fn test_register_items() -> i32 {
    let it: Vec<i32> = vec_new();
    let id1: Vec<i32> = vec_new();
    let id2: Vec<i32> = vec_new();
    let id3: Vec<i32> = vec_new();
    let id4: Vec<i32> = vec_new();
    vec_push(it, 0); vec_push(id1, 5); vec_push(id2, 1); vec_push(id3, 2); vec_push(id4, 0);
    vec_push(it, 1); vec_push(id1, 10); vec_push(id2, 3); vec_push(id3, 0); vec_push(id4, 0);
    vec_push(it, 3); vec_push(id1, 20); vec_push(id2, 1); vec_push(id3, 0); vec_push(id4, 0);
    let mv: Vec<i32> = vec_new();
    let mt: Vec<i32> = vec_new();
    let fa: Vec<i32> = vec_new();
    register_items(it, id1, id2, id3, id4, mv, mt, fa);
    if vec_len(mv) != 2 { return 1; }
    if vec_get(mv, 0) != 5 { return 2; }
    if vec_get(mv, 1) != 10 { return 3; }
    if vec_len(mt) != 2 { return 4; }
    if vec_get(mt, 0) != 10 { return 5; }
    if vec_get(mt, 1) != 20 { return 6; }
    if vec_len(fa) != 2 { return 7; }
    if vec_get(fa, 0) != 5 { return 8; }
    if vec_get(fa, 1) != 2 { return 9; }
    return 0;
}

fn test_tok_str() -> i32 {
    let source: string = "fn foo bar";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 2);
    vec_push(starts, 3); vec_push(ends, 6);
    vec_push(starts, 7); vec_push(ends, 10);
    if string_eq(tok_str(source, starts, ends, 0), "fn") != true { return 1; }
    if string_eq(tok_str(source, starts, ends, 1), "foo") != true { return 2; }
    if string_eq(tok_str(source, starts, ends, 2), "bar") != true { return 3; }
    return 0;
}

fn test_res_value_exists() -> i32 {
    let source: string = "alpha beta gamma";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 5);
    vec_push(starts, 6); vec_push(ends, 10);
    vec_push(starts, 11); vec_push(ends, 16);
    let mv: Vec<i32> = vec_new();
    vec_push(mv, 0);
    vec_push(mv, 2);
    if res_value_exists(mv, "alpha", source, starts, ends) != true { return 1; }
    if res_value_exists(mv, "gamma", source, starts, ends) != true { return 2; }
    if res_value_exists(mv, "beta", source, starts, ends) != false { return 3; }
    if res_value_exists(mv, "nope", source, starts, ends) != false { return 4; }
    return 0;
}

fn test_res_type_exists() -> i32 {
    let source: string = "MyStruct i32";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 8);
    vec_push(starts, 9); vec_push(ends, 12);
    let mt: Vec<i32> = vec_new();
    vec_push(mt, 0);
    if res_type_exists(mt, "MyStruct", source, starts, ends) != true { return 1; }
    if res_type_exists(mt, "i32", source, starts, ends) != true { return 2; }
    if res_type_exists(mt, "bool", source, starts, ends) != true { return 3; }
    if res_type_exists(mt, "Nope", source, starts, ends) != false { return 4; }
    /* `byte` is the normative alias of `u8` (sv0doc §4.1; SPEC UP-018). */
    if res_type_exists(mt, "byte", source, starts, ends) != true { return 5; }
    return 0;
}

fn test_resolve_pat_shape_simple() -> i32 {
    let pt: Vec<i32> = vec_new();
    let pd1: Vec<i32> = vec_new();
    let pd2: Vec<i32> = vec_new();
    let pd3: Vec<i32> = vec_new();
    vec_push(pt, 0); vec_push(pd1, 0); vec_push(pd2, 0); vec_push(pd3, 0);
    let source: string = "_";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 1);
    let mv: Vec<i32> = vec_new();
    let mt: Vec<i32> = vec_new();
    let pp: Vec<i32> = vec_new();
    if resolve_pat_shape(pt, pd1, pd2, pd3, 0,
                          source, starts, ends, mv, mt, pp) != 0 { return 1; }
    vec_push(pt, 1); vec_push(pd1, 0); vec_push(pd2, 0); vec_push(pd3, 0);
    if resolve_pat_shape(pt, pd1, pd2, pd3, 1,
                          source, starts, ends, mv, mt, pp) != 0 { return 2; }
    vec_push(pt, 6); vec_push(pd1, 0); vec_push(pd2, 0); vec_push(pd3, 0);
    if resolve_pat_shape(pt, pd1, pd2, pd3, 2,
                          source, starts, ends, mv, mt, pp) != 306 { return 3; }
    return 0;
}

