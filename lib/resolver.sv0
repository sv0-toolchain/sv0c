                   source, starts, ends, mt2, vec_new(), pp, vec_new())) != 301 { return 3; }
    return 0;
}

/* PC-4a: TyArray `[T; N]` length validation — an IDENT length (td3==1) must be a
   bound value (E0300 if unbound); an INT_LIT length (td3==0) needs no lookup. */
fn test_resolve_ty_array_len() -> i32 {
    let source: string = "i32 N";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 3);
    vec_push(starts, 4); vec_push(ends, 5);
    let mt: Vec<i32> = vec_new();
    let pp: Vec<i32> = vec_new();
    vec_push(pp, 0);
    let tt: Vec<i32> = vec_new();
    let td1: Vec<i32> = vec_new();
    let td2: Vec<i32> = vec_new();
    let td3: Vec<i32> = vec_new();
    vec_push(tt, 0); vec_push(td1, 0); vec_push(td2, 1); vec_push(td3, 0);
    vec_push(tt, 3); vec_push(td1, 0); vec_push(td2, 1); vec_push(td3, 1);
    let mv_empty: Vec<i32> = vec_new();
    if resolve_ty(tt, td1, td2, td3, 1,
                   source, starts, ends, mt, mv_empty, pp, vec_new()) != 300 { return 1; }
    let mv_bound: Vec<i32> = vec_new();
    vec_push(mv_bound, 1);
    if resolve_ty(tt, td1, td2, td3, 1,
                   source, starts, ends, mt, mv_bound, pp, vec_new()) != 0 { return 2; }
    vec_set(td3, 1, 0);
    if resolve_ty(tt, td1, td2, td3, 1,
                   source, starts, ends, mt, mv_empty, pp, vec_new()) != 0 { return 3; }
    return 0;
}

