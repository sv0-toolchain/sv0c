/* Phase 2 real pipeline module: sml/name_resolution/resolver.sml -> sv0.
   Name resolution utilities: path-to-string joining (2-seg and Vec),
   intrinsic registration (17 builtins with string+arity lookup +
   register_all_intrinsics into env fn_arities/mod_values), import
   alias management (Vec-based add/lookup/reset), item registration
   dispatch (by item tag), pattern-bind counting, variant-arity
   extraction, context rules (allowSelf), error codes, arity checks,
   pat_binds (SML patBinds — collects bound var handles from flat
   patterns into Vec), bind_pattern_locals (SML bindPatternLocals),
   register_item/register_items (SML registerItem — item arena to
   env registration pass; enum variant registration deferred),
   inline env lookups (tok_str, res_is_prelude_type, res_value_exists,
   res_type_exists — string-based name comparison via token stream),
   resolve_pat_shape (SML resolvePatShape — pattern name validation),
   resolve_ty (SML resolveTy — type name validation; TyArray size expr
   deferred to resolve_expr),
   scope management (res_enter_scope, res_bind_local,
   res_lookup_in_frames_str, res_full_value_exists,
   res_lookup_fn_arity_str),
   resolve_expr (SML resolveExpr — 27 expr tag cases with scope/binding/
   arity checking; ExprCast roots are validated via program type arena
   in resolve_program),
   resolve_stmt (SML resolveStmt — LetStmt/SemiStmt),
   resolve_contract (SML resolveContract — thin wrapper),
   apply_use_clause/apply_use_clauses (SML applyUseClause — use clause
   alias registration; enum variant aliases deferred — variant names
   local to parser),
   resolve_top_item / resolve_program: ItemFn body + params; ItemStruct field
   types + ItemTypeAlias RHS via program type arena (pty_tt and struct_field_ty_root);
   enum payload resolve_ty and contract expr roots still deferred. */

/* ── path joining ───────────────────────────────────────────── */

fn path_join2(a: string, b: string) -> string {
    let ab: string = string_concat(a, "::");
    return string_concat(ab, b);
}

fn mangle_use_target(mod_name: string, item_name: string) -> string {
    let a: string = string_concat(mod_name, "__");
    return string_concat(a, item_name);
}

/* ── generalized path → string ─────────────────────────────────
   path_join_vec: joins token-stream path segments with "::".
   path_indices is the Vec<i32> of token positions from parse_path.
   Extracts each segment's text via source/starts/ends. */

fn path_join_vec(source: string, starts: Vec<i32>, ends: Vec<i32>,
                 path_indices: Vec<i32>) -> string {
    let n: i32 = vec_len(path_indices);
    if n == 0 { return ""; }
    let first_pos: i32 = vec_get(path_indices, 0);
    let fs: i32 = vec_get(starts, first_pos);
    let fe: i32 = vec_get(ends, first_pos);
    let mut out: string = string_substr(source, fs, fe - fs);
    let mut i: i32 = 1;
    while i < n {
        out = string_concat(out, "::");
        let pos: i32 = vec_get(path_indices, i);
        let s: i32 = vec_get(starts, pos);
        let e: i32 = vec_get(ends, pos);
        let seg: string = string_substr(source, s, e - s);
        out = string_concat(out, seg);
        i = i + 1;
    }
    return out;
}

/* ── import alias management ───────────────────────────────────
   Interleaved Vec<i32>: [from0, to0, from1, to1, ...].
   from/to are interned string handles. */

fn import_alias_new() -> Vec<i32> {
    return vec_new();
}

fn import_alias_add(aliases: Vec<i32>, from_handle: i32, to_handle: i32) -> i32 {
    vec_push(aliases, from_handle);
    vec_push(aliases, to_handle);
    return vec_len(aliases) / 2;
}

fn import_alias_count(aliases: Vec<i32>) -> i32 {
    return vec_len(aliases) / 2;
}

fn import_alias_lookup(aliases: Vec<i32>, name_handle: i32) -> i32 {
    let n: i32 = vec_len(aliases);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(aliases, i) == name_handle {
            return vec_get(aliases, i + 1);
        }
        i = i + 2;
    }
    return 0 - 1;
}

/* import_alias_reset: in SML this is `recordedImportAliases := []`.
   In sv0, the caller discards the old Vec and calls import_alias_new()
   for a fresh list. No in-place clear needed. */

/* ── intrinsic function registry (string-based) ─────────────── */

/* 17 intrinsics from withIntrinsics in resolver.sml:
   println(1), old(1), forall(3), exists(3), no_alias(2),
   string_len(1), string_eq(2), string_concat(2),
   string_char_at(2), string_substr(3),
   vec_new(0), vec_push(2), vec_len(1), vec_get(2), vec_set(3),
   box_new(1), box_deref(1). */

fn is_intrinsic(name: string) -> bool {
    if string_eq(name, "println") { return true; }
    if string_eq(name, "old") { return true; }
    if string_eq(name, "forall") { return true; }
    if string_eq(name, "exists") { return true; }
    if string_eq(name, "no_alias") { return true; }
    if string_eq(name, "string_len") { return true; }
    if string_eq(name, "string_eq") { return true; }
    if string_eq(name, "string_concat") { return true; }
    if string_eq(name, "string_char_at") { return true; }
    if string_eq(name, "string_substr") { return true; }
    if string_eq(name, "vec_new") { return true; }
    if string_eq(name, "vec_push") { return true; }
    if string_eq(name, "vec_len") { return true; }
    if string_eq(name, "vec_get") { return true; }
    if string_eq(name, "vec_set") { return true; }
    if string_eq(name, "box_new") { return true; }
    if string_eq(name, "box_deref") { return true; }
    /* Host I/O builtins (lowering build_builtin_map IDs 15-18); used by the
       library modules (link / include_expand) but not in the original 17. */
    if string_eq(name, "read_file") { return true; }
    if string_eq(name, "write_file") { return true; }
    if string_eq(name, "read_dir") { return true; }
    if string_eq(name, "write_bytes") { return true; }
    /* getenv (NEX-055c, lowering build_builtin_map ID 19): host
       environment-variable read, "" when unset, never panics -- also
       not in the original 17, same as the host-I/O builtins above. */
    if string_eq(name, "getenv") { return true; }
    return false;
}

fn intrinsic_arity(name: string) -> i32 {
    if string_eq(name, "println") { return 1; }
    if string_eq(name, "old") { return 1; }
    if string_eq(name, "forall") { return 3; }
    if string_eq(name, "exists") { return 3; }
    if string_eq(name, "no_alias") { return 2; }
    if string_eq(name, "string_len") { return 1; }
    if string_eq(name, "string_eq") { return 2; }
    if string_eq(name, "string_concat") { return 2; }
    if string_eq(name, "string_char_at") { return 2; }
    if string_eq(name, "string_substr") { return 3; }
    if string_eq(name, "vec_new") { return 0; }
    if string_eq(name, "vec_push") { return 2; }
    if string_eq(name, "vec_len") { return 1; }
    if string_eq(name, "vec_get") { return 2; }
    if string_eq(name, "vec_set") { return 3; }
    if string_eq(name, "box_new") { return 1; }
    if string_eq(name, "box_deref") { return 1; }
    if string_eq(name, "read_file") { return 1; }
    if string_eq(name, "write_file") { return 2; }
    if string_eq(name, "read_dir") { return 1; }
    if string_eq(name, "write_bytes") { return 2; }
    if string_eq(name, "getenv") { return 1; }
    return 0 - 1;
}

/* Deliberately NOT bumped for read_file/write_file/read_dir/write_bytes/
   getenv (NEX-055c): this counts only the original 17 SML-parity
   intrinsics from resolver.sml's own withIntrinsics -- the host-I/O
   builtins above were never added to it either, an established
   precedent this module continues rather than "fixes". */
fn intrinsic_count() -> i32 {
    return 17;
}

fn is_string_intrinsic(name: string) -> bool {
    if string_eq(name, "string_len") { return true; }
    if string_eq(name, "string_eq") { return true; }
    if string_eq(name, "string_concat") { return true; }
    if string_eq(name, "string_char_at") { return true; }
    if string_eq(name, "string_substr") { return true; }
    return false;
}

fn is_vec_intrinsic(name: string) -> bool {
    if string_eq(name, "vec_new") { return true; }
    if string_eq(name, "vec_push") { return true; }
    if string_eq(name, "vec_len") { return true; }
    if string_eq(name, "vec_get") { return true; }
    if string_eq(name, "vec_set") { return true; }
    return false;
}

fn is_box_intrinsic(name: string) -> bool {
    if string_eq(name, "box_new") { return true; }
    if string_eq(name, "box_deref") { return true; }
    return false;
}

/* ── register all intrinsics into env ───────────────────────── */

fn register_one_intrinsic(fn_arities: Vec<i32>, mod_values: Vec<i32>,
                          name: i32, arity: i32) -> i32 {
    vec_push(fn_arities, name);
    vec_push(fn_arities, arity);
    vec_push(mod_values, name);
    return 0;
}

fn register_all_intrinsics(fn_arities: Vec<i32>, mod_values: Vec<i32>,
                           println_h: i32, old_h: i32, forall_h: i32,
                           exists_h: i32, no_alias_h: i32,
                           str_len_h: i32, str_eq_h: i32,
                           str_concat_h: i32, str_char_at_h: i32,
                           str_substr_h: i32,
                           vec_new_h: i32, vec_push_h: i32,
                           vec_len_h: i32, vec_get_h: i32,
                           vec_set_h: i32,
                           box_new_h: i32, box_deref_h: i32) -> i32 {
    register_one_intrinsic(fn_arities, mod_values, println_h, 1);
    register_one_intrinsic(fn_arities, mod_values, old_h, 1);
    register_one_intrinsic(fn_arities, mod_values, forall_h, 3);
    register_one_intrinsic(fn_arities, mod_values, exists_h, 3);
    register_one_intrinsic(fn_arities, mod_values, no_alias_h, 2);
    register_one_intrinsic(fn_arities, mod_values, str_len_h, 1);
    register_one_intrinsic(fn_arities, mod_values, str_eq_h, 2);
    register_one_intrinsic(fn_arities, mod_values, str_concat_h, 2);
    register_one_intrinsic(fn_arities, mod_values, str_char_at_h, 2);
    register_one_intrinsic(fn_arities, mod_values, str_substr_h, 3);
    register_one_intrinsic(fn_arities, mod_values, vec_new_h, 0);
    register_one_intrinsic(fn_arities, mod_values, vec_push_h, 2);
    register_one_intrinsic(fn_arities, mod_values, vec_len_h, 1);
    register_one_intrinsic(fn_arities, mod_values, vec_get_h, 2);
    register_one_intrinsic(fn_arities, mod_values, vec_set_h, 3);
    register_one_intrinsic(fn_arities, mod_values, box_new_h, 1);
    register_one_intrinsic(fn_arities, mod_values, box_deref_h, 1);
    return 17;
}

/* ── item registration classification ───────────────────────── */

/* Item tags from ast.sv0: 0=ItemFn, 1=ItemStruct, 2=ItemEnum,
   3=ItemTrait, 4=ItemImpl, 5=ItemUse, 6=ItemModule, 7=ItemTypeAlias. */

fn item_registers_fn(tag: i32) -> bool {
    return tag == 0;
}

fn item_registers_type(tag: i32) -> bool {
    if tag == 1 { return true; }
    if tag == 2 { return true; }
    if tag == 3 { return true; }
    if tag == 7 { return true; }
    return false;
}

fn item_registers_variants(tag: i32) -> bool {
    return tag == 2;
}

fn item_is_use(tag: i32) -> bool {
    return tag == 5;
}

fn item_is_module(tag: i32) -> bool {
    return tag == 6;
}

fn item_needs_registration(tag: i32) -> bool {
    if item_registers_fn(tag) { return true; }
    if item_registers_type(tag) { return true; }
    return false;
}

/* ── variant arity extraction ───────────────────────────────── */

/* Variant kinds: 0=VariantUnit, 1=VariantTuple, 2=VariantStruct. */
fn enum_variant_arity(variant_kind: i32, tuple_fields: i32,
                      struct_fields: i32) -> i32 {
    if variant_kind == 0 { return 0; }
    if variant_kind == 1 { return tuple_fields; }
    if variant_kind == 2 { return struct_fields; }
    return 0;
}

fn enum_variant_qualified_path(enum_name: string,
                               variant_name: string) -> string {
    return path_join2(enum_name, variant_name);
}

fn variant_stem(variant_kind: i32, name_handle: i32) -> i32 {
    return name_handle;
}

fn enum_variant_reg_path(enum_name: string,
                         variant_name: string) -> string {
    return enum_variant_qualified_path(enum_name, variant_name);
}

fn enum_variant_reg_arity(variant_kind: i32, tuple_fields: i32,
                          struct_fields: i32) -> i32 {
    return enum_variant_arity(variant_kind, tuple_fields, struct_fields);
}

/* ── pattern-bind counting ──────────────────────────────────── */

/* Pat tags: 0=PatWild, 1=PatBind, 2=PatLit, 3=PatTuple,
   4=PatStruct, 5=PatEnum, 6=PatOr. */
fn pat_binds_count(pat_tag: i32, child_count: i32) -> i32 {
    if pat_tag == 0 { return 0; }
    if pat_tag == 1 { return 1; }
    if pat_tag == 2 { return 0; }
    if pat_tag == 3 { return child_count; }
    if pat_tag == 4 { return child_count; }
    if pat_tag == 5 { return child_count; }
    if pat_tag == 6 { return 255; }
    return 0;
}

fn pat_is_or(pat_tag: i32) -> bool {
    return pat_tag == 6;
}

/* SML patBinds: collects bound variable name handles from a flat
   pattern.  In the bootstrap sv0, patterns are not yet recursive
   (no Box<Pat>), so this handles the flat cases:
     PatWild (0) → nothing
     PatBind (1) → push name handle
     PatLit  (2) → nothing
   For compound patterns (PatTuple/PatStruct/PatEnum), the caller
   must iterate sub-patterns and call pat_binds on each.
   PatOr (6) is unsupported (SML raises Fail). */
fn pat_binds(pat_tag: i32, name_handle: i32, out: Vec<i32>) -> i32 {
    if pat_tag == 1 {
        vec_push(out, name_handle);
        return 1;
    }
    return 0;
}

/* SML bindPatternLocals: folds patBinds result into an env.
   Takes the collected binds Vec and pushes each handle into the
   env's local names Vec. Returns the count of locals bound. */
fn bind_pattern_locals(binds: Vec<i32>, env_locals: Vec<i32>) -> i32 {
    let n: i32 = vec_len(binds);
    let mut i: i32 = 0;
    while i < n {
        vec_push(env_locals, vec_get(binds, i));
        i = i + 1;
    }
    return n;
}

/* ── context rules (allowSelf) ──────────────────────────────── */

fn should_allow_self(item_tag: i32) -> bool {
    if item_tag == 3 { return true; }
    if item_tag == 4 { return true; }
    return false;
}

/* ── resolution error codes ─────────────────────────────────── */

fn error_code_unbound_ident() -> string { return "E0300"; }
fn error_code_unknown_type() -> string { return "E0301"; }
fn error_code_pat_or_unsupported() -> string { return "E0306"; }
fn error_code_wrong_arity() -> string { return "E0307"; }
fn error_code_use_clause() -> string { return "E0309"; }

/* ── diagnostic span packing (span fidelity) ──────────────────
   The resolve* functions signal an error by returning a numeric code, which
   propagates up unchanged through `if r != 0 { return r; }`. To carry the
   offending source TOKEN out to the compose main for a real (line, col) —
   without threading a span param through resolve_expr's 56 call sites — fold the
   token into that return value: packed = code*1000000 + (tok+1). code stays in
   [300,999]; tok in [0,999999], else -1 (default span). Any real code packs
   nonzero, so success (0) is still distinguishable. Bare codes (< 1000, from
   sites that do not pack) decode to themselves with tok = -1. */
fn diag_pack(code: i32, tok: i32) -> i32 {
    let mut t: i32 = tok;
    if t < 0 { t = 0 - 1; }
    if t >= 1000000 { t = 0 - 1; }
    return code * 1000000 + t + 1;
}
fn diag_code_of(packed: i32) -> i32 {
    if packed < 1000 { return packed; }
    return packed / 1000000;
}
fn diag_tok_of(packed: i32) -> i32 {
    if packed < 1000 { return 0 - 1; }
    return packed - (packed / 1000000) * 1000000 - 1;
}

/* ── arity checking ─────────────────────────────────────────── */

fn arity_matches(expected: i32, actual: i32) -> bool {
    return expected == actual;
}

fn check_call_arity(expected: i32, actual: i32) -> i32 {
    if expected == actual { return 0; }
    if expected < 0 { return 0; }
    return 1;
}

/* ── item registration pass (SML registerItem) ────────────────
   Walks the item arena and registers names/arities in the env.
   Enum variant registration deferred — needs variant sub-arena
   with per-variant name + arity data (see transliteration-plan). */

fn register_item(item_tag: i32, item_d1: i32, item_d2: i32,
                 item_d3: i32, item_d4: i32,
                 mod_vals: Vec<i32>, mod_tys: Vec<i32>,
                 fn_arities: Vec<i32>) -> i32 {
    if item_tag == 0 {
        vec_push(mod_vals, item_d1);
        vec_push(fn_arities, item_d1);
        vec_push(fn_arities, item_d3);
        return 0;
    }
    if item_tag == 1 {
        vec_push(mod_vals, item_d1);
        vec_push(mod_tys, item_d1);
        return 0;
    }
    if item_tag == 2 {
        vec_push(mod_vals, item_d1);
        vec_push(mod_tys, item_d1);
        return 0;
    }
    if item_tag == 3 {
        vec_push(mod_tys, item_d1);
        return 0;
    }
    if item_tag == 7 {
        vec_push(mod_tys, item_d1);
        return 0;
    }
    return 0;
}

fn register_items(it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
                  id3: Vec<i32>, id4: Vec<i32>,
                  mod_vals: Vec<i32>, mod_tys: Vec<i32>,
                  fn_arities: Vec<i32>) -> i32 {
    let n: i32 = vec_len(it);
    let mut i: i32 = 0;
    while i < n {
        let tag: i32 = vec_get(it, i);
        let d1: i32 = vec_get(id1, i);
        let d2: i32 = vec_get(id2, i);
        let d3: i32 = vec_get(id3, i);
        let d4: i32 = vec_get(id4, i);
        register_item(tag, d1, d2, d3, d4,
                      mod_vals, mod_tys, fn_arities);
        i = i + 1;
    }
    return 0;
}

/* ── inline env lookups for resolver traversals ──────────────
   Each .sv0 is compiled standalone; resolver needs env-style
   lookups but cannot import from env.sv0. These operate on the
   same data structures (mod_vals/mod_tys as Vec<i32> of token
   positions, fn_arities interleaved [pos, arity, ...]).
   Lookups extract strings from the token stream for comparison
   since two occurrences of the same name have different positions. */

fn tok_str(source: string, starts: Vec<i32>, ends: Vec<i32>,
           pos: i32) -> string {
    let s: i32 = vec_get(starts, pos);
    let e: i32 = vec_get(ends, pos);
    return string_substr(source, s, e - s);
}

fn res_is_prelude_type(name: string) -> bool {
    if string_eq(name, "i8") { return true; }
    if string_eq(name, "i16") { return true; }
    if string_eq(name, "i32") { return true; }
    if string_eq(name, "i64") { return true; }
    if string_eq(name, "i128") { return true; }
    if string_eq(name, "u8") { return true; }
    if string_eq(name, "byte") { return true; }
    if string_eq(name, "u16") { return true; }
    if string_eq(name, "u32") { return true; }
    if string_eq(name, "u64") { return true; }
    if string_eq(name, "u128") { return true; }
    if string_eq(name, "isize") { return true; }
    if string_eq(name, "usize") { return true; }
    if string_eq(name, "f32") { return true; }
    if string_eq(name, "f64") { return true; }
    if string_eq(name, "bool") { return true; }
    if string_eq(name, "char") { return true; }
    if string_eq(name, "str") { return true; }
    if string_eq(name, "string") { return true; }
    if string_eq(name, "String") { return true; }
    if string_eq(name, "unit") { return true; }
    if string_eq(name, "Vec") { return true; }
    if string_eq(name, "Box") { return true; }
    return false;
}

fn res_value_exists(mod_vals: Vec<i32>, name_str: string,
                    source: string, starts: Vec<i32>,
                    ends: Vec<i32>) -> bool {
    let len: i32 = vec_len(mod_vals);
    let mut i: i32 = 0;
    while i < len {
        let pos: i32 = vec_get(mod_vals, i);
        let nm: string = tok_str(source, starts, ends, pos);
        if string_eq(nm, name_str) { return true; }
        i = i + 1;
    }
    return false;
}

fn res_type_exists(mod_tys: Vec<i32>, name_str: string,
                   source: string, starts: Vec<i32>,
                   ends: Vec<i32>) -> bool {
    if res_is_prelude_type(name_str) { return true; }
    let len: i32 = vec_len(mod_tys);
    let mut i: i32 = 0;
    while i < len {
        let pos: i32 = vec_get(mod_tys, i);
        let nm: string = tok_str(source, starts, ends, pos);
        if string_eq(nm, name_str) { return true; }
        i = i + 1;
    }
    return false;
}

/* ── resolve_pat_shape (SML resolvePatShape) ──────────────────
   Validates that struct/enum constructor names in patterns exist
   in the env. Walks pattern arena recursively. Returns 0 on
   success, 300 for unbound constructor, 301 for unknown type,
   306 for unsupported PatOr. */

fn resolve_pat_shape(pt: Vec<i32>, pd1: Vec<i32>, pd2: Vec<i32>,
                     pd3: Vec<i32>, idx: i32,
                     source: string, starts: Vec<i32>,
                     ends: Vec<i32>,
                     mod_vals: Vec<i32>, mod_tys: Vec<i32>,
                     pp: Vec<i32>) -> i32 {
    let tag: i32 = vec_get(pt, idx);
    if tag == 0 { return 0; }
    if tag == 1 { return 0; }
    if tag == 2 { return 0; }
    if tag == 3 {
        let first: i32 = vec_get(pd1, idx);
        let count: i32 = vec_get(pd2, idx);
        let mut i: i32 = 0;
        while i < count {
            let r: i32 = resolve_pat_shape(pt, pd1, pd2, pd3, first + i,
                                            source, starts, ends,
                                            mod_vals, mod_tys, pp);
            if r != 0 { return r; }
            i = i + 1;
        }
        return 0;
    }
    if tag == 4 {
        let pps: i32 = vec_get(pd1, idx);
        let ppc: i32 = vec_get(pd2, idx);
        let fc: i32 = vec_get(pd3, idx);
        let path: Vec<i32> = vec_new();
        let mut k: i32 = 0;
        while k < ppc {
            vec_push(path, vec_get(pp, pps + k));
            k = k + 1;
        }
        let ps: string = path_join_vec(source, starts, ends, path);
        if ppc >= 2 {
            /* Enum struct-variant pattern `Enum::Variant { fields }`: struct
               variants are not registered as qualified values (unlike tuple/nullary
               variants), so accept when the first segment is a known enum type — the
               coarse pass; the checker validates the variant + fields. Mirrors the
               2-seg expr-path handler. */
            let seg0: string = tok_str(source, starts, ends, vec_get(path, 0));
            if res_type_exists(mod_tys, seg0, source, starts, ends) != true {
                return 301;
            }
        } else {
            if res_type_exists(mod_tys, ps, source, starts, ends) != true {
                return 301;
            }
        }
        let mut fi: i32 = 0;
        while fi < fc {
            let child_idx: i32 = idx - fc + fi;
            let r: i32 = resolve_pat_shape(pt, pd1, pd2, pd3, child_idx,
                                            source, starts, ends,
                                            mod_vals, mod_tys, pp);
            if r != 0 { return r; }
            fi = fi + 1;
        }
        return 0;
    }
    if tag == 5 {
        let pps: i32 = vec_get(pd1, idx);
        let ppc: i32 = vec_get(pd2, idx);
        let ac: i32 = vec_get(pd3, idx);
        let path: Vec<i32> = vec_new();
        let mut k: i32 = 0;
        while k < ppc {
            vec_push(path, vec_get(pp, pps + k));
            k = k + 1;
        }
        let ps: string = path_join_vec(source, starts, ends, path);
        if res_value_exists(mod_vals, ps, source, starts, ends) != true {
            return 300;
        }
        let mut ai: i32 = 0;
        while ai < ac {
            let child_idx: i32 = idx - ac + ai;
            let r: i32 = resolve_pat_shape(pt, pd1, pd2, pd3, child_idx,
                                            source, starts, ends,
                                            mod_vals, mod_tys, pp);
            if r != 0 { return r; }
            ai = ai + 1;
        }
        return 0;
    }
    if tag == 6 { return 306; }
    return 0;
}

/* Is `name` the text of one of the program's declared generic (`<T, ...>`)
   parameter names? `tparam_names` holds TOKEN POSITIONS (see
   parse_generic_params/parse_enum_item), collected file-scoped rather than
   per-declaring-item: sv0 has no nested/shadowing generic scopes today (a
   type param is only ever referenced inside the same item that binds it),
   so treating the set as global is a deliberate, documented simplification
   — over-permissive in a pathological case (two unrelated items each
   declaring an unrelated `T` would each accept the other's), never
   under-permissive, and there is no such pathological case anywhere in the
   corpus today. Revisit if/when per-item scoping actually matters. */
fn res_is_type_param(name: string, tparam_names: Vec<i32>,
                     source: string, starts: Vec<i32>, ends: Vec<i32>) -> bool {
    let n: i32 = vec_len(tparam_names);
    let mut i: i32 = 0;
    while i < n {
        let tok: i32 = vec_get(tparam_names, i);
        if string_eq(tok_str(source, starts, ends, tok), name) { return true; }
        i = i + 1;
    }
    return false;
}

/* ── resolve_ty (SML resolveTy) ───────────────────────────────
   Validates that type names in the type arena exist in the env.
   Walks type arena recursively. Returns 0 on success, 301 for
   unknown type. TyArray size expression resolution deferred to
   resolve_expr (batch 20+). tparam_names: see res_is_type_param — checked
   as a third fallback after mod_tys/prelude, fixing enum type parameters
   like `enum Option<T> { Some(T), None }`'s own `T` being rejected as an
   unknown type (BUGS.md #3, sv0-mathlib). */

fn resolve_ty(tt: Vec<i32>, td1: Vec<i32>, td2: Vec<i32>,
              td3: Vec<i32>, idx: i32,
              source: string, starts: Vec<i32>, ends: Vec<i32>,
              mod_tys: Vec<i32>, mod_vals: Vec<i32>, pp: Vec<i32>,
              tparam_names: Vec<i32>) -> i32 {
    let tag: i32 = vec_get(tt, idx);
    if tag == 6 { return 0; }
    if tag == 0 {
        let pps: i32 = vec_get(td1, idx);
        let ppc: i32 = vec_get(td2, idx);
        let tac: i32 = vec_get(td3, idx);
        let path: Vec<i32> = vec_new();
        let mut k: i32 = 0;
        while k < ppc {
            vec_push(path, vec_get(pp, pps + k));
            k = k + 1;
        }
        let ps: string = path_join_vec(source, starts, ends, path);
        if res_type_exists(mod_tys, ps, source, starts, ends) != true {
            if res_is_prelude_type(ps) != true {
                if res_is_type_param(ps, tparam_names, source, starts, ends) != true {
                    return diag_pack(301, vec_get(pp, pps));
                }
            }
        }
        let mut ti: i32 = 0;
        while ti < tac {
            let child_idx: i32 = idx - tac + ti;
            let r: i32 = resolve_ty(tt, td1, td2, td3, child_idx,
                                     source, starts, ends, mod_tys, mod_vals, pp,
                                     tparam_names);
            if r != 0 { return r; }
            ti = ti + 1;
        }
        return 0;
    }
    if tag == 1 {
        return resolve_ty(tt, td1, td2, td3, vec_get(td1, idx),
                           source, starts, ends, mod_tys, mod_vals, pp,
                           tparam_names);
    }
    if tag == 2 {
        return resolve_ty(tt, td1, td2, td3, vec_get(td1, idx),
                           source, starts, ends, mod_tys, mod_vals, pp,
                           tparam_names);
    }
    if tag == 3 {
        /* TyArray `[T; N]` (PC-4a): resolve the element type, and if the length is
           an IDENT (td3==1, set by the parser), it must be a bound value — an
           unbound length identifier is E0300. An INT_LIT length (td3==0) is a
           constant and needs no lookup. sv0 has no const-generics, so the check is
           just boundedness, mirroring SML resolveTy `resolveExpr` on the length. */
        if vec_get(td3, idx) == 1 {
            let len_tok: i32 = vec_get(td2, idx);
            let ln: string = tok_str(source, starts, ends, len_tok);
            if res_full_value_exists(mod_vals, vec_new(), ln,
                                     source, starts, ends) != true {
                return 300;
            }
        }
        return resolve_ty(tt, td1, td2, td3, vec_get(td1, idx),
                           source, starts, ends, mod_tys, mod_vals, pp,
                           tparam_names);
    }
    if tag == 4 {
        return resolve_ty(tt, td1, td2, td3, vec_get(td1, idx),
                           source, starts, ends, mod_tys, mod_vals, pp,
                           tparam_names);
    }
    if tag == 5 {
        let first: i32 = vec_get(td1, idx);
        let count: i32 = vec_get(td2, idx);
        let mut i: i32 = 0;
        while i < count {
            let r: i32 = resolve_ty(tt, td1, td2, td3, first + i,
                                     source, starts, ends, mod_tys, mod_vals, pp,
                                     tparam_names);
            if r != 0 { return r; }
            i = i + 1;
        }
        return 0;
    }
    return 0;
}

/* ── scope management helpers ────────────────────────────────
   Inline copies of env.sv0 scope operations. Frames is a Vec
   of Vec<i32>, each inner Vec holding name token positions. */

fn res_enter_scope(frames: Vec<i32>) -> i32 {
    let f: Vec<i32> = vec_new();
    vec_push(frames, f);
    return 0;
}

fn res_bind_local(frames: Vec<i32>, name_pos: i32) -> i32 {
    let len: i32 = vec_len(frames);
    if len == 0 {
        let f: Vec<i32> = vec_new();
        vec_push(f, name_pos);
        vec_push(frames, f);
        return 0;
    }
    let top: Vec<i32> = vec_get(frames, len - 1);
    vec_push(top, name_pos);
    return 0;
}

/* BH-6: leave a block scope. sv0's frames Vec has no pop, so tombstone the top
   frame's entries (set each bound name-token to -1). res_lookup_in_frames_str
   skips -1 entries, so a block-local is no longer found after its block ends
   (→ E0300), matching SML's scoping. The empty frame is left in place (frames is
   fresh per fn — resolve_top_item L1454 — so residual frames are harmless). */
fn res_exit_scope(frames: Vec<i32>) -> i32 {
    let len: i32 = vec_len(frames);
    if len == 0 { return 0; }
    let top: Vec<i32> = vec_get(frames, len - 1);
    let tl: i32 = vec_len(top);
    let mut j: i32 = 0;
    while j < tl {
        vec_set(top, j, 0 - 1);
        j = j + 1;
    }
    return 0;
}

fn res_lookup_in_frames_str(frames: Vec<i32>, name_str: string,
                            source: string, starts: Vec<i32>,
                            ends: Vec<i32>) -> bool {
    let flen: i32 = vec_len(frames);
    let mut fi: i32 = flen - 1;
    while fi >= 0 {
        let frame: Vec<i32> = vec_get(frames, fi);
        let fv_len: i32 = vec_len(frame);
        let mut j: i32 = 0;
        while j < fv_len {
            let pos: i32 = vec_get(frame, j);
            /* BH-6: skip tombstoned (out-of-scope) block-locals — res_exit_scope
               sets their name to -1, not a valid token index. */
            if pos >= 0 {
                let nm: string = tok_str(source, starts, ends, pos);
                if string_eq(nm, name_str) { return true; }
            }
            j = j + 1;
        }
        fi = fi - 1;
    }
    return false;
}

fn res_full_value_exists(mod_vals: Vec<i32>, frames: Vec<i32>,
                         name_str: string, source: string,
                         starts: Vec<i32>, ends: Vec<i32>) -> bool {
    if res_lookup_in_frames_str(frames, name_str, source, starts, ends) {
        return true;
    }
    return res_value_exists(mod_vals, name_str, source, starts, ends);
}

fn res_lookup_fn_arity_str(fn_arities: Vec<i32>, name_str: string,
                           source: string, starts: Vec<i32>,
                           ends: Vec<i32>) -> i32 {
    let len: i32 = vec_len(fn_arities);
    let mut i: i32 = 0;
    while i < len {
        let pos: i32 = vec_get(fn_arities, i);
        let nm: string = tok_str(source, starts, ends, pos);
        if string_eq(nm, name_str) {
            return vec_get(fn_arities, i + 1);
        }
        i = i + 2;
    }
    return 0 - 1;
}

/* ── resolve_expr (SML resolveExpr) ───────────────────────────
   Walks the expr arena and validates names, scoping, and arity.
   Returns 0 on success, error code on failure.
   ExprCast type roots are validated in resolve_program using pty_*.
   Pattern arena is local to parser — ExprFor/ExprMatch patterns
   use inlined tag/d1 from expr arena. */

/* Resolve the arena index of block statement `si`. Statement nodes are not
   contiguous; parse_block records an ordered index list in pp with its offset
   (+1) in the block's d4 (parser.sv0 block_stmt_sidecar_push). d4 == 0 → no
   sidecar (hand-built test arenas) → legacy sf + si fallback. */
fn block_stmt_index(pp: Vec<i32>, stmts_first: i32, sidecar: i32, si: i32) -> i32 {
    if sidecar > 0 {
        return vec_get(pp, sidecar - 1 + si);
    }
    return stmts_first + si;
}

fn resolve_expr(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                ed3: Vec<i32>, ed4: Vec<i32>, idx: i32,
                source: string, starts: Vec<i32>, ends: Vec<i32>,
                mod_vals: Vec<i32>, mod_tys: Vec<i32>,
                fn_arities: Vec<i32>, frames: Vec<i32>,
                pp: Vec<i32>) -> i32 {
    if idx < 0 { return 0; }
    let tag: i32 = vec_get(et, idx);
    if tag == 0 { return 0; }
    if tag == 1 {
        let pps: i32 = vec_get(ed1, idx);
        let ppc: i32 = vec_get(ed2, idx);
        let path: Vec<i32> = vec_new();
        let mut k: i32 = 0;
        while k < ppc {
            vec_push(path, vec_get(pp, pps + k));
            k = k + 1;
        }
        let ps: string = path_join_vec(source, starts, ends, path);
        if res_full_value_exists(mod_vals, frames, ps,
                                  source, starts, ends) {
            return 0;
        }
        /* Intrinsic/builtin values (println, string_*, vec_*, box_*, host I/O, …)
           are not defined in the source and are not registered in the module env,
           so accept a 1-segment name that is_intrinsic recognises. This also
           resolves the callee of an intrinsic call, which reaches here via the
           tag-4 handler's resolve_expr(callee). */
        if ppc == 1 {
            if is_intrinsic(ps) {
                return 0;
            }
            /* `result` in a requires/ensures clause is the function's return value
               (SML binds it in the contract env: resolver.sml). Accept it here. */
            if string_eq(ps, "result") {
                return 0;
            }
        }
        /* 2-segment enum-variant constructor path (EnumType::Variant). The
           resolver only registers enum type names (not per-variant qualified
           paths), and is a coarse existence pass — the checker validates the
           variant. Accept when the first segment is a known type. Covers a
           nullary `Color::Green` and the callee of `Opt::Some(x)`. */
        if ppc == 2 {
            let seg0: string = tok_str(source, starts, ends, vec_get(pp, pps));
            if res_type_exists(mod_tys, seg0, source, starts, ends) {
                return 0;
            }
        }
        return diag_pack(300, vec_get(pp, pps));
    }
    if tag == 2 {
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed2, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 3 {
        let r1: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed2, idx),
                                    source, starts, ends,
                                    mod_vals, mod_tys, fn_arities, frames, pp);
        if r1 != 0 { return r1; }
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed3, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 4 {
        let callee: i32 = vec_get(ed1, idx);
        let args_first: i32 = vec_get(ed2, idx);
        let args_count: i32 = vec_get(ed3, idx);
        /* d4 = pp sidecar of arg-root indices (0 => contiguous fallback). */
        let args_sidecar: i32 = vec_get(ed4, idx);
        if vec_get(et, callee) == 1 {
            let cpps: i32 = vec_get(ed1, callee);
            let cppc: i32 = vec_get(ed2, callee);
            let cpath: Vec<i32> = vec_new();
            let mut ck: i32 = 0;
            while ck < cppc {
                vec_push(cpath, vec_get(pp, cpps + ck));
                ck = ck + 1;
            }
            let cps: string = path_join_vec(source, starts, ends, cpath);
            if cppc == 1 {
                if string_eq(cps, "forall") {
                    if args_count == 3 {
                        let binder: i32 = args_first;
                        if vec_get(et, binder) == 1 {
                            let bpos: i32 = vec_get(pp, vec_get(ed1, binder));
                            let rd: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                                        args_first + 1,
                                                        source, starts, ends,
                                                        mod_vals, mod_tys,
                                                        fn_arities, frames, pp);
                            if rd != 0 { return rd; }
                            res_enter_scope(frames);
                            res_bind_local(frames, bpos);
                            let rb: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                                        args_first + 2,
                                                        source, starts, ends,
                                                        mod_vals, mod_tys,
                                                        fn_arities, frames, pp);
                            return rb;
                        }
                    }
                }
                if string_eq(cps, "exists") {
                    if args_count == 3 {
                        let binder: i32 = args_first;
                        if vec_get(et, binder) == 1 {
                            let bpos: i32 = vec_get(pp, vec_get(ed1, binder));
                            let rd: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                                        args_first + 1,
                                                        source, starts, ends,
                                                        mod_vals, mod_tys,
                                                        fn_arities, frames, pp);
                            if rd != 0 { return rd; }
                            res_enter_scope(frames);
                            res_bind_local(frames, bpos);
                            let rb: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                                        args_first + 2,
                                                        source, starts, ends,
                                                        mod_vals, mod_tys,
                                                        fn_arities, frames, pp);
                            return rb;
                        }
                    }
                }
            }
            let arity: i32 = res_lookup_fn_arity_str(fn_arities, cps,
                                                      source, starts, ends);
            if arity >= 0 {
                if arity != args_count { return diag_pack(307, vec_get(pp, cpps)); }
            }
        }
        let rf: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, callee,
                                    source, starts, ends,
                                    mod_vals, mod_tys, fn_arities, frames, pp);
        if rf != 0 { return rf; }
        let mut ai: i32 = 0;
        while ai < args_count {
            let ra: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                        block_stmt_index(pp, args_first, args_sidecar, ai),
                                        source, starts, ends,
                                        mod_vals, mod_tys, fn_arities, frames, pp);
            if ra != 0 { return ra; }
            ai = ai + 1;
        }
        return 0;
    }
    if tag == 5 {
        let recv: i32 = vec_get(ed1, idx);
        let margs_count: i32 = vec_get(ed3, idx);
        let margs_sidecar: i32 = vec_get(ed4, idx);
        let rr: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, recv,
                                    source, starts, ends,
                                    mod_vals, mod_tys, fn_arities, frames, pp);
        if rr != 0 { return rr; }
        let mut mi: i32 = 0;
        while mi < margs_count {
            let rm: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                        block_stmt_index(pp, 0, margs_sidecar, mi),
                                        source, starts, ends,
                                        mod_vals, mod_tys, fn_arities, frames, pp);
            if rm != 0 { return rm; }
            mi = mi + 1;
        }
        return 0;
    }
    if tag == 6 {
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 7 {
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 8 {
        let ra: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                                    source, starts, ends,
                                    mod_vals, mod_tys, fn_arities, frames, pp);
        if ra != 0 { return ra; }
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed2, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 9 {
        let sf: i32 = vec_get(ed1, idx);
        let sc: i32 = vec_get(ed2, idx);
        let tail: i32 = vec_get(ed3, idx);
        let sidecar: i32 = vec_get(ed4, idx);
        res_enter_scope(frames);
        let mut si: i32 = 0;
        while si < sc {
            let rs: i32 = resolve_stmt(et, ed1, ed2, ed3, ed4,
                                        block_stmt_index(pp, sf, sidecar, si),
                                        source, starts, ends,
                                        mod_vals, mod_tys,
                                        fn_arities, frames, pp);
            if rs != 0 {
                res_exit_scope(frames);
                return rs;
            }
            si = si + 1;
        }
        if tail >= 0 {
            let rt: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, tail,
                                 source, starts, ends,
                                 mod_vals, mod_tys, fn_arities, frames, pp);
            res_exit_scope(frames);
            return rt;
        }
        res_exit_scope(frames);
        return 0;
    }
    if tag == 10 {
        let rc: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                                    source, starts, ends,
                                    mod_vals, mod_tys, fn_arities, frames, pp);
        if rc != 0 { return rc; }
        let rt: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed2, idx),
                                    source, starts, ends,
                                    mod_vals, mod_tys, fn_arities, frames, pp);
        if rt != 0 { return rt; }
        let else_idx: i32 = vec_get(ed3, idx);
        if else_idx >= 0 {
            return resolve_expr(et, ed1, ed2, ed3, ed4, else_idx,
                                 source, starts, ends,
                                 mod_vals, mod_tys, fn_arities, frames, pp);
        }
        return 0;
    }
    if tag == 11 {
        let scrut: i32 = vec_get(ed1, idx);
        let arms_f: i32 = vec_get(ed2, idx);
        let arms_c: i32 = vec_get(ed3, idx);
        let arms_sidecar: i32 = vec_get(ed4, idx);
        let rsc: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, scrut,
                                     source, starts, ends,
                                     mod_vals, mod_tys, fn_arities, frames, pp);
        if rsc != 0 { return rsc; }
        let mut ami: i32 = 0;
        while ami < arms_c {
            let arm_idx: i32 = block_stmt_index(pp, arms_f, arms_sidecar, ami);
            let arm_pat_tag: i32 = vec_get(ed1, arm_idx);
            let arm_pat_d1: i32 = vec_get(ed2, arm_idx);
            let guard: i32 = vec_get(ed3, arm_idx);
            let body: i32 = vec_get(ed4, arm_idx);
            res_enter_scope(frames);
            if arm_pat_tag == 1 {
                res_bind_local(frames, arm_pat_d1);
            }
            /* PatEnum with a tuple payload (`Variant(x, ...)`): bind each payload
               PatBind so the arm body can reference it. arm_pat_d1 is the
               ExprPatExtra index; the ExprPatEnumMeta (tag 33) just before it lists
               the ExprPatFieldEmbed (tag 31) payload rows (d4 == 1 => PatBind). */
            if arm_pat_tag == 5 {
                let argc_r: i32 = vec_get(ed3, arm_pat_d1);
                if argc_r > 0 {
                    let meta_r: i32 = arm_pat_d1 - 1;
                    if vec_get(et, meta_r) == 33 {
                        let ac_r: i32 = vec_get(ed1, meta_r);
                        let first_r: i32 = vec_get(ed2, meta_r);
                        let mut ej_r: i32 = 0;
                        while ej_r < ac_r {
                            let eidx_r: i32 = first_r + ej_r;
                            if vec_get(et, eidx_r) == 31 {
                                if vec_get(ed4, eidx_r) == 1 {
                                    res_bind_local(frames, vec_get(ed1, eidx_r));
                                }
                            }
                            ej_r = ej_r + 1;
                        }
                    }
                }
            }
            /* PatStruct enum struct-variant (`Variant { w, h }`): bind each field
               shorthand PatBind. Mirrors PatEnum(5) but the meta is ExprPatStructMeta
               (tag 32) not ExprPatEnumMeta (33). */
            if arm_pat_tag == 4 {
                let fc_r: i32 = vec_get(ed3, arm_pat_d1);
                if fc_r > 0 {
                    let meta_s: i32 = arm_pat_d1 - 1;
                    if vec_get(et, meta_s) == 32 {
                        let mc_s: i32 = vec_get(ed1, meta_s);
                        let first_s: i32 = vec_get(ed2, meta_s);
                        let mut ej_s: i32 = 0;
                        while ej_s < mc_s {
                            let eidx_s: i32 = first_s + ej_s;
                            if vec_get(et, eidx_s) == 31 {
                                if vec_get(ed4, eidx_s) == 1 {
                                    res_bind_local(frames, vec_get(ed1, eidx_s));
                                }
                            }
                            ej_s = ej_s + 1;
                        }
                    }
                }
            }
            if guard >= 0 {
                let rg: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, guard,
                                            source, starts, ends,
                                            mod_vals, mod_tys,
                                            fn_arities, frames, pp);
                if rg != 0 { return rg; }
            }
            let rb: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, body,
                                        source, starts, ends,
                                        mod_vals, mod_tys,
                                        fn_arities, frames, pp);
            if rb != 0 { return rb; }
            ami = ami + 1;
        }
        return 0;
    }
    if tag == 12 {
        let cond: i32 = vec_get(ed1, idx);
        let wbody: i32 = vec_get(ed2, idx);
        let inv_f: i32 = vec_get(ed3, idx);
        let inv_c: i32 = vec_get(ed4, idx);
        let rwc: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, cond,
                                     source, starts, ends,
                                     mod_vals, mod_tys, fn_arities, frames, pp);
        if rwc != 0 { return rwc; }
        let mut ii: i32 = 0;
        while ii < inv_c {
            /* inv_f is a `pp`-sidecar HANDLE (from parser.sv0's
               block_stmt_sidecar_push: `off + 1` into the shared pp
               pool), not a direct et-arena index — the same sidecar
               indirection block_stmt_index already exists to decode for
               block statements and match arms. Using `inv_f + ii`
               directly as an et index (as this did before) reads
               whatever unrelated et node happens to sit at that much
               smaller pp-pool-derived position — landing on some
               EARLIER, unrelated function's expression node and
               reporting a bogus "unbound name" there instead of
               resolving the real loop_invariant clause. Found while
               adding sv0-mathlib's first loop_invariant in a
               multi-function file (R0.1, frac_floor_of_nonneg): any
               `while ... loop_invariant(...) { ... }` anywhere in a file
               broke name resolution for an unrelated, EARLIER function
               (e.g. `clamp_i32`'s own `requires(lo <= hi)`), confirmed
               via the identical bare `loop_invariant(true)` (content
               doesn't matter, only presence). */
            let ri: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                        block_stmt_index(pp, 0 - 1, inv_f, ii),
                                        source, starts, ends,
                                        mod_vals, mod_tys,
                                        fn_arities, frames, pp);
            if ri != 0 { return ri; }
            ii = ii + 1;
        }
        return resolve_expr(et, ed1, ed2, ed3, ed4, wbody,
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 13 {
        let pat_tok: i32 = vec_get(ed1, idx);
        let iter: i32 = vec_get(ed2, idx);
        let fbody: i32 = vec_get(ed3, idx);
        let rit: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, iter,
                                     source, starts, ends,
                                     mod_vals, mod_tys, fn_arities, frames, pp);
        if rit != 0 { return rit; }
        res_enter_scope(frames);
        res_bind_local(frames, pat_tok);
        return resolve_expr(et, ed1, ed2, ed3, ed4, fbody,
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 14 {
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 15 {
        let rv: i32 = vec_get(ed1, idx);
        if rv >= 0 {
            return resolve_expr(et, ed1, ed2, ed3, ed4, rv,
                                 source, starts, ends,
                                 mod_vals, mod_tys, fn_arities, frames, pp);
        }
        return 0;
    }
    if tag == 16 {
        let bv: i32 = vec_get(ed1, idx);
        if bv >= 0 {
            return resolve_expr(et, ed1, ed2, ed3, ed4, bv,
                                 source, starts, ends,
                                 mod_vals, mod_tys, fn_arities, frames, pp);
        }
        return 0;
    }
    if tag == 17 { return 0; }
    if tag == 18 {
        let ra: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                                    source, starts, ends,
                                    mod_vals, mod_tys, fn_arities, frames, pp);
        if ra != 0 { return ra; }
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed2, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 19 {
        let ra: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed2, idx),
                                    source, starts, ends,
                                    mod_vals, mod_tys, fn_arities, frames, pp);
        if ra != 0 { return ra; }
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed3, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 20 {
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 21 {
        let lo: i32 = vec_get(ed1, idx);
        let hi: i32 = vec_get(ed2, idx);
        if lo >= 0 {
            let rl: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, lo,
                                        source, starts, ends,
                                        mod_vals, mod_tys, fn_arities, frames, pp);
            if rl != 0 { return rl; }
        }
        if hi >= 0 {
            return resolve_expr(et, ed1, ed2, ed3, ed4, hi,
                                 source, starts, ends,
                                 mod_vals, mod_tys, fn_arities, frames, pp);
        }
        return 0;
    }
    if tag == 22 {
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 23 {
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 24 {
        let spps: i32 = vec_get(ed1, idx);
        let sppc: i32 = vec_get(ed2, idx);
        let sfc: i32 = vec_get(ed3, idx);
        let spath: Vec<i32> = vec_new();
        let mut sk: i32 = 0;
        while sk < sppc {
            vec_push(spath, vec_get(pp, spps + sk));
            sk = sk + 1;
        }
        let sps: string = path_join_vec(source, starts, ends, spath);
        if res_type_exists(mod_tys, sps, source, starts, ends) != true {
            return 301;
        }
        let mut sfi: i32 = 0;
        while sfi < sfc {
            let rfe: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                         idx - sfc + sfi,
                                         source, starts, ends,
                                         mod_vals, mod_tys,
                                         fn_arities, frames, pp);
            if rfe != 0 { return rfe; }
            sfi = sfi + 1;
        }
        return 0;
    }
    if tag == 25 {
        let tf: i32 = vec_get(ed1, idx);
        let tc: i32 = vec_get(ed2, idx);
        let mut ti: i32 = 0;
        while ti < tc {
            let rte: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                         tf + ti,
                                         source, starts, ends,
                                         mod_vals, mod_tys,
                                         fn_arities, frames, pp);
            if rte != 0 { return rte; }
            ti = ti + 1;
        }
        return 0;
    }
    if tag == 26 {
        let af: i32 = vec_get(ed1, idx);
        let ac: i32 = vec_get(ed2, idx);
        let mut ari: i32 = 0;
        while ari < ac {
            let rae: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                         af + ari,
                                         source, starts, ends,
                                         mod_vals, mod_tys,
                                         fn_arities, frames, pp);
            if rae != 0 { return rae; }
            ari = ari + 1;
        }
        return 0;
    }
    return 0;
}

/* ── resolve_stmt (SML resolveStmt) ──────────────────────────
   Handles LetStmt(27) and SemiStmt(28) in the expr arena.
   LetStmt binds the local variable in the current scope.
   Type annotations are local to parser — validation deferred. */

fn resolve_stmt(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                ed3: Vec<i32>, ed4: Vec<i32>, idx: i32,
                source: string, starts: Vec<i32>, ends: Vec<i32>,
                mod_vals: Vec<i32>, mod_tys: Vec<i32>,
                fn_arities: Vec<i32>, frames: Vec<i32>,
                pp: Vec<i32>) -> i32 {
    let tag: i32 = vec_get(et, idx);
    if tag == 27 {
        let init: i32 = vec_get(ed3, idx);
        if init >= 0 {
            let ri: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, init,
                                        source, starts, ends,
                                        mod_vals, mod_tys,
                                        fn_arities, frames, pp);
            if ri != 0 { return ri; }
        }
        let name_pos: i32 = vec_get(ed1, idx);
        res_bind_local(frames, name_pos);
        return 0;
    }
    if tag == 28 {
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    return resolve_expr(et, ed1, ed2, ed3, ed4, idx,
                         source, starts, ends,
                         mod_vals, mod_tys, fn_arities, frames, pp);
}

/* ── resolve_contract (SML resolveContract) ───────────────── */

fn resolve_contract(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                    ed3: Vec<i32>, ed4: Vec<i32>, idx: i32,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    mod_vals: Vec<i32>, mod_tys: Vec<i32>,
                    fn_arities: Vec<i32>, frames: Vec<i32>,
                    pp: Vec<i32>) -> i32 {
    return resolve_expr(et, ed1, ed2, ed3, ed4, idx,
                         source, starts, ends,
                         mod_vals, mod_tys, fn_arities, frames, pp);
}

fn resolve_expr_cast_roots_program(et: Vec<i32>, ed2: Vec<i32>,
                                   pty_tt: Vec<i32>, pty_td1: Vec<i32>,
                                   pty_td2: Vec<i32>, pty_td3: Vec<i32>,
                                   source: string, starts: Vec<i32>,
                                   ends: Vec<i32>,
                                   mod_tys: Vec<i32>, mod_vals: Vec<i32>,
                                   pp: Vec<i32>, tparam_names: Vec<i32>) -> i32 {
    let mut i: i32 = 0;
    let n: i32 = vec_len(et);
    let tn: i32 = vec_len(pty_tt);
    while i < n {
        if vec_get(et, i) == 20 {
            let tr: i32 = vec_get(ed2, i);
            if tr >= 0 {
                if tr < tn {
                    let rr: i32 = resolve_ty(pty_tt, pty_td1, pty_td2, pty_td3, tr,
                                             source, starts, ends, mod_tys, mod_vals, pp,
                                             tparam_names);
                    if rr != 0 { return rr; }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

/* ── apply_use_clause (SML applyUseClause) ───────────────────
   Processes a single ItemUse. Constructs the mangled target name
   (module__item), checks if it exists as a function or type,
   and registers the short alias in the environment.
   Assumes item names are already mangled (link phase complete).
   Enum variant alias registration deferred — variant names are
   local to parser and not stored in item arena.
   Returns 0 on success, 309 on unknown module item. */

fn apply_use_clause(it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
                    idx: i32,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    mod_vals: Vec<i32>, mod_tys: Vec<i32>,
                    fn_arities: Vec<i32>,
                    pp: Vec<i32>) -> i32 {
    let tag: i32 = vec_get(it, idx);
    if tag != 5 { return 0; }
    let pps: i32 = vec_get(id1, idx);
    let ppc: i32 = vec_get(id2, idx);
    if ppc != 2 { return 309; }
    let m_tok: i32 = vec_get(pp, pps);
    let nm_tok: i32 = vec_get(pp, pps + 1);
    let m_str: string = tok_str(source, starts, ends, m_tok);
    let nm_str: string = tok_str(source, starts, ends, nm_tok);
    let tgt: string = mangle_use_target(m_str, nm_str);
    let arity: i32 = res_lookup_fn_arity_str(fn_arities, tgt,
                                              source, starts, ends);
    if arity >= 0 {
        vec_push(mod_vals, nm_tok);
        vec_push(fn_arities, nm_tok);
        vec_push(fn_arities, arity);
        return 0;
    }
    if res_type_exists(mod_tys, tgt, source, starts, ends) {
        vec_push(mod_tys, nm_tok);
        return 0;
    }
    /* PC-2e collision-free fallback: sv0's linkProjectDir merges modules WITHOUT
       mangling top-level names (unlike the SML reference — see
       doc/pc3b-linkprojectdir-scoping.md §5e/§5f, the token-model defining-name
       mangle breaks check_program's forward param scan). So in a merged program
       `use lib::make` finds the bare `make`/`Signal` definition, not `lib__make`.
       Register the short alias against the unmangled target. */
    let uarity: i32 = res_lookup_fn_arity_str(fn_arities, nm_str,
                                              source, starts, ends);
    if uarity >= 0 {
        vec_push(mod_vals, nm_tok);
        vec_push(fn_arities, nm_tok);
        vec_push(fn_arities, uarity);
        return 0;
    }
    if res_type_exists(mod_tys, nm_str, source, starts, ends) {
        vec_push(mod_tys, nm_tok);
        return 0;
    }
    return 309;
}

fn apply_use_clauses(it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
                     id3: Vec<i32>, id4: Vec<i32>,
                     source: string, starts: Vec<i32>, ends: Vec<i32>,
                     mod_vals: Vec<i32>, mod_tys: Vec<i32>,
                     fn_arities: Vec<i32>,
                     pp: Vec<i32>) -> i32 {
    let len: i32 = vec_len(it);
    let mut i: i32 = 0;
    while i < len {
        if vec_get(it, i) == 5 {
            let r: i32 = apply_use_clause(it, id1, id2, i,
                                           source, starts, ends,
                                           mod_vals, mod_tys,
                                           fn_arities, pp);
            if r != 0 { return r; }
        }
        i = i + 1;
    }
    return 0;
}

/* ── resolve_top_item (SML resolveTopItem) ────────────────────
   ItemFn (tag 0): bind param names then resolve_expr on body_root.
   ItemStruct (tag 1): resolve_ty each field type root in struct_field_ty_root
   (parallel to struct_field_name_toks; base id3, count id2).
   ItemEnum (tag 2): resolve_ty each variant payload root (enum_variant_payload_ty_root
   slice; base/count per item).
   ItemTypeAlias (tag 7): id2 is type arena root index (program pty_tt).
   ItemTrait / ItemImpl (tags 3, 4): parent rows no-op at top level (methods are ItemFn rows).
   ItemModule / ItemUse (tags 5, 6): no-op here (registration/use elsewhere). */

fn resolve_top_item(it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
                    id3: Vec<i32>, id4: Vec<i32>, id5: Vec<i32>,
                    idx: i32,
                    et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                    ed3: Vec<i32>, ed4: Vec<i32>,
                    fn_param_name_toks: Vec<i32>,
                    fn_param_ty_root: Vec<i32>,
                    fn_ret_ty_root_by_item: Vec<i32>,
                    fn_contract_base_by_item: Vec<i32>,
                    fn_contract_root: Vec<i32>,
                    enum_variant_payload_ty_root: Vec<i32>,
                    enum_variant_payload_base_by_item: Vec<i32>,
                    enum_variant_payload_count_by_item: Vec<i32>,
                    pty_tt: Vec<i32>, pty_td1: Vec<i32>, pty_td2: Vec<i32>,
                    pty_td3: Vec<i32>, struct_field_ty_root: Vec<i32>,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    mod_vals: Vec<i32>, mod_tys: Vec<i32>,
                    fn_arities: Vec<i32>,
                    pp: Vec<i32>, tparam_names: Vec<i32>) -> i32 {
    let tag: i32 = vec_get(it, idx);
    if tag == 5 { return 0; }
    if tag == 6 { return 0; }
    if tag == 0 {
        let body_root: i32 = vec_get(id4, idx);
        let param_count: i32 = vec_get(id3, idx);
        let pbase: i32 = vec_get(id5, idx);
        let frames: Vec<i32> = vec_new();
        let mut pti: i32 = 0;
        while pti < param_count {
            let tr: i32 = vec_get(fn_param_ty_root, pbase + pti);
            let rty: i32 = resolve_ty(pty_tt, pty_td1, pty_td2, pty_td3, tr,
                                      source, starts, ends, mod_tys, mod_vals, pp,
                                      tparam_names);
            if rty != 0 { return rty; }
            pti = pti + 1;
        }
        let ret_root: i32 = vec_get(fn_ret_ty_root_by_item, idx);
        if ret_root >= 0 {
            let rr: i32 = resolve_ty(pty_tt, pty_td1, pty_td2, pty_td3, ret_root,
                                     source, starts, ends, mod_tys, mod_vals, pp,
                                     tparam_names);
            if rr != 0 { return rr; }
        }
        res_enter_scope(frames);
        let mut pi: i32 = 0;
        while pi < param_count {
            let tok: i32 = vec_get(fn_param_name_toks, pbase + pi);
            if tok >= 0 {
                res_bind_local(frames, tok);
            }
            pi = pi + 1;
        }
        let cbase: i32 = vec_get(fn_contract_base_by_item, idx);
        let ccount: i32 = vec_get(id2, idx) / 2;
        let mut ci: i32 = 0;
        while ci < ccount {
            let cr: i32 = vec_get(fn_contract_root, cbase + ci);
            let rc: i32 = resolve_contract(et, ed1, ed2, ed3, ed4, cr,
                                           source, starts, ends,
                                           mod_vals, mod_tys,
                                           fn_arities, frames, pp);
            if rc != 0 { return rc; }
            ci = ci + 1;
        }
        return resolve_expr(et, ed1, ed2, ed3, ed4, body_root,
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 1 {
        let fc: i32 = vec_get(id2, idx);
        let sfb: i32 = vec_get(id3, idx);
        let mut fi: i32 = 0;
        while fi < fc {
            let tr: i32 = vec_get(struct_field_ty_root, sfb + fi);
            let rr: i32 = resolve_ty(pty_tt, pty_td1, pty_td2, pty_td3, tr,
                                      source, starts, ends, mod_tys, mod_vals, pp,
                                      tparam_names);
            if rr != 0 { return rr; }
            fi = fi + 1;
        }
        return 0;
    }
    if tag == 2 {
        let base: i32 = vec_get(enum_variant_payload_base_by_item, idx);
        let cnt: i32 = vec_get(enum_variant_payload_count_by_item, idx);
        let mut vi: i32 = 0;
        while vi < cnt {
            let tr: i32 = vec_get(enum_variant_payload_ty_root, base + vi);
            let rr: i32 = resolve_ty(pty_tt, pty_td1, pty_td2, pty_td3, tr,
                                     source, starts, ends, mod_tys, mod_vals, pp,
                                     tparam_names);
            if rr != 0 { return rr; }
            vi = vi + 1;
        }
        return 0;
    }
    if tag == 7 {
        let alias_root: i32 = vec_get(id2, idx);
        return resolve_ty(pty_tt, pty_td1, pty_td2, pty_td3, alias_root,
                           source, starts, ends, mod_tys, mod_vals, pp,
                           tparam_names);
    }
    return 0;
}

/* ── resolve_program (SML resolve) ────────────────────────────
   Top-level entry: register intrinsics → register_items →
   apply_use_clauses → resolve_top_items.
   Returns 0 on success, error code on failure. */

/* resolve_program: top-level entry. Caller is responsible for
   registering intrinsics before calling this function (using
   register_all_intrinsics with the appropriate token handles
   from the program's token stream). This function orchestrates:
   register_items → apply_use_clauses → resolve_top_items. */

fn resolve_program(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                   ed3: Vec<i32>, ed4: Vec<i32>,
                   it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
                   id3: Vec<i32>, id4: Vec<i32>, id5: Vec<i32>,
                   fn_param_name_toks: Vec<i32>,
                   fn_param_ty_root: Vec<i32>,
                   fn_ret_ty_root_by_item: Vec<i32>,
                   fn_contract_base_by_item: Vec<i32>,
                   fn_contract_root: Vec<i32>,
                   enum_variant_payload_ty_root: Vec<i32>,
                   enum_variant_payload_base_by_item: Vec<i32>,
                   enum_variant_payload_count_by_item: Vec<i32>,
                   pty_tt: Vec<i32>, pty_td1: Vec<i32>, pty_td2: Vec<i32>,
                   pty_td3: Vec<i32>, struct_field_ty_root: Vec<i32>,
                   source: string, starts: Vec<i32>, ends: Vec<i32>,
                   mod_vals: Vec<i32>, mod_tys: Vec<i32>,
                   fn_arities: Vec<i32>,
                   pp: Vec<i32>, tparam_names: Vec<i32>) -> i32 {
    register_items(it, id1, id2, id3, id4,
                   mod_vals, mod_tys, fn_arities);
    let ru: i32 = apply_use_clauses(it, id1, id2, id3, id4,
                                     source, starts, ends,
                                     mod_vals, mod_tys,
                                     fn_arities, pp);
    if ru != 0 { return ru; }
    let rcast: i32 = resolve_expr_cast_roots_program(et, ed2,
                                                     pty_tt, pty_td1,
                                                     pty_td2, pty_td3,
                                                     source, starts, ends,
                                                     mod_tys, mod_vals, pp,
                                                     tparam_names);
    if rcast != 0 { return rcast; }
    let len: i32 = vec_len(it);
    let mut i: i32 = 0;
    while i < len {
        let r: i32 = resolve_top_item(it, id1, id2, id3, id4, id5, i,
                                       et, ed1, ed2, ed3, ed4,
                                       fn_param_name_toks,
                                       fn_param_ty_root,
                                       fn_ret_ty_root_by_item,
                                       fn_contract_base_by_item,
                                       fn_contract_root,
                                       enum_variant_payload_ty_root,
                                       enum_variant_payload_base_by_item,
                                       enum_variant_payload_count_by_item,
                                       pty_tt, pty_td1, pty_td2, pty_td3,
                                       struct_field_ty_root,
                                       source, starts, ends,
                                       mod_vals, mod_tys,
                                       fn_arities, pp, tparam_names);
        if r != 0 { return r; }
        i = i + 1;
    }
    return 0;
}

/* ── tests ──────────────────────────────────────────────────── */

fn test_path_join() -> i32 {
    if string_eq(path_join2("Foo", "Bar"), "Foo::Bar") != true { return 1; }
    if string_eq(path_join2("mod", "fn"), "mod::fn") != true { return 2; }
    return 0;
}

fn test_mangle_use() -> i32 {
    if string_eq(mangle_use_target("mymod", "foo"), "mymod__foo") != true { return 1; }
    if string_eq(mangle_use_target("a", "b"), "a__b") != true { return 2; }
    return 0;
}

fn test_is_intrinsic() -> i32 {
    if is_intrinsic("println") != true { return 1; }
    if is_intrinsic("vec_new") != true { return 2; }
    if is_intrinsic("box_deref") != true { return 3; }
    if is_intrinsic("foo") != false { return 4; }
    if is_intrinsic("main") != false { return 5; }
    return 0;
}

fn test_intrinsic_arity() -> i32 {
    if intrinsic_arity("println") != 1 { return 1; }
    if intrinsic_arity("forall") != 3 { return 2; }
    if intrinsic_arity("vec_new") != 0 { return 3; }
    if intrinsic_arity("string_substr") != 3 { return 4; }
    if intrinsic_arity("unknown") != 0 - 1 { return 5; }
    return 0;
}

fn test_intrinsic_classify() -> i32 {
    if is_string_intrinsic("string_len") != true { return 1; }
    if is_string_intrinsic("string_substr") != true { return 2; }
    if is_string_intrinsic("println") != false { return 3; }
    if is_vec_intrinsic("vec_new") != true { return 4; }
    if is_vec_intrinsic("vec_set") != true { return 5; }
    if is_vec_intrinsic("println") != false { return 6; }
    if is_box_intrinsic("box_new") != true { return 7; }
    if is_box_intrinsic("vec_new") != false { return 8; }
    if intrinsic_count() != 17 { return 9; }
    return 0;
}

fn test_item_classify() -> i32 {
    if item_registers_fn(0) != true { return 1; }
    if item_registers_fn(1) != false { return 2; }
    if item_registers_type(1) != true { return 3; }
    if item_registers_type(2) != true { return 4; }
    if item_registers_type(3) != true { return 5; }
    if item_registers_type(7) != true { return 6; }
    if item_registers_type(0) != false { return 7; }
    if item_registers_type(4) != false { return 8; }
    if item_registers_variants(2) != true { return 9; }
    if item_registers_variants(1) != false { return 10; }
    if item_is_use(5) != true { return 11; }
    if item_is_use(0) != false { return 12; }
    if item_is_module(6) != true { return 13; }
    if item_needs_registration(0) != true { return 14; }
    if item_needs_registration(5) != false { return 15; }
    return 0;
}

fn test_variant_arity() -> i32 {
    if enum_variant_arity(0, 0, 0) != 0 { return 1; }
    if enum_variant_arity(1, 3, 0) != 3 { return 2; }
    if enum_variant_arity(2, 0, 5) != 5 { return 3; }
    let qp: string = enum_variant_qualified_path("Color", "Red");
    if string_eq(qp, "Color::Red") != true { return 4; }
    return 0;
}

fn test_pat_binds() -> i32 {
    if pat_binds_count(0, 0) != 0 { return 1; }
    if pat_binds_count(1, 0) != 1 { return 2; }
    if pat_binds_count(2, 0) != 0 { return 3; }
    if pat_binds_count(3, 3) != 3 { return 4; }
    if pat_binds_count(5, 2) != 2 { return 5; }
    if pat_binds_count(6, 0) != 255 { return 6; }
    if pat_is_or(6) != true { return 7; }
