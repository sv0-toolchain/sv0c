/* Phase 2 real pipeline module: sml/name_resolution/resolver.sml -> sv0.
   Name resolution utilities: path-to-string joining (2-seg and Vec),
   intrinsic registration (17 builtins with string+arity lookup +
   register_all_intrinsics into env fn_arities/mod_values), import
   alias management (Vec-based add/lookup/reset), item registration
   dispatch (by item tag), pattern-bind counting, variant-arity
   extraction, context rules (allowSelf), error codes, arity checks,
   pat_binds (SML patBinds — collects bound var handles from flat
   patterns into Vec), bind_pattern_locals (SML bindPatternLocals),
   register_item/register_items (SML registerItem — item arena to
   env registration pass; enum variant registration deferred),
   inline env lookups (tok_str, res_is_prelude_type, res_value_exists,
   res_type_exists — string-based name comparison via token stream),
   resolve_pat_shape (SML resolvePatShape — pattern name validation),
   resolve_ty (SML resolveTy — type name validation; TyArray size expr
   deferred to resolve_expr),
   scope management (res_enter_scope, res_bind_local,
   res_lookup_in_frames_str, res_full_value_exists,
   res_lookup_fn_arity_str),
   resolve_expr (SML resolveExpr — 27 expr tag cases with scope/binding/
   arity checking; ExprCast type validation deferred — type arena local),
   resolve_stmt (SML resolveStmt — LetStmt/SemiStmt),
   resolve_contract (SML resolveContract — thin wrapper).
   Remaining: resolveFn, resolveStruct/Enum/Trait/Impl, resolveTopItem,
   applyUseClause, resolve (top-level entry). */

/* ── path joining ───────────────────────────────────────────── */

fn path_join2(a: string, b: string) -> string {
    let ab: string = string_concat(a, "::");
    return string_concat(ab, b);
}

fn mangle_use_target(mod_name: string, item_name: string) -> string {
    let a: string = string_concat(mod_name, "__");
    return string_concat(a, item_name);
}

/* ── generalized path → string ─────────────────────────────────
   path_join_vec: joins token-stream path segments with "::".
   path_indices is the Vec<i32> of token positions from parse_path.
   Extracts each segment's text via source/starts/ends. */

fn path_join_vec(source: string, starts: Vec<i32>, ends: Vec<i32>,
                 path_indices: Vec<i32>) -> string {
    let n: i32 = vec_len(path_indices);
    if n == 0 { return ""; }
    let first_pos: i32 = vec_get(path_indices, 0);
    let fs: i32 = vec_get(starts, first_pos);
    let fe: i32 = vec_get(ends, first_pos);
    let mut out: string = string_substr(source, fs, fe - fs);
    let mut i: i32 = 1;
    while i < n {
        out = string_concat(out, "::");
        let pos: i32 = vec_get(path_indices, i);
        let s: i32 = vec_get(starts, pos);
        let e: i32 = vec_get(ends, pos);
        let seg: string = string_substr(source, s, e - s);
        out = string_concat(out, seg);
        i = i + 1;
    }
    return out;
}

/* ── import alias management ───────────────────────────────────
   Interleaved Vec<i32>: [from0, to0, from1, to1, ...].
   from/to are interned string handles. */

fn import_alias_new() -> Vec<i32> {
    return vec_new();
}

fn import_alias_add(aliases: Vec<i32>, from_handle: i32, to_handle: i32) -> i32 {
    vec_push(aliases, from_handle);
    vec_push(aliases, to_handle);
    return vec_len(aliases) / 2;
}

fn import_alias_count(aliases: Vec<i32>) -> i32 {
    return vec_len(aliases) / 2;
}

fn import_alias_lookup(aliases: Vec<i32>, name_handle: i32) -> i32 {
    let n: i32 = vec_len(aliases);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(aliases, i) == name_handle {
            return vec_get(aliases, i + 1);
        }
        i = i + 2;
    }
    return 0 - 1;
}

/* import_alias_reset: in SML this is `recordedImportAliases := []`.
   In sv0, the caller discards the old Vec and calls import_alias_new()
   for a fresh list. No in-place clear needed. */

/* ── intrinsic function registry (string-based) ─────────────── */

/* 17 intrinsics from withIntrinsics in resolver.sml:
   println(1), old(1), forall(3), exists(3), no_alias(2),
   string_len(1), string_eq(2), string_concat(2),
   string_char_at(2), string_substr(3),
   vec_new(0), vec_push(2), vec_len(1), vec_get(2), vec_set(3),
   box_new(1), box_deref(1). */

fn is_intrinsic(name: string) -> bool {
    if string_eq(name, "println") { return true; }
    if string_eq(name, "old") { return true; }
    if string_eq(name, "forall") { return true; }
    if string_eq(name, "exists") { return true; }
    if string_eq(name, "no_alias") { return true; }
    if string_eq(name, "string_len") { return true; }
    if string_eq(name, "string_eq") { return true; }
    if string_eq(name, "string_concat") { return true; }
    if string_eq(name, "string_char_at") { return true; }
    if string_eq(name, "string_substr") { return true; }
    if string_eq(name, "vec_new") { return true; }
    if string_eq(name, "vec_push") { return true; }
    if string_eq(name, "vec_len") { return true; }
    if string_eq(name, "vec_get") { return true; }
    if string_eq(name, "vec_set") { return true; }
    if string_eq(name, "box_new") { return true; }
    if string_eq(name, "box_deref") { return true; }
    return false;
}

fn intrinsic_arity(name: string) -> i32 {
    if string_eq(name, "println") { return 1; }
    if string_eq(name, "old") { return 1; }
    if string_eq(name, "forall") { return 3; }
    if string_eq(name, "exists") { return 3; }
    if string_eq(name, "no_alias") { return 2; }
    if string_eq(name, "string_len") { return 1; }
    if string_eq(name, "string_eq") { return 2; }
    if string_eq(name, "string_concat") { return 2; }
    if string_eq(name, "string_char_at") { return 2; }
    if string_eq(name, "string_substr") { return 3; }
    if string_eq(name, "vec_new") { return 0; }
    if string_eq(name, "vec_push") { return 2; }
    if string_eq(name, "vec_len") { return 1; }
    if string_eq(name, "vec_get") { return 2; }
    if string_eq(name, "vec_set") { return 3; }
    if string_eq(name, "box_new") { return 1; }
    if string_eq(name, "box_deref") { return 1; }
    return 0 - 1;
}

fn intrinsic_count() -> i32 {
    return 17;
}

fn is_string_intrinsic(name: string) -> bool {
    if string_eq(name, "string_len") { return true; }
    if string_eq(name, "string_eq") { return true; }
    if string_eq(name, "string_concat") { return true; }
    if string_eq(name, "string_char_at") { return true; }
    if string_eq(name, "string_substr") { return true; }
    return false;
}

fn is_vec_intrinsic(name: string) -> bool {
    if string_eq(name, "vec_new") { return true; }
    if string_eq(name, "vec_push") { return true; }
    if string_eq(name, "vec_len") { return true; }
    if string_eq(name, "vec_get") { return true; }
    if string_eq(name, "vec_set") { return true; }
    return false;
}

fn is_box_intrinsic(name: string) -> bool {
    if string_eq(name, "box_new") { return true; }
    if string_eq(name, "box_deref") { return true; }
    return false;
}

/* ── register all intrinsics into env ───────────────────────── */

fn register_one_intrinsic(fn_arities: Vec<i32>, mod_values: Vec<i32>,
                          name: i32, arity: i32) -> i32 {
    vec_push(fn_arities, name);
    vec_push(fn_arities, arity);
    vec_push(mod_values, name);
    return 0;
}

fn register_all_intrinsics(fn_arities: Vec<i32>, mod_values: Vec<i32>,
                           println_h: i32, old_h: i32, forall_h: i32,
                           exists_h: i32, no_alias_h: i32,
                           str_len_h: i32, str_eq_h: i32,
                           str_concat_h: i32, str_char_at_h: i32,
                           str_substr_h: i32,
                           vec_new_h: i32, vec_push_h: i32,
                           vec_len_h: i32, vec_get_h: i32,
                           vec_set_h: i32,
                           box_new_h: i32, box_deref_h: i32) -> i32 {
    register_one_intrinsic(fn_arities, mod_values, println_h, 1);
    register_one_intrinsic(fn_arities, mod_values, old_h, 1);
    register_one_intrinsic(fn_arities, mod_values, forall_h, 3);
    register_one_intrinsic(fn_arities, mod_values, exists_h, 3);
    register_one_intrinsic(fn_arities, mod_values, no_alias_h, 2);
    register_one_intrinsic(fn_arities, mod_values, str_len_h, 1);
    register_one_intrinsic(fn_arities, mod_values, str_eq_h, 2);
    register_one_intrinsic(fn_arities, mod_values, str_concat_h, 2);
    register_one_intrinsic(fn_arities, mod_values, str_char_at_h, 2);
    register_one_intrinsic(fn_arities, mod_values, str_substr_h, 3);
    register_one_intrinsic(fn_arities, mod_values, vec_new_h, 0);
    register_one_intrinsic(fn_arities, mod_values, vec_push_h, 2);
    register_one_intrinsic(fn_arities, mod_values, vec_len_h, 1);
    register_one_intrinsic(fn_arities, mod_values, vec_get_h, 2);
    register_one_intrinsic(fn_arities, mod_values, vec_set_h, 3);
    register_one_intrinsic(fn_arities, mod_values, box_new_h, 1);
    register_one_intrinsic(fn_arities, mod_values, box_deref_h, 1);
    return 17;
}

/* ── item registration classification ───────────────────────── */

/* Item tags from ast.sv0: 0=ItemFn, 1=ItemStruct, 2=ItemEnum,
   3=ItemTrait, 4=ItemImpl, 5=ItemUse, 6=ItemModule, 7=ItemTypeAlias. */

fn item_registers_fn(tag: i32) -> bool {
    return tag == 0;
}

fn item_registers_type(tag: i32) -> bool {
    if tag == 1 { return true; }
    if tag == 2 { return true; }
    if tag == 3 { return true; }
    if tag == 7 { return true; }
    return false;
}

fn item_registers_variants(tag: i32) -> bool {
    return tag == 2;
}

fn item_is_use(tag: i32) -> bool {
    return tag == 5;
}

fn item_is_module(tag: i32) -> bool {
    return tag == 6;
}

fn item_needs_registration(tag: i32) -> bool {
    if item_registers_fn(tag) { return true; }
    if item_registers_type(tag) { return true; }
    return false;
}

/* ── variant arity extraction ───────────────────────────────── */

/* Variant kinds: 0=VariantUnit, 1=VariantTuple, 2=VariantStruct. */
fn enum_variant_arity(variant_kind: i32, tuple_fields: i32,
                      struct_fields: i32) -> i32 {
    if variant_kind == 0 { return 0; }
    if variant_kind == 1 { return tuple_fields; }
    if variant_kind == 2 { return struct_fields; }
    return 0;
}

fn enum_variant_qualified_path(enum_name: string,
                               variant_name: string) -> string {
    return path_join2(enum_name, variant_name);
}

fn variant_stem(variant_kind: i32, name_handle: i32) -> i32 {
    return name_handle;
}

fn enum_variant_reg_path(enum_name: string,
                         variant_name: string) -> string {
    return enum_variant_qualified_path(enum_name, variant_name);
}

fn enum_variant_reg_arity(variant_kind: i32, tuple_fields: i32,
                          struct_fields: i32) -> i32 {
    return enum_variant_arity(variant_kind, tuple_fields, struct_fields);
}

/* ── pattern-bind counting ──────────────────────────────────── */

/* Pat tags: 0=PatWild, 1=PatBind, 2=PatLit, 3=PatTuple,
   4=PatStruct, 5=PatEnum, 6=PatOr. */
fn pat_binds_count(pat_tag: i32, child_count: i32) -> i32 {
    if pat_tag == 0 { return 0; }
    if pat_tag == 1 { return 1; }
    if pat_tag == 2 { return 0; }
    if pat_tag == 3 { return child_count; }
    if pat_tag == 4 { return child_count; }
    if pat_tag == 5 { return child_count; }
    if pat_tag == 6 { return 255; }
    return 0;
}

fn pat_is_or(pat_tag: i32) -> bool {
    return pat_tag == 6;
}

/* SML patBinds: collects bound variable name handles from a flat
   pattern.  In the bootstrap sv0, patterns are not yet recursive
   (no Box<Pat>), so this handles the flat cases:
     PatWild (0) → nothing
     PatBind (1) → push name handle
     PatLit  (2) → nothing
   For compound patterns (PatTuple/PatStruct/PatEnum), the caller
   must iterate sub-patterns and call pat_binds on each.
   PatOr (6) is unsupported (SML raises Fail). */
fn pat_binds(pat_tag: i32, name_handle: i32, out: Vec<i32>) -> i32 {
    if pat_tag == 1 {
        vec_push(out, name_handle);
        return 1;
    }
    return 0;
}

/* SML bindPatternLocals: folds patBinds result into an env.
   Takes the collected binds Vec and pushes each handle into the
   env's local names Vec. Returns the count of locals bound. */
fn bind_pattern_locals(binds: Vec<i32>, env_locals: Vec<i32>) -> i32 {
    let n: i32 = vec_len(binds);
    let mut i: i32 = 0;
    while i < n {
        vec_push(env_locals, vec_get(binds, i));
        i = i + 1;
    }
    return n;
}

/* ── context rules (allowSelf) ──────────────────────────────── */

fn should_allow_self(item_tag: i32) -> bool {
    if item_tag == 3 { return true; }
    if item_tag == 4 { return true; }
    return false;
}

/* ── resolution error codes ─────────────────────────────────── */

fn error_code_unbound_ident() -> string { return "E0300"; }
fn error_code_unknown_type() -> string { return "E0301"; }
fn error_code_pat_or_unsupported() -> string { return "E0306"; }
fn error_code_wrong_arity() -> string { return "E0307"; }
fn error_code_use_clause() -> string { return "E0309"; }

/* ── arity checking ─────────────────────────────────────────── */

fn arity_matches(expected: i32, actual: i32) -> bool {
    return expected == actual;
}

fn check_call_arity(expected: i32, actual: i32) -> i32 {
    if expected == actual { return 0; }
    if expected < 0 { return 0; }
    return 1;
}

/* ── item registration pass (SML registerItem) ────────────────
   Walks the item arena and registers names/arities in the env.
   Enum variant registration deferred — needs variant sub-arena
   with per-variant name + arity data (see transliteration-plan). */

fn register_item(item_tag: i32, item_d1: i32, item_d2: i32,
                 item_d3: i32, item_d4: i32,
                 mod_vals: Vec<i32>, mod_tys: Vec<i32>,
                 fn_arities: Vec<i32>) -> i32 {
    if item_tag == 0 {
        vec_push(mod_vals, item_d1);
        vec_push(fn_arities, item_d1);
        vec_push(fn_arities, item_d3);
        return 0;
    }
    if item_tag == 1 {
        vec_push(mod_vals, item_d1);
        vec_push(mod_tys, item_d1);
        return 0;
    }
    if item_tag == 2 {
        vec_push(mod_vals, item_d1);
        vec_push(mod_tys, item_d1);
        return 0;
    }
    if item_tag == 3 {
        vec_push(mod_tys, item_d1);
        return 0;
    }
    if item_tag == 7 {
        vec_push(mod_tys, item_d1);
        return 0;
    }
    return 0;
}

fn register_items(it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
                  id3: Vec<i32>, id4: Vec<i32>,
                  mod_vals: Vec<i32>, mod_tys: Vec<i32>,
                  fn_arities: Vec<i32>) -> i32 {
    let n: i32 = vec_len(it);
    let mut i: i32 = 0;
    while i < n {
        let tag: i32 = vec_get(it, i);
        let d1: i32 = vec_get(id1, i);
        let d2: i32 = vec_get(id2, i);
        let d3: i32 = vec_get(id3, i);
        let d4: i32 = vec_get(id4, i);
        register_item(tag, d1, d2, d3, d4,
                      mod_vals, mod_tys, fn_arities);
        i = i + 1;
    }
    return 0;
}

/* ── inline env lookups for resolver traversals ──────────────
   Each .sv0 is compiled standalone; resolver needs env-style
   lookups but cannot import from env.sv0. These operate on the
   same data structures (mod_vals/mod_tys as Vec<i32> of token
   positions, fn_arities interleaved [pos, arity, ...]).
   Lookups extract strings from the token stream for comparison
   since two occurrences of the same name have different positions. */

fn tok_str(source: string, starts: Vec<i32>, ends: Vec<i32>,
           pos: i32) -> string {
    let s: i32 = vec_get(starts, pos);
    let e: i32 = vec_get(ends, pos);
    return string_substr(source, s, e - s);
}

fn res_is_prelude_type(name: string) -> bool {
    if string_eq(name, "i8") { return true; }
    if string_eq(name, "i16") { return true; }
    if string_eq(name, "i32") { return true; }
    if string_eq(name, "i64") { return true; }
    if string_eq(name, "i128") { return true; }
    if string_eq(name, "u8") { return true; }
    if string_eq(name, "u16") { return true; }
    if string_eq(name, "u32") { return true; }
    if string_eq(name, "u64") { return true; }
    if string_eq(name, "u128") { return true; }
    if string_eq(name, "isize") { return true; }
    if string_eq(name, "usize") { return true; }
    if string_eq(name, "f32") { return true; }
    if string_eq(name, "f64") { return true; }
    if string_eq(name, "bool") { return true; }
    if string_eq(name, "char") { return true; }
    if string_eq(name, "str") { return true; }
    if string_eq(name, "string") { return true; }
    if string_eq(name, "String") { return true; }
    if string_eq(name, "unit") { return true; }
    if string_eq(name, "Vec") { return true; }
    if string_eq(name, "Box") { return true; }
    return false;
}

fn res_value_exists(mod_vals: Vec<i32>, name_str: string,
                    source: string, starts: Vec<i32>,
                    ends: Vec<i32>) -> bool {
    let len: i32 = vec_len(mod_vals);
    let mut i: i32 = 0;
    while i < len {
        let pos: i32 = vec_get(mod_vals, i);
        let nm: string = tok_str(source, starts, ends, pos);
        if string_eq(nm, name_str) { return true; }
        i = i + 1;
    }
    return false;
}

fn res_type_exists(mod_tys: Vec<i32>, name_str: string,
                   source: string, starts: Vec<i32>,
                   ends: Vec<i32>) -> bool {
    if res_is_prelude_type(name_str) { return true; }
    let len: i32 = vec_len(mod_tys);
    let mut i: i32 = 0;
    while i < len {
        let pos: i32 = vec_get(mod_tys, i);
        let nm: string = tok_str(source, starts, ends, pos);
        if string_eq(nm, name_str) { return true; }
        i = i + 1;
    }
    return false;
}

/* ── resolve_pat_shape (SML resolvePatShape) ──────────────────
   Validates that struct/enum constructor names in patterns exist
   in the env. Walks pattern arena recursively. Returns 0 on
   success, 300 for unbound constructor, 301 for unknown type,
   306 for unsupported PatOr. */

fn resolve_pat_shape(pt: Vec<i32>, pd1: Vec<i32>, pd2: Vec<i32>,
                     pd3: Vec<i32>, idx: i32,
                     source: string, starts: Vec<i32>,
                     ends: Vec<i32>,
                     mod_vals: Vec<i32>, mod_tys: Vec<i32>,
                     pp: Vec<i32>) -> i32 {
    let tag: i32 = vec_get(pt, idx);
    if tag == 0 { return 0; }
    if tag == 1 { return 0; }
    if tag == 2 { return 0; }
    if tag == 3 {
        let first: i32 = vec_get(pd1, idx);
        let count: i32 = vec_get(pd2, idx);
        let mut i: i32 = 0;
        while i < count {
            let r: i32 = resolve_pat_shape(pt, pd1, pd2, pd3, first + i,
                                            source, starts, ends,
                                            mod_vals, mod_tys, pp);
            if r != 0 { return r; }
            i = i + 1;
        }
        return 0;
    }
    if tag == 4 {
        let pps: i32 = vec_get(pd1, idx);
        let ppc: i32 = vec_get(pd2, idx);
        let fc: i32 = vec_get(pd3, idx);
        let path: Vec<i32> = vec_new();
        let mut k: i32 = 0;
        while k < ppc {
            vec_push(path, vec_get(pp, pps + k));
            k = k + 1;
        }
        let ps: string = path_join_vec(source, starts, ends, path);
        if ppc >= 2 {
            if res_value_exists(mod_vals, ps, source, starts, ends) != true {
                return 300;
            }
        } else {
            if res_type_exists(mod_tys, ps, source, starts, ends) != true {
                return 301;
            }
        }
        let mut fi: i32 = 0;
        while fi < fc {
            let child_idx: i32 = idx - fc + fi;
            let r: i32 = resolve_pat_shape(pt, pd1, pd2, pd3, child_idx,
                                            source, starts, ends,
                                            mod_vals, mod_tys, pp);
            if r != 0 { return r; }
            fi = fi + 1;
        }
        return 0;
    }
    if tag == 5 {
        let pps: i32 = vec_get(pd1, idx);
        let ppc: i32 = vec_get(pd2, idx);
        let ac: i32 = vec_get(pd3, idx);
        let path: Vec<i32> = vec_new();
        let mut k: i32 = 0;
        while k < ppc {
            vec_push(path, vec_get(pp, pps + k));
            k = k + 1;
        }
        let ps: string = path_join_vec(source, starts, ends, path);
        if res_value_exists(mod_vals, ps, source, starts, ends) != true {
            return 300;
        }
        let mut ai: i32 = 0;
        while ai < ac {
            let child_idx: i32 = idx - ac + ai;
            let r: i32 = resolve_pat_shape(pt, pd1, pd2, pd3, child_idx,
                                            source, starts, ends,
                                            mod_vals, mod_tys, pp);
            if r != 0 { return r; }
            ai = ai + 1;
        }
        return 0;
    }
    if tag == 6 { return 306; }
    return 0;
}

/* ── resolve_ty (SML resolveTy) ───────────────────────────────
   Validates that type names in the type arena exist in the env.
   Walks type arena recursively. Returns 0 on success, 301 for
   unknown type. TyArray size expression resolution deferred to
   resolve_expr (batch 20+). */

fn resolve_ty(tt: Vec<i32>, td1: Vec<i32>, td2: Vec<i32>,
              td3: Vec<i32>, idx: i32,
              source: string, starts: Vec<i32>, ends: Vec<i32>,
              mod_tys: Vec<i32>, pp: Vec<i32>) -> i32 {
    let tag: i32 = vec_get(tt, idx);
    if tag == 6 { return 0; }
    if tag == 0 {
        let pps: i32 = vec_get(td1, idx);
        let ppc: i32 = vec_get(td2, idx);
        let tac: i32 = vec_get(td3, idx);
        let path: Vec<i32> = vec_new();
        let mut k: i32 = 0;
        while k < ppc {
            vec_push(path, vec_get(pp, pps + k));
            k = k + 1;
        }
        let ps: string = path_join_vec(source, starts, ends, path);
        if res_type_exists(mod_tys, ps, source, starts, ends) != true {
            return 301;
        }
        let mut ti: i32 = 0;
        while ti < tac {
            let child_idx: i32 = idx - tac + ti;
            let r: i32 = resolve_ty(tt, td1, td2, td3, child_idx,
                                     source, starts, ends, mod_tys, pp);
            if r != 0 { return r; }
            ti = ti + 1;
        }
        return 0;
    }
    if tag == 1 {
        return resolve_ty(tt, td1, td2, td3, vec_get(td1, idx),
                           source, starts, ends, mod_tys, pp);
    }
    if tag == 2 {
        return resolve_ty(tt, td1, td2, td3, vec_get(td1, idx),
                           source, starts, ends, mod_tys, pp);
    }
    if tag == 3 {
        return resolve_ty(tt, td1, td2, td3, vec_get(td1, idx),
                           source, starts, ends, mod_tys, pp);
    }
    if tag == 4 {
        return resolve_ty(tt, td1, td2, td3, vec_get(td1, idx),
                           source, starts, ends, mod_tys, pp);
    }
    if tag == 5 {
        let first: i32 = vec_get(td1, idx);
        let count: i32 = vec_get(td2, idx);
        let mut i: i32 = 0;
        while i < count {
            let r: i32 = resolve_ty(tt, td1, td2, td3, first + i,
                                     source, starts, ends, mod_tys, pp);
            if r != 0 { return r; }
            i = i + 1;
        }
        return 0;
    }
    return 0;
}

/* ── scope management helpers ────────────────────────────────
   Inline copies of env.sv0 scope operations. Frames is a Vec
   of Vec<i32>, each inner Vec holding name token positions. */

fn res_enter_scope(frames: Vec<i32>) -> i32 {
    let f: Vec<i32> = vec_new();
    vec_push(frames, f);
    return 0;
}

fn res_bind_local(frames: Vec<i32>, name_pos: i32) -> i32 {
    let len: i32 = vec_len(frames);
    if len == 0 {
        let f: Vec<i32> = vec_new();
        vec_push(f, name_pos);
        vec_push(frames, f);
        return 0;
    }
    let top: Vec<i32> = vec_get(frames, len - 1);
    vec_push(top, name_pos);
    return 0;
}

fn res_lookup_in_frames_str(frames: Vec<i32>, name_str: string,
                            source: string, starts: Vec<i32>,
                            ends: Vec<i32>) -> bool {
    let flen: i32 = vec_len(frames);
    let mut fi: i32 = flen - 1;
    while fi >= 0 {
        let frame: Vec<i32> = vec_get(frames, fi);
        let fv_len: i32 = vec_len(frame);
        let mut j: i32 = 0;
        while j < fv_len {
            let pos: i32 = vec_get(frame, j);
            let nm: string = tok_str(source, starts, ends, pos);
            if string_eq(nm, name_str) { return true; }
            j = j + 1;
        }
        fi = fi - 1;
    }
    return false;
}

fn res_full_value_exists(mod_vals: Vec<i32>, frames: Vec<i32>,
                         name_str: string, source: string,
                         starts: Vec<i32>, ends: Vec<i32>) -> bool {
    if res_lookup_in_frames_str(frames, name_str, source, starts, ends) {
        return true;
    }
    return res_value_exists(mod_vals, name_str, source, starts, ends);
}

fn res_lookup_fn_arity_str(fn_arities: Vec<i32>, name_str: string,
                           source: string, starts: Vec<i32>,
                           ends: Vec<i32>) -> i32 {
    let len: i32 = vec_len(fn_arities);
    let mut i: i32 = 0;
    while i < len {
        let pos: i32 = vec_get(fn_arities, i);
        let nm: string = tok_str(source, starts, ends, pos);
        if string_eq(nm, name_str) {
            return vec_get(fn_arities, i + 1);
        }
        i = i + 2;
    }
    return 0 - 1;
}

/* ── resolve_expr (SML resolveExpr) ───────────────────────────
   Walks the expr arena and validates names, scoping, and arity.
   Returns 0 on success, error code on failure.
   Type arena is local to parser — ExprCast type validation deferred.
   Pattern arena is local to parser — ExprFor/ExprMatch patterns
   use inlined tag/d1 from expr arena. */

fn resolve_expr(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                ed3: Vec<i32>, ed4: Vec<i32>, idx: i32,
                source: string, starts: Vec<i32>, ends: Vec<i32>,
                mod_vals: Vec<i32>, mod_tys: Vec<i32>,
                fn_arities: Vec<i32>, frames: Vec<i32>,
                pp: Vec<i32>) -> i32 {
    if idx < 0 { return 0; }
    let tag: i32 = vec_get(et, idx);
    if tag == 0 { return 0; }
    if tag == 1 {
        let pps: i32 = vec_get(ed1, idx);
        let ppc: i32 = vec_get(ed2, idx);
        let path: Vec<i32> = vec_new();
        let mut k: i32 = 0;
        while k < ppc {
            vec_push(path, vec_get(pp, pps + k));
            k = k + 1;
        }
        let ps: string = path_join_vec(source, starts, ends, path);
        if res_full_value_exists(mod_vals, frames, ps,
                                  source, starts, ends) != true {
            return 300;
        }
        return 0;
    }
    if tag == 2 {
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed2, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 3 {
        let r1: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed2, idx),
                                    source, starts, ends,
                                    mod_vals, mod_tys, fn_arities, frames, pp);
        if r1 != 0 { return r1; }
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed3, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 4 {
        let callee: i32 = vec_get(ed1, idx);
        let args_first: i32 = vec_get(ed2, idx);
        let args_count: i32 = vec_get(ed3, idx);
        if vec_get(et, callee) == 1 {
            let cpps: i32 = vec_get(ed1, callee);
            let cppc: i32 = vec_get(ed2, callee);
            let cpath: Vec<i32> = vec_new();
            let mut ck: i32 = 0;
            while ck < cppc {
                vec_push(cpath, vec_get(pp, cpps + ck));
                ck = ck + 1;
            }
            let cps: string = path_join_vec(source, starts, ends, cpath);
            if cppc == 1 {
                if string_eq(cps, "forall") {
                    if args_count == 3 {
                        let binder: i32 = args_first;
                        if vec_get(et, binder) == 1 {
                            let bpos: i32 = vec_get(pp, vec_get(ed1, binder));
                            let rd: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                                        args_first + 1,
                                                        source, starts, ends,
                                                        mod_vals, mod_tys,
                                                        fn_arities, frames, pp);
                            if rd != 0 { return rd; }
                            res_enter_scope(frames);
                            res_bind_local(frames, bpos);
                            let rb: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                                        args_first + 2,
                                                        source, starts, ends,
                                                        mod_vals, mod_tys,
                                                        fn_arities, frames, pp);
                            return rb;
                        }
                    }
                }
                if string_eq(cps, "exists") {
                    if args_count == 3 {
                        let binder: i32 = args_first;
                        if vec_get(et, binder) == 1 {
                            let bpos: i32 = vec_get(pp, vec_get(ed1, binder));
                            let rd: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                                        args_first + 1,
                                                        source, starts, ends,
                                                        mod_vals, mod_tys,
                                                        fn_arities, frames, pp);
                            if rd != 0 { return rd; }
                            res_enter_scope(frames);
                            res_bind_local(frames, bpos);
                            let rb: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                                        args_first + 2,
                                                        source, starts, ends,
                                                        mod_vals, mod_tys,
                                                        fn_arities, frames, pp);
                            return rb;
                        }
                    }
                }
            }
            let arity: i32 = res_lookup_fn_arity_str(fn_arities, cps,
                                                      source, starts, ends);
            if arity >= 0 {
                if arity != args_count { return 307; }
            }
        }
        let rf: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, callee,
                                    source, starts, ends,
                                    mod_vals, mod_tys, fn_arities, frames, pp);
        if rf != 0 { return rf; }
        let mut ai: i32 = 0;
        while ai < args_count {
            let ra: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                        args_first + ai,
                                        source, starts, ends,
                                        mod_vals, mod_tys, fn_arities, frames, pp);
            if ra != 0 { return ra; }
            ai = ai + 1;
        }
        return 0;
    }
    if tag == 5 {
        let recv: i32 = vec_get(ed1, idx);
        let margs_first: i32 = vec_get(ed3, idx);
        let margs_count: i32 = vec_get(ed4, idx);
        let rr: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, recv,
                                    source, starts, ends,
                                    mod_vals, mod_tys, fn_arities, frames, pp);
        if rr != 0 { return rr; }
        let mut mi: i32 = 0;
        while mi < margs_count {
            let rm: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                        margs_first + mi,
                                        source, starts, ends,
                                        mod_vals, mod_tys, fn_arities, frames, pp);
            if rm != 0 { return rm; }
            mi = mi + 1;
        }
        return 0;
    }
    if tag == 6 {
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 7 {
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 8 {
        let ra: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                                    source, starts, ends,
                                    mod_vals, mod_tys, fn_arities, frames, pp);
        if ra != 0 { return ra; }
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed2, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 9 {
        let sf: i32 = vec_get(ed1, idx);
        let sc: i32 = vec_get(ed2, idx);
        let tail: i32 = vec_get(ed3, idx);
        res_enter_scope(frames);
        let mut si: i32 = 0;
        while si < sc {
            let rs: i32 = resolve_stmt(et, ed1, ed2, ed3, ed4,
                                        sf + si,
                                        source, starts, ends,
                                        mod_vals, mod_tys,
                                        fn_arities, frames, pp);
            if rs != 0 { return rs; }
            si = si + 1;
        }
        if tail >= 0 {
            return resolve_expr(et, ed1, ed2, ed3, ed4, tail,
                                 source, starts, ends,
                                 mod_vals, mod_tys, fn_arities, frames, pp);
        }
        return 0;
    }
    if tag == 10 {
        let rc: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                                    source, starts, ends,
                                    mod_vals, mod_tys, fn_arities, frames, pp);
        if rc != 0 { return rc; }
        let rt: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed2, idx),
                                    source, starts, ends,
                                    mod_vals, mod_tys, fn_arities, frames, pp);
        if rt != 0 { return rt; }
        let else_idx: i32 = vec_get(ed3, idx);
        if else_idx >= 0 {
            return resolve_expr(et, ed1, ed2, ed3, ed4, else_idx,
                                 source, starts, ends,
                                 mod_vals, mod_tys, fn_arities, frames, pp);
        }
        return 0;
    }
    if tag == 11 {
        let scrut: i32 = vec_get(ed1, idx);
        let arms_f: i32 = vec_get(ed2, idx);
        let arms_c: i32 = vec_get(ed3, idx);
        let rsc: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, scrut,
                                     source, starts, ends,
                                     mod_vals, mod_tys, fn_arities, frames, pp);
        if rsc != 0 { return rsc; }
        let mut ami: i32 = 0;
        while ami < arms_c {
            let arm_idx: i32 = arms_f + ami;
            let arm_pat_tag: i32 = vec_get(ed1, arm_idx);
            let arm_pat_d1: i32 = vec_get(ed2, arm_idx);
            let guard: i32 = vec_get(ed3, arm_idx);
            let body: i32 = vec_get(ed4, arm_idx);
            res_enter_scope(frames);
            if arm_pat_tag == 1 {
                res_bind_local(frames, arm_pat_d1);
            }
            if guard >= 0 {
                let rg: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, guard,
                                            source, starts, ends,
                                            mod_vals, mod_tys,
                                            fn_arities, frames, pp);
                if rg != 0 { return rg; }
            }
            let rb: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, body,
                                        source, starts, ends,
                                        mod_vals, mod_tys,
                                        fn_arities, frames, pp);
            if rb != 0 { return rb; }
            ami = ami + 1;
        }
        return 0;
    }
    if tag == 12 {
        let cond: i32 = vec_get(ed1, idx);
        let wbody: i32 = vec_get(ed2, idx);
        let inv_f: i32 = vec_get(ed3, idx);
        let inv_c: i32 = vec_get(ed4, idx);
        let rwc: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, cond,
                                     source, starts, ends,
                                     mod_vals, mod_tys, fn_arities, frames, pp);
        if rwc != 0 { return rwc; }
        let mut ii: i32 = 0;
        while ii < inv_c {
            let ri: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                        inv_f + ii,
                                        source, starts, ends,
                                        mod_vals, mod_tys,
                                        fn_arities, frames, pp);
            if ri != 0 { return ri; }
            ii = ii + 1;
        }
        return resolve_expr(et, ed1, ed2, ed3, ed4, wbody,
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 13 {
        let pat_tok: i32 = vec_get(ed1, idx);
        let iter: i32 = vec_get(ed2, idx);
        let fbody: i32 = vec_get(ed3, idx);
        let rit: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, iter,
                                     source, starts, ends,
                                     mod_vals, mod_tys, fn_arities, frames, pp);
        if rit != 0 { return rit; }
        res_enter_scope(frames);
        res_bind_local(frames, pat_tok);
        return resolve_expr(et, ed1, ed2, ed3, ed4, fbody,
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 14 {
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 15 {
        let rv: i32 = vec_get(ed1, idx);
        if rv >= 0 {
            return resolve_expr(et, ed1, ed2, ed3, ed4, rv,
                                 source, starts, ends,
                                 mod_vals, mod_tys, fn_arities, frames, pp);
        }
        return 0;
    }
    if tag == 16 {
        let bv: i32 = vec_get(ed1, idx);
        if bv >= 0 {
            return resolve_expr(et, ed1, ed2, ed3, ed4, bv,
                                 source, starts, ends,
                                 mod_vals, mod_tys, fn_arities, frames, pp);
        }
        return 0;
    }
    if tag == 17 { return 0; }
    if tag == 18 {
        let ra: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                                    source, starts, ends,
                                    mod_vals, mod_tys, fn_arities, frames, pp);
        if ra != 0 { return ra; }
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed2, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 19 {
        let ra: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed2, idx),
                                    source, starts, ends,
                                    mod_vals, mod_tys, fn_arities, frames, pp);
        if ra != 0 { return ra; }
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed3, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 20 {
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 21 {
        let lo: i32 = vec_get(ed1, idx);
        let hi: i32 = vec_get(ed2, idx);
        if lo >= 0 {
            let rl: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, lo,
                                        source, starts, ends,
                                        mod_vals, mod_tys, fn_arities, frames, pp);
            if rl != 0 { return rl; }
        }
        if hi >= 0 {
            return resolve_expr(et, ed1, ed2, ed3, ed4, hi,
                                 source, starts, ends,
                                 mod_vals, mod_tys, fn_arities, frames, pp);
        }
        return 0;
    }
    if tag == 22 {
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 23 {
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    if tag == 24 {
        let spps: i32 = vec_get(ed1, idx);
        let sppc: i32 = vec_get(ed2, idx);
        let sfc: i32 = vec_get(ed3, idx);
        let spath: Vec<i32> = vec_new();
        let mut sk: i32 = 0;
        while sk < sppc {
            vec_push(spath, vec_get(pp, spps + sk));
            sk = sk + 1;
        }
        let sps: string = path_join_vec(source, starts, ends, spath);
        if res_type_exists(mod_tys, sps, source, starts, ends) != true {
            return 301;
        }
        let mut sfi: i32 = 0;
        while sfi < sfc {
            let rfe: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                         idx - sfc + sfi,
                                         source, starts, ends,
                                         mod_vals, mod_tys,
                                         fn_arities, frames, pp);
            if rfe != 0 { return rfe; }
            sfi = sfi + 1;
        }
        return 0;
    }
    if tag == 25 {
        let tf: i32 = vec_get(ed1, idx);
        let tc: i32 = vec_get(ed2, idx);
        let mut ti: i32 = 0;
        while ti < tc {
            let rte: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                         tf + ti,
                                         source, starts, ends,
                                         mod_vals, mod_tys,
                                         fn_arities, frames, pp);
            if rte != 0 { return rte; }
            ti = ti + 1;
        }
        return 0;
    }
    if tag == 26 {
        let af: i32 = vec_get(ed1, idx);
        let ac: i32 = vec_get(ed2, idx);
        let mut ari: i32 = 0;
        while ari < ac {
            let rae: i32 = resolve_expr(et, ed1, ed2, ed3, ed4,
                                         af + ari,
                                         source, starts, ends,
                                         mod_vals, mod_tys,
                                         fn_arities, frames, pp);
            if rae != 0 { return rae; }
            ari = ari + 1;
        }
        return 0;
    }
    return 0;
}

/* ── resolve_stmt (SML resolveStmt) ──────────────────────────
   Handles LetStmt(27) and SemiStmt(28) in the expr arena.
   LetStmt binds the local variable in the current scope.
   Type annotations are local to parser — validation deferred. */

fn resolve_stmt(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                ed3: Vec<i32>, ed4: Vec<i32>, idx: i32,
                source: string, starts: Vec<i32>, ends: Vec<i32>,
                mod_vals: Vec<i32>, mod_tys: Vec<i32>,
                fn_arities: Vec<i32>, frames: Vec<i32>,
                pp: Vec<i32>) -> i32 {
    let tag: i32 = vec_get(et, idx);
    if tag == 27 {
        let init: i32 = vec_get(ed3, idx);
        if init >= 0 {
            let ri: i32 = resolve_expr(et, ed1, ed2, ed3, ed4, init,
                                        source, starts, ends,
                                        mod_vals, mod_tys,
                                        fn_arities, frames, pp);
            if ri != 0 { return ri; }
        }
        let name_pos: i32 = vec_get(ed1, idx);
        res_bind_local(frames, name_pos);
        return 0;
    }
    if tag == 28 {
        return resolve_expr(et, ed1, ed2, ed3, ed4, vec_get(ed1, idx),
                             source, starts, ends,
                             mod_vals, mod_tys, fn_arities, frames, pp);
    }
    return resolve_expr(et, ed1, ed2, ed3, ed4, idx,
                         source, starts, ends,
                         mod_vals, mod_tys, fn_arities, frames, pp);
}

/* ── resolve_contract (SML resolveContract) ───────────────── */

fn resolve_contract(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                    ed3: Vec<i32>, ed4: Vec<i32>, idx: i32,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    mod_vals: Vec<i32>, mod_tys: Vec<i32>,
                    fn_arities: Vec<i32>, frames: Vec<i32>,
                    pp: Vec<i32>) -> i32 {
    return resolve_expr(et, ed1, ed2, ed3, ed4, idx,
                         source, starts, ends,
                         mod_vals, mod_tys, fn_arities, frames, pp);
}

/* ── tests ──────────────────────────────────────────────────── */

fn test_path_join() -> i32 {
    if string_eq(path_join2("Foo", "Bar"), "Foo::Bar") != true { return 1; }
    if string_eq(path_join2("mod", "fn"), "mod::fn") != true { return 2; }
    return 0;
}

fn test_mangle_use() -> i32 {
    if string_eq(mangle_use_target("mymod", "foo"), "mymod__foo") != true { return 1; }
    if string_eq(mangle_use_target("a", "b"), "a__b") != true { return 2; }
    return 0;
}

fn test_is_intrinsic() -> i32 {
    if is_intrinsic("println") != true { return 1; }
    if is_intrinsic("vec_new") != true { return 2; }
    if is_intrinsic("box_deref") != true { return 3; }
    if is_intrinsic("foo") != false { return 4; }
    if is_intrinsic("main") != false { return 5; }
    return 0;
}

fn test_intrinsic_arity() -> i32 {
    if intrinsic_arity("println") != 1 { return 1; }
    if intrinsic_arity("forall") != 3 { return 2; }
    if intrinsic_arity("vec_new") != 0 { return 3; }
    if intrinsic_arity("string_substr") != 3 { return 4; }
    if intrinsic_arity("unknown") != 0 - 1 { return 5; }
