/* PC-2e: unmangled fallback — sv0's collision-free linkProjectDir merge leaves
   top-level names UNMANGLED, so `use mymod::bar` must resolve against the bare
   `bar`/`Sig` definition (not `mymod__bar`). Covers both fallback branches. */
fn test_apply_use_clause_unmangled() -> i32 {
    let source: string = "mymod bar Sig";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 5);
    vec_push(starts, 6); vec_push(ends, 9);
    vec_push(starts, 10); vec_push(ends, 13);
    let mv: Vec<i32> = vec_new();
    let mt: Vec<i32> = vec_new();
    vec_push(mt, 2);
    let fa: Vec<i32> = vec_new();
    vec_push(fa, 1);
    vec_push(fa, 3);
    let pp: Vec<i32> = vec_new();
    vec_push(pp, 0);
    vec_push(pp, 1);
    let it: Vec<i32> = vec_new();
    let id1: Vec<i32> = vec_new();
    let id2: Vec<i32> = vec_new();
    vec_push(it, 5);
    vec_push(id1, 0);
    vec_push(id2, 2);
    let r: i32 = apply_use_clause(it, id1, id2, 0,
                                   source, starts, ends,
                                   mv, mt, fa, pp);
    if r != 0 { return 1; }
    if res_lookup_fn_arity_str(fa, "bar", source, starts, ends) != 3 { return 2; }
    let pp2: Vec<i32> = vec_new();
    vec_push(pp2, 0);
    vec_push(pp2, 2);
    let it2: Vec<i32> = vec_new();
    let id1b: Vec<i32> = vec_new();
    let id2b: Vec<i32> = vec_new();
    vec_push(it2, 5);
    vec_push(id1b, 0);
    vec_push(id2b, 2);
    let r2: i32 = apply_use_clause(it2, id1b, id2b, 0,
                                    source, starts, ends,
                                    mv, mt, fa, pp2);
    if r2 != 0 { return 3; }
    return 0;
}

