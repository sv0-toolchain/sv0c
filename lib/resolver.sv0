fn test_scope_mgmt() -> i32 {
    let source: string = "x y z";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 1);
    vec_push(starts, 2); vec_push(ends, 3);
    vec_push(starts, 4); vec_push(ends, 5);
    let frames: Vec<i32> = vec_new();
    res_enter_scope(frames);
    res_bind_local(frames, 0);
    if res_lookup_in_frames_str(frames, "x", source, starts, ends) != true { return 1; }
    if res_lookup_in_frames_str(frames, "y", source, starts, ends) != false { return 2; }
    res_bind_local(frames, 1);
    if res_lookup_in_frames_str(frames, "y", source, starts, ends) != true { return 3; }
    let mv: Vec<i32> = vec_new();
    vec_push(mv, 2);
    if res_full_value_exists(mv, frames, "z", source, starts, ends) != true { return 4; }
    if res_full_value_exists(mv, frames, "x", source, starts, ends) != true { return 5; }
    return 0;
}

