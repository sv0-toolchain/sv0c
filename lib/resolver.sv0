    let enum_payload_ty_root: Vec<i32> = vec_new();
    let enum_payload_base: Vec<i32> = vec_new();
    let enum_payload_count: Vec<i32> = vec_new();
    vec_push(it, 0);
    vec_push(id1, 0);
    vec_push(id2, 0);
    vec_push(id3, 1);
    vec_push(id4, 0);
    vec_push(id5, 0);
    vec_push(fn_ptoks, 0);
    vec_push(fn_p_ty_root, 0);
    vec_push(fn_ret_root, 0 - 1);
    vec_push(fn_contract_base, 0 - 1);
    vec_push(enum_payload_base, 0 - 1);
    vec_push(enum_payload_count, 0);
    let pty_tt: Vec<i32> = vec_new();
    let pty_td1: Vec<i32> = vec_new();
    let pty_td2: Vec<i32> = vec_new();
    let pty_td3: Vec<i32> = vec_new();
    vec_push(pty_tt, 0);
    vec_push(pty_td1, 0);
    vec_push(pty_td2, 1);
    vec_push(pty_td3, 0);
    let sf_tr: Vec<i32> = vec_new();
    let r: i32 = resolve_program(et, ed1, ed2, ed3, ed4,
                                  it, id1, id2, id3, id4, id5,
                                  fn_ptoks,
                                  fn_p_ty_root,
                                  fn_ret_root,
                                  fn_contract_base,
                                  fn_contract_root,
                                  enum_payload_ty_root,
                                  enum_payload_base,
                                  enum_payload_count,
                                  pty_tt, pty_td1, pty_td2, pty_td3, sf_tr,
                                  source, starts, ends,
                                  mv, mt, fa, pp, vec_new());
    if r != 0 { return 1; }
    if res_full_value_exists(mv, vec_new(), "main",
                              source, starts, ends) != true { return 2; }
    if res_lookup_fn_arity_str(fa, "main", source, starts, ends) != 1 { return 3; }
    return 0;
}

fn test_resolve_program_cast_type_roots() -> i32 {
    let source: string = "main NoSuch";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 4);
    vec_push(starts, 5); vec_push(ends, 11);
    let mv: Vec<i32> = vec_new();
    let mt: Vec<i32> = vec_new();
    let fa: Vec<i32> = vec_new();
    let pp: Vec<i32> = vec_new();
    vec_push(pp, 0);
    vec_push(pp, 1);
    let et: Vec<i32> = vec_new();
    let ed1: Vec<i32> = vec_new();
    let ed2: Vec<i32> = vec_new();
    let ed3: Vec<i32> = vec_new();
    let ed4: Vec<i32> = vec_new();
    /* body expr: literal then cast */
    vec_push(et, 0); vec_push(ed1, 0); vec_push(ed2, 0); vec_push(ed3, 0); vec_push(ed4, 0);
    vec_push(et, 20); vec_push(ed1, 0); vec_push(ed2, 0); vec_push(ed3, 0); vec_push(ed4, 0);
    let it: Vec<i32> = vec_new();
    let id1: Vec<i32> = vec_new();
    let id2: Vec<i32> = vec_new();
    let id3: Vec<i32> = vec_new();
    let id4: Vec<i32> = vec_new();
    let id5: Vec<i32> = vec_new();
    vec_push(it, 0);
    vec_push(id1, 0);
    vec_push(id2, 0);
    vec_push(id3, 0);
    vec_push(id4, 1);
    vec_push(id5, 0 - 1);
    let fn_ptoks: Vec<i32> = vec_new();
    let fn_p_ty_root: Vec<i32> = vec_new();
    let fn_ret_root: Vec<i32> = vec_new();
    let fn_contract_base: Vec<i32> = vec_new();
    let fn_contract_root: Vec<i32> = vec_new();
    let enum_payload_ty_root: Vec<i32> = vec_new();
    let enum_payload_base: Vec<i32> = vec_new();
    let enum_payload_count: Vec<i32> = vec_new();
    vec_push(fn_ret_root, 0 - 1);
    vec_push(fn_contract_base, 0 - 1);
    vec_push(enum_payload_base, 0 - 1);
    vec_push(enum_payload_count, 0);
    let pty_tt: Vec<i32> = vec_new();
    let pty_td1: Vec<i32> = vec_new();
    let pty_td2: Vec<i32> = vec_new();
    let pty_td3: Vec<i32> = vec_new();
    /* cast target = TyName(NoSuch) */
    vec_push(pty_tt, 0); vec_push(pty_td1, 1); vec_push(pty_td2, 1); vec_push(pty_td3, 0);
    let sf_tr: Vec<i32> = vec_new();
    let r1: i32 = resolve_program(et, ed1, ed2, ed3, ed4,
                                  it, id1, id2, id3, id4, id5,
                                  fn_ptoks,
                                  fn_p_ty_root,
                                  fn_ret_root,
                                  fn_contract_base,
                                  fn_contract_root,
                                  enum_payload_ty_root,
                                  enum_payload_base,
                                  enum_payload_count,
                                  pty_tt, pty_td1, pty_td2, pty_td3, sf_tr,
                                  source, starts, ends,
                                  mv, mt, fa, pp, vec_new());
    if diag_code_of(r1) != 301 { return 1; }
    vec_push(mt, 1);
    let r2: i32 = resolve_program(et, ed1, ed2, ed3, ed4,
                                  it, id1, id2, id3, id4, id5,
                                  fn_ptoks,
                                  fn_p_ty_root,
                                  fn_ret_root,
                                  fn_contract_base,
                                  fn_contract_root,
                                  enum_payload_ty_root,
                                  enum_payload_base,
                                  enum_payload_count,
                                  pty_tt, pty_td1, pty_td2, pty_td3, sf_tr,
                                  source, starts, ends,
                                  mv, mt, fa, pp, vec_new());
    if r2 != 0 { return 2; }
    return 0;
}

