    let td3: Vec<i32> = vec_new();
    vec_push(tt, 0); vec_push(td1, 0); vec_push(td2, 1); vec_push(td3, 0);
    if resolve_ty(tt, td1, td2, td3, 0,
                   source, starts, ends, mt, vec_new(), pp, vec_new()) != 0 { return 1; }
    vec_push(pp, 1);
    vec_push(tt, 0); vec_push(td1, 1); vec_push(td2, 1); vec_push(td3, 0);
    if resolve_ty(tt, td1, td2, td3, 1,
                   source, starts, ends, mt, vec_new(), pp, vec_new()) != 0 { return 2; }
