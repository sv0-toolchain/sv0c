fn test_path_join_vec() -> i32 {
    let src: string = "Foo::Bar::Baz";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0);
    vec_push(ends, 3);
    vec_push(starts, 5);
    vec_push(ends, 8);
    vec_push(starts, 10);
    vec_push(ends, 13);
    let indices: Vec<i32> = vec_new();
    vec_push(indices, 0);
    vec_push(indices, 1);
    vec_push(indices, 2);
    let joined: string = path_join_vec(src, starts, ends, indices);
    if string_eq(joined, "Foo::Bar::Baz") != true { return 1; }
    let single: Vec<i32> = vec_new();
    vec_push(single, 0);
    let r2: string = path_join_vec(src, starts, ends, single);
    if string_eq(r2, "Foo") != true { return 2; }
    let empty: Vec<i32> = vec_new();
    let r3: string = path_join_vec(src, starts, ends, empty);
    if string_eq(r3, "") != true { return 3; }
    return 0;
}

fn test_import_alias() -> i32 {
    let aliases: Vec<i32> = import_alias_new();
    if import_alias_count(aliases) != 0 { return 1; }
    if import_alias_lookup(aliases, 10) != 0 - 1 { return 2; }
    import_alias_add(aliases, 10, 20);
    import_alias_add(aliases, 30, 40);
    if import_alias_count(aliases) != 2 { return 3; }
    if import_alias_lookup(aliases, 10) != 20 { return 4; }
    if import_alias_lookup(aliases, 30) != 40 { return 5; }
    if import_alias_lookup(aliases, 50) != 0 - 1 { return 6; }
    let aliases2: Vec<i32> = import_alias_new();
    if import_alias_count(aliases2) != 0 { return 7; }
    if import_alias_lookup(aliases2, 10) != 0 - 1 { return 8; }
    return 0;
}

fn test_register_intrinsics() -> i32 {
    let fn_ar: Vec<i32> = vec_new();
    let mod_v: Vec<i32> = vec_new();
    let count: i32 = register_all_intrinsics(fn_ar, mod_v,
        100, 101, 102, 103, 104,
        105, 106, 107, 108, 109,
        110, 111, 112, 113, 114,
        115, 116);
    if count != 17 { return 1; }
    if vec_len(fn_ar) != 34 { return 2; }
    if vec_len(mod_v) != 17 { return 3; }
    if vec_get(fn_ar, 0) != 100 { return 4; }
    if vec_get(fn_ar, 1) != 1 { return 5; }
    if vec_get(fn_ar, 4) != 102 { return 6; }
    if vec_get(fn_ar, 5) != 3 { return 7; }
    if vec_get(mod_v, 0) != 100 { return 8; }
    if vec_get(mod_v, 16) != 116 { return 9; }
    return 0;
}

