    vec_push(mv, 0);
    let mt: Vec<i32> = vec_new();
    let fa: Vec<i32> = vec_new();
    vec_push(fa, 0);
    vec_push(fa, 2);
    let frames: Vec<i32> = vec_new();
    let pp: Vec<i32> = vec_new();
    vec_push(pp, 0);
    let et: Vec<i32> = vec_new();
    let ed1: Vec<i32> = vec_new();
    let ed2: Vec<i32> = vec_new();
    let ed3: Vec<i32> = vec_new();
    let ed4: Vec<i32> = vec_new();
    vec_push(et, 1); vec_push(ed1, 0); vec_push(ed2, 1);
    vec_push(ed3, 0); vec_push(ed4, 0);
    vec_push(et, 0); vec_push(ed1, 0); vec_push(ed2, 1);
    vec_push(ed3, 0); vec_push(ed4, 0);
    vec_push(et, 0); vec_push(ed1, 0); vec_push(ed2, 2);
    vec_push(ed3, 0); vec_push(ed4, 0);
    vec_push(et, 4); vec_push(ed1, 0); vec_push(ed2, 1);
    vec_push(ed3, 2); vec_push(ed4, 0);
    if resolve_expr(et, ed1, ed2, ed3, ed4, 3, source, starts, ends,
                     mv, mt, fa, frames, pp) != 0 { return 1; }
    vec_push(et, 4); vec_push(ed1, 0); vec_push(ed2, 1);
    vec_push(ed3, 1); vec_push(ed4, 0);
    if resolve_expr(et, ed1, ed2, ed3, ed4, 4, source, starts, ends,
                     mv, mt, fa, frames, pp) != 307 { return 2; }
    return 0;
}

fn test_resolve_stmt_let() -> i32 {
    let source: string = "a b";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 1);
    vec_push(starts, 2); vec_push(ends, 3);
    let mv: Vec<i32> = vec_new();
    let mt: Vec<i32> = vec_new();
    let fa: Vec<i32> = vec_new();
    let frames: Vec<i32> = vec_new();
    res_enter_scope(frames);
    let pp: Vec<i32> = vec_new();
    vec_push(pp, 0);
    let et: Vec<i32> = vec_new();
    let ed1: Vec<i32> = vec_new();
    let ed2: Vec<i32> = vec_new();
    let ed3: Vec<i32> = vec_new();
    let ed4: Vec<i32> = vec_new();
    vec_push(et, 27); vec_push(ed1, 0); vec_push(ed2, 0 - 1);
    vec_push(ed3, 0 - 1); vec_push(ed4, 0);
    if resolve_stmt(et, ed1, ed2, ed3, ed4, 0, source, starts, ends,
                     mv, mt, fa, frames, pp) != 0 { return 1; }
    if res_lookup_in_frames_str(frames, "a", source, starts, ends) != true { return 2; }
    vec_push(pp, 0);
    vec_push(et, 1); vec_push(ed1, 0); vec_push(ed2, 1);
    vec_push(ed3, 0); vec_push(ed4, 0);
    if resolve_expr(et, ed1, ed2, ed3, ed4, 1, source, starts, ends,
                     mv, mt, fa, frames, pp) != 0 { return 3; }
    return 0;
}

