    vec_push(ends, 3);
    vec_push(starts, 5);
    vec_push(ends, 8);
    vec_push(starts, 10);
    vec_push(ends, 13);
    let indices: Vec<i32> = vec_new();
    vec_push(indices, 0);
    vec_push(indices, 1);
    vec_push(indices, 2);
    let joined: string = path_join_vec(src, starts, ends, indices);
    if string_eq(joined, "Foo::Bar::Baz") != true { return 1; }
    let single: Vec<i32> = vec_new();
    vec_push(single, 0);
    let r2: string = path_join_vec(src, starts, ends, single);
    if string_eq(r2, "Foo") != true { return 2; }
    let empty: Vec<i32> = vec_new();
    let r3: string = path_join_vec(src, starts, ends, empty);
    if string_eq(r3, "") != true { return 3; }
    return 0;
}

