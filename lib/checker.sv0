fn test_fields_of_struct() -> i32 {
    let tbl: Vec<i32> = vec_new();
    vec_push(tbl, 100); vec_push(tbl, 3);
    vec_push(tbl, 200); vec_push(tbl, 5);
    if fields_of_struct(tbl, 2, 100) != 0 { return 1; }
    if fields_of_struct(tbl, 2, 200) != 1 { return 2; }
    if fields_of_struct(tbl, 2, 999) != 0 - 1 { return 3; }
    return 0;
}

