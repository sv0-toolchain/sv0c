fn test_synth_building_blocks() -> i32 {
    /* source: "fn foo ( x : i32 ) -> bool { }"
       tok: 0=fn(60) 1=foo(5) 2=((6) 3=x(5) 4=:(14) 5=i32(5)
            6=)(7) 7=->(18) 8=bool(5) 9={(8) 10=}(9) */
    let source: string = "fn foo ( x : i32 ) -> bool { }";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 2);
    vec_push(starts, 3); vec_push(ends, 6);
    vec_push(starts, 7); vec_push(ends, 8);
    vec_push(starts, 9); vec_push(ends, 10);
    vec_push(starts, 11); vec_push(ends, 12);
    vec_push(starts, 13); vec_push(ends, 16);
    vec_push(starts, 17); vec_push(ends, 18);
    vec_push(starts, 19); vec_push(ends, 21);
    vec_push(starts, 22); vec_push(ends, 26);
    vec_push(starts, 27); vec_push(ends, 28);
    vec_push(starts, 29); vec_push(ends, 30);
    let en: Vec<i32> = vec_new();
    let et: Vec<i32> = vec_new();
    let em: Vec<i32> = vec_new();
    env_extend(en, et, em, 3, TY_INT(), 0);
    let r1: i32 = env_lookup_str(en, et, source, starts, ends, "x");
    if r1 != TY_INT() { return 1; }
    let r2: i32 = env_lookup_str(en, et, source, starts, ends, "y");
    if r2 != 0 - 1 { return 2; }
    let sd_names: Vec<i32> = vec_new();
    let sd_foffs: Vec<i32> = vec_new();
    let sd_fcounts: Vec<i32> = vec_new();
    let sd_fn_flat: Vec<i32> = vec_new();
    let sd_ft_flat: Vec<i32> = vec_new();
    vec_push(sd_names, 1);
    vec_push(sd_foffs, 0);
    vec_push(sd_fcounts, 0);
    let si: i32 = sdef_name_lookup_str(sd_names, source, starts, ends, "foo");
    if si != 0 { return 3; }
    let si2: i32 = sdef_name_lookup_str(sd_names, source, starts, ends, "bar");
    if si2 != 0 - 1 { return 4; }
    let fnames: Vec<i32> = vec_new();
    let frtypes: Vec<i32> = vec_new();
    vec_push(fnames, 1);
    vec_push(frtypes, TY_BOOL());
    let ibo: Vec<i32> = vec_new();
    let rt: i32 = synth_call_ret_type(fnames, frtypes, source,
                                       starts, ends, "foo", ibo);
    if rt != TY_BOOL() { return 5; }
    let ibo2: Vec<i32> = vec_new();
    let rt2: i32 = synth_call_ret_type(fnames, frtypes, source,
                                        starts, ends, "println", ibo2);
    if rt2 != TY_UNIT() { return 6; }
    return 0;
}

