fn test_builtin_fn_lookup() -> i32 {
    if builtin_fn_lookup("println") != 0 { return 1; }
    if builtin_fn_lookup("string_len") != 1 { return 2; }
    if builtin_fn_lookup("vec_new") != 6 { return 3; }
    if builtin_fn_lookup("vec_get") != 9 { return 4; }
    if builtin_fn_lookup("box_deref") != 12 { return 5; }
    if builtin_fn_lookup("unknown") != 0 - 1 { return 6; }
    if builtin_fn_ret_type(0) != TY_UNIT() { return 7; }
    if builtin_fn_ret_type(1) != TY_INT() { return 8; }
    if builtin_fn_ret_type(2) != TY_BOOL() { return 9; }
    if builtin_fn_ret_type(3) != TY_STRING() { return 10; }
    if builtin_fn_ret_type(9) != TY_VAR() { return 11; }
    if builtin_fn_param_count(0) != 1 { return 12; }
    if builtin_fn_param_count(5) != 3 { return 13; }
    if builtin_fn_param_count(6) != 0 { return 14; }
    if builtin_fn_param_type(0, 0) != TY_STRING() { return 15; }
    if builtin_fn_param_type(4, 0) != TY_STRING() { return 16; }
    if builtin_fn_param_type(4, 1) != TY_INT() { return 17; }
    if builtin_fn_param_type(9, 0) != TY_NAMED() { return 18; }
    if builtin_fn_param_type(9, 1) != TY_INT() { return 19; }
    return 0;
}

fn test_resolve_fn_call() -> i32 {
    let source: string = "fn foo ( ) -> i32 { }";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 2);
    vec_push(starts, 3); vec_push(ends, 6);
    vec_push(starts, 7); vec_push(ends, 8);
    vec_push(starts, 9); vec_push(ends, 10);
    vec_push(starts, 11); vec_push(ends, 13);
    vec_push(starts, 14); vec_push(ends, 17);
    vec_push(starts, 18); vec_push(ends, 19);
    vec_push(starts, 20); vec_push(ends, 21);
    let fnames: Vec<i32> = vec_new();
    vec_push(fnames, 1);
    let ib0: Vec<i32> = vec_new();
    let r0: i32 = resolve_fn_call(fnames, source, starts, ends,
                                   "foo", ib0);
    if r0 != 0 { return 1; }
    if vec_get(ib0, 0) != 0 { return 2; }
    let ib1: Vec<i32> = vec_new();
    let r1: i32 = resolve_fn_call(fnames, source, starts, ends,
                                   "println", ib1);
    if r1 != 0 { return 3; }
    if vec_get(ib1, 0) != 1 { return 4; }
    let ib2: Vec<i32> = vec_new();
    let r2: i32 = resolve_fn_call(fnames, source, starts, ends,
                                   "nonexistent", ib2);
    if r2 != 0 - 1 { return 5; }
    return 0;
}

fn test_enum_ctor_resolution() -> i32 {
    /* enum Color { Red , Green ( i32 ) , Blue { x : i32 } }
       tok 0=enum(62) 1=Color(5) 2={(8) 3=Red(5) 4=,(12)
           5=Green(5) 6=((6) 7=i32(5) 8=)(7) 9=,(12)
