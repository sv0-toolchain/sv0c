fn test_stmt_returns_arena() -> i32 {
    let et: Vec<i32> = vec_new();
    let ed1: Vec<i32> = vec_new();
    vec_push(et, 15);  vec_push(ed1, 0 - 1);
    vec_push(et, 28);  vec_push(ed1, 0);
    vec_push(et, 0);   vec_push(ed1, 0);
    vec_push(et, 28);  vec_push(ed1, 2);
    vec_push(et, 27);  vec_push(ed1, 0);
    if stmt_returns_arena(et, ed1, 1) != true { return 1; }
    if stmt_returns_arena(et, ed1, 3) != false { return 2; }
    if stmt_returns_arena(et, ed1, 4) != false { return 3; }
    if stmt_returns_arena(et, ed1, 0) != true { return 4; }
    return 0;
}

fn test_last_stmt_returns_arena() -> i32 {
