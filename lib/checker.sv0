    vec_push(targets, 20);
    let saved: i32 = vec_len(names);
    vec_push(names, 30);
    vec_push(targets, 40);
    let r1: i32 = alias_lookup_bounded(names, targets, saved, 30);
    if r1 != 30 { return 1; }
    let r2: i32 = alias_lookup_bounded(names, targets, 2, 30);
    if r2 != 40 { return 2; }
    let r3: i32 = alias_lookup_bounded(names, targets, 0, 10);
    if r3 != 10 { return 3; }
    return 0;
}

fn test_ctor_ty_tag() -> i32 {
    if ctor_ty_tag(0, 0) != TY_ENUM() { return 1; }
    if ctor_ty_tag(1, 3) != TY_FN() { return 2; }
    if ctor_ty_tag(2, 2) != TY_FN() { return 3; }
    if ctor_ty_tag(1, 0) != TY_ENUM() { return 4; }
    return 0;
}

