/* Phase 2 real pipeline module: sml/type_checker/checker.sml -> sv0.
   Type checker utilities: binop classification (Arith/Logic/Cmp),
   integral type detection, AST type name → type tag mapping (22
   primitive names), assignment LHS classification (ALVar/ALField),
   statement return detection, path→string joining (2/3/Vec-based),
   error code constants (E0400–E0449), type import alias canon
   (Vec-based), env lookup/extend helpers, variant shape classification,
   constructor arity from shape, struct/enum name extraction from
   program tables, contract parameter classification, struct field
   lookup by name + type. expect (type unification gate — SML expect),
   fields_of_struct (SML fieldsOfStruct), variant_shape_of (SML
   variantShapeOf), assign_lhs_bad (SML assignLhsBad),
   enter_loop/exit_loop (SML withLoop decomposed).
   infer_lit (SML synth literal arms — maps literal tag to type tag).
   ctor_ty_arity (SML ctorTy param count), struct_field_ty (SML
   tyOfStructField via parallel type Vec),
   dup_variant_names (SML dupVariants — duplicate name check),
   struct_enum_name_clash (SML initTypes clash check),
   named_only_ty (SML namedOnlyTy — struct/enum/none classifier),
   fields_of_struct_count (SML fieldsOfStruct — field count by name handle).
   stmt_returns_arena / last_stmt_returns_arena (SML stmtReturns /
   lastStmtReturns — arena-aware, real expr arena tags 28/15).
   chk_tok_str (single-token text extraction for checker arena walks).
   expr_references_result (SML exprReferencesResult — recursive expr
   arena walk checking for single-segment "result" path).
   ast_ty_to_types_tag (SML astTyToTy primitive dispatch — maps type
   name strings to types.sv0 Ty tag values: TyUnit=0, TyBool=1, TyChar=2,
   TyString=3, TyIsize=4, TyUsize=5, TyInt=7, TyUint=8, TyFloat=9;
   returns -1 for user/unknown types).
   contract_expr_new/enter/exit/active (SML withContractExpr
   decomposed — scoped "in contract expr" flag via Vec tail),
   ty_import_alias_push / alias_lookup_bounded (SML
   addTyImportAlias/clearTyImportAliases — scoped push with
   logical-length restore), ctor_ty_tag (SML ctorTy — returns
   TY_FN for parameterised variants, TY_ENUM for nullary).
   try_success_validate (SML trySuccessPayloadTy — validates enum
   is a valid ? target: Result(Ok/Err) or Option(Some/None) with
   single-field tuple success variant; returns 1=Result, 2=Option,
   0=not valid, -1=shape mismatch).
   Full type resolution (batch 41): ast_ty_to_ty_payload
   (SML astTyToTy full dispatch — resolve_field_ty_tag + payload
   data: width for int/float, name handle for struct/enum, type
   param index for TyVar), enum_ctor_count (count variants for
   an enum by name handle), item_fn_ret_ty_tag (function return
   type resolution from arena index), binop_result_ty_tag and
   unop_result_ty_tag (SML synth ExprBinop/ExprUnop result type
   helpers for Arith→TyInt, Logic/Cmp→TyBool, Neg/BitNot→TyInt,
   Not→TyBool).
   type_param_push/type_param_restore/type_param_lookup (SML
   withTypeParams decomposed — push/pop generic type param bindings
   into a stride-2 Vec<i32> of (name_handle, ty_tag) pairs).
   resolve_field_ty_tag (SML resolveFieldTy simplified — maps parser
   type arena node to types.sv0 Ty tag using struct/enum name tables
   and type param scope; initTypes building block).
   Batch 42: env_entry_index (SML envEntry index-returning lookup),
   function type table (fn_table_add/lookup/ret_type/param_count/
   param_type — parallel Vecs for function signatures needed by
   modEnvFromProg and synth ExprCall).
   Batch 43: scan_struct_field_names (token re-scan for initTypes —
   extract struct field name positions from token stream using item
   arena metadata), scan_enum_variant_names (same for enum variant
   name positions — handles unit, tuple, and struct variant shapes).
   Batch 44: type_param_lookup_str (string-based type param lookup),
   scan_type_tag_at (token-stream type resolver — resolves type
   annotation at a token position to a checker type tag using string
   comparison; handles primitives, struct/enum, type params, Vec/Box,
   unit, tuple, ref, refmut), scan_struct_field_type_tags (struct
   field type tag extraction using scan_type_tag_at),
   scan_fn_param_type_tags (function parameter type tag extraction —
   walks fn signature tokens to extract each param's type tag).
   Batch 45: fn_table_lookup_str (string-based fn table lookup for
   cross-scope name resolution), scan_fn_ret_type_tag (token re-scan
   for function return type), item_fn_ty_to_table (SML itemFnTy —
   extract function type from item arena and register in fn table),
   register_all_item_fns (first part of modEnvFromProg — walk all
   ItemFn items and populate function type table).
   Full type inference (synth/checkStmt/checkFn/initTypes) deferred —
   needs deep AST traversal and unification. */

/* ── binop classification ───────────────────────────────────── */

fn BINOP_ARITH() -> i32 { return 0; }
fn BINOP_LOGIC() -> i32 { return 1; }
fn BINOP_CMP() -> i32 { return 2; }

/* Ast.binop tags: Add=0, Sub=1, Mul=2, Div=3, Rem=4,
   Eq=5, Neq=6, Lt=7, Gt=8, Leq=9, Geq=10,
   And=11, Or=12, BitAnd=13, BitOr=14, BitXor=15, Shl=16, Shr=17 */
fn binop_class(tag: i32) -> i32 {
    if tag <= 4 { return 0; }
    if tag >= 5 {
        if tag <= 10 { return 2; }
    }
    if tag == 11 { return 1; }
    if tag == 12 { return 1; }
    if tag >= 13 {
        if tag <= 17 { return 0; }
    }
    return 0;
}

fn is_arith_binop(tag: i32) -> bool { return binop_class(tag) == 0; }
fn is_logic_binop(tag: i32) -> bool { return binop_class(tag) == 1; }
fn is_cmp_binop(tag: i32) -> bool { return binop_class(tag) == 2; }

fn binop_returns_bool(tag: i32) -> bool {
    if is_cmp_binop(tag) { return true; }
    return is_logic_binop(tag);
}

fn binop_result_ty_tag(op_tag: i32) -> i32 {
    if is_arith_binop(op_tag) { return TY_INT(); }
    return TY_BOOL();
}

fn unop_result_ty_tag(op_tag: i32) -> i32 {
    if op_tag == 0 { return TY_INT(); }
    if op_tag == 1 { return TY_BOOL(); }
    if op_tag == 2 { return TY_INT(); }
    return TY_UNKNOWN();
}

/* ── integral type detection ────────────────────────────────── */

/* Types.ty tags: TyInt=0, TyUint=1, TyIsize=8, TyUsize=9 */
fn is_integral_ty(ty_tag: i32) -> bool {
    if ty_tag == 0 { return true; }
    if ty_tag == 1 { return true; }
    if ty_tag == 8 { return true; }
    if ty_tag == 9 { return true; }
    return false;
}

fn is_bool_ty(ty_tag: i32) -> bool { return ty_tag == 3; }
fn is_unit_ty(ty_tag: i32) -> bool { return ty_tag == 2; }
fn is_string_ty(ty_tag: i32) -> bool { return ty_tag == 5; }
fn is_numeric_ty(ty_tag: i32) -> bool {
    if is_integral_ty(ty_tag) { return true; }
    return ty_tag == 10;
}

fn assign_lhs_is_var(class: i32) -> bool { return class == 0; }
fn assign_lhs_is_field(class: i32) -> bool { return class == 1; }

/* ── AST type name → type tag ───────────────────────────────── */

fn TY_UNIT() -> i32 { return 2; }
fn TY_BOOL() -> i32 { return 3; }
fn TY_CHAR() -> i32 { return 4; }
fn TY_INT() -> i32 { return 0; }
fn TY_UINT() -> i32 { return 1; }
fn TY_ISIZE() -> i32 { return 8; }
fn TY_USIZE() -> i32 { return 9; }
fn TY_FLOAT() -> i32 { return 10; }
fn TY_STRING() -> i32 { return 5; }
fn TY_STRUCT() -> i32 { return 6; }
fn TY_ENUM() -> i32 { return 7; }
fn TY_FN() -> i32 { return 11; }
fn TY_REF() -> i32 { return 12; }
fn TY_REFMUT() -> i32 { return 13; }
fn TY_TUPLE() -> i32 { return 14; }
fn TY_NAMED() -> i32 { return 15; }
fn TY_VAR() -> i32 { return 16; }
fn TY_UNKNOWN() -> i32 { return 0 - 1; }

fn ast_type_name_to_tag(name: string) -> i32 {
    if string_eq(name, "unit") { return 2; }
    if string_eq(name, "bool") { return 3; }
    if string_eq(name, "char") { return 4; }
    if string_eq(name, "i32") { return 0; }
    if string_eq(name, "u32") { return 1; }
    if string_eq(name, "i64") { return 0; }
    if string_eq(name, "u64") { return 1; }
    if string_eq(name, "i128") { return 0; }
    if string_eq(name, "u128") { return 1; }
    if string_eq(name, "i8") { return 0; }
    if string_eq(name, "u8") { return 1; }
    if string_eq(name, "i16") { return 0; }
    if string_eq(name, "u16") { return 1; }
    if string_eq(name, "isize") { return 8; }
    if string_eq(name, "usize") { return 9; }
    if string_eq(name, "f32") { return 10; }
    if string_eq(name, "f64") { return 10; }
    if string_eq(name, "str") { return 5; }
    if string_eq(name, "string") { return 5; }
    if string_eq(name, "String") { return 5; }
    return 0 - 1;
}

fn is_primitive_type_name(name: string) -> bool {
    return ast_type_name_to_tag(name) >= 0;
}

fn int_width_from_name(name: string) -> i32 {
    if string_eq(name, "i8") { return 8; }
    if string_eq(name, "u8") { return 8; }
    if string_eq(name, "i16") { return 16; }
    if string_eq(name, "u16") { return 16; }
    if string_eq(name, "i32") { return 32; }
    if string_eq(name, "u32") { return 32; }
    if string_eq(name, "i64") { return 64; }
    if string_eq(name, "u64") { return 64; }
    if string_eq(name, "i128") { return 128; }
    if string_eq(name, "u128") { return 128; }
    if string_eq(name, "f32") { return 32; }
    if string_eq(name, "f64") { return 64; }
    return 0;
}

/* ── ast_ty_to_types_tag (SML astTyToTy primitive dispatch) ─── */
/* Maps type name string to types.sv0 Ty tag:
   TyUnit=0 TyBool=1 TyChar=2 TyString=3 TyIsize=4 TyUsize=5
   TyInt=7 TyUint=8 TyFloat=9. Returns -1 for user/unknown. */

fn ast_ty_to_types_tag(name: string) -> i32 {
    if string_eq(name, "unit") { return 0; }
    if string_eq(name, "bool") { return 1; }
    if string_eq(name, "char") { return 2; }
    if string_eq(name, "str") { return 3; }
    if string_eq(name, "string") { return 3; }
    if string_eq(name, "String") { return 3; }
    if string_eq(name, "isize") { return 4; }
    if string_eq(name, "usize") { return 5; }
    if string_eq(name, "i8") { return 7; }
    if string_eq(name, "i16") { return 7; }
    if string_eq(name, "i32") { return 7; }
    if string_eq(name, "i64") { return 7; }
    if string_eq(name, "i128") { return 7; }
    if string_eq(name, "u8") { return 8; }
    if string_eq(name, "u16") { return 8; }
    if string_eq(name, "u32") { return 8; }
    if string_eq(name, "u64") { return 8; }
    if string_eq(name, "u128") { return 8; }
    if string_eq(name, "f32") { return 9; }
    if string_eq(name, "f64") { return 9; }
    return 0 - 1;
}

/* ── assignment LHS classification ──────────────────────────── */

fn AL_VAR() -> i32 { return 0; }
fn AL_FIELD() -> i32 { return 1; }
fn AL_INVALID() -> i32 { return 0 - 1; }

/* ExprPath tag=2, ExprField tag=11 in ast.sv0 */
fn classify_assign_lhs(expr_tag: i32) -> i32 {
    if expr_tag == 2 { return 0; }
    if expr_tag == 11 { return 1; }
    return 0 - 1;
}

/* ── statement return detection ─────────────────────────────── */

/* StmtSemi tag=0, StmtExpr tag=1; ExprReturn tag=14 */
fn stmt_returns(stmt_tag: i32, inner_expr_tag: i32) -> bool {
    if stmt_tag == 0 {
        if inner_expr_tag == 14 { return true; }
    }
    if stmt_tag == 1 {
        if inner_expr_tag == 14 { return true; }
    }
    return false;
}

fn last_stmt_returns(count: i32, last_stmt_tag: i32, last_expr_tag: i32) -> bool {
    if count == 0 { return false; }
    return stmt_returns(last_stmt_tag, last_expr_tag);
}

/* ── path → string ──────────────────────────────────────────── */

fn path_key_2(a: string, b: string) -> string {
    return string_concat(string_concat(a, "::"), b);
}

fn path_key_3(a: string, b: string, c: string) -> string {
    return string_concat(path_key_2(a, b), string_concat("::", c));
}

/* ── generalized path key (Vec-based) ──────────────────────────
   Joins a Vec<i32> of string handles into a "::"-delimited key.
   Needs source+starts+ends from the token stream. */

fn path_key_vec(source: string, starts: Vec<i32>, ends: Vec<i32>,
                segs: Vec<i32>) -> string {
    let n: i32 = vec_len(segs);
    if n == 0 { return ""; }
    let p0: i32 = vec_get(segs, 0);
    let s0: i32 = vec_get(starts, p0);
    let e0: i32 = vec_get(ends, p0);
    let mut out: string = string_substr(source, s0, e0 - s0);
    let mut i: i32 = 1;
    while i < n {
        out = string_concat(out, "::");
        let p: i32 = vec_get(segs, i);
        let s: i32 = vec_get(starts, p);
        let e: i32 = vec_get(ends, p);
        out = string_concat(out, string_substr(source, s, e - s));
        i = i + 1;
    }
    return out;
}

/* ── contract parameter classification ─────────────────────────
   is_contract_param: checks if a name handle appears in the
   contract parameter list (Vec<i32> of name handles). */

fn is_contract_param(params: Vec<i32>, name: i32) -> bool {
    let n: i32 = vec_len(params);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(params, i) == name { return true; }
        i = i + 1;
    }
    return false;
}

/* ── struct/enum name extraction from program tables ───────────
   structNames / enumNames: extract just the name handles from
   the program's struct/enum definition tables.
   Input is interleaved [name, field_count, ...] or [name, variant_count, ...]. */

fn struct_names_count(struct_table: Vec<i32>, stride: i32) -> i32 {
    return vec_len(struct_table) / stride;
}

fn struct_name_at(struct_table: Vec<i32>, stride: i32, idx: i32) -> i32 {
    return vec_get(struct_table, idx * stride);
}

fn enum_names_count(enum_table: Vec<i32>, stride: i32) -> i32 {
    return vec_len(enum_table) / stride;
}

fn enum_name_at(enum_table: Vec<i32>, stride: i32, idx: i32) -> i32 {
    return vec_get(enum_table, idx * stride);
}

fn name_in_table(table: Vec<i32>, stride: i32, name: i32) -> bool {
    let n: i32 = vec_len(table) / stride;
    let mut i: i32 = 0;
    while i < n {
        if vec_get(table, i * stride) == name { return true; }
        i = i + 1;
    }
    return false;
}

/* ── type import alias canonicalization ──────────────────────── */

fn alias_lookup(names: Vec<i32>, targets: Vec<i32>, name: i32) -> i32 {
    let n: i32 = vec_len(names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(names, i) == name {
            return vec_get(targets, i);
        }
        i = i + 1;
    }
    return name;
}

fn canon_ty_import(names: Vec<i32>, targets: Vec<i32>, name: i32) -> i32 {
    let resolved: i32 = alias_lookup(names, targets, name);
    if resolved == name { return name; }
    return canon_ty_import(names, targets, resolved);
}

/* ── env helpers ────────────────────────────────────────────── */

fn env_lookup(env_names: Vec<i32>, env_types: Vec<i32>, name: i32) -> i32 {
    let n: i32 = vec_len(env_names);
    let mut i: i32 = n - 1;
    while i >= 0 {
        if vec_get(env_names, i) == name {
            return vec_get(env_types, i);
        }
        i = i - 1;
    }
    return 0 - 1;
}

fn env_extend(env_names: Vec<i32>, env_types: Vec<i32>, env_muts: Vec<i32>,
              name: i32, ty: i32, is_mut: i32) -> i32 {
    vec_push(env_names, name);
    vec_push(env_types, ty);
    vec_push(env_muts, is_mut);
    return vec_len(env_names) - 1;
}

fn env_is_mut(env_muts: Vec<i32>, idx: i32) -> bool {
    if idx < 0 { return false; }
    return vec_get(env_muts, idx) != 0;
}

/* ── env_entry_index (SML envEntry — index-returning lookup) ─
   Returns the Vec index for a name in the env, or -1 if not
   found.  Callers can then retrieve both type and mut. */

fn env_entry_index(env_names: Vec<i32>, name: i32) -> i32 {
    let n: i32 = vec_len(env_names);
    let mut i: i32 = n - 1;
    while i >= 0 {
        if vec_get(env_names, i) == name {
            return i;
        }
        i = i - 1;
    }
    return 0 - 1;
}

/* ── function type table (modEnvFromProg / synth support) ────
   Separate from the general env.  Stores function signatures
   for user-defined and built-in functions:
     fn_names      — name handles (parallel)
     fn_param_counts — param count per function (parallel)
     fn_ret_types  — return type tag per function (parallel)
     fn_param_types_flat — flat array of param type tags
     fn_param_offsets — start offset in fn_param_types_flat
                                                             */

fn fn_table_add(fn_names: Vec<i32>, fn_param_counts: Vec<i32>,
                fn_ret_types: Vec<i32>, fn_param_offsets: Vec<i32>,
                fn_param_types_flat: Vec<i32>,
                name: i32, ret_ty: i32,
                param_tags: Vec<i32>, param_count: i32) -> i32 {
    let offset: i32 = vec_len(fn_param_types_flat);
    vec_push(fn_names, name);
    vec_push(fn_param_counts, param_count);
    vec_push(fn_ret_types, ret_ty);
    vec_push(fn_param_offsets, offset);
    let mut j: i32 = 0;
    while j < param_count {
        vec_push(fn_param_types_flat, vec_get(param_tags, j));
        j = j + 1;
    }
    return vec_len(fn_names) - 1;
}

fn fn_table_lookup(fn_names: Vec<i32>, name: i32) -> i32 {
    let n: i32 = vec_len(fn_names);
    let mut i: i32 = n - 1;
    while i >= 0 {
        if vec_get(fn_names, i) == name {
            return i;
        }
        i = i - 1;
    }
    return 0 - 1;
}

fn fn_table_ret_type(fn_ret_types: Vec<i32>, idx: i32) -> i32 {
    if idx < 0 { return TY_UNKNOWN(); }
    return vec_get(fn_ret_types, idx);
}

fn fn_table_param_count(fn_param_counts: Vec<i32>, idx: i32) -> i32 {
    if idx < 0 { return 0 - 1; }
    return vec_get(fn_param_counts, idx);
}

fn fn_table_param_type(fn_param_offsets: Vec<i32>,
                       fn_param_types_flat: Vec<i32>,
                       fn_idx: i32, param_idx: i32) -> i32 {
    if fn_idx < 0 { return TY_UNKNOWN(); }
    let off: i32 = vec_get(fn_param_offsets, fn_idx);
    return vec_get(fn_param_types_flat, off + param_idx);
}

/* ── fn_table_lookup_str (string-based fn table lookup) ────────
   Companion to fn_table_lookup that compares by string value
   instead of token position.  Extracts the name string at each
   fn_names entry and compares with name_str.  Required for
   cross-scope lookups where the call-site token position differs
   from the declaration token position.                          */

fn fn_table_lookup_str(fn_names: Vec<i32>,
                       source: string, starts: Vec<i32>,
                       ends: Vec<i32>,
                       name_str: string) -> i32 {
    let n: i32 = vec_len(fn_names);
    let mut i: i32 = n - 1;
    while i >= 0 {
        let pos: i32 = vec_get(fn_names, i);
        let s: i32 = vec_get(starts, pos);
        let e: i32 = vec_get(ends, pos);
        let nm: string = string_substr(source, s, e - s);
        if string_eq(nm, name_str) {
            return i;
        }
        i = i - 1;
    }
    return 0 - 1;
}

/* ── variant shape classification ───────────────────────────── */

fn VS_UNIT() -> i32 { return 0; }
fn VS_TUPLE() -> i32 { return 1; }
fn VS_STRUCT() -> i32 { return 2; }

fn ctor_arity(shape: i32, field_count: i32) -> i32 {
    if shape == 0 { return 0; }
    return field_count;
}

fn ctor_is_unit(shape: i32) -> bool {
    return shape == 0;
}

fn ctor_is_tuple(shape: i32) -> bool {
    return shape == 1;
}

/* ── try (?) operator helpers ───────────────────────────────── */

fn is_result_enum(has_ok: bool, has_err: bool) -> bool {
    if has_ok {
        if has_err { return true; }
    }
    return false;
}

fn is_option_enum(has_some: bool, has_none: bool) -> bool {
    if has_some {
        if has_none { return true; }
    }
    return false;
}

fn try_success_shape_valid(shape: i32, field_count: i32) -> bool {
    if shape == 1 {
        if field_count == 1 { return true; }
    }
    return false;
}

/* ── error code constants ───────────────────────────────────── */

fn error_type_mismatch() -> string { return "E0400"; }
fn error_unbound_value() -> string { return "E0401"; }
fn error_stmt_no_effect() -> string { return "E0405"; }
fn error_unknown_type() -> string { return "E0406"; }
fn error_no_return_type() -> string { return "E0409"; }
fn error_duplicate_struct_enum() -> string { return "E0417"; }
fn error_unknown_struct() -> string { return "E0420"; }
fn error_unknown_variant() -> string { return "E0421"; }
fn error_unknown_enum() -> string { return "E0422"; }
fn error_enum_tuple_arity() -> string { return "E0426"; }
fn error_unknown_field() -> string { return "E0429"; }
fn error_try_payload() -> string { return "E0441"; }
fn error_immutable_assign() -> string { return "E0448"; }
fn error_bad_assign_lhs() -> string { return "E0449"; }

/* ── struct field lookup ────────────────────────────────────── */

fn struct_field_index(field_names: Vec<i32>, name: i32) -> i32 {
    let n: i32 = vec_len(field_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(field_names, i) == name {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn struct_has_field(field_names: Vec<i32>, name: i32) -> bool {
    return struct_field_index(field_names, name) >= 0;
}

/* ── type unification gate (SML expect) ────────────────────── */

fn expect(got_tag: i32, want_tag: i32) -> bool {
    return got_tag == want_tag;
}

/* ── struct/enum definition lookup ─────────────────────────── */

fn fields_of_struct(struct_names: Vec<i32>, struct_stride: i32,
                    target_name: i32) -> i32 {
    let n: i32 = vec_len(struct_names) / struct_stride;
    let mut i: i32 = 0;
    while i < n {
        if vec_get(struct_names, i * struct_stride) == target_name {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn variant_shape_of(enum_names: Vec<i32>, enum_stride: i32,
                    enum_name: i32, variant_name: i32,
                    variant_tags: Vec<i32>, variant_enum_ids: Vec<i32>) -> i32 {
    let ne: i32 = vec_len(enum_names) / enum_stride;
    let mut found_enum: bool = false;
    let mut i: i32 = 0;
    while i < ne {
        if vec_get(enum_names, i * enum_stride) == enum_name {
            found_enum = true;
            i = ne;
        }
        i = i + 1;
    }
    if found_enum == false { return 0 - 2; }
    let nv: i32 = vec_len(variant_tags);
    let mut j: i32 = 0;
    while j < nv {
        if vec_get(variant_enum_ids, j) == enum_name {
            if vec_get(variant_tags, j) == variant_name {
                return j;
            }
        }
        j = j + 1;
    }
    return 0 - 1;
}

fn assign_lhs_bad() -> i32 {
    return 0 - 1;
}

/* ── loop depth tracking (SML withLoop decomposed) ─────────── */

fn in_loop(depth: i32) -> bool {
    return depth > 0;
}

fn enter_loop(depth: i32) -> i32 {
    return depth + 1;
}

fn exit_loop(depth: i32) -> i32 {
    if depth <= 0 { return 0; }
    return depth - 1;
}

/* ── constructor type arity (SML ctorTy param count) ─────────
   VSUnit → 0 params, VSTuple → field_count params, VSStruct → field_count params.
   This is the arity of the function type a constructor creates. */
fn ctor_ty_arity(shape: i32, field_count: i32) -> i32 {
    if shape == 0 { return 0; }
    return field_count;
}

/* ── struct field type lookup (SML tyOfStructField) ──────────
   Given parallel name and type Vecs for a struct's fields,
   look up the type tag for a field by name handle.
   Returns -1 if the field is not found. */
fn struct_field_ty(field_names: Vec<i32>, field_types: Vec<i32>,
                   name: i32) -> i32 {
    let idx: i32 = struct_field_index(field_names, name);
    if idx < 0 { return 0 - 1; }
    return vec_get(field_types, idx);
}

/* ── literal type inference (SML synth ExprLit arms) ─────────
   Maps literal tag to type tag.  Tags from ast.sv0:
     0 = IntLit  → TyInt(32) = type tag 0
     1 = BoolLit → TyBool    = type tag 2
     2 = UnitLit → TyUnit    = type tag 4
     3 = StringLit → TyString = type tag 5
     4 = FloatLit → TyFloat  = type tag 1 (if supported)
   Returns -1 for unknown literal tag. */
fn infer_lit(lit_tag: i32) -> i32 {
    if lit_tag == 0 { return TY_INT(); }
    if lit_tag == 1 { return TY_BOOL(); }
    if lit_tag == 2 { return TY_UNIT(); }
    if lit_tag == 3 { return TY_STRING(); }
    if lit_tag == 4 { return TY_CHAR(); }
    return 0 - 1;
}

/* ── dup_variant_names (SML dupVariants) ───────────────────────
   Scan a Vec of variant name handles; return the index of the first
   duplicate, or -1 if all names are unique.  O(n^2) — fine for
   typical enum sizes. */
fn dup_variant_names(names: Vec<i32>) -> i32 {
    let n: i32 = vec_len(names);
    let mut i: i32 = 0;
    while i < n {
        let mut j: i32 = 0;
        while j < i {
            if vec_get(names, j) == vec_get(names, i) { return i; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── struct_enum_name_clash (SML initTypes clash check) ───────
   Given a Vec of struct name handles and a Vec of enum name handles,
   return the first struct name that also appears as an enum, or -1. */
fn struct_enum_name_clash(struct_names: Vec<i32>,
                          enum_names: Vec<i32>) -> i32 {
    let sn: i32 = vec_len(struct_names);
    let en: i32 = vec_len(enum_names);
    let mut i: i32 = 0;
    while i < sn {
        let s: i32 = vec_get(struct_names, i);
        let mut j: i32 = 0;
        while j < en {
            if vec_get(enum_names, j) == s { return s; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── named_only_ty (SML namedOnlyTy) ──────────────────────────
   Given struct and enum name tables, check whether a name handle
   is a struct, enum, or neither.  Returns:
     1 = struct, 2 = enum, 0 = not found. */
fn named_only_ty(struct_names: Vec<i32>, enum_names: Vec<i32>,
                 name: i32) -> i32 {
    let sn: i32 = vec_len(struct_names);
    let mut i: i32 = 0;
    while i < sn {
        if vec_get(struct_names, i) == name { return 1; }
        i = i + 1;
    }
    let en: i32 = vec_len(enum_names);
    let mut j: i32 = 0;
    while j < en {
        if vec_get(enum_names, j) == name { return 2; }
        j = j + 1;
    }
    return 0;
}

/* ── fields_of_struct_count (SML fieldsOfStruct length) ────── */

fn fields_of_struct_count(struct_names: Vec<i32>,
                          struct_field_counts: Vec<i32>,
                          name: i32) -> i32 {
    let n: i32 = vec_len(struct_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(struct_names, i) == name {
            return vec_get(struct_field_counts, i);
        }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── arena-aware statement return detection ────────────────────
   Uses real expression arena tags (SemiStmt=28, ExprReturn=15).
   SML stmtReturns/lastStmtReturns using arena Vecs directly. */

fn stmt_returns_arena(et: Vec<i32>, ed1: Vec<i32>, idx: i32) -> bool {
    let tag: i32 = vec_get(et, idx);
    if tag == 28 {
        let inner: i32 = vec_get(ed1, idx);
        if inner >= 0 { return vec_get(et, inner) == 15; }
        return false;
    }
    if tag == 15 { return true; }
    return false;
}

fn last_stmt_returns_arena(et: Vec<i32>, ed1: Vec<i32>,
                           first_stmt: i32,
                           stmt_count: i32) -> bool {
    if stmt_count == 0 { return false; }
    return stmt_returns_arena(et, ed1, first_stmt + stmt_count - 1);
}

/* ── token text helper ─────────────────────────────────────── */

fn chk_tok_str(source: string, starts: Vec<i32>, ends: Vec<i32>,
               pos: i32) -> string {
    let s: i32 = vec_get(starts, pos);
    let e: i32 = vec_get(ends, pos);
    return string_substr(source, s, e - s);
}

/* ── expr_references_result (SML exprReferencesResult) ────────
   Recursive walk over the expression arena checking whether any
   ExprPath is the single-segment path "result".  Used by
   checkContract to reject `ensures` on unit-returning functions
   that mention `result`. */

fn expr_references_result(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                          ed3: Vec<i32>, ed4: Vec<i32>, idx: i32,
                          source: string, starts: Vec<i32>,
                          ends: Vec<i32>, pp: Vec<i32>) -> bool {
    if idx < 0 { return false; }
    let tag: i32 = vec_get(et, idx);
    if tag == 0 { return false; }
    if tag == 1 {
        let pps: i32 = vec_get(ed1, idx);
        let ppc: i32 = vec_get(ed2, idx);
        if ppc == 1 {
            let tok: i32 = vec_get(pp, pps);
            let name: string = chk_tok_str(source, starts, ends, tok);
            return string_eq(name, "result");
        }
        return false;
    }
    if tag == 2 {
        return expr_references_result(et, ed1, ed2, ed3, ed4,
                                       vec_get(ed2, idx),
                                       source, starts, ends, pp);
    }
    if tag == 3 {
        if expr_references_result(et, ed1, ed2, ed3, ed4,
                                   vec_get(ed2, idx),
                                   source, starts, ends, pp) { return true; }
        return expr_references_result(et, ed1, ed2, ed3, ed4,
                                       vec_get(ed3, idx),
                                       source, starts, ends, pp);
    }
    if tag == 4 {
        let callee: i32 = vec_get(ed1, idx);
        if expr_references_result(et, ed1, ed2, ed3, ed4, callee,
                                   source, starts, ends, pp) { return true; }
        let af: i32 = vec_get(ed2, idx);
        let ac: i32 = vec_get(ed3, idx);
        let mut ai: i32 = 0;
        while ai < ac {
            if expr_references_result(et, ed1, ed2, ed3, ed4, af + ai,
                                       source, starts, ends, pp) { return true; }
            ai = ai + 1;
        }
        return false;
    }
    if tag == 6 {
        return expr_references_result(et, ed1, ed2, ed3, ed4,
                                       vec_get(ed1, idx),
                                       source, starts, ends, pp);
    }
    if tag == 10 {
        if expr_references_result(et, ed1, ed2, ed3, ed4,
                                   vec_get(ed1, idx),
                                   source, starts, ends, pp) { return true; }
        if expr_references_result(et, ed1, ed2, ed3, ed4,
                                   vec_get(ed2, idx),
                                   source, starts, ends, pp) { return true; }
        let else_idx: i32 = vec_get(ed3, idx);
        if else_idx >= 0 {
            return expr_references_result(et, ed1, ed2, ed3, ed4, else_idx,
                                           source, starts, ends, pp);
        }
        return false;
    }
    if tag == 11 {
        let scrut: i32 = vec_get(ed1, idx);
        if expr_references_result(et, ed1, ed2, ed3, ed4, scrut,
                                   source, starts, ends, pp) { return true; }
        let arms_f: i32 = vec_get(ed2, idx);
        let arms_c: i32 = vec_get(ed3, idx);
        let mut ami: i32 = 0;
        while ami < arms_c {
            let arm_idx: i32 = arms_f + ami;
            let guard: i32 = vec_get(ed3, arm_idx);
            let body: i32 = vec_get(ed4, arm_idx);
            if guard >= 0 {
                if expr_references_result(et, ed1, ed2, ed3, ed4, guard,
                                           source, starts, ends, pp) { return true; }
            }
            if expr_references_result(et, ed1, ed2, ed3, ed4, body,
                                       source, starts, ends, pp) { return true; }
            ami = ami + 1;
        }
        return false;
    }
    if tag == 12 {
        if expr_references_result(et, ed1, ed2, ed3, ed4,
                                   vec_get(ed1, idx),
                                   source, starts, ends, pp) { return true; }
        let inv_f: i32 = vec_get(ed3, idx);
        let inv_c: i32 = vec_get(ed4, idx);
        let mut ii: i32 = 0;
        while ii < inv_c {
            if expr_references_result(et, ed1, ed2, ed3, ed4, inv_f + ii,
                                       source, starts, ends, pp) { return true; }
            ii = ii + 1;
        }
        return expr_references_result(et, ed1, ed2, ed3, ed4,
                                       vec_get(ed2, idx),
                                       source, starts, ends, pp);
    }
    if tag == 13 {
        if expr_references_result(et, ed1, ed2, ed3, ed4,
                                   vec_get(ed2, idx),
                                   source, starts, ends, pp) { return true; }
        return expr_references_result(et, ed1, ed2, ed3, ed4,
                                       vec_get(ed3, idx),
                                       source, starts, ends, pp);
    }
    if tag == 14 {
        return expr_references_result(et, ed1, ed2, ed3, ed4,
                                       vec_get(ed1, idx),
                                       source, starts, ends, pp);
    }
    if tag == 16 {
        let bv: i32 = vec_get(ed1, idx);
        if bv >= 0 {
            return expr_references_result(et, ed1, ed2, ed3, ed4, bv,
                                           source, starts, ends, pp);
        }
        return false;
    }
    if tag == 17 { return false; }
    if tag == 18 {
        if expr_references_result(et, ed1, ed2, ed3, ed4,
                                   vec_get(ed1, idx),
                                   source, starts, ends, pp) { return true; }
        return expr_references_result(et, ed1, ed2, ed3, ed4,
                                       vec_get(ed2, idx),
                                       source, starts, ends, pp);
    }
    if tag == 19 {
        if expr_references_result(et, ed1, ed2, ed3, ed4,
                                   vec_get(ed2, idx),
                                   source, starts, ends, pp) { return true; }
        return expr_references_result(et, ed1, ed2, ed3, ed4,
                                       vec_get(ed3, idx),
                                       source, starts, ends, pp);
    }
    if tag == 20 {
        return expr_references_result(et, ed1, ed2, ed3, ed4,
                                       vec_get(ed1, idx),
                                       source, starts, ends, pp);
    }
    if tag == 22 {
        return expr_references_result(et, ed1, ed2, ed3, ed4,
                                       vec_get(ed1, idx),
                                       source, starts, ends, pp);
    }
    if tag == 24 {
        let sfc: i32 = vec_get(ed3, idx);
        let mut sfi: i32 = 0;
        while sfi < sfc {
            if expr_references_result(et, ed1, ed2, ed3, ed4,
                                       idx - sfc + sfi,
                                       source, starts, ends, pp) { return true; }
            sfi = sfi + 1;
        }
        return false;
    }
    if tag == 25 {
        let tf: i32 = vec_get(ed1, idx);
        let tc: i32 = vec_get(ed2, idx);
        let mut ti: i32 = 0;
        while ti < tc {
            if expr_references_result(et, ed1, ed2, ed3, ed4, tf + ti,
                                       source, starts, ends, pp) { return true; }
            ti = ti + 1;
        }
        return false;
    }
    return false;
}

/* ── type_param_push / type_param_lookup (SML withTypeParams) ─
   In SML, withTypeParams saves currentTypeParams, appends new
   bindings, runs a thunk, then restores.  In sv0 (no vec_pop /
   vec_set), we use a logical-length model: push appends pairs and
   returns the saved length; the caller treats that length as the
   restore point for subsequent lookups.  The type_params Vec
   stores (name_handle, ty_tag) pairs with stride 2.
   To "restore", the caller passes the saved_len to lookup — no
   physical truncation needed. */

fn type_param_push(type_params: Vec<i32>,
                   new_names: Vec<i32>, new_tags: Vec<i32>) -> i32 {
    let saved: i32 = vec_len(type_params);
    let count: i32 = vec_len(new_names);
    let mut i: i32 = 0;
    while i < count {
        vec_push(type_params, vec_get(new_names, i));
        vec_push(type_params, vec_get(new_tags, i));
        i = i + 1;
    }
    return saved;
}

fn type_param_lookup(type_params: Vec<i32>, limit: i32,
                     name: i32) -> i32 {
    let mut i: i32 = limit - 2;
    while i >= 0 {
        if vec_get(type_params, i) == name {
            return vec_get(type_params, i + 1);
        }
        i = i - 2;
    }
    return 0 - 1;
}

/* ── resolve_field_ty_tag (SML resolveFieldTy, simplified) ───
   Maps a parser type arena node to a types.sv0 Ty tag for struct/enum
   field definitions (used by initTypes).  Unlike astTyToTy, this
   function does NOT return Option — it returns -1 on error.
   Works on the parser type arena: ty_tags, ty_data1/d2/d3.
   For TyName with a single segment: tries primitive names first,
   then checks struct/enum name tables.
   For TyUnit/TyRef/TyRefMut/TyTuple: returns the corresponding
   types.sv0 tag.  Does not handle Vec/Box/Array generics (returns -1). */

fn resolve_field_ty_tag(ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                        ty_d2: Vec<i32>, ty_d3: Vec<i32>,
                        pp: Vec<i32>,
                        source: string, starts: Vec<i32>,
                        ends: Vec<i32>,
                        struct_names: Vec<i32>, enum_names: Vec<i32>,
                        type_params: Vec<i32>, tp_limit: i32,
                        idx: i32) -> i32 {
    if idx < 0 { return 0 - 1; }
    let tag: i32 = vec_get(ty_tags, idx);
    if tag == 6 { return TY_UNIT(); }
    if tag == 2 { return TY_REF(); }
    if tag == 3 { return TY_REFMUT(); }
    if tag == 7 { return TY_TUPLE(); }
    if tag == 0 {
        let seg_count: i32 = vec_get(ty_d2, idx);
        if seg_count == 1 {
            let pps: i32 = vec_get(ty_d1, idx);
            let tok: i32 = vec_get(pp, pps);
            let s: i32 = vec_get(starts, tok);
            let e: i32 = vec_get(ends, tok);
            let name: string = string_substr(source, s, e - s);
            let prim: i32 = ast_ty_to_types_tag(name);
            if prim >= 0 { return prim; }
            let mut ni: i32 = 0;
            while ni < vec_len(struct_names) {
                if vec_get(struct_names, ni) == tok {
                    return TY_STRUCT();
                }
                ni = ni + 1;
            }
            let mut ei: i32 = 0;
            while ei < vec_len(enum_names) {
                if vec_get(enum_names, ei) == tok {
                    return TY_ENUM();
                }
                ei = ei + 1;
            }
            let tp: i32 = type_param_lookup(type_params, tp_limit, tok);
            if tp >= 0 { return TY_VAR(); }
            return 0 - 1;
        }
        return 0 - 1;
    }
    return 0 - 1;
}

/* ── ast_ty_to_ty_payload (SML astTyToTy — full dispatch) ────
   Extends resolve_field_ty_tag by also returning payload data.
   For TyInt/TyUint/TyFloat: pushes width (8/16/32/64/128) to out.
   For TyStruct/TyEnum: pushes name token handle to out.
   For TyVar: pushes the type parameter index to out.
   For simple types (TyUnit, TyBool, etc.): out unchanged.
   Returns the type tag, or -1 for unknown.  */

fn ast_ty_to_ty_payload(ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                        ty_d2: Vec<i32>, ty_d3: Vec<i32>,
                        pp: Vec<i32>,
                        source: string, starts: Vec<i32>,
                        ends: Vec<i32>,
                        struct_names: Vec<i32>, enum_names: Vec<i32>,
                        type_params: Vec<i32>, tp_limit: i32,
                        idx: i32, out_payload: Vec<i32>) -> i32 {
    if idx < 0 { return 0 - 1; }
    let tag: i32 = vec_get(ty_tags, idx);
    if tag == 6 { return TY_UNIT(); }
    if tag == 2 { return TY_REF(); }
    if tag == 3 { return TY_REFMUT(); }
    if tag == 7 { return TY_TUPLE(); }
    if tag == 0 {
        let seg_count: i32 = vec_get(ty_d2, idx);
        if seg_count == 1 {
            let pps: i32 = vec_get(ty_d1, idx);
            let tok: i32 = vec_get(pp, pps);
            let s: i32 = vec_get(starts, tok);
            let e: i32 = vec_get(ends, tok);
            let name: string = string_substr(source, s, e - s);
            let prim: i32 = ast_type_name_to_tag(name);
            if prim >= 0 {
                let w: i32 = int_width_from_name(name);
                if w > 0 { vec_push(out_payload, w); }
                return prim;
            }
            let mut ni: i32 = 0;
            while ni < vec_len(struct_names) {
                if vec_get(struct_names, ni) == tok {
                    vec_push(out_payload, tok);
                    return TY_STRUCT();
                }
                ni = ni + 1;
            }
            let mut ei: i32 = 0;
            while ei < vec_len(enum_names) {
                if vec_get(enum_names, ei) == tok {
                    vec_push(out_payload, tok);
                    return TY_ENUM();
                }
                ei = ei + 1;
            }
            let tp: i32 = type_param_lookup(type_params, tp_limit, tok);
            if tp >= 0 {
                vec_push(out_payload, tp);
                return TY_VAR();
            }
            return 0 - 1;
        }
        return 0 - 1;
    }
    return 0 - 1;
}

/* ── enum_ctor_count (variant count for an enum) ───────────── */

fn enum_ctor_count(variant_enum_ids: Vec<i32>, enum_name: i32) -> i32 {
    let nv: i32 = vec_len(variant_enum_ids);
    let mut count: i32 = 0;
    let mut j: i32 = 0;
    while j < nv {
        if vec_get(variant_enum_ids, j) == enum_name {
            count = count + 1;
        }
        j = j + 1;
    }
    return count;
}

/* ── item_fn_ret_ty_tag (function return type tag) ──────────
   Given a function item's return type arena index (or -1 for
   no explicit return type), resolves to a Ty tag.  Returns
   TY_UNKNOWN (-1) if no return type or type not found.
   Building block for itemFnTy / modEnvFromProg. */

fn item_fn_ret_ty_tag(ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                      ty_d2: Vec<i32>, ty_d3: Vec<i32>,
                      pp: Vec<i32>,
                      source: string, starts: Vec<i32>,
                      ends: Vec<i32>,
                      struct_names: Vec<i32>, enum_names: Vec<i32>,
                      type_params: Vec<i32>, tp_limit: i32,
                      ret_idx: i32) -> i32 {
    if ret_idx < 0 { return TY_UNKNOWN(); }
    return resolve_field_ty_tag(ty_tags, ty_d1, ty_d2, ty_d3,
                                pp, source, starts, ends,
                                struct_names, enum_names,
                                type_params, tp_limit, ret_idx);
}

/* ── scan_struct_field_names (token re-scan for initTypes) ────
   Given a struct's name_tok_pos (from the item arena d1 for
   ItemStruct) and its field_count (from d2), re-walk the token
   stream to extract field name token positions.
   Token layout: `struct Name { field1: Type, field2: Type }`
   Tags: 89(struct) 5(IDENT) ...generics... 8({) 5(IDENT) 14(:)
         type_tokens... 12(,) 5(IDENT) 14(:) type_tokens... 9(})
   Pushes field_count name token positions into out_field_names.
   pub_tag=87 can precede field names; skip it.
   Returns 0 on success, -1 on unexpected tokens. */

fn scan_struct_field_names(tok_tags: Vec<i32>, name_tok_pos: i32,
                           field_count: i32,
                           out_field_names: Vec<i32>) -> i32 {
    let mut p: i32 = name_tok_pos + 1;
    while vec_get(tok_tags, p) != 8 {
        p = p + 1;
        if p >= vec_len(tok_tags) { return 0 - 1; }
    }
    p = p + 1;
    let mut found: i32 = 0;
    while found < field_count {
        if vec_get(tok_tags, p) == 87 { p = p + 1; }
        if vec_get(tok_tags, p) != 5 { return 0 - 1; }
        vec_push(out_field_names, p);
        found = found + 1;
        p = p + 1;
        if vec_get(tok_tags, p) != 14 { return 0 - 1; }
        p = p + 1;
        let mut depth: i32 = 0;
        let mut scanning_type: bool = true;
        while scanning_type {
            let t: i32 = vec_get(tok_tags, p);
            if t == 8 { depth = depth + 1; p = p + 1; }
            else {
                if t == 10 { depth = depth + 1; p = p + 1; }
                else {
                    if t == 9 {
                        if depth > 0 { depth = depth - 1; p = p + 1; }
                        else { scanning_type = false; }
                    } else {
                        if t == 11 {
                            if depth > 0 { depth = depth - 1; p = p + 1; }
                            else { scanning_type = false; }
                        } else {
                            if t == 12 {
                                if depth == 0 { scanning_type = false; p = p + 1; }
                                else { p = p + 1; }
                            } else { p = p + 1; }
                        }
                    }
                }
            }
        }
    }
    return 0;
}

/* ── scan_enum_variant_names (token re-scan for initTypes) ───
   Given an enum's name_tok_pos and variant_count, re-walk the
   token stream to extract variant name token positions.
   Token layout: `enum Name { Var1, Var2(T), Var3 { f: T } }`
   Pushes variant_count name token positions into out.
   Returns 0 on success, -1 on unexpected tokens. */

fn scan_enum_variant_names(tok_tags: Vec<i32>, name_tok_pos: i32,
                            variant_count: i32,
                            out_variant_names: Vec<i32>) -> i32 {
    let mut p: i32 = name_tok_pos + 1;
    while vec_get(tok_tags, p) != 8 {
        p = p + 1;
        if p >= vec_len(tok_tags) { return 0 - 1; }
    }
    p = p + 1;
    let mut found: i32 = 0;
    while found < variant_count {
        if vec_get(tok_tags, p) != 5 { return 0 - 1; }
        vec_push(out_variant_names, p);
        found = found + 1;
        p = p + 1;
        let t: i32 = vec_get(tok_tags, p);
        if t == 6 {
            let mut depth: i32 = 1;
            p = p + 1;
            while depth > 0 {
                let u: i32 = vec_get(tok_tags, p);
                if u == 6 { depth = depth + 1; }
                if u == 7 { depth = depth - 1; }
                p = p + 1;
            }
        }
        if t == 10 {
            let mut depth: i32 = 1;
            p = p + 1;
            while depth > 0 {
                let u: i32 = vec_get(tok_tags, p);
                if u == 10 { depth = depth + 1; }
                if u == 11 { depth = depth - 1; }
                p = p + 1;
            }
        }
        if t == 8 {
            let mut depth: i32 = 1;
            p = p + 1;
            while depth > 0 {
                let u: i32 = vec_get(tok_tags, p);
                if u == 8 { depth = depth + 1; }
                if u == 9 { depth = depth - 1; }
                p = p + 1;
            }
        }
        if vec_get(tok_tags, p) == 12 { p = p + 1; }
    }
    return 0;
}

/* ── type_param_lookup_str (string-based type param lookup) ───
   Companion to type_param_lookup that compares by string value
   instead of token position.  The type_params Vec stores stride-2
   entries (tok_pos, tag); this function extracts the string at each
   tok_pos and compares with name_str.  Returns the tag on match,
   or -1 if not found.  Needed by scan_type_tag_at where the type
   annotation token is at a different position than the declaration
   token but refers to the same name.                            */

fn type_param_lookup_str(type_params: Vec<i32>, limit: i32,
                         source: string, starts: Vec<i32>,
                         ends: Vec<i32>,
                         name_str: string) -> i32 {
    let mut i: i32 = limit - 2;
    while i >= 0 {
        let tp_pos: i32 = vec_get(type_params, i);
        let tps: i32 = vec_get(starts, tp_pos);
        let tpe: i32 = vec_get(ends, tp_pos);
        let tp_name: string = string_substr(source, tps, tpe - tps);
        if string_eq(tp_name, name_str) {
            return vec_get(type_params, i + 1);
        }
        i = i - 2;
    }
    return 0 - 1;
}

/* ── scan_type_tag_at (token-stream type resolver) ────────────
   Given a position in the token stream at the start of a type
   annotation, resolves it to a checker type tag.  Pushes the
   resolved tag into out_tag.  Returns the token position AFTER
   the consumed type tokens, or -1 on error.

   Handles:
     IDENT         → primitive dispatch (ast_type_name_to_tag),
                     struct/enum name (string comparison), or
                     type param (string-based lookup)
     IDENT < ... > → TY_NAMED (Vec, Box, generic container)
     ( )           → TY_UNIT
     ( T, ... )    → TY_TUPLE (balanced parens)
     & T           → TY_REF
     & mut T       → TY_REFMUT
     fallback      → TY_UNKNOWN

   Token tags: IDENT=5, LPAREN=6, RPAREN=7, LT=38, GT=39,
   AMP=27, MUT=77.                                              */

fn scan_type_tag_at(tok_tags: Vec<i32>, source: string,
                    starts: Vec<i32>, ends: Vec<i32>,
                    struct_names: Vec<i32>, enum_names: Vec<i32>,
                    type_params: Vec<i32>, tp_limit: i32,
                    pos: i32, out_tag: Vec<i32>) -> i32 {
    let t: i32 = vec_get(tok_tags, pos);
    if t == 5 {
        if vec_get(tok_tags, pos + 1) == 38 {
            let mut depth: i32 = 1;
            let mut p: i32 = pos + 2;
            while depth > 0 {
                let u: i32 = vec_get(tok_tags, p);
                if u == 38 { depth = depth + 1; }
                if u == 39 { depth = depth - 1; }
                p = p + 1;
            }
            vec_push(out_tag, 15);
            return p;
        }
        let s: i32 = vec_get(starts, pos);
        let e: i32 = vec_get(ends, pos);
        let name: string = string_substr(source, s, e - s);
        let prim: i32 = ast_type_name_to_tag(name);
        if prim >= 0 {
            vec_push(out_tag, prim);
            return pos + 1;
        }
        let mut ni: i32 = 0;
        while ni < vec_len(struct_names) {
            let sn: i32 = vec_get(struct_names, ni);
            let ss: i32 = vec_get(starts, sn);
            let se: i32 = vec_get(ends, sn);
            let sname: string = string_substr(source, ss, se - ss);
            if string_eq(name, sname) {
                vec_push(out_tag, 6);
                return pos + 1;
            }
            ni = ni + 1;
        }
        let mut ei: i32 = 0;
        while ei < vec_len(enum_names) {
            let en_pos: i32 = vec_get(enum_names, ei);
            let es: i32 = vec_get(starts, en_pos);
            let ee: i32 = vec_get(ends, en_pos);
            let ename: string = string_substr(source, es, ee - es);
            if string_eq(name, ename) {
                vec_push(out_tag, 7);
                return pos + 1;
            }
            ei = ei + 1;
        }
        let tp: i32 = type_param_lookup_str(type_params, tp_limit,
                                             source, starts, ends, name);
        if tp >= 0 {
            vec_push(out_tag, 16);
            return pos + 1;
        }
        vec_push(out_tag, 0 - 1);
        return pos + 1;
    }
    if t == 6 {
        if vec_get(tok_tags, pos + 1) == 7 {
            vec_push(out_tag, 2);
            return pos + 2;
        }
        let mut depth: i32 = 1;
        let mut p: i32 = pos + 1;
        while depth > 0 {
            let u: i32 = vec_get(tok_tags, p);
            if u == 6 { depth = depth + 1; }
            if u == 7 { depth = depth - 1; }
            p = p + 1;
        }
        vec_push(out_tag, 14);
        return p;
    }
    if t == 27 {
        if vec_get(tok_tags, pos + 1) == 77 {
            let inner_out: Vec<i32> = vec_new();
            let p: i32 = scan_type_tag_at(tok_tags, source, starts, ends,
                                           struct_names, enum_names,
                                           type_params, tp_limit,
                                           pos + 2, inner_out);
            vec_push(out_tag, 13);
            return p;
        }
        let inner_out: Vec<i32> = vec_new();
        let p: i32 = scan_type_tag_at(tok_tags, source, starts, ends,
                                       struct_names, enum_names,
                                       type_params, tp_limit,
                                       pos + 1, inner_out);
        vec_push(out_tag, 12);
        return p;
    }
    vec_push(out_tag, 0 - 1);
    return pos + 1;
}

/* ── scan_struct_field_type_tags (field type extraction) ────────
   Given field name positions (from scan_struct_field_names),
   resolves each field's type by calling scan_type_tag_at at
   position name_pos + 2 (past IDENT COLON).  Pushes one type
   tag per field into out_field_types.  Returns 0 on success.  */

fn scan_struct_field_type_tags(tok_tags: Vec<i32>, source: string,
                               starts: Vec<i32>, ends: Vec<i32>,
                               struct_names: Vec<i32>,
                               enum_names: Vec<i32>,
                               type_params: Vec<i32>, tp_limit: i32,
                               field_name_positions: Vec<i32>,
                               out_field_types: Vec<i32>) -> i32 {
    let count: i32 = vec_len(field_name_positions);
    let mut i: i32 = 0;
    while i < count {
        let name_pos: i32 = vec_get(field_name_positions, i);
        let type_start: i32 = name_pos + 2;
        let _end: i32 = scan_type_tag_at(tok_tags, source, starts, ends,
                                          struct_names, enum_names,
                                          type_params, tp_limit,
                                          type_start, out_field_types);
        i = i + 1;
    }
    return 0;
}

/* ── scan_fn_param_type_tags (function param type extraction) ──
   For a function with name_tok_pos (from item arena id1) and
   param_count (from id3), re-scans the token stream to extract
   each parameter's type tag.  Walks past optional generics
   <...>, through ( ), handling [mut] IDENT : Type patterns.
   Pushes param_count type tags into out_param_types.
   Returns 0 on success, -1 on unexpected tokens.

   Token layout: fn NAME [<...>] ( [mut] p1 : T1 , [mut] p2 : T2 ) ...
   Token tags: FN=65 IDENT=5 LT=38 GT=39 LPAREN=6 RPAREN=7
               MUT=77 SELF=86 COLON=14 COMMA=12                */

fn scan_fn_param_type_tags(tok_tags: Vec<i32>, source: string,
                           starts: Vec<i32>, ends: Vec<i32>,
                           struct_names: Vec<i32>,
                           enum_names: Vec<i32>,
                           type_params: Vec<i32>, tp_limit: i32,
                           name_tok_pos: i32, param_count: i32,
                           out_param_types: Vec<i32>) -> i32 {
    if param_count == 0 { return 0; }
    let mut p: i32 = name_tok_pos + 1;
    if vec_get(tok_tags, p) == 38 {
        let mut depth: i32 = 1;
        p = p + 1;
        while depth > 0 {
            let u: i32 = vec_get(tok_tags, p);
            if u == 38 { depth = depth + 1; }
            if u == 39 { depth = depth - 1; }
            p = p + 1;
        }
    }
    if vec_get(tok_tags, p) != 6 { return 0 - 1; }
    p = p + 1;
    let mut found: i32 = 0;
    while found < param_count {
        if vec_get(tok_tags, p) == 77 { p = p + 1; }
        let pt: i32 = vec_get(tok_tags, p);
        if pt != 5 {
            if pt != 86 { return 0 - 1; }
        }
        p = p + 1;
        if vec_get(tok_tags, p) != 14 { return 0 - 1; }
        p = p + 1;
        p = scan_type_tag_at(tok_tags, source, starts, ends,
                              struct_names, enum_names,
                              type_params, tp_limit,
                              p, out_param_types);
        if p < 0 { return 0 - 1; }
        found = found + 1;
        if vec_get(tok_tags, p) == 12 { p = p + 1; }
    }
    return 0;
}

/* ── scan_fn_ret_type_tag (token re-scan for fn return type) ──
   For a function with name_tok_pos and has_ret flag (from id2),
   re-scans the token stream to resolve the return type to a
   type tag.  Walks past optional generics and balanced parens
   to find the -> arrow, then uses scan_type_tag_at on the type
   after the arrow.  Returns TY_UNIT if has_ret == 0.           */

fn scan_fn_ret_type_tag(tok_tags: Vec<i32>, source: string,
                        starts: Vec<i32>, ends: Vec<i32>,
                        struct_names: Vec<i32>,
                        enum_names: Vec<i32>,
                        type_params: Vec<i32>, tp_limit: i32,
                        name_tok_pos: i32, has_ret: i32) -> i32 {
    if has_ret == 0 { return TY_UNIT(); }
    let mut p: i32 = name_tok_pos + 1;
    if vec_get(tok_tags, p) == 38 {
        let mut depth: i32 = 1;
        p = p + 1;
        while depth > 0 {
            let u: i32 = vec_get(tok_tags, p);
            if u == 38 { depth = depth + 1; }
            if u == 39 { depth = depth - 1; }
            p = p + 1;
        }
    }
    if vec_get(tok_tags, p) != 6 { return TY_UNKNOWN(); }
    let mut depth: i32 = 1;
    p = p + 1;
    while depth > 0 {
        let u: i32 = vec_get(tok_tags, p);
        if u == 6 { depth = depth + 1; }
        if u == 7 { depth = depth - 1; }
        p = p + 1;
    }
    if vec_get(tok_tags, p) != 19 { return TY_UNKNOWN(); }
    let out: Vec<i32> = vec_new();
    let _end: i32 = scan_type_tag_at(tok_tags, source, starts, ends,
                                      struct_names, enum_names,
                                      type_params, tp_limit,
                                      p + 1, out);
    if vec_len(out) == 0 { return TY_UNKNOWN(); }
    return vec_get(out, 0);
}

/* ── item_fn_ty_to_table (SML itemFnTy → fn table) ────────────
   Given an item arena index for an ItemFn, extracts param type
   tags (via scan_fn_param_type_tags) and return type tag (via
   scan_fn_ret_type_tag), then registers in the function type
   table via fn_table_add.  Returns 0 on success, -1 on error. */

fn item_fn_ty_to_table(tok_tags: Vec<i32>, source: string,
                       starts: Vec<i32>, ends: Vec<i32>,
                       struct_names: Vec<i32>,
                       enum_names: Vec<i32>,
                       type_params: Vec<i32>, tp_limit: i32,
                       id1: Vec<i32>, id2: Vec<i32>,
                       id3: Vec<i32>,
                       fn_names: Vec<i32>,
                       fn_param_counts: Vec<i32>,
                       fn_ret_types: Vec<i32>,
                       fn_param_offsets: Vec<i32>,
                       fn_param_types_flat: Vec<i32>,
                       item_idx: i32) -> i32 {
    let name_pos: i32 = vec_get(id1, item_idx);
    let has_ret: i32 = vec_get(id2, item_idx);
    let param_count: i32 = vec_get(id3, item_idx);
    let param_types: Vec<i32> = vec_new();
    let r1: i32 = scan_fn_param_type_tags(tok_tags, source, starts, ends,
                                           struct_names, enum_names,
                                           type_params, tp_limit,
                                           name_pos, param_count,
                                           param_types);
    if r1 < 0 { return 0 - 1; }
    let ret_tag: i32 = scan_fn_ret_type_tag(tok_tags, source, starts, ends,
                                             struct_names, enum_names,
                                             type_params, tp_limit,
                                             name_pos, has_ret);
    let _idx: i32 = fn_table_add(fn_names, fn_param_counts,
                                  fn_ret_types, fn_param_offsets,
                                  fn_param_types_flat,
                                  name_pos, ret_tag,
                                  param_types, param_count);
    return 0;
}

/* ── register_all_item_fns (first part of modEnvFromProg) ─────
   Walks all item arena entries; for each ItemFn (it[i] == 0),
   calls item_fn_ty_to_table to extract and register the
   function's type.  Returns the count of registered functions. */

fn register_all_item_fns(tok_tags: Vec<i32>, source: string,
                         starts: Vec<i32>, ends: Vec<i32>,
                         struct_names: Vec<i32>,
                         enum_names: Vec<i32>,
                         type_params: Vec<i32>, tp_limit: i32,
                         it: Vec<i32>, id1: Vec<i32>,
                         id2: Vec<i32>, id3: Vec<i32>,
                         fn_names: Vec<i32>,
                         fn_param_counts: Vec<i32>,
                         fn_ret_types: Vec<i32>,
                         fn_param_offsets: Vec<i32>,
                         fn_param_types_flat: Vec<i32>) -> i32 {
    let n: i32 = vec_len(it);
    let mut count: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        if vec_get(it, i) == 0 {
            let r: i32 = item_fn_ty_to_table(tok_tags, source,
                                              starts, ends,
                                              struct_names, enum_names,
                                              type_params, tp_limit,
                                              id1, id2, id3,
                                              fn_names, fn_param_counts,
                                              fn_ret_types, fn_param_offsets,
                                              fn_param_types_flat, i);
            if r == 0 { count = count + 1; }
        }
        i = i + 1;
    }
    return count;
}

/* ── contract_expr scoped flag (SML withContractExpr) ────────
   SML uses a mutable bool ref toggled by withContractExpr; sv0
   decomposes into enter/exit and a pure query.  The flag is
   represented as a stride-0 Vec<i32> (single element) that
   callers thread through the checker:
     0 = not inside a contract expression
     1 = inside a contract expression                        */

fn contract_expr_new() -> Vec<i32> {
    let v: Vec<i32> = vec_new();
    vec_push(v, 0);
    return v;
}

fn contract_expr_enter(flag: Vec<i32>) -> i32 {
    let saved: i32 = vec_get(flag, 0);
    vec_push(flag, 1);
    return saved;
}

fn contract_expr_exit(flag: Vec<i32>, saved: i32) -> i32 {
    vec_push(flag, saved);
    return 0;
}

fn contract_expr_active(flag: Vec<i32>) -> bool {
    let n: i32 = vec_len(flag);
    return vec_get(flag, n - 1) == 1;
}

/* ── ty import alias scoped push (SML addTyImportAlias /
   clearTyImportAliases) ─────────────────────────────────────
   Uses the same logical-length model as type_param_push:
   aliases are stride-2 (from, to) in a single Vec; push
   returns the saved length; callers pass saved_len as limit
   to alias_lookup and canon_ty_import to restrict scope.
   "clear" = use limit 0.                                    */

fn ty_import_alias_push(aliases: Vec<i32>,
                        from_h: i32, to_h: i32) -> i32 {
    let saved: i32 = vec_len(aliases);
    vec_push(aliases, from_h);
    vec_push(aliases, to_h);
    return saved;
}

fn alias_lookup_bounded(names: Vec<i32>, targets: Vec<i32>,
                        limit: i32, name: i32) -> i32 {
    let n: i32 = limit;
    let mut i: i32 = 0;
    while i < n {
        if vec_get(names, i) == name {
            return vec_get(targets, i);
        }
        i = i + 1;
    }
    return name;
}

/* ── ctor_ty_tag (SML ctorTy — constructor type tag) ────────
   Returns TY_FN when the variant has parameters (VSTuple or
   VSStruct), TY_ENUM when it is VSUnit (nullary).  The caller
   supplies the variant shape tag (0=Unit, 1=Tuple, 2=Struct)
   and the param_count.  This is the tag-level building block;
   the full TyFn(param_types, TyEnum en) construction comes
   with initTypes.                                           */

fn ctor_ty_tag(shape: i32, param_count: i32) -> i32 {
    if shape == 0 { return TY_ENUM(); }
    if param_count > 0 { return TY_FN(); }
    return TY_ENUM();
}

/* ── try_success_validate (SML trySuccessPayloadTy) ─────────
   Validate that an enum is a valid `?` target (Result or Option).
   Scans variant_tags/variant_enum_ids for Ok/Err or Some/None
   variants (using string comparison via source/starts/ends),
   then checks the success variant (Ok or Some) has VSTuple
   shape with exactly 1 field.
   Returns:
     1 = valid Result (has Ok(T)/Err(E))
     2 = valid Option (has Some(T)/None)
     0 = not a Result/Option enum
    -1 = has Ok/Err or Some/None but success variant shape invalid
   The success variant's flat index is pushed to out_idx. */

fn try_success_validate(variant_tags: Vec<i32>,
                        variant_enum_ids: Vec<i32>,
                        variant_shapes: Vec<i32>,
                        variant_field_counts: Vec<i32>,
                        enum_name: i32,
                        source: string, starts: Vec<i32>,
                        ends: Vec<i32>,
                        out_idx: Vec<i32>) -> i32 {
    let nv: i32 = vec_len(variant_tags);
    let mut has_ok: bool = false;
    let mut has_err: bool = false;
    let mut has_some: bool = false;
    let mut has_none: bool = false;
    let mut ok_idx: i32 = 0 - 1;
    let mut some_idx: i32 = 0 - 1;
    let mut j: i32 = 0;
    while j < nv {
        if vec_get(variant_enum_ids, j) == enum_name {
            let vh: i32 = vec_get(variant_tags, j);
            let vs: i32 = vec_get(starts, vh);
            let ve: i32 = vec_get(ends, vh);
            let vn: string = string_substr(source, vs, ve - vs);
            if string_eq(vn, "Ok") { has_ok = true; ok_idx = j; }
            if string_eq(vn, "Err") { has_err = true; }
            if string_eq(vn, "Some") { has_some = true; some_idx = j; }
            if string_eq(vn, "None") { has_none = true; }
        }
        j = j + 1;
    }
    if has_ok {
        if has_err {
            let sh: i32 = vec_get(variant_shapes, ok_idx);
            let fc: i32 = vec_get(variant_field_counts, ok_idx);
            if try_success_shape_valid(sh, fc) {
                vec_push(out_idx, ok_idx);
                return 1;
            }
            return 0 - 1;
        }
    }
    if has_some {
        if has_none {
            let sh2: i32 = vec_get(variant_shapes, some_idx);
            let fc2: i32 = vec_get(variant_field_counts, some_idx);
            if try_success_shape_valid(sh2, fc2) {
                vec_push(out_idx, some_idx);
                return 2;
            }
            return 0 - 1;
        }
    }
    return 0;
}

/* ── scan_enum_variant_shapes (token re-scan for initTypes) ──
   Given variant name positions (from scan_enum_variant_names),
   determine each variant's shape by inspecting the token
   immediately after the variant name:
     ( → VSTuple(1)   { → VSStruct(2)   else → VSUnit(0)    */

fn scan_enum_variant_shapes(tok_tags: Vec<i32>,
                             variant_name_positions: Vec<i32>,
                             out_shapes: Vec<i32>) -> i32 {
    let n: i32 = vec_len(variant_name_positions);
    let mut i: i32 = 0;
    while i < n {
        let vp: i32 = vec_get(variant_name_positions, i);
        let next: i32 = vec_get(tok_tags, vp + 1);
        if next == 6 { vec_push(out_shapes, 1); }
        else {
            if next == 8 { vec_push(out_shapes, 2); }
            else { vec_push(out_shapes, 0); }
        }
        i = i + 1;
    }
    return 0;
}

/* ── init_struct_defs (SML initTypes — struct half) ──────────
   Walks all ItemStruct entries (it[i]==1) in the item arena,
   calls scan_struct_field_names + scan_struct_field_type_tags,
   and populates the struct def table:
     sdef_names           — one name_tok_pos per struct
     sdef_field_offsets    — start offset into flat arrays
     sdef_field_counts     — field count per struct
     sdef_fnames_flat      — all field name positions, flattened
     sdef_ftypes_flat      — all field type tags, flattened
   Returns the number of structs registered.                  */

fn init_struct_defs(tok_tags: Vec<i32>, source: string,
                    starts: Vec<i32>, ends: Vec<i32>,
                    struct_names: Vec<i32>, enum_names: Vec<i32>,
                    type_params: Vec<i32>, tp_limit: i32,
                    it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
                    sdef_names: Vec<i32>,
                    sdef_field_offsets: Vec<i32>,
                    sdef_field_counts: Vec<i32>,
                    sdef_fnames_flat: Vec<i32>,
                    sdef_ftypes_flat: Vec<i32>) -> i32 {
    let n: i32 = vec_len(it);
    let mut count: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        if vec_get(it, i) == 1 {
            let name_pos: i32 = vec_get(id1, i);
            let field_count: i32 = vec_get(id2, i);
            vec_push(sdef_names, name_pos);
            vec_push(sdef_field_offsets, vec_len(sdef_fnames_flat));
            vec_push(sdef_field_counts, field_count);
            if field_count > 0 {
                let fnames: Vec<i32> = vec_new();
                let r0: i32 = scan_struct_field_names(tok_tags, name_pos,
                                                       field_count, fnames);
                if r0 == 0 {
                    let ftypes: Vec<i32> = vec_new();
                    let r1: i32 = scan_struct_field_type_tags(
                        tok_tags, source, starts, ends,
                        struct_names, enum_names,
                        type_params, tp_limit,
                        fnames, ftypes);
                    let mut j: i32 = 0;
                    while j < field_count {
                        vec_push(sdef_fnames_flat, vec_get(fnames, j));
                        vec_push(sdef_ftypes_flat, vec_get(ftypes, j));
                        j = j + 1;
                    }
                }
            }
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

/* ── init_enum_defs (SML initTypes — enum half) ─────────────
   Walks all ItemEnum entries (it[i]==2), calls
   scan_enum_variant_names + scan_enum_variant_shapes,
   and populates the enum def table:
     edef_names            — one name_tok_pos per enum
     edef_variant_offsets   — start offset into flat arrays
     edef_variant_counts    — variant count per enum
     edef_vnames_flat       — all variant name positions, flattened
     edef_vshapes_flat      — all variant shapes, flattened
   Returns the number of enums registered.                    */

fn init_enum_defs(tok_tags: Vec<i32>,
                  it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
                  edef_names: Vec<i32>,
                  edef_variant_offsets: Vec<i32>,
                  edef_variant_counts: Vec<i32>,
                  edef_vnames_flat: Vec<i32>,
                  edef_vshapes_flat: Vec<i32>) -> i32 {
    let n: i32 = vec_len(it);
    let mut count: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        if vec_get(it, i) == 2 {
            let name_pos: i32 = vec_get(id1, i);
            let variant_count: i32 = vec_get(id2, i);
            vec_push(edef_names, name_pos);
            vec_push(edef_variant_offsets, vec_len(edef_vnames_flat));
            vec_push(edef_variant_counts, variant_count);
            if variant_count > 0 {
                let vnames: Vec<i32> = vec_new();
                let r0: i32 = scan_enum_variant_names(tok_tags,
                                                       name_pos,
                                                       variant_count,
                                                       vnames);
                if r0 == 0 {
                    let vshapes: Vec<i32> = vec_new();
                    let r1: i32 = scan_enum_variant_shapes(tok_tags,
                                                            vnames,
                                                            vshapes);
                    let mut j: i32 = 0;
                    while j < variant_count {
                        vec_push(edef_vnames_flat, vec_get(vnames, j));
                        vec_push(edef_vshapes_flat, vec_get(vshapes, j));
                        j = j + 1;
                    }
                }
            }
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

/* ── struct_def_field_ty_str (lookup field type by string) ───
   Given a struct name tok_pos and a field name string, look up
   the field's type tag in the struct def table.  Returns -1 if
   the struct or field is not found.                           */

fn struct_def_field_ty_str(sdef_names: Vec<i32>,
                           sdef_field_offsets: Vec<i32>,
                           sdef_field_counts: Vec<i32>,
                           sdef_fnames_flat: Vec<i32>,
                           sdef_ftypes_flat: Vec<i32>,
                           source: string,
                           starts: Vec<i32>, ends: Vec<i32>,
                           struct_name_pos: i32,
                           field_name_str: string) -> i32 {
    let ns: i32 = vec_len(sdef_names);
    let mut si: i32 = 0 - 1;
    let mut k: i32 = 0;
    while k < ns {
        if vec_get(sdef_names, k) == struct_name_pos {
            si = k;
            k = ns;
        }
        k = k + 1;
    }
    if si < 0 { return 0 - 1; }
    let off: i32 = vec_get(sdef_field_offsets, si);
    let fc: i32 = vec_get(sdef_field_counts, si);
    let mut f: i32 = 0;
    while f < fc {
        let fnp: i32 = vec_get(sdef_fnames_flat, off + f);
        let s: i32 = vec_get(starts, fnp);
        let e: i32 = vec_get(ends, fnp);
        let fname: string = string_substr(source, s, e - s);
        if string_eq(fname, field_name_str) {
            return vec_get(sdef_ftypes_flat, off + f);
        }
        f = f + 1;
    }
    return 0 - 1;
}

/* ── enum_def_variant_shape_str (lookup variant shape by string) ─
   Given an enum name tok_pos and variant name string, look up
   the variant's shape in the enum def table.  Returns -1 if not
   found.                                                      */

fn enum_def_variant_shape_str(edef_names: Vec<i32>,
                               edef_variant_offsets: Vec<i32>,
                               edef_variant_counts: Vec<i32>,
                               edef_vnames_flat: Vec<i32>,
                               edef_vshapes_flat: Vec<i32>,
                               source: string,
                               starts: Vec<i32>, ends: Vec<i32>,
                               enum_name_pos: i32,
                               variant_name_str: string) -> i32 {
    let ne: i32 = vec_len(edef_names);
    let mut ei: i32 = 0 - 1;
    let mut k: i32 = 0;
    while k < ne {
        if vec_get(edef_names, k) == enum_name_pos {
            ei = k;
            k = ne;
        }
        k = k + 1;
    }
    if ei < 0 { return 0 - 1; }
    let off: i32 = vec_get(edef_variant_offsets, ei);
    let vc: i32 = vec_get(edef_variant_counts, ei);
    let mut v: i32 = 0;
    while v < vc {
        let vnp: i32 = vec_get(edef_vnames_flat, off + v);
        let s: i32 = vec_get(starts, vnp);
        let e: i32 = vec_get(ends, vnp);
        let vname: string = string_substr(source, s, e - s);
        if string_eq(vname, variant_name_str) {
            return vec_get(edef_vshapes_flat, off + v);
        }
        v = v + 1;
    }
    return 0 - 1;
}

/* ── builtin function table (SML modEnvFromProg builtins) ────
   The SML checker extends the env with 13 built-in functions
   (println, string_*, vec_*, box_*).  In sv0 we use integer
   builtin IDs instead of string env entries; synth ExprCall
   checks user fns via fn_table first, then falls through to
   builtin lookup.

   Builtin IDs:
     0=println 1=string_len 2=string_eq 3=string_concat
     4=string_char_at 5=string_substr 6=vec_new 7=vec_push
     8=vec_len 9=vec_get 10=vec_set 11=box_new 12=box_deref

   For generic builtins (vec/box), return/param types use
   TY_VAR to signal polymorphism.                             */

fn BUILTIN_COUNT() -> i32 { return 13; }

fn builtin_fn_lookup(name_str: string) -> i32 {
    if string_eq(name_str, "println") { return 0; }
    if string_eq(name_str, "string_len") { return 1; }
    if string_eq(name_str, "string_eq") { return 2; }
    if string_eq(name_str, "string_concat") { return 3; }
    if string_eq(name_str, "string_char_at") { return 4; }
    if string_eq(name_str, "string_substr") { return 5; }
    if string_eq(name_str, "vec_new") { return 6; }
    if string_eq(name_str, "vec_push") { return 7; }
    if string_eq(name_str, "vec_len") { return 8; }
    if string_eq(name_str, "vec_get") { return 9; }
    if string_eq(name_str, "vec_set") { return 10; }
    if string_eq(name_str, "box_new") { return 11; }
    if string_eq(name_str, "box_deref") { return 12; }
    return 0 - 1;
}

fn builtin_fn_ret_type(bid: i32) -> i32 {
    if bid == 0 { return TY_UNIT(); }
    if bid == 1 { return TY_INT(); }
    if bid == 2 { return TY_BOOL(); }
    if bid == 3 { return TY_STRING(); }
    if bid == 4 { return TY_INT(); }
    if bid == 5 { return TY_STRING(); }
    if bid == 6 { return TY_NAMED(); }
    if bid == 7 { return TY_UNIT(); }
    if bid == 8 { return TY_INT(); }
    if bid == 9 { return TY_VAR(); }
    if bid == 10 { return TY_UNIT(); }
    if bid == 11 { return TY_NAMED(); }
    if bid == 12 { return TY_VAR(); }
    return 0 - 1;
}

fn builtin_fn_param_count(bid: i32) -> i32 {
    if bid == 0 { return 1; }
    if bid == 1 { return 1; }
    if bid == 2 { return 2; }
    if bid == 3 { return 2; }
    if bid == 4 { return 2; }
    if bid == 5 { return 3; }
    if bid == 6 { return 0; }
    if bid == 7 { return 2; }
    if bid == 8 { return 1; }
    if bid == 9 { return 2; }
    if bid == 10 { return 3; }
    if bid == 11 { return 1; }
    if bid == 12 { return 1; }
    return 0 - 1;
}

fn builtin_fn_param_type(bid: i32, idx: i32) -> i32 {
    if bid == 0 { return TY_STRING(); }
    if bid == 1 { return TY_STRING(); }
    if bid == 2 { return TY_STRING(); }
    if bid == 3 { return TY_STRING(); }
    if bid == 4 {
        if idx == 0 { return TY_STRING(); }
        return TY_INT();
    }
    if bid == 5 {
        if idx == 0 { return TY_STRING(); }
        return TY_INT();
    }
    if bid == 7 {
        if idx == 0 { return TY_NAMED(); }
        return TY_VAR();
    }
    if bid == 8 { return TY_NAMED(); }
    if bid == 9 {
        if idx == 0 { return TY_NAMED(); }
        return TY_INT();
    }
    if bid == 10 {
        if idx == 0 { return TY_NAMED(); }
        if idx == 1 { return TY_INT(); }
        return TY_VAR();
    }
    if bid == 11 { return TY_VAR(); }
    if bid == 12 { return TY_NAMED(); }
    return 0 - 1;
}

/* ── unified function lookup (user fns + builtins) ──────────
   Given a function call name (as string), first check the user
   fn_table (via fn_table_lookup_str), then fall through to
   builtin_fn_lookup.  Returns a result code:
     >= 0 and is_builtin_out[0]==0 → fn_table index
     >= 0 and is_builtin_out[0]==1 → builtin ID
     -1 → not found                                           */

fn resolve_fn_call(fn_names: Vec<i32>, source: string,
                   starts: Vec<i32>, ends: Vec<i32>,
                   name_str: string,
                   is_builtin_out: Vec<i32>) -> i32 {
    let idx: i32 = fn_table_lookup_str(fn_names, source,
                                        starts, ends, name_str);
    if idx >= 0 {
        vec_push(is_builtin_out, 0);
        return idx;
    }
    let bid: i32 = builtin_fn_lookup(name_str);
    if bid >= 0 {
        vec_push(is_builtin_out, 1);
        return bid;
    }
    return 0 - 1;
}

/* ── enum def name lookup (string-based) ────────────────────
   Finds the index of an enum in the edef table by comparing
   the name string at each edef_names token position.  Returns
   -1 if not found.                                            */

fn edef_name_lookup_str(edef_names: Vec<i32>, source: string,
                        starts: Vec<i32>, ends: Vec<i32>,
                        enum_name_str: string) -> i32 {
    let ne: i32 = vec_len(edef_names);
    let mut k: i32 = 0;
    while k < ne {
        let np: i32 = vec_get(edef_names, k);
        let s: i32 = vec_get(starts, np);
        let e: i32 = vec_get(ends, np);
        let nm: string = string_substr(source, s, e - s);
        if string_eq(nm, enum_name_str) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}

/* ── ctor_type_from_edef (enum ctor type from def table) ────
   Given an enum name token position and a variant name string,
   looks up the variant shape in the enum def table, then
   returns the constructor type tag:
     VSUnit → TY_ENUM   (nullary)
     VSTuple/VSStruct → TY_FN  (parameterised)
   Returns -1 if enum or variant not found.                   */

fn ctor_type_from_edef(edef_names: Vec<i32>,
                       edef_variant_offsets: Vec<i32>,
                       edef_variant_counts: Vec<i32>,
                       edef_vnames_flat: Vec<i32>,
                       edef_vshapes_flat: Vec<i32>,
                       source: string,
                       starts: Vec<i32>, ends: Vec<i32>,
                       enum_name_pos: i32,
                       variant_name_str: string) -> i32 {
    let sh: i32 = enum_def_variant_shape_str(
        edef_names, edef_variant_offsets, edef_variant_counts,
        edef_vnames_flat, edef_vshapes_flat,
        source, starts, ends,
        enum_name_pos, variant_name_str);
    if sh < 0 { return 0 - 1; }
    if sh == 0 { return TY_ENUM(); }
    return TY_FN();
}

/* ── resolve_ctor_path_ty (2-segment path → ctor type tag) ──
   Given two token positions for a 2-segment path (e.g.
   Color::Red), resolves to the constructor type tag by:
   1. Extracting enum name string from seg1 token
   2. Looking up enum in edef table via edef_name_lookup_str
   3. Extracting variant name string from seg2 token
   4. Looking up variant shape and computing ctor type tag
   Used by synth ExprPath for enum constructor references.
   Returns -1 if not found.                                   */

fn resolve_ctor_path_ty(edef_names: Vec<i32>,
                        edef_variant_offsets: Vec<i32>,
                        edef_variant_counts: Vec<i32>,
                        edef_vnames_flat: Vec<i32>,
                        edef_vshapes_flat: Vec<i32>,
                        source: string,
                        starts: Vec<i32>, ends: Vec<i32>,
                        seg1_tok_pos: i32,
                        seg2_tok_pos: i32) -> i32 {
    let s1: i32 = vec_get(starts, seg1_tok_pos);
    let e1: i32 = vec_get(ends, seg1_tok_pos);
    let enum_str: string = string_substr(source, s1, e1 - s1);
    let eidx: i32 = edef_name_lookup_str(edef_names, source,
                                          starts, ends, enum_str);
    if eidx < 0 { return 0 - 1; }
    let s2: i32 = vec_get(starts, seg2_tok_pos);
    let e2: i32 = vec_get(ends, seg2_tok_pos);
    let variant_str: string = string_substr(source, s2, e2 - s2);
    let enp: i32 = vec_get(edef_names, eidx);
    return ctor_type_from_edef(edef_names,
                                edef_variant_offsets,
                                edef_variant_counts,
                                edef_vnames_flat,
                                edef_vshapes_flat,
                                source, starts, ends,
                                enp, variant_str);
}

/* ── synth_expr_call_simple (simple function call typing) ────
   Given a callee that is an ExprPath(1-seg), extracts the
   function name, resolves via fn_table then builtins, and
   returns the return type tag.  Synthesises each argument
   (for future arity checking) but does not yet validate
   argument types against parameter types.
   Returns -1 if callee is not a 1-seg path or fn not found. */

fn synth_expr_call_simple(
    et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>, ed3: Vec<i32>,
    ed4: Vec<i32>, pp: Vec<i32>,
    source: string, starts: Vec<i32>, ends: Vec<i32>,
    env_names: Vec<i32>, env_types: Vec<i32>, env_muts: Vec<i32>,
    edef_names: Vec<i32>,
    edef_variant_offsets: Vec<i32>,
    edef_variant_counts: Vec<i32>,
    edef_vnames_flat: Vec<i32>,
    edef_vshapes_flat: Vec<i32>,
    fn_names: Vec<i32>, fn_ret_types: Vec<i32>,
    ret_ty: i32, loop_depth: i32,
    callee_idx: i32, args_first: i32, args_count: i32) -> i32 {
    let callee_tag: i32 = vec_get(et, callee_idx);
    if callee_tag != 1 { return 0 - 1; }
    let pps: i32 = vec_get(ed1, callee_idx);
    let ppc: i32 = vec_get(ed2, callee_idx);
    if ppc == 1 {
        let tok_pos: i32 = vec_get(pp, pps);
        let s: i32 = vec_get(starts, tok_pos);
        let e: i32 = vec_get(ends, tok_pos);
        let nm: string = string_substr(source, s, e - s);
        let ibo: Vec<i32> = vec_new();
        let rt: i32 = synth_call_ret_type(fn_names, fn_ret_types,
                                           source, starts, ends,
                                           nm, ibo);
        if rt < 0 { return 0 - 1; }
        let mut ai: i32 = 0;
        while ai < args_count {
            let arg_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                          source, starts, ends,
                                          env_names, env_types, env_muts,
                                          edef_names, edef_variant_offsets,
                                          edef_variant_counts,
                                          edef_vnames_flat, edef_vshapes_flat,
                                          fn_names, fn_ret_types,
                                          ret_ty, loop_depth,
                                          args_first + ai);
            if arg_ty < 0 { return 0 - 1; }
            ai = ai + 1;
        }
        return rt;
    }
    if ppc == 2 {
        let seg1: i32 = vec_get(pp, pps);
        let seg2: i32 = vec_get(pp, pps + 1);
        let ctor_ty: i32 = resolve_ctor_path_ty(edef_names,
                                                  edef_variant_offsets,
                                                  edef_variant_counts,
                                                  edef_vnames_flat,
                                                  edef_vshapes_flat,
                                                  source, starts, ends,
                                                  seg1, seg2);
        if ctor_ty >= 0 {
            let mut ai: i32 = 0;
            while ai < args_count {
                let arg_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                              source, starts, ends,
                                              env_names, env_types, env_muts,
                                              edef_names, edef_variant_offsets,
                                              edef_variant_counts,
                                              edef_vnames_flat, edef_vshapes_flat,
                                              fn_names, fn_ret_types,
                                              ret_ty, loop_depth,
                                              args_first + ai);
                if arg_ty < 0 { return 0 - 1; }
                ai = ai + 1;
            }
            return TY_ENUM();
        }
    }
    return 0 - 1;
}

/* ── sdef_name_lookup_str (string-based struct def lookup) ───
   Finds the index of a struct in the sdef table by comparing
   the name string at each sdef_names token position.  Returns
   -1 if not found.  Mirrors edef_name_lookup_str.            */

fn sdef_name_lookup_str(sdef_names: Vec<i32>, source: string,
                        starts: Vec<i32>, ends: Vec<i32>,
                        struct_name_str: string) -> i32 {
    let ns: i32 = vec_len(sdef_names);
    let mut k: i32 = 0;
    while k < ns {
        let np: i32 = vec_get(sdef_names, k);
        let s: i32 = vec_get(starts, np);
        let e: i32 = vec_get(ends, np);
        let nm: string = string_substr(source, s, e - s);
        if string_eq(nm, struct_name_str) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}

/* ── env_lookup_str (string-based env lookup) ────────────────
   Walks env_names backwards, extracts the string at each
   token position, and compares with target_str.  Returns
   the type tag from env_types if found, or -1 if not found.
   Used by synth ExprPath and other cross-scope lookups
   where integer token positions are not directly comparable. */

fn env_lookup_str(env_names: Vec<i32>, env_types: Vec<i32>,
                  source: string, starts: Vec<i32>, ends: Vec<i32>,
                  target_str: string) -> i32 {
    let n: i32 = vec_len(env_names);
    let mut i: i32 = n - 1;
    while i >= 0 {
        let np: i32 = vec_get(env_names, i);
        let s: i32 = vec_get(starts, np);
        let e: i32 = vec_get(ends, np);
        let nm: string = string_substr(source, s, e - s);
        if string_eq(nm, target_str) {
            return vec_get(env_types, i);
        }
        i = i - 1;
    }
    return 0 - 1;
}

/* ── synth_call_ret_type (function call return type) ─────────
   Given a callee name string, resolves the function via
   fn_table then builtins.  Returns the return type tag or
   -1 if the function is not found.  Wraps resolve_fn_call
   with the actual return type extraction.                    */

fn synth_call_ret_type(fn_names: Vec<i32>,
                       fn_ret_types: Vec<i32>,
                       source: string,
                       starts: Vec<i32>, ends: Vec<i32>,
                       callee_name_str: string,
                       is_builtin_out: Vec<i32>) -> i32 {
    let fid: i32 = resolve_fn_call(fn_names, source, starts, ends,
                                    callee_name_str, is_builtin_out);
    if fid < 0 { return 0 - 1; }
    let is_b: i32 = vec_get(is_builtin_out, vec_len(is_builtin_out) - 1);
    if is_b != 0 {
        return builtin_fn_ret_type(fid);
    }
    return vec_get(fn_ret_types, fid);
}

/* ── check_stmt_in_block (SML checkStmt — statement processing) ─
   Processes one statement node within a block.  For LetStmt (27):
   synthesise the init expression, infer the binding type, and
   push (name, type, mut) to the env Vecs.  For SemiStmt (28):
   synthesise the inner expression and discard the type.
   Returns 0 on success, -1 on error.
   NOTE: env extensions are NOT scoped — bindings leak out of
   the block.  This is acceptable for well-formed programs that
   have already been validated by the SML compiler.             */

fn check_stmt_in_block(
    et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>, ed3: Vec<i32>,
    ed4: Vec<i32>, pp: Vec<i32>,
    source: string, starts: Vec<i32>, ends: Vec<i32>,
    env_names: Vec<i32>, env_types: Vec<i32>, env_muts: Vec<i32>,
    edef_names: Vec<i32>,
    edef_variant_offsets: Vec<i32>,
    edef_variant_counts: Vec<i32>,
    edef_vnames_flat: Vec<i32>,
    edef_vshapes_flat: Vec<i32>,
    fn_names: Vec<i32>, fn_ret_types: Vec<i32>,
    ret_ty: i32, loop_depth: i32,
    stmt_idx: i32) -> i32 {
    let stag: i32 = vec_get(et, stmt_idx);
    if stag == 27 {
        let name_tok: i32 = vec_get(ed1, stmt_idx);
        let init_idx: i32 = vec_get(ed3, stmt_idx);
        let is_mut: i32 = vec_get(ed4, stmt_idx);
        if init_idx < 0 { return 0 - 1; }
        let ty_init: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                       source, starts, ends,
                                       env_names, env_types, env_muts,
                                       edef_names, edef_variant_offsets,
                                       edef_variant_counts,
                                       edef_vnames_flat, edef_vshapes_flat,
                                       fn_names, fn_ret_types,
                                       ret_ty, loop_depth,
                                       init_idx);
        if ty_init < 0 { return 0 - 1; }
        env_extend(env_names, env_types, env_muts,
                   name_tok, ty_init, is_mut);
        return 0;
    }
    if stag == 28 {
        let expr_idx: i32 = vec_get(ed1, stmt_idx);
        let discard: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                       source, starts, ends,
                                       env_names, env_types, env_muts,
                                       edef_names, edef_variant_offsets,
                                       edef_variant_counts,
                                       edef_vnames_flat, edef_vshapes_flat,
                                       fn_names, fn_ret_types,
                                       ret_ty, loop_depth,
                                       expr_idx);
        if discard < 0 { return 0 - 1; }
        return 0;
    }
    return 0 - 1;
}

/* ── synth_expr (SML synth — expression type synthesis) ──────
   Dispatches on expression tag and returns the synthesised
   type tag.  Currently handles:
     0 ExprLit      → infer_lit(lit_tag)
     1 ExprPath     → env_lookup_str (1-seg) / resolve_ctor_path_ty (2-seg)
     2 ExprUnop     → recurse on operand, return unop result type
     3 ExprBinop    → recurse on both operands, return binop result type
     9 ExprBlock    → process stmts (check_stmt_in_block), synth tail
    10 ExprIf       → synth cond (TY_BOOL), synth then/else arms
    12 ExprWhile    → synth cond, synth body with loop_depth+1
    14 ExprLoop     → synth body with loop_depth+1
    15 ExprReturn   → synth value, expect matches ret_ty
    16 ExprBreak    → check loop_depth > 0, return TY_UNIT
    17 ExprContinue → check loop_depth > 0, return TY_UNIT
    18 ExprAssign   → synth LHS and RHS, return TY_UNIT
    19 ExprAssignOp → synth LHS and RHS, return TY_UNIT
     4 ExprCall     → delegate to synth_expr_call_simple
     5 ExprMethodCall → synth obj + args, return TY_INT (simplified)
     6 ExprField    → synth obj, return TY_INT (simplified)
     7 ExprTupleField → synth obj, return TY_INT (simplified)
     8 ExprIndex    → synth obj and index, return TY_INT (simplified)
    11 ExprMatch    → synth scrutinee + each arm body/guard, return first arm ty
    13 ExprFor      → synth range lo/hi, extend env, synth body w/ loop_depth+1
    20 ExprCast     → synth source, return TY_INT (simplified)
    21 ExprRange    → synth lo/hi, return TY_INT
    22 ExprTry      → synth operand, return TY_INT (simplified)
    23 ExprAssert   → synth operand, return TY_UNIT
    24 ExprStruct   → return TY_INT (simplified, field traversal deferred)
    25 ExprTuple    → unwrap (1-elem) or unsupported (multi)
    26 ExprArray    → return TY_INT (simplified, element traversal deferred)
   All 27 expression tags are now handled.                    */

fn synth_expr(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>, ed3: Vec<i32>,
              ed4: Vec<i32>, pp: Vec<i32>,
              source: string, starts: Vec<i32>, ends: Vec<i32>,
              env_names: Vec<i32>, env_types: Vec<i32>, env_muts: Vec<i32>,
              edef_names: Vec<i32>,
              edef_variant_offsets: Vec<i32>,
              edef_variant_counts: Vec<i32>,
              edef_vnames_flat: Vec<i32>,
              edef_vshapes_flat: Vec<i32>,
              fn_names: Vec<i32>, fn_ret_types: Vec<i32>,
              ret_ty: i32, loop_depth: i32,
              idx: i32) -> i32 {
    let tag: i32 = vec_get(et, idx);
    if tag == 0 {
        let lit_tag: i32 = vec_get(ed1, idx);
        return infer_lit(lit_tag);
    }
    if tag == 1 {
        let pps: i32 = vec_get(ed1, idx);
        let ppc: i32 = vec_get(ed2, idx);
        if ppc == 1 {
            let tok_pos: i32 = vec_get(pp, pps);
            let s: i32 = vec_get(starts, tok_pos);
            let e: i32 = vec_get(ends, tok_pos);
            let nm: string = string_substr(source, s, e - s);
            return env_lookup_str(env_names, env_types,
                                  source, starts, ends, nm);
        }
        if ppc == 2 {
            let seg1: i32 = vec_get(pp, pps);
            let seg2: i32 = vec_get(pp, pps + 1);
            return resolve_ctor_path_ty(edef_names,
                                         edef_variant_offsets,
                                         edef_variant_counts,
                                         edef_vnames_flat,
                                         edef_vshapes_flat,
                                         source, starts, ends,
                                         seg1, seg2);
        }
        return 0 - 1;
    }
    if tag == 2 {
        let unop_tag: i32 = vec_get(ed1, idx);
        let operand_idx: i32 = vec_get(ed2, idx);
        let op_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                     source, starts, ends,
                                     env_names, env_types, env_muts,
                                     edef_names, edef_variant_offsets,
                                     edef_variant_counts,
                                     edef_vnames_flat, edef_vshapes_flat,
                                     fn_names, fn_ret_types,
                                     ret_ty, loop_depth,
                                     operand_idx);
        if op_ty < 0 { return 0 - 1; }
        return unop_result_ty_tag(unop_tag);
    }
    if tag == 3 {
        let binop_tag: i32 = vec_get(ed1, idx);
        let lhs_idx: i32 = vec_get(ed2, idx);
        let rhs_idx: i32 = vec_get(ed3, idx);
        let lhs_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                      source, starts, ends,
                                      env_names, env_types, env_muts,
                                      edef_names, edef_variant_offsets,
                                      edef_variant_counts,
                                      edef_vnames_flat, edef_vshapes_flat,
                                      fn_names, fn_ret_types,
                                      ret_ty, loop_depth,
                                      lhs_idx);
        if lhs_ty < 0 { return 0 - 1; }
        let rhs_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                      source, starts, ends,
                                      env_names, env_types, env_muts,
                                      edef_names, edef_variant_offsets,
                                      edef_variant_counts,
                                      edef_vnames_flat, edef_vshapes_flat,
                                      fn_names, fn_ret_types,
                                      ret_ty, loop_depth,
                                      rhs_idx);
        if rhs_ty < 0 { return 0 - 1; }
        return binop_result_ty_tag(binop_tag);
    }
    if tag == 4 {
        let callee_idx: i32 = vec_get(ed1, idx);
        let args_first: i32 = vec_get(ed2, idx);
        let args_count: i32 = vec_get(ed3, idx);
        return synth_expr_call_simple(
            et, ed1, ed2, ed3, ed4, pp,
            source, starts, ends,
            env_names, env_types, env_muts,
            edef_names, edef_variant_offsets,
            edef_variant_counts,
            edef_vnames_flat, edef_vshapes_flat,
            fn_names, fn_ret_types,
            ret_ty, loop_depth,
            callee_idx, args_first, args_count);
    }
    if tag == 5 {
        let mc_obj: i32 = vec_get(ed1, idx);
        let mc_args_first: i32 = vec_get(ed3, idx);
        let mc_args_count: i32 = vec_get(ed4, idx);
        let mc_obj_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                         source, starts, ends,
                                         env_names, env_types, env_muts,
                                         edef_names, edef_variant_offsets,
                                         edef_variant_counts,
                                         edef_vnames_flat, edef_vshapes_flat,
                                         fn_names, fn_ret_types,
                                         ret_ty, loop_depth,
                                         mc_obj);
        if mc_obj_ty < 0 { return 0 - 1; }
        let mut mc_i: i32 = 0;
        while mc_i < mc_args_count {
            let mc_arg_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                             source, starts, ends,
                                             env_names, env_types, env_muts,
                                             edef_names, edef_variant_offsets,
                                             edef_variant_counts,
                                             edef_vnames_flat, edef_vshapes_flat,
                                             fn_names, fn_ret_types,
                                             ret_ty, loop_depth,
                                             mc_args_first + mc_i);
            if mc_arg_ty < 0 { return 0 - 1; }
            mc_i = mc_i + 1;
        }
        return TY_INT();
    }
    if tag == 6 {
        let fld_obj: i32 = vec_get(ed1, idx);
        let fld_obj_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                          source, starts, ends,
                                          env_names, env_types, env_muts,
                                          edef_names, edef_variant_offsets,
                                          edef_variant_counts,
                                          edef_vnames_flat, edef_vshapes_flat,
                                          fn_names, fn_ret_types,
                                          ret_ty, loop_depth,
                                          fld_obj);
        if fld_obj_ty < 0 { return 0 - 1; }
        return TY_INT();
    }
    if tag == 7 {
        let tf_obj: i32 = vec_get(ed1, idx);
        let tf_obj_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                         source, starts, ends,
                                         env_names, env_types, env_muts,
                                         edef_names, edef_variant_offsets,
                                         edef_variant_counts,
                                         edef_vnames_flat, edef_vshapes_flat,
                                         fn_names, fn_ret_types,
                                         ret_ty, loop_depth,
                                         tf_obj);
        if tf_obj_ty < 0 { return 0 - 1; }
        return TY_INT();
    }
    if tag == 8 {
        let obj_idx: i32 = vec_get(ed1, idx);
        let index_idx: i32 = vec_get(ed2, idx);
        let obj_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                      source, starts, ends,
                                      env_names, env_types, env_muts,
                                      edef_names, edef_variant_offsets,
                                      edef_variant_counts,
                                      edef_vnames_flat, edef_vshapes_flat,
                                      fn_names, fn_ret_types,
                                      ret_ty, loop_depth,
                                      obj_idx);
        if obj_ty < 0 { return 0 - 1; }
        let idx_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                      source, starts, ends,
                                      env_names, env_types, env_muts,
                                      edef_names, edef_variant_offsets,
                                      edef_variant_counts,
                                      edef_vnames_flat, edef_vshapes_flat,
                                      fn_names, fn_ret_types,
                                      ret_ty, loop_depth,
                                      index_idx);
        if idx_ty < 0 { return 0 - 1; }
        return TY_INT();
    }
    if tag == 10 {
        let cond_idx: i32 = vec_get(ed1, idx);
        let then_idx: i32 = vec_get(ed2, idx);
        let else_idx: i32 = vec_get(ed3, idx);
        let cond_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                       source, starts, ends,
                                       env_names, env_types, env_muts,
                                       edef_names, edef_variant_offsets,
                                       edef_variant_counts,
                                       edef_vnames_flat, edef_vshapes_flat,
                                       fn_names, fn_ret_types,
                                       ret_ty, loop_depth,
                                       cond_idx);
        if cond_ty < 0 { return 0 - 1; }
        let then_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                       source, starts, ends,
                                       env_names, env_types, env_muts,
                                       edef_names, edef_variant_offsets,
                                       edef_variant_counts,
                                       edef_vnames_flat, edef_vshapes_flat,
                                       fn_names, fn_ret_types,
                                       ret_ty, loop_depth,
                                       then_idx);
        if then_ty < 0 { return 0 - 1; }
        if else_idx < 0 {
            return TY_UNIT();
        }
        let else_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                       source, starts, ends,
                                       env_names, env_types, env_muts,
                                       edef_names, edef_variant_offsets,
                                       edef_variant_counts,
                                       edef_vnames_flat, edef_vshapes_flat,
                                       fn_names, fn_ret_types,
                                       ret_ty, loop_depth,
                                       else_idx);
        if else_ty < 0 { return 0 - 1; }
        if then_ty == else_ty { return then_ty; }
        return TY_UNIT();
    }
    if tag == 15 {
        let val_idx: i32 = vec_get(ed1, idx);
        if val_idx < 0 { return ret_ty; }
        let val_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                      source, starts, ends,
                                      env_names, env_types, env_muts,
                                      edef_names, edef_variant_offsets,
                                      edef_variant_counts,
                                      edef_vnames_flat, edef_vshapes_flat,
                                      fn_names, fn_ret_types,
                                      ret_ty, loop_depth,
                                      val_idx);
        if val_ty < 0 { return 0 - 1; }
        return ret_ty;
    }
    if tag == 16 {
        if loop_depth <= 0 { return 0 - 1; }
        return TY_UNIT();
    }
    if tag == 17 {
        if loop_depth <= 0 { return 0 - 1; }
        return TY_UNIT();
    }
    if tag == 11 {
        let scrut_idx: i32 = vec_get(ed1, idx);
        let arms_first: i32 = vec_get(ed2, idx);
        let arms_count: i32 = vec_get(ed3, idx);
        let scrut_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                        source, starts, ends,
                                        env_names, env_types, env_muts,
                                        edef_names, edef_variant_offsets,
                                        edef_variant_counts,
                                        edef_vnames_flat, edef_vshapes_flat,
                                        fn_names, fn_ret_types,
                                        ret_ty, loop_depth,
                                        scrut_idx);
        if scrut_ty < 0 { return 0 - 1; }
        let mut first_body_ty: i32 = TY_INT();
        let mut ai: i32 = 0;
        while ai < arms_count {
            let arm_idx: i32 = arms_first + ai;
            let guard_idx: i32 = vec_get(ed3, arm_idx);
            let body_idx: i32 = vec_get(ed4, arm_idx);
            if guard_idx >= 0 {
                let g_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                            source, starts, ends,
                                            env_names, env_types, env_muts,
                                            edef_names, edef_variant_offsets,
                                            edef_variant_counts,
                                            edef_vnames_flat, edef_vshapes_flat,
                                            fn_names, fn_ret_types,
                                            ret_ty, loop_depth,
                                            guard_idx);
                if g_ty < 0 { return 0 - 1; }
            }
            let b_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                        source, starts, ends,
                                        env_names, env_types, env_muts,
                                        edef_names, edef_variant_offsets,
                                        edef_variant_counts,
                                        edef_vnames_flat, edef_vshapes_flat,
                                        fn_names, fn_ret_types,
                                        ret_ty, loop_depth,
                                        body_idx);
            if b_ty < 0 { return 0 - 1; }
            if ai == 0 { first_body_ty = b_ty; }
            ai = ai + 1;
        }
        return first_body_ty;
    }
    if tag == 12 {
        let cond_idx: i32 = vec_get(ed1, idx);
        let body_idx: i32 = vec_get(ed2, idx);
        let cond_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                       source, starts, ends,
                                       env_names, env_types, env_muts,
                                       edef_names, edef_variant_offsets,
                                       edef_variant_counts,
                                       edef_vnames_flat, edef_vshapes_flat,
                                       fn_names, fn_ret_types,
                                       ret_ty, loop_depth,
                                       cond_idx);
        if cond_ty < 0 { return 0 - 1; }
        let body_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                       source, starts, ends,
                                       env_names, env_types, env_muts,
                                       edef_names, edef_variant_offsets,
                                       edef_variant_counts,
                                       edef_vnames_flat, edef_vshapes_flat,
                                       fn_names, fn_ret_types,
                                       ret_ty, loop_depth + 1,
                                       body_idx);
        if body_ty < 0 { return 0 - 1; }
        return TY_UNIT();
    }
    if tag == 13 {
        let pat_tok: i32 = vec_get(ed1, idx);
        let iter_idx: i32 = vec_get(ed2, idx);
        let fbody_idx: i32 = vec_get(ed3, idx);
        let rtag: i32 = vec_get(et, iter_idx);
        if rtag != 21 { return 0 - 1; }
        let lo_idx: i32 = vec_get(ed1, iter_idx);
        let hi_idx: i32 = vec_get(ed2, iter_idx);
        if lo_idx >= 0 {
            let lo_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                         source, starts, ends,
                                         env_names, env_types, env_muts,
                                         edef_names, edef_variant_offsets,
                                         edef_variant_counts,
                                         edef_vnames_flat, edef_vshapes_flat,
                                         fn_names, fn_ret_types,
                                         ret_ty, loop_depth,
                                         lo_idx);
            if lo_ty < 0 { return 0 - 1; }
        }
        if hi_idx >= 0 {
            let hi_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                         source, starts, ends,
                                         env_names, env_types, env_muts,
                                         edef_names, edef_variant_offsets,
                                         edef_variant_counts,
                                         edef_vnames_flat, edef_vshapes_flat,
                                         fn_names, fn_ret_types,
                                         ret_ty, loop_depth,
                                         hi_idx);
            if hi_ty < 0 { return 0 - 1; }
        }
        env_extend(env_names, env_types, env_muts, pat_tok, TY_INT(), 0);
        let fbody_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                        source, starts, ends,
                                        env_names, env_types, env_muts,
                                        edef_names, edef_variant_offsets,
                                        edef_variant_counts,
                                        edef_vnames_flat, edef_vshapes_flat,
                                        fn_names, fn_ret_types,
                                        ret_ty, loop_depth + 1,
                                        fbody_idx);
        if fbody_ty < 0 { return 0 - 1; }
        return TY_UNIT();
    }
    if tag == 14 {
        let body_idx: i32 = vec_get(ed1, idx);
        let body_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                       source, starts, ends,
                                       env_names, env_types, env_muts,
                                       edef_names, edef_variant_offsets,
                                       edef_variant_counts,
                                       edef_vnames_flat, edef_vshapes_flat,
                                       fn_names, fn_ret_types,
                                       ret_ty, loop_depth + 1,
                                       body_idx);
        if body_ty < 0 { return 0 - 1; }
        return TY_UNIT();
    }
    if tag == 18 {
        let lhs_idx: i32 = vec_get(ed1, idx);
        let rhs_idx: i32 = vec_get(ed2, idx);
        let lhs_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                      source, starts, ends,
                                      env_names, env_types, env_muts,
                                      edef_names, edef_variant_offsets,
                                      edef_variant_counts,
                                      edef_vnames_flat, edef_vshapes_flat,
                                      fn_names, fn_ret_types,
                                      ret_ty, loop_depth,
                                      lhs_idx);
        if lhs_ty < 0 { return 0 - 1; }
        let rhs_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                      source, starts, ends,
                                      env_names, env_types, env_muts,
                                      edef_names, edef_variant_offsets,
                                      edef_variant_counts,
                                      edef_vnames_flat, edef_vshapes_flat,
                                      fn_names, fn_ret_types,
                                      ret_ty, loop_depth,
                                      rhs_idx);
        if rhs_ty < 0 { return 0 - 1; }
        return TY_UNIT();
    }
    if tag == 19 {
        let lhs_idx: i32 = vec_get(ed2, idx);
        let rhs_idx: i32 = vec_get(ed3, idx);
        let lhs_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                      source, starts, ends,
                                      env_names, env_types, env_muts,
                                      edef_names, edef_variant_offsets,
                                      edef_variant_counts,
                                      edef_vnames_flat, edef_vshapes_flat,
                                      fn_names, fn_ret_types,
                                      ret_ty, loop_depth,
                                      lhs_idx);
        if lhs_ty < 0 { return 0 - 1; }
        let rhs_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                      source, starts, ends,
                                      env_names, env_types, env_muts,
                                      edef_names, edef_variant_offsets,
                                      edef_variant_counts,
                                      edef_vnames_flat, edef_vshapes_flat,
                                      fn_names, fn_ret_types,
                                      ret_ty, loop_depth,
                                      rhs_idx);
        if rhs_ty < 0 { return 0 - 1; }
        return TY_UNIT();
    }
    if tag == 20 {
        let cast_src: i32 = vec_get(ed1, idx);
        let cast_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                       source, starts, ends,
                                       env_names, env_types, env_muts,
                                       edef_names, edef_variant_offsets,
                                       edef_variant_counts,
                                       edef_vnames_flat, edef_vshapes_flat,
                                       fn_names, fn_ret_types,
                                       ret_ty, loop_depth,
                                       cast_src);
        if cast_ty < 0 { return 0 - 1; }
        return TY_INT();
    }
    if tag == 21 {
        let rlo: i32 = vec_get(ed1, idx);
        let rhi: i32 = vec_get(ed2, idx);
        if rlo >= 0 {
            let rlo_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                          source, starts, ends,
                                          env_names, env_types, env_muts,
                                          edef_names, edef_variant_offsets,
                                          edef_variant_counts,
                                          edef_vnames_flat, edef_vshapes_flat,
                                          fn_names, fn_ret_types,
                                          ret_ty, loop_depth,
                                          rlo);
            if rlo_ty < 0 { return 0 - 1; }
        }
        if rhi >= 0 {
            let rhi_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                          source, starts, ends,
                                          env_names, env_types, env_muts,
                                          edef_names, edef_variant_offsets,
                                          edef_variant_counts,
                                          edef_vnames_flat, edef_vshapes_flat,
                                          fn_names, fn_ret_types,
                                          ret_ty, loop_depth,
                                          rhi);
            if rhi_ty < 0 { return 0 - 1; }
        }
        return TY_INT();
    }
    if tag == 22 {
        let try_src: i32 = vec_get(ed1, idx);
        let try_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                      source, starts, ends,
                                      env_names, env_types, env_muts,
                                      edef_names, edef_variant_offsets,
                                      edef_variant_counts,
                                      edef_vnames_flat, edef_vshapes_flat,
                                      fn_names, fn_ret_types,
                                      ret_ty, loop_depth,
                                      try_src);
        if try_ty < 0 { return 0 - 1; }
        return TY_INT();
    }
    if tag == 23 {
        let expr_idx: i32 = vec_get(ed1, idx);
        let expr_ty: i32 = synth_expr(et, ed1, ed2, ed3, ed4, pp,
                                       source, starts, ends,
                                       env_names, env_types, env_muts,
                                       edef_names, edef_variant_offsets,
                                       edef_variant_counts,
                                       edef_vnames_flat, edef_vshapes_flat,
                                       fn_names, fn_ret_types,
                                       ret_ty, loop_depth,
                                       expr_idx);
        if expr_ty < 0 { return 0 - 1; }
        return TY_UNIT();
    }
    if tag == 24 {
        return TY_INT();
    }
    if tag == 25 {
        let first_idx: i32 = vec_get(ed1, idx);
        let count: i32 = vec_get(ed2, idx);
        if count == 1 {
            return synth_expr(et, ed1, ed2, ed3, ed4, pp,
                              source, starts, ends,
                              env_names, env_types, env_muts,
                              edef_names, edef_variant_offsets,
                              edef_variant_counts,
                              edef_vnames_flat, edef_vshapes_flat,
                              fn_names, fn_ret_types,
                              ret_ty, loop_depth,
                              first_idx);
        }
        return 0 - 1;
    }
    if tag == 26 {
        return TY_INT();
    }
    if tag == 9 {
        let stmts_first: i32 = vec_get(ed1, idx);
        let stmts_count: i32 = vec_get(ed2, idx);
        let tail_idx: i32 = vec_get(ed3, idx);
        let mut si: i32 = 0;
        while si < stmts_count {
            let rc: i32 = check_stmt_in_block(
                et, ed1, ed2, ed3, ed4, pp,
                source, starts, ends,
                env_names, env_types, env_muts,
                edef_names, edef_variant_offsets,
                edef_variant_counts,
                edef_vnames_flat, edef_vshapes_flat,
                fn_names, fn_ret_types,
                ret_ty, loop_depth,
                stmts_first + si);
            if rc < 0 { return 0 - 1; }
            si = si + 1;
        }
        if tail_idx >= 0 {
            return synth_expr(et, ed1, ed2, ed3, ed4, pp,
                              source, starts, ends,
                              env_names, env_types, env_muts,
                              edef_names, edef_variant_offsets,
                              edef_variant_counts,
                              edef_vnames_flat, edef_vshapes_flat,
                              fn_names, fn_ret_types,
                              ret_ty, loop_depth,
                              tail_idx);
        }
        return TY_UNIT();
    }
    return 0 - 1;
}

