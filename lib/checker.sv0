    vec_push(starts, 13); vec_push(ends, 16);
    vec_push(starts, 17); vec_push(ends, 18);
    vec_push(starts, 19); vec_push(ends, 24);
    vec_push(starts, 25); vec_push(ends, 26);
    vec_push(starts, 27); vec_push(ends, 30);
    vec_push(starts, 31); vec_push(ends, 32);
    vec_push(starts, 33); vec_push(ends, 34);
    vec_push(starts, 35); vec_push(ends, 39);
    vec_push(starts, 40); vec_push(ends, 41);
    vec_push(starts, 42); vec_push(ends, 43);
    vec_push(starts, 44); vec_push(ends, 45);
    vec_push(starts, 46); vec_push(ends, 49);
    vec_push(starts, 50); vec_push(ends, 51);
    vec_push(starts, 52); vec_push(ends, 53);
    let item_t: Vec<i32> = vec_new();
    let item_d1: Vec<i32> = vec_new();
    let item_d2: Vec<i32> = vec_new();
