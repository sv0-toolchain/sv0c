    vec_push(et, 0);   vec_push(ed1, 0);
    vec_push(et, 28);  vec_push(ed1, 0);
    vec_push(et, 15);  vec_push(ed1, 0 - 1);
    vec_push(et, 28);  vec_push(ed1, 2);
    if last_stmt_returns_arena(et, ed1, 0, 0) != false { return 1; }
    if last_stmt_returns_arena(et, ed1, 1, 1) != false { return 2; }
    if last_stmt_returns_arena(et, ed1, 3, 1) != true { return 3; }
    return 0;
}

fn test_expr_references_result() -> i32 {
    let source: string = "result  x  y";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0);  vec_push(ends, 6);
    vec_push(starts, 8);  vec_push(ends, 9);
    vec_push(starts, 11); vec_push(ends, 12);
    let pp: Vec<i32> = vec_new();
    vec_push(pp, 0);
    vec_push(pp, 1);
    vec_push(pp, 2);
    let et: Vec<i32> = vec_new();
    let ed1: Vec<i32> = vec_new();
    let ed2: Vec<i32> = vec_new();
    let ed3: Vec<i32> = vec_new();
    let ed4: Vec<i32> = vec_new();
    vec_push(et, 1); vec_push(ed1, 0); vec_push(ed2, 1); vec_push(ed3, 0); vec_push(ed4, 0);
    vec_push(et, 1); vec_push(ed1, 1); vec_push(ed2, 1); vec_push(ed3, 0); vec_push(ed4, 0);
    vec_push(et, 0); vec_push(ed1, 0); vec_push(ed2, 0); vec_push(ed3, 0); vec_push(ed4, 0);
    vec_push(et, 3); vec_push(ed1, 0); vec_push(ed2, 0); vec_push(ed3, 2); vec_push(ed4, 0);
    vec_push(et, 3); vec_push(ed1, 0); vec_push(ed2, 1); vec_push(ed3, 2); vec_push(ed4, 0);
    if expr_references_result(et, ed1, ed2, ed3, ed4, 0, source, starts, ends, pp) != true { return 1; }
    if expr_references_result(et, ed1, ed2, ed3, ed4, 1, source, starts, ends, pp) != false { return 2; }
    if expr_references_result(et, ed1, ed2, ed3, ed4, 2, source, starts, ends, pp) != false { return 3; }
    if expr_references_result(et, ed1, ed2, ed3, ed4, 3, source, starts, ends, pp) != true { return 4; }
    if expr_references_result(et, ed1, ed2, ed3, ed4, 4, source, starts, ends, pp) != false { return 5; }
    if expr_references_result(et, ed1, ed2, ed3, ed4, 0 - 1, source, starts, ends, pp) != false { return 6; }
    return 0;
}

fn test_ast_ty_types_tag() -> i32 {
    if ast_ty_to_types_tag("unit") != 0 { return 1; }
    if ast_ty_to_types_tag("bool") != 1 { return 2; }
    if ast_ty_to_types_tag("char") != 2 { return 3; }
    if ast_ty_to_types_tag("str") != 3 { return 4; }
    if ast_ty_to_types_tag("string") != 3 { return 5; }
    if ast_ty_to_types_tag("String") != 3 { return 6; }
    if ast_ty_to_types_tag("isize") != 4 { return 7; }
    if ast_ty_to_types_tag("usize") != 5 { return 8; }
    if ast_ty_to_types_tag("i32") != 7 { return 9; }
    if ast_ty_to_types_tag("u32") != 8 { return 10; }
    if ast_ty_to_types_tag("f64") != 9 { return 11; }
    if ast_ty_to_types_tag("Foo") != 0 - 1 { return 12; }
    if ast_ty_to_types_tag("Vec") != 0 - 1 { return 13; }
    if int_width_from_name("i32") != 32 { return 14; }
    if int_width_from_name("u64") != 64 { return 15; }
    return 0;
}

fn test_type_params() -> i32 {
    let tp: Vec<i32> = vec_new();
    let names: Vec<i32> = vec_new();
    let tags: Vec<i32> = vec_new();
    vec_push(names, 10);
    vec_push(tags, 16);
    vec_push(names, 20);
    vec_push(tags, 16);
    let saved: i32 = type_param_push(tp, names, tags);
    if saved != 0 { return 1; }
    if vec_len(tp) != 4 { return 2; }
    if type_param_lookup(tp, 4, 10) != 16 { return 3; }
    if type_param_lookup(tp, 4, 20) != 16 { return 4; }
    if type_param_lookup(tp, 4, 99) != 0 - 1 { return 5; }
    let n2: Vec<i32> = vec_new();
    let t2: Vec<i32> = vec_new();
    vec_push(n2, 30);
    vec_push(t2, 16);
    let saved2: i32 = type_param_push(tp, n2, t2);
    if saved2 != 4 { return 6; }
    if vec_len(tp) != 6 { return 7; }
    if type_param_lookup(tp, 6, 30) != 16 { return 8; }
    if type_param_lookup(tp, saved2, 30) != 0 - 1 { return 9; }
    if type_param_lookup(tp, saved2, 10) != 16 { return 10; }
    if type_param_lookup(tp, saved, 10) != 0 - 1 { return 11; }
    return 0;
}

fn test_resolve_field_ty() -> i32 {
    let source: string = "i32 bool Foo";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 3);
    vec_push(starts, 4); vec_push(ends, 8);
    vec_push(starts, 9); vec_push(ends, 12);
    let tt: Vec<i32> = vec_new();
    let td1: Vec<i32> = vec_new();
    let td2: Vec<i32> = vec_new();
    let td3: Vec<i32> = vec_new();
    let pp: Vec<i32> = vec_new();
    vec_push(tt, 0); vec_push(td1, 0); vec_push(td2, 1); vec_push(td3, 0);
    vec_push(pp, 0);
    vec_push(tt, 6); vec_push(td1, 0); vec_push(td2, 0); vec_push(td3, 0);
    vec_push(tt, 0); vec_push(td1, 1); vec_push(td2, 1); vec_push(td3, 0);
    vec_push(pp, 1);
    let sn: Vec<i32> = vec_new();
    let en: Vec<i32> = vec_new();
    let tp: Vec<i32> = vec_new();
    let r0: i32 = resolve_field_ty_tag(tt, td1, td2, td3, pp,
                                        source, starts, ends,
                                        sn, en, tp, 0, 0);
    if r0 != 7 { return 1; }
    let r1: i32 = resolve_field_ty_tag(tt, td1, td2, td3, pp,
                                        source, starts, ends,
                                        sn, en, tp, 0, 1);
    if r1 != 2 { return 2; }
    let r2: i32 = resolve_field_ty_tag(tt, td1, td2, td3, pp,
                                        source, starts, ends,
                                        sn, en, tp, 0, 2);
    if r2 != 1 { return 3; }
    vec_push(tt, 0); vec_push(td1, 2); vec_push(td2, 1); vec_push(td3, 0);
    vec_push(pp, 2);
    vec_push(sn, 2);
    let r3: i32 = resolve_field_ty_tag(tt, td1, td2, td3, pp,
                                        source, starts, ends,
                                        sn, en, tp, 0, 3);
    if r3 != 6 { return 4; }
    let en2: Vec<i32> = vec_new();
    vec_push(en2, 2);
    let sn2: Vec<i32> = vec_new();
    let r4: i32 = resolve_field_ty_tag(tt, td1, td2, td3, pp,
                                        source, starts, ends,
                                        sn2, en2, tp, 0, 3);
    if r4 != 7 { return 5; }
    let r_bad: i32 = resolve_field_ty_tag(tt, td1, td2, td3, pp,
                                           source, starts, ends,
                                           sn, en, tp, 0, 0 - 1);
    if r_bad != 0 - 1 { return 6; }
    return 0;
}

fn test_contract_expr_flag() -> i32 {
    let flag: Vec<i32> = contract_expr_new();
    if contract_expr_active(flag) != false { return 1; }
    let saved: i32 = contract_expr_enter(flag);
    if contract_expr_active(flag) != true { return 2; }
    let x: i32 = contract_expr_exit(flag, saved);
    if contract_expr_active(flag) != false { return 3; }
    return 0;
}

fn test_ty_import_alias_push() -> i32 {
    let names: Vec<i32> = vec_new();
    let targets: Vec<i32> = vec_new();
