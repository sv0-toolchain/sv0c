    vec_push(vei2, 200);
    vec_push(vs2, 1);
    vec_push(vfc2, 1);
    vec_push(vt2, 3);
    vec_push(vei2, 200);
    vec_push(vs2, 0);
    vec_push(vfc2, 0);
    let oi2: Vec<i32> = vec_new();
    let r2: i32 = try_success_validate(vt2, vei2, vs2, vfc2, 200,
                      src, st, en, oi2);
