fn test_fn_table_lookup_str() -> i32 {
    let source: string = "foo bar baz";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 3);
    vec_push(starts, 4); vec_push(ends, 7);
    vec_push(starts, 8); vec_push(ends, 11);
    let fnames: Vec<i32> = vec_new();
    let fpcs: Vec<i32> = vec_new();
    let frets: Vec<i32> = vec_new();
    let foffs: Vec<i32> = vec_new();
    let fptf: Vec<i32> = vec_new();
    let p0: Vec<i32> = vec_new();
    vec_push(p0, TY_INT());
    let x0: i32 = fn_table_add(fnames, fpcs, frets, foffs, fptf,
                                0, TY_BOOL(), p0, 1);
    if x0 < 0 { return 99; }
    let p1: Vec<i32> = vec_new();
    let x1: i32 = fn_table_add(fnames, fpcs, frets, foffs, fptf,
                                1, TY_STRING(), p1, 0);
    if x1 < 0 { return 99; }
    let r0: i32 = fn_table_lookup_str(fnames, source, starts, ends, "foo");
    if r0 != 0 { return 1; }
    let r1: i32 = fn_table_lookup_str(fnames, source, starts, ends, "bar");
    if r1 != 1 { return 2; }
    let r2: i32 = fn_table_lookup_str(fnames, source, starts, ends, "baz");
    if r2 != 0 - 1 { return 3; }
    if fn_table_ret_type(frets, r0) != TY_BOOL() { return 4; }
    if fn_table_ret_type(frets, r1) != TY_STRING() { return 5; }
    return 0;
}

fn test_scan_fn_ret_type_tag() -> i32 {
    let source: string = "fn foo ( x : i32 ) -> bool { }";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 2);
