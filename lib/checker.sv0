    vec_push(st, 9);
    vec_push(en, 13);
    vec_push(st, 13);
    vec_push(en, 16);
    vec_push(vt, 0);
    vec_push(vei, 100);
    vec_push(vs, 1);
    vec_push(vfc, 1);
    vec_push(vt, 1);
    vec_push(vei, 100);
    vec_push(vs, 1);
    vec_push(vfc, 1);
    let oi1: Vec<i32> = vec_new();
