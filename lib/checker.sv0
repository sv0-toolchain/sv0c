fn test_path_key_vec() -> i32 {
    let src: string = "Foo::Bar::Baz";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 3);
    vec_push(starts, 5); vec_push(ends, 8);
    vec_push(starts, 10); vec_push(ends, 13);
    let segs: Vec<i32> = vec_new();
    vec_push(segs, 0); vec_push(segs, 1); vec_push(segs, 2);
    let k: string = path_key_vec(src, starts, ends, segs);
    if string_eq(k, "Foo::Bar::Baz") != true { return 1; }
    let one: Vec<i32> = vec_new();
    vec_push(one, 0);
    if string_eq(path_key_vec(src, starts, ends, one), "Foo") != true { return 2; }
    let empty: Vec<i32> = vec_new();
    if string_eq(path_key_vec(src, starts, ends, empty), "") != true { return 3; }
    return 0;
}

