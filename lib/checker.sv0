    return 0;
}

fn test_int_width_from_name() -> i32 {
    if int_width_from_name("i32") != 32 { return 1; }
    if int_width_from_name("u64") != 64 { return 2; }
    if int_width_from_name("i8") != 8 { return 3; }
    if int_width_from_name("f64") != 64 { return 4; }
    if int_width_from_name("bool") != 0 { return 5; }
    if int_width_from_name("string") != 0 { return 6; }
    if int_width_from_name("i128") != 128 { return 7; }
    return 0;
}

fn test_ast_ty_payload() -> i32 {
    let tt: Vec<i32> = vec_new();
    let td1: Vec<i32> = vec_new();
    let td2: Vec<i32> = vec_new();
    let td3: Vec<i32> = vec_new();
    let pp: Vec<i32> = vec_new();
    let src: string = "i32MyStruct";
    let st: Vec<i32> = vec_new();
    let en: Vec<i32> = vec_new();
    vec_push(st, 0);
    vec_push(en, 3);
    vec_push(st, 3);
    vec_push(en, 11);
    vec_push(pp, 0);
    vec_push(pp, 1);
    vec_push(tt, 0);
    vec_push(td1, 0);
    vec_push(td2, 1);
    vec_push(td3, 0);
    let sn: Vec<i32> = vec_new();
    vec_push(sn, 1);
    let enn: Vec<i32> = vec_new();
    let tp: Vec<i32> = vec_new();
    let op1: Vec<i32> = vec_new();
    let r1: i32 = ast_ty_to_ty_payload(tt, td1, td2, td3, pp,
                      src, st, en, sn, enn, tp, 0, 0, op1);
    if r1 != TY_INT() { return 1; }
    if vec_len(op1) != 1 { return 2; }
    if vec_get(op1, 0) != 32 { return 3; }
    let op2: Vec<i32> = vec_new();
    vec_push(tt, 0);
    vec_push(td1, 1);
    vec_push(td2, 1);
    vec_push(td3, 0);
    let r2: i32 = ast_ty_to_ty_payload(tt, td1, td2, td3, pp,
                      src, st, en, sn, enn, tp, 0, 1, op2);
    if r2 != TY_STRUCT() { return 4; }
    if vec_len(op2) != 1 { return 5; }
    if vec_get(op2, 0) != 1 { return 6; }
    let op3: Vec<i32> = vec_new();
    vec_push(tt, 6);
    vec_push(td1, 0);
    vec_push(td2, 0);
    vec_push(td3, 0);
    let r3: i32 = ast_ty_to_ty_payload(tt, td1, td2, td3, pp,
                      src, st, en, sn, enn, tp, 0, 2, op3);
    if r3 != TY_UNIT() { return 7; }
    if vec_len(op3) != 0 { return 8; }
    return 0;
}

