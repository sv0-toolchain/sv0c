                      src, st, en, oi1);
    if r1 != 1 { return 1; }
    if vec_len(oi1) != 1 { return 2; }
    if vec_get(oi1, 0) != 0 { return 3; }
    let vt2: Vec<i32> = vec_new();
    let vei2: Vec<i32> = vec_new();
    let vs2: Vec<i32> = vec_new();
    let vfc2: Vec<i32> = vec_new();
