fn test_fn_table() -> i32 {
    let fnames: Vec<i32> = vec_new();
    let fpcs: Vec<i32> = vec_new();
    let frets: Vec<i32> = vec_new();
    let foffs: Vec<i32> = vec_new();
    let fptf: Vec<i32> = vec_new();
    let params1: Vec<i32> = vec_new();
    vec_push(params1, TY_STRING());
    let x1: i32 = fn_table_add(fnames, fpcs, frets, foffs, fptf,
                     100, TY_UNIT(), params1, 1);
    if x1 != 0 { return 1; }
    if fn_table_lookup(fnames, 100) != 0 { return 2; }
    if fn_table_ret_type(frets, 0) != TY_UNIT() { return 3; }
    if fn_table_param_count(fpcs, 0) != 1 { return 4; }
    if fn_table_param_type(foffs, fptf, 0, 0) != TY_STRING() { return 5; }
    let params2: Vec<i32> = vec_new();
    vec_push(params2, TY_INT());
    vec_push(params2, TY_INT());
    let x2: i32 = fn_table_add(fnames, fpcs, frets, foffs, fptf,
                     200, TY_BOOL(), params2, 2);
    if x2 != 1 { return 6; }
    if fn_table_param_count(fpcs, 1) != 2 { return 7; }
    if fn_table_param_type(foffs, fptf, 1, 0) != TY_INT() { return 8; }
    if fn_table_param_type(foffs, fptf, 1, 1) != TY_INT() { return 9; }
    if fn_table_ret_type(frets, 1) != TY_BOOL() { return 10; }
    if fn_table_lookup(fnames, 999) != 0 - 1 { return 11; }
    if fn_table_ret_type(frets, 0 - 1) != TY_UNKNOWN() { return 12; }
    let params0: Vec<i32> = vec_new();
    let x3: i32 = fn_table_add(fnames, fpcs, frets, foffs, fptf,
                     300, TY_INT(), params0, 0);
    if fn_table_param_count(fpcs, x3) != 0 { return 13; }
    if fn_table_ret_type(frets, x3) != TY_INT() { return 14; }
    return 0;
}

