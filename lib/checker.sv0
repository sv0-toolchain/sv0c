                                 ed_names, ed_voffs, ed_vcounts,
                                 ed_vn_flat, ed_vs_flat);
    if c != 1 { return 1; }
    let ei: i32 = edef_name_lookup_str(ed_names, source,
                                        starts, ends, "Color");
    if ei != 0 { return 2; }
    let ei2: i32 = edef_name_lookup_str(ed_names, source,
                                         starts, ends, "Nope");
    if ei2 != 0 - 1 { return 3; }
    let ct0: i32 = ctor_type_from_edef(ed_names, ed_voffs, ed_vcounts,
                                        ed_vn_flat, ed_vs_flat,
                                        source, starts, ends,
                                        1, "Red");
    if ct0 != TY_ENUM() { return 4; }
    let ct1: i32 = ctor_type_from_edef(ed_names, ed_voffs, ed_vcounts,
                                        ed_vn_flat, ed_vs_flat,
                                        source, starts, ends,
                                        1, "Green");
    if ct1 != TY_FN() { return 5; }
    let ct2: i32 = ctor_type_from_edef(ed_names, ed_voffs, ed_vcounts,
                                        ed_vn_flat, ed_vs_flat,
                                        source, starts, ends,
                                        1, "Blue");
    if ct2 != TY_FN() { return 6; }
    let rp: i32 = resolve_ctor_path_ty(ed_names, ed_voffs, ed_vcounts,
                                        ed_vn_flat, ed_vs_flat,
                                        source, starts, ends,
                                        1, 3);
    if rp != TY_ENUM() { return 7; }
    let rp2: i32 = resolve_ctor_path_ty(ed_names, ed_voffs, ed_vcounts,
                                         ed_vn_flat, ed_vs_flat,
                                         source, starts, ends,
                                         1, 5);
    if rp2 != TY_FN() { return 8; }
    return 0;
}

fn test_synth_expr() -> i32 {
    /* source: "x 42 true"
       tok: 0=x(5)  1=42(1)  2=true(63) */
    let source: string = "x 42 true";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 1);
    vec_push(starts, 2); vec_push(ends, 4);
    vec_push(starts, 5); vec_push(ends, 9);
    let en: Vec<i32> = vec_new();
    let ety: Vec<i32> = vec_new();
    let em: Vec<i32> = vec_new();
    env_extend(en, ety, em, 0, TY_INT(), 0);
    let et: Vec<i32> = vec_new();
    let ed1: Vec<i32> = vec_new();
    let ed2: Vec<i32> = vec_new();
    let ed3: Vec<i32> = vec_new();
    let ed4v: Vec<i32> = vec_new();
    let ppool: Vec<i32> = vec_new();
    let edn: Vec<i32> = vec_new();
    let edvo: Vec<i32> = vec_new();
    let edvc: Vec<i32> = vec_new();
    let edvn: Vec<i32> = vec_new();
    let edvs: Vec<i32> = vec_new();
    let tfn: Vec<i32> = vec_new();
    let tfrt: Vec<i32> = vec_new();
    vec_push(et, 0); vec_push(ed1, 0); vec_push(ed2, 1); vec_push(ed3, 0); vec_push(ed4v, 0);
    let r0: i32 = synth_expr(et, ed1, ed2, ed3, ed4v, ppool,
                              source, starts, ends, en, ety, em,
                              edn, edvo, edvc, edvn, edvs,
                              tfn, tfrt,
                              TY_INT(), 0, 0);
    if r0 != TY_INT() { return 1; }
    vec_push(et, 0); vec_push(ed1, 1); vec_push(ed2, 0); vec_push(ed3, 0); vec_push(ed4v, 0);
    let r1: i32 = synth_expr(et, ed1, ed2, ed3, ed4v, ppool,
