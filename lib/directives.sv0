/* Coverage comment directives (sv0cov CV-304; SPEC 19.3, 19.4; sv0doc
 * attributes/coverage.md section 6).
 *
 * A pre-lex scan of each source unit's text (the lexer drops comments). It
 * walks the text the way lib/lexer.sv0 does -- strings and character literals
 * with their escapes, nested block comments -- so a `// sv0cov:` inside a
 * string or a block comment is never a directive. Grammar (exact):
 *
 *   // sv0cov: ignore-next reason="<text>"
 *   // sv0cov: ignore-start reason="<text>"
 *   // sv0cov: ignore-end
 *
 * with one or more spaces or tabs between the parts and only spaces or tabs
 * after the last. The reason is a string with the lexer's escapes, 1 to 1,024
 * bytes. A directive is a line comment alone on its line. Any comment whose
 * text (after the comment opener and spaces) starts with `sv0cov:` in any
 * case is a directive attempt and must be spelled exactly so (COV3201).
 * Regions do not nest: a directive inside an open region, or between an
 * `ignore-next` and its construct, is redundant (COV3203); an `ignore-end`
 * without a start, or a start never closed in its unit, is COV3201; an
 * `ignore-next` with no code after it in its unit is COV1021. A missing or
 * empty reason is COV3207. Checked in every build, like attributes (D-14).
 *
 * Table, DIRS_STRIDE() ints per directive: kind (1 ignore-next, 2
 * ignore-start, 3 ignore-end), unit, comment start, comment end (exclusive,
 * before the newline), reason start and end (inside the quotes; -1 for
 * ignore-end), partner (the matching start or end; -1), next (offset of the
 * first code byte after an ignore-next; -1 otherwise). Offsets are into the
 * unit's own text. Which construct an ignore-next excludes, and the effect,
 * are lib/exclusions.sv0 (sv0cov CV-305).
 *
 * Errors: (code, unit, start, end, message id) quintuples.
 *
 * `&&` and `||` evaluate both operands in sv0c today, so index guards here
 * are nested ifs. Depends on lib/lexer.sv0 (skip_line_comment,
 * skip_block_comment, scan_string_end, scan_char_end).
 */

fn DIRS_STRIDE() -> i32 { return 8; }

fn dirs_ch(text: string, p: i32) -> i32 {
    if p < 0 { return 0 - 1; }
    if p >= string_len(text) { return 0 - 1; }
    return string_char_at(text, p);
}

fn dirs_ws(c: i32) -> bool {
    return c == 32 || c == 9 || c == 13;
}

fn dirs_lower(c: i32) -> i32 {
    if c >= 65 {
        if c <= 90 { return c + 32; }
    }
    return c;
}

/* True when `word` is at `p`; `fold` compares ASCII case-insensitively. */
fn dirs_has(text: string, p: i32, word: string, fold: bool) -> bool {
    let n: i32 = string_len(word);
    let mut i: i32 = 0;
    while i < n {
        let mut c: i32 = dirs_ch(text, p + i);
        if fold { c = dirs_lower(c); }
        if c != string_char_at(word, i) { return false; }
        i = i + 1;
    }
    return true;
}

fn dirs_skip_ws(text: string, p: i32, e: i32) -> i32 {
    let mut q: i32 = p;
    while q < e {
        if dirs_ws(string_char_at(text, q)) == false { return q; }
        q = q + 1;
    }
    return q;
}

fn dirs_err(errs: Vec<i32>, code: i32, unit: i32, a: i32, b: i32, id: i32) -> i32 {
    vec_push(errs, code);
    vec_push(errs, unit);
    vec_push(errs, a);
    vec_push(errs, b);
    vec_push(errs, id);
    return 1;
}

/* A line comment at p whose text starts with `sv0cov:` (any case). */
fn dirs_line_attempt(text: string, p: i32) -> bool {
    let mut q: i32 = p + 2;
    while dirs_ch(text, q) == 47 { q = q + 1; }
    while dirs_ws(dirs_ch(text, q)) { q = q + 1; }
    return dirs_has(text, q, "sv0cov:", true);
}

/* A block comment at p whose text starts with `sv0cov:` (any case). */
fn dirs_block_attempt(text: string, p: i32) -> bool {
    let mut q: i32 = p + 2;
    while dirs_ch(text, q) == 42 { q = q + 1; }
    let mut going: bool = true;
    while going {
        let c: i32 = dirs_ch(text, q);
        if dirs_ws(c) { q = q + 1; } else { if c == 10 { q = q + 1; } else { going = false; } }
    }
    return dirs_has(text, q, "sv0cov:", true);
}

fn dirs_push(tab: Vec<i32>, kind: i32, unit: i32, p: i32, e: i32, rs: i32, re: i32) -> i32 {
    let k: i32 = vec_len(tab) / DIRS_STRIDE();
    vec_push(tab, kind);
    vec_push(tab, unit);
    vec_push(tab, p);
    vec_push(tab, e);
    vec_push(tab, rs);
    vec_push(tab, re);
    vec_push(tab, 0 - 1);
    vec_push(tab, 0 - 1);
    return k;
}

/* One directive attempt: the line comment text[p..e). `st` holds the open
   ignore-start and the pending ignore-next (table indices, -1 for none).
   Returns the number of errors. */
fn dirs_directive(text: string, unit: i32, p: i32, e: i32, standalone: bool,
                  tab: Vec<i32>, errs: Vec<i32>, st: Vec<i32>) -> i32 {
    if standalone == false { return dirs_err(errs, 3201, unit, p, e, 1); }
    if dirs_has(text, p, "// sv0cov:", false) == false { return dirs_err(errs, 3201, unit, p, e, 2); }
    let r: i32 = dirs_skip_ws(text, p + 10, e);
    if r == e { return dirs_err(errs, 3201, unit, p, e, 3); }
    if r == p + 10 { return dirs_err(errs, 3201, unit, p, e, 2); }
    let mut a: i32 = r;
    let mut more: bool = true;
    while more {
        if a >= e { more = false; } else {
            if dirs_ws(string_char_at(text, a)) { more = false; } else { a = a + 1; }
        }
    }
    let mut kind: i32 = 0;
    if a - r == 11 { if dirs_has(text, r, "ignore-next", false) { kind = 1; } }
    if a - r == 12 { if dirs_has(text, r, "ignore-start", false) { kind = 2; } }
    if a - r == 10 { if dirs_has(text, r, "ignore-end", false) { kind = 3; } }
    if kind == 0 { return dirs_err(errs, 3201, unit, r, a, 3); }
    let r2: i32 = dirs_skip_ws(text, a, e);
    let mut rs: i32 = 0 - 1;
    let mut re: i32 = 0 - 1;
    if kind == 3 {
        if r2 < e { return dirs_err(errs, 3201, unit, r2, e, 4); }
    } else {
        if r2 == e { return dirs_err(errs, 3207, unit, p, e, 5); }
        if dirs_has(text, r2, "reason=\"", false) == false { return dirs_err(errs, 3201, unit, r2, e, 6); }
        rs = r2 + 8;
        let mut z: i32 = rs;
        let mut scanning: bool = true;
        while scanning {
            if z >= e { scanning = false; } else {
                let c: i32 = string_char_at(text, z);
                if c == 92 { z = z + 2; } else { if c == 34 { scanning = false; } else { z = z + 1; } }
            }
        }
        if z >= e { return dirs_err(errs, 3201, unit, r2, e, 7); }
        re = z;
        if re == rs { return dirs_err(errs, 3207, unit, r2, re + 1, 8); }
        if re - rs > 1024 { return dirs_err(errs, 3201, unit, rs, re, 9); }
        let t: i32 = dirs_skip_ws(text, re + 1, e);
        if t < e { return dirs_err(errs, 3201, unit, t, e, 10); }
    }
    let open: i32 = vec_get(st, 0);
    let pending: i32 = vec_get(st, 1);
    if pending >= 0 { return dirs_err(errs, 3203, unit, p, e, 11); }
    if kind == 3 {
        if open < 0 { return dirs_err(errs, 3201, unit, p, e, 13); }
        let k: i32 = dirs_push(tab, kind, unit, p, e, rs, re);
        vec_set(tab, k * DIRS_STRIDE() + 6, open);
        vec_set(tab, open * DIRS_STRIDE() + 6, k);
        vec_set(st, 0, 0 - 1);
        return 0;
    }
    if open >= 0 { return dirs_err(errs, 3203, unit, p, e, 12); }
    let k2: i32 = dirs_push(tab, kind, unit, p, e, rs, re);
    if kind == 1 { vec_set(st, 1, k2); } else { vec_set(st, 0, k2); }
    return 0;
}

/* Scan one unit's text; appends directives to `tab` and errors to `errs`.
   Returns the number of errors. */
fn dirs_scan_unit(text: string, unit: i32, tab: Vec<i32>, errs: Vec<i32>) -> i32 {
    let s: i32 = DIRS_STRIDE();
    let n: i32 = string_len(text);
    let st: Vec<i32> = vec_new();
    vec_push(st, 0 - 1);
    vec_push(st, 0 - 1);
    let mut nerr: i32 = 0;
    let mut line_code: bool = false;
    let mut p: i32 = 0;
    while p < n {
        let c: i32 = string_char_at(text, p);
        let nx: i32 = dirs_ch(text, p + 1);
        if c == 10 {
            line_code = false;
            p = p + 1;
        } else { if dirs_ws(c) {
            p = p + 1;
        } else { if c == 47 && nx == 47 {
            let e: i32 = skip_line_comment(text, p);
            if dirs_line_attempt(text, p) {
                nerr = nerr + dirs_directive(text, unit, p, e, line_code == false, tab, errs, st);
            }
            p = e;
        } else { if c == 47 && nx == 42 {
            let e2: i32 = skip_block_comment(text, p + 2, 1);
            if dirs_block_attempt(text, p) {
                let mut le: i32 = p;
                let mut walking: bool = true;
                while walking {
                    if le >= e2 { walking = false; } else {
                        if string_char_at(text, le) == 10 { walking = false; } else { le = le + 1; }
                    }
                }
                nerr = nerr + dirs_err(errs, 3201, unit, p, le, 16);
            }
            line_code = true;
            p = e2;
        } else {
            let pending: i32 = vec_get(st, 1);
            if pending >= 0 {
                vec_set(tab, pending * s + 7, p);
                vec_set(st, 1, 0 - 1);
            }
            line_code = true;
            if c == 34 { p = scan_string_end(text, p + 1); }
            else { if c == 39 { p = scan_char_end(text, p + 1); } else { p = p + 1; } }
        } } } }
    }
    let open: i32 = vec_get(st, 0);
    if open >= 0 {
        nerr = nerr + dirs_err(errs, 3201, unit, vec_get(tab, open * s + 2), vec_get(tab, open * s + 3), 14);
    }
    let pend: i32 = vec_get(st, 1);
    if pend >= 0 {
        nerr = nerr + dirs_err(errs, 1021, unit, vec_get(tab, pend * s + 2), vec_get(tab, pend * s + 3), 15);
    }
    return nerr;
}

fn dirs_message(id: i32) -> string {
    if id == 1 { return "a `// sv0cov:` directive must be a comment on a line of its own"; }
    if id == 2 { return "write a coverage directive exactly as `// sv0cov: <action> reason=\"...\"` (lower case, one space after `//`)"; }
    if id == 3 { return "unknown coverage directive action; the actions are `ignore-next`, `ignore-start` and `ignore-end`"; }
    if id == 4 { return "`ignore-end` takes nothing after it"; }
    if id == 5 { return "the coverage directive needs `reason=\"...\"` after the action"; }
    if id == 6 { return "the coverage directive's reason must be written `reason=\"...\"`"; }
    if id == 7 { return "the coverage directive's reason string is not closed on its line"; }
    if id == 8 { return "the coverage directive's reason is empty"; }
    if id == 9 { return "the coverage directive's reason is longer than 1024 bytes"; }
    if id == 10 { return "nothing may follow the reason of a coverage directive"; }
    if id == 11 { return "this directive comes between a `sv0cov: ignore-next` and the construct it excludes"; }
    if id == 12 { return "this directive is inside a `sv0cov: ignore-start` region, which already excludes everything up to its `ignore-end`"; }
    if id == 13 { return "`ignore-end` without an `ignore-start` before it in this file"; }
    if id == 14 { return "this `ignore-start` is never closed by an `ignore-end` in its file"; }
    if id == 15 { return "nothing follows this `ignore-next` in its file"; }
    if id == 16 { return "a coverage directive must be a `//` line comment"; }
    return "invalid coverage directive";
}

fn dirs_code_text(code: i32) -> string {
    if code == 1021 { return "COV1021"; }
    if code == 3203 { return "COV3203"; }
    if code == 3207 { return "COV3207"; }
    return "COV3201";
}

fn dirs_kind_name(kind: i32) -> string {
    if kind == 1 { return "ignore-next"; }
    if kind == 2 { return "ignore-start"; }
    return "ignore-end";
}

/* The table lines of unit `unit` (whose text is `text`): dir, index, unit,
   kind, comment start, comment end, reason text (or -), partner, next. */
fn dirs_dump_unit(text: string, unit: i32, tab: Vec<i32>) -> string {
    let s: i32 = DIRS_STRIDE();
    let n: i32 = vec_len(tab) / s;
    let mut out: string = "";
    let mut k: i32 = 0;
    while k < n {
        if vec_get(tab, k * s + 1) == unit {
            let rs: i32 = vec_get(tab, k * s + 4);
            let mut reason: string = "-";
            if rs >= 0 { reason = string_substr(text, rs, vec_get(tab, k * s + 5) - rs); }
            let mut line: string = string_concat("dir\t", int_to_string(k));
            line = string_concat(string_concat(line, "\t"), int_to_string(unit));
            line = string_concat(string_concat(line, "\t"), dirs_kind_name(vec_get(tab, k * s)));
            line = string_concat(string_concat(line, "\t"), int_to_string(vec_get(tab, k * s + 2)));
            line = string_concat(string_concat(line, "\t"), int_to_string(vec_get(tab, k * s + 3)));
            line = string_concat(string_concat(line, "\t"), reason);
            line = string_concat(string_concat(line, "\t"), int_to_string(vec_get(tab, k * s + 6)));
            line = string_concat(string_concat(line, "\t"), int_to_string(vec_get(tab, k * s + 7)));
            out = string_concat(string_concat(out, line), "\n");
        }
        k = k + 1;
    }
    return out;
}
