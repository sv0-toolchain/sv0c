fn test_lower_program_fn() -> i32 {
    let src: string = "fn foo() { } struct Bar { x: i32, } enum Qux { A, B, }";
    let strt: Vec<i32> = vec_new();
    let endi: Vec<i32> = vec_new();
    let mut p: i32 = 0;
    while p < 54 {
        vec_push(strt, p);
        vec_push(endi, p + 1);
        p = p + 1;
    }
    let it: Vec<i32> = vec_new();
    let id1: Vec<i32> = vec_new();
    let id2: Vec<i32> = vec_new();
    let id3: Vec<i32> = vec_new();
    let id4: Vec<i32> = vec_new();
    let ifc: Vec<i32> = vec_new();
    let ivm: Vec<i32> = vec_new();
    let sfn: Vec<i32> = vec_new();
    let evn: Vec<i32> = vec_new();
    let sfnames: Vec<i32> = vec_new();
    let sftypes: Vec<i32> = vec_new();
    vec_push(it, 0);
    vec_push(id1, 3);
    vec_push(id2, 0);
    vec_push(id3, 0);
    vec_push(id4, 0);
    vec_push(ifc, 0);
    vec_push(ivm, 0);
    vec_push(it, 1);
    vec_push(id1, 14);
    vec_push(id2, 1);
    vec_push(id3, 0);
    vec_push(id4, 0);
    vec_push(ifc, 1);
    vec_push(ivm, 0);
    vec_push(sfn, 20);
    vec_push(sfnames, 20);
    vec_push(sftypes, 22);
    vec_push(it, 2);
    vec_push(id1, 30);
    vec_push(id2, 2);
    vec_push(id3, 0);
    vec_push(id4, 0);
    vec_push(ifc, 0);
    vec_push(ivm, 0);
    vec_push(evn, 40);
    vec_push(evn, 45);
    let ob: Vec<i32> = vec_new();
    let osn: Vec<i32> = vec_new();
    let oso: Vec<i32> = vec_new();
    let osc: Vec<i32> = vec_new();
    let osf: Vec<i32> = vec_new();
    let oen: Vec<i32> = vec_new();
    let oeto: Vec<i32> = vec_new();
    let oetc: Vec<i32> = vec_new();
    let oetf: Vec<i32> = vec_new();
    let oem: Vec<i32> = vec_new();
    let bet: Vec<i32> = vec_new();
    let be1: Vec<i32> = vec_new();
    let be2: Vec<i32> = vec_new();
    let be3: Vec<i32> = vec_new();
    let be4: Vec<i32> = vec_new();
    let bsf: Vec<i32> = vec_new();
    let bpp: Vec<i32> = vec_new();
    let ttags: Vec<i32> = vec_new();
    let oblks: Vec<i32> = vec_new();
    let td: string = lower(it, id1, id2, id3, id4, ifc, ivm,
                             sfn, evn, sfnames, sftypes,
                             src, strt, endi,
                             ob, osn, oso, osc, osf,
                             oen, oeto, oetc, oetf, oem,
                             bet, be1, be2, be3, be4, bsf,
                             bpp, ttags, oblks,
                             vec_new(), vec_new(), vec_new(),
                             vec_new(), vec_new(), vec_new(), 0, vec_new(),
                             vec_new(), vec_new());
    if vec_len(ob) != 1 { return 1; }
    if vec_get(ob, 0) != 3 { return 2; }
    if vec_len(osn) != 1 { return 3; }
    if vec_len(oen) != 1 { return 4; }
    if vec_len(oblks) != 4 { return 5; }
    if vec_get(oblks, 0) != 3 { return 6; }
    return 0;
}

