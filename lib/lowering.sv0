    let v2: i32 = parse_decimal_i32_from_tok(src, st, en, 1);
    if v2 != 0 { return 2; }
    let v3: i32 = parse_decimal_i32_from_tok(src, st, en, 0 - 1);
    if v3 != 0 { return 3; }
    return 0;
}

