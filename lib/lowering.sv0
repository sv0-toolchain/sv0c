    if ir_value_tag(v2) != 1 { return 2; }
    let v3: Value = lower_lit_to_ir_value(5, 1, tok_tags, lit_src, lit_st, lit_en);
    if ir_value_tag(v3) != 2 { return 3; }
    let v4: Value = lower_lit_to_ir_value(3, 2, tok_tags, lit_src, lit_st, lit_en);
    if ir_value_tag(v4) != 5 { return 4; }
    let v5: Value = lower_lit_to_ir_value(99, 0, tok_tags, lit_src, lit_st, lit_en);
    if ir_value_tag(v5) != 4 { return 5; }
    return 0;
}

