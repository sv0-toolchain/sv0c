}

fn test_inject_ensures_and_ret_slot() -> i32 {
    let body0: Vec<i32> = vec_new();
    vec_push(body0, box_new(Instr::ReturnVal(box_new(Value::VInt(5)))));
    let ens0: Vec<i32> = vec_new();
    vec_push(ens0, box_new(Instr::Ensures(box_new(Expr::Literal(box_new(Value::VBoolTrue))), 99)));
    let out0: Vec<i32> = inject_ensures_and_ret_slot(body0, ens0, false, 0 - 1);
    if vec_len(out0) != 2 { return 1; }
    let i0: Instr = box_deref(vec_get(out0, 0));
    if ir_instr_tag(i0) != 13 { return 2; }
    let i1: Instr = box_deref(vec_get(out0, 1));
    if ir_instr_tag(i1) != 15 { return 3; }
    let body1: Vec<i32> = vec_new();
    vec_push(body1, box_new(Instr::ReturnVal(box_new(Value::VInt(7)))));
    let ens1: Vec<i32> = vec_new();
    vec_push(ens1, box_new(Instr::Ensures(box_new(Expr::Literal(box_new(Value::VBoolTrue))), 77)));
    let out1: Vec<i32> = inject_ensures_and_ret_slot(body1, ens1, true, 42);
    if vec_len(out1) != 3 { return 4; }
    let j1: Instr = box_deref(vec_get(out1, 1));
    if ir_instr_tag(j1) != 13 { return 5; }
    let j2: Instr = box_deref(vec_get(out1, 2));
    if ir_instr_tag(j2) != 15 { return 6; }
    match j2 {
        Instr::ReturnVal(bv2) => {
            let rv2: Value = box_deref(bv2);
            if ir_value_tag(rv2) != 3 { return 7; }
            match rv2 {
                Value::VVar(h2) => {
                    if h2 != 42 { return 8; }
                },
                _ => { return 9; },
            }
        },
        _ => { return 10; },
    }
    return 0;
}

