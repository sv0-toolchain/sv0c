/* Phase 2 real pipeline module: sml/ir/lowering.sml -> sv0.
   Lowering utilities: splitQName, binop/unop → C strings, AST type → C
   type mapping, freshTmp counter + fresh_tmp_str, oldSlot naming,
   retSyntaxIsUnit, storeValueToSlot/assignment LHS classification,
   paramName extraction, uniqOldNames (dedup), enum tag lookup (Vec),
   struct field list lookup, enum/struct type detection, variant slot
   counting, enum max payload, tryVariantNames, literal classification +
   lower_lit_to_ir_tag, fn_ret_cty, value_to_expr_kind, enum_alloc_width,
   import alias management + resolve_fn_callee + resolve_enum_ctor_path,
   **`import_aliases`** threaded from **`lower`** into **`match_scrut_cty`**
   (SML **`importAliases`** for **`callee_fn_index_match_env`**),
   param_name, lower_field_index, ast_ty_to_c_string_with_user,
   find_fn_index / callee_fn_index, scrut_local_lookup / param_ty_lookup.
   Typedef builders (batch 34): handle_to_str (token handle → string),
   emit_struct_td / emit_enum_td (SML emitStructTd/emitEnumTd — C typedef
   string generation), build_struct_order (SML buildStructOrder — populate
   struct field order lookup tables), build_enum_variants_data (SML
   buildEnumVariants — populate enum variant tag + max payload tables),
   collect_typedefs_str (SML collectTypedefs — concatenate all struct then
   enum typedef strings from item Vecs).
   AST walk helpers (batch 35): mentions_result (SML mentionsResult —
   recursive expr arena walk detecting "result" path for ensures clause
   result-slot injection), all_old_names_expr (SML allOldNames — recursive
   expr arena walk collecting old(x) token handles for contract pre/post
   variable setup; includes ExprBlock/stmt dispatch for LetStmt/SemiStmt).
   lowerFn prereqs (batch 36): expr_init_cty (SML exprInitCty — infer
   type handle from init expression shape: ExprStruct path, 2-segment
   ExprPath for enum ctors, ExprCall callee return type, ExprTuple(1)
   recursion; returns -1 for "int"), scan_lets (SML scanLets — walk
   ExprBlock for LetStmt with init, collect name+type handle pairs).
   Arena lookup helpers (batch 37): try_variant_names_lookup (SML
   tryVariantNames — full arena lookup with string-based Ok/Err/Some/None
   detection; returns success+failure variant handles), find_variant_in_items
   (SML findVariantAst — find variant flat index within an enum's item arena).
   Scoped state helpers (batch 39): scrut_locals_push /
   scrut_local_lookup_bounded (SML withScrutLocals — push extra
   scrut bindings with logical-length restore), lower_alias_replace
   (SML setImportAliases — bulk alias table fill from parallel Vecs).
   Match/variant helpers (batch 40): match_scrut_cty (SML matchScrutCty
   — determine type handle for match scrutinee via scrut locals, packed
   lower_match_env scrut region [8..10] (interleaved), param region [5..7],
   enum ctor path, or callee return type from env [2..4]), variant_shape_in_items
   (enum variant shape+field count lookup from item arena flat arrays).
   Full IR emission (lowerExpr/lowerStmt/lowerFn/lower) deferred —
   needs deep AST traversal with slot/instr accumulation.
   IR enum types (batch 62): local Value/Expr/Instr definitions
   matching codegen.sv0 layout for downstream compatibility,
   ir_value_tag/ir_expr_tag/ir_instr_tag accessors,
   ctr_fresh (mutable temp counter via Vec<i32> + vec_set),
   classify_assign_lhs_arena (SML classifyAssignLhs — full
   flat-arena LHS classification for ExprPath(1-seg) and
   ExprField(ExprPath(1-seg), field)). */

/* ── IR types (local copies, matching codegen.sv0 layout) ──── */

enum Value {
    VInt(i32),
    VBoolTrue,
    VBoolFalse,
    VVar(i32),
    VUnit,
    VString(i32),
    VMember(Box<Value>, i32),
    VAddrOf(i32),
    /* Float literal: h is the source token handle (not a parsed value — sv0
       has no way to carry an f64 payload through this i32-slotted enum), so
       emission re-derives the literal text from source and prints it
       verbatim (already valid C double syntax). Appended last to keep this
       enum's layout a prefix-compatible match with codegen.sv0's copy,
       which megaTU-main.sv0's emit path reinterprets these boxes as via
       box_deref — see BUGS.md #5 in sv0-mathlib for the original repro. */
    VFloat(i32),
    /* Integer literal too wide for VInt's i32 payload (e.g. an i64::MAX-
       magnitude literal): h is the source token handle, same "print the
       source text verbatim" strategy as VFloat — a bare decimal integer
       literal is already valid C and the C compiler infers the right width,
       so there's no need to parse it into any bounded sv0 integer at
       compile time. Previously VInt's parse (parse_decimal_i32_from_tok)
       silently wrapped mod 2^32 for any such literal, regardless of the
       declared type context (BUGS.md #1 in sv0-mathlib). */
    VIntWide(i32),
}

enum Expr {
    Literal(Box<Value>),
    Load(i32),
    Binop(i32, Box<Value>, Box<Value>),
    Unop(i32, Box<Value>),
    FieldAccess(Box<Value>, i32),
}

enum Instr {
    Nop,
    DeclVar(i32),
    DeclNamed(i32, i32),
    Assign(i32, Box<Expr>),
    Store(i32, Box<Expr>),
    StoreField(i32, i32, Box<Expr>),
    IfElse(Box<Expr>, Vec<i32>, Vec<i32>),
    WhileLoop(Box<Expr>, Vec<i32>),
    BlockInstr(Vec<i32>),
    Break,
    Continue,
    Call(i32, i32, Vec<i32>, i32),
    Requires(Box<Expr>, i32),
    Ensures(Box<Expr>, i32),
    ReturnVoid,
    ReturnVal(Box<Value>),
}

fn ir_value_tag(v: Value) -> i32 {
    match v {
        Value::VInt(_) => { return 0; },
        Value::VBoolTrue => { return 1; },
        Value::VBoolFalse => { return 2; },
        Value::VVar(_) => { return 3; },
        Value::VUnit => { return 4; },
        Value::VString(_) => { return 5; },
        Value::VMember(_, _) => { return 6; },
        Value::VAddrOf(_) => { return 7; },
        Value::VFloat(_) => { return 8; },
        Value::VIntWide(_) => { return 9; },
    }
}

fn ir_expr_tag(e: Expr) -> i32 {
    match e {
        Expr::Literal(_) => { return 0; },
        Expr::Load(_) => { return 1; },
        Expr::Binop(_, _, _) => { return 2; },
        Expr::Unop(_, _) => { return 3; },
        Expr::FieldAccess(_, _) => { return 4; },
    }
}

fn ir_instr_tag(ins: Instr) -> i32 {
    match ins {
        Instr::Nop => { return 0; },
        Instr::DeclVar(_) => { return 1; },
        Instr::DeclNamed(_, _) => { return 2; },
        Instr::Assign(_, _) => { return 3; },
        Instr::Store(_, _) => { return 4; },
        Instr::StoreField(_, _, _) => { return 5; },
        Instr::IfElse(_, _, _) => { return 6; },
        Instr::WhileLoop(_, _) => { return 7; },
        Instr::BlockInstr(_) => { return 8; },
        Instr::Break => { return 9; },
        Instr::Continue => { return 10; },
        Instr::Call(_, _, _, _) => { return 11; },
        Instr::Requires(_, _) => { return 12; },
        Instr::Ensures(_, _) => { return 13; },
        Instr::ReturnVoid => { return 14; },
        Instr::ReturnVal(_) => { return 15; },
    }
}

/* ── lower_lit_to_ir_value (SML lowerLit → Value enum) ────────
   Converts a literal tag + token position to an IR Value.
   Parser lit tags: 0=IntLit, 1=FloatLit, 3=StringLit, 5=BoolLit.
   tok_tags needed to distinguish true (91) vs false (64). */

fn lower_lit_to_ir_value(lit_tag: i32, tok_pos: i32,
                          tok_tags: Vec<i32>,
                          source: string, starts: Vec<i32>, ends: Vec<i32>) -> Value {
    /* Integer literal: parse the actual value from the token text (SML IR VInt
       holds the value). Previously stored tok_pos, so codegen emitted the token
       index instead of the number. */
    if lit_tag == 0 {
        if decimal_lit_fits_i32(source, starts, ends, tok_pos) {
            return Value::VInt(parse_decimal_i32_from_tok(source, starts, ends, tok_pos));
        }
        return Value::VIntWide(tok_pos);
    }
    if lit_tag == 5 {
        let tt: i32 = vec_get(tok_tags, tok_pos);
        if tt == 91 { return Value::VBoolTrue; }
        return Value::VBoolFalse;
    }
    if lit_tag == 3 { return Value::VString(tok_pos); }
    /* Float literal: no eager numeric parse (see VFloat's doc comment) —
       carry the token handle and let emission print the source text
       verbatim. Previously fell through to VUnit, silently discarding the
       literal (BUGS.md #5 in sv0-mathlib). */
    if lit_tag == 1 { return Value::VFloat(tok_pos); }
    return Value::VUnit;
}

/* Does the decimal digit run at this token fit in an i32 (0..=2147483647 —
   literal tokens are always a bare non-negative digit run; a source-level
   negative like `-5` is unary-neg applied to the literal `5`, so i32::MIN's
   magnitude 2147483648 is correctly treated as NOT fitting here)? Pure
   string comparison, no arithmetic — sidesteps needing overflow-safe i32
   accumulation just to detect overflow. i32::MAX has exactly 10 digits, so
   anything shorter always fits and anything longer never does; a 10-digit
   run needs a lexicographic compare against "2147483647" (safe for
   equal-length non-negative decimal strings). Used by
   lower_lit_to_ir_value to route to VInt vs. VIntWide (BUGS.md #1,
   sv0-mathlib). */
fn decimal_lit_fits_i32(source: string, starts: Vec<i32>, ends: Vec<i32>,
                        tok_pos: i32) -> bool {
    if tok_pos < 0 { return true; }
    if tok_pos >= vec_len(starts) { return true; }
    if tok_pos >= vec_len(ends) { return true; }
    let s: i32 = vec_get(starts, tok_pos);
    let e: i32 = vec_get(ends, tok_pos);
    if s < 0 { return true; }
    if e <= s { return true; }
    let len: i32 = e - s;
    if len < 10 { return true; }
    if len > 10 { return false; }
    let i32_max: string = "2147483647";
    let mut i: i32 = 0;
    while i < 10 {
        let c: i32 = string_char_at(source, s + i);
        let m: i32 = string_char_at(i32_max, i);
        if c < m { return true; }
        if c > m { return false; }
        i = i + 1;
    }
    return true;
}

/* Parse decimal digits from `source[starts[tok_pos]..ends[tok_pos])`.
   Used for PatLit int match arms where the arena stores a token index,
   not the numeric value. Returns 0 on bad bounds or non-digit run. */

fn parse_decimal_i32_from_tok(source: string, starts: Vec<i32>, ends: Vec<i32>,
                              tok_pos: i32) -> i32 {
    if tok_pos < 0 { return 0; }
    if tok_pos >= vec_len(starts) { return 0; }
    if tok_pos >= vec_len(ends) { return 0; }
    let s: i32 = vec_get(starts, tok_pos);
    let e: i32 = vec_get(ends, tok_pos);
    if s < 0 { return 0; }
    if e <= s { return 0; }
    let mut acc: i32 = 0;
    let mut i: i32 = s;
    while i < e {
        let c: i32 = string_char_at(source, i);
        if c < 48 { return 0; }
        if c > 57 { return 0; }
        let d: i32 = c - 48;
        acc = acc * 10 + d;
        i = i + 1;
    }
    return acc;
}

/* ── lower_expr_to_value (SML lowerExprToValue) ───────────────
   Walks the flat expression arena at `idx` and returns an IR
   Value.  Instructions accumulate (as boxed Instr handles) in
   out_instrs.  ctr is a single-element Vec for the temp counter.
   Handles:
     0 ExprLit       → lower_lit_to_ir_value
     1 ExprPath      → VVar (1-seg); 2-seg enum path → nullary ctor
     2 ExprUnop      → Borrow/BorrowMut on ExprPath → VAddrOf;
                        otherwise recurse + Assign(tmp, Unop)
     3 ExprBinop     → recurse lhs+rhs, Assign(tmp, Binop)
     4 ExprCall      → lower args, Call instr, VVar(tmp)
     6 ExprField     → recurse obj, VMember(v, field)
     9 ExprBlock     → inline LetStmt/SemiStmt, tail expr
    10 ExprIf        → with-else: IfElse + Store; no-else: IfElse → VUnit
    15 ExprReturn    → ReturnVal / ReturnVoid
    18 ExprAssign    → classify LHS + Store/StoreField → VUnit
    19 ExprAssignOp  → load + binop + store → VUnit
    25 ExprTuple     → unwrap 1-elem; otherwise VUnit
    12 ExprWhile    → lower cond+body, WhileLoop instr → VUnit
    14 ExprLoop     → WhileLoop(true, body) → VUnit
    16 ExprBreak    → Break instr → VUnit
    17 ExprContinue → Continue instr → VUnit
    20 ExprCast     → recurse src, Assign(tmp, Unop(99,v)) → VVar(tmp)
    13 ExprFor      → desugar to WhileLoop
     1 ExprPath(2)  → nullary enum ctor (DeclNamed + tag store)
     4 ExprCall(2)  → enum ctor with args (DeclNamed + tag + payload)

   Per-tag helper decomposition (§2 of bootstrap-compiler-workarounds.md):
   Tags 4, 9, 10, 13 extracted into lower_tag_call / lower_tag_block /
   lower_tag_if / lower_tag_for to keep per-function expression depth low.
   forall/exists (SML lowerQuant): guarded handle_to_str + shape match, inlined. */

fn lower_tag_call(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                   ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
                   tok_tags: Vec<i32>,
                   idx: i32, ctr: Vec<i32>,
                   out_instrs: Vec<i32>,
                   enum_names: Vec<i32>,
                   enum_tag_offsets: Vec<i32>,
                   enum_tag_counts: Vec<i32>,
                   enum_tags_flat: Vec<i32>,
                   fn_ctx: Vec<i32>,
                   builtin_map: Vec<i32>, lit_sf_names: Vec<i32>,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                    item_field_counts: Vec<i32>,
                    enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                    match_env_inherit: Vec<i32>, import_aliases: Vec<i32>) -> Value {
    let callee_idx: i32 = vec_get(ed1, idx);
    let args_first: i32 = vec_get(ed2, idx);
    let args_count: i32 = vec_get(ed3, idx);
    /* d4 = pp sidecar of arg-root indices (args are non-contiguous). 0 => no
       sidecar (special desugared calls / hand-built tests) => legacy args_first + k. */
    let args_sidecar: i32 = vec_get(ed4, idx);
    let ct_pre: i32 = vec_get(et, callee_idx);
    if ct_pre == 1 {
        let cpps_pre: i32 = vec_get(ed1, callee_idx);
        let cppc_pre: i32 = vec_get(ed2, callee_idx);
        if cppc_pre == 1 {
            let name_h_pre: i32 = vec_get(pp, cpps_pre);
            if name_h_pre >= 0 && name_h_pre < vec_len(starts)
                && name_h_pre < vec_len(ends) {
                let callee_nm_pre: string = handle_to_str(name_h_pre,
                                                           source, starts, ends);
                let mut qwant_pre: i32 = 0;
                if string_eq(callee_nm_pre, "forall") { qwant_pre = 1; }
                if string_eq(callee_nm_pre, "exists") { qwant_pre = 2; }
                if qwant_pre >= 1 && args_count == 3 {
                    let arg_iter_pre: i32 = args_first;
                    let arg_rng_pre: i32 = args_first + 1;
                    let arg_body_pre: i32 = args_first + 2;
                    if vec_get(et, arg_iter_pre) == 1 && vec_get(ed2, arg_iter_pre) == 1 && vec_get(et, arg_rng_pre) == 21 {
                        let lo_ix_pre: i32 = vec_get(ed1, arg_rng_pre);
                        let hi_ix_pre: i32 = vec_get(ed2, arg_rng_pre);
                        let iter_tok_pre: i32 = vec_get(pp, vec_get(ed1, arg_iter_pre));
                        let hi_t_q: i32 = ctr_fresh(ctr);
                        let cnt_t_q: i32 = ctr_fresh(ctr);
                        let acc_t_q: i32 = ctr_fresh(ctr);
                        let v_hi_q: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                            tok_tags, hi_ix_pre, ctr, out_instrs,
                                            enum_names, enum_tag_offsets,
                                            enum_tag_counts, enum_tags_flat,
                                            fn_ctx, builtin_map, lit_sf_names,
                                            source, starts, ends, item_tags,
                                            item_names, item_d2, item_d3, item_d4,
                                            item_field_counts, enum_vnames_flat, enum_max_payloads,
                                            item_fn_row, match_env_inherit,
                                            import_aliases);
                        let e_hi_q: Expr = value_to_expr(v_hi_q);
                        let a_hi_q: Instr = Instr::Assign(hi_t_q, box_new(e_hi_q));
                        vec_push(out_instrs, box_new(a_hi_q));
                        let v_lo_q: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                            tok_tags, lo_ix_pre, ctr, out_instrs,
                                            enum_names, enum_tag_offsets,
                                            enum_tag_counts, enum_tags_flat,
                                            fn_ctx, builtin_map, lit_sf_names,
                                            source, starts, ends, item_tags,
                                            item_names, item_d2, item_d3, item_d4,
                                            item_field_counts, enum_vnames_flat, enum_max_payloads,
                                            item_fn_row, match_env_inherit,
                                            import_aliases);
                        let e_lo_q: Expr = value_to_expr(v_lo_q);
                        let a_lo_q: Instr = Instr::Assign(cnt_t_q, box_new(e_lo_q));
                        vec_push(out_instrs, box_new(a_lo_q));
                        if qwant_pre == 1 {
                            let ia_q: Instr = Instr::Assign(acc_t_q,
                                box_new(Expr::Literal(
                                    box_new(Value::VBoolTrue))));
                            vec_push(out_instrs, box_new(ia_q));
                        } else {
                            let ia2_q: Instr = Instr::Assign(acc_t_q,
                                box_new(Expr::Literal(
                                    box_new(Value::VBoolFalse))));
                            vec_push(out_instrs, box_new(ia2_q));
                        }
                        let cond_e_q: Expr = Expr::Binop(7,
                            box_new(Value::VVar(cnt_t_q)),
                            box_new(Value::VVar(hi_t_q)));
                        let p_t_q: i32 = ctr_fresh(ctr);
                        let mut inner_q: Vec<i32> = vec_new();
                        let it_q: Instr = Instr::Assign(iter_tok_pre,
                            box_new(Expr::Load(cnt_t_q)));
                        vec_push(inner_q, box_new(it_q));
                        let ep_q: Expr = lower_expr_with_instrs(et, ed1, ed2, ed3, ed4, pp,
                            tok_tags, arg_body_pre, ctr, inner_q,
                            enum_names, enum_tag_offsets,
                            enum_tag_counts, enum_tags_flat,
                            fn_ctx, builtin_map, lit_sf_names,
                            source, starts, ends, item_tags,
                            item_names, item_d2, item_d3, item_d4,
                            item_field_counts, enum_vnames_flat, enum_max_payloads,
                            item_fn_row, match_env_inherit,
                            import_aliases);
                        let dv_q: Instr = Instr::DeclVar(p_t_q);
                        vec_push(inner_q, box_new(dv_q));
                        let st_q: Instr = Instr::Store(p_t_q, box_new(ep_q));
                        vec_push(inner_q, box_new(st_q));
                        let mut else_q: Vec<i32> = vec_new();
                        if qwant_pre == 1 {
                            let cond_pf_q: Expr = Expr::Binop(5,
                                box_new(Value::VVar(p_t_q)),
                                box_new(Value::VInt(0)));
                            let mut then_q: Vec<i32> = vec_new();
                            let stf_q: Instr = Instr::Store(acc_t_q,
                                box_new(Expr::Literal(
                                    box_new(Value::VBoolFalse))));
                            vec_push(then_q, box_new(stf_q));
                            vec_push(then_q, box_new(Instr::Break));
                            let if_q: Instr = Instr::IfElse(box_new(cond_pf_q),
                                then_q, else_q);
                            vec_push(inner_q, box_new(if_q));
                        } else {
                            let cond_pe_q: Expr = Expr::Binop(6,
                                box_new(Value::VVar(p_t_q)),
                                box_new(Value::VInt(0)));
                            let mut then_e: Vec<i32> = vec_new();
                            let ste_q: Instr = Instr::Store(acc_t_q,
                                box_new(Expr::Literal(
                                    box_new(Value::VBoolTrue))));
                            vec_push(then_e, box_new(ste_q));
                            vec_push(then_e, box_new(Instr::Break));
                            let if_e: Instr = Instr::IfElse(box_new(cond_pe_q),
                                then_e, else_q);
                            vec_push(inner_q, box_new(if_e));
                        }
                        let one_q: Value = Value::VInt(1);
                        let incr_eq: Expr = Expr::Binop(0,
                            box_new(Value::VVar(cnt_t_q)),
                            box_new(one_q));
                        let incr_iq: Instr = Instr::Store(cnt_t_q, box_new(incr_eq));
                        vec_push(inner_q, box_new(incr_iq));
                        let wl_q: Instr = Instr::WhileLoop(box_new(cond_e_q),
                            inner_q);
                        vec_push(out_instrs, box_new(wl_q));
                        return Value::VVar(acc_t_q);
                    }
                }
            }
        }
    }
    /* Enum-ctor call as an EXPRESSION (`Enum::Variant(args)`): SML
       lowerExprToValue declares the enum result temp FIRST — `[DeclNamed(en,t)] @
       enumConstructInstrs t …` — and freshTmp's it before lowering the args, so
       the enum's slots precede any temp an arg spills (e.g. `return
       Err(some_call())`). Pre-create + declare it here, before the shared arg
       loop, and reuse it in the cppc==2 branch (which otherwise declares it AFTER
       the args, swapping the slots). Only 2-seg-path callees are enum ctors. */
    let mut ec_t: i32 = 0 - 1;
    if vec_get(et, callee_idx) == 1 {
        if vec_get(ed2, callee_idx) == 2 {
            let en_tok_pre: i32 = vec_get(pp, vec_get(ed1, callee_idx));
            ec_t = ctr_fresh(ctr);
            vec_push(out_instrs, box_new(Instr::DeclNamed(en_tok_pre, ec_t)));
        }
    }
    let mut arg_vals: Vec<i32> = vec_new();
    let mut ai: i32 = 0;
    loop {
        if ai >= args_count { break; }
        let a_idx: i32 = block_stmt_index(pp, args_first, args_sidecar, ai);
        let av: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                             tok_tags, a_idx, ctr,
                                             out_instrs, enum_names,
                                             enum_tag_offsets,
                                             enum_tag_counts,
                                             enum_tags_flat, fn_ctx,
                                             builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        vec_push(arg_vals, box_new(av));
        ai = ai + 1;
    }
    let ct: i32 = vec_get(et, callee_idx);
    if ct == 1 {
        let cpps: i32 = vec_get(ed1, callee_idx);
        let cppc: i32 = vec_get(ed2, callee_idx);
        if cppc == 1 {
            let callee_tok: i32 = vec_get(pp, cpps);
            let t: i32 = ctr_fresh(ctr);
            let mut bid: i32 = 0;
            if callee_tok >= 0 {
                if callee_tok < vec_len(builtin_map) {
                    bid = vec_get(builtin_map, callee_tok);
                }
            }
            if bid == 0 {
                /* A void-returning user fn (no `-> T`, or explicit `-> ()`) must
                   lower to a void Call with dst=0, like the builtin void path
                   below -- never `int _sv0tN = f(...)` (C rejects init from void). */
                if lower_callee_is_void(et, ed1, ed2, pp, idx,
                        item_tags, item_names, item_d2, tok_tags,
                        source, starts, ends) {
                    /* SML lowerExprForEffect assigns even a void call's (unit) value
                       to a fresh temp, so its VM emit reserves a slot per void-call
                       statement. The C backend can't (`int t = voidf()` is invalid),
                       so gate on lower_vm_target(): dst=temp for the VM, dst=0 for C. */
                    let mut vdst: i32 = 0;
                    if lower_vm_target() == 1 { vdst = ctr_fresh(ctr); }
                    let void_call_instr: Instr = Instr::Call(vdst, callee_tok, arg_vals, 0);
                    vec_push(out_instrs, box_new(void_call_instr));
                    return Value::VUnit;
                }
                /* Type the result temp by the callee's return type: string ->
                   const char* sentinel; a user struct/enum -> its type name token
                   (else the int temp collides with the typed value downstream). */
                let mut rt_u: i32 = 0;
                if lower_call_ret_is_string(et, ed1, ed2, pp, idx,
                        item_tags, item_names, item_d2, tok_tags,
                        source, starts, ends) {
                    rt_u = lower_string_cty();
                } else {
                    let uty_c: i32 = lower_call_ret_user_ty_tok(et, ed1, ed2, pp,
                        idx, item_tags, item_names, item_d2, tok_tags,
                        source, starts, ends);
                    if uty_c >= 0 {
                        rt_u = uty_c;
                    }
                }
                let call_instr: Instr = Instr::Call(t, callee_tok, arg_vals, rt_u);
                vec_push(out_instrs, box_new(call_instr));
                return Value::VVar(t);
            }
            if bid == 14 {
                if args_count >= 1 {
                    let na_val: Value = box_deref(vec_get(arg_vals, 0));
                    return na_val;
                }
                return Value::VUnit;
            }
            let mut is_void: i32 = 0;
            if bid == 1 { is_void = 1; }
            if bid == 8 { is_void = 1; }
            if bid == 11 { is_void = 1; }
            if bid == 16 { is_void = 1; }
            if bid == 18 { is_void = 1; }
            let fn_sentinel: i32 = 0 - bid;
            if is_void == 1 {
                let vc: Instr = Instr::Call(0, fn_sentinel, arg_vals, 0);
                vec_push(out_instrs, box_new(vc));
                return Value::VUnit;
            }
            let bc: Instr = Instr::Call(t, fn_sentinel, arg_vals, 0);
            vec_push(out_instrs, box_new(bc));
            return Value::VVar(t);
        }
        if cppc == 2 {
            let en_tok: i32 = vec_get(pp, cpps);
            let vn_tok: i32 = vec_get(pp, cpps + 1);
            let k: i32 = enum_tag_lookup_str(enum_names, enum_tags_flat,
                                          enum_tag_offsets,
                                          enum_tag_counts,
                                          en_tok, vn_tok, source, starts, ends);
            /* t was pre-created + DeclNamed before the arg loop (SML declares the
               enum temp first). */
            let t: i32 = ec_t;
            let tag_e: Expr = Expr::Literal(box_new(Value::VInt(k)));
            let sf_tag: Instr = Instr::StoreField(t, 0 - 1,
                                                   box_new(tag_e));
            vec_push(out_instrs, box_new(sf_tag));
            let mut pi: i32 = 0;
            loop {
                if pi >= args_count { break; }
                let pv: Value = box_deref(vec_get(arg_vals, pi));
                let pe: Expr = value_to_expr(pv);
                let field_sentinel: i32 = 0 - 10 - pi;
                let sf_p: Instr = Instr::StoreField(t, field_sentinel,
                                                     box_new(pe));
                vec_push(out_instrs, box_new(sf_p));
                pi = pi + 1;
            }
            return Value::VVar(t);
        }
    }
    return Value::VUnit;
}

/* Resolve the arena index of block statement `si`. Statement nodes are not
   contiguous; parse_block records an ordered index list in pp with its offset
   (+1) in the block's d4 (parser.sv0 block_stmt_sidecar_push). d4 == 0 → no
   sidecar (hand-built test arenas) → legacy stmts_first + si fallback. */
fn block_stmt_index(pp: Vec<i32>, stmts_first: i32, sidecar: i32, si: i32) -> i32 {
    if sidecar > 0 {
        return vec_get(pp, sidecar - 1 + si);
    }
    return stmts_first + si;
}

fn lower_tag_block(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                    ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
                    tok_tags: Vec<i32>,
                    idx: i32, ctr: Vec<i32>,
                    out_instrs: Vec<i32>,
                    enum_names: Vec<i32>,
                    enum_tag_offsets: Vec<i32>,
                    enum_tag_counts: Vec<i32>,
                    enum_tags_flat: Vec<i32>,
                    fn_ctx: Vec<i32>,
                    builtin_map: Vec<i32>, lit_sf_names: Vec<i32>,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                    item_field_counts: Vec<i32>,
                    enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                    match_env_inherit: Vec<i32>, import_aliases: Vec<i32>,
                    for_effect: i32, into_dest: i32) -> Value {
    let stmts_first: i32 = vec_get(ed1, idx);
    let stmts_count: i32 = vec_get(ed2, idx);
    let tail_idx: i32 = vec_get(ed3, idx);
    let sidecar: i32 = vec_get(ed4, idx);
    let mut si: i32 = 0;
    loop {
        if si >= stmts_count { break; }
        let s_idx: i32 = block_stmt_index(pp, stmts_first, sidecar, si);
        let s_tag: i32 = vec_get(et, s_idx);
        if s_tag == 27 {
            let name_tok: i32 = vec_get(ed1, s_idx);
            let init_idx: i32 = vec_get(ed3, s_idx);
            /* A `let` whose init is a struct literal (ExprStruct, tag 24) binds a
               struct value: declare it with the struct's type (DeclNamed) so the
               C variable is the struct type, not int. The struct typename is the
               last path segment of the literal (same as the tag-24 lowering). The
               let's own type annotation is not retained by the parser, so the init
               shape is the type source here. */
            let mut let_declared: i32 = 0;
            let mut init_handled: i32 = 0;
            /* Deferral for lets whose init spills a temp (SML declares the var
               AFTER lowering the init, so the spilled temp gets the earlier slot).
               deferred_ty holds the C type token (string sentinel -7, or a struct
               token); has_deferred_decl marks that the DeclNamed is emitted below,
               after the init — not up front. Mirrors lower_stmt's fn-body path. */
            let mut deferred_ty: i32 = 0 - 1;
            let mut has_deferred_decl: i32 = 0;
            if init_idx >= 0 {
                /* Struct-literal / enum-ctor lets CONSTRUCT DIRECTLY into the let
                   var (mirrors lower_stmt's fn-body path), not into a fresh temp
                   that is then copied — the temp copy costs a full struct/enum
                   width of extra locals per let, which nested-block-heavy functions
                   (the forall/exists desugar in lower_tag_call, the for desugar)
                   pay hundreds of times over. */
                if vec_get(et, init_idx) == 24 {
                    let sppc: i32 = vec_get(ed2, init_idx);
                    let fc_lb: i32 = vec_get(ed3, init_idx);
                    if sppc >= 1 {
                        if fc_lb > 0 {
                            let sty_tok: i32 = vec_get(pp,
                                vec_get(ed1, init_idx) + sppc - 1);
                            vec_push(out_instrs, box_new(Instr::DeclNamed(sty_tok, name_tok)));
                            let_declared = 1;
                            let sf0_lb: i32 = vec_get(ed4, init_idx);
                            let mut fi_lb: i32 = 0;
                            while fi_lb < fc_lb {
                                let ch_lb: i32 = vec_get(lit_sf_names, sf0_lb + fi_lb * 2 + 1);
                                let fv_lb: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                    tok_tags, ch_lb, ctr, out_instrs, enum_names, enum_tag_offsets,
                                    enum_tag_counts, enum_tags_flat, fn_ctx, builtin_map, lit_sf_names,
                                    source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4,
                                    item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
                                let fnm_lb: i32 = vec_get(lit_sf_names, sf0_lb + fi_lb * 2);
                                vec_push(out_instrs, box_new(Instr::StoreField(name_tok, fnm_lb,
                                                            box_new(value_to_expr(fv_lb)))));
                                fi_lb = fi_lb + 1;
                            }
                            init_handled = 1;
                        }
                    }
                }
                if vec_get(et, init_idx) == 1 {
                    if vec_get(ed2, init_idx) == 2 {
                        let ety_tok: i32 = vec_get(pp, vec_get(ed1, init_idx));
                        let vn_tok_lb: i32 = vec_get(pp, vec_get(ed1, init_idx) + 1);
                        vec_push(out_instrs, box_new(Instr::DeclNamed(ety_tok, name_tok)));
                        let k_lb: i32 = enum_tag_lookup_str(enum_names, enum_tags_flat,
                                                            enum_tag_offsets, enum_tag_counts,
                                                            ety_tok, vn_tok_lb, source, starts, ends);
                        let tag_elb: Expr = Expr::Literal(box_new(Value::VInt(k_lb)));
                        vec_push(out_instrs, box_new(Instr::StoreField(name_tok, 0 - 1, box_new(tag_elb))));
                        let_declared = 1;
                        init_handled = 1;
                    }
                }
                if vec_get(et, init_idx) == 4 {
                    let callee_cb: i32 = vec_get(ed1, init_idx);
                    if vec_get(et, callee_cb) == 1 {
                        if vec_get(ed2, callee_cb) == 2 {
                            let en_tok_lb: i32 = vec_get(pp, vec_get(ed1, callee_cb));
                            let vnc_lb: i32 = vec_get(pp, vec_get(ed1, callee_cb) + 1);
                            vec_push(out_instrs, box_new(Instr::DeclNamed(en_tok_lb, name_tok)));
                            let kc_lb: i32 = enum_tag_lookup_str(enum_names, enum_tags_flat,
                                                                enum_tag_offsets, enum_tag_counts,
                                                                en_tok_lb, vnc_lb, source, starts, ends);
                            let af_lb: i32 = vec_get(ed2, init_idx);
                            let ac_lb: i32 = vec_get(ed3, init_idx);
                            let asc_lb: i32 = vec_get(ed4, init_idx);
                            let mut avals_lb: Vec<i32> = vec_new();
                            let mut aic_lb: i32 = 0;
                            while aic_lb < ac_lb {
                                let aidx_lb: i32 = block_stmt_index(pp, af_lb, asc_lb, aic_lb);
                                let avc_lb: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                    tok_tags, aidx_lb, ctr, out_instrs, enum_names, enum_tag_offsets,
                                    enum_tag_counts, enum_tags_flat, fn_ctx, builtin_map, lit_sf_names,
                                    source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4,
                                    item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
                                vec_push(avals_lb, box_new(avc_lb));
                                aic_lb = aic_lb + 1;
                            }
                            let tagc_lb: Expr = Expr::Literal(box_new(Value::VInt(kc_lb)));
                            vec_push(out_instrs, box_new(Instr::StoreField(name_tok, 0 - 1, box_new(tagc_lb))));
                            let mut pic_lb: i32 = 0;
                            while pic_lb < ac_lb {
                                let pvc_lb: Value = box_deref(vec_get(avals_lb, pic_lb));
                                let fsc_lb: i32 = 0 - 10 - pic_lb;
                                vec_push(out_instrs, box_new(Instr::StoreField(name_tok, fsc_lb,
                                                            box_new(value_to_expr(pvc_lb)))));
                                pic_lb = pic_lb + 1;
                            }
                            let_declared = 1;
                            init_handled = 1;
                        }
                    }
                }
                /* String-typed let (literal / string builtin / block or if-expr
                   whose value is a string). */
                if lower_expr_yields_string(et, ed1, ed2, ed3, pp, init_idx, item_tags, item_names, item_d2, tok_tags, source, starts, ends) {
                    /* Defer the DeclNamed to after the init (SML declares a string
                       local after lowering its init, so a string-returning call's
                       result temp gets the earlier slot). */
                    deferred_ty = lower_string_cty();
                    has_deferred_decl = 1;
                    let_declared = 1;
                }
                /* String-returning user-function call init: same const char* decl. */
                if let_declared == 0 {
                    if lower_call_ret_is_string(et, ed1, ed2, pp, init_idx,
                            item_tags, item_names, item_d2, tok_tags,
                            source, starts, ends) {
                        let decl_scb: Instr = Instr::DeclNamed(lower_string_cty(), name_tok);
                        vec_push(out_instrs, box_new(decl_scb));
                        let_declared = 1;
                    }
                }
                /* `let x = str_param` aliasing a string-typed parameter. */
                if let_declared == 0 {
                    if lower_init_ident_is_string_param(et, ed1, ed2, pp, init_idx,
                            item_tags, item_names, item_d3, tok_tags,
                            source, starts, ends, item_fn_row) {
                        let decl_spb: Instr = Instr::DeclNamed(lower_string_cty(), name_tok);
                        vec_push(out_instrs, box_new(decl_spb));
                        let_declared = 1;
                    }
                }
                /* `let x = f(..)` where f returns a user struct/enum: DEFER the
                   DeclNamed to after the init (SML lowerStmt lowers the call temp
                   first, so x's slot follows it). Emitting DeclNamed(x) up front
                   here gave x the lower slot and swapped it with the call-result
                   temp — the fn-body path (lower_stmt) already defers via
                   deferred_ty/has_deferred_decl; this mirrors it for nested blocks. */
                if let_declared == 0 {
                    let uty_lb: i32 = lower_call_ret_user_ty_tok(et, ed1, ed2, pp,
                        init_idx, item_tags, item_names, item_d2, tok_tags,
                        source, starts, ends);
                    if uty_lb >= 0 {
                        deferred_ty = uty_lb;
                        has_deferred_decl = 1;
                        let_declared = 1;
                    }
                }
                /* `let q: Point = p.m(..)` where method m returns a user
                   struct/enum: same deferred DeclNamed as the tag-4 call path
                   (methods lower to free fns, so the return-type scan matches). */
                if let_declared == 0 {
                    let mty_lb: i32 = lower_mcall_ret_user_ty_tok(et, ed2,
                        init_idx, item_tags, item_names, item_d2, tok_tags,
                        source, starts, ends);
                    if mty_lb >= 0 {
                        deferred_ty = mty_lb;
                        has_deferred_decl = 1;
                        let_declared = 1;
                    }
                }
                /* `let x: T = box_deref(bv)` with T a user struct/enum. */
                if let_declared == 0 {
                    let bdb: i32 = lower_typed_box_deref_let(et, ed1, ed2, ed3, ed4,
                        pp, tok_tags, init_idx, name_tok, vec_get(ed2, s_idx), ctr,
                        out_instrs, enum_names, enum_tag_offsets, enum_tag_counts,
                        enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source,
                        starts, ends, item_tags, item_names, item_d2, item_d3, item_d4,
                        item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row,
                        match_env_inherit, import_aliases);
                    if bdb == 1 {
                        let_declared = 1;
                        init_handled = 1;
                    }
                }
                /* `let x: <i64/u64/u32/f32/f64/...> = <anything not already
                   special-cased above>;` — use the explicit annotation's own
                   C type instead of falling through to a bare DeclVar (a
                   plain "int"). i32/bool/no-annotation lets are deliberately
                   excluded (is_wide_primitive_ty_name) and keep using the
                   existing DeclVar path unchanged — that default is already
                   correct for them. BUGS.md #7, sv0-mathlib. */
                if let_declared == 0 {
                    let ann_tok_lb: i32 = vec_get(ed2, s_idx);
                    if ann_tok_lb >= 0 {
                        if lower_tok_in_bounds(ann_tok_lb, starts, ends) {
                            let ann_name_lb: string = handle_to_str(ann_tok_lb, source, starts, ends);
                            if is_wide_primitive_ty_name(ann_name_lb) {
                                deferred_ty = ann_tok_lb;
                                has_deferred_decl = 1;
                            }
                        }
                    }
                }
            }
            /* SML lowerStmt StmtLet (general case): `instrs @ [Store(x, rhs)]` —
               the initializer is lowered FIRST, then the let variable is declared.
               So x's VM slot is allocated AFTER any temps the init spilled (e.g.
               the result temps of `let y = if c { a } else { b }`), not before.
               Declaring x up front (as we did) gave it the lower slot and diverged
               the bytecode. The DeclVar is only skipped when a struct/enum/string
               special case already emitted a DeclNamed (let_declared == 1). */
            if init_idx >= 0 {
                if init_handled == 0 {
                    /* Lower the init via lower_expr_with_instrs (SML lowerStmt
                       StmtLet: `instrs @ [Store(x, rhs)]`) so a top-level binop
                       becomes Store(x, Binop) directly — lower_expr_to_value would
                       spill the binop to a temp and then copy it into x (an extra
                       slot + load/store). Matches lower_stmt's fn-body let path. */
                    let e: Expr = lower_expr_with_instrs(et, ed1, ed2, ed3, ed4,
                                                         pp, tok_tags, init_idx,
                                                         ctr, out_instrs,
                                                         enum_names,
                                                         enum_tag_offsets,
                                                         enum_tag_counts,
                                                         enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
                    if has_deferred_decl == 1 {
                        vec_push(out_instrs, box_new(Instr::DeclNamed(deferred_ty, name_tok)));
                    } else {
                        if let_declared == 0 {
                            vec_push(out_instrs, box_new(Instr::DeclVar(name_tok)));
                        }
                    }
                    let asgn: Instr = Instr::Store(name_tok, box_new(e));
                    vec_push(out_instrs, box_new(asgn));
                }
            } else {
                if let_declared == 0 {
                    vec_push(out_instrs, box_new(Instr::DeclVar(name_tok)));
                }
            }
        }
        if s_tag == 28 {
            let semi_idx: i32 = vec_get(ed1, s_idx);
            /* A bare expression statement is lowered FOR EFFECT (SML lowerStmt
               StmtSemi → lowerExprForEffect), so an `if c {…} else {…}` statement
               emits IfElse with effect branches, not the value path's result temps.
               lower_for_effect routes ExprReturn to lower_return and everything
               else to the value form, matching the old discard behaviour. */
            let de1: i32 = lower_for_effect(et, ed1, ed2, ed3, ed4, pp,
                                            tok_tags, semi_idx, ctr, out_instrs,
                                            enum_names, enum_tag_offsets, enum_tag_counts,
                                            enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        }
        si = si + 1;
    }
    if into_dest >= 0 {
        /* Into-var context (SML lowerIntoVarInstrs ExprBlock): lower the tail INTO
           the dest var; a block with no tail stores VUnit (`NONE => [Store(t,
           VUnit)]`). Used for match arm bodies. */
        if tail_idx >= 0 {
            lower_into_var_instrs(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                  tail_idx, into_dest, ctr, out_instrs,
                                  enum_names, enum_tag_offsets,
                                  enum_tag_counts, enum_tags_flat,
                                  fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        } else {
            vec_push(out_instrs, box_new(Instr::Store(into_dest,
                box_new(Expr::Literal(box_new(Value::VUnit))))));
        }
        return Value::VUnit;
    }
    if tail_idx >= 0 {
        if for_effect == 1 {
            /* Effect context (block value discarded, e.g. a loop body): lower the
               tail FOR EFFECT so a tail `if c {…} else {…}` emits IfElse with
               effect branches, not the value path's dead result temps (SML
               lowerExprForEffect ExprBlock: `is @ lowerExprForEffect e2`). */
            lower_for_effect(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                             tail_idx, ctr, out_instrs,
                             enum_names, enum_tag_offsets,
                             enum_tag_counts, enum_tags_flat,
                             fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
            return Value::VUnit;
        }
        return lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                    tail_idx, ctr, out_instrs,
                                    enum_names, enum_tag_offsets,
                                    enum_tag_counts, enum_tags_flat,
                                    fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    }
    return Value::VUnit;
}

fn lower_tag_if(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                 ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
                 tok_tags: Vec<i32>,
                 idx: i32, ctr: Vec<i32>,
                 out_instrs: Vec<i32>,
                 enum_names: Vec<i32>,
                 enum_tag_offsets: Vec<i32>,
                 enum_tag_counts: Vec<i32>,
                 enum_tags_flat: Vec<i32>,
                 fn_ctx: Vec<i32>,
                 builtin_map: Vec<i32>, lit_sf_names: Vec<i32>,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                    item_field_counts: Vec<i32>,
                    enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                    match_env_inherit: Vec<i32>, import_aliases: Vec<i32>) -> Value {
    let cond_idx: i32 = vec_get(ed1, idx);
    let then_idx: i32 = vec_get(ed2, idx);
    let else_idx: i32 = vec_get(ed3, idx);
    /* SML IfElse lowers the condition via lowerExprWithInstrs — a top-level binop
       is kept as Ir.Binop directly (JUMP_IF_NOT tests it inline), NOT spilled to a
       temp. lower_cond_expr does exactly that (writing any operand sub-instrs to
       out_instrs, empty for a simple `x > 3`), matching the while-loop condition. */
    let cond_expr: Expr = lower_cond_expr(et, ed1, ed2, ed3, ed4, pp,
                                         tok_tags, cond_idx, ctr,
                                         out_instrs, enum_names,
                                         enum_tag_offsets, enum_tag_counts,
                                         enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    if else_idx >= 0 {
        let t: i32 = ctr_fresh(ctr);
        let u: i32 = ctr_fresh(ctr);
        let mut then_instrs: Vec<i32> = vec_new();
        let vt: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                             tok_tags, then_idx, ctr,
                                             then_instrs, enum_names,
                                             enum_tag_offsets,
                                             enum_tag_counts,
                                             enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let t_lit: Expr = Expr::Literal(box_new(vt));
        let t_store: Instr = Instr::Store(u, box_new(t_lit));
        vec_push(then_instrs, box_new(t_store));
        let mut else_instrs: Vec<i32> = vec_new();
        let ve: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                             tok_tags, else_idx, ctr,
                                             else_instrs, enum_names,
                                             enum_tag_offsets,
                                             enum_tag_counts,
                                             enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let e_lit: Expr = Expr::Literal(box_new(ve));
        let e_store: Instr = Instr::Store(u, box_new(e_lit));
        vec_push(else_instrs, box_new(e_store));
        /* Type the result temps: if the branches yield strings, declare them
           const char* (via the string sentinel) so `if c { "a" } else { "b" }`
           and any downstream string op typecheck; else plain int. */
        let mut if_is_str: i32 = 0;
        if lower_expr_yields_string(et, ed1, ed2, ed3, pp, then_idx,
                item_tags, item_names, item_d2, tok_tags, source, starts, ends) {
            if_is_str = 1;
        }
        if lower_expr_yields_string(et, ed1, ed2, ed3, pp, else_idx,
                item_tags, item_names, item_d2, tok_tags, source, starts, ends) {
            if_is_str = 1;
        }
        if if_is_str == 1 {
            vec_push(out_instrs, box_new(Instr::DeclNamed(lower_string_cty(), t)));
            vec_push(out_instrs, box_new(Instr::DeclNamed(lower_string_cty(), u)));
        } else {
            vec_push(out_instrs, box_new(Instr::DeclVar(t)));
            vec_push(out_instrs, box_new(Instr::DeclVar(u)));
        }
        let if_instr: Instr = Instr::IfElse(box_new(cond_expr),
                                              then_instrs, else_instrs);
        vec_push(out_instrs, box_new(if_instr));
        let load_u: Expr = Expr::Load(u);
        let final_store: Instr = Instr::Store(t, box_new(load_u));
        vec_push(out_instrs, box_new(final_store));
        return Value::VVar(t);
    }
    let mut then_only: Vec<i32> = vec_new();
    let discard2: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                               tok_tags, then_idx, ctr,
                                               then_only, enum_names,
                                               enum_tag_offsets,
                                               enum_tag_counts,
                                               enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    let mut no_else: Vec<i32> = vec_new();
    let if_no_el: Instr = Instr::IfElse(box_new(cond_expr),
                                          then_only, no_else);
    vec_push(out_instrs, box_new(if_no_el));
    return Value::VUnit;
}

fn lower_tag_for(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                  ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
                  tok_tags: Vec<i32>,
                  idx: i32, ctr: Vec<i32>,
                  out_instrs: Vec<i32>,
                  enum_names: Vec<i32>,
                  enum_tag_offsets: Vec<i32>,
                  enum_tag_counts: Vec<i32>,
                  enum_tags_flat: Vec<i32>,
                  fn_ctx: Vec<i32>,
                  builtin_map: Vec<i32>, lit_sf_names: Vec<i32>,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                    item_field_counts: Vec<i32>,
                    enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                    match_env_inherit: Vec<i32>, import_aliases: Vec<i32>) -> Value {
    let pat_tok: i32 = vec_get(ed1, idx);
    let range_idx: i32 = vec_get(ed2, idx);
    let for_body: i32 = vec_get(ed3, idx);
    let range_tag: i32 = vec_get(et, range_idx);
    if range_tag == 21 {
        let lo_idx: i32 = vec_get(ed1, range_idx);
        let hi_idx: i32 = vec_get(ed2, range_idx);
        let hi_t: i32 = ctr_fresh(ctr);
        let i_t: i32 = ctr_fresh(ctr);
        let v_hi: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4,
                                               pp, tok_tags, hi_idx,
                                               ctr, out_instrs,
                                               enum_names,
                                               enum_tag_offsets,
                                               enum_tag_counts,
                                               enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let e_hi: Expr = value_to_expr(v_hi);
        let assign_hi: Instr = Instr::Assign(hi_t, box_new(e_hi));
        vec_push(out_instrs, box_new(assign_hi));
        let v_lo: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4,
                                               pp, tok_tags, lo_idx,
                                               ctr, out_instrs,
                                               enum_names,
                                               enum_tag_offsets,
                                               enum_tag_counts,
                                               enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let e_lo: Expr = value_to_expr(v_lo);
        let assign_it: Instr = Instr::Assign(i_t, box_new(e_lo));
        vec_push(out_instrs, box_new(assign_it));
        let cond_e: Expr = Expr::Binop(7, box_new(Value::VVar(i_t)),
                                        box_new(Value::VVar(hi_t)));
        let assign_x: Instr = Instr::Assign(pat_tok,
                                              box_new(Expr::Load(i_t)));
        let one_v: Value = Value::VInt(1);
        let incr_e: Expr = Expr::Binop(0, box_new(Value::VVar(i_t)),
                                         box_new(one_v));
        let incr_i: Instr = Instr::Store(i_t, box_new(incr_e));
        let mut loop_body: Vec<i32> = vec_new();
        vec_push(loop_body, box_new(assign_x));
        vec_push(loop_body, box_new(incr_i));
        let discard_for: i32 = lower_for_effect(et, ed1, ed2, ed3,
                                                      ed4, pp, tok_tags,
                                                      for_body, ctr,
                                                      loop_body,
                                                      enum_names,
                                                      enum_tag_offsets,
                                                      enum_tag_counts,
                                                      enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let wl: Instr = Instr::WhileLoop(box_new(cond_e), loop_body);
        vec_push(out_instrs, box_new(wl));
    }
    return Value::VUnit;
}

/* ── lower_tag_try (ExprTry, tag 22) ──────────────────────────
   Handles the `?` operator: evaluate inner expression, check the
   tag field against the failure variant, propagate on failure,
   extract payload on success.  Uses a simplified type-inference
   heuristic (no scrut locals / param types). */

fn lower_tag_try(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                  ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
                  tok_tags: Vec<i32>,
                  idx: i32, ctr: Vec<i32>,
                  out_instrs: Vec<i32>,
                  enum_names: Vec<i32>,
                  enum_tag_offsets: Vec<i32>,
                  enum_tag_counts: Vec<i32>,
                  enum_tags_flat: Vec<i32>,
                  fn_ctx: Vec<i32>,
                  builtin_map: Vec<i32>, lit_sf_names: Vec<i32>,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                    item_field_counts: Vec<i32>,
                    enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                    match_env_inherit: Vec<i32>, import_aliases: Vec<i32>) -> Value {
    let inner: i32 = vec_get(ed1, idx);
    let fc_len: i32 = vec_len(fn_ctx);
    let mut fn_count: i32 = 0;
    if fc_len > 0 {
        fn_count = vec_get(fn_ctx, 0);
    }
    let inner_tag: i32 = vec_get(et, inner);
    let mut enum_name: i32 = 0 - 1;
    if inner_tag == 4 {
        let callee_idx: i32 = vec_get(ed1, inner);
        let callee_tag: i32 = vec_get(et, callee_idx);
        if callee_tag == 1 {
            let cpps: i32 = vec_get(ed1, callee_idx);
            let cppc: i32 = vec_get(ed2, callee_idx);
            if cppc == 1 {
                let callee_tok: i32 = vec_get(pp, cpps);
                let mut fi: i32 = 0;
                loop {
                    if fi >= fn_count { break; }
                    let fn_name_h: i32 = vec_get(fn_ctx, 1 + fi);
                    /* BH-11a: compare by NAME TEXT — the callee's use token differs
                       from the fn's decl token stored in fn_ctx. */
                    if lower_tok_str_eq(source, starts, ends, fn_name_h, callee_tok) {
                        enum_name = vec_get(fn_ctx, 1 + fn_count + fi);
                    }
                    fi = fi + 1;
                }
            }
            if cppc == 2 {
                let cpps2: i32 = vec_get(ed1, callee_idx);
                enum_name = vec_get(pp, cpps2);
            }
        }
    }
    if inner_tag == 1 {
        let pps: i32 = vec_get(ed1, inner);
        let ppc: i32 = vec_get(ed2, inner);
        if ppc == 2 {
            enum_name = vec_get(pp, pps);
        }
        if ppc == 1 {
            /* BH-11a: a bare-variable operand (`o?`) — its enum is the one the
               ENCLOSING fn returns (`?` propagates the same enum). Look up the
               current fn (item_fn_row) in fn_ctx to get its return enum token. */
            if item_fn_row >= 0 {
                if item_fn_row < vec_len(item_names) {
                    let cur_fn_tok: i32 = vec_get(item_names, item_fn_row);
                    let mut fj: i32 = 0;
                    while fj < fn_count {
                        if vec_get(fn_ctx, 1 + fj) == cur_fn_tok {
                            enum_name = vec_get(fn_ctx, 1 + fn_count + fj);
                        }
                        fj = fj + 1;
                    }
                }
            }
        }
    }
    if enum_name < 0 { return Value::VUnit; }
    let failK: i32 = 1;
    let inner_v: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                              tok_tags, inner, ctr,
                                              out_instrs, enum_names,
                                              enum_tag_offsets,
                                              enum_tag_counts,
                                              enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    let u: i32 = ctr_fresh(ctr);
    let decl_u: Instr = Instr::DeclNamed(enum_name, u);
    vec_push(out_instrs, box_new(decl_u));
    let inner_e: Expr = value_to_expr(inner_v);
    let store_u: Instr = Instr::Store(u, box_new(inner_e));
    vec_push(out_instrs, box_new(store_u));
    let out_t: i32 = ctr_fresh(ctr);
    let decl_out: Instr = Instr::DeclVar(out_t);
    vec_push(out_instrs, box_new(decl_out));
    let tag_member: Value = Value::VMember(box_new(Value::VVar(u)),
                                            0 - 1);
    let fail_v: Value = Value::VInt(failK);
    let cond_e: Expr = Expr::Binop(11, box_new(tag_member),
                                     box_new(fail_v));
    let mut then_is: Vec<i32> = vec_new();
    let ret_fail: Instr = Instr::ReturnVal(box_new(Value::VVar(u)));
    vec_push(then_is, box_new(ret_fail));
    let mut else_is: Vec<i32> = vec_new();
    let p0_access: Value = Value::VVar(u);
    let p0_e: Expr = Expr::FieldAccess(box_new(p0_access), 0 - 10);
    let store_out: Instr = Instr::Store(out_t, box_new(p0_e));
    vec_push(else_is, box_new(store_out));
    let if_instr: Instr = Instr::IfElse(box_new(cond_e),
                                          then_is, else_is);
    vec_push(out_instrs, box_new(if_instr));
    return Value::VVar(out_t);
}

/* Lower an expression to (instrs, Expr) WITHOUT hoisting the top-level operator
   into a temp — the operand-computing instructions go into `cond_is`, and the
   returned Expr is the top-level Binop/Unop referencing the operand values (or,
   for anything else, value_to_expr of the lowered value). Mirrors SML
   lowerExprWithInstrs. Used for loop conditions, which must re-evaluate each
   iteration: lower_expr_to_value would emit `Assign(t, i < len)` once before the
   loop and leave `while (t)` checking a frozen temp (infinite loop / OOB). */
fn lower_cond_expr(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                   ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
                   tok_tags: Vec<i32>, idx: i32, ctr: Vec<i32>,
                   cond_is: Vec<i32>,
                   enum_names: Vec<i32>, enum_tag_offsets: Vec<i32>,
                   enum_tag_counts: Vec<i32>, enum_tags_flat: Vec<i32>,
                   fn_ctx: Vec<i32>, builtin_map: Vec<i32>, lit_sf_names: Vec<i32>,
                   source: string, starts: Vec<i32>, ends: Vec<i32>,
                   item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>,
                   item_d3: Vec<i32>, item_d4: Vec<i32>, item_field_counts: Vec<i32>,
                   enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                   match_env_inherit: Vec<i32>, import_aliases: Vec<i32>) -> Expr {
    let ctag: i32 = vec_get(et, idx);
    if ctag == 3 {
        let op: i32 = vec_get(ed1, idx);
        let lhs_i: i32 = vec_get(ed2, idx);
        let rhs_i: i32 = vec_get(ed3, idx);
        let vl: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp, tok_tags,
            lhs_i, ctr, cond_is, enum_names, enum_tag_offsets, enum_tag_counts,
            enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends,
            item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts,
            enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let vr: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp, tok_tags,
            rhs_i, ctr, cond_is, enum_names, enum_tag_offsets, enum_tag_counts,
            enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends,
            item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts,
            enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        return Expr::Binop(op, box_new(vl), box_new(vr));
    }
    /* Plain unary (! ~ -, tags 0/1/2); borrow/cast (4/5/99) are not loop
       conditions, so fall through to the general value form for those. */
    if ctag == 2 {
        let uop: i32 = vec_get(ed1, idx);
        if uop < 3 {
            let operand_i: i32 = vec_get(ed2, idx);
            let uv: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                operand_i, ctr, cond_is, enum_names, enum_tag_offsets, enum_tag_counts,
                enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends,
                item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts,
                enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
            return Expr::Unop(uop, box_new(uv));
        }
    }
    let gv: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp, tok_tags,
        idx, ctr, cond_is, enum_names, enum_tag_offsets, enum_tag_counts,
        enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends,
        item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts,
        enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    return value_to_expr(gv);
}

fn lower_expr_to_value(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                        ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
                        tok_tags: Vec<i32>,
                        idx: i32, ctr: Vec<i32>,
                        out_instrs: Vec<i32>,
                        enum_names: Vec<i32>,
                        enum_tag_offsets: Vec<i32>,
                        enum_tag_counts: Vec<i32>,
                        enum_tags_flat: Vec<i32>,
                        fn_ctx: Vec<i32>,
                        builtin_map: Vec<i32>,
                        lit_sf_names: Vec<i32>,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                    item_field_counts: Vec<i32>,
                    enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                    match_env_inherit: Vec<i32>, import_aliases: Vec<i32>) -> Value {
    let tag: i32 = vec_get(et, idx);
    if tag == 0 {
        let lit_tag: i32 = vec_get(ed1, idx);
        let tok_pos: i32 = vec_get(ed2, idx);
        return lower_lit_to_ir_value(lit_tag, tok_pos, tok_tags, source, starts, ends);
    }
    if tag == 1 {
        let pps: i32 = vec_get(ed1, idx);
        let ppc: i32 = vec_get(ed2, idx);
        if ppc == 1 {
            let name_tok: i32 = vec_get(pp, pps);
            return Value::VVar(name_tok);
        }
        if ppc == 2 {
            let en_tok: i32 = vec_get(pp, pps);
            let vn_tok: i32 = vec_get(pp, pps + 1);
            let k: i32 = enum_tag_lookup_str(enum_names, enum_tags_flat,
                                          enum_tag_offsets, enum_tag_counts,
                                          en_tok, vn_tok, source, starts, ends);
            let t: i32 = ctr_fresh(ctr);
            let decl: Instr = Instr::DeclNamed(en_tok, t);
            vec_push(out_instrs, box_new(decl));
            let tag_e: Expr = Expr::Literal(box_new(Value::VInt(k)));
            let sf_tag: Instr = Instr::StoreField(t, 0 - 1, box_new(tag_e));
            vec_push(out_instrs, box_new(sf_tag));
            return Value::VVar(t);
        }
        return Value::VUnit;
    }
    if tag == 2 {
        let unop_tag: i32 = vec_get(ed1, idx);
        let operand_idx: i32 = vec_get(ed2, idx);
        if unop_tag == 4 {
            let ot: i32 = vec_get(et, operand_idx);
            if ot == 1 {
                let opps: i32 = vec_get(ed1, operand_idx);
                let oppc: i32 = vec_get(ed2, operand_idx);
                if oppc == 1 {
                    return Value::VAddrOf(vec_get(pp, opps));
                }
            }
        }
        if unop_tag == 5 {
            let ot2: i32 = vec_get(et, operand_idx);
            if ot2 == 1 {
                let opps2: i32 = vec_get(ed1, operand_idx);
                let oppc2: i32 = vec_get(ed2, operand_idx);
                if oppc2 == 1 {
                    return Value::VAddrOf(vec_get(pp, opps2));
                }
            }
        }
        let v: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                            tok_tags, operand_idx, ctr,
                                            out_instrs, enum_names,
                                            enum_tag_offsets, enum_tag_counts,
                                            enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let t: i32 = ctr_fresh(ctr);
        let expr: Expr = Expr::Unop(unop_tag, box_new(v));
        let instr: Instr = Instr::Assign(t, box_new(expr));
        vec_push(out_instrs, box_new(instr));
        return Value::VVar(t);
    }
    if tag == 3 {
        let binop_tag: i32 = vec_get(ed1, idx);
        let lhs_idx: i32 = vec_get(ed2, idx);
        let rhs_idx: i32 = vec_get(ed3, idx);
        let vl: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                             tok_tags, lhs_idx, ctr,
                                             out_instrs, enum_names,
                                             enum_tag_offsets, enum_tag_counts,
                                             enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let vr: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                             tok_tags, rhs_idx, ctr,
                                             out_instrs, enum_names,
                                             enum_tag_offsets, enum_tag_counts,
                                             enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let t: i32 = ctr_fresh(ctr);
        let expr: Expr = Expr::Binop(binop_tag, box_new(vl), box_new(vr));
        let instr: Instr = Instr::Assign(t, box_new(expr));
        vec_push(out_instrs, box_new(instr));
        return Value::VVar(t);
    }
    if tag == 4 {
        return lower_tag_call(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                               idx, ctr, out_instrs, enum_names,
                               enum_tag_offsets, enum_tag_counts,
                               enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    }
    if tag == 6 {
        let obj_idx: i32 = vec_get(ed1, idx);
        let field_tok: i32 = vec_get(ed2, idx);
        let v1: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                             tok_tags, obj_idx, ctr,
                                             out_instrs, enum_names,
                                             enum_tag_offsets, enum_tag_counts,
                                             enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        return Value::VMember(box_new(v1), field_tok);
    }
    /* ExprTupleField: obj.N — encode tuple projection as VMember with a
       synthetic field handle. Was `500 + field_num`, decoded by
       megatu_field_name as "any fh in [500,600) is a tuple field" — a
       REAL, positive source token index, not a reserved sentinel space,
       so any file with 500+ tokens before a genuine struct field access
       (`obj.fieldname`, tag 6 above, which uses the field's own raw
       token position as fh with NO offset) could collide: a real field
       token landing at index 500-599 was silently misread as a tuple
       projection index instead, emitting the wrong C field name
       (`fN` instead of the real name) — not a rare edge case, any
       moderately-sized multi-function file reaches token 500. Found via
       sv0-mathlib's R0.2 trig work (a struct literal in a file large
       enough to push a real field-name token past 500). Fixed by moving
       to a NEGATIVE sentinel range instead — real token indices are
       always >= 0, so this is unconditionally collision-free. `-10-i`
       (the existing enum payload-slot sentinel) was too close a
       neighbor to reuse directly — a large-enough enum's payload count
       could still reach it — so this uses `-2000000-field_num` instead,
       the same "far enough that no realistic count could ever reach it"
       margin `lower_temp_base` (below) already uses on the positive
       side for temp handles, just mirrored onto the negative axis. */
    if tag == 7 {
        let obj_idx7: i32 = vec_get(ed1, idx);
        let field_num: i32 = vec_get(ed2, idx);
        let vobj: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                               tok_tags, obj_idx7, ctr,
                                               out_instrs, enum_names,
                                               enum_tag_offsets,
                                               enum_tag_counts,
                                               enum_tags_flat, fn_ctx,
                                               builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let fh: i32 = (0 - 2000000) - field_num;
        return Value::VMember(box_new(vobj), fh);
    }
    /* ExprMethodCall (tag 5): `rcv.method(args…)` — same IR as a direct
       call with the receiver prepended: `method(rcv, args…)` (token
       position in ed2 matches `builtin_map` / codegen name resolution,
       same as ExprPath callee positions in `pp`). */
    if tag == 5 {
        let rcv_mc: i32 = vec_get(ed1, idx);
        let method_tok: i32 = vec_get(ed2, idx);
        let args_count_mc: i32 = vec_get(ed3, idx);
        let args_sidecar_mc: i32 = vec_get(ed4, idx);
        let v_rcv: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                                tok_tags, rcv_mc, ctr,
                                                out_instrs, enum_names,
                                                enum_tag_offsets,
                                                enum_tag_counts,
                                                enum_tags_flat, fn_ctx,
                                                builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let mut arg_vals_mc: Vec<i32> = vec_new();
        vec_push(arg_vals_mc, box_new(v_rcv));
        let mut aj_mc: i32 = 0;
        loop {
            if aj_mc >= args_count_mc { break; }
            let ax_mc: i32 = block_stmt_index(pp, 0, args_sidecar_mc, aj_mc);
            let av_mc: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                                   tok_tags, ax_mc, ctr,
                                                   out_instrs, enum_names,
                                                   enum_tag_offsets,
                                                   enum_tag_counts,
                                                   enum_tags_flat, fn_ctx,
                                                   builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
            vec_push(arg_vals_mc, box_new(av_mc));
            aj_mc = aj_mc + 1;
        }
        let t_mc: i32 = ctr_fresh(ctr);
        let mut bid_mc: i32 = 0;
        if method_tok >= 0 {
            if method_tok < vec_len(builtin_map) {
                bid_mc = vec_get(builtin_map, method_tok);
            }
        }
        if bid_mc == 0 {
            /* Type the result temp by the method's return type: a user
               struct/enum -> its type-name token, so `let q: Point =
               p.scaled(2)` declares `Point _sv0tN` not `int`. */
            let mut rt_mc: i32 = 0;
            let uty_mc: i32 = lower_mcall_ret_user_ty_tok(et, ed2, idx,
                item_tags, item_names, item_d2, tok_tags, source, starts, ends);
            if uty_mc >= 0 {
                rt_mc = uty_mc;
            }
            let call_mc: Instr = Instr::Call(t_mc, method_tok, arg_vals_mc, rt_mc);
            vec_push(out_instrs, box_new(call_mc));
            return Value::VVar(t_mc);
        }
        if bid_mc == 14 {
            if vec_len(arg_vals_mc) >= 2 {
                let na_mv: Value = box_deref(vec_get(arg_vals_mc, 1));
                return na_mv;
            }
            return Value::VUnit;
        }
        let mut is_void_mc: i32 = 0;
        if bid_mc == 1 { is_void_mc = 1; }
        if bid_mc == 8 { is_void_mc = 1; }
        if bid_mc == 11 { is_void_mc = 1; }
        let fn_sent_mc: i32 = 0 - bid_mc;
        if is_void_mc == 1 {
            let vc_mc: Instr = Instr::Call(0, fn_sent_mc, arg_vals_mc, 0);
            vec_push(out_instrs, box_new(vc_mc));
            return Value::VUnit;
        }
        let bc_mc: Instr = Instr::Call(t_mc, fn_sent_mc, arg_vals_mc, 0);
        vec_push(out_instrs, box_new(bc_mc));
        return Value::VVar(t_mc);
    }
    /* ExprIndex (tag 8): obj[index] — Vec element load via sv0_vec_get
       (CALL_BUILTIN 10), matching ExprCall(vec_get, ...) lowering. */
    if tag == 8 {
        let ob: i32 = vec_get(ed1, idx);
        let ix: i32 = vec_get(ed2, idx);
        let v_o: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                             tok_tags, ob, ctr,
                                             out_instrs, enum_names,
                                             enum_tag_offsets,
                                             enum_tag_counts,
                                             enum_tags_flat, fn_ctx,
                                             builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let v_i: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                             tok_tags, ix, ctr,
                                             out_instrs, enum_names,
                                             enum_tag_offsets,
                                             enum_tag_counts,
                                             enum_tags_flat, fn_ctx,
                                             builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let t_ix: i32 = ctr_fresh(ctr);
        let mut arg_ix: Vec<i32> = vec_new();
        vec_push(arg_ix, box_new(v_o));
        vec_push(arg_ix, box_new(v_i));
        let vec_get_fn_h: i32 = 0 - 10;
        let call_ix: Instr = Instr::Call(t_ix, vec_get_fn_h, arg_ix, 0);
        vec_push(out_instrs, box_new(call_ix));
        return Value::VVar(t_ix);
