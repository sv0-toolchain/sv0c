fn test_match_scrut_cty() -> i32 {
    let me: Vec<i32> = lower_match_env_alloc_v0_empty_header();
    let et: Vec<i32> = vec_new();
    let ed1: Vec<i32> = vec_new();
    let ed2: Vec<i32> = vec_new();
    let ed3: Vec<i32> = vec_new();
    let ed4: Vec<i32> = vec_new();
    let pp: Vec<i32> = vec_new();
    let al: Vec<i32> = vec_new();
    let sn: Vec<i32> = vec_new();
    let sc: Vec<i32> = vec_new();
    vec_push(pp, 42);
    vec_push(pp, 99);
    vec_push(et, 1);
    vec_push(ed1, 0);
    vec_push(ed2, 2);
    vec_push(ed3, 0);
    vec_push(ed4, 0);
    let r1: i32 = match_scrut_cty(et, ed1, ed2, ed3, ed4, 0,
                       pp, me, al, sn, sc, 0);
    if r1 != 42 { return 1; }
    vec_push(et, 1);
    vec_push(ed1, 0);
    vec_push(ed2, 1);
    vec_push(ed3, 0);
    vec_push(ed4, 0);
    vec_push(sn, 42);
    vec_push(sc, 77);
    let r2: i32 = match_scrut_cty(et, ed1, ed2, ed3, ed4, 1,
                       pp, me, al, sn, sc, 1);
    if r2 != 77 { return 2; }
    let r3: i32 = match_scrut_cty(et, ed1, ed2, ed3, ed4, 0 - 1,
                       pp, me, al, sn, sc, 0);
    if r3 != 0 - 1 { return 3; }
    vec_push(et, 0);
    vec_push(ed1, 0);
    vec_push(ed2, 0);
    vec_push(ed3, 0);
    vec_push(ed4, 0);
    let r4: i32 = match_scrut_cty(et, ed1, ed2, ed3, ed4, 2,
                       pp, me, al, sn, sc, 0);
    if r4 != 0 - 1 { return 4; }
    vec_push(et, 4);
    vec_push(ed1, 1);
    vec_push(ed2, 0);
    vec_push(ed3, 0);
    vec_push(ed4, 0);
    let bfn: i32 = vec_len(me);
    vec_push(me, 42);
    let brt: i32 = vec_len(me);
    vec_push(me, 200);
    vec_set(me, 2, bfn);
    vec_set(me, 3, brt);
    vec_set(me, 4, 1);
    let r5: i32 = match_scrut_cty(et, ed1, ed2, ed3, ed4, 3,
                       pp, me, al, sn, sc, 0);
    if r5 != 200 { return 5; }
    let me2: Vec<i32> = lower_match_env_alloc_v0_empty_header();
    let ap2: i32 = lower_match_env_append_scrut_pair(me2, 42, 200);
    if ap2 != 0 { return 6; }
    let r6: i32 = match_scrut_cty(et, ed1, ed2, ed3, ed4, 1,
                       pp, me2, al, sn, sc, 0);
    if r6 != 200 { return 7; }
    return 0;
}

