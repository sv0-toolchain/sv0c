    vec_push(id1, 3);
    vec_push(id2, 0);
    vec_push(id3, 0);
    vec_push(id4, 0);
    vec_push(ifc, 0);
    vec_push(ivm, 0);
    vec_push(it, 1);
    vec_push(id1, 14);
    vec_push(id2, 1);
    vec_push(id3, 0);
    vec_push(id4, 0);
    vec_push(ifc, 1);
    vec_push(ivm, 0);
    vec_push(sfn, 20);
    vec_push(sfnames, 20);
    vec_push(sftypes, 22);
    vec_push(it, 2);
    vec_push(id1, 30);
    vec_push(id2, 2);
    vec_push(id3, 0);
    vec_push(id4, 0);
    vec_push(ifc, 0);
    vec_push(ivm, 0);
    vec_push(evn, 40);
    vec_push(evn, 45);
    let ob: Vec<i32> = vec_new();
    let osn: Vec<i32> = vec_new();
    let oso: Vec<i32> = vec_new();
    let osc: Vec<i32> = vec_new();
    let osf: Vec<i32> = vec_new();
    let oen: Vec<i32> = vec_new();
    let oeto: Vec<i32> = vec_new();
    let oetc: Vec<i32> = vec_new();
    let oetf: Vec<i32> = vec_new();
    let oem: Vec<i32> = vec_new();
    let bet: Vec<i32> = vec_new();
    let be1: Vec<i32> = vec_new();
