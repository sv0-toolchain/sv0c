    if vec_get(oc, 0) != 0 - 1 { return 3; }
    let on2: Vec<i32> = vec_new();
    let oc2: Vec<i32> = vec_new();
    let c2: i32 = scan_lets(et, ed1, ed2, ed3, ed4, 0 - 1,
                      pp, fnn, frc, al, on2, oc2);
    if c2 != 0 { return 4; }
    let c3: i32 = scan_lets(et, ed1, ed2, ed3, ed4, 0,
                      pp, fnn, frc, al, on2, oc2);
    if c3 != 0 { return 5; }
    return 0;
}

