/* Phase 2 real pipeline module: sml/ir/lowering.sml -> sv0.
   Lowering utilities: splitQName, binop/unop → C strings, AST type → C
   type mapping, freshTmp counter + fresh_tmp_str, oldSlot naming,
   retSyntaxIsUnit, storeValueToSlot/assignment LHS classification,
   paramName extraction, uniqOldNames (dedup), enum tag lookup (Vec),
   struct field list lookup, enum/struct type detection, variant slot
   counting, enum max payload, tryVariantNames, literal classification +
   lower_lit_to_ir_tag, fn_ret_cty, value_to_expr_kind, enum_alloc_width,
   import alias management + resolve_fn_callee + resolve_enum_ctor_path,
   param_name, lower_field_index, ast_ty_to_c_string_with_user,
   find_fn_index / callee_fn_index, scrut_local_lookup / param_ty_lookup.
   Typedef builders (batch 34): handle_to_str (token handle → string),
   emit_struct_td / emit_enum_td (SML emitStructTd/emitEnumTd — C typedef
   string generation), build_struct_order (SML buildStructOrder — populate
   struct field order lookup tables), build_enum_variants_data (SML
   buildEnumVariants — populate enum variant tag + max payload tables),
   collect_typedefs_str (SML collectTypedefs — concatenate all struct then
   enum typedef strings from item Vecs).
   Full IR emission (lowerExpr/lowerStmt/lowerFn/lower) deferred —
   needs deep AST traversal with slot/instr accumulation. */

/* ── freshTmp ───────────────────────────────────────────────── */

fn fresh_tmp_name(counter: i32) -> i32 {
    return counter;
}

fn next_tmp(counter: i32) -> i32 {
    return counter + 1;
}

fn lower_digit(d: i32) -> string {
    if d == 0 { return "0"; }
    if d == 1 { return "1"; }
    if d == 2 { return "2"; }
    if d == 3 { return "3"; }
    if d == 4 { return "4"; }
    if d == 5 { return "5"; }
    if d == 6 { return "6"; }
    if d == 7 { return "7"; }
    if d == 8 { return "8"; }
    return "9";
}

fn lower_int_to_str(n: i32) -> string {
    if n < 0 { return string_concat("-", lower_int_to_str(0 - n)); }
    if n < 10 { return lower_digit(n); }
    let rest: string = lower_int_to_str(n / 10);
    let last: string = lower_digit(n - (n / 10) * 10);
    return string_concat(rest, last);
}

fn fresh_tmp_str(counter: i32) -> string {
    return string_concat("_sv0t", lower_int_to_str(counter));
}

/* ── import aliases (SML importAliases : (string*string) list ref) ── */

fn lower_alias_new() -> Vec<i32> {
    return vec_new();
}

fn lower_alias_add(aliases: Vec<i32>, from_h: i32, to_h: i32) -> i32 {
    vec_push(aliases, from_h);
    vec_push(aliases, to_h);
    return vec_len(aliases) / 2;
}

fn lower_alias_lookup(aliases: Vec<i32>, name_h: i32) -> i32 {
    let n: i32 = vec_len(aliases);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(aliases, i) == name_h {
            return vec_get(aliases, i + 1);
        }
        i = i + 2;
    }
    return 0 - 1;
}

fn resolve_fn_callee(aliases: Vec<i32>, name_h: i32) -> i32 {
    let target: i32 = lower_alias_lookup(aliases, name_h);
    if target < 0 { return name_h; }
    return target;
}

fn resolve_enum_ctor_path(ctor_from_enum: Vec<i32>, ctor_from_var: Vec<i32>,
                          ctor_to_enum: Vec<i32>, ctor_to_var: Vec<i32>,
                          enum_h: i32, variant_h: i32) -> i32 {
    let n: i32 = vec_len(ctor_from_enum);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(ctor_from_enum, i) == enum_h {
            if vec_get(ctor_from_var, i) == variant_h {
                return i;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn resolved_ctor_enum(ctor_to_enum: Vec<i32>, idx: i32, default_enum: i32) -> i32 {
    if idx < 0 { return default_enum; }
    return vec_get(ctor_to_enum, idx);
}

fn resolved_ctor_variant(ctor_to_var: Vec<i32>, idx: i32, default_var: i32) -> i32 {
    if idx < 0 { return default_var; }
    return vec_get(ctor_to_var, idx);
}

/* ── splitQName ─────────────────────────────────────────────── */

fn find_double_colon(s: string, start: i32) -> i32 {
    let len: i32 = string_len(s);
    let limit: i32 = len - 1;
    let mut i: i32 = start;
    while i < limit {
        if string_char_at(s, i) == 58 {
            if string_char_at(s, i + 1) == 58 {
                return i;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn split_qname_count(s: string) -> i32 {
    let mut count: i32 = 1;
    let mut pos: i32 = 0;
    let idx: i32 = find_double_colon(s, pos);
    if idx < 0 { return 1; }
    count = count + 1;
    pos = idx + 2;
    let idx2: i32 = find_double_colon(s, pos);
    if idx2 < 0 { return count; }
    count = count + 1;
    pos = idx2 + 2;
    let idx3: i32 = find_double_colon(s, pos);
    if idx3 < 0 { return count; }
    return count + 1;
}

fn has_qualified_name(s: string) -> bool {
    return find_double_colon(s, 0) >= 0;
}

/* ── AST binop → C operator string ──────────────────────────── */

fn ast_binop_to_c(tag: i32) -> string {
    if tag == 0 { return "+"; }
    if tag == 1 { return "-"; }
    if tag == 2 { return "*"; }
    if tag == 3 { return "/"; }
    if tag == 4 { return "%"; }
    if tag == 5 { return "=="; }
    if tag == 6 { return "!="; }
    if tag == 7 { return "<"; }
    if tag == 8 { return ">"; }
    if tag == 9 { return "<="; }
    if tag == 10 { return ">="; }
    if tag == 11 { return "&&"; }
    if tag == 12 { return "||"; }
    if tag == 13 { return "&"; }
    if tag == 14 { return "|"; }
    if tag == 15 { return "^"; }
    if tag == 16 { return "<<"; }
    if tag == 17 { return ">>"; }
    return "+";
}

/* ── AST unop → C operator string ───────────────────────────── */

/* Ast.unop: Neg=0, Not=1, BitNot=2, Deref=3, Borrow=4, BorrowMut=5 */
fn ast_unop_to_c(tag: i32) -> string {
    if tag == 0 { return "-"; }
    if tag == 1 { return "!"; }
    if tag == 2 { return "~"; }
    if tag == 3 { return "*"; }
    if tag == 4 { return "&"; }
    if tag == 5 { return "&"; }
    return "?";
}

fn is_supported_unop(tag: i32) -> bool {
    if tag == 0 { return true; }
    if tag == 1 { return true; }
    if tag == 2 { return true; }
    if tag == 4 { return true; }
    if tag == 5 { return true; }
    return false;
}

/* ── AST type → C type string mapping ───────────────────────── */

fn ast_ty_to_c_string(name: string) -> string {
    if string_eq(name, "unit") { return "void"; }
    if string_eq(name, "i32") { return "int"; }
    if string_eq(name, "bool") { return "int"; }
    if string_eq(name, "i8") { return "int8_t"; }
    if string_eq(name, "u8") { return "uint8_t"; }
    if string_eq(name, "i16") { return "int16_t"; }
    if string_eq(name, "u16") { return "uint16_t"; }
    if string_eq(name, "i64") { return "int64_t"; }
    if string_eq(name, "u64") { return "uint64_t"; }
    if string_eq(name, "isize") { return "intptr_t"; }
    if string_eq(name, "usize") { return "uintptr_t"; }
    if string_eq(name, "string") { return "const char*"; }
    if string_eq(name, "str") { return "const char*"; }
    if string_eq(name, "String") { return "const char*"; }
    if string_eq(name, "Vec") { return "int"; }
    if string_eq(name, "Box") { return "int"; }
    return "int";
}

/* ── ast_ty_to_c_string_with_user (SML astTyToCString struct/enum branch)
   Like ast_ty_to_c_string but if the primitive lookup returns "int"
   (unknown), checks struct and enum name-handle tables.  If the
   handle is a known struct or enum, returns the original name string
   (the caller's C typedef); otherwise falls back to "int".
   SML: `TyName ([n],_,_) => if exists structFieldOrder n then n ...` */
fn ast_ty_to_c_string_with_user(name: string, name_handle: i32,
                                struct_names: Vec<i32>,
                                enum_names: Vec<i32>) -> string {
    let prim: string = ast_ty_to_c_string(name);
    if string_eq(prim, "int") != true { return prim; }
    if is_struct_cty(struct_names, name_handle) { return name; }
    if is_enum_cty(enum_names, name_handle) { return name; }
    return "int";
}

fn is_void_cty(name: string) -> bool {
    if string_eq(name, "void") { return true; }
    if string_eq(name, "unit") { return true; }
    return false;
}

fn ast_ty_is_unit(name: string) -> bool {
    return string_eq(name, "unit");
}

/* ── oldSlot naming ─────────────────────────────────────────── */

fn old_slot_prefix() -> string {
    return "_sv0old_";
}

fn old_slot_name_len(name_len: i32) -> i32 {
    return 8 + name_len;
}

fn old_slot_name(name: string) -> string {
    return string_concat("_sv0old_", name);
}

/* ── paramName ─────────────────────────────────────────────────
   PatBind → name. In sv0, pattern tags: 0=Wild, 1=Bind, ...
   paramName returns the name handle (token index) for a Bind pat,
   or -1 for non-Bind patterns. */

fn param_name_tag(pat_tag: i32) -> bool {
    return pat_tag == 1;
}

/* SML paramName: extracts the name handle from a PatBind parameter.
   Returns the handle if pat_tag == 1 (PatBind), else -1. */
fn param_name(pat_tag: i32, name_handle: i32) -> i32 {
    if pat_tag == 1 { return name_handle; }
    return 0 - 1;
}

/* SML local fieldIndex in matchArmSetup: given a Vec of struct
   field name handles and a target name handle, returns its index
   or -1 if not found. */
fn lower_field_index(field_names: Vec<i32>, target: i32) -> i32 {
    let n: i32 = vec_len(field_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(field_names, i) == target { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── uniqOldNames (dedup) ──────────────────────────────────────
   Given a Vec<i32> of name handles, return how many unique entries
   there are. Also provides a helper to check membership and add
   if not present. */

fn old_name_seen(seen: Vec<i32>, name: i32) -> bool {
    let n: i32 = vec_len(seen);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(seen, i) == name { return true; }
        i = i + 1;
    }
    return false;
}

fn old_names_add_unique(seen: Vec<i32>, name: i32) -> bool {
    if old_name_seen(seen, name) { return false; }
    vec_push(seen, name);
    return true;
}

fn uniq_old_names(names: Vec<i32>) -> Vec<i32> {
    let out: Vec<i32> = vec_new();
    let n: i32 = vec_len(names);
    let mut i: i32 = 0;
    while i < n {
        let name: i32 = vec_get(names, i);
        old_names_add_unique(out, name);
        i = i + 1;
    }
    return out;
}

/* ── retSyntaxIsUnit ────────────────────────────────────────── */

fn ret_syntax_is_unit(has_ret: bool, ret_ty_name: string) -> bool {
    if has_ret == false { return true; }
    if string_eq(ret_ty_name, "unit") { return true; }
    return false;
}

fn use_ret_slot(is_unit: bool, ens_mentions_result: bool) -> bool {
    if is_unit { return false; }
    return ens_mentions_result;
}

fn lower_lit_supported(lit_tag: i32) -> bool {
    return classify_literal(lit_tag) >= 0;
}

/* ── storeValueToSlot classification ────────────────────────── */
/* Class constants: SKIP=0, STORE=1, LOAD=2 */

fn store_value_class(is_var: bool, var_name_eq_slot: bool) -> i32 {
    if is_var {
        if var_name_eq_slot { return 0; }
        return 2;
    }
    return 1;
}

/* ── assignment LHS classification ──────────────────────────── */
/* Class constants: VAR=0, FIELD=1, INVALID=-1 */

fn low_classify_assign_lhs(expr_tag: i32) -> i32 {
    if expr_tag == 2 { return 0; }
    if expr_tag == 11 { return 1; }
    return 0 - 1;
}

/* ── enum/struct lookup helpers ──────────────────────────────── */

fn enum_tag_lookup(enum_names: Vec<i32>, enum_tags_flat: Vec<i32>,
                   enum_tag_offsets: Vec<i32>, enum_tag_counts: Vec<i32>,
                   enum_name: i32, variant_name: i32) -> i32 {
    let n: i32 = vec_len(enum_names);
    let mut ei: i32 = 0;
    while ei < n {
        if vec_get(enum_names, ei) == enum_name {
            let offset: i32 = vec_get(enum_tag_offsets, ei);
            let count: i32 = vec_get(enum_tag_counts, ei);
            let mut vi: i32 = 0;
            while vi < count {
                let flat_idx: i32 = offset + vi * 2;
                if vec_get(enum_tags_flat, flat_idx) == variant_name {
                    return vec_get(enum_tags_flat, flat_idx + 1);
                }
                vi = vi + 1;
            }
            return 0 - 1;
        }
        ei = ei + 1;
    }
    return 0 - 2;
}

fn struct_fields_lookup(struct_names: Vec<i32>, struct_field_offsets: Vec<i32>,
                        struct_field_counts: Vec<i32>, struct_fields_flat: Vec<i32>,
                        name: i32) -> i32 {
    let n: i32 = vec_len(struct_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(struct_names, i) == name {
            return vec_get(struct_field_offsets, i);
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn struct_field_count(struct_names: Vec<i32>, struct_field_counts: Vec<i32>,
                      name: i32) -> i32 {
    let n: i32 = vec_len(struct_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(struct_names, i) == name {
            return vec_get(struct_field_counts, i);
        }
        i = i + 1;
    }
    return 0;
}

fn is_enum_cty(enum_names: Vec<i32>, name: i32) -> bool {
    let n: i32 = vec_len(enum_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(enum_names, i) == name { return true; }
        i = i + 1;
    }
    return false;
}

fn is_struct_cty(struct_names: Vec<i32>, name: i32) -> bool {
    let n: i32 = vec_len(struct_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(struct_names, i) == name { return true; }
        i = i + 1;
    }
    return false;
}

/* ── variant slots ──────────────────────────────────────────── */

fn variant_slot_count(shape_tag: i32, field_count: i32) -> i32 {
    if shape_tag == 0 { return 0; }
    return field_count;
}

/* ── enum max payload ───────────────────────────────────────── */

fn enum_max_payload_lookup(enum_names: Vec<i32>, enum_max_payloads: Vec<i32>,
                           name: i32) -> i32 {
    let n: i32 = vec_len(enum_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(enum_names, i) == name {
            return vec_get(enum_max_payloads, i);
        }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── tryVariantNames (Result/Option) ────────────────────────── */

fn try_variant_success(has_ok: bool, has_some: bool) -> string {
    if has_ok { return "Ok"; }
    if has_some { return "Some"; }
    return "";
}

fn try_variant_failure(has_err: bool, has_none: bool) -> string {
    if has_err { return "Err"; }
    if has_none { return "None"; }
    return "";
}

fn is_try_enum(has_ok: bool, has_err: bool, has_some: bool, has_none: bool) -> bool {
    if has_ok {
        if has_err { return true; }
    }
    if has_some {
        if has_none { return true; }
    }
    return false;
}

/* ── literal lowering classification ────────────────────────── */
/* Tag constants: INT=0, BOOL=1, UNIT=2, STRING=3, UNSUPPORTED=-1 */

fn classify_literal(lit_tag: i32) -> i32 {
    if lit_tag == 0 { return 0; }
    if lit_tag == 1 { return 1; }
    if lit_tag == 2 { return 2; }
    if lit_tag == 3 { return 3; }
    return 0 - 1;
}

fn lower_lit_to_ir_tag(lit_tag: i32) -> i32 {
    if lit_tag == 0 { return 0; }
    if lit_tag == 1 { return 1; }
    if lit_tag == 2 { return 4; }
    if lit_tag == 3 { return 5; }
    return 0 - 1;
}

fn fn_ret_cty(has_ret: bool, ret_cty: string) -> string {
    if has_ret { return ret_cty; }
    return "int";
}

/* ── value → expr classification ────────────────────────────── */
/* Class constants: VAR=0, OTHER=1 */

fn value_to_expr_kind(val_tag: i32) -> i32 {
    if val_tag == 0 { return 0; }
    return 1;
}

/* ── enum store payload helpers ─────────────────────────────── */

fn payload_field_name(index: i32) -> i32 {
    return index;
}

fn enum_store_payload_count(val_count: i32) -> i32 {
    return val_count;
}

/* ── enum width (1 + maxPayload) ────────────────────────────── */

fn enum_alloc_width(max_payload: i32) -> i32 {
    return 1 + max_payload;
}

/* ── retValueSlot constant ──────────────────────────────────── */

fn ret_value_slot() -> string {
    return "_sv0ret";
}

/* ── find_fn_index (SML calleeRetCty helper — index into fn table) */

fn find_fn_index(fn_names: Vec<i32>, name_h: i32) -> i32 {
    let n: i32 = vec_len(fn_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(fn_names, i) == name_h { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── callee_fn_index (SML calleeRetCty — resolve alias + find) */

fn callee_fn_index(fn_names: Vec<i32>, aliases: Vec<i32>,
                   name_h: i32) -> i32 {
    let resolved: i32 = resolve_fn_callee(aliases, name_h);
    return find_fn_index(fn_names, resolved);
}

/* ── scrut_local_lookup / param_ty_lookup ──────────────────── */

fn scrut_local_lookup(scrut_names: Vec<i32>, name_h: i32) -> i32 {
    let n: i32 = vec_len(scrut_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(scrut_names, i) == name_h { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn param_ty_lookup(param_names: Vec<i32>, name_h: i32) -> i32 {
    let n: i32 = vec_len(param_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(param_names, i) == name_h { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── handle_to_str (token handle → string) ──────────────────── */

fn handle_to_str(h: i32, source: string,
                 starts: Vec<i32>, ends: Vec<i32>) -> string {
    let s: i32 = vec_get(starts, h);
    let e: i32 = vec_get(ends, h);
    return string_substr(source, s, e - s);
}

/* ── emit_struct_td (SML emitStructTd) ──────────────────────── */

fn emit_struct_td(name_h: i32,
                  fnames: Vec<i32>, ftypes: Vec<i32>,
                  foff: i32, fcount: i32,
                  source: string, starts: Vec<i32>, ends: Vec<i32>,
                  sn: Vec<i32>, en: Vec<i32>) -> string {
    let name: string = handle_to_str(name_h, source, starts, ends);
    let mut r: string = "typedef struct {\n";
    let mut i: i32 = 0;
    while i < fcount {
        let th: i32 = vec_get(ftypes, foff + i);
        let tname: string = handle_to_str(th, source, starts, ends);
        let cty: string = ast_ty_to_c_string_with_user(tname, th, sn, en);
        let fname: string = handle_to_str(vec_get(fnames, foff + i), source, starts, ends);
        r = string_concat(r, "  ");
        r = string_concat(r, cty);
        r = string_concat(r, " ");
        r = string_concat(r, fname);
        r = string_concat(r, ";\n");
        i = i + 1;
    }
    r = string_concat(r, "} ");
    r = string_concat(r, name);
    r = string_concat(r, ";\n");
    return r;
}

/* ── emit_enum_td (SML emitEnumTd) ──────────────────────────── */

fn emit_enum_td(name_h: i32, max_payload: i32,
                source: string, starts: Vec<i32>, ends: Vec<i32>) -> string {
    let name: string = handle_to_str(name_h, source, starts, ends);
    let mut r: string = "typedef struct {\n  int tag;\n";
    let mut i: i32 = 0;
    while i < max_payload {
        r = string_concat(r, "  int p");
        r = string_concat(r, lower_int_to_str(i));
        r = string_concat(r, ";\n");
        i = i + 1;
    }
    r = string_concat(r, "} ");
    r = string_concat(r, name);
    r = string_concat(r, ";\n");
    return r;
}

/* ── build_struct_order (SML buildStructOrder) ──────────────── */

fn build_struct_order(item_tags: Vec<i32>, item_names: Vec<i32>,
                      item_field_counts: Vec<i32>,
                      struct_fnames_flat: Vec<i32>,
                      out_names: Vec<i32>,
                      out_offsets: Vec<i32>,
                      out_counts: Vec<i32>,
                      out_flat: Vec<i32>) -> i32 {
    let n: i32 = vec_len(item_tags);
    let mut i: i32 = 0;
    let mut sf: i32 = 0;
    while i < n {
        let tag: i32 = vec_get(item_tags, i);
        let fc: i32 = vec_get(item_field_counts, i);
        if tag == 1 {
            vec_push(out_names, vec_get(item_names, i));
            vec_push(out_offsets, vec_len(out_flat));
            vec_push(out_counts, fc);
            let mut j: i32 = 0;
            while j < fc {
                vec_push(out_flat, vec_get(struct_fnames_flat, sf + j));
                j = j + 1;
            }
            sf = sf + fc;
        }
        i = i + 1;
    }
    return vec_len(out_names);
}

/* ── build_enum_variants_data (SML buildEnumVariants) ────────── */

fn build_enum_variants_data(item_tags: Vec<i32>, item_names: Vec<i32>,
                            item_field_counts: Vec<i32>,
                            item_vmax: Vec<i32>,
                            enum_vnames_flat: Vec<i32>,
                            out_names: Vec<i32>,
                            out_tag_offsets: Vec<i32>,
                            out_tag_counts: Vec<i32>,
                            out_tags_flat: Vec<i32>,
                            out_max_payloads: Vec<i32>) -> i32 {
    let n: i32 = vec_len(item_tags);
    let mut i: i32 = 0;
    let mut ev: i32 = 0;
    while i < n {
        let tag: i32 = vec_get(item_tags, i);
        let vc: i32 = vec_get(item_field_counts, i);
        if tag == 2 {
            vec_push(out_names, vec_get(item_names, i));
            vec_push(out_tag_offsets, vec_len(out_tags_flat));
            vec_push(out_tag_counts, vc);
            vec_push(out_max_payloads, vec_get(item_vmax, i));
            let mut j: i32 = 0;
            while j < vc {
                vec_push(out_tags_flat, vec_get(enum_vnames_flat, ev + j));
                vec_push(out_tags_flat, j);
                j = j + 1;
            }
            ev = ev + vc;
        }
        i = i + 1;
    }
    return vec_len(out_names);
}

/* ── collect_typedefs_str (SML collectTypedefs) ──────────────── */

fn collect_typedefs_str(item_tags: Vec<i32>, item_names: Vec<i32>,
                        item_field_counts: Vec<i32>,
                        item_vmax: Vec<i32>,
                        sf_names: Vec<i32>, sf_types: Vec<i32>,
                        source: string, starts: Vec<i32>, ends: Vec<i32>,
                        sn: Vec<i32>, en: Vec<i32>) -> string {
    let n: i32 = vec_len(item_tags);
    let mut r: string = "";
    let mut i: i32 = 0;
    let mut sf: i32 = 0;
    while i < n {
        let tag: i32 = vec_get(item_tags, i);
        let fc: i32 = vec_get(item_field_counts, i);
        if tag == 1 {
            let td: string = emit_struct_td(vec_get(item_names, i),
                                             sf_names, sf_types,
                                             sf, fc,
                                             source, starts, ends,
                                             sn, en);
            r = string_concat(r, td);
            sf = sf + fc;
        }
        i = i + 1;
    }
    i = 0;
    while i < n {
        if vec_get(item_tags, i) == 2 {
            let td2: string = emit_enum_td(vec_get(item_names, i),
                                            vec_get(item_vmax, i),
                                            source, starts, ends);
            r = string_concat(r, td2);
        }
        i = i + 1;
    }
    return r;
}

