fn test_ir_types() -> i32 {
    let vi: Value = Value::VInt(42);
    if ir_value_tag(vi) != 0 { return 1; }
    let vb: Value = Value::VBoolTrue;
    if ir_value_tag(vb) != 1 { return 2; }
    let vf: Value = Value::VBoolFalse;
    if ir_value_tag(vf) != 2 { return 3; }
    let vv: Value = Value::VVar(10);
    if ir_value_tag(vv) != 3 { return 4; }
    let vu: Value = Value::VUnit;
    if ir_value_tag(vu) != 4 { return 5; }
    let vs: Value = Value::VString(7);
    if ir_value_tag(vs) != 5 { return 6; }
    let base: Value = Value::VVar(3);
    let vm: Value = Value::VMember(box_new(base), 5);
    if ir_value_tag(vm) != 6 { return 7; }
    let va: Value = Value::VAddrOf(9);
    if ir_value_tag(va) != 7 { return 8; }
    let el: Expr = Expr::Literal(box_new(Value::VInt(5)));
    if ir_expr_tag(el) != 0 { return 9; }
    let eld: Expr = Expr::Load(50);
    if ir_expr_tag(eld) != 1 { return 10; }
    let eb: Expr = Expr::Binop(20, box_new(Value::VInt(3)), box_new(Value::VInt(4)));
    if ir_expr_tag(eb) != 2 { return 11; }
    let eu: Expr = Expr::Unop(1, box_new(Value::VBoolTrue));
    if ir_expr_tag(eu) != 3 { return 12; }
    let ef: Expr = Expr::FieldAccess(box_new(Value::VVar(60)), 61);
    if ir_expr_tag(ef) != 4 { return 13; }
    let i_nop: Instr = Instr::Nop;
    if ir_instr_tag(i_nop) != 0 { return 14; }
    let i_dv: Instr = Instr::DeclVar(50);
    if ir_instr_tag(i_dv) != 1 { return 15; }
    let i_brk: Instr = Instr::Break;
    if ir_instr_tag(i_brk) != 9 { return 16; }
    let i_cont: Instr = Instr::Continue;
    if ir_instr_tag(i_cont) != 10 { return 17; }
    let i_rv: Instr = Instr::ReturnVoid;
    if ir_instr_tag(i_rv) != 14 { return 18; }
    let i_ret: Instr = Instr::ReturnVal(box_new(Value::VInt(0)));
    if ir_instr_tag(i_ret) != 15 { return 19; }
    let asgn_e: Expr = Expr::Load(70);
    let i_asgn: Instr = Instr::Assign(71, box_new(asgn_e));
    if ir_instr_tag(i_asgn) != 3 { return 20; }
    return 0;
}

fn test_ctr_fresh() -> i32 {
    let mut ctr: Vec<i32> = vec_new();
    vec_push(ctr, 0);
    let t0: i32 = ctr_fresh(ctr);
    if t0 != 0 { return 1; }
    let t1: i32 = ctr_fresh(ctr);
    if t1 != 1 { return 2; }
    let t2: i32 = ctr_fresh(ctr);
    if t2 != 2 { return 3; }
    if vec_get(ctr, 0) != 3 { return 4; }
    return 0;
}

fn test_classify_arena() -> i32 {
    let mut et: Vec<i32> = vec_new();
    let mut ed1: Vec<i32> = vec_new();
    let mut ed2: Vec<i32> = vec_new();
    let mut pp: Vec<i32> = vec_new();
    vec_push(pp, 42);
    vec_push(et, 1);
    vec_push(ed1, 0);
    vec_push(ed2, 1);
    let out1: Vec<i32> = vec_new();
    let r1: i32 = classify_assign_lhs_arena(et, ed1, ed2, pp, 0, out1);
    if r1 != 0 { return 1; }
    if vec_len(out1) != 1 { return 2; }
    if vec_get(out1, 0) != 42 { return 3; }
    vec_push(et, 6);
    vec_push(ed1, 0);
    vec_push(ed2, 99);
    let out2: Vec<i32> = vec_new();
    let r2: i32 = classify_assign_lhs_arena(et, ed1, ed2, pp, 1, out2);
    if r2 != 1 { return 4; }
    if vec_len(out2) != 2 { return 5; }
    if vec_get(out2, 0) != 42 { return 6; }
    if vec_get(out2, 1) != 99 { return 7; }
    vec_push(et, 3);
    vec_push(ed1, 0);
    vec_push(ed2, 0);
    let out3: Vec<i32> = vec_new();
    let r3: i32 = classify_assign_lhs_arena(et, ed1, ed2, pp, 2, out3);
    if r3 != 0 - 1 { return 8; }
    return 0;
}

fn test_parse_decimal_i32_from_tok() -> i32 {
    let src: string = "let x = 12045;";
    let mut st: Vec<i32> = vec_new();
    let mut en: Vec<i32> = vec_new();
    vec_push(st, 8);
    vec_push(en, 13);
    let v: i32 = parse_decimal_i32_from_tok(src, st, en, 0);
    if v != 12045 { return 1; }
    let v2: i32 = parse_decimal_i32_from_tok(src, st, en, 1);
    if v2 != 0 { return 2; }
    let v3: i32 = parse_decimal_i32_from_tok(src, st, en, 0 - 1);
    if v3 != 0 { return 3; }
    return 0;
}

