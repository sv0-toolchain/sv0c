    if resolved_ctor_variant(tv, idx, 20) != 40 { return 3; }
    let miss: i32 = resolve_enum_ctor_path(fe, fv, te, tv, 99, 88);
    if miss != 0 - 1 { return 4; }
    if resolved_ctor_enum(te, miss, 99) != 99 { return 5; }
    if resolved_ctor_variant(tv, miss, 88) != 88 { return 6; }
    return 0;
}

