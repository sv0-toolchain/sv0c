       `lower_tag_call` sentinels). */
    if tag == 26 {
        let elem_count_ar: i32 = vec_get(ed2, idx);
        let t_ar: i32 = ctr_fresh(ctr);
        let mut args_new: Vec<i32> = vec_new();
        let bid_new: i32 = 7;
        let fn_new: i32 = 0 - bid_new;
        let ins_new: Instr = Instr::Call(t_ar, fn_new, args_new, 0);
        vec_push(out_instrs, box_new(ins_new));
        let mut ak_ar: i32 = 0;
        loop {
            if ak_ar >= elem_count_ar { break; }
            let ek_ar: i32 = idx - elem_count_ar + ak_ar;
            let v_el: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                                  tok_tags, ek_ar, ctr,
                                                  out_instrs, enum_names,
                                                  enum_tag_offsets,
                                                  enum_tag_counts,
                                                  enum_tags_flat, fn_ctx,
                                                  builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
            let mut args_push: Vec<i32> = vec_new();
            vec_push(args_push, box_new(Value::VVar(t_ar)));
            vec_push(args_push, box_new(v_el));
            let bid_push: i32 = 8;
            let fn_push: i32 = 0 - bid_push;
            let ins_push: Instr = Instr::Call(0, fn_push, args_push, 0);
