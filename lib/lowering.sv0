fn test_fill_import_aliases_from_use_items() -> i32 {
    let item_tags: Vec<i32> = vec_new();
    let item_names: Vec<i32> = vec_new();
    let item_d2: Vec<i32> = vec_new();
    let item_d3: Vec<i32> = vec_new();
    let pp: Vec<i32> = vec_new();
    let aliases: Vec<i32> = lower_alias_new();
    let source: string = "mod foo mod__foo";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    /* handles: 0=>"mod", 1=>"foo", 2=>"mod__foo" */
    vec_push(starts, 0); vec_push(ends, 3);
    vec_push(starts, 4); vec_push(ends, 7);
    vec_push(starts, 8); vec_push(ends, 16);
    /* ItemFn name: mod__foo */
    vec_push(item_tags, 0);
    vec_push(item_names, 2);
    vec_push(item_d2, 0);
    vec_push(item_d3, 0);
    /* ItemUse path: mod::foo */
    vec_push(pp, 0);
    vec_push(pp, 1);
    vec_push(item_tags, 5);
    vec_push(item_names, 0);
    vec_push(item_d2, 0);
    vec_push(item_d3, 2);
    let c: i32 = lower_fill_import_aliases_from_use_items(aliases, item_tags,
        item_names, item_d2, item_d3, pp, source, starts, ends);
    if c != 1 { return 1; }
    if lower_alias_lookup(aliases, 1) != 2 { return 2; }
    let c2: i32 = lower_fill_import_aliases_from_use_items(aliases, item_tags,
        item_names, item_d2, item_d3, pp, source, starts, ends);
    if c2 != 1 { return 3; }
    if vec_len(aliases) != 2 { return 4; }
    return 0;
}

