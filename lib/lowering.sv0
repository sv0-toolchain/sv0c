fn test_lower_enum_ctor() -> i32 {
    let mut et: Vec<i32> = vec_new();
    let mut ed1: Vec<i32> = vec_new();
    let mut ed2: Vec<i32> = vec_new();
    let mut ed3: Vec<i32> = vec_new();
    let mut ed4: Vec<i32> = vec_new();
    let mut pp: Vec<i32> = vec_new();
    let mut tok_tags: Vec<i32> = vec_new();
    vec_push(tok_tags, 91);
    let mut ctr: Vec<i32> = vec_new();
    vec_push(ctr, 0);
    let mut out: Vec<i32> = vec_new();
    let en_n: Vec<i32> = vec_new();
    let en_to: Vec<i32> = vec_new();
    let en_tc: Vec<i32> = vec_new();
    let en_tf: Vec<i32> = vec_new();
    let fn_ctx: Vec<i32> = vec_new();
    let builtin_map: Vec<i32> = vec_new();
    let lit_sf_names: Vec<i32> = vec_new();
    /* enum_tag_lookup_str compares by source text, so give the enum/variant tokens
       real spellings: token 0="E", 1="A", 2="B" in "E A B". The ctor is E::A. */
    let source: string = "E A B";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0);
    vec_push(ends, 1);
    vec_push(starts, 2);
    vec_push(ends, 3);
    vec_push(starts, 4);
    vec_push(ends, 5);
    let item_tags: Vec<i32> = vec_new();
    let item_names: Vec<i32> = vec_new();
    let item_d2: Vec<i32> = vec_new();
    let item_d3: Vec<i32> = vec_new();
    let item_d4: Vec<i32> = vec_new();
    let item_fn_row: i32 = 0 - 1;
    let item_field_counts: Vec<i32> = vec_new();
    let enum_vnames_flat: Vec<i32> = vec_new();
    let enum_max_payloads: Vec<i32> = vec_new();
    vec_push(en_n, 0);
    vec_push(en_to, 0);
    vec_push(en_tc, 2);
    vec_push(en_tf, 1);
    vec_push(en_tf, 0);
    vec_push(en_tf, 2);
    vec_push(en_tf, 1);
    vec_push(pp, 0);
    vec_push(pp, 1);
    vec_push(et, 1);
    vec_push(ed1, 0);
    vec_push(ed2, 2);
    vec_push(ed3, 0);
    vec_push(ed4, 0);
    let v1: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                         0, ctr, out, en_n, en_to, en_tc,
                                         en_tf, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, vec_new(), vec_new());
    if ir_value_tag(v1) != 3 { return 1; }
    if vec_len(out) != 2 { return 2; }
    return 0;
}

fn test_lower_try() -> i32 {
    let mut et: Vec<i32> = vec_new();
    let mut ed1: Vec<i32> = vec_new();
    let mut ed2: Vec<i32> = vec_new();
    let mut ed3: Vec<i32> = vec_new();
    let mut ed4: Vec<i32> = vec_new();
    let mut pp: Vec<i32> = vec_new();
    let mut tok_tags: Vec<i32> = vec_new();
    vec_push(tok_tags, 91);
    let mut ctr: Vec<i32> = vec_new();
    vec_push(ctr, 0);
    let mut out: Vec<i32> = vec_new();
    let en_n: Vec<i32> = vec_new();
    let en_to: Vec<i32> = vec_new();
    let en_tc: Vec<i32> = vec_new();
    let en_tf: Vec<i32> = vec_new();
    vec_push(en_n, 500);
    vec_push(en_to, 0);
    vec_push(en_tc, 2);
    vec_push(en_tf, 600);
    vec_push(en_tf, 0);
    vec_push(en_tf, 601);
    vec_push(en_tf, 1);
    vec_push(pp, 0);
    vec_push(pp, 0);
    vec_push(et, 1);
    vec_push(ed1, 0);
    vec_push(ed2, 1);
    vec_push(ed3, 0);
    vec_push(ed4, 0);
    vec_push(et, 4);
    vec_push(ed1, 0);
    vec_push(ed2, 0);
    vec_push(ed3, 0);
    vec_push(ed4, 0);
    vec_push(et, 22);
    vec_push(ed1, 1);
    vec_push(ed2, 0);
    vec_push(ed3, 0);
    vec_push(ed4, 0);
    let mut fn_ctx: Vec<i32> = vec_new();
    let builtin_map: Vec<i32> = vec_new();
    let lit_sf_names: Vec<i32> = vec_new();
    /* BH-11a: token 0 = "f"; fn_ctx now compares callee text, so source/starts/ends
       must back token 0. */
    let source: string = "f";
    let mut starts: Vec<i32> = vec_new();
    let mut ends: Vec<i32> = vec_new();
    vec_push(starts, 0);
    vec_push(ends, 1);
    let item_tags: Vec<i32> = vec_new();
    let item_names: Vec<i32> = vec_new();
    let item_d2: Vec<i32> = vec_new();
    let item_d3: Vec<i32> = vec_new();
    let item_d4: Vec<i32> = vec_new();
    let item_fn_row: i32 = 0 - 1;
    let item_field_counts: Vec<i32> = vec_new();
    let enum_vnames_flat: Vec<i32> = vec_new();
    let enum_max_payloads: Vec<i32> = vec_new();
    vec_push(fn_ctx, 1);
    vec_push(fn_ctx, 0);
    vec_push(fn_ctx, 500);
    let v1: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                         2, ctr, out, en_n, en_to, en_tc,
                                         en_tf, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, vec_new(), vec_new());
    if ir_value_tag(v1) != 3 { return 1; }
    if vec_len(out) < 4 { return 2; }
    let i0: Instr = box_deref(vec_get(out, 0));
    if ir_instr_tag(i0) != 11 { return 3; }
    let i1: Instr = box_deref(vec_get(out, 1));
    if ir_instr_tag(i1) != 2 { return 4; }
    let i2: Instr = box_deref(vec_get(out, 2));
    if ir_instr_tag(i2) != 4 { return 5; }
    let i3: Instr = box_deref(vec_get(out, 3));
    if ir_instr_tag(i3) != 1 { return 6; }
    let i4: Instr = box_deref(vec_get(out, 4));
    if ir_instr_tag(i4) != 6 { return 7; }
    return 0;
}

fn test_build_builtin_map() -> i32 {
    let mut tt: Vec<i32> = vec_new();
    let src: string = "println vec_push foo vec_get no_alias bar";
    let mut st: Vec<i32> = vec_new();
    let mut en: Vec<i32> = vec_new();
    vec_push(tt, 5); vec_push(st, 0); vec_push(en, 7);
    vec_push(tt, 5); vec_push(st, 8); vec_push(en, 16);
    vec_push(tt, 5); vec_push(st, 17); vec_push(en, 20);
    vec_push(tt, 5); vec_push(st, 21); vec_push(en, 28);
    vec_push(tt, 5); vec_push(st, 29); vec_push(en, 37);
    vec_push(tt, 5); vec_push(st, 38); vec_push(en, 41);
    let bm: Vec<i32> = build_builtin_map(tt, src, st, en);
    if vec_len(bm) != 6 { return 1; }
    if vec_get(bm, 0) != 1 { return 2; }
    if vec_get(bm, 1) != 8 { return 3; }
    if vec_get(bm, 2) != 0 { return 4; }
    if vec_get(bm, 3) != 10 { return 5; }
    if vec_get(bm, 4) != 14 { return 6; }
    if vec_get(bm, 5) != 0 { return 7; }
    /* NEX-055c: getenv classifies to the next id after write_bytes (18). */
    if build_builtin_map_classify("getenv") != 19 { return 8; }
    if build_builtin_map_classify("write_bytes") != 18 { return 9; }
    return 0;
}

fn test_lower_match_env_helpers() -> i32 {
    let empty: Vec<i32> = vec_new();
    if lower_match_env_is_legacy_path(empty) != 1 { return 1; }
    if lower_match_env_is_packed_v0(empty) != 0 { return 2; }
    let hdr: Vec<i32> = lower_match_env_alloc_v0_empty_header();
    if vec_len(hdr) != lower_match_env_hdr_len() { return 3; }
    if lower_match_env_is_packed_v0(hdr) != 1 { return 4; }
    if lower_match_env_is_legacy_path(hdr) != 0 { return 5; }
    if vec_get(hdr, 0) != lower_match_env_magic_v0() { return 6; }
    if vec_get(hdr, 4) != 0 { return 7; }
    let mut bad: Vec<i32> = vec_new();
    vec_push(bad, lower_match_env_magic_v0());
    vec_push(bad, 2);
    let mut k: i32 = 2;
    while k < lower_match_env_hdr_len() {
        vec_push(bad, 0);
        k = k + 1;
    }
    if lower_match_env_is_packed_v0(bad) != 0 { return 8; }
    return 0;
}

fn test_lower_match_env_fn_pack_roundtrip() -> i32 {
    let env: Vec<i32> = lower_match_env_alloc_v0_empty_header();
    let tags: Vec<i32> = vec_new();
    let names: Vec<i32> = vec_new();
    let d2: Vec<i32> = vec_new();
    vec_push(tags, 0);
    vec_push(names, 100);
    vec_push(d2, 0);
    let src: string = "";
    let sts: Vec<i32> = vec_new();
    let ens: Vec<i32> = vec_new();
    let tt: Vec<i32> = vec_new();
    let ap: i32 = lower_match_env_append_top_fn_match_tables(env, tags,
        names, d2, src, sts, ens, tt);
    if ap != 0 { return 1; }
    let from_env_n: Vec<i32> = vec_new();
    let from_env_r: Vec<i32> = vec_new();
    let un: i32 = lower_match_env_unpack_fn_tables_for_match(env,
        from_env_n, from_env_r);
    if un != 0 { return 2; }
    let direct_n: Vec<i32> = vec_new();
    let direct_r: Vec<i32> = vec_new();
    let du: i32 = lower_top_fn_tables_for_match(tags, names, d2, src,
        sts, ens, tt, direct_n, direct_r);
    if du != 0 { return 3; }
    if vec_len(from_env_n) != vec_len(direct_n) { return 4; }
    if vec_len(from_env_r) != vec_len(direct_r) { return 5; }
    let mut j: i32 = 0;
    let nlen: i32 = vec_len(direct_n);
    while j < nlen {
        if vec_get(from_env_n, j) != vec_get(direct_n, j) { return 6; }
        if vec_get(from_env_r, j) != vec_get(direct_r, j) { return 7; }
        j = j + 1;
    }
    if vec_get(env, 4) != 1 { return 8; }
    return 0;
}

fn test_lower_match_env_scrut_merge_roundtrip() -> i32 {
    let parent: Vec<i32> = lower_match_env_alloc_v0_empty_header();
    let ap1: i32 = lower_match_env_append_scrut_pair(parent, 501, 701);
    if ap1 != 0 { return 1; }
    let ap2: i32 = lower_match_env_append_scrut_pair(parent, 502, 702);
    if ap2 != 0 { return 2; }
    if vec_get(parent, 10) != 2 { return 3; }
    let dst: Vec<i32> = lower_match_env_alloc_v0_empty_header();
    let mg: i32 = lower_match_env_merge_parent_scrut(dst, parent);
    if mg != 0 { return 4; }
    if vec_get(dst, 10) != 2 { return 5; }
    let ty_a: i32 = lower_match_env_scrut_ty_lookup(dst, 99, 501);
    if ty_a != 701 { return 6; }
    let ty_b: i32 = lower_match_env_scrut_ty_lookup(dst, 99, 502);
    if ty_b != 702 { return 7; }
    let ty_lim: i32 = lower_match_env_scrut_ty_lookup(dst, 1, 502);
    if ty_lim != 0 - 2 { return 8; }
    let ty_miss: i32 = lower_match_env_scrut_ty_lookup(dst, 99, 999);
    if ty_miss != 0 - 2 { return 9; }
    let ap3: i32 = lower_match_env_append_scrut_pair(dst, 501, 1701);
    if ap3 != 0 { return 10; }
    let ty_shadow: i32 = lower_match_env_scrut_ty_lookup(dst, 99, 501);
    if ty_shadow != 1701 { return 11; }
    let leg: Vec<i32> = vec_new();
    vec_push(leg, 0);
    let mg2: i32 = lower_match_env_merge_parent_scrut(dst, leg);
    if mg2 != 0 { return 12; }
    if vec_get(dst, 10) != 3 { return 13; }
    let bad_dst: Vec<i32> = vec_new();
    vec_push(bad_dst, 0);
    let mg3: i32 = lower_match_env_merge_parent_scrut(bad_dst, parent);
    if mg3 != 0 - 1 { return 14; }
    let par_alt: Vec<i32> = lower_match_env_alloc_v0_empty_header();
    let nm0: i32 = vec_len(par_alt);
    vec_push(par_alt, 601);
    vec_push(par_alt, 602);
    let ty0: i32 = vec_len(par_alt);
    vec_push(par_alt, 801);
    vec_push(par_alt, 802);
    vec_set(par_alt, 8, nm0);
    vec_set(par_alt, 9, ty0);
    vec_set(par_alt, 10, 2);
    let dst2: Vec<i32> = lower_match_env_alloc_v0_empty_header();
    let mg4: i32 = lower_match_env_merge_parent_scrut(dst2, par_alt);
    if mg4 != 0 { return 15; }
    let ty_c: i32 = lower_match_env_scrut_ty_lookup(dst2, 99, 601);
    if ty_c != 801 { return 16; }
    let ty_d: i32 = lower_match_env_scrut_ty_lookup(dst2, 99, 602);
    if ty_d != 802 { return 17; }
    return 0;
}

/* Clone must copy scrut tail so per-arm `lower_match_env_clone` keeps
   outer scrut + payload bindings visible; appending on the clone must
   not mutate the parent env. */

fn test_lower_match_env_clone_scrut_roundtrip() -> i32 {
    let parent: Vec<i32> = lower_match_env_alloc_v0_empty_header();
    let ap0: i32 = lower_match_env_append_scrut_pair(parent, 1001, 2001);
    if ap0 != 0 { return 1; }
    let arm: Vec<i32> = lower_match_env_clone(parent);
    if vec_get(arm, 10) != 1 { return 2; }
    let ty1: i32 = lower_match_env_scrut_ty_lookup(arm, 99, 1001);
    if ty1 != 2001 { return 3; }
    let ap1: i32 = lower_match_env_append_scrut_pair(arm, 1002, 2002);
    if ap1 != 0 { return 4; }
    if vec_get(arm, 10) != 2 { return 5; }
    if vec_get(parent, 10) != 1 { return 6; }
    let ty2: i32 = lower_match_env_scrut_ty_lookup(arm, 99, 1002);
    if ty2 != 2002 { return 7; }
    return 0;
}

fn main() -> i32 {
    let r3: i32 = test_binop_to_c();
    if r3 != 0 { return 30 + r3; }
    let r4: i32 = test_unop_to_c();
    if r4 != 0 { return 50 + r4; }
    let r5: i32 = test_ty_to_c();
    if r5 != 0 { return 60 + r5; }
    let r6: i32 = test_old_slot();
    if r6 != 0 { return 80 + r6; }
    let r7: i32 = test_ret_syntax();
    if r7 != 0 { return 90 + r7; }
    let r8: i32 = test_store_value_class();
    if r8 != 0 { return 100 + r8; }
    let r8a: i32 = test_store_value_to_slot();
    if r8a != 0 { return 105 + r8a; }
    let r8b: i32 = test_inject_ensures_and_ret_slot();
    if r8b != 0 { return 108 + r8b; }
    let r9: i32 = test_assign_lhs();
    if r9 != 0 { return 110 + r9; }
    let r10: i32 = test_enum_tag();
    if r10 != 0 { return 120 + r10; }
