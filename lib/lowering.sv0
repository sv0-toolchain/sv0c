        if cls2 == 1 {
            let obj_tok2: i32 = vec_get(aout2, 0);
            let fld_tok2: i32 = vec_get(aout2, 1);
            let cur2: Value = Value::VMember(box_new(Value::VVar(obj_tok2)), fld_tok2);
            let rv2b: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                                   tok_tags, rhs_idx2, ctr,
                                                   out_instrs, enum_names,
                                                   enum_tag_offsets,
                                                   enum_tag_counts,
                                                   enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
            let be2: Expr = Expr::Binop(op_tag, box_new(cur2), box_new(rv2b));
            let sf2: Instr = Instr::StoreField(obj_tok2, fld_tok2, box_new(be2));
            vec_push(out_instrs, box_new(sf2));
        }
        return Value::VUnit;
    }
    if tag == 20 {
        let cast_src: i32 = vec_get(ed1, idx);
        let cv: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                             tok_tags, cast_src, ctr,
                                             out_instrs, enum_names,
                                             enum_tag_offsets, enum_tag_counts,
                                             enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let ct2: i32 = ctr_fresh(ctr);
        let cast_e: Expr = Expr::Unop(99, box_new(cv));
        let cast_i: Instr = Instr::Assign(ct2, box_new(cast_e));
        vec_push(out_instrs, box_new(cast_i));
        return Value::VVar(ct2);
    }
    if tag == 22 {
        return lower_tag_try(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                              idx, ctr, out_instrs, enum_names,
                              enum_tag_offsets, enum_tag_counts,
                              enum_tags_flat, fn_ctx, builtin_map,
                              lit_sf_names, source, starts, ends,
                              item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts,
                              enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    }
    if tag == 24 {
        let pps_s: i32 = vec_get(ed1, idx);
        let ppc_s: i32 = vec_get(ed2, idx);
        let fc_s: i32 = vec_get(ed3, idx);
        let sf0: i32 = vec_get(ed4, idx);
        if ppc_s < 1 {
            return Value::VUnit;
        }
        if fc_s <= 0 {
            return Value::VUnit;
        }
        /* `pp[pps_s .. pps_s+ppc_s)` holds path segment token indices.
           Single-seg matches SML `hd path`. For `Mod::Struct { ... }`,
           use the **last** segment as the struct typename for DeclNamed. */
        let sty_idx: i32 = pps_s + ppc_s - 1;
        let sty_tok: i32 = vec_get(pp, sty_idx);
        let t_s: i32 = ctr_fresh(ctr);
        let decl_s: Instr = Instr::DeclNamed(sty_tok, t_s);
        vec_push(out_instrs, box_new(decl_s));
        /* lit_sf_names is stride-2 per field: [name_tok, value_root]. sf0 is the
           stride-2 base (fc_before). Read the value root directly rather than
           assuming the fc_s value expressions are contiguous before the ExprStruct
           node — they are not when a field value is itself a field access / call. */
        let mut fi_s: i32 = 0;
        while fi_s < fc_s {
            let ch_s: i32 = vec_get(lit_sf_names, sf0 + fi_s * 2 + 1);
            let fv_s: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                                  tok_tags, ch_s, ctr,
                                                  out_instrs, enum_names,
                                                  enum_tag_offsets,
                                                  enum_tag_counts,
                                                  enum_tags_flat, fn_ctx,
                                                  builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
            let fe_s: Expr = value_to_expr(fv_s);
            let fnm_s: i32 = vec_get(lit_sf_names, sf0 + fi_s * 2);
            let stf_s: Instr = Instr::StoreField(t_s, fnm_s, box_new(fe_s));
            vec_push(out_instrs, box_new(stf_s));
            fi_s = fi_s + 1;
        }
        return Value::VVar(t_s);
    }
    if tag == 25 {
        let elem_count: i32 = vec_get(ed2, idx);
        if elem_count == 1 {
            let first_idx: i32 = vec_get(ed1, idx);
            return lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                        tok_tags, first_idx, ctr,
                                        out_instrs, enum_names,
                                        enum_tag_offsets, enum_tag_counts,
                                        enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        }
    }
    /* ExprAssert: evaluate condition for side effects only; runtime
       assert lowering (branch on false) deferred to match SML. */
    if tag == 23 {
        let assert_expr: i32 = vec_get(ed1, idx);
        lower_for_effect(et, ed1, ed2, ed3, ed4, pp, tok_tags, assert_expr,
                         ctr, out_instrs, enum_names, enum_tag_offsets,
                         enum_tag_counts, enum_tags_flat, fn_ctx,
                         builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        return Value::VUnit;
    }
    if tag == 30 {
        return Value::VUnit;
    }
    return Value::VUnit;
}

/* ── value_to_expr (SML valueToExpr) ────────────────────────
   VVar(x) → Load(x);  otherwise → Literal(v). */

fn value_to_expr(v: Value) -> Expr {
    let t: i32 = ir_value_tag(v);
    if t == 3 {
        match v {
            Value::VVar(x) => { return Expr::Load(x); },
            _ => { return Expr::Literal(box_new(v)); },
        }
    }
    return Expr::Literal(box_new(v));
}

/* ── lower_expr_with_instrs (SML lowerExprWithInstrs) ───────
   Returns (instrs via out_instrs, Expr).  Wrapper: calls
   lower_expr_to_value then value_to_expr. */

fn lower_expr_with_instrs(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                           ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
                           tok_tags: Vec<i32>,
                           idx: i32, ctr: Vec<i32>,
                           out_instrs: Vec<i32>,
                           enum_names: Vec<i32>,
                           enum_tag_offsets: Vec<i32>,
                           enum_tag_counts: Vec<i32>,
                           enum_tags_flat: Vec<i32>,
                           fn_ctx: Vec<i32>,
                           builtin_map: Vec<i32>, lit_sf_names: Vec<i32>,
                           source: string, starts: Vec<i32>, ends: Vec<i32>,
                           item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                    item_field_counts: Vec<i32>,
                    enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                    match_env_inherit: Vec<i32>, import_aliases: Vec<i32>) -> Expr {
    /* Faithful to SML lowerExprWithInstrs: a top-level binop returns Ir.Binop
       DIRECTLY (operands lowered to values, which may spill sub-exprs), NOT a
       temp — otherwise `x = a + b` becomes Assign(tmp, Binop); Store(x, tmp)
       (an extra slot + load/store) instead of SML's Store(x, Binop). Other
       shapes fall back to value_to_expr(lower_expr_to_value): a bare path lowers
       to VVar and a literal to VInt, and value_to_expr wraps those to the same
       bytecode Load/Literal would emit, so only binop needs the direct form. */
    let etag: i32 = vec_get(et, idx);
    if etag == 10 {
        let else_idx_wi: i32 = vec_get(ed3, idx);
        /* VM-only (lower_vm_target): the t/u DeclVar form matches SML's VM temp
           numbering but assumes int-typed temps; a struct/enum-valued if would emit
           `int t;` for a struct in C. The C backend keeps its valid value-path
           lowering (lower_tag_if), which handles the type correctly. */
        if else_idx_wi >= 0 && lower_vm_target() == 1 {
            let cond_idx_wi: i32 = vec_get(ed1, idx);
            let then_idx_wi: i32 = vec_get(ed2, idx);
            let t_wi: i32 = ctr_fresh(ctr);
            let u_wi: i32 = ctr_fresh(ctr);
            let cond_e_wi: Expr = lower_cond_expr(et, ed1, ed2, ed3, ed4, pp,
                                                  tok_tags, cond_idx_wi, ctr, out_instrs,
                                                  enum_names, enum_tag_offsets, enum_tag_counts,
                                                  enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
            vec_push(out_instrs, box_new(Instr::DeclVar(t_wi)));
            vec_push(out_instrs, box_new(Instr::DeclVar(u_wi)));
            let mut then_wi: Vec<i32> = vec_new();
            lower_into_var_instrs(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                  then_idx_wi, u_wi, ctr, then_wi,
                                  enum_names, enum_tag_offsets, enum_tag_counts,
                                  enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
            let mut else_wi: Vec<i32> = vec_new();
            lower_into_var_instrs(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                  else_idx_wi, u_wi, ctr, else_wi,
                                  enum_names, enum_tag_offsets, enum_tag_counts,
                                  enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
            vec_push(out_instrs, box_new(Instr::IfElse(box_new(cond_e_wi), then_wi, else_wi)));
            vec_push(out_instrs, box_new(Instr::Store(t_wi, box_new(Expr::Load(u_wi)))));
            return value_to_expr(Value::VVar(t_wi));
        }
    }
    if etag == 3 {
        let binop_tag: i32 = vec_get(ed1, idx);
        let lhs_idx: i32 = vec_get(ed2, idx);
        let rhs_idx: i32 = vec_get(ed3, idx);
        let vl: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                             tok_tags, lhs_idx, ctr,
                                             out_instrs, enum_names,
                                             enum_tag_offsets, enum_tag_counts,
                                             enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let vr: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                             tok_tags, rhs_idx, ctr,
                                             out_instrs, enum_names,
                                             enum_tag_offsets, enum_tag_counts,
                                             enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        return Expr::Binop(binop_tag, box_new(vl), box_new(vr));
    }
    let v: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                        tok_tags, idx, ctr, out_instrs,
                                        enum_names, enum_tag_offsets,
                                        enum_tag_counts, enum_tags_flat,
                                        fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    return value_to_expr(v);
}

/* ── lower_for_effect (SML lowerExprForEffect — simplified) ─
   Lowers an expression discarding the result value.
   Returns the instruction list via out_instrs. */

fn lower_for_effect(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                    ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
                    tok_tags: Vec<i32>,
                    idx: i32, ctr: Vec<i32>,
                    out_instrs: Vec<i32>,
                    enum_names: Vec<i32>,
                    enum_tag_offsets: Vec<i32>,
                    enum_tag_counts: Vec<i32>,
                    enum_tags_flat: Vec<i32>,
                    fn_ctx: Vec<i32>,
                    builtin_map: Vec<i32>, lit_sf_names: Vec<i32>,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                    item_field_counts: Vec<i32>,
                    enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                    match_env_inherit: Vec<i32>, import_aliases: Vec<i32>) -> i32 {
    /* SML lowerExprForEffect ExprIf: `ic @ [IfElse(ec, effect-then, effect-else)]`
       — an if used for effect (a bare `if c {…} else {…}` statement) does NOT
       allocate result temps. lower_expr_to_value routes it through lower_tag_if's
       value path, which declares two result slots and stores each branch value
       into them (dead work that diverges the bytecode). Lower the condition
       faithfully (lower_cond_expr) and lower each branch FOR EFFECT instead. */
    let etag: i32 = vec_get(et, idx);
    if etag == 9 {
        /* Block for effect (SML lowerExprForEffect ExprBlock): lower its
           statements, then its tail expression FOR EFFECT — no result temp for a
           tail if/match whose value is discarded (e.g. a loop body). */
        lower_tag_block(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                        idx, ctr, out_instrs, enum_names,
                        enum_tag_offsets, enum_tag_counts,
                        enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases, 1, 0 - 1);
        return 0;
    }
    if etag == 10 {
        let cond_idx: i32 = vec_get(ed1, idx);
        let then_idx: i32 = vec_get(ed2, idx);
        let else_idx: i32 = vec_get(ed3, idx);
        let cond_e: Expr = lower_cond_expr(et, ed1, ed2, ed3, ed4, pp,
                                           tok_tags, cond_idx, ctr, out_instrs,
                                           enum_names, enum_tag_offsets, enum_tag_counts,
                                           enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let then_is: Vec<i32> = vec_new();
        let rt: i32 = lower_for_effect(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                       then_idx, ctr, then_is,
                                       enum_names, enum_tag_offsets, enum_tag_counts,
                                       enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let else_is: Vec<i32> = vec_new();
        if else_idx >= 0 {
            let re: i32 = lower_for_effect(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                           else_idx, ctr, else_is,
                                           enum_names, enum_tag_offsets, enum_tag_counts,
                                           enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        }
        vec_push(out_instrs, box_new(Instr::IfElse(box_new(cond_e), then_is, else_is)));
        return 0;
    }
    let discard5: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                               tok_tags, idx, ctr,
                                               out_instrs, enum_names,
                                               enum_tag_offsets,
                                               enum_tag_counts,
                                               enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    return 0;
}

/* ── lower_into_var_instrs (SML lowerIntoVarInstrs — simplified)
   Lowers body_idx and emits Store(dest, expr).
   The SML version optimises for blocks/literals/if-exprs; this
   simplified version always goes through lower_expr_with_instrs.
   Tests omitted: SML compiler function budget (~172 fn limit). */

fn lower_into_var_instrs(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                          ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
                          tok_tags: Vec<i32>,
                          body_idx: i32, dest: i32,
                          ctr: Vec<i32>,
                          out_instrs: Vec<i32>,
                          enum_names: Vec<i32>,
                          enum_tag_offsets: Vec<i32>,
                          enum_tag_counts: Vec<i32>,
                          enum_tags_flat: Vec<i32>,
                          fn_ctx: Vec<i32>,
                          builtin_map: Vec<i32>, lit_sf_names: Vec<i32>,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                    item_field_counts: Vec<i32>,
                    enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                    match_env_inherit: Vec<i32>, import_aliases: Vec<i32>) -> i32 {
    /* SML lowerIntoVarInstrs: a block lowers its stmts then its tail INTO dest
       (no tail => Store(dest, VUnit)); a no-else `if` stores VUnit in the empty
       branch. sv0 previously always fell to `Store(dest, lower_expr_with_instrs)`,
       which drops those unit stores for a block/if arm body whose value is unit
       (e.g. a match arm ending in `if c { return N }`). Handle those two shapes
       faithfully; if-with-else stays on the default path (unchanged — the
       byte-identical modules rely on it). */
    let btag: i32 = vec_get(et, body_idx);
    if btag == 9 {
        lower_tag_block(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                        body_idx, ctr, out_instrs, enum_names,
                        enum_tag_offsets, enum_tag_counts,
                        enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases, 0, dest);
        return 0;
    }
    if btag == 10 {
        let else_idx_iv: i32 = vec_get(ed3, body_idx);
        if else_idx_iv < 0 {
            let cond_idx_iv: i32 = vec_get(ed1, body_idx);
            let then_idx_iv: i32 = vec_get(ed2, body_idx);
            let cond_e_iv: Expr = lower_cond_expr(et, ed1, ed2, ed3, ed4, pp,
                                                  tok_tags, cond_idx_iv, ctr, out_instrs,
                                                  enum_names, enum_tag_offsets, enum_tag_counts,
                                                  enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
            let mut then_is_iv: Vec<i32> = vec_new();
            lower_into_var_instrs(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                  then_idx_iv, dest, ctr, then_is_iv,
                                  enum_names, enum_tag_offsets, enum_tag_counts,
                                  enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
            let mut else_is_iv: Vec<i32> = vec_new();
            vec_push(else_is_iv, box_new(Instr::Store(dest,
                box_new(Expr::Literal(box_new(Value::VUnit))))));
            vec_push(out_instrs, box_new(Instr::IfElse(box_new(cond_e_iv), then_is_iv, else_is_iv)));
            return 0;
        } else {
            /* ExprIf WITH else into a var (SML lowerIntoVarInstrs): a fresh `u`
               holds the if's value, each branch lowers INTO u, then `dest = u`
               (`u=freshTmp; ic @ [declU, IfElse(ec, into_var(th,u), into_var(el,u)),
               Store(t, Load u)]`). Otherwise the tail if-else of a match arm falls
               to lower_expr_with_instrs' value path, whose temp numbering differs
               from SML. u is freshTmp'd BEFORE the condition (lower slot); its
               DeclVar is emitted AFTER the condition's spill instrs. */
            let cond_idx_we: i32 = vec_get(ed1, body_idx);
            let then_idx_we: i32 = vec_get(ed2, body_idx);
            let u_we: i32 = ctr_fresh(ctr);
            let cond_e_we: Expr = lower_cond_expr(et, ed1, ed2, ed3, ed4, pp,
                                                  tok_tags, cond_idx_we, ctr, out_instrs,
                                                  enum_names, enum_tag_offsets, enum_tag_counts,
                                                  enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
            vec_push(out_instrs, box_new(Instr::DeclVar(u_we)));
            let mut then_we: Vec<i32> = vec_new();
            lower_into_var_instrs(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                  then_idx_we, u_we, ctr, then_we,
                                  enum_names, enum_tag_offsets, enum_tag_counts,
                                  enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
            let mut else_we: Vec<i32> = vec_new();
            lower_into_var_instrs(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                  else_idx_iv, u_we, ctr, else_we,
                                  enum_names, enum_tag_offsets, enum_tag_counts,
                                  enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
            vec_push(out_instrs, box_new(Instr::IfElse(box_new(cond_e_we), then_we, else_we)));
            vec_push(out_instrs, box_new(Instr::Store(dest, box_new(Expr::Load(u_we)))));
            return 0;
        }
    }
    let ee: Expr = lower_expr_with_instrs(et, ed1, ed2, ed3, ed4, pp,
                                           tok_tags, body_idx, ctr,
                                           out_instrs, enum_names,
                                           enum_tag_offsets,
                                           enum_tag_counts,
                                           enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    let si: Instr = Instr::Store(dest, box_new(ee));
    vec_push(out_instrs, box_new(si));
    return 0;
}

/* ── bind_scrut_var (SML bindScrutVar) ───────────────────────
   Lowers the match scrutinee and ensures it is in a named temp.
   Returns the temp ID (either the original VVar handle or a fresh
   ctr temp).  Side-effect instructions go to out_instrs.
   scrut_cty: type handle from match_scrut_cty (-1 = unknown).
   Tests omitted: SML compiler function budget (~172 fn limit). */

fn bind_scrut_var(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                   ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
                   tok_tags: Vec<i32>,
                   scrut_idx: i32, ctr: Vec<i32>,
                   out_instrs: Vec<i32>,
                   enum_names: Vec<i32>,
                   enum_tag_offsets: Vec<i32>,
                   enum_tag_counts: Vec<i32>,
                   enum_tags_flat: Vec<i32>,
                   fn_ctx: Vec<i32>,
                   builtin_map: Vec<i32>,
                   lit_sf_names: Vec<i32>,
                   item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                   item_field_counts: Vec<i32>,
                   enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                   match_env_ctx: Vec<i32>,
                   scrut_cty: i32,
                   source: string, starts: Vec<i32>, ends: Vec<i32>,
                   import_aliases: Vec<i32>) -> i32 {
    let v: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                        tok_tags, scrut_idx, ctr,
                                        out_instrs, enum_names,
                                        enum_tag_offsets,
                                        enum_tag_counts, enum_tags_flat,
                                        fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_ctx, import_aliases);
    let vtag: i32 = ir_value_tag(v);
    if vtag == 3 {
        match v {
            Value::VVar(x) => { return x; },
            _ => { return 0 - 1; },
        }
    }
    if vtag == 0 {
        let t: i32 = ctr_fresh(ctr);
        let ai: Instr = Instr::Assign(t, box_new(Expr::Literal(box_new(v))));
        vec_push(out_instrs, box_new(ai));
        return t;
    }
    if vtag == 1 {
        let t: i32 = ctr_fresh(ctr);
        let ai: Instr = Instr::Assign(t, box_new(Expr::Literal(box_new(v))));
        vec_push(out_instrs, box_new(ai));
        return t;
    }
    if vtag == 2 {
        let t: i32 = ctr_fresh(ctr);
        let ai: Instr = Instr::Assign(t, box_new(Expr::Literal(box_new(v))));
        vec_push(out_instrs, box_new(ai));
        return t;
    }
    let t: i32 = ctr_fresh(ctr);
    let ee: Expr = value_to_expr(v);
    let mut is_scalar: i32 = 0;
    if scrut_cty < 0 { is_scalar = 1; }
    if is_scalar == 0 {
        let tname: string = handle_to_str(scrut_cty, source, starts, ends);
        if string_eq(tname, "i32") { is_scalar = 1; }
        if string_eq(tname, "bool") { is_scalar = 1; }
    }
    if is_scalar == 1 {
        let ai2: Instr = Instr::Assign(t, box_new(ee));
        vec_push(out_instrs, box_new(ai2));
    } else {
        let di: Instr = Instr::DeclNamed(scrut_cty, t);
        let si: Instr = Instr::Store(t, box_new(ee));
        vec_push(out_instrs, box_new(di));
        vec_push(out_instrs, box_new(si));
    }
    return t;
}

/* ── lower_match_arms (SML lowerMatchArms + inline matchArmSetup)
   Iterates arms of ExprMatch, building nested IfElse chains.
   For each arm: determines condition (cexp) and pre-bindings (bindPre)
   based on pattern tag, lowers body via lower_into_var_instrs, handles
   optional guard.  Appends the resulting IfElse instruction tree to
   out_instrs.  `out` is the dest variable for the match result.
   `scrut_var` is the temp holding the scrutinee value.
   Pattern support: PatWild(0), PatBind(1); PatLit(2) with ExprPatExtra
   (tag 30): `==` on scrut; int literals parsed from source (incl. `-n`
   via parser is_neg + positive int token); bool literals (`lit_tag` 5)
   match SML: `true` → scrutinee `!= 0`, `false` → `== 0` (token 91 =
   true); unary `-` inverts which branch fires; other literal kinds with
   non-int/bool literals use `!=` when `is_neg` is set;
   PatEnum(5) with ExprPatExtra when path has >=2 segments: tag field
   `VMember(scrut,-1)` vs variant discriminant; tuple args: ExprPatEnumMeta
   (33) + ExprPatFieldEmbed rows with ed2 = payload index → Assign to
   `VMember(scrut, 0-10-pi)`; PatStruct(4) same tag
   compare when path has >=2 segments. Parser embeds field rows as
   ExprPatFieldEmbed(31) + ExprPatStructMeta(32) immediately before
   ExprPatExtra(30); PatStruct field bindPre lowers PatBind rows via
   `lower_pat_struct_field_payload_index` (parser PatBind.data3 holds
   field name tok for `field: pat` rows). After cloning `arm_menv`,
   tuple/struct payload bindings are registered in packed scrut pairs
   (same `scrut_cty` as PatBind) so nested `match_scrut_cty` on those
   names resolves during the arm body.
   Tests omitted: SML compiler function budget (~172 fn limit). */

fn lower_match_arms(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                    ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
                    tok_tags: Vec<i32>,
                    arms_first: i32, arm_count: i32, arms_sidecar: i32,
                    out_var: i32, scrut_var: i32,
                    scrut_cty: i32,
                    ctr: Vec<i32>,
                    out_instrs: Vec<i32>,
                    enum_names: Vec<i32>,
                    enum_tag_offsets: Vec<i32>,
                    enum_tag_counts: Vec<i32>,
                    enum_tags_flat: Vec<i32>,
                    fn_ctx: Vec<i32>,
                    builtin_map: Vec<i32>,
                    lit_sf_names: Vec<i32>,
                    item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                    item_field_counts: Vec<i32>,
                    enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                    match_env: Vec<i32>,
                    source: string, starts: Vec<i32>,
                    ends: Vec<i32>,
                    import_aliases: Vec<i32>) -> i32 {
    let mut result_instrs: Vec<i32> = vec_new();
    let mut ai: i32 = arm_count - 1;
    while ai >= 0 {
        let arm_idx: i32 = block_stmt_index(pp, arms_first, arms_sidecar, ai);
        let arm_tag: i32 = vec_get(et, arm_idx);
        if arm_tag != 29 { return 0 - 1; }
        let pat_tag: i32 = vec_get(ed1, arm_idx);
        let pat_d1: i32 = vec_get(ed2, arm_idx);
        let guard_idx: i32 = vec_get(ed3, arm_idx);
        let body_idx: i32 = vec_get(ed4, arm_idx);
        let mut cexp: Expr = Expr::Literal(box_new(Value::VBoolTrue));
        let mut bind_instrs: Vec<i32> = vec_new();
        if pat_tag == 0 {
            cexp = Expr::Literal(box_new(Value::VBoolTrue));
        }
        if pat_tag == 1 {
            cexp = Expr::Literal(box_new(Value::VBoolTrue));
            let mut is_scalar: i32 = 0;
            if scrut_cty < 0 { is_scalar = 1; }
            if is_scalar == 0 {
                let tname: string = handle_to_str(scrut_cty, source, starts, ends);
                if string_eq(tname, "i32") { is_scalar = 1; }
                if string_eq(tname, "bool") { is_scalar = 1; }
            }
            if is_scalar == 1 {
                let ba: Instr = Instr::Assign(pat_d1,
                    box_new(Expr::Load(scrut_var)));
                vec_push(bind_instrs, box_new(ba));
            } else {
                let bd: Instr = Instr::DeclNamed(scrut_cty, pat_d1);
                let bs: Instr = Instr::Store(pat_d1,
                    box_new(Expr::Load(scrut_var)));
                vec_push(bind_instrs, box_new(bd));
                vec_push(bind_instrs, box_new(bs));
            }
        }
        if pat_tag == 2 {
            let paux2: i32 = vec_get(ed2, arm_idx);
            let pxt2: i32 = vec_get(et, paux2);
            if pxt2 == 30 {
                let k2: i32 = vec_get(ed4, paux2);
                if k2 == 2 {
                    let is_neg2: i32 = vec_get(ed3, paux2);
                    let lt2: i32 = vec_get(ed1, paux2);
                    let tp2: i32 = vec_get(ed2, paux2);
                    if lt2 == 0 {
                        let lv2: Value = Value::VVar(scrut_var);
                        if string_len(source) == 0 {
                            if is_neg2 == 1 {
                                cexp = Expr::Literal(box_new(Value::VBoolTrue));
                            } else {
                                let rv0: Value = lower_lit_to_ir_value(0, tp2, tok_tags, source, starts, ends);
                                cexp = Expr::Binop(5, box_new(lv2),
                                                    box_new(rv0));
                            }
                        } else {
                            let mut vi: i32 = parse_decimal_i32_from_tok(
                                source, starts, ends, tp2);
                            if is_neg2 == 1 {
                                vi = 0 - vi;
                            }
                            let rv2: Value = Value::VInt(vi);
                            cexp = Expr::Binop(5, box_new(lv2), box_new(rv2));
                        }
                    } else {
                        if lt2 == 5 {
                            let tt_b: i32 = vec_get(tok_tags, tp2);
                            let mut nz: i32 = 0;
                            if tt_b == 91 {
                                nz = 1;
                            }
                            if is_neg2 == 1 {
                                if nz == 1 {
                                    nz = 0;
                                } else {
                                    nz = 1;
                                }
                            }
                            let lv_b: Value = Value::VVar(scrut_var);
                            let zv: Value = Value::VInt(0);
                            if nz == 1 {
                                cexp = Expr::Binop(6, box_new(lv_b),
                                                    box_new(zv));
                            } else {
                                cexp = Expr::Binop(5, box_new(lv_b),
                                                    box_new(zv));
                            }
                        } else {
                            if is_neg2 == 1 {
                                let rv_n: Value = lower_lit_to_ir_value(
                                    lt2, tp2, tok_tags, source, starts, ends);
                                let lv_n: Value = Value::VVar(scrut_var);
                                cexp = Expr::Binop(6, box_new(lv_n),
                                                    box_new(rv_n));
                            } else {
                                let rv3: Value = lower_lit_to_ir_value(
                                    lt2, tp2, tok_tags, source, starts, ends);
                                let lv3: Value = Value::VVar(scrut_var);
                                cexp = Expr::Binop(5, box_new(lv3),
                                                    box_new(rv3));
                            }
                        }
                    }
                } else {
                    cexp = Expr::Literal(box_new(Value::VBoolFalse));
                }
            } else {
                cexp = Expr::Literal(box_new(Value::VBoolFalse));
            }
        }
        if pat_tag == 5 {
            let paux5: i32 = vec_get(ed2, arm_idx);
            let pxt5: i32 = vec_get(et, paux5);
            if pxt5 == 30 {
                let k5: i32 = vec_get(ed4, paux5);
                if k5 == 5 {
                    let pp_s5: i32 = vec_get(ed1, paux5);
                    let pp_c5: i32 = vec_get(ed2, paux5);
                    if pp_c5 >= 2 {
                        let en_h: i32 = vec_get(pp, pp_s5);
                        let vn_h: i32 = vec_get(pp, pp_s5 + 1);
                        let kv: i32 = enum_tag_lookup_str(enum_names,
                            enum_tags_flat, enum_tag_offsets,
                            enum_tag_counts, en_h, vn_h, source, starts, ends);
                        if kv < 0 {
                            cexp = Expr::Literal(box_new(Value::VBoolFalse));
                        } else {
                            let tag_m: Value = Value::VMember(
                                box_new(Value::VVar(scrut_var)), 0 - 1);
                            let kv_v: Value = Value::VInt(kv);
                            cexp = Expr::Binop(5, box_new(tag_m),
                                                box_new(kv_v));
                            let argc5: i32 = vec_get(ed3, paux5);
                            if argc5 > 0 {
                                let meta_idx5: i32 = paux5 - 1;
                                let mtag5: i32 = vec_get(et, meta_idx5);
                                if mtag5 == 33 {
                                    let ac5: i32 = vec_get(ed1, meta_idx5);
                                    let first_e5: i32 = vec_get(ed2, meta_idx5);
                                    let mut ej: i32 = 0;
                                    while ej < ac5 {
                                        let eidx5: i32 = first_e5 + ej;
                                        let etg5: i32 = vec_get(et, eidx5);
                                        if etg5 == 31 {
                                            let ipt5: i32 = vec_get(ed4, eidx5);
                                            if ipt5 == 1 {
                                                let bind_tok5: i32 = vec_get(ed1, eidx5);
                                                let pi5: i32 = vec_get(ed2, eidx5);
                                                if pi5 >= 0 {
                                                    let pay5: i32 = 0 - 10 - pi5;
                                                    let rhsv5: Value = Value::VMember(
                                                        box_new(Value::VVar(scrut_var)), pay5);
                                                    let asgx5: Instr = Instr::Assign(
                                                        bind_tok5,
                                                        box_new(Expr::Literal(
                                                            box_new(rhsv5))));
                                                    vec_push(bind_instrs, box_new(asgx5));
                                                }
                                            }
                                        }
                                        ej = ej + 1;
                                    }
                                }
                            }
                        }
                    } else {
                        cexp = Expr::Literal(box_new(Value::VBoolTrue));
                    }
                } else {
                    cexp = Expr::Literal(box_new(Value::VBoolFalse));
                }
            } else {
                cexp = Expr::Literal(box_new(Value::VBoolFalse));
            }
        }
        if pat_tag == 4 {
            let paux4: i32 = vec_get(ed2, arm_idx);
            let pxt4: i32 = vec_get(et, paux4);
            if pxt4 == 30 {
                let k4: i32 = vec_get(ed4, paux4);
                if k4 == 4 {
                    let pp_s4: i32 = vec_get(ed1, paux4);
                    let pp_c4: i32 = vec_get(ed2, paux4);
                    if pp_c4 >= 2 {
                        let en_h4: i32 = vec_get(pp, pp_s4);
                        let vn_h4: i32 = vec_get(pp, pp_s4 + 1);
                        let kv4: i32 = enum_tag_lookup_str(enum_names,
                            enum_tags_flat, enum_tag_offsets,
                            enum_tag_counts, en_h4, vn_h4, source, starts, ends);
                        if kv4 < 0 {
                            cexp = Expr::Literal(box_new(Value::VBoolFalse));
                        } else {
                            let tag_m4: Value = Value::VMember(
                                box_new(Value::VVar(scrut_var)), 0 - 1);
                            let kv_v4: Value = Value::VInt(kv4);
                            cexp = Expr::Binop(5, box_new(tag_m4),
                                                box_new(kv_v4));
                            let meta_idx: i32 = paux4 - 1;
                            let mtag: i32 = vec_get(et, meta_idx);
                            if mtag == 32 {
                                let sfc: i32 = vec_get(ed1, meta_idx);
                                let first_emb: i32 = vec_get(ed2, meta_idx);
                                if sfc > 0 {
                                    let mut fj: i32 = 0;
                                    while fj < sfc {
                                        let eidx: i32 = first_emb + fj;
                                        let etg: i32 = vec_get(et, eidx);
                                        if etg == 31 {
                                            let ipt: i32 = vec_get(ed4, eidx);
                                            if ipt == 1 {
                                                let bind_tok: i32 = vec_get(ed1, eidx);
                                                let fld_meta: i32 = vec_get(ed3, eidx);
                                                let mut fnam_tok: i32 = bind_tok;
                                                if fld_meta != 0 {
                                                    fnam_tok = fld_meta;
                                                }
                                                let pi: i32 = lower_pat_struct_field_payload_index(
                                                    tok_tags, source, starts, ends,
                                                    vn_h4, sfc, fnam_tok);
                                                /* The name→slot scan reads the variant
                                                   token from the PATTERN (`{ w, h }`,
                                                   no `: type`), not the definition, so
                                                   it fails; fall back to embed order =
                                                   the field slot (pattern fields in
                                                   definition order, the common case). */
                                                let mut pif: i32 = pi;
                                                if pif < 0 { pif = fj; }
                                                if pif >= 0 {
                                                    let pay: i32 = 0 - 10 - pif;
                                                    let rhsv: Value = Value::VMember(
                                                        box_new(Value::VVar(scrut_var)), pay);
                                                    let asgx: Instr = Instr::Assign(
                                                        bind_tok,
                                                        box_new(Expr::Literal(
                                                            box_new(rhsv))));
                                                    vec_push(bind_instrs, box_new(asgx));
                                                }
                                            }
                                        }
                                        fj = fj + 1;
                                    }
                                }
                            }
                        }
                    } else {
                        /* PC-4b: plain struct pattern `S { f, … }` (single-segment
                           path): irrefutable (cond true); extract each field by its
                           real C member name — VMember(scrut, field_name_tok) — not
                           the enum payload p<i> slot used by the 2-segment case. */
                        cexp = Expr::Literal(box_new(Value::VBoolTrue));
                        let meta_idxp: i32 = paux4 - 1;
                        if vec_get(et, meta_idxp) == 32 {
                            let sfcp: i32 = vec_get(ed1, meta_idxp);
                            let first_embp: i32 = vec_get(ed2, meta_idxp);
                            if sfcp > 0 {
                                let mut fjp: i32 = 0;
                                while fjp < sfcp {
                                    let eidxp: i32 = first_embp + fjp;
                                    if vec_get(et, eidxp) == 31 {
                                        if vec_get(ed4, eidxp) == 1 {
                                            let bind_tokp: i32 = vec_get(ed1, eidxp);
                                            let fld_metap: i32 = vec_get(ed3, eidxp);
                                            let mut fnam_tokp: i32 = bind_tokp;
                                            if fld_metap != 0 {
                                                fnam_tokp = fld_metap;
                                            }
                                            if bind_tokp >= 0 {
                                                let rhsvp: Value = Value::VMember(
                                                    box_new(Value::VVar(scrut_var)),
                                                    fnam_tokp);
                                                let asgxp: Instr = Instr::Assign(
                                                    bind_tokp,
                                                    box_new(Expr::Literal(
                                                        box_new(rhsvp))));
                                                vec_push(bind_instrs, box_new(asgxp));
                                            }
                                        }
                                    }
                                    fjp = fjp + 1;
                                }
                            }
                        }
                    }
                } else {
                    cexp = Expr::Literal(box_new(Value::VBoolFalse));
                }
            } else {
                cexp = Expr::Literal(box_new(Value::VBoolFalse));
            }
        }
        let arm_menv: Vec<i32> = lower_match_env_clone(match_env);
        if pat_tag == 1 {
            let dap: i32 = lower_match_env_append_scrut_pair(arm_menv, pat_d1,
                scrut_cty);
        }
        if pat_tag == 5 {
            let paux5s: i32 = vec_get(ed2, arm_idx);
            let pxt5s: i32 = vec_get(et, paux5s);
            if pxt5s == 30 {
                let k5s: i32 = vec_get(ed4, paux5s);
                if k5s == 5 {
                    let pp_c5s: i32 = vec_get(ed2, paux5s);
                    if pp_c5s >= 2 {
                        let pp_s5s: i32 = vec_get(ed1, paux5s);
                        let en_hs: i32 = vec_get(pp, pp_s5s);
                        let vn_hs: i32 = vec_get(pp, pp_s5s + 1);
                        let kvs: i32 = enum_tag_lookup_str(enum_names,
                            enum_tags_flat, enum_tag_offsets,
                            enum_tag_counts, en_hs, vn_hs, source, starts, ends);
                        if kvs >= 0 {
                            let argc5s: i32 = vec_get(ed3, paux5s);
                            if argc5s > 0 {
                                let meta_idx5s: i32 = paux5s - 1;
                                if vec_get(et, meta_idx5s) == 33 {
                                    let ac5s: i32 = vec_get(ed1, meta_idx5s);
                                    let first_e5s: i32 = vec_get(ed2, meta_idx5s);
                                    let mut ejs: i32 = 0;
                                    while ejs < ac5s {
                                        let eidx5s: i32 = first_e5s + ejs;
                                        let etg5s: i32 = vec_get(et, eidx5s);
                                        if etg5s == 31 {
                                            let ipt5s: i32 = vec_get(ed4, eidx5s);
                                            if ipt5s == 1 {
                                                let bind_tok5s: i32 = vec_get(ed1, eidx5s);
                                                let pi5s: i32 = vec_get(ed2, eidx5s);
                                                if bind_tok5s >= 0 {
                                                    if pi5s >= 0 {
                                                        let das: i32 = lower_match_env_append_scrut_pair(
                                                            arm_menv, bind_tok5s, scrut_cty);
                                                    }
                                                }
                                            }
                                        }
                                        ejs = ejs + 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if pat_tag == 4 {
            let paux4s: i32 = vec_get(ed2, arm_idx);
            let pxt4s: i32 = vec_get(et, paux4s);
            if pxt4s == 30 {
                let k4s: i32 = vec_get(ed4, paux4s);
                if k4s == 4 {
                    let pp_c4s: i32 = vec_get(ed2, paux4s);
                    if pp_c4s >= 2 {
                        let pp_s4s: i32 = vec_get(ed1, paux4s);
                        let en_h4s: i32 = vec_get(pp, pp_s4s);
                        let vn_h4s: i32 = vec_get(pp, pp_s4s + 1);
                        let kv4s: i32 = enum_tag_lookup_str(enum_names,
                            enum_tags_flat, enum_tag_offsets,
                            enum_tag_counts, en_h4s, vn_h4s, source, starts, ends);
                        if kv4s >= 0 {
                            let meta_idxs: i32 = paux4s - 1;
                            if vec_get(et, meta_idxs) == 32 {
                                let sfc4s: i32 = vec_get(ed1, meta_idxs);
                                let first_embs: i32 = vec_get(ed2, meta_idxs);
                                if sfc4s > 0 {
                                    let mut fjs: i32 = 0;
                                    while fjs < sfc4s {
                                        let eidxs: i32 = first_embs + fjs;
                                        let etgs: i32 = vec_get(et, eidxs);
                                        if etgs == 31 {
                                            let ipts: i32 = vec_get(ed4, eidxs);
                                            if ipts == 1 {
                                                let bind_toks: i32 = vec_get(ed1, eidxs);
                                                let fld_metas: i32 = vec_get(ed3, eidxs);
                                                let mut fnam_toks: i32 = bind_toks;
                                                if fld_metas != 0 {
                                                    fnam_toks = fld_metas;
                                                }
                                                let pis: i32 = lower_pat_struct_field_payload_index(
                                                    tok_tags, source, starts, ends,
                                                    vn_h4s, sfc4s, fnam_toks);
                                                if bind_toks >= 0 {
                                                    if pis >= 0 {
                                                        let dss: i32 = lower_match_env_append_scrut_pair(
                                                            arm_menv, bind_toks, scrut_cty);
                                                    }
                                                }
                                            }
                                        }
                                        fjs = fjs + 1;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        /* Body-only (no pattern binds prepended). `th` is assembled below as
           binds → (guard | body) so the pattern var is bound BEFORE the guard
           evaluates it — previously the binds lived inside body_is, which the
           guard test wrapped, so a guard referenced the bind before it existed
           (invalid C). */
        let mut body_is: Vec<i32> = vec_new();
        let discard_body: i32 = lower_into_var_instrs(et, ed1, ed2, ed3, ed4, pp,
                                  tok_tags, body_idx, out_var, ctr, body_is,
                                  enum_names, enum_tag_offsets, enum_tag_counts,
                                  enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, arm_menv, import_aliases);
        let mut th: Vec<i32> = vec_new();
        let bli: i32 = vec_len(bind_instrs);
        let mut bi: i32 = 0;
        while bi < bli {
            vec_push(th, vec_get(bind_instrs, bi));
            bi = bi + 1;
        }
        if guard_idx >= 0 {
            /* guard preamble appends to th (after the binds); the guard test then
               wraps the body-only instrs. */
            let ge: Expr = lower_expr_with_instrs(et, ed1, ed2, ed3, ed4, pp,
                                                   tok_tags, guard_idx, ctr,
                                                   th, enum_names,
                                                   enum_tag_offsets,
                                                   enum_tag_counts,
                                                   enum_tags_flat, fn_ctx,
                                                   builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, arm_menv, import_aliases);
            let guard_if: Instr = Instr::IfElse(box_new(ge), body_is,
                                                  result_instrs);
            vec_push(th, box_new(guard_if));
        } else {
            let mut bj: i32 = 0;
            while bj < vec_len(body_is) {
                vec_push(th, vec_get(body_is, bj));
                bj = bj + 1;
            }
        }
        let arm_if: Instr = Instr::IfElse(box_new(cexp), th, result_instrs);
        let mut new_result: Vec<i32> = vec_new();
        vec_push(new_result, box_new(arm_if));
        result_instrs = new_result;
        ai = ai - 1;
    }
    let rlen: i32 = vec_len(result_instrs);
    let mut ri: i32 = 0;
    while ri < rlen {
        vec_push(out_instrs, vec_get(result_instrs, ri));
        ri = ri + 1;
    }
    return 0;
}

/* ── lower_match_ps_peek / skip helpers (signature rescan) ───
   Mirror lexer navigation for ItemFn signatures without depending on
   `parser.sv0` link order in the self-host compilation unit. */

fn lower_match_ps_peek(tags: Vec<i32>, pos: i32) -> i32 {
    if pos >= vec_len(tags) { return 97; }
    return vec_get(tags, pos);
}

fn lower_match_skip_generic_params(tags: Vec<i32>, pos: i32) -> i32 {
    if lower_match_ps_peek(tags, pos) != 38 { return pos; }
    let mut p: i32 = pos + 1;
    let mut depth: i32 = 1;
    while depth > 0 {
        let t: i32 = lower_match_ps_peek(tags, p);
        if t == 97 { return p; }
        if t == 38 { depth = depth + 1; }
        if t == 39 { depth = depth - 1; }
        p = p + 1;
    }
    return p;
}

fn lower_match_skip_bracket_group(tags: Vec<i32>, pos: i32) -> i32 {
    if lower_match_ps_peek(tags, pos) != 10 { return pos; }
    let mut p: i32 = pos + 1;
    let mut depth: i32 = 1;
    while depth > 0 {
        let t: i32 = lower_match_ps_peek(tags, p);
        if t == 97 { return 0 - 1; }
        if t == 10 { depth = depth + 1; }
        if t == 11 { depth = depth - 1; }
        p = p + 1;
    }
    return p;
}

/* Skip a `(` … `)` group honoring nested (), `<>`, and `[]`. */

fn lower_skip_paren_group_with_generics(tags: Vec<i32>, open_pos: i32) -> i32 {
    if lower_match_ps_peek(tags, open_pos) != 6 { return 0 - 1; }
    let mut p: i32 = open_pos + 1;
    let mut depth: i32 = 1;
    while depth > 0 {
        if p >= vec_len(tags) { return 0 - 1; }
        let t: i32 = lower_match_ps_peek(tags, p);
        if t == 97 { return 0 - 1; }
        if t == 38 {
            p = lower_match_skip_generic_params(tags, p);
        } else {
            if t == 10 {
                p = lower_match_skip_bracket_group(tags, p);
            } else {
                if t == 6 { depth = depth + 1; }
                if t == 7 { depth = depth - 1; }
                p = p + 1;
            }
        }
    }
    return p;
}

/* ── lower_scan_fn_ret_ty_tok ─────────────────────────────────
   Given an ItemFn name token index (`name_tok`), locate `->` after
   optional fn generics + the param paren group, and return the **first
   token index** of the return type head (IDENT, `(`, `&`, or `[` open).
   Returns **-1** when the shape is not recognized.  Full `parse_type`
   validation is deferred — this is a match-time best-effort handle. */

fn lower_scan_fn_ret_ty_tok(tok_tags: Vec<i32>, source: string,
                            starts: Vec<i32>, ends: Vec<i32>,
                            name_tok: i32) -> i32 {
    let bound_ok: i32 = vec_len(starts) + vec_len(ends) + string_len(source);
    if bound_ok < 0 { return 0 - 1; }
    let mut p: i32 = name_tok + 1;
    p = lower_match_skip_generic_params(tok_tags, p);
    if lower_match_ps_peek(tok_tags, p) != 6 { return 0 - 1; }
    let after_params: i32 = lower_skip_paren_group_with_generics(tok_tags, p);
    if after_params < 0 { return 0 - 1; }
    if lower_match_ps_peek(tok_tags, after_params) != 19 { return 0 - 1; }
    let p3: i32 = after_params + 1;
    let t0: i32 = lower_match_ps_peek(tok_tags, p3);
    if t0 != 5 {
        if t0 != 6 {
            if t0 != 27 {
                if t0 != 10 { return 0 - 1; }
            }
        }
    }
    return p3;
}

/* Token re-scan for ItemFn parameter names + first type-token index
   per parameter (same walking strategy as checker `scan_fn_param_names`).
   Pushes one name token index and one type-head token index per param.
   Returns 0 on success, -1 on unexpected tokens. */

fn lower_scan_item_fn_param_names_ty_toks(tok_tags: Vec<i32>,
    name_tok_pos: i32, param_count: i32,
    out_param_name_tok: Vec<i32>,
    out_param_ty_head_tok: Vec<i32>) -> i32 {
    if param_count == 0 { return 0; }
    let mut p: i32 = name_tok_pos + 1;
    if vec_get(tok_tags, p) == 38 {
        let mut depth: i32 = 1;
        p = p + 1;
        while depth > 0 {
            let u: i32 = vec_get(tok_tags, p);
            if u == 38 { depth = depth + 1; }
            if u == 39 { depth = depth - 1; }
            p = p + 1;
        }
    }
    if vec_get(tok_tags, p) != 6 { return 0 - 1; }
    p = p + 1;
    let mut found: i32 = 0;
    while found < param_count {
        if vec_get(tok_tags, p) == 77 { p = p + 1; }
        let pt: i32 = vec_get(tok_tags, p);
        if pt != 5 {
            if pt != 86 { return 0 - 1; }
        }
        vec_push(out_param_name_tok, p);
        p = p + 1;
        if vec_get(tok_tags, p) != 14 { return 0 - 1; }
        p = p + 1;
        let ty_head: i32 = p;
        vec_push(out_param_ty_head_tok, ty_head);
        let mut tdepth: i32 = 0;
        let mut done: bool = false;
        while done != true {
            let tt: i32 = vec_get(tok_tags, p);
            if tt == 38 { tdepth = tdepth + 1; p = p + 1; }
            else {
                if tt == 39 { tdepth = tdepth - 1; p = p + 1; }
                else {
                    if tt == 6 { tdepth = tdepth + 1; p = p + 1; }
                    else {
                        if tt == 7 {
                            if tdepth > 0 { tdepth = tdepth - 1; p = p + 1; }
                            else { done = true; }
                        } else {
                            if tt == 12 {
                                if tdepth == 0 { done = true; }
                                else { p = p + 1; }
                            } else { p = p + 1; }
                        }
                    }
                }
            }
        }
        found = found + 1;
        if vec_get(tok_tags, p) == 12 { p = p + 1; }
    }
    return 0;
}

/* ── lower_match_env (packed Vec<i32> — option B) ───────────
   Versioned header + contiguous sub-slices for match-time callee /
   param / scrut tables.  See `doc/transliteration-plan.md` §Lowering
   match environment.  `magic == 0` or `len < 11` = legacy path: build
   `fn_names` / `fn_ret` locally (current `lower_tag_match`). */

fn lower_match_env_hdr_len() -> i32 {
    return 11;
}

fn lower_match_env_magic_legacy() -> i32 {
    return 0;
}

fn lower_match_env_magic_v0() -> i32 {
    return 1297235969;
}

fn lower_match_env_version_v0() -> i32 {
    return 1;
}

fn lower_match_env_is_legacy_path(env: Vec<i32>) -> i32 {
    let n: i32 = vec_len(env);
    let h: i32 = lower_match_env_hdr_len();
    if n < h {
        return 1;
    }
    if vec_get(env, 0) == lower_match_env_magic_legacy() {
        return 1;
    }
    return 0;
}

fn lower_match_env_is_packed_v0(env: Vec<i32>) -> i32 {
    let n: i32 = vec_len(env);
    let h: i32 = lower_match_env_hdr_len();
    if n < h {
        return 0;
    }
    if vec_get(env, 0) != lower_match_env_magic_v0() {
        return 0;
    }
    if vec_get(env, 1) != lower_match_env_version_v0() {
        return 0;
    }
    return 1;
}

fn lower_match_env_alloc_v0_empty_header() -> Vec<i32> {
    let e: Vec<i32> = vec_new();
    vec_push(e, lower_match_env_magic_v0());
    vec_push(e, lower_match_env_version_v0());
    vec_push(e, 0 - 1);
    vec_push(e, 0 - 1);
    vec_push(e, 0);
    vec_push(e, 0 - 1);
    vec_push(e, 0 - 1);
    vec_push(e, 0);
    vec_push(e, 0 - 1);
    vec_push(e, 0 - 1);
    vec_push(e, 0);
    return e;
}

/* Appends parallel `fn_names` / `fn_ret` runs after the v0 header and
   patches `[2]`..`[4]` (`fn_names_base`, `fn_ret_base`, `fn_count`).
   Requires `lower_match_env_is_packed_v0(env)`.  Empty program yields
   `fn_count == 0` and bases **-1**. */

fn lower_match_env_append_top_fn_match_tables(env: Vec<i32>,
    item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>,
    source: string, starts: Vec<i32>, ends: Vec<i32>,
    tok_tags: Vec<i32>) -> i32 {
    if lower_match_env_is_packed_v0(env) != 1 {
        return 0 - 1;
    }
    let names_tmp: Vec<i32> = vec_new();
    let ret_tmp: Vec<i32> = vec_new();
    let discard_tbl: i32 = lower_top_fn_tables_for_match(item_tags,
        item_names, item_d2, source, starts, ends, tok_tags, names_tmp,
        ret_tmp);
    let fc: i32 = vec_len(names_tmp);
    if fc != vec_len(ret_tmp) {
        return 0 - 2;
    }
    if fc == 0 {
        vec_set(env, 2, 0 - 1);
        vec_set(env, 3, 0 - 1);
        vec_set(env, 4, 0);
        return 0;
    }
    let bfn: i32 = vec_len(env);
    let mut i: i32 = 0;
    while i < fc {
        vec_push(env, vec_get(names_tmp, i));
        i = i + 1;
    }
    let brt: i32 = vec_len(env);
    i = 0;
    while i < fc {
        vec_push(env, vec_get(ret_tmp, i));
        i = i + 1;
    }
    vec_set(env, 2, bfn);
    vec_set(env, 3, brt);
    vec_set(env, 4, fc);
    return 0;
}

/* Copies packed callee tables into standalone vecs (tests / tooling;
   `match_scrut_cty` reads callee bases `[2..4]` in the packed vec). */

fn lower_match_env_unpack_fn_tables_for_match(env: Vec<i32>,
    fn_names_out: Vec<i32>, fn_ret_out: Vec<i32>) -> i32 {
    if lower_match_env_is_packed_v0(env) != 1 {
        return 0 - 1;
    }
    let fc: i32 = vec_get(env, 4);
    if fc == 0 {
        return 0;
    }
    let bfn: i32 = vec_get(env, 2);
    let brt: i32 = vec_get(env, 3);
    if bfn < 0 {
        return 0 - 2;
    }
    if brt < 0 {
        return 0 - 3;
    }
    let mut j: i32 = 0;
    while j < fc {
        vec_push(fn_names_out, vec_get(env, bfn + j));
        j = j + 1;
    }
    j = 0;
    while j < fc {
        vec_push(fn_ret_out, vec_get(env, brt + j));
        j = j + 1;
    }
    return 0;
}

/* Appends current ItemFn param name / type-head token runs into `env`
   and patches header `[5]`..`[7]`.  No-op (bases -1, count 0) when
   `item_fn_row < 0`, row is not ItemFn, or `param_count == 0`. */

fn lower_match_env_append_item_fn_param_rows(env: Vec<i32>,
    item_tags: Vec<i32>, item_names: Vec<i32>, item_d3: Vec<i32>,
    tok_tags: Vec<i32>, item_fn_row: i32) -> i32 {
    if lower_match_env_is_packed_v0(env) != 1 {
        return 0 - 1;
    }
    if item_fn_row < 0 {
        vec_set(env, 5, 0 - 1);
        vec_set(env, 6, 0 - 1);
        vec_set(env, 7, 0);
        return 0;
    }
    if item_fn_row >= vec_len(item_tags) {
        return 0 - 2;
    }
    if vec_get(item_tags, item_fn_row) != 0 {
        vec_set(env, 5, 0 - 1);
        vec_set(env, 6, 0 - 1);
        vec_set(env, 7, 0);
        return 0;
    }
    let pc: i32 = vec_get(item_d3, item_fn_row);
    if pc == 0 {
        vec_set(env, 5, 0 - 1);
        vec_set(env, 6, 0 - 1);
        vec_set(env, 7, 0);
        return 0;
    }
    let name_tok: i32 = vec_get(item_names, item_fn_row);
    let pnames: Vec<i32> = vec_new();
    let pty: Vec<i32> = vec_new();
    let rs: i32 = lower_scan_item_fn_param_names_ty_toks(tok_tags, name_tok,
        pc, pnames, pty);
    if rs < 0 { return 0 - 3; }
    if vec_len(pnames) != pc { return 0 - 4; }
    if vec_len(pty) != pc { return 0 - 5; }
    let bn: i32 = vec_len(env);
    let mut j: i32 = 0;
    while j < pc {
        vec_push(env, vec_get(pnames, j));
        j = j + 1;
    }
    let bt: i32 = vec_len(env);
    j = 0;
    while j < pc {
        vec_push(env, vec_get(pty, j));
        j = j + 1;
    }
    vec_set(env, 5, bn);
    vec_set(env, 6, bt);
    vec_set(env, 7, pc);
    return 0;
}

/* Deep copy of a packed `lower_match_env` (header + all tail slices). */

fn lower_match_env_clone(env: Vec<i32>) -> Vec<i32> {
    let n: i32 = vec_len(env);
    let r: Vec<i32> = vec_new();
    let mut i: i32 = 0;
    while i < n {
        vec_push(r, vec_get(env, i));
        i = i + 1;
    }
    return r;
}

/* Append scrut-local name/type pairs from `parent`'s `[8..10]` region
   onto `dst` (packed v0).  No-op when parent is empty, not packed, or
   has `scrut_count == 0`.  Used so nested `match` inherits outer-arm
   scrut bindings. */

fn lower_match_env_merge_parent_scrut(dst: Vec<i32>, parent: Vec<i32>) -> i32 {
    if vec_len(parent) == 0 {
        return 0;
    }
    if lower_match_env_is_packed_v0(parent) != 1 {
        return 0;
    }
    if lower_match_env_is_packed_v0(dst) != 1 {
        return 0 - 1;
    }
    let sc: i32 = vec_get(parent, 10);
    if sc <= 0 {
        return 0;
    }
    let bn: i32 = vec_get(parent, 8);
    let bt: i32 = vec_get(parent, 9);
    if bn < 0 {
        return 0 - 2;
    }
    let dst_bn: i32 = vec_len(dst);
    let mut j: i32 = 0;
    if bt >= 0 {
        while j < sc {
            vec_push(dst, vec_get(parent, bn + j));
            vec_push(dst, vec_get(parent, bt + j));
            j = j + 1;
        }
    } else {
        while j < sc {
            vec_push(dst, vec_get(parent, bn + j * 2));
            vec_push(dst, vec_get(parent, bn + j * 2 + 1));
            j = j + 1;
        }
    }
    vec_set(dst, 8, dst_bn);
    vec_set(dst, 9, 0 - 1);
    vec_set(dst, 10, sc);
    return 0;
}

/* Append one scrut-local `(name_h, ty_h)` as an interleaved tail slice
   starting at `[8]` (`[9]` reserved **-1**).  Pairs occupy `base+2*i`
   (name) and `base+2*i+1` (type). */

fn lower_match_env_append_scrut_pair(env: Vec<i32>, name_h: i32, ty_h: i32) -> i32 {
    if lower_match_env_is_packed_v0(env) != 1 {
        return 0 - 1;
    }
    if name_h < 0 {
        return 0;
    }
    let sc0: i32 = vec_get(env, 10);
    if sc0 == 0 {
        let bsn: i32 = vec_len(env);
        vec_push(env, name_h);
        vec_push(env, ty_h);
        vec_set(env, 8, bsn);
        vec_set(env, 9, 0 - 1);
        vec_set(env, 10, 1);
        return 0;
    }
    vec_push(env, name_h);
    vec_push(env, ty_h);
    vec_set(env, 10, sc0 + 1);
    return 0;
}

/* Bounded scrut-local lookup in packed env `[8..10]` (interleaved). */

fn lower_match_env_scrut_ty_lookup(env: Vec<i32>, limit: i32,
                                   name_h: i32) -> i32 {
    if lower_match_env_is_packed_v0(env) != 1 {
        return 0 - 2;
    }
    let sc: i32 = vec_get(env, 10);
    if sc <= 0 {
        return 0 - 2;
    }
    let bn: i32 = vec_get(env, 8);
    if bn < 0 {
        return 0 - 2;
    }
    let mut lim: i32 = sc;
    if limit < lim {
        lim = limit;
    }
    let mut i: i32 = lim - 1;
    while i >= 0 {
        if vec_get(env, bn + i * 2) == name_h {
            return vec_get(env, bn + i * 2 + 1);
        }
        i = i - 1;
    }
    return 0 - 2;
}

/* ── lower_top_fn_tables_for_match ───────────────────────────
   Push every top-level ItemFn (item tag 0) name handle from the item
   arena in program order into `fn_names`, with a parallel `fn_ret`
   entry holding the **first return-type token** when `item_d2` records
   `has_ret == 1` and token rescan succeeds; otherwise **-1**. */

fn lower_top_fn_tables_for_match(item_tags: Vec<i32>, item_names: Vec<i32>,
                                  item_d2: Vec<i32>,
                                  source: string, starts: Vec<i32>, ends: Vec<i32>,
                                  tok_tags: Vec<i32>,
                                  fn_names: Vec<i32>, fn_ret: Vec<i32>) -> i32 {
    let n: i32 = vec_len(item_tags);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(item_tags, i) == 0 {
            let nm: i32 = vec_get(item_names, i);
            let packed: i32 = vec_get(item_d2, i);
            let has_ret: i32 = packed % 2;
            let mut rh: i32 = 0 - 1;
            if has_ret == 1 {
                let got: i32 = lower_scan_fn_ret_ty_tok(tok_tags, source,
                    starts, ends, nm);
                rh = got;
            }
            vec_push(fn_names, nm);
            vec_push(fn_ret, rh);
        }
        i = i + 1;
    }
    return 0;
}

/* ── lower_tag_match (ExprMatch — tag 11 dispatch)
   SML: ExprMatch(scrut, arms, _) in lowerExprToValue.
   Lowers scrutinee via bind_scrut_var, allocates output temp, delegates
   to lower_match_arms.
   `scrut_cty` comes from match_scrut_cty on the scrutinee expression.
   Packed **`lower_match_env`** holds top-level callee tables **`[2..4]`**
   (**`lower_match_env_append_top_fn_match_tables`**) and, when
   **`item_fn_row >= 0`**, current ItemFn param rows **`[5..7]`**
   (**`lower_match_env_append_item_fn_param_rows`**).  **`match_scrut_cty`**
   reads callee + param slices directly from **`match_env`** (no unpack
   copy).  Scrut-local rows live in **`[8..10]`** (interleaved name/type
   pairs; **`lower_match_env_merge_parent_scrut`** + **`lower_match_env_append_scrut_pair`**).
   Parallel **`scrut_names` / `scrut_ctys` / `scrut_limit`** remain for
   **`test_match_scrut_cty`** only.
   2-seg ExprPath / ExprCall shapes still resolve enum/struct type handles
   via `pp` (ctor scrutinees, paths).
   Tests omitted: SML compiler function budget (~172 fn limit). */

fn lower_tag_match(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                   ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
                   tok_tags: Vec<i32>,
                   idx: i32, ctr: Vec<i32>,
                   out_instrs: Vec<i32>,
                   enum_names: Vec<i32>,
                   enum_tag_offsets: Vec<i32>,
                   enum_tag_counts: Vec<i32>,
                   enum_tags_flat: Vec<i32>,
                   fn_ctx: Vec<i32>,
                   builtin_map: Vec<i32>, lit_sf_names: Vec<i32>,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                    item_field_counts: Vec<i32>,
                    enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                    match_env_inherit: Vec<i32>, import_aliases: Vec<i32>) -> Value {
    let scrut_idx: i32 = vec_get(ed1, idx);
    let arms_first: i32 = vec_get(ed2, idx);
    let arm_count: i32 = vec_get(ed3, idx);
    let arms_sidecar: i32 = vec_get(ed4, idx);
    let match_env: Vec<i32> = lower_match_env_alloc_v0_empty_header();
    let discard_ap: i32 = lower_match_env_append_top_fn_match_tables(
        match_env, item_tags, item_names, item_d2, source, starts, ends,
        tok_tags);
    let discard_pr: i32 = lower_match_env_append_item_fn_param_rows(
        match_env, item_tags, item_names, item_d3, tok_tags, item_fn_row);
    let discard_mg: i32 = lower_match_env_merge_parent_scrut(match_env,
        match_env_inherit);
    let scrut_names_mt: Vec<i32> = vec_new();
    let scrut_ctys_mt: Vec<i32> = vec_new();
    let sct: i32 = match_scrut_cty(et, ed1, ed2, ed3, ed4, scrut_idx, pp,
        match_env, import_aliases,
        scrut_names_mt, scrut_ctys_mt, 0);
    let scrut_var: i32 = bind_scrut_var(et, ed1, ed2, ed3, ed4, pp,
                                         tok_tags, scrut_idx, ctr,
                                         out_instrs, enum_names,
                                         enum_tag_offsets, enum_tag_counts,
                                         enum_tags_flat, fn_ctx,
                                         builtin_map, lit_sf_names,
                                         item_tags, item_names, item_d2,
                                         item_d3, item_d4, item_field_counts,
                                         enum_vnames_flat, enum_max_payloads, item_fn_row,
                                         match_env,
                                         sct, source, starts, ends,
                                         import_aliases);
    let st_scr: i32 = vec_get(et, scrut_idx);
    if st_scr == 1 {
        let pps_s2: i32 = vec_get(ed1, scrut_idx);
        let ppc_s2: i32 = vec_get(ed2, scrut_idx);
        if ppc_s2 == 1 {
            let nh2: i32 = vec_get(pp, pps_s2);
            let dps2: i32 = lower_match_env_append_scrut_pair(match_env,
                nh2, sct);
        }
    }
    let out: i32 = ctr_fresh(ctr);
    let dv: Instr = Instr::DeclVar(out);
    vec_push(out_instrs, box_new(dv));
    /* KC-003 fix: lower_match_arms builds the if/else-if chain with an
       EMPTY final else (the innermost `result_instrs` it starts from,
       used as the last arm's implicit else-branch) -- currently
       unreachable only because the checker enforces match exhaustiveness
       ahead of codegen, but the emitted C left `out` genuinely
       uninitialized on that path, which is real UB if that guarantee
       were ever violated and is exactly what Clang's own
       -Wsometimes-uninitialized correctly flagged (16 occurrences across
       the behavior corpus, confirmed during NEX-049a). A defensive zero
       store here -- `out` is always plain `int` for a match result
       (DeclVar's own emission never gives it another type; see
       megatu_emit_instr's DeclVar case) -- makes every path through the
       chain assign it a defined value, eliminating the UB without
       touching lower_match_arms' own, more delicate arm-by-arm
       plumbing.

       Gated to the C target only (lower_vm_target()==0): the VM has no
       analogous "uninitialized C local" UB (it executes an explicit
       Instr stream, not C stack variables reachable by an unguarded
       fallthrough), and the SML --target=vm golden this native VM
       emitter is byte-compared against has no equivalent extra store --
       found live, not hypothetically, when this fix (originally emitted
       unconditionally) broke tier-2 VM byte-parity for every module
       containing a match expression. Emitting it unconditionally would
       add a real, harmless-but-extra Instr::Store to VM bytecode with
       no VM-side bug to justify it, permanently diverging from the SML
       reference. */
    if lower_vm_target() == 0 {
        let zero_init: Instr = Instr::Store(out, box_new(Expr::Literal(box_new(Value::VInt(0)))));
        vec_push(out_instrs, box_new(zero_init));
    }
    let discard_ma: i32 = lower_match_arms(et, ed1, ed2, ed3, ed4, pp,
                                            tok_tags, arms_first, arm_count,
                                            arms_sidecar,
                                            out, scrut_var, sct, ctr,
                                            out_instrs, enum_names,
                                            enum_tag_offsets, enum_tag_counts,
                                            enum_tags_flat, fn_ctx,
                                            builtin_map, lit_sf_names,
                                            item_tags, item_names, item_d2,
                                            item_d3, item_d4, item_field_counts,
                                            enum_vnames_flat, enum_max_payloads, item_fn_row,
                                            match_env,
                                            source, starts, ends,
                                            import_aliases);
    return Value::VVar(out);
}

/* ── lower_return (SML lowerReturn) ─────────────────────────
   Lowers an expression and emits ReturnVal(v).
   Appends instructions to out_instrs. */

fn lower_return(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
                tok_tags: Vec<i32>,
                idx: i32, ctr: Vec<i32>,
                out_instrs: Vec<i32>,
                enum_names: Vec<i32>,
                enum_tag_offsets: Vec<i32>,
                enum_tag_counts: Vec<i32>,
                enum_tags_flat: Vec<i32>,
                fn_ctx: Vec<i32>,
                builtin_map: Vec<i32>, lit_sf_names: Vec<i32>,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                    item_field_counts: Vec<i32>,
                    enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                    match_env_inherit: Vec<i32>, import_aliases: Vec<i32>) -> i32 {
    /* Bare `return;` (ExprReturn d1 = value_idx = -1) has no value to lower —
       emit ReturnVoid. Without this the -1 index reaches lower_expr_to_value and
       reads et[-1] out of bounds. */
    if idx < 0 {
        let rv: Instr = Instr::ReturnVoid;
        vec_push(out_instrs, box_new(rv));
        return 0;
    }
    let v: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                        tok_tags, idx, ctr, out_instrs,
                                        enum_names, enum_tag_offsets,
                                        enum_tag_counts, enum_tags_flat,
                                        fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    let ri: Instr = Instr::ReturnVal(box_new(v));
    vec_push(out_instrs, box_new(ri));
    return 0;
}

/* ── lower_stmt (SML lowerStmt — simplified) ────────────────
   Processes a single stmt-arena node at `s_idx`.
   LetStmt (27): DeclVar + lower init + Store.
   SemiStmt (28): lower for effect. */

fn lower_stmt(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
              ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
              tok_tags: Vec<i32>,
              s_idx: i32, ctr: Vec<i32>,
              out_instrs: Vec<i32>,
              enum_names: Vec<i32>,
              enum_tag_offsets: Vec<i32>,
              enum_tag_counts: Vec<i32>,
              enum_tags_flat: Vec<i32>,
              fn_ctx: Vec<i32>,
              builtin_map: Vec<i32>, lit_sf_names: Vec<i32>,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                    item_field_counts: Vec<i32>,
                    enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                    match_env_inherit: Vec<i32>, import_aliases: Vec<i32>,
                    str_locals: Vec<i32>) -> i32 {
    let s_tag: i32 = vec_get(et, s_idx);
    if s_tag == 27 {
        let name_tok: i32 = vec_get(ed1, s_idx);
        let init_idx: i32 = vec_get(ed3, s_idx);
        /* A `let` whose init is a struct literal (ExprStruct, tag 24) binds a
           struct value: declare it with the struct's type (DeclNamed) so the C
           variable is the struct type, not int. The typename is the literal's last
           path segment (as in the tag-24 lowering). The let's own type annotation
           is not retained by the parser, so the init shape is the type source. */
        let mut let_declared: i32 = 0;
        /* A `let x = f(..)` whose init is a struct/enum/string-returning USER CALL:
           record the type here but declare x AFTER the init (SML's general path
           lowers the call temp first, so x's slot follows it — like the if-as-value
           reorder). Struct/enum/string LITERAL inits stay decl-first. `deferred_ty`
           holds the C type token (a struct token >=0, or the string sentinel -7),
           so a separate flag marks whether a deferral was requested. */
        let mut deferred_ty: i32 = 0 - 1;
        let mut has_deferred_decl: i32 = 0;
        /* str_let: this let binds a string; its name joins str_locals so later
           `let y = x` aliases resolve to const char* too. */
        let mut str_let: i32 = 0;
        /* init_handled: the init was fully lowered by a special branch (declare +
           init in one), so skip the generic init lowering + Store below. */
        let mut init_handled: i32 = 0;
        if init_idx >= 0 {
            if vec_get(et, init_idx) == 24 {
                let sppc: i32 = vec_get(ed2, init_idx);
                let fc_ls: i32 = vec_get(ed3, init_idx);
                if sppc >= 1 {
                    if fc_ls > 0 {
                        let sty_tok: i32 = vec_get(pp,
                            vec_get(ed1, init_idx) + sppc - 1);
                        let decl_n: Instr = Instr::DeclNamed(sty_tok, name_tok);
                        vec_push(out_instrs, box_new(decl_n));
                        let_declared = 1;
                        /* Construct the struct DIRECTLY into the let var (SML
                           StmtLet ExprStruct: `[DeclNamed(sn,x)] @ per-field
                           StoreField(x,fname,ei)`) — not into a fresh temp that is
                           then copied, which SML never does and which costs a full
                           struct-width of extra locals. Fields interleave
                           spill-then-store, matching SML `pi @ [StoreField]`. */
                        let sf0_ls: i32 = vec_get(ed4, init_idx);
                        let mut fi_ls: i32 = 0;
                        while fi_ls < fc_ls {
                            let ch_ls: i32 = vec_get(lit_sf_names, sf0_ls + fi_ls * 2 + 1);
                            let fv_ls: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                tok_tags, ch_ls, ctr, out_instrs, enum_names, enum_tag_offsets,
                                enum_tag_counts, enum_tags_flat, fn_ctx, builtin_map, lit_sf_names,
                                source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4,
                                item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
                            let fnm_ls: i32 = vec_get(lit_sf_names, sf0_ls + fi_ls * 2);
                            vec_push(out_instrs, box_new(Instr::StoreField(name_tok, fnm_ls,
                                                        box_new(value_to_expr(fv_ls)))));
                            fi_ls = fi_ls + 1;
                        }
                        init_handled = 1;
                    }
                }
            }
            /* Enum nullary constructor init (`let x = Enum::Variant`, 2-seg
               ExprPath): declare x with the enum type and store the tag DIRECTLY
               into x (SML constructs into x, not a temp that is then copied). */
            if vec_get(et, init_idx) == 1 {
                if vec_get(ed2, init_idx) == 2 {
                    let ety_tok: i32 = vec_get(pp, vec_get(ed1, init_idx));
                    let vn_tok_n: i32 = vec_get(pp, vec_get(ed1, init_idx) + 1);
                    vec_push(out_instrs, box_new(Instr::DeclNamed(ety_tok, name_tok)));
                    let k_n: i32 = enum_tag_lookup_str(enum_names, enum_tags_flat,
                                                       enum_tag_offsets, enum_tag_counts,
                                                       ety_tok, vn_tok_n, source, starts, ends);
                    let tag_en: Expr = Expr::Literal(box_new(Value::VInt(k_n)));
                    vec_push(out_instrs, box_new(Instr::StoreField(name_tok, 0 - 1, box_new(tag_en))));
                    /* KC-006 fix (C target only, mirrors KC-003's own gate): a
                       unit-variant ctor (`let e: E = E::B;`) only stores
                       `.tag`, leaving the enum struct's other `.p<i>` payload
                       slots (needed by SOME OTHER variant of E) genuinely
                       uninitialized -- the exact site GitHub CI's Linux/GCC
                       run caught live (enum_match_unit.sv0: "'e.p0' may be
                       used uninitialized"), never surfaced by this dev
                       machine's Clang. Confirmed (via a temporary debug
                       write_file probe) that THIS function is the one that
                       actually lowers that fixture's `let e: E = E::B;` --
                       two other structurally-identical enum-nullary-ctor
                       blocks elsewhere in this file were tried first and
                       ruled out, one of which (in lower_expr_to_value, the
                       general-expression path) triggers an unrelated,
                       pre-existing self-hosting panic ("vec: index out of
                       bounds") when this exact fix shape is added there --
                       deliberately not applied there; flagged as its own
                       follow-up investigation rather than chased down here. */
                    if lower_vm_target() == 0 {
                        let maxp_n: i32 = enum_max_payload_lookup_str(enum_names, enum_max_payloads,
                                                                       ety_tok, source, starts, ends);
                        let mut pzn: i32 = 0;
                        while pzn < maxp_n {
                            let pzn_e: Instr = Instr::StoreField(name_tok, 0 - 10 - pzn,
                                box_new(Expr::Literal(box_new(Value::VInt(0)))));
                            vec_push(out_instrs, box_new(pzn_e));
                            pzn = pzn + 1;
                        }
                    }
                    let_declared = 1;
                    init_handled = 1;
                }
            }
            /* Enum payload constructor init (`let x = Enum::Variant(args)`): declare
               x with the enum type and construct the variant DIRECTLY into x (tag +
               payload StoreFields), as SML does (`[DeclNamed(en,x)] @
               enumConstructInstrs x ...`) — not into a temp that is then copied. */
            if vec_get(et, init_idx) == 4 {
                let callee_ci: i32 = vec_get(ed1, init_idx);
                if vec_get(et, callee_ci) == 1 {
                    if vec_get(ed2, callee_ci) == 2 {
                        let en_tok_c: i32 = vec_get(pp, vec_get(ed1, callee_ci));
                        let vn_tok_c: i32 = vec_get(pp, vec_get(ed1, callee_ci) + 1);
                        vec_push(out_instrs, box_new(Instr::DeclNamed(en_tok_c, name_tok)));
                        let k_c: i32 = enum_tag_lookup_str(enum_names, enum_tags_flat,
                                                           enum_tag_offsets, enum_tag_counts,
                                                           en_tok_c, vn_tok_c, source, starts, ends);
                        /* SML enumConstructInstrs order: lower ALL args first
                           (`inss`), THEN the tag StoreField, THEN the payload
                           StoreFields (`inss @ [tag] @ enumStorePayload`). Emitting
                           the tag store before the args, or interleaving arg
                           lowering with payload stores, misplaces any side-effect
                           instructions an arg spills (e.g. box_new's alloc/stores). */
                        let args_first_c: i32 = vec_get(ed2, init_idx);
                        let args_count_c: i32 = vec_get(ed3, init_idx);
                        let args_sidecar_c: i32 = vec_get(ed4, init_idx);
                        let mut arg_vals_c: Vec<i32> = vec_new();
                        let mut ai_c: i32 = 0;
                        while ai_c < args_count_c {
                            let a_idx_c: i32 = block_stmt_index(pp, args_first_c, args_sidecar_c, ai_c);
                            let av_c: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                tok_tags, a_idx_c, ctr, out_instrs, enum_names, enum_tag_offsets,
                                enum_tag_counts, enum_tags_flat, fn_ctx, builtin_map, lit_sf_names,
                                source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4,
                                item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
                            vec_push(arg_vals_c, box_new(av_c));
                            ai_c = ai_c + 1;
                        }
                        let tag_ec: Expr = Expr::Literal(box_new(Value::VInt(k_c)));
                        vec_push(out_instrs, box_new(Instr::StoreField(name_tok, 0 - 1, box_new(tag_ec))));
                        let mut pi_c: i32 = 0;
                        while pi_c < args_count_c {
                            let pv_c: Value = box_deref(vec_get(arg_vals_c, pi_c));
                            let fs_c: i32 = 0 - 10 - pi_c;
                            vec_push(out_instrs, box_new(Instr::StoreField(name_tok, fs_c,
                                                        box_new(value_to_expr(pv_c)))));
                            pi_c = pi_c + 1;
                        }
                        let_declared = 1;
                        init_handled = 1;
                    }
                }
            }
            /* String-typed let (string literal, string-returning builtin call, or a
               block/if-expr whose value is a string): declare `const char*`. */
            if lower_expr_yields_string(et, ed1, ed2, ed3, pp, init_idx, item_tags, item_names, item_d2, tok_tags, source, starts, ends) {
                /* SML's general let path declares a string local AFTER lowering the
                   init, so any temps the init spilled (a builtin/user call, an
                   if-block value) get the earlier slots. Defer the DeclNamed to the
                   init block below; a literal init has no temps so the order is moot. */
                deferred_ty = lower_string_cty();
                has_deferred_decl = 1;
                let_declared = 1;
                str_let = 1;
            }
            /* String-returning user-function call init: same const char* decl. */
            if let_declared == 0 {
                if lower_call_ret_is_string(et, ed1, ed2, pp, init_idx,
                        item_tags, item_names, item_d2, tok_tags,
                        source, starts, ends) {
                    let decl_su: Instr = Instr::DeclNamed(lower_string_cty(), name_tok);
                    vec_push(out_instrs, box_new(decl_su));
                    let_declared = 1;
                    str_let = 1;
                }
            }
            /* `let x = str_param` aliasing a string-typed parameter. */
            if let_declared == 0 {
                if lower_init_ident_is_string_param(et, ed1, ed2, pp, init_idx,
                        item_tags, item_names, item_d3, tok_tags,
                        source, starts, ends, item_fn_row) {
                    let decl_sp: Instr = Instr::DeclNamed(lower_string_cty(), name_tok);
                    vec_push(out_instrs, box_new(decl_sp));
                    let_declared = 1;
                    str_let = 1;
                }
            }
            /* `let x = str_local` aliasing an earlier string-typed local. */
            if let_declared == 0 {
                if lower_ident_in_str_locals(et, ed1, ed2, pp, init_idx,
                        str_locals, source, starts, ends) {
                    let decl_sl: Instr = Instr::DeclNamed(lower_string_cty(), name_tok);
                    vec_push(out_instrs, box_new(decl_sl));
                    let_declared = 1;
                    str_let = 1;
                }
            }
            /* `let x = f(..)` where f returns a user struct/enum: declare x with
               that type (the call temp is typed likewise via the Call rt_h). */
            if let_declared == 0 {
                let uty_ls: i32 = lower_call_ret_user_ty_tok(et, ed1, ed2, pp,
                    init_idx, item_tags, item_names, item_d2, tok_tags,
                    source, starts, ends);
                if uty_ls >= 0 {
                    /* Record the type; emit DeclNamed AFTER the init (below) so the
                       call temp gets the earlier slot, as SML does. */
                    deferred_ty = uty_ls;
                    has_deferred_decl = 1;
                }
            }
            /* `let x = rcv.m(..)` where method m returns a user struct/enum:
               same deferred typed DeclNamed as the tag-4 call path (methods
               lower to free fns, so the method-name return scan matches). */
            if let_declared == 0 {
                let mty_ls: i32 = lower_mcall_ret_user_ty_tok(et, ed2,
                    init_idx, item_tags, item_names, item_d2, tok_tags,
                    source, starts, ends);
                if mty_ls >= 0 {
                    deferred_ty = mty_ls;
                    has_deferred_decl = 1;
                }
            }
            /* `let x: T = box_deref(bv)` with T a user struct/enum: emit a single
               typed box_deref Call (declare + reconstruct element type T). */
            if let_declared == 0 {
                let bd: i32 = lower_typed_box_deref_let(et, ed1, ed2, ed3, ed4, pp,
                    tok_tags, init_idx, name_tok, vec_get(ed2, s_idx), ctr,
                    out_instrs, enum_names, enum_tag_offsets, enum_tag_counts,
                    enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source,
                    starts, ends, item_tags, item_names, item_d2, item_d3, item_d4,
                    item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row,
                    match_env_inherit, import_aliases);
                if bd == 1 {
                    let_declared = 1;
                    init_handled = 1;
                }
            }
            /* `let x: <i64/u64/u32/f32/f64/...> = <anything not already
               special-cased above>;` — mirrors the identical fix in
               lower_tag_block (nested blocks); see that copy's comment and
               BUGS.md #7, sv0-mathlib, for the full rationale. */
            if let_declared == 0 {
                let ann_tok_ls: i32 = vec_get(ed2, s_idx);
                if ann_tok_ls >= 0 {
                    if lower_tok_in_bounds(ann_tok_ls, starts, ends) {
                        let ann_name_ls: string = handle_to_str(ann_tok_ls, source, starts, ends);
                        if is_wide_primitive_ty_name(ann_name_ls) {
                            deferred_ty = ann_tok_ls;
                            has_deferred_decl = 1;
                        }
                    }
                }
            }
        }
        if str_let == 1 {
            vec_push(str_locals, name_tok);
        }
        /* SML lowerStmt StmtLet: lower the initializer FIRST, then declare the
           let variable (its VM slot is allocated after any temps the init spilled,
           e.g. the result temps of `let y = if c { a } else { b }`). Declaring x up
           front gives it the lower slot and diverges the bytecode. DeclVar is
           skipped when a struct/enum/string special case already emitted DeclNamed. */
        if init_idx >= 0 {
            if init_handled == 0 {
                let e: Expr = lower_expr_with_instrs(et, ed1, ed2, ed3, ed4, pp,
                                                       tok_tags, init_idx, ctr,
                                                       out_instrs, enum_names,
                                                       enum_tag_offsets,
                                                       enum_tag_counts,
                                                       enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
                if has_deferred_decl == 1 {
                    vec_push(out_instrs, box_new(Instr::DeclNamed(deferred_ty, name_tok)));
                } else {
                    if let_declared == 0 {
                        vec_push(out_instrs, box_new(Instr::DeclVar(name_tok)));
                    }
                }
                let si: Instr = Instr::Store(name_tok, box_new(e));
                vec_push(out_instrs, box_new(si));
            }
        } else {
            if let_declared == 0 {
                vec_push(out_instrs, box_new(Instr::DeclVar(name_tok)));
            }
        }
        return 0;
    }
    if s_tag == 28 {
        let expr_idx: i32 = vec_get(ed1, s_idx);
        /* `return e;` as a statement must emit a Return instr (SML lowerStmt
           StmtSemi(ExprReturn)). lower_for_effect lowers for value + discards,
           dropping the return. Route the return's value through lower_return. */
        if vec_get(et, expr_idx) == 15 {
            let ret_val: i32 = vec_get(ed1, expr_idx);
            return lower_return(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                ret_val, ctr, out_instrs, enum_names,
                                enum_tag_offsets, enum_tag_counts,
                                enum_tags_flat, fn_ctx, builtin_map, lit_sf_names,
                                source, starts, ends, item_tags, item_names,
                                item_d2, item_d3, item_d4, item_field_counts,
                                enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit,
                                import_aliases);
        }
        let rc: i32 = lower_for_effect(et, ed1, ed2, ed3, ed4, pp,
                                        tok_tags, expr_idx, ctr,
                                        out_instrs, enum_names,
                                        enum_tag_offsets, enum_tag_counts,
                                        enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        return 0;
    }
    return 0;
}

/* ── lower_block (SML lowerBlock) ───────────────────────────
   Processes stmts via lower_stmt, optional tail via lower_return.
   stmts_first/stmts_count/tail_idx come from ExprBlock d1/d2/d3. */

fn lower_block(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
               ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
               tok_tags: Vec<i32>,
               stmts_first: i32, stmts_count: i32, tail_idx: i32,
               block_sidecar: i32,
               ctr: Vec<i32>,
               out_instrs: Vec<i32>,
               enum_names: Vec<i32>,
               enum_tag_offsets: Vec<i32>,
               enum_tag_counts: Vec<i32>,
               enum_tags_flat: Vec<i32>,
               fn_ctx: Vec<i32>,
               builtin_map: Vec<i32>, lit_sf_names: Vec<i32>,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                    item_field_counts: Vec<i32>,
                    enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                    match_env_inherit: Vec<i32>, import_aliases: Vec<i32>) -> i32 {
    let mut si: i32 = 0;
    /* Running set of string-typed local name tokens for this block, so a later
       `let y = x` aliasing an earlier string local declares const char*. */
    let str_locals: Vec<i32> = vec_new();
    loop {
        if si >= stmts_count { break; }
        let s_idx: i32 = block_stmt_index(pp, stmts_first, block_sidecar, si);
        let rc: i32 = lower_stmt(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                  s_idx, ctr, out_instrs, enum_names,
                                  enum_tag_offsets, enum_tag_counts,
                                  enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases, str_locals);
        si = si + 1;
    }
    if tail_idx >= 0 {
        let rc2: i32 = lower_return(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                     tail_idx, ctr, out_instrs,
                                     enum_names, enum_tag_offsets,
                                     enum_tag_counts, enum_tags_flat,
                                     fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    }
    return 0;
}

/* ── lower_body (SML lowerBody) ─────────────────────────────
   If body_idx points to ExprBlock, use lower_block;
   otherwise treat it as a single return expression. */

fn lower_body(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
              ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
              tok_tags: Vec<i32>,
              body_idx: i32, ctr: Vec<i32>,
              out_instrs: Vec<i32>,
              enum_names: Vec<i32>,
              enum_tag_offsets: Vec<i32>,
              enum_tag_counts: Vec<i32>,
              enum_tags_flat: Vec<i32>,
              fn_ctx: Vec<i32>,
              builtin_map: Vec<i32>, lit_sf_names: Vec<i32>,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                    item_field_counts: Vec<i32>,
                    enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                    match_env_inherit: Vec<i32>, import_aliases: Vec<i32>) -> i32 {
    let btag: i32 = vec_get(et, body_idx);
    if btag == 9 {
        let sf: i32 = vec_get(ed1, body_idx);
        let sc: i32 = vec_get(ed2, body_idx);
        let ti: i32 = vec_get(ed3, body_idx);
        let sidecar: i32 = vec_get(ed4, body_idx);
        return lower_block(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                           sf, sc, ti, sidecar, ctr, out_instrs,
                           enum_names, enum_tag_offsets,
                           enum_tag_counts, enum_tags_flat,
                           fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    }
    return lower_return(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                        body_idx, ctr, out_instrs,
                        enum_names, enum_tag_offsets,
                        enum_tag_counts, enum_tags_flat,
                        fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
}

/* ── lower_fn (SML lowerFn — simplified, no contracts) ──────
   Lowers a function body.  The caller provides the per-function
   expression arena (et/ed1-ed4), the path pool (pp), and the
   token tags array.  body_idx is the root expression index.
   out_instrs accumulates the lowered instructions. */

fn lower_fn(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
            ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
            tok_tags: Vec<i32>,
            body_idx: i32, fn_name_h: i32,
            req_roots: Vec<i32>, ens_roots: Vec<i32>,
            out_instrs: Vec<i32>,
            enum_names: Vec<i32>,
            enum_tag_offsets: Vec<i32>,
            enum_tag_counts: Vec<i32>,
            enum_tags_flat: Vec<i32>,
            fn_ctx: Vec<i32>,
            builtin_map: Vec<i32>, lit_sf_names: Vec<i32>,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
                    item_field_counts: Vec<i32>,
                    enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                    match_env_inherit: Vec<i32>, import_aliases: Vec<i32>) -> i32 {
    let mut ctr: Vec<i32> = vec_new();
    /* Start the temp counter above the token-index range so synthetic temps
       never collide with source-var handles (see lower_temp_base). */
    vec_push(ctr, lower_temp_base());
    let req_instrs: Vec<i32> = vec_new();
    let mut ri: i32 = 0;
    while ri < vec_len(req_roots) {
        let r_idx: i32 = vec_get(req_roots, ri);
        let re: Expr = lower_expr_with_instrs(et, ed1, ed2, ed3, ed4, pp,
                                              tok_tags, r_idx, ctr, req_instrs,
                                              enum_names, enum_tag_offsets,
                                              enum_tag_counts, enum_tags_flat,
                                              fn_ctx, builtin_map, lit_sf_names,
                                              source, starts, ends, item_tags,
                                              item_names, item_d2, item_d3,
                                              item_d4, item_field_counts,
                                              enum_vnames_flat, enum_max_payloads, item_fn_row,
                                              match_env_inherit, import_aliases);
        vec_push(req_instrs, box_new(Instr::Requires(box_new(re), fn_name_h)));
        ri = ri + 1;
    }
    let body_instrs: Vec<i32> = vec_new();
    let rc_body: i32 = lower_body(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                  body_idx, ctr, body_instrs,
                                  enum_names, enum_tag_offsets,
                                  enum_tag_counts, enum_tags_flat,
                                  fn_ctx, builtin_map, lit_sf_names, source,
                                  starts, ends, item_tags, item_names, item_d2,
                                  item_d3, item_d4, item_field_counts,
                                  enum_vnames_flat, enum_max_payloads, item_fn_row,
                                  match_env_inherit, import_aliases);
    if rc_body != 0 { return rc_body; }
    let mut mentions_res: bool = false;
    let mut ei: i32 = 0;
    while ei < vec_len(ens_roots) {
        if mentions_result(et, ed1, ed2, ed3, ed4, vec_get(ens_roots, ei),
                           source, starts, ends, pp) {
            mentions_res = true;
        }
        ei = ei + 1;
    }
    let use_slot: bool = use_ret_slot(false, mentions_res);
    let mut ret_slot: i32 = 0 - 1;
    let decl_instrs: Vec<i32> = vec_new();
    if use_slot {
        let mut rh: i32 = 0 - 1;
        let mut rk: i32 = 0;
        while rk < vec_len(ens_roots) {
            let c: i32 = first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                                  vec_get(ens_roots, rk),
                                                  source, starts, ends, pp);
            if c >= 0 { rh = c; }
            rk = rk + 1;
        }
        if rh >= 0 {
            ret_slot = rh;
        } else {
            ret_slot = ctr_fresh(ctr);
        }
        /* VMF-014a: declare the `result` slot with the function's real return
           type when it is not a plain i32/bool/unit. A bare DeclVar leaves it
           a scalar (width 1, no struct field layout), which the C backend
           papers over via its tyenv but the VM emitter does not -- so
           `ensures(result.re == a && result.im == b)` on a struct-returning
           fn failed to VM-emit (emit_member_load_from_var on `result` found a
           width-1 scalar slot). DeclNamed with a wide primitive is also more
           correct for the C side (`double result;` not `int result;`). */
        let rtt: i32 = lower_scan_fn_ret_ty_tok(tok_tags, source, starts, ends,
                                                fn_name_h);
        let mut use_named: bool = false;
        if rtt >= 0 {
            let rtn: string = handle_to_str(rtt, source, starts, ends);
            if string_eq(rtn, "i32") != true {
                if string_eq(rtn, "bool") != true {
                    if string_eq(rtn, "unit") != true {
                        use_named = true;
                    }
                }
            }
        }
        if use_named {
            vec_push(decl_instrs, box_new(Instr::DeclNamed(rtt, ret_slot)));
        } else {
            vec_push(decl_instrs, box_new(Instr::DeclVar(ret_slot)));
        }
    }
    let ens_instrs: Vec<i32> = vec_new();
    let mut ej: i32 = 0;
    while ej < vec_len(ens_roots) {
        let discard_ens: i32 = lower_ensures_clause(
            et, ed1, ed2, ed3, ed4, pp, tok_tags, vec_get(ens_roots, ej),
            use_slot, fn_name_h, ctr, ens_instrs, enum_names,
            enum_tag_offsets, enum_tag_counts, enum_tags_flat, fn_ctx,
            builtin_map, lit_sf_names, source, starts, ends, item_tags,
            item_names, item_d2, item_d3, item_d4, item_field_counts,
            enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        ej = ej + 1;
    }
    let body_final: Vec<i32> = inject_ensures_and_ret_slot(
        body_instrs, ens_instrs, use_slot, ret_slot);
    let discard_append_decl: i32 = append_instrs(out_instrs, decl_instrs);
    let discard_append_req: i32 = append_instrs(out_instrs, req_instrs);
    let discard_append_body: i32 = append_instrs(out_instrs, body_final);
    return 0;
}

/* ── build_builtin_map ──────────────────────────────────────────
   Pre-scans the token stream and builds a Vec<i32> indexed by
   token position.  For each IDENT token that names a builtin,
   stores the 1-based builtin ID (checker_id + 1); 0 otherwise.
   IDs 1–13 mirror checker.sv0 builtin_fn_lookup (0–12) shifted
   by +1.  ID 14 = no_alias.     IDs 15–17 = read_file / write_file / read_dir (host I/O; VM
   CALL_BUILTIN 15–17). ID 18 = write_bytes (C/native-only, no VM
   CALL_BUILTIN case). ID 19 = getenv (NEX-055c; C/native-only, same as
   write_bytes -- no VM CALL_BUILTIN case, since a host-env read has no
   meaningful role in .sv0b/VM execution).
   `old` requires structural AST matching and is handled separately. */

fn build_builtin_map_classify(s: string) -> i32 {
    if string_eq(s, "println") { return 1; }
    if string_eq(s, "string_len") { return 2; }
    if string_eq(s, "string_eq") { return 3; }
    if string_eq(s, "string_concat") { return 4; }
    if string_eq(s, "string_char_at") { return 5; }
    if string_eq(s, "string_substr") { return 6; }
    if string_eq(s, "vec_new") { return 7; }
    if string_eq(s, "vec_push") { return 8; }
    if string_eq(s, "vec_len") { return 9; }
    if string_eq(s, "vec_get") { return 10; }
    if string_eq(s, "vec_set") { return 11; }
    if string_eq(s, "box_new") { return 12; }
    if string_eq(s, "box_deref") { return 13; }
    if string_eq(s, "no_alias") { return 14; }
    if string_eq(s, "read_file") { return 15; }
    if string_eq(s, "write_file") { return 16; }
    if string_eq(s, "read_dir") { return 17; }
    if string_eq(s, "write_bytes") { return 18; }
    if string_eq(s, "getenv") { return 19; }
    return 0;
}

fn build_builtin_map(tok_tags: Vec<i32>, source: string,
                     starts: Vec<i32>, ends: Vec<i32>) -> Vec<i32> {
    let n: i32 = vec_len(tok_tags);
    let mut bm: Vec<i32> = vec_new();
    let mut i: i32 = 0;
    while i < n {
        let mut bid: i32 = 0;
        if vec_get(tok_tags, i) == 5 {
            let s: string = handle_to_str(i, source, starts, ends);
            bid = build_builtin_map_classify(s);
        }
        vec_push(bm, bid);
        i = i + 1;
    }
    return bm;
}

/* ── lower (SML Lowering.lower — top-level program lowering) ──
   Orchestrates the full lowering pass over a parsed program.
   Builds struct/enum infrastructure, collects C typedefs, and
   iterates ItemFn items to produce IR block metadata.

   Body lowering uses the shared `body_et`/`body_ed*` arenas plus the
   parser path pool `body_pp` (same `pp` passed to `parse_program` /
   `parse_fn_body`) so ExprPath indices resolve.  Callers must supply
   arenas and `body_pp` from the same parse pass.

   Output:
     out_block_labels — one name handle per ItemFn (insertion order)
     out_struct_names / out_struct_offsets / out_struct_counts /
       out_struct_flat — struct field-order data for downstream helpers
     out_enum_names / out_enum_tag_offsets / out_enum_tag_flat /
       out_enum_max — enum variant data
   Returns the typedefs string (C typedef declarations). */

/* Any source token within an expr subtree (BH-10a): recurse down the leftmost
   child to a leaf (ExprPath/ExprLit) that carries a token. Used only to locate a
   contract clause in the token stream. Returns -1 if the subtree has no leaf
   token (never the case for a contract condition). */
fn expr_any_tok(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>, ed3: Vec<i32>,
                pp: Vec<i32>, idx: i32) -> i32 {
    if idx < 0 { return 0 - 1; }
    if idx >= vec_len(et) { return 0 - 1; }
    let tag: i32 = vec_get(et, idx);
    if tag == 0 { return vec_get(ed2, idx); }
    if tag == 1 {
        let pps: i32 = vec_get(ed1, idx);
        if pps < 0 { return 0 - 1; }
        if pps >= vec_len(pp) { return 0 - 1; }
        return vec_get(pp, pps);
    }
    if tag == 2 { return expr_any_tok(et, ed1, ed2, ed3, pp, vec_get(ed2, idx)); }
    if tag == 3 { return expr_any_tok(et, ed1, ed2, ed3, pp, vec_get(ed2, idx)); }
    if tag == 4 { return expr_any_tok(et, ed1, ed2, ed3, pp, vec_get(ed1, idx)); }
    if tag == 5 { return expr_any_tok(et, ed1, ed2, ed3, pp, vec_get(ed1, idx)); }
    if tag == 6 { return expr_any_tok(et, ed1, ed2, ed3, pp, vec_get(ed1, idx)); }
    if tag == 8 { return expr_any_tok(et, ed1, ed2, ed3, pp, vec_get(ed1, idx)); }
    return 0 - 1;
}

/* Contract clause kind for a contract-expr root (BH-10a): find a token inside the
   expr, then scan the token stream BACKWARD to the nearest requires(83) /
   ensures(61) / loop_invariant(73) keyword. Those keywords sit immediately before
   the clause's `(` and never occur inside an expression, so the nearest preceding
   one is exactly this clause's kind. The native parser stores contract roots but
   not their kind; this recovers it without threading a kind array through the
   whole parser. Returns 83/61/73, or -1. */
fn contract_kw_pos_of_root(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>, ed3: Vec<i32>,
                           pp: Vec<i32>, tok_tags: Vec<i32>, root: i32) -> i32 {
    let anytok: i32 = expr_any_tok(et, ed1, ed2, ed3, pp, root);
    if anytok < 0 { return 0 - 1; }
    let mut t: i32 = anytok;
    while t >= 0 {
        let tg: i32 = vec_get(tok_tags, t);
        if tg == 83 { return t; }
        if tg == 61 { return t; }
        if tg == 73 { return t; }
        t = t - 1;
    }
    return 0 - 1;
}

/* A contract clause is "advanced" if its condition uses a quantifier
   (exists=63 / forall=67) or old(80). The native emit does not yet lower those
   (SML does), so BH-10a scopes to simple requires/ensures and DROPS advanced
   clauses (leaving them unchecked, as before) rather than emitting invalid C.
   Scans the clause's `( … )` range from its keyword; LPAREN=6, RPAREN=7. */
fn contract_is_advanced(tok_tags: Vec<i32>, kw_pos: i32) -> bool {
    let n: i32 = vec_len(tok_tags);
    let mut t: i32 = kw_pos + 1;
    let mut depth: i32 = 0;
    while t < n {
        let tg: i32 = vec_get(tok_tags, t);
        if tg == 6 { depth = depth + 1; }
        if tg == 7 {
            depth = depth - 1;
            if depth == 0 { return false; }
        }
        if tg == 63 { return true; }
        if tg == 67 { return true; }
        if tg == 80 { return true; }
        t = t + 1;
    }
    return false;
}

/* String equality of two source tokens' identifier text (BH-11a). Two occurrences
   of the same name are DIFFERENT tokens, so fn_ctx lookups must compare by text. */
fn lower_tok_str_eq(source: string, starts: Vec<i32>, ends: Vec<i32>,
                    a: i32, b: i32) -> bool {
    if a < 0 { return false; }
    if b < 0 { return false; }
    if a >= vec_len(starts) { return false; }
    if b >= vec_len(starts) { return false; }
    let as2: i32 = vec_get(starts, a);
    let ae: i32 = vec_get(ends, a);
    let bs: i32 = vec_get(starts, b);
    let be: i32 = vec_get(ends, b);
    return string_eq(string_substr(source, as2, ae - as2),
                     string_substr(source, bs, be - bs));
}

/* True if `tok`'s identifier text names a declared enum (out_enum_names is a flat
   list of enum name tokens). Used to decide whether a fn's return type is an enum
   for the `?`-operator fn_ctx (BH-11a). */
fn lower_name_is_enum(enum_names: Vec<i32>, tok: i32,
                      source: string, starts: Vec<i32>, ends: Vec<i32>) -> bool {
    if tok < 0 { return false; }
    if tok >= vec_len(starts) { return false; }
    let ts: i32 = vec_get(starts, tok);
    let te: i32 = vec_get(ends, tok);
    if te <= ts { return false; }
    let nm: string = string_substr(source, ts, te - ts);
    let ne: i32 = vec_len(enum_names);
    let mut j: i32 = 0;
    while j < ne {
        let et: i32 = vec_get(enum_names, j);
        if et >= 0 {
            if et < vec_len(starts) {
                let es: i32 = vec_get(starts, et);
                let ee: i32 = vec_get(ends, et);
                if string_eq(nm, string_substr(source, es, ee - es)) { return true; }
            }
        }
        j = j + 1;
    }
    return false;
}

/* 1-based source line of a byte position (M4-S-024 verified-mode contract id). */
fn lower_line_of_pos(source: string, pos: i32) -> i32 {
    let n: i32 = string_len(source);
    let mut line: i32 = 1;
    let mut i: i32 = 0;
    while i < pos {
        if i >= n { return line; }
        if string_char_at(source, i) == 10 { line = line + 1; }
        i = i + 1;
    }
    return line;
}

/* Is `line` in the proven-ensures set (verified mode)? */
fn lower_proven_has(proven_lines: Vec<i32>, line: i32) -> bool {
    let n: i32 = vec_len(proven_lines);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(proven_lines, i) == line { return true; }
        i = i + 1;
    }
    return false;
}

fn lower(item_tags: Vec<i32>, item_names: Vec<i32>,
         item_d2: Vec<i32>, item_d3: Vec<i32>, item_d4: Vec<i32>,
         item_field_counts: Vec<i32>, item_vmax: Vec<i32>,
         struct_fnames_flat: Vec<i32>, enum_vnames_flat: Vec<i32>,
         sf_names: Vec<i32>, sf_types: Vec<i32>,
         source: string, starts: Vec<i32>, ends: Vec<i32>,
         out_block_labels: Vec<i32>,
         out_struct_names: Vec<i32>,
         out_struct_offsets: Vec<i32>,
         out_struct_counts: Vec<i32>,
         out_struct_flat: Vec<i32>,
         out_enum_names: Vec<i32>,
         out_enum_tag_offsets: Vec<i32>,
         out_enum_tag_counts: Vec<i32>,
         out_enum_tag_flat: Vec<i32>,
         out_enum_max: Vec<i32>,
         body_et: Vec<i32>, body_ed1: Vec<i32>,
         body_ed2: Vec<i32>,          body_ed3: Vec<i32>,
         body_ed4: Vec<i32>, body_sf: Vec<i32>,
         body_pp: Vec<i32>,
         tok_tags: Vec<i32>,
         out_blocks: Vec<i32>,
         import_aliases: Vec<i32>,
         fn_contract_root: Vec<i32>,
         fn_contract_base: Vec<i32>,
         fn_ret_ty_root: Vec<i32>,
         pty_tt: Vec<i32>, pty_td1: Vec<i32>,
         contract_mode: i32, proven_lines: Vec<i32>,
         enum_variant_payload_count_by_variant: Vec<i32>,
         enum_variant_payload_ty_name_tok: Vec<i32>) -> string {
    /* contract_mode (M4-S-023/024): 0 = runtime (emit all contract checks — the
       default), 1 = verified (drop `ensures` whose source line is in proven_lines,
       keep everything else), 2 = disabled (drop all requires + ensures runtime
       checks). */
    /* Merge ItemUse value imports into any caller-provided alias table
       (SML lowering sees resolver importAliases ∪ synthetic use rows). */
    let discard_fill_alias: i32 = lower_fill_import_aliases_from_use_items(
        import_aliases, item_tags, item_names, item_d2, item_d3, body_pp,
        source, starts, ends);
    let discard_so: i32 = build_struct_order(item_tags, item_names,
                                              item_field_counts,
                                              struct_fnames_flat,
                                              out_struct_names,
                                              out_struct_offsets,
                                              out_struct_counts,
                                              out_struct_flat);
    let discard_ev: i32 = build_enum_variants_data(item_tags, item_names,
                                                    item_field_counts,
                                                    item_vmax,
                                                    enum_vnames_flat,
                                                    out_enum_names,
                                                    out_enum_tag_offsets,
                                                    out_enum_tag_counts,
                                                    out_enum_tag_flat,
                                                    out_enum_max);
    let typedefs: string = collect_typedefs_str(item_tags, item_names,
                                                 item_field_counts,
                                                 item_vmax,
                                                 sf_names, sf_types,
                                                 source, starts, ends,
                                                 out_struct_names,
                                                 out_enum_names,
                                                 item_d3,
                                                 enum_variant_payload_count_by_variant,
                                                 enum_variant_payload_ty_name_tok);
    let has_body_arenas: i32 = vec_len(body_et);
    let mut builtin_map: Vec<i32> = vec_new();
    if has_body_arenas > 0 {
        builtin_map = build_builtin_map(tok_tags, source, starts, ends);
    }
    let fn_ctx: Vec<i32> = vec_new();
    let n: i32 = vec_len(item_tags);
    /* BH-11a: fn_ctx = [count, name_0..name_{c-1}, enum_0..enum_{c-1}] for each
       ENUM-returning fn (name token -> its return enum's name token). lower_tag_try
       uses it to type a `?` operand: `f()?` via the callee's entry, and a bare
       `o?` via the CURRENT fn's entry (`?` propagates the same enum the fn
       returns). Populated from fn_ret_ty_root + the pty arena. */
    let ctx_names: Vec<i32> = vec_new();
    let ctx_enums: Vec<i32> = vec_new();
    let mut ci: i32 = 0;
    while ci < n {
        if vec_get(item_tags, ci) == 0 {
            if ci < vec_len(fn_ret_ty_root) {
                let rroot: i32 = vec_get(fn_ret_ty_root, ci);
                if rroot >= 0 {
                    if rroot < vec_len(pty_tt) {
                        if vec_get(pty_tt, rroot) == 0 {
                            let rpps: i32 = vec_get(pty_td1, rroot);
                            if rpps >= 0 {
                                if rpps < vec_len(body_pp) {
                                    let rtok: i32 = vec_get(body_pp, rpps);
                                    if lower_name_is_enum(out_enum_names, rtok,
                                                          source, starts, ends) {
                                        vec_push(ctx_names, vec_get(item_names, ci));
                                        vec_push(ctx_enums, rtok);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        ci = ci + 1;
    }
    vec_push(fn_ctx, vec_len(ctx_names));
    let mut ck: i32 = 0;
    while ck < vec_len(ctx_names) {
        vec_push(fn_ctx, vec_get(ctx_names, ck));
        ck = ck + 1;
    }
    ck = 0;
    while ck < vec_len(ctx_enums) {
        vec_push(fn_ctx, vec_get(ctx_enums, ck));
        ck = ck + 1;
    }
    let mut i: i32 = 0;
    while i < n {
        if vec_get(item_tags, i) == 0 {
            let label_h: i32 = vec_get(item_names, i);
            vec_push(out_block_labels, label_h);
            let body_root: i32 = vec_get(item_d4, i);
            let instrs: Vec<i32> = vec_new();
            /* BH-10a: route this fn's contracts to lowering. The parser stores all
               clause roots flat in fn_contract_root[base .. base+count) (base =
               fn_contract_base[i], count = item_d2[i]/2) without their kind;
               recover requires(83)/ensures(61) per clause and split — loop_invariant
               (73) is not a fn-level contract and is dropped. lower_fn then builds
               Instr::Requires/Ensures, which the emit turns into sv0_requires/
               sv0_ensures. Previously both were passed empty, silently dropping
               every runtime contract. */
            let req_roots: Vec<i32> = vec_new();
            let ens_roots: Vec<i32> = vec_new();
            if i < vec_len(fn_contract_base) {
                let cbase: i32 = vec_get(fn_contract_base, i);
                if cbase >= 0 {
                    let ccount: i32 = vec_get(item_d2, i) / 2;
                    let mut cj: i32 = 0;
                    while cj < ccount {
                        let croot: i32 = vec_get(fn_contract_root, cbase + cj);
                        let kwpos: i32 = contract_kw_pos_of_root(body_et, body_ed1,
                                            body_ed2, body_ed3, body_pp, tok_tags, croot);
                        if kwpos >= 0 {
                            if contract_is_advanced(tok_tags, kwpos) != true {
                                let ckind: i32 = vec_get(tok_tags, kwpos);
                                if ckind == 83 {
                                    /* requires: dropped only in disabled mode (they
                                       are preconditions, never "proven" locally). */
                                    if contract_mode != 2 { vec_push(req_roots, croot); }
                                } else {
                                    if ckind == 61 {
                                        /* ensures: dropped in disabled mode, or in
                                           verified mode when this clause's line was
                                           proven (M4-S-024). */
                                        let mut keep_ens: bool = true;
                                        if contract_mode == 2 { keep_ens = false; }
                                        if contract_mode == 1 {
                                            let eline: i32 = lower_line_of_pos(source, vec_get(starts, kwpos));
                                            if lower_proven_has(proven_lines, eline) { keep_ens = false; }
                                        }
                                        if keep_ens { vec_push(ens_roots, croot); }
                                    }
                                }
                            }
                        }
                        cj = cj + 1;
                    }
                }
            }
            if has_body_arenas > 0 {
                if body_root >= 0 {
                    let discard_lf: i32 = lower_fn(body_et, body_ed1, body_ed2,
                                                    body_ed3, body_ed4, body_pp,
                                                    tok_tags, body_root, label_h,
                                                    req_roots, ens_roots, instrs,
                                                    out_enum_names,
                                                    out_enum_tag_offsets,
                                                    out_enum_tag_counts,
                                                    out_enum_tag_flat,
                                                    fn_ctx, builtin_map, body_sf,
                                                    source, starts, ends,
                                                    item_tags, item_names,
                                                    item_d2, item_d3, item_d4,
                                                    item_field_counts,
                                                    enum_vnames_flat, out_enum_max, i,
                                                    vec_new(),
                                                    import_aliases);
                }
            }
            let params: Vec<i32> = vec_new();
            let ret_h: i32 = 9;
            vec_push(out_blocks, label_h);
            vec_push(out_blocks, ret_h);
            vec_push(out_blocks, box_new(params));
            vec_push(out_blocks, box_new(instrs));
        }
        i = i + 1;
    }
    return typedefs;
}

/* ── freshTmp ───────────────────────────────────────────────── */

/* Synthetic-temp handle base. In the SML reference (ir.sml) IR values carry
   STRINGS: freshTmp() = "_sv0t<n>", real vars = their source name. The sv0 IR
   flattens names to i32 handles resolved at emit time, but real vars carry a
   token INDEX and freshTmp temps carry a plain counter — the two spaces overlap.
   Offsetting the production counter (lower_fn) by this base keeps every temp
   handle disjoint from any token index, so the native emitter can tell a temp
   (>= base → "_sv0t<h-base>") from a source var (< base → handle_to_str). Chosen
   far above any realistic token count; also above the 500..599 tuple-field range. */
fn lower_temp_base() -> i32 {
    return 1000000;
}

/* Sentinel C-type handle for the `string` primitive, used as a DeclNamed ctype
   for string-typed `let`s (the parser discards the `let` annotation, so the type
   is inferred from the init). The compose main's megatu_ty_name maps it to
   `const char*`. Negative + distinct from the tag/payload field sentinels
   (-1, -10-i), which are field handles resolved by megatu_field_name, not ctypes. */
fn lower_string_cty() -> i32 {
    return 0 - 7;
}

/* True when `call_idx` is a 1-seg ExprCall to a top-level user function whose
   declared return type is the `string` primitive. The analog of the string-
   returning-builtin case in lower_init_is_string, but for user fns, so that
   `let s = user_fn(..)` declares const char* (not int) and the call's result
   temp is typed const char* (via the Call rt_h). Names compared by TEXT (a def
   token vs a use token), the standard def-vs-use handle mismatch guard. */
fn lower_tok_in_bounds(h: i32, starts: Vec<i32>, ends: Vec<i32>) -> bool {
    if h < 0 { return false; }
    if h >= vec_len(starts) { return false; }
    if h >= vec_len(ends) { return false; }
    return true;
}

fn lower_call_ret_is_string(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>, pp: Vec<i32>,
                            call_idx: i32,
                            item_tags: Vec<i32>, item_names: Vec<i32>,
                            item_d2: Vec<i32>, tok_tags: Vec<i32>,
                            source: string, starts: Vec<i32>, ends: Vec<i32>) -> bool {
    /* Every index is bounds-checked: this runs on synthetic arenas in the
       lowering unit tests (empty starts/ends/items), and handle_to_str does no
       bounds guard of its own. On real input all indices are valid, so the
       guards never change behavior. */
    if call_idx < 0 { return false; }
    if call_idx >= vec_len(et) { return false; }
    if vec_get(et, call_idx) != 4 { return false; }
    let callee: i32 = vec_get(ed1, call_idx);
    if callee < 0 { return false; }
    if callee >= vec_len(et) { return false; }
    if vec_get(et, callee) != 1 { return false; }
    if vec_get(ed2, callee) != 1 { return false; }
    let cpps: i32 = vec_get(ed1, callee);
    if cpps < 0 { return false; }
    if cpps >= vec_len(pp) { return false; }
    let ctok: i32 = vec_get(pp, cpps);
    if lower_tok_in_bounds(ctok, starts, ends) != true { return false; }
    let cname: string = handle_to_str(ctok, source, starts, ends);
    let n: i32 = vec_len(item_tags);
    let nn: i32 = vec_len(item_names);
    let nd: i32 = vec_len(item_d2);
    let mut i: i32 = 0;
    while i < n {
        if i < nn {
            if i < nd {
                if vec_get(item_tags, i) == 0 {
                    let nm: i32 = vec_get(item_names, i);
                    if lower_tok_in_bounds(nm, starts, ends) {
                        let iname: string = handle_to_str(nm, source, starts, ends);
                        if string_eq(iname, cname) {
                            let packed: i32 = vec_get(item_d2, i);
                            if packed % 2 == 1 {
                                let p3: i32 = lower_scan_fn_ret_ty_tok(tok_tags,
                                    source, starts, ends, nm);
                                if lower_tok_in_bounds(p3, starts, ends) {
                                    let rty: string = handle_to_str(p3, source,
                                                                    starts, ends);
                                    if string_eq(rty, "string") { return true; }
                                }
                            }
                            return false;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return false;
}

/* True when a `let` init is a bare 1-seg identifier that names a `string`-typed
   parameter of the current function (item_fn_row). Handles `let x = str_param`
   aliasing so x is declared const char* not int. Uses the same param name/type
   token scan the match-scrutinee typing uses. Fully bounds-checked; returns
   false for item_fn_row < 0 (the case in every lowering unit test), so the
   non-bounds-safe param scan is never reached on synthetic arenas. */
fn lower_init_ident_is_string_param(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
        pp: Vec<i32>, init_idx: i32,
        item_tags: Vec<i32>, item_names: Vec<i32>, item_d3: Vec<i32>,
        tok_tags: Vec<i32>, source: string, starts: Vec<i32>, ends: Vec<i32>,
        item_fn_row: i32) -> bool {
    if init_idx < 0 { return false; }
    if init_idx >= vec_len(et) { return false; }
    if vec_get(et, init_idx) != 1 { return false; }
    if vec_get(ed2, init_idx) != 1 { return false; }
    let pps: i32 = vec_get(ed1, init_idx);
    if pps < 0 { return false; }
    if pps >= vec_len(pp) { return false; }
    let itok: i32 = vec_get(pp, pps);
    if lower_tok_in_bounds(itok, starts, ends) != true { return false; }
    if item_fn_row < 0 { return false; }
    if item_fn_row >= vec_len(item_tags) { return false; }
    if item_fn_row >= vec_len(item_names) { return false; }
    if item_fn_row >= vec_len(item_d3) { return false; }
    if vec_get(item_tags, item_fn_row) != 0 { return false; }
    let pc: i32 = vec_get(item_d3, item_fn_row);
    if pc <= 0 { return false; }
    let name_tok: i32 = vec_get(item_names, item_fn_row);
    if name_tok < 0 { return false; }
    if name_tok + 1 >= vec_len(tok_tags) { return false; }
    let pnames: Vec<i32> = vec_new();
    let pty: Vec<i32> = vec_new();
    let rs: i32 = lower_scan_item_fn_param_names_ty_toks(tok_tags, name_tok,
        pc, pnames, pty);
    if rs < 0 { return false; }
    if vec_len(pnames) != pc { return false; }
    if vec_len(pty) != pc { return false; }
    let iname: string = handle_to_str(itok, source, starts, ends);
    let mut j: i32 = 0;
    while j < pc {
        let pn: i32 = vec_get(pnames, j);
        let pt: i32 = vec_get(pty, j);
        if lower_tok_in_bounds(pn, starts, ends) {
            if lower_tok_in_bounds(pt, starts, ends) {
                if string_eq(handle_to_str(pn, source, starts, ends), iname) {
                    if string_eq(handle_to_str(pt, source, starts, ends),
                                 "string") {
                        return true;
                    }
                    return false;
                }
            }
        }
        j = j + 1;
    }
    return false;
}

/* True when a `let` init is a bare 1-seg identifier naming a `string`-typed local
   already declared earlier in the same block. str_locals holds the name tokens of
   such locals (pushed by lower_block/lower_stmt as they declare string lets);
   compared by TEXT. Handles `let s = spaces(..); let t = s;` chains. Bounds-safe. */
fn lower_ident_in_str_locals(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>, pp: Vec<i32>,
        init_idx: i32, str_locals: Vec<i32>,
        source: string, starts: Vec<i32>, ends: Vec<i32>) -> bool {
    if init_idx < 0 { return false; }
    if init_idx >= vec_len(et) { return false; }
    if vec_get(et, init_idx) != 1 { return false; }
    if vec_get(ed2, init_idx) != 1 { return false; }
    let pps: i32 = vec_get(ed1, init_idx);
    if pps < 0 { return false; }
    if pps >= vec_len(pp) { return false; }
    let itok: i32 = vec_get(pp, pps);
    if lower_tok_in_bounds(itok, starts, ends) != true { return false; }
    let iname: string = handle_to_str(itok, source, starts, ends);
    let n: i32 = vec_len(str_locals);
    let mut i: i32 = 0;
    while i < n {
        let s: i32 = vec_get(str_locals, i);
        if lower_tok_in_bounds(s, starts, ends) {
            if string_eq(handle_to_str(s, source, starts, ends), iname) {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

/* True when a 1-seg ExprCall's callee is a top-level user function that returns
   unit/void -- either no `-> T` at all, or an explicit `-> ()`. Used so such a
   call lowers to a void Call(dst=0, ...) instead of `int _sv0tN = f(...)` (which
   C rejects as init-from-void). Bounds-safe, mirrors lower_callee_ret_ty_head. */
fn lower_callee_is_void(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>, pp: Vec<i32>,
        call_idx: i32, item_tags: Vec<i32>, item_names: Vec<i32>,
        item_d2: Vec<i32>, tok_tags: Vec<i32>,
        source: string, starts: Vec<i32>, ends: Vec<i32>) -> bool {
    if call_idx < 0 { return false; }
    if call_idx >= vec_len(et) { return false; }
    if vec_get(et, call_idx) != 4 { return false; }
    let callee: i32 = vec_get(ed1, call_idx);
    if callee < 0 { return false; }
    if callee >= vec_len(et) { return false; }
    if vec_get(et, callee) != 1 { return false; }
    if vec_get(ed2, callee) != 1 { return false; }
    let cpps: i32 = vec_get(ed1, callee);
    if cpps < 0 { return false; }
    if cpps >= vec_len(pp) { return false; }
    let ctok: i32 = vec_get(pp, cpps);
    if lower_tok_in_bounds(ctok, starts, ends) != true { return false; }
    let cname: string = handle_to_str(ctok, source, starts, ends);
    let n: i32 = vec_len(item_tags);
    let nn: i32 = vec_len(item_names);
    let nd: i32 = vec_len(item_d2);
    let mut i: i32 = 0;
    while i < n {
        if i < nn {
            if i < nd {
                if vec_get(item_tags, i) == 0 {
                    let nm: i32 = vec_get(item_names, i);
                    if lower_tok_in_bounds(nm, starts, ends) {
                        if string_eq(handle_to_str(nm, source, starts, ends), cname) {
                            let packed: i32 = vec_get(item_d2, i);
                            let has_ret: i32 = packed - (packed / 2) * 2;
                            if has_ret == 0 {
                                return true;
                            }
                            let p3: i32 = lower_scan_fn_ret_ty_tok(tok_tags,
                                source, starts, ends, nm);
                            let mut is_unit: i32 = 0;
                            if p3 >= 0 {
                                if p3 < vec_len(tok_tags) {
                                    if p3 + 1 < vec_len(tok_tags) {
                                        if vec_get(tok_tags, p3) == 6 {
                                            if vec_get(tok_tags, p3 + 1) == 7 {
                                                is_unit = 1;
                                            }
                                        }
                                    }
                                }
                            }
                            if is_unit == 1 {
                                return true;
                            }
                            return false;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return false;
}

/* Return-type head token of a 1-seg ExprCall to a top-level user function (has a
   `-> T`), or -1. The shared front-end of the string-return and user-type-return
   detection. Bounds-safe (runs on synthetic arenas in the lowering unit tests). */
fn lower_callee_ret_ty_head(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>, pp: Vec<i32>,
        call_idx: i32, item_tags: Vec<i32>, item_names: Vec<i32>,
        item_d2: Vec<i32>, tok_tags: Vec<i32>,
        source: string, starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    if call_idx < 0 { return 0 - 1; }
    if call_idx >= vec_len(et) { return 0 - 1; }
    if vec_get(et, call_idx) != 4 { return 0 - 1; }
    let callee: i32 = vec_get(ed1, call_idx);
    if callee < 0 { return 0 - 1; }
    if callee >= vec_len(et) { return 0 - 1; }
    if vec_get(et, callee) != 1 { return 0 - 1; }
    if vec_get(ed2, callee) != 1 { return 0 - 1; }
    let cpps: i32 = vec_get(ed1, callee);
    if cpps < 0 { return 0 - 1; }
    if cpps >= vec_len(pp) { return 0 - 1; }
    let ctok: i32 = vec_get(pp, cpps);
    if lower_tok_in_bounds(ctok, starts, ends) != true { return 0 - 1; }
    let cname: string = handle_to_str(ctok, source, starts, ends);
    return lower_ret_ty_head_from_name(cname, item_tags, item_names, item_d2,
        tok_tags, source, starts, ends);
}

/* ── lower_ret_ty_head_from_name ─────────────────────────────
   Scan the item arena for a top-level ItemFn (tag 0) whose name matches
   `cname`; return its first return-type token when `has_ret == 1` and the
   token is in bounds, else -1. Shared by the direct-call head scan
   (`lower_callee_ret_ty_head`) and the method-call scan
   (`lower_mcall_ret_user_ty_tok`) — impl methods are flattened to
   top-level ItemFns, so a method name resolves here too. */

fn lower_ret_ty_head_from_name(cname: string, item_tags: Vec<i32>,
        item_names: Vec<i32>, item_d2: Vec<i32>, tok_tags: Vec<i32>,
        source: string, starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    let n: i32 = vec_len(item_tags);
    let nn: i32 = vec_len(item_names);
    let nd: i32 = vec_len(item_d2);
    let mut i: i32 = 0;
    while i < n {
        if i < nn {
            if i < nd {
                if vec_get(item_tags, i) == 0 {
                    let nm: i32 = vec_get(item_names, i);
                    if lower_tok_in_bounds(nm, starts, ends) {
                        if string_eq(handle_to_str(nm, source, starts, ends), cname) {
                            let packed: i32 = vec_get(item_d2, i);
                            if packed % 2 == 1 {
                                let p3: i32 = lower_scan_fn_ret_ty_tok(tok_tags,
                                    source, starts, ends, nm);
                                if lower_tok_in_bounds(p3, starts, ends) {
                                    return p3;
                                }
                            }
                            return 0 - 1;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

/* True if `name` (by TEXT) is a top-level user struct (ItemStruct tag 1) or enum
   (ItemEnum tag 2). Used to decide a call-result temp / let local should carry the
   user type name, not int. */
fn lower_name_is_user_type(name: string, item_tags: Vec<i32>, item_names: Vec<i32>,
        source: string, starts: Vec<i32>, ends: Vec<i32>) -> bool {
    let n: i32 = vec_len(item_tags);
    let nn: i32 = vec_len(item_names);
    let mut i: i32 = 0;
    while i < n {
        if i < nn {
            let t: i32 = vec_get(item_tags, i);
            let mut is_ty: i32 = 0;
            if t == 1 { is_ty = 1; }
            if t == 2 { is_ty = 1; }
            if is_ty == 1 {
                let nm: i32 = vec_get(item_names, i);
                if lower_tok_in_bounds(nm, starts, ends) {
                    if string_eq(handle_to_str(nm, source, starts, ends), name) {
                        return true;
                    }
                }
            }
        }
        i = i + 1;
    }
    return false;
}

/* Return-type name token of a 1-seg user call whose return type is a user
   struct/enum (so a `let x = f(..)` / the call temp gets `T`, not int), else -1.
   The struct/enum-return analog of lower_call_ret_is_string. */
fn lower_call_ret_user_ty_tok(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>, pp: Vec<i32>,
        call_idx: i32, item_tags: Vec<i32>, item_names: Vec<i32>,
        item_d2: Vec<i32>, tok_tags: Vec<i32>,
        source: string, starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    let head: i32 = lower_callee_ret_ty_head(et, ed1, ed2, pp, call_idx,
        item_tags, item_names, item_d2, tok_tags, source, starts, ends);
    if head < 0 { return 0 - 1; }
    let rty: string = handle_to_str(head, source, starts, ends);
    if lower_name_is_user_type(rty, item_tags, item_names, source, starts, ends) {
        return head;
    }
    return 0 - 1;
}

/* ── lower_mcall_ret_user_ty_tok ─────────────────────────────
   Method-call (tag 5) analogue of lower_call_ret_user_ty_tok. The method
   name token is ed2[mcall_idx] (methods lower via UFCS to a free fn of the
   same name). Returns the method's return-type token when it names a user
   struct/enum, else -1. The method_tok bounds guard avoids the
   `test_lower_expr_method_call` OOB (method_tok=99, empty starts/ends). */

fn lower_mcall_ret_user_ty_tok(et: Vec<i32>, ed2: Vec<i32>, mcall_idx: i32,
        item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>,
        tok_tags: Vec<i32>, source: string, starts: Vec<i32>,
        ends: Vec<i32>) -> i32 {
    if mcall_idx < 0 { return 0 - 1; }
    if mcall_idx >= vec_len(et) { return 0 - 1; }
    if vec_get(et, mcall_idx) != 5 { return 0 - 1; }
    let mtok: i32 = vec_get(ed2, mcall_idx);
    if lower_tok_in_bounds(mtok, starts, ends) != true { return 0 - 1; }
    let mname: string = handle_to_str(mtok, source, starts, ends);
    let head: i32 = lower_ret_ty_head_from_name(mname, item_tags, item_names,
        item_d2, tok_tags, source, starts, ends);
    if head < 0 { return 0 - 1; }
    let rty: string = handle_to_str(head, source, starts, ends);
    if lower_name_is_user_type(rty, item_tags, item_names, source, starts, ends) {
        return head;
    }
    return 0 - 1;
}

/* Handle `let x: T = box_deref(bv)` where T is a user struct/enum and bv is a simple
   variable (the corpus case). Emits a single Instr::Call(dst=x, box_deref, [bv], T):
   the Call declares x with type T and, via rt_h=T, tells the emit to reconstruct the
   box's element type T (not int) — box_deref of a boxed struct otherwise loses the
   struct (single-word int deref). The recursive-type piece: box_new/box_deref of a
   Ty/Value/Expr struct. Returns 1 if handled, 0 to fall back to generic lowering.
   `ann_tok` is the retained let annotation head token (LetStmt d2), or -1. */
fn lower_typed_box_deref_let(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
        ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>, tok_tags: Vec<i32>,
        init_idx: i32, name_tok: i32, ann_tok: i32, ctr: Vec<i32>,
        out_instrs: Vec<i32>,
        enum_names: Vec<i32>, enum_tag_offsets: Vec<i32>, enum_tag_counts: Vec<i32>,
        enum_tags_flat: Vec<i32>, fn_ctx: Vec<i32>, builtin_map: Vec<i32>,
        lit_sf_names: Vec<i32>, source: string, starts: Vec<i32>, ends: Vec<i32>,
        item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>,
        item_d3: Vec<i32>, item_d4: Vec<i32>, item_field_counts: Vec<i32>,
        enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
        match_env_inherit: Vec<i32>, import_aliases: Vec<i32>) -> i32 {
    if ann_tok < 0 { return 0; }
    if lower_tok_in_bounds(ann_tok, starts, ends) != true { return 0; }
    let ann_name: string = handle_to_str(ann_tok, source, starts, ends);
    if lower_name_is_user_type(ann_name, item_tags, item_names,
                               source, starts, ends) != true { return 0; }
    if init_idx < 0 { return 0; }
    if init_idx >= vec_len(et) { return 0; }
    if vec_get(et, init_idx) != 4 { return 0; }
    let callee: i32 = vec_get(ed1, init_idx);
    if callee < 0 { return 0; }
    if callee >= vec_len(et) { return 0; }
    if vec_get(et, callee) != 1 { return 0; }
    if vec_get(ed2, callee) != 1 { return 0; }
    let cpps: i32 = vec_get(ed1, callee);
    if cpps < 0 { return 0; }
    if cpps >= vec_len(pp) { return 0; }
    let ctok: i32 = vec_get(pp, cpps);
    if lower_tok_in_bounds(ctok, starts, ends) != true { return 0; }
    if string_eq(handle_to_str(ctok, source, starts, ends), "box_deref") != true {
        return 0;
    }
    let args_first: i32 = vec_get(ed2, init_idx);
    let args_count: i32 = vec_get(ed3, init_idx);
    if args_count < 1 { return 0; }
    let args_sidecar: i32 = vec_get(ed4, init_idx);
    let arg_idx: i32 = block_stmt_index(pp, args_first, args_sidecar, 0);
    if arg_idx < 0 { return 0; }
    if arg_idx >= vec_len(et) { return 0; }
    /* Lower the arg (simple var OR complex, e.g. box_deref(vec_get(..))) to a
       value; its instrs go into out_instrs before the box_deref Call. */
    let av: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp, tok_tags,
        arg_idx, ctr, out_instrs, enum_names, enum_tag_offsets, enum_tag_counts,
        enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends,
        item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts,
        enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    /* av is always a VVar for a box_deref arg (lower_expr_to_value spills a complex
       arg like vec_get(..) to a temp and returns VVar(temp)); capture its handle so
       it can be re-read per slot without moving av. */
    let mut box_h: i32 = 0 - 1;
    match av {
        Value::VVar(h) => { box_h = h; },
        Value::VInt(n) => {},
        Value::VBoolTrue => {},
        Value::VBoolFalse => {},
        Value::VString(s) => {},
        Value::VUnit => {},
        Value::VMember(bv, f) => {},
        Value::VAddrOf(h2) => {},
    }
    /* Is the annotated type an enum? If so, find its max payload (by NAME — the
       annotation is a use-token that won't integer-match the enum decl token). */
    let mut is_enum_bd: i32 = 0;
    let mut maxp_bd: i32 = 0;
    let ne_bd: i32 = vec_len(enum_names);
    let mut ei_bd: i32 = 0;
    while ei_bd < ne_bd {
        let enh_bd: i32 = vec_get(enum_names, ei_bd);
        if lower_tok_in_bounds(enh_bd, starts, ends) {
            if string_eq(handle_to_str(enh_bd, source, starts, ends), ann_name) {
                is_enum_bd = 1;
                if ei_bd < vec_len(enum_max_payloads) {
                    maxp_bd = vec_get(enum_max_payloads, ei_bd);
                }
                ei_bd = ne_bd;
            }
        }
        ei_bd = ei_bd + 1;
    }
    /* VM target + enum: reconstruct per-slot (SML boxDerefFromValue + copyFields):
       load each box word into a temp, StoreField it into a fresh `out`, then copy
       out's fields into x. box_load = builtin id 21 (vm_codegen remaps 21->14). The
       C backend (lower_vm_target()==0) keeps the single sv0__box_deref_raw call, so
       its packed box representation is untouched. */
    if lower_vm_target() == 1 {
        if is_enum_bd == 1 {
            if box_h >= 0 {
                let out_bd: i32 = ctr_fresh(ctr);
                vec_push(out_instrs, box_new(Instr::DeclNamed(ann_tok, out_bd)));
                let t_tag: i32 = ctr_fresh(ctr);
                let mut a_tag: Vec<i32> = vec_new();
                vec_push(a_tag, box_new(Value::VVar(box_h)));
                vec_push(a_tag, box_new(Value::VInt(0)));
                vec_push(out_instrs, box_new(Instr::Call(t_tag, 0 - 21, a_tag, 0)));
                vec_push(out_instrs, box_new(Instr::StoreField(out_bd, 0 - 1,
                    box_new(value_to_expr(Value::VVar(t_tag))))));
                let mut pi_bd: i32 = 0;
                while pi_bd < maxp_bd {
                    let t_p: i32 = ctr_fresh(ctr);
                    let mut a_p: Vec<i32> = vec_new();
                    vec_push(a_p, box_new(Value::VVar(box_h)));
                    vec_push(a_p, box_new(Value::VInt(pi_bd + 1)));
                    vec_push(out_instrs, box_new(Instr::Call(t_p, 0 - 21, a_p, 0)));
                    vec_push(out_instrs, box_new(Instr::StoreField(out_bd, 0 - 10 - pi_bd,
                        box_new(value_to_expr(Value::VVar(t_p))))));
                    pi_bd = pi_bd + 1;
                }
                vec_push(out_instrs, box_new(Instr::DeclNamed(ann_tok, name_tok)));
                vec_push(out_instrs, box_new(Instr::StoreField(name_tok, 0 - 1,
                    box_new(value_to_expr(Value::VMember(box_new(Value::VVar(out_bd)), 0 - 1))))));
                let mut ci_bd: i32 = 0;
                while ci_bd < maxp_bd {
                    vec_push(out_instrs, box_new(Instr::StoreField(name_tok, 0 - 10 - ci_bd,
                        box_new(value_to_expr(Value::VMember(box_new(Value::VVar(out_bd)), 0 - 10 - ci_bd))))));
                    ci_bd = ci_bd + 1;
                }
                return 1;
            }
        }
    }
    let args: Vec<i32> = vec_new();
    vec_push(args, box_new(Value::VVar(box_h)));
    let call: Instr = Instr::Call(name_tok, 0 - 13, args, ann_tok);
    vec_push(out_instrs, box_new(call));
    return 1;
}

/* VM-target flag (0 = C backend, single sv0__box_deref_raw box_deref; 1 = VM, which
   reconstructs a typed box_deref per-slot to match SML --target=vm). The C compose
   builds leave this 0; the native VM emitter recipe patches the assembled mega-TU to
   return 1. Kept as a plain constant fn so no target flag has to be threaded. */
fn lower_vm_target() -> i32 { return 0; }

/* True if a `let` init evaluates to a `string` (const char*): a string literal
   (ExprLit lit_tag 3) or a call to a string-returning builtin. Used to give the
   binding a string C type instead of int. */
fn lower_init_is_string(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>, pp: Vec<i32>,
                        init_idx: i32, source: string, starts: Vec<i32>,
                        ends: Vec<i32>) -> bool {
    let itag: i32 = vec_get(et, init_idx);
    if itag == 0 {
        if vec_get(ed1, init_idx) == 3 {
            return true;
        }
        return false;
    }
    if itag == 4 {
        let callee: i32 = vec_get(ed1, init_idx);
        if vec_get(et, callee) == 1 {
            if vec_get(ed2, callee) == 1 {
                let nt: i32 = vec_get(pp, vec_get(ed1, callee));
                let nm: string = handle_to_str(nt, source, starts, ends);
                if string_eq(nm, "string_concat") { return true; }
                if string_eq(nm, "string_substr") { return true; }
                if string_eq(nm, "read_file") { return true; }
                if string_eq(nm, "read_dir") { return true; }
                if string_eq(nm, "getenv") { return true; }
            }
        }
    }
    return false;
}

/* True if the expression at `idx` evaluates to a `string`: a string literal, a
   string-returning builtin OR user function call, or — recursing — a block's tail
   (tag 9, ed3) or an if-expr's then branch (tag 10, ed2). Used to type a string-
   valued let and an if-expression result temp as const char* (e.g.
   `let s: string = if c { emit(..) } else { "!" }` whose branches are user calls). */
fn lower_expr_yields_string(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
        ed3: Vec<i32>, pp: Vec<i32>, idx: i32,
        item_tags: Vec<i32>, item_names: Vec<i32>, item_d2: Vec<i32>,
        tok_tags: Vec<i32>, source: string, starts: Vec<i32>, ends: Vec<i32>) -> bool {
    if idx < 0 { return false; }
    if idx >= vec_len(et) { return false; }
    if lower_init_is_string(et, ed1, ed2, pp, idx, source, starts, ends) {
        return true;
    }
    if lower_call_ret_is_string(et, ed1, ed2, pp, idx, item_tags, item_names,
            item_d2, tok_tags, source, starts, ends) {
        return true;
    }
    let tag: i32 = vec_get(et, idx);
    if tag == 9 {
        return lower_expr_yields_string(et, ed1, ed2, ed3, pp,
            vec_get(ed3, idx), item_tags, item_names, item_d2, tok_tags,
            source, starts, ends);
    }
    if tag == 10 {
        return lower_expr_yields_string(et, ed1, ed2, ed3, pp,
            vec_get(ed2, idx), item_tags, item_names, item_d2, tok_tags,
            source, starts, ends);
    }
    return false;
}

fn fresh_tmp_name(counter: i32) -> i32 {
    return counter;
}

fn next_tmp(counter: i32) -> i32 {
    return counter + 1;
}

fn lower_digit(d: i32) -> string {
    if d == 0 { return "0"; }
    if d == 1 { return "1"; }
    if d == 2 { return "2"; }
    if d == 3 { return "3"; }
    if d == 4 { return "4"; }
    if d == 5 { return "5"; }
    if d == 6 { return "6"; }
    if d == 7 { return "7"; }
    if d == 8 { return "8"; }
    return "9";
}

fn lower_int_to_str(n: i32) -> string {
    if n < 0 { return string_concat("-", lower_int_to_str(0 - n)); }
    if n < 10 { return lower_digit(n); }
    let rest: string = lower_int_to_str(n / 10);
    let last: string = lower_digit(n - (n / 10) * 10);
    return string_concat(rest, last);
}

fn fresh_tmp_str(counter: i32) -> string {
    return string_concat("_sv0t", lower_int_to_str(counter));
}

/* ── import aliases (SML importAliases : (string*string) list ref) ── */

fn lower_alias_new() -> Vec<i32> {
    return vec_new();
}

fn lower_alias_add(aliases: Vec<i32>, from_h: i32, to_h: i32) -> i32 {
    vec_push(aliases, from_h);
    vec_push(aliases, to_h);
    return vec_len(aliases) / 2;
}

fn lower_alias_lookup(aliases: Vec<i32>, name_h: i32) -> i32 {
    let n: i32 = vec_len(aliases);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(aliases, i) == name_h {
            return vec_get(aliases, i + 1);
        }
        i = i + 2;
    }
    return 0 - 1;
}

fn resolve_fn_callee(aliases: Vec<i32>, name_h: i32) -> i32 {
    let target: i32 = lower_alias_lookup(aliases, name_h);
    if target < 0 { return name_h; }
    return target;
}

fn lower_find_item_fn_name_by_text(item_tags: Vec<i32>,
                                   item_names: Vec<i32>,
                                   source: string,
                                   starts: Vec<i32>,
                                   ends: Vec<i32>,
                                   target_name: string) -> i32 {
    let n: i32 = vec_len(item_tags);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(item_tags, i) == 0 {
            let name_h: i32 = vec_get(item_names, i);
            let name_s: string = handle_to_str(name_h, source, starts, ends);
            if string_eq(name_s, target_name) { return name_h; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── lower_fill_import_aliases_from_use_items ────────────────
   Build lowering alias rows from ItemUse entries:
     use mod::foo;  =>  foo -> mod__foo (if ItemFn exists).
   This mirrors resolver.apply_use_clause value aliases enough for
   lowering call-site resolution, while skipping type-only aliases. */
fn lower_fill_import_aliases_from_use_items(aliases: Vec<i32>,
                                            item_tags: Vec<i32>,
                                            item_names: Vec<i32>,
                                            item_d2: Vec<i32>,
                                            item_d3: Vec<i32>,
                                            pp: Vec<i32>,
                                            source: string,
                                            starts: Vec<i32>,
                                            ends: Vec<i32>) -> i32 {
    let n: i32 = vec_len(item_tags);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(item_tags, i) == 5 {
            let pps: i32 = vec_get(item_d2, i);
            let ppc: i32 = vec_get(item_d3, i);
            if ppc == 2 {
                let mod_h: i32 = vec_get(pp, pps);
                let short_h: i32 = vec_get(pp, pps + 1);
                let mod_s: string = handle_to_str(mod_h, source, starts, ends);
                let short_s: string = handle_to_str(short_h, source, starts, ends);
                let mut target: string = string_concat(mod_s, "__");
                target = string_concat(target, short_s);
                let to_h: i32 = lower_find_item_fn_name_by_text(item_tags,
                    item_names, source, starts, ends, target);
                if to_h >= 0 {
                    if lower_alias_lookup(aliases, short_h) < 0 {
                        let discard_add: i32 = lower_alias_add(aliases, short_h, to_h);
                    }
                }
            }
        }
        i = i + 1;
    }
    return vec_len(aliases) / 2;
}

fn resolve_enum_ctor_path(ctor_from_enum: Vec<i32>, ctor_from_var: Vec<i32>,
                          ctor_to_enum: Vec<i32>, ctor_to_var: Vec<i32>,
                          enum_h: i32, variant_h: i32) -> i32 {
    let n: i32 = vec_len(ctor_from_enum);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(ctor_from_enum, i) == enum_h {
            if vec_get(ctor_from_var, i) == variant_h {
                return i;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn resolved_ctor_enum(ctor_to_enum: Vec<i32>, idx: i32, default_enum: i32) -> i32 {
    if idx < 0 { return default_enum; }
    return vec_get(ctor_to_enum, idx);
}

fn resolved_ctor_variant(ctor_to_var: Vec<i32>, idx: i32, default_var: i32) -> i32 {
    if idx < 0 { return default_var; }
    return vec_get(ctor_to_var, idx);
}

/* ── splitQName ─────────────────────────────────────────────── */

fn find_double_colon(s: string, start: i32) -> i32 {
    let len: i32 = string_len(s);
    let limit: i32 = len - 1;
    let mut i: i32 = start;
    while i < limit {
        if string_char_at(s, i) == 58 {
            if string_char_at(s, i + 1) == 58 {
                return i;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn split_qname_count(s: string) -> i32 {
    let mut count: i32 = 1;
    let mut pos: i32 = 0;
    let idx: i32 = find_double_colon(s, pos);
    if idx < 0 { return 1; }
    count = count + 1;
    pos = idx + 2;
    let idx2: i32 = find_double_colon(s, pos);
    if idx2 < 0 { return count; }
    count = count + 1;
    pos = idx2 + 2;
    let idx3: i32 = find_double_colon(s, pos);
    if idx3 < 0 { return count; }
    return count + 1;
}

fn has_qualified_name(s: string) -> bool {
    return find_double_colon(s, 0) >= 0;
}

/* ── AST binop → C operator string ──────────────────────────── */

fn ast_binop_to_c(tag: i32) -> string {
    if tag == 0 { return "+"; }
    if tag == 1 { return "-"; }
    if tag == 2 { return "*"; }
    if tag == 3 { return "/"; }
    if tag == 4 { return "%"; }
    if tag == 5 { return "=="; }
    if tag == 6 { return "!="; }
    if tag == 7 { return "<"; }
    if tag == 8 { return ">"; }
    if tag == 9 { return "<="; }
    if tag == 10 { return ">="; }
    if tag == 11 { return "&&"; }
    if tag == 12 { return "||"; }
    if tag == 13 { return "&"; }
    if tag == 14 { return "|"; }
    if tag == 15 { return "^"; }
    if tag == 16 { return "<<"; }
    if tag == 17 { return ">>"; }
    return "+";
}

/* ── AST unop → C operator string ───────────────────────────── */

/* Ast.unop: Neg=0, Not=1, BitNot=2, Deref=3, Borrow=4, BorrowMut=5 */
fn ast_unop_to_c(tag: i32) -> string {
    if tag == 0 { return "-"; }
    if tag == 1 { return "!"; }
    if tag == 2 { return "~"; }
    if tag == 3 { return "*"; }
    if tag == 4 { return "&"; }
    if tag == 5 { return "&"; }
    return "?";
}

fn is_supported_unop(tag: i32) -> bool {
    if tag == 0 { return true; }
    if tag == 1 { return true; }
    if tag == 2 { return true; }
    if tag == 4 { return true; }
    if tag == 5 { return true; }
    return false;
}

/* ── AST type → C type string mapping ───────────────────────── */

fn ast_ty_to_c_string(name: string) -> string {
    if string_eq(name, "unit") { return "void"; }
    if string_eq(name, "i32") { return "int"; }
    if string_eq(name, "bool") { return "int"; }
    if string_eq(name, "i8") { return "int8_t"; }
    if string_eq(name, "u8") { return "uint8_t"; }
    if string_eq(name, "byte") { return "uint8_t"; }
    if string_eq(name, "i16") { return "int16_t"; }
    if string_eq(name, "u16") { return "uint16_t"; }
    if string_eq(name, "i64") { return "int64_t"; }
    if string_eq(name, "u64") { return "uint64_t"; }
    if string_eq(name, "u32") { return "uint32_t"; }
    if string_eq(name, "f32") { return "float"; }
    if string_eq(name, "f64") { return "double"; }
    if string_eq(name, "isize") { return "intptr_t"; }
    if string_eq(name, "usize") { return "uintptr_t"; }
    if string_eq(name, "string") { return "const char*"; }
    if string_eq(name, "str") { return "const char*"; }
    if string_eq(name, "String") { return "const char*"; }
    if string_eq(name, "Vec") { return "int"; }
    if string_eq(name, "Box") { return "int"; }
    return "int";
}

/* True for the primitive type names whose real C type is NOT "int"/`bool`'s
   default (i8/u8/i16/u16/i64/u64/u32/f32/f64/isize/usize) — deliberately
   excludes i32/bool, whose already-correct fallback ("int") a caller
   should keep using unchanged. Used by lower_tag_block's LetStmt lowering
   to decide whether an explicit `let x: T = <expr>;` annotation needs to
   override the plain-DeclVar default (BUGS.md #7, sv0-mathlib): without
   this, `let nan: f64 = 0.0 / 0.0;` silently declared C `int nan;` —
   worse than truncation, undefined behavior (double-to-int conversion of
   a NaN) — because the annotation was parsed and stored (LetStmt's own
   `d2`) but no lowering path ever consulted it; the `let`'s init-
   expression *shape* was the only thing ever used to pick a declared
   type, and a plain arithmetic RHS matches none of the special-cased
   shapes (struct literal, enum ctor, string, user-type-returning call). */
fn is_wide_primitive_ty_name(name: string) -> bool {
    if string_eq(name, "i8") { return true; }
    if string_eq(name, "u8") { return true; }
    if string_eq(name, "byte") { return true; }
    if string_eq(name, "i16") { return true; }
    if string_eq(name, "u16") { return true; }
    if string_eq(name, "i64") { return true; }
    if string_eq(name, "u64") { return true; }
    if string_eq(name, "u32") { return true; }
    if string_eq(name, "f32") { return true; }
    if string_eq(name, "f64") { return true; }
    if string_eq(name, "isize") { return true; }
    if string_eq(name, "usize") { return true; }
    return false;
}

/* ── ast_ty_to_c_string_with_user (SML astTyToCString struct/enum branch)
   Like ast_ty_to_c_string but if the primitive lookup returns "int"
   (unknown), checks struct and enum name-handle tables.  If the
   handle is a known struct or enum, returns the original name string
   (the caller's C typedef); otherwise falls back to "int".
   SML: `TyName ([n],_,_) => if exists structFieldOrder n then n ...` */
fn ast_ty_to_c_string_with_user(name: string, name_handle: i32,
                                struct_names: Vec<i32>,
                                enum_names: Vec<i32>) -> string {
    let prim: string = ast_ty_to_c_string(name);
    if string_eq(prim, "int") != true { return prim; }
    if is_struct_cty(struct_names, name_handle) { return name; }
    if is_enum_cty(enum_names, name_handle) { return name; }
    return "int";
}

fn is_void_cty(name: string) -> bool {
    if string_eq(name, "void") { return true; }
    if string_eq(name, "unit") { return true; }
    return false;
}

fn ast_ty_is_unit(name: string) -> bool {
    return string_eq(name, "unit");
}

/* ── oldSlot naming ─────────────────────────────────────────── */

fn old_slot_prefix() -> string {
    return "_sv0old_";
}

fn old_slot_name_len(name_len: i32) -> i32 {
    return 8 + name_len;
}

fn old_slot_name(name: string) -> string {
    return string_concat("_sv0old_", name);
}

/* ── paramName ─────────────────────────────────────────────────
   PatBind → name. In sv0, pattern tags: 0=Wild, 1=Bind, ...
   paramName returns the name handle (token index) for a Bind pat,
   or -1 for non-Bind patterns. */

fn param_name_tag(pat_tag: i32) -> bool {
    return pat_tag == 1;
}

/* SML paramName: extracts the name handle from a PatBind parameter.
   Returns the handle if pat_tag == 1 (PatBind), else -1. */
fn param_name(pat_tag: i32, name_handle: i32) -> i32 {
    if pat_tag == 1 { return name_handle; }
    return 0 - 1;
}

/* SML local fieldIndex in matchArmSetup: given a Vec of struct
   field name handles and a target name handle, returns its index
   or -1 if not found. */
fn lower_field_index(field_names: Vec<i32>, target: i32) -> i32 {
    let n: i32 = vec_len(field_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(field_names, i) == target { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── uniqOldNames (dedup) ──────────────────────────────────────
   Given a Vec<i32> of name handles, return how many unique entries
   there are. Also provides a helper to check membership and add
   if not present. */

fn old_name_seen(seen: Vec<i32>, name: i32) -> bool {
    let n: i32 = vec_len(seen);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(seen, i) == name { return true; }
        i = i + 1;
    }
    return false;
}

fn old_names_add_unique(seen: Vec<i32>, name: i32) -> bool {
    if old_name_seen(seen, name) { return false; }
    vec_push(seen, name);
    return true;
}

fn uniq_old_names(names: Vec<i32>) -> Vec<i32> {
    let out: Vec<i32> = vec_new();
    let n: i32 = vec_len(names);
    let mut i: i32 = 0;
    while i < n {
        let name: i32 = vec_get(names, i);
        old_names_add_unique(out, name);
        i = i + 1;
    }
    return out;
}

/* ── retSyntaxIsUnit ────────────────────────────────────────── */

fn ret_syntax_is_unit(has_ret: bool, ret_ty_name: string) -> bool {
    if has_ret == false { return true; }
    if string_eq(ret_ty_name, "unit") { return true; }
    return false;
}

fn use_ret_slot(is_unit: bool, ens_mentions_result: bool) -> bool {
    if is_unit { return false; }
    return ens_mentions_result;
}

fn append_instrs(dst: Vec<i32>, src: Vec<i32>) -> i32 {
    let n: i32 = vec_len(src);
    let mut i: i32 = 0;
    while i < n {
        vec_push(dst, vec_get(src, i));
        i = i + 1;
    }
    return 0;
}

fn store_value_to_slot(slot: i32, v: Value, out_instrs: Vec<i32>) -> i32 {
    let vtag: i32 = ir_value_tag(v);
    if vtag == 3 {
        match v {
            Value::VVar(x) => {
                if x != slot {
                    let si0: Instr = Instr::Store(slot, box_new(Expr::Load(x)));
                    vec_push(out_instrs, box_new(si0));
                }
                return 0;
            },
            _ => {
                let si1: Instr = Instr::Store(slot, box_new(Expr::Literal(box_new(v))));
                vec_push(out_instrs, box_new(si1));
                return 0;
            },
        }
    }
    let si2: Instr = Instr::Store(slot, box_new(Expr::Literal(box_new(v))));
    vec_push(out_instrs, box_new(si2));
    return 0;
}

fn lower_ensures_clause(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                        ed3: Vec<i32>, ed4: Vec<i32>, pp: Vec<i32>,
                        tok_tags: Vec<i32>, expr_idx: i32,
                        map_result: bool, fn_name_h: i32,
                        ctr: Vec<i32>, out_instrs: Vec<i32>,
                        enum_names: Vec<i32>,
                        enum_tag_offsets: Vec<i32>,
                        enum_tag_counts: Vec<i32>,
                        enum_tags_flat: Vec<i32>,
                        fn_ctx: Vec<i32>,
                        builtin_map: Vec<i32>, lit_sf_names: Vec<i32>,
                        source: string, starts: Vec<i32>, ends: Vec<i32>,
                        item_tags: Vec<i32>, item_names: Vec<i32>,
                        item_d2: Vec<i32>, item_d3: Vec<i32>,
                        item_d4: Vec<i32>, item_field_counts: Vec<i32>,
                        enum_vnames_flat: Vec<i32>, enum_max_payloads: Vec<i32>, item_fn_row: i32,
                        match_env_inherit: Vec<i32>,
                        import_aliases: Vec<i32>) -> i32 {
    /* M3-S-034 follow-up: map `result` references to return-slot when map_result=true. */
    let ee: Expr = lower_expr_with_instrs(et, ed1, ed2, ed3, ed4, pp,
                                          tok_tags, expr_idx, ctr,
                                          out_instrs, enum_names,
                                          enum_tag_offsets, enum_tag_counts,
                                          enum_tags_flat, fn_ctx, builtin_map,
                                          lit_sf_names, source, starts, ends,
                                          item_tags, item_names, item_d2,
                                          item_d3, item_d4, item_field_counts,
                                          enum_vnames_flat, enum_max_payloads, item_fn_row,
                                          match_env_inherit, import_aliases);
    if map_result == true {
        let keep_shape: i32 = 0;
    }
    let ei: Instr = Instr::Ensures(box_new(ee), fn_name_h);
    vec_push(out_instrs, box_new(ei));
    return 0;
}

fn inject_ensures_and_ret_slot(is: Vec<i32>, ens_instrs: Vec<i32>,
                               use_ret_slot_flag: bool,
                               ret_slot: i32) -> Vec<i32> {
    if vec_len(ens_instrs) == 0 { return is; }
    let out: Vec<i32> = vec_new();
    let n: i32 = vec_len(is);
    let mut i: i32 = 0;
    while i < n {
        let ins: Instr = box_deref(vec_get(is, i));
        match ins {
            Instr::ReturnVal(bv) => {
                let rv: Value = box_deref(bv);
                if use_ret_slot_flag {
                    let discard_sv: i32 = store_value_to_slot(ret_slot, rv, out);
                    let discard_append0: i32 = append_instrs(out, ens_instrs);
                    let rr: Instr = Instr::ReturnVal(box_new(Value::VVar(ret_slot)));
                    vec_push(out, box_new(rr));
                } else {
                    let discard_append1: i32 = append_instrs(out, ens_instrs);
                    let rr2: Instr = Instr::ReturnVal(box_new(rv));
                    vec_push(out, box_new(rr2));
                }
            },
            Instr::ReturnVoid => {
                let discard_append2: i32 = append_instrs(out, ens_instrs);
                vec_push(out, box_new(Instr::ReturnVoid));
            },
            _ => {
                vec_push(out, box_new(ins));
            },
        }
        i = i + 1;
    }
    return out;
}

fn lower_lit_supported(lit_tag: i32) -> bool {
    return classify_literal(lit_tag) >= 0;
}

/* ── storeValueToSlot classification ────────────────────────── */
/* Class constants: SKIP=0, STORE=1, LOAD=2 */

fn store_value_class(is_var: bool, var_name_eq_slot: bool) -> i32 {
    if is_var {
        if var_name_eq_slot { return 0; }
        return 2;
    }
    return 1;
}

/* ── assignment LHS classification ──────────────────────────── */
/* Class constants: VAR=0, FIELD=1, INVALID=-1 */

fn low_classify_assign_lhs(expr_tag: i32) -> i32 {
    if expr_tag == 2 { return 0; }
    if expr_tag == 11 { return 1; }
    return 0 - 1;
}

/* ── enum/struct lookup helpers ──────────────────────────────── */

/* Text-based enum variant tag lookup. The enum tables hold the DEFINITION name
   tokens while a constructor/pattern carries USE tokens (different token indices,
   same spelling), so comparison must be by source text, not token index (the
   index-based enum_tag_lookup only works for hand-built test arenas). Returns the
   variant's tag index, -1 if the variant is unknown, -2 if the enum is unknown. */
fn enum_tag_lookup_str(enum_names: Vec<i32>, enum_tags_flat: Vec<i32>,
                       enum_tag_offsets: Vec<i32>, enum_tag_counts: Vec<i32>,
                       enum_name: i32, variant_name: i32,
                       source: string, starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    let want_e: string = handle_to_str(enum_name, source, starts, ends);
    let want_v: string = handle_to_str(variant_name, source, starts, ends);
    let n: i32 = vec_len(enum_names);
    let mut ei: i32 = 0;
    while ei < n {
        let e_nm: string = handle_to_str(vec_get(enum_names, ei),
                                         source, starts, ends);
        if string_eq(e_nm, want_e) {
            let offset: i32 = vec_get(enum_tag_offsets, ei);
            let count: i32 = vec_get(enum_tag_counts, ei);
            let mut vi: i32 = 0;
            while vi < count {
                let flat_idx: i32 = offset + vi * 2;
                let v_nm: string = handle_to_str(vec_get(enum_tags_flat, flat_idx),
                                                 source, starts, ends);
                if string_eq(v_nm, want_v) {
                    return vec_get(enum_tags_flat, flat_idx + 1);
                }
                vi = vi + 1;
            }
            return 0 - 1;
        }
        ei = ei + 1;
    }
    return 0 - 2;
}

fn enum_tag_lookup(enum_names: Vec<i32>, enum_tags_flat: Vec<i32>,
                   enum_tag_offsets: Vec<i32>, enum_tag_counts: Vec<i32>,
                   enum_name: i32, variant_name: i32) -> i32 {
    let n: i32 = vec_len(enum_names);
    let mut ei: i32 = 0;
    while ei < n {
        if vec_get(enum_names, ei) == enum_name {
            let offset: i32 = vec_get(enum_tag_offsets, ei);
            let count: i32 = vec_get(enum_tag_counts, ei);
            let mut vi: i32 = 0;
            while vi < count {
                let flat_idx: i32 = offset + vi * 2;
                if vec_get(enum_tags_flat, flat_idx) == variant_name {
                    return vec_get(enum_tags_flat, flat_idx + 1);
                }
                vi = vi + 1;
            }
            return 0 - 1;
        }
        ei = ei + 1;
    }
    return 0 - 2;
}

/* Token re-scan: struct field name positions after `{` following
   `name_tok_pos` (variant name for enum struct variants, or struct
   name for ItemStruct). Mirrors checker scan_struct_field_names. */

fn lower_scan_struct_field_names(tok_tags: Vec<i32>, name_tok_pos: i32,
                                 field_count: i32,
                                 out_field_names: Vec<i32>) -> i32 {
    let mut p: i32 = name_tok_pos + 1;
    while vec_get(tok_tags, p) != 8 {
        p = p + 1;
        if p >= vec_len(tok_tags) { return 0 - 1; }
    }
    p = p + 1;
    let mut found: i32 = 0;
    while found < field_count {
        if vec_get(tok_tags, p) == 87 { p = p + 1; }
        if vec_get(tok_tags, p) != 5 { return 0 - 1; }
        vec_push(out_field_names, p);
        found = found + 1;
        p = p + 1;
        if vec_get(tok_tags, p) != 14 { return 0 - 1; }
        p = p + 1;
        let mut depth: i32 = 0;
        let mut scanning_type: bool = true;
        while scanning_type {
            let t: i32 = vec_get(tok_tags, p);
            if t == 8 { depth = depth + 1; p = p + 1; }
            else {
                if t == 10 { depth = depth + 1; p = p + 1; }
                else {
                    if t == 9 {
                        if depth > 0 { depth = depth - 1; p = p + 1; }
                        else { scanning_type = false; }
                    } else {
                        if t == 11 {
                            if depth > 0 { depth = depth - 1; p = p + 1; }
                            else { scanning_type = false; }
                        } else {
                            if t == 12 {
                                if depth == 0 {
                                    scanning_type = false;
                                    p = p + 1;
                                } else { p = p + 1; }
                            } else { p = p + 1; }
                        }
                    }
                }
            }
        }
    }
    return 0;
}

/* Map a struct-pattern field name token to payload slot index `pi`
   (0..field_count-1) for `StoreField`/`VMember` encoding `0-10-pi`. */

fn lower_pat_struct_field_payload_index(tok_tags: Vec<i32>,
                                        source: string, starts: Vec<i32>,
                                        ends: Vec<i32>,
                                        vn_name_tok: i32, field_count: i32,
                                        field_name_tok: i32) -> i32 {
    let fnames: Vec<i32> = vec_new();
    let sr: i32 = lower_scan_struct_field_names(tok_tags, vn_name_tok,
                                                field_count, fnames);
    if sr != 0 { return 0 - 1; }
    let ws: i32 = vec_get(starts, field_name_tok);
    let we: i32 = vec_get(ends, field_name_tok);
    let want: string = string_substr(source, ws, we - ws);
    let mut fi: i32 = 0;
    while fi < field_count {
        let ftp: i32 = vec_get(fnames, fi);
        let fs: i32 = vec_get(starts, ftp);
        let fe: i32 = vec_get(ends, ftp);
        let s2: string = string_substr(source, fs, fe - fs);
        if string_eq(s2, want) { return fi; }
        fi = fi + 1;
    }
    return 0 - 1;
}

fn struct_fields_lookup(struct_names: Vec<i32>, struct_field_offsets: Vec<i32>,
                        struct_field_counts: Vec<i32>, struct_fields_flat: Vec<i32>,
                        name: i32) -> i32 {
    let n: i32 = vec_len(struct_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(struct_names, i) == name {
            return vec_get(struct_field_offsets, i);
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn struct_field_count(struct_names: Vec<i32>, struct_field_counts: Vec<i32>,
                      name: i32) -> i32 {
    let n: i32 = vec_len(struct_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(struct_names, i) == name {
            return vec_get(struct_field_counts, i);
        }
        i = i + 1;
    }
    return 0;
}

fn is_enum_cty(enum_names: Vec<i32>, name: i32) -> bool {
    let n: i32 = vec_len(enum_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(enum_names, i) == name { return true; }
        i = i + 1;
    }
    return false;
}

fn is_struct_cty(struct_names: Vec<i32>, name: i32) -> bool {
    let n: i32 = vec_len(struct_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(struct_names, i) == name { return true; }
        i = i + 1;
    }
    return false;
}

/* ── variant slots ──────────────────────────────────────────── */

fn variant_slot_count(shape_tag: i32, field_count: i32) -> i32 {
    if shape_tag == 0 { return 0; }
    return field_count;
}

/* ── enum max payload ───────────────────────────────────────── */

fn enum_max_payload_lookup(enum_names: Vec<i32>, enum_max_payloads: Vec<i32>,
                           name: i32) -> i32 {
    let n: i32 = vec_len(enum_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(enum_names, i) == name {
            return vec_get(enum_max_payloads, i);
        }
        i = i + 1;
    }
    return 0 - 1;
}

/* Text-based variant of the above (mirrors enum_tag_lookup_str): `name` is a
   USE-site token (e.g. the `E` in `E::B`), while `enum_names` holds
   DEFINITION-site tokens -- raw token equality only works when they happen
   to be the same occurrence, so a real lookup needs text comparison, same
   as enum_tag_lookup_str already does for variant tags. Used by the
   unit-variant ctor path (KC-006) to find how many payload slots the
   enum's C struct actually has, so every slot can be defensively
   zero-initialized regardless of which variant is being constructed. */
fn enum_max_payload_lookup_str(enum_names: Vec<i32>, enum_max_payloads: Vec<i32>,
                               name: i32, source: string, starts: Vec<i32>,
                               ends: Vec<i32>) -> i32 {
    let want: string = handle_to_str(name, source, starts, ends);
    let n: i32 = vec_len(enum_names);
    let mut i: i32 = 0;
    while i < n {
        let e_nm: string = handle_to_str(vec_get(enum_names, i), source, starts, ends);
        if string_eq(e_nm, want) {
            return vec_get(enum_max_payloads, i);
        }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── tryVariantNames (Result/Option) ────────────────────────── */

fn try_variant_success(has_ok: bool, has_some: bool) -> string {
    if has_ok { return "Ok"; }
    if has_some { return "Some"; }
    return "";
}

fn try_variant_failure(has_err: bool, has_none: bool) -> string {
    if has_err { return "Err"; }
    if has_none { return "None"; }
    return "";
}

fn is_try_enum(has_ok: bool, has_err: bool, has_some: bool, has_none: bool) -> bool {
    if has_ok {
        if has_err { return true; }
    }
    if has_some {
        if has_none { return true; }
    }
    return false;
}

/* ── try_variant_names_lookup (SML tryVariantNames — full arena) ─ */
/* Finds Ok/Err or Some/None variant name handles for a given enum.
   Pushes success handle then failure handle into out_handles.
   Returns true if the enum is a Result/Option shape. */

fn try_variant_names_lookup(enum_names: Vec<i32>,
                            enum_tag_offsets: Vec<i32>,
                            enum_tag_counts: Vec<i32>,
                            enum_tags_flat: Vec<i32>,
                            source: string, starts: Vec<i32>,
                            ends: Vec<i32>,
                            enum_name: i32,
                            out_handles: Vec<i32>) -> bool {
    let n: i32 = vec_len(enum_names);
    let mut ei: i32 = 0;
    while ei < n {
        if vec_get(enum_names, ei) == enum_name {
            let offset: i32 = vec_get(enum_tag_offsets, ei);
            let count: i32 = vec_get(enum_tag_counts, ei);
            let mut has_ok: bool = false;
            let mut has_err: bool = false;
            let mut has_some: bool = false;
            let mut has_none: bool = false;
            let mut ok_h: i32 = 0;
            let mut err_h: i32 = 0;
            let mut some_h: i32 = 0;
            let mut none_h: i32 = 0;
            let mut vi: i32 = 0;
            while vi < count {
                let vn_h: i32 = vec_get(enum_tags_flat, offset + vi * 2);
                let vn_s: string = handle_to_str(vn_h, source, starts, ends);
                if string_eq(vn_s, "Ok") { has_ok = true; ok_h = vn_h; }
                if string_eq(vn_s, "Err") { has_err = true; err_h = vn_h; }
                if string_eq(vn_s, "Some") { has_some = true; some_h = vn_h; }
                if string_eq(vn_s, "None") { has_none = true; none_h = vn_h; }
                vi = vi + 1;
            }
            if has_ok {
                if has_err {
                    vec_push(out_handles, ok_h);
                    vec_push(out_handles, err_h);
                    return true;
                }
            }
            if has_some {
                if has_none {
                    vec_push(out_handles, some_h);
                    vec_push(out_handles, none_h);
                    return true;
                }
            }
            return false;
        }
        ei = ei + 1;
    }
    return false;
}

/* ── find_variant_in_items (SML findVariantAst — arena) ────────── */
/* Given enum name handle and variant name handle, find the
   variant's flat index (within the enum's variant list) from the
   item arena.  Returns -1 if enum not found, -2 if variant not
   found within the enum. */

fn find_variant_in_items(item_tags: Vec<i32>, item_names: Vec<i32>,
                         item_field_counts: Vec<i32>,
                         variant_names_flat: Vec<i32>,
                         enum_name: i32, variant_name: i32) -> i32 {
    let n: i32 = vec_len(item_tags);
    let mut i: i32 = 0;
    let mut vn_offset: i32 = 0;
    while i < n {
        let tag: i32 = vec_get(item_tags, i);
        let vc: i32 = vec_get(item_field_counts, i);
        if tag == 2 {
            if vec_get(item_names, i) == enum_name {
                let mut vi: i32 = 0;
                while vi < vc {
                    if vec_get(variant_names_flat, vn_offset + vi) == variant_name {
                        return vi;
                    }
                    vi = vi + 1;
                }
                return 0 - 2;
            }
            vn_offset = vn_offset + vc;
        }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── literal lowering classification ────────────────────────── */
/* Tag constants: INT=0, BOOL=1, UNIT=2, STRING=3, UNSUPPORTED=-1 */

fn classify_literal(lit_tag: i32) -> i32 {
    if lit_tag == 0 { return 0; }
    if lit_tag == 1 { return 1; }
    if lit_tag == 2 { return 2; }
    if lit_tag == 3 { return 3; }
    return 0 - 1;
}

fn lower_lit_to_ir_tag(lit_tag: i32) -> i32 {
    if lit_tag == 0 { return 0; }
    if lit_tag == 1 { return 1; }
    if lit_tag == 2 { return 4; }
    if lit_tag == 3 { return 5; }
    return 0 - 1;
}

fn fn_ret_cty(has_ret: bool, ret_cty: string) -> string {
    if has_ret { return ret_cty; }
    return "int";
}

/* ── value → expr classification ────────────────────────────── */
/* Class constants: VAR=0, OTHER=1 */

fn value_to_expr_kind(val_tag: i32) -> i32 {
    if val_tag == 0 { return 0; }
    return 1;
}

/* ── enum store payload helpers ─────────────────────────────── */

fn payload_field_name(index: i32) -> i32 {
    return index;
}

fn enum_store_payload_count(val_count: i32) -> i32 {
    return val_count;
}

/* ── enum width (1 + maxPayload) ────────────────────────────── */

fn enum_alloc_width(max_payload: i32) -> i32 {
    return 1 + max_payload;
}

/* ── retValueSlot constant ──────────────────────────────────── */

fn ret_value_slot() -> string {
    return "_sv0ret";
}

/* ── find_fn_index (SML calleeRetCty helper — index into fn table) */

fn find_fn_index(fn_names: Vec<i32>, name_h: i32) -> i32 {
    let n: i32 = vec_len(fn_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(fn_names, i) == name_h { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── callee_fn_index (SML calleeRetCty — resolve alias + find) */

fn callee_fn_index(fn_names: Vec<i32>, aliases: Vec<i32>,
                   name_h: i32) -> i32 {
    let resolved: i32 = resolve_fn_callee(aliases, name_h);
    return find_fn_index(fn_names, resolved);
}

fn callee_fn_index_match_env(env: Vec<i32>, aliases: Vec<i32>,
                             name_h: i32) -> i32 {
    if lower_match_env_is_packed_v0(env) != 1 {
        return 0 - 1;
    }
    let fc: i32 = vec_get(env, 4);
    if fc <= 0 { return 0 - 1; }
    let bfn: i32 = vec_get(env, 2);
    if bfn < 0 { return 0 - 1; }
    let resolved: i32 = resolve_fn_callee(aliases, name_h);
    let mut j: i32 = 0;
    while j < fc {
        if vec_get(env, bfn + j) == resolved { return j; }
        j = j + 1;
    }
    return 0 - 1;
}

/* ── scrut_local_lookup / param_ty_lookup ──────────────────── */

fn scrut_local_lookup(scrut_names: Vec<i32>, name_h: i32) -> i32 {
    let n: i32 = vec_len(scrut_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(scrut_names, i) == name_h { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn param_ty_lookup(param_names: Vec<i32>, name_h: i32) -> i32 {
    let n: i32 = vec_len(param_names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(param_names, i) == name_h { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── handle_to_str (token handle → string) ──────────────────── */

fn handle_to_str(h: i32, source: string,
                 starts: Vec<i32>, ends: Vec<i32>) -> string {
    let s: i32 = vec_get(starts, h);
    let e: i32 = vec_get(ends, h);
    return string_substr(source, s, e - s);
}

/* ── emit_struct_td (SML emitStructTd) ──────────────────────── */

/* True if `name` (by TEXT) matches any handle in `list`. is_struct_cty/is_enum_cty
   compare by handle equality, which works in the SML pipeline (interned names share
   a handle) but not in the composed compiler (handles are token indices, so a field-
   type token — a use — never equals the struct-def token). This text fallback
   recovers user-struct/enum field types there. Bounds-safe. */
fn lower_name_in_handle_list(name: string, list: Vec<i32>,
                             source: string, starts: Vec<i32>, ends: Vec<i32>) -> bool {
    let n: i32 = vec_len(list);
    let mut i: i32 = 0;
    while i < n {
        let h: i32 = vec_get(list, i);
        if lower_tok_in_bounds(h, starts, ends) {
            if string_eq(handle_to_str(h, source, starts, ends), name) {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

fn emit_struct_td(name_h: i32,
                  fnames: Vec<i32>, ftypes: Vec<i32>,
                  foff: i32, fcount: i32,
                  source: string, starts: Vec<i32>, ends: Vec<i32>,
                  sn: Vec<i32>, en: Vec<i32>) -> string {
    let name: string = handle_to_str(name_h, source, starts, ends);
    let mut r: string = "typedef struct {\n";
    let mut i: i32 = 0;
    while i < fcount {
        let th: i32 = vec_get(ftypes, foff + i);
        let tname: string = handle_to_str(th, source, starts, ends);
        let mut cty: string = ast_ty_to_c_string_with_user(tname, th, sn, en);
        /* Composed-compiler fallback: a field whose type is a user struct/enum
           resolves to int under handle-equality (def-vs-use token mismatch); match
           by text so `span: Span` emits `Span span;` not `int span;`. */
        if string_eq(cty, "int") {
            if lower_name_in_handle_list(tname, sn, source, starts, ends) {
                cty = tname;
            } else {
                if lower_name_in_handle_list(tname, en, source, starts, ends) {
                    cty = tname;
                }
            }
        }
        let fname: string = handle_to_str(vec_get(fnames, foff + i), source, starts, ends);
        r = string_concat(r, "  ");
        r = string_concat(r, cty);
        r = string_concat(r, " ");
        r = string_concat(r, fname);
        r = string_concat(r, ";\n");
        i = i + 1;
    }
    r = string_concat(r, "} ");
    r = string_concat(r, name);
    r = string_concat(r, ";\n");
    return r;
}

/* ── emit_enum_td (SML emitEnumTd) ──────────────────────────── */

/* Payload-slot category codes (enum_slot_ctys_for_item's output; kept as
   i32 codes rather than a Vec<string> — Vec<T> is used i32-handle-style
   throughout this codebase, never with string elements). */
fn enum_slot_category_to_cty(cat: i32) -> string {
    if cat == 1 { return "double"; }
    if cat == 2 { return "int64_t"; }
    if cat == 3 { return "uint64_t"; }
    if cat == 4 { return "uint32_t"; }
    return "int";
}

/* `slot_cats[i]` (length `max_payload`) is that payload slot's category,
   already resolved by the caller (enum_slot_ctys_for_item) — see that
   function's doc comment for why every variant SHARES these numbered
   slots (BUGS.md #8, sv0-mathlib) and how a slot's type gets picked. */
fn emit_enum_td(name_h: i32, max_payload: i32, slot_cats: Vec<i32>,
                source: string, starts: Vec<i32>, ends: Vec<i32>) -> string {
    let name: string = handle_to_str(name_h, source, starts, ends);
    let mut r: string = "typedef struct {\n  int tag;\n";
    let mut i: i32 = 0;
    while i < max_payload {
        r = string_concat(r, "  ");
        r = string_concat(r, enum_slot_category_to_cty(vec_get(slot_cats, i)));
        r = string_concat(r, " p");
        r = string_concat(r, lower_int_to_str(i));
        r = string_concat(r, ";\n");
        i = i + 1;
    }
    r = string_concat(r, "} ");
    r = string_concat(r, name);
    r = string_concat(r, ";\n");
    return r;
}

/* ── build_struct_order (SML buildStructOrder) ──────────────── */

fn build_struct_order(item_tags: Vec<i32>, item_names: Vec<i32>,
                      item_field_counts: Vec<i32>,
                      struct_fnames_flat: Vec<i32>,
                      out_names: Vec<i32>,
                      out_offsets: Vec<i32>,
                      out_counts: Vec<i32>,
                      out_flat: Vec<i32>) -> i32 {
    let n: i32 = vec_len(item_tags);
    let mut i: i32 = 0;
    let mut sf: i32 = 0;
    while i < n {
        let tag: i32 = vec_get(item_tags, i);
        let fc: i32 = vec_get(item_field_counts, i);
        if tag == 1 {
            vec_push(out_names, vec_get(item_names, i));
            vec_push(out_offsets, vec_len(out_flat));
            vec_push(out_counts, fc);
            let mut j: i32 = 0;
            while j < fc {
                vec_push(out_flat, vec_get(struct_fnames_flat, sf + j));
                j = j + 1;
            }
            sf = sf + fc;
        }
        i = i + 1;
    }
    return vec_len(out_names);
}

/* ── build_enum_variants_data (SML buildEnumVariants) ────────── */

fn build_enum_variants_data(item_tags: Vec<i32>, item_names: Vec<i32>,
                            item_field_counts: Vec<i32>,
                            item_vmax: Vec<i32>,
                            enum_vnames_flat: Vec<i32>,
                            out_names: Vec<i32>,
                            out_tag_offsets: Vec<i32>,
                            out_tag_counts: Vec<i32>,
                            out_tags_flat: Vec<i32>,
                            out_max_payloads: Vec<i32>) -> i32 {
    let n: i32 = vec_len(item_tags);
    let mut i: i32 = 0;
    let mut ev: i32 = 0;
    while i < n {
        let tag: i32 = vec_get(item_tags, i);
        let vc: i32 = vec_get(item_field_counts, i);
        if tag == 2 {
            vec_push(out_names, vec_get(item_names, i));
            vec_push(out_tag_offsets, vec_len(out_tags_flat));
            vec_push(out_tag_counts, vc);
            vec_push(out_max_payloads, vec_get(item_vmax, i));
            let mut j: i32 = 0;
            while j < vc {
                vec_push(out_tags_flat, vec_get(enum_vnames_flat, ev + j));
                vec_push(out_tags_flat, j);
                j = j + 1;
            }
            ev = ev + vc;
        }
        i = i + 1;
    }
    return vec_len(out_names);
}

/* i64/u64/u32/f32/f64 payload category (2/2/4/1/1 — u32 gets its own
   category, 4, since it needs `uint32_t` specifically, not `int64_t`);
   0 (the safe "just use int" default) for i8/u8/i16/u16/i32/bool/isize/
   usize/unrecognized. Deliberately narrower than
   is_wide_primitive_ty_name/megatu_cty_category (bugs #1/#5/#7): those
   only ever needed 3 buckets (int/double/int64_t) because a temp variable
   is never *shared* the way an enum payload slot is; here u32 needs its
   own bucket because a slot can't silently widen an unsigned value into a
   signed 64-bit type across variant boundaries without risking a real
   mismatch. i8/u8/i16/u16/isize/usize stay in the "int" bucket: sv0's own
   ast_ty_to_c_string maps most of those to distinct C types too, but none
   of them come up in a payload today and int is a safe (if not maximally
   precise) default for a first version of this fix. */
fn enum_payload_ty_name_to_category(name: string) -> i32 {
    if string_eq(name, "i64") { return 2; }
    if string_eq(name, "u64") { return 2; }
    if string_eq(name, "u32") { return 4; }
    if string_eq(name, "f32") { return 1; }
    if string_eq(name, "f64") { return 1; }
    return 0;
}

/* Every variant of an sv0 enum shares the SAME numbered payload slots in
   the emitted C struct (a flat tagged struct, not a real C union) — slot 0
   might be `Some(T)`'s `T`, or a completely different type from a
   different variant's slot 0. Resolve each slot's category by scanning
   every variant of this item: if every variant that actually HAS a
   payload there agrees on a non-default category, use it; if none do
   (all default/mixed/no payload), fall back to category 0 ("int", the
   pre-existing, always-safe behavior — never a regression, only ever an
   improvement when there's real agreement to use). BUGS.md #8,
   sv0-mathlib: this is what makes `enum Option<T> { Some(T), None }`
   instantiated with `T = i64` or `T = f64` (this library's own concrete,
   non-generic per-type Option shapes) declare a correctly-typed payload
   instead of always `int`.
   payload_offset_by_variant[v] locates variant v's own payload run inside
   the flat evptn/enum_variant_payload_ty_name_tok array — precomputed
   once by the caller as a running sum of enum_variant_payload_count_by_variant,
   since slot 0 resets per-variant but the flat array doesn't. */
fn enum_slot_ctys_for_item(vbase: i32, vcount: i32, max_payload: i32,
                           evpv: Vec<i32>, evptn: Vec<i32>,
                           payload_offset_by_variant: Vec<i32>,
                           source: string, starts: Vec<i32>, ends: Vec<i32>) -> Vec<i32> {
    let slot_cats: Vec<i32> = vec_new();
    let mut s: i32 = 0;
    while s < max_payload {
        let mut agreed_cat: i32 = 0 - 1;
        let mut conflict: bool = false;
        let mut v: i32 = vbase;
        while v < vbase + vcount {
            let vpc: i32 = vec_get(evpv, v);
            if s < vpc {
                let ptok: i32 = vec_get(evptn, vec_get(payload_offset_by_variant, v) + s);
                let mut cat: i32 = 0;
                if ptok >= 0 {
                    if lower_tok_in_bounds(ptok, starts, ends) {
                        cat = enum_payload_ty_name_to_category(
                            handle_to_str(ptok, source, starts, ends));
                    }
                }
                if cat != 0 {
                    if agreed_cat < 0 {
                        agreed_cat = cat;
                    } else {
                        if agreed_cat != cat {
                            conflict = true;
                        }
                    }
                }
            }
            v = v + 1;
        }
        if conflict {
            vec_push(slot_cats, 0);
        } else {
            if agreed_cat < 0 {
                vec_push(slot_cats, 0);
            } else {
                vec_push(slot_cats, agreed_cat);
            }
        }
        s = s + 1;
    }
    return slot_cats;
}

/* ── collect_typedefs_str (SML collectTypedefs) ──────────────── */

fn collect_typedefs_str(item_tags: Vec<i32>, item_names: Vec<i32>,
                        item_field_counts: Vec<i32>,
                        item_vmax: Vec<i32>,
                        sf_names: Vec<i32>, sf_types: Vec<i32>,
                        source: string, starts: Vec<i32>, ends: Vec<i32>,
                        sn: Vec<i32>, en: Vec<i32>,
                        item_d3: Vec<i32>, evpv: Vec<i32>, evptn: Vec<i32>) -> string {
    let n: i32 = vec_len(item_tags);
    let mut r: string = "";
    let mut i: i32 = 0;
    let mut sf: i32 = 0;
    while i < n {
        let tag: i32 = vec_get(item_tags, i);
        let fc: i32 = vec_get(item_field_counts, i);
        if tag == 1 {
            let td: string = emit_struct_td(vec_get(item_names, i),
                                             sf_names, sf_types,
                                             sf, fc,
                                             source, starts, ends,
                                             sn, en);
            r = string_concat(r, td);
            sf = sf + fc;
        }
        i = i + 1;
    }
    /* payload_offset_by_variant[v] = running sum of evpv[0..v) — locates
       variant v's own payload run inside the flat evptn array (slot 0
       resets per-variant; evptn does not). Computed once, up front, over
       ALL variants of ALL enum items (evpv/evptn are program-wide flat
       arrays), then indexed per-item below via item_d3 (= each enum
       item's own variant-range base into this same variant ordering). */
    let payload_offset_by_variant: Vec<i32> = vec_new();
    let vn: i32 = vec_len(evpv);
    let mut running: i32 = 0;
    let mut vi: i32 = 0;
    while vi < vn {
        vec_push(payload_offset_by_variant, running);
        running = running + vec_get(evpv, vi);
        vi = vi + 1;
    }
    i = 0;
    while i < n {
        if vec_get(item_tags, i) == 2 {
            let mp: i32 = vec_get(item_vmax, i);
            let slot_cats: Vec<i32> = enum_slot_ctys_for_item(
                vec_get(item_d3, i), vec_get(item_field_counts, i), mp,
                evpv, evptn, payload_offset_by_variant,
                source, starts, ends);
            let td2: string = emit_enum_td(vec_get(item_names, i),
                                            mp, slot_cats,
                                            source, starts, ends);
            r = string_concat(r, td2);
        }
        i = i + 1;
    }
    return r;
}

/* ── mentions_result (SML mentionsResult — expr arena walk) ─── */

fn mentions_result(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                   ed3: Vec<i32>, ed4: Vec<i32>, idx: i32,
                   source: string, starts: Vec<i32>,
                   ends: Vec<i32>, pp: Vec<i32>) -> bool {
    if idx < 0 { return false; }
    let tag: i32 = vec_get(et, idx);
    if tag == 0 { return false; }
    if tag == 1 {
        let ppc: i32 = vec_get(ed2, idx);
        if ppc == 1 {
            let tok: i32 = vec_get(pp, vec_get(ed1, idx));
            return string_eq(handle_to_str(tok, source, starts, ends), "result");
        }
        return false;
    }
    if tag == 2 {
        return mentions_result(et, ed1, ed2, ed3, ed4,
                               vec_get(ed2, idx), source, starts, ends, pp);
    }
    if tag == 3 {
        if mentions_result(et, ed1, ed2, ed3, ed4,
                           vec_get(ed2, idx), source, starts, ends, pp) { return true; }
        return mentions_result(et, ed1, ed2, ed3, ed4,
                               vec_get(ed3, idx), source, starts, ends, pp);
    }
    if tag == 4 {
        if mentions_result(et, ed1, ed2, ed3, ed4,
                           vec_get(ed1, idx), source, starts, ends, pp) { return true; }
        let af: i32 = vec_get(ed2, idx);
        let ac: i32 = vec_get(ed3, idx);
        let mut ai: i32 = 0;
        while ai < ac {
            if mentions_result(et, ed1, ed2, ed3, ed4,
                               af + ai, source, starts, ends, pp) { return true; }
            ai = ai + 1;
        }
        return false;
    }
    if tag == 6 {
        return mentions_result(et, ed1, ed2, ed3, ed4,
                               vec_get(ed1, idx), source, starts, ends, pp);
    }
    if tag == 10 {
        if mentions_result(et, ed1, ed2, ed3, ed4,
                           vec_get(ed1, idx), source, starts, ends, pp) { return true; }
        if mentions_result(et, ed1, ed2, ed3, ed4,
                           vec_get(ed2, idx), source, starts, ends, pp) { return true; }
        return mentions_result(et, ed1, ed2, ed3, ed4,
                               vec_get(ed3, idx), source, starts, ends, pp);
    }
    if tag == 11 {
        if mentions_result(et, ed1, ed2, ed3, ed4,
                           vec_get(ed1, idx), source, starts, ends, pp) { return true; }
        let amf: i32 = vec_get(ed2, idx);
        let amc: i32 = vec_get(ed3, idx);
        let mut ami: i32 = 0;
        while ami < amc {
            let aidx: i32 = amf + ami;
            let grd: i32 = vec_get(ed3, aidx);
            if grd >= 0 {
                if mentions_result(et, ed1, ed2, ed3, ed4,
                                   grd, source, starts, ends, pp) { return true; }
            }
            if mentions_result(et, ed1, ed2, ed3, ed4,
                               vec_get(ed4, aidx), source, starts, ends, pp) { return true; }
            ami = ami + 1;
        }
        return false;
    }
    if tag == 12 {
        if mentions_result(et, ed1, ed2, ed3, ed4,
                           vec_get(ed1, idx), source, starts, ends, pp) { return true; }
        let invf: i32 = vec_get(ed3, idx);
        let invc: i32 = vec_get(ed4, idx);
        let mut ii: i32 = 0;
        while ii < invc {
            if mentions_result(et, ed1, ed2, ed3, ed4,
                               invf + ii, source, starts, ends, pp) { return true; }
            ii = ii + 1;
        }
        return mentions_result(et, ed1, ed2, ed3, ed4,
                               vec_get(ed2, idx), source, starts, ends, pp);
    }
    if tag == 13 {
        if mentions_result(et, ed1, ed2, ed3, ed4,
                           vec_get(ed2, idx), source, starts, ends, pp) { return true; }
        return mentions_result(et, ed1, ed2, ed3, ed4,
                               vec_get(ed3, idx), source, starts, ends, pp);
    }
    if tag == 14 {
        return mentions_result(et, ed1, ed2, ed3, ed4,
                               vec_get(ed1, idx), source, starts, ends, pp);
    }
    if tag == 16 {
        return mentions_result(et, ed1, ed2, ed3, ed4,
                               vec_get(ed1, idx), source, starts, ends, pp);
    }
    if tag == 20 {
        return mentions_result(et, ed1, ed2, ed3, ed4,
                               vec_get(ed1, idx), source, starts, ends, pp);
    }
    if tag == 22 {
        return mentions_result(et, ed1, ed2, ed3, ed4,
                               vec_get(ed1, idx), source, starts, ends, pp);
    }
    if tag == 24 {
        let sfc: i32 = vec_get(ed3, idx);
        let mut sfi: i32 = 0;
        while sfi < sfc {
            if mentions_result(et, ed1, ed2, ed3, ed4,
                               idx - sfc + sfi, source, starts, ends, pp) { return true; }
            sfi = sfi + 1;
        }
        return false;
    }
    if tag == 25 {
        let tf: i32 = vec_get(ed1, idx);
        let tc: i32 = vec_get(ed2, idx);
        let mut ti: i32 = 0;
        while ti < tc {
            if mentions_result(et, ed1, ed2, ed3, ed4,
                               tf + ti, source, starts, ends, pp) { return true; }
            ti = ti + 1;
        }
        return false;
    }
    if tag == 30 {
        return false;
    }
    return false;
}

fn first_result_path_handle(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                            ed3: Vec<i32>, ed4: Vec<i32>, idx: i32,
                            source: string, starts: Vec<i32>,
                            ends: Vec<i32>, pp: Vec<i32>) -> i32 {
    if idx < 0 { return 0 - 1; }
    let tag: i32 = vec_get(et, idx);
    if tag == 1 {
        let ppc: i32 = vec_get(ed2, idx);
        if ppc == 1 {
            let tok: i32 = vec_get(pp, vec_get(ed1, idx));
            if string_eq(handle_to_str(tok, source, starts, ends), "result") {
                return tok;
            }
        }
        return 0 - 1;
    }
    if tag == 0 { return 0 - 1; }
    if tag == 2 {
        return first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                        vec_get(ed2, idx), source, starts, ends, pp);
    }
    if tag == 3 {
        let r1: i32 = first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                               vec_get(ed2, idx), source, starts, ends, pp);
        if r1 >= 0 { return r1; }
        return first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                        vec_get(ed3, idx), source, starts, ends, pp);
    }
    if tag == 4 {
        let c: i32 = first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                              vec_get(ed1, idx), source, starts, ends, pp);
        if c >= 0 { return c; }
        let af: i32 = vec_get(ed2, idx);
        let ac: i32 = vec_get(ed3, idx);
        let mut ai: i32 = 0;
        while ai < ac {
            let ra: i32 = first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                                   af + ai, source, starts, ends, pp);
            if ra >= 0 { return ra; }
            ai = ai + 1;
        }
        return 0 - 1;
    }
    if tag == 6 || tag == 14 || tag == 16 || tag == 20 || tag == 22 {
        return first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                        vec_get(ed1, idx), source, starts, ends, pp);
    }
    if tag == 10 {
        let rc: i32 = first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                               vec_get(ed1, idx), source, starts, ends, pp);
        if rc >= 0 { return rc; }
        let rt: i32 = first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                               vec_get(ed2, idx), source, starts, ends, pp);
        if rt >= 0 { return rt; }
        return first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                        vec_get(ed3, idx), source, starts, ends, pp);
    }
    if tag == 11 {
        let rs: i32 = first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                               vec_get(ed1, idx), source, starts, ends, pp);
        if rs >= 0 { return rs; }
        let af2: i32 = vec_get(ed2, idx);
        let ac2: i32 = vec_get(ed3, idx);
        let mut ai2: i32 = 0;
        while ai2 < ac2 {
            let aidx: i32 = af2 + ai2;
            let grd: i32 = vec_get(ed3, aidx);
            if grd >= 0 {
                let rg: i32 = first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                                       grd, source, starts, ends, pp);
                if rg >= 0 { return rg; }
            }
            let rb: i32 = first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                                   vec_get(ed4, aidx), source, starts, ends, pp);
            if rb >= 0 { return rb; }
            ai2 = ai2 + 1;
        }
        return 0 - 1;
    }
    if tag == 12 {
        let rc2: i32 = first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                                vec_get(ed1, idx), source, starts, ends, pp);
        if rc2 >= 0 { return rc2; }
        let invf: i32 = vec_get(ed3, idx);
        let invc: i32 = vec_get(ed4, idx);
        let mut ii: i32 = 0;
        while ii < invc {
            let ri: i32 = first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                                   invf + ii, source, starts, ends, pp);
            if ri >= 0 { return ri; }
            ii = ii + 1;
        }
        return first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                        vec_get(ed2, idx), source, starts, ends, pp);
    }
    if tag == 13 {
        let ri1: i32 = first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                                vec_get(ed2, idx), source, starts, ends, pp);
        if ri1 >= 0 { return ri1; }
        return first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                        vec_get(ed3, idx), source, starts, ends, pp);
    }
    if tag == 24 {
        let sfc: i32 = vec_get(ed3, idx);
        let mut sfi: i32 = 0;
        while sfi < sfc {
            let rr: i32 = first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                                   idx - sfc + sfi, source, starts, ends, pp);
            if rr >= 0 { return rr; }
            sfi = sfi + 1;
        }
        return 0 - 1;
    }
    if tag == 25 {
        let tf: i32 = vec_get(ed1, idx);
        let tc: i32 = vec_get(ed2, idx);
        let mut ti: i32 = 0;
        while ti < tc {
            let rr2: i32 = first_result_path_handle(et, ed1, ed2, ed3, ed4,
                                                    tf + ti, source, starts, ends, pp);
            if rr2 >= 0 { return rr2; }
            ti = ti + 1;
        }
        return 0 - 1;
    }
    return 0 - 1;
}

/* ── all_old_names_expr (SML allOldNames — collect old(x) handles) */

fn all_old_names_expr(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                      ed3: Vec<i32>, ed4: Vec<i32>, idx: i32,
                      source: string, starts: Vec<i32>,
                      ends: Vec<i32>, pp: Vec<i32>,
                      out: Vec<i32>) -> i32 {
    if idx < 0 { return 0; }
    let tag: i32 = vec_get(et, idx);
    if tag == 0 { return 0; }
    if tag == 1 { return 0; }
    if tag == 4 {
        let callee: i32 = vec_get(ed1, idx);
        let ac: i32 = vec_get(ed3, idx);
        if ac == 1 {
            let ct: i32 = vec_get(et, callee);
            if ct == 1 {
                let cppc: i32 = vec_get(ed2, callee);
                if cppc == 1 {
                    let ctok: i32 = vec_get(pp, vec_get(ed1, callee));
                    if string_eq(handle_to_str(ctok, source, starts, ends), "old") {
                        let arg0: i32 = vec_get(ed2, idx);
                        let at: i32 = vec_get(et, arg0);
                        if at == 1 {
                            let appc: i32 = vec_get(ed2, arg0);
                            if appc == 1 {
                                let ntok: i32 = vec_get(pp, vec_get(ed1, arg0));
                                vec_push(out, ntok);
                                return 1;
                            }
                        }
                    }
                }
            }
        }
        all_old_names_expr(et, ed1, ed2, ed3, ed4, callee,
                           source, starts, ends, pp, out);
        let af: i32 = vec_get(ed2, idx);
        let mut ai: i32 = 0;
        while ai < ac {
            all_old_names_expr(et, ed1, ed2, ed3, ed4, af + ai,
                               source, starts, ends, pp, out);
            ai = ai + 1;
        }
        return 0;
    }
    if tag == 2 {
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed2, idx), source, starts, ends, pp, out);
        return 0;
    }
    if tag == 3 {
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed2, idx), source, starts, ends, pp, out);
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed3, idx), source, starts, ends, pp, out);
        return 0;
    }
    if tag == 6 {
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed1, idx), source, starts, ends, pp, out);
        return 0;
    }
    if tag == 10 {
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed1, idx), source, starts, ends, pp, out);
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed2, idx), source, starts, ends, pp, out);
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed3, idx), source, starts, ends, pp, out);
        return 0;
    }
    if tag == 11 {
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed1, idx), source, starts, ends, pp, out);
        let amf: i32 = vec_get(ed2, idx);
        let amc: i32 = vec_get(ed3, idx);
        let mut ami: i32 = 0;
        while ami < amc {
            let aidx: i32 = amf + ami;
            let grd: i32 = vec_get(ed3, aidx);
            if grd >= 0 {
                all_old_names_expr(et, ed1, ed2, ed3, ed4,
                                   grd, source, starts, ends, pp, out);
            }
            all_old_names_expr(et, ed1, ed2, ed3, ed4,
                               vec_get(ed4, aidx), source, starts, ends, pp, out);
            ami = ami + 1;
        }
        return 0;
    }
    if tag == 12 {
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed1, idx), source, starts, ends, pp, out);
        let invf: i32 = vec_get(ed3, idx);
        let invc: i32 = vec_get(ed4, idx);
        let mut ii: i32 = 0;
        while ii < invc {
            all_old_names_expr(et, ed1, ed2, ed3, ed4,
                               invf + ii, source, starts, ends, pp, out);
            ii = ii + 1;
        }
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed2, idx), source, starts, ends, pp, out);
        return 0;
    }
    if tag == 13 {
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed2, idx), source, starts, ends, pp, out);
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed3, idx), source, starts, ends, pp, out);
        return 0;
    }
    if tag == 14 {
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed1, idx), source, starts, ends, pp, out);
        return 0;
    }
    if tag == 20 {
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed1, idx), source, starts, ends, pp, out);
        return 0;
    }
    if tag == 21 {
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed1, idx), source, starts, ends, pp, out);
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed2, idx), source, starts, ends, pp, out);
        return 0;
    }
    if tag == 22 {
        all_old_names_expr(et, ed1, ed2, ed3, ed4,
                           vec_get(ed1, idx), source, starts, ends, pp, out);
        return 0;
    }
    if tag == 24 {
        let sfc: i32 = vec_get(ed3, idx);
        let mut sfi: i32 = 0;
        while sfi < sfc {
            all_old_names_expr(et, ed1, ed2, ed3, ed4,
                               idx - sfc + sfi, source, starts, ends, pp, out);
            sfi = sfi + 1;
        }
        return 0;
    }
    if tag == 25 {
        let tf: i32 = vec_get(ed1, idx);
        let tc: i32 = vec_get(ed2, idx);
        let mut ti: i32 = 0;
        while ti < tc {
            all_old_names_expr(et, ed1, ed2, ed3, ed4,
                               tf + ti, source, starts, ends, pp, out);
            ti = ti + 1;
        }
        return 0;
    }
    if tag == 9 {
        let sf: i32 = vec_get(ed1, idx);
        let sc: i32 = vec_get(ed2, idx);
        let mut si: i32 = 0;
        while si < sc {
            let sidx: i32 = sf + si;
            let stag: i32 = vec_get(et, sidx);
            if stag == 27 {
                let ini: i32 = vec_get(ed3, sidx);
                if ini >= 0 {
                    all_old_names_expr(et, ed1, ed2, ed3, ed4,
                                       ini, source, starts, ends, pp, out);
                }
            }
            if stag == 28 {
                all_old_names_expr(et, ed1, ed2, ed3, ed4,
                                   vec_get(ed1, sidx), source, starts, ends, pp, out);
            }
            si = si + 1;
        }
        let tail: i32 = vec_get(ed3, idx);
        if tail >= 0 {
            all_old_names_expr(et, ed1, ed2, ed3, ed4,
                               tail, source, starts, ends, pp, out);
        }
        return 0;
    }
    if tag == 30 {
        return 0;
    }
    return 0;
}

/* ── expr_init_cty (SML exprInitCty) ────────────────────────
   Infer the type name token handle from an expression's shape.
   Used by scan_lets when no type annotation is stored in the arena.
   Tag reference:  0=ExprLit, 1=ExprPath, 4=ExprCall, 24=ExprStruct,
   25=ExprTuple.  Returns -1 for unresolvable cases (meaning "int").
   Arena note: the parser discards type annotations into ephemeral
   local Vecs, so we always infer from the init expression. */

fn expr_init_cty(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                 ed3: Vec<i32>, ed4: Vec<i32>, idx: i32,
                 pp: Vec<i32>,
                 fn_names: Vec<i32>, fn_ret_ctys: Vec<i32>,
                 aliases: Vec<i32>) -> i32 {
    if idx < 0 { return 0 - 1; }
    let tag: i32 = vec_get(et, idx);
    if tag == 24 {
        let pps: i32 = vec_get(ed1, idx);
        return vec_get(pp, pps);
    }
    if tag == 1 {
        let pps2: i32 = vec_get(ed1, idx);
        let ppc2: i32 = vec_get(ed2, idx);
        if ppc2 == 2 {
            return vec_get(pp, pps2);
        }
        return 0 - 1;
    }
    if tag == 4 {
        let callee: i32 = vec_get(ed1, idx);
        if callee >= 0 {
            let ct: i32 = vec_get(et, callee);
            if ct == 1 {
                let cpps: i32 = vec_get(ed1, callee);
                let cppc: i32 = vec_get(ed2, callee);
                if cppc == 1 {
                    let ftok: i32 = vec_get(pp, cpps);
                    let fi: i32 = callee_fn_index(fn_names, aliases, ftok);
                    if fi >= 0 {
                        return vec_get(fn_ret_ctys, fi);
                    }
                    return 0 - 1;
                }
                if cppc == 2 {
                    return vec_get(pp, cpps);
                }
            }
        }
        return 0 - 1;
    }
    if tag == 25 {
        let tc: i32 = vec_get(ed2, idx);
        if tc == 1 {
            let first: i32 = vec_get(ed1, idx);
            return expr_init_cty(et, ed1, ed2, ed3, ed4, first,
                       pp, fn_names, fn_ret_ctys, aliases);
        }
    }
    return 0 - 1;
}

/* ── scan_lets (SML scanLets) ──────────────────────────────────
   Walk ExprBlock stmt children for LetStmt(27) with an init
   expression, collecting (name_handle, type_handle) pairs.
   Name handles go into out_names; type handles (from expr_init_cty)
   go into out_ctys (-1 means "int").  Returns pair count.
   Arena note: type annotations are not stored in the expr arena
   (parser discards them into ephemeral local Vecs), so we always
   infer via expr_init_cty — a known approximation until the
   parser stores type annotation data. */

fn scan_lets(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
             ed3: Vec<i32>, ed4: Vec<i32>,
             block_idx: i32,
             pp: Vec<i32>,
             fn_names: Vec<i32>, fn_ret_ctys: Vec<i32>,
             aliases: Vec<i32>,
             out_names: Vec<i32>,
             out_ctys: Vec<i32>) -> i32 {
    if block_idx < 0 { return 0; }
    let btag: i32 = vec_get(et, block_idx);
    if btag != 9 { return 0; }
    let sf: i32 = vec_get(ed1, block_idx);
    let sc: i32 = vec_get(ed2, block_idx);
    let mut count: i32 = 0;
    let mut i: i32 = 0;
    while i < sc {
        let sidx: i32 = sf + i;
        let stag: i32 = vec_get(et, sidx);
        if stag == 27 {
            let init: i32 = vec_get(ed3, sidx);
            if init >= 0 {
                let nh: i32 = vec_get(ed1, sidx);
                let th: i32 = expr_init_cty(et, ed1, ed2, ed3, ed4,
                                  init, pp, fn_names, fn_ret_ctys,
                                  aliases);
                vec_push(out_names, nh);
                vec_push(out_ctys, th);
                count = count + 1;
            }
        }
        i = i + 1;
    }
    return count;
}

/* ── scrut_locals_push (SML withScrutLocals) ─────────────────
   Same logical-length model as type_param_push: scrut locals
   are stride-2 (name_handle, type_string_handle) in parallel
   Vecs.  Push returns the saved length; callers pass saved_len
   as limit to scrut_local_lookup to restrict scope.
   "restore" = use the saved_len as limit.                   */

fn scrut_locals_push(scrut_names: Vec<i32>,
                     scrut_types: Vec<i32>,
                     extra_names: Vec<i32>,
                     extra_types: Vec<i32>) -> i32 {
    let saved: i32 = vec_len(scrut_names);
    let en: i32 = vec_len(extra_names);
    let mut i: i32 = 0;
    while i < en {
        vec_push(scrut_names, vec_get(extra_names, i));
        vec_push(scrut_types, vec_get(extra_types, i));
        i = i + 1;
    }
    return saved;
}

fn scrut_local_lookup_bounded(scrut_names: Vec<i32>,
                              limit: i32,
                              name_h: i32) -> i32 {
    let mut i: i32 = 0;
    while i < limit {
        if vec_get(scrut_names, i) == name_h { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── lower_alias_replace (SML setImportAliases) ─────────────
   Bulk replace the import alias table.  Takes source parallel
   Vecs of (from, to) handles and fills the target alias Vec
   (stride-2).  Returns the new count.  Callers allocate a
   fresh Vec via lower_alias_new() before calling.           */

fn lower_alias_replace(target: Vec<i32>,
                       from_handles: Vec<i32>,
                       to_handles: Vec<i32>) -> i32 {
    let n: i32 = vec_len(from_handles);
    let mut i: i32 = 0;
    while i < n {
        vec_push(target, vec_get(from_handles, i));
        vec_push(target, vec_get(to_handles, i));
        i = i + 1;
    }
    return n;
}

/* ── match_scrut_cty (SML matchScrutCty) ─────────────────────
   Determine the C type name handle for a match scrutinee
   expression.  Same dispatch as expr_init_cty but with
   additional probes into scrut_locals and fn param tables for
   single-segment paths.  Returns a type name token handle, or
   -1 for "int" (default).
   Tag reference: 0=ExprLit, 1=ExprPath, 4=ExprCall,
                  24=ExprStruct, 25=ExprTuple. */

fn match_scrut_cty(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                   ed3: Vec<i32>, ed4: Vec<i32>, idx: i32,
                   pp: Vec<i32>,
                   match_env: Vec<i32>,
                   aliases: Vec<i32>,
                   scrut_names: Vec<i32>, scrut_ctys: Vec<i32>,
                   scrut_limit: i32) -> i32 {
    if idx < 0 { return 0 - 1; }
    let tag: i32 = vec_get(et, idx);
    /* ExprLit scrutinee: treat like unknown scalar (-1), same as
       expr_init_cty default for literals. */
    if tag == 0 {
        return 0 - 1;
    }
    if tag == 24 {
        let pps24: i32 = vec_get(ed1, idx);
        return vec_get(pp, pps24);
    }
    if tag == 1 {
        let pps: i32 = vec_get(ed1, idx);
        let ppc: i32 = vec_get(ed2, idx);
        if ppc == 2 {
            return vec_get(pp, pps);
        }
        if ppc == 1 {
            let name_h: i32 = vec_get(pp, pps);
            let si: i32 = scrut_local_lookup_bounded(scrut_names,
                                                      scrut_limit, name_h);
            if si >= 0 { return vec_get(scrut_ctys, si); }
            let mut lim_e: i32 = 0;
            if lower_match_env_is_packed_v0(match_env) == 1 {
                lim_e = vec_get(match_env, 10);
            }
            if scrut_limit > 0 {
                if lim_e > scrut_limit {
                    lim_e = scrut_limit;
                }
            }
            if lim_e > 0 {
                let te: i32 = lower_match_env_scrut_ty_lookup(match_env,
                    lim_e, name_h);
                if te != 0 - 2 {
                    return te;
                }
            }
            let pc: i32 = vec_get(match_env, 7);
            if pc > 0 {
                let bn: i32 = vec_get(match_env, 5);
                let bt: i32 = vec_get(match_env, 6);
                if bn >= 0 {
                    if bt >= 0 {
                        let mut pj: i32 = 0;
                        while pj < pc {
                            if vec_get(match_env, bn + pj) == name_h {
                                return vec_get(match_env, bt + pj);
                            }
                            pj = pj + 1;
                        }
                    }
                }
            }
            return 0 - 1;
        }
        return 0 - 1;
    }
    if tag == 4 {
        let callee: i32 = vec_get(ed1, idx);
        if callee >= 0 {
            let ct: i32 = vec_get(et, callee);
            if ct == 1 {
                let cpps: i32 = vec_get(ed1, callee);
                let cppc: i32 = vec_get(ed2, callee);
                if cppc == 2 {
                    return vec_get(pp, cpps);
                }
                if cppc == 1 {
                    let ftok: i32 = vec_get(pp, cpps);
                    let fi: i32 = callee_fn_index_match_env(match_env,
                        aliases, ftok);
                    if fi >= 0 {
                        let brt: i32 = vec_get(match_env, 3);
                        return vec_get(match_env, brt + fi);
                    }
                    return 0 - 1;
                }
            }
        }
        return 0 - 1;
    }
    if tag == 25 {
        let tc: i32 = vec_get(ed2, idx);
        if tc == 1 {
            let first: i32 = vec_get(ed1, idx);
            return match_scrut_cty(et, ed1, ed2, ed3, ed4, first,
                       pp, match_env, aliases,
                       scrut_names, scrut_ctys, scrut_limit);
        }
    }
    return 0 - 1;
}

/* ── variant_field_count_in_items (building block) ──────────
   Given an enum name handle and a variant flat index within
   the enum, look up the variant's shape tag from a variant
   shapes flat array.  The shapes flat array parallels the
   variant names flat array (one entry per variant).
   Returns:  0 = VSUnit, 1 = VSTuple, 2 = VSStruct, -1 = not found.
   `field_count` is returned through the out_count Vec (single push). */

fn variant_shape_in_items(item_tags: Vec<i32>, item_names: Vec<i32>,
                          item_field_counts: Vec<i32>,
                          variant_shapes_flat: Vec<i32>,
                          variant_fcs_flat: Vec<i32>,
                          enum_name: i32, variant_idx: i32,
                          out_count: Vec<i32>) -> i32 {
    let n: i32 = vec_len(item_tags);
    let mut i: i32 = 0;
    let mut vn_offset: i32 = 0;
    while i < n {
        let tag: i32 = vec_get(item_tags, i);
        let vc: i32 = vec_get(item_field_counts, i);
        if tag == 2 {
            if vec_get(item_names, i) == enum_name {
                if variant_idx >= 0 {
                    if variant_idx < vc {
                        let shape: i32 = vec_get(variant_shapes_flat, vn_offset + variant_idx);
                        let fc: i32 = vec_get(variant_fcs_flat, vn_offset + variant_idx);
                        vec_push(out_count, fc);
                        return shape;
                    }
                }
                return 0 - 1;
            }
            vn_offset = vn_offset + vc;
        }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── ctr_fresh (mutable temp counter via Vec<i32>) ─────────── */
/* ctr is a single-element Vec<i32>; ctr[0] = current counter.
   Returns the current value and increments it. */

fn ctr_fresh(ctr: Vec<i32>) -> i32 {
    let n: i32 = vec_get(ctr, 0);
    vec_set(ctr, 0, n + 1);
    return n;
}

/* ── classify_assign_lhs_arena (SML classifyAssignLhs) ────────
   Examines the flat expression arena at `idx`.
   Parser expr tags: 1=ExprPath, 6=ExprField.
   If ExprPath (tag 1) with pp_count=1: pushes name_tok_pos to
   out, returns 0 (ALVar).
   If ExprField (tag 6) where obj is ExprPath(1-seg): pushes
   base_tok_pos and field_tok to out, returns 1 (ALField).
   Otherwise: returns -1 (invalid assignment target). */

fn classify_assign_lhs_arena(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                              pp: Vec<i32>,
                              idx: i32, out: Vec<i32>) -> i32 {
    let tag: i32 = vec_get(et, idx);
    if tag == 1 {
        let pps: i32 = vec_get(ed1, idx);
        let ppc: i32 = vec_get(ed2, idx);
        if ppc == 1 {
            vec_push(out, vec_get(pp, pps));
            return 0;
        }
        return 0 - 1;
    }
    if tag == 6 {
        let obj_idx: i32 = vec_get(ed1, idx);
        let field_tok: i32 = vec_get(ed2, idx);
        let obj_tag: i32 = vec_get(et, obj_idx);
        if obj_tag == 1 {
            let opps: i32 = vec_get(ed1, obj_idx);
            let oppc: i32 = vec_get(ed2, obj_idx);
            if oppc == 1 {
                vec_push(out, vec_get(pp, opps));
                vec_push(out, field_tok);
                return 1;
            }
        }
        return 0 - 1;
    }
    return 0 - 1;
}

