    let pp: Vec<i32> = vec_new();
    vec_push(pp, 0); vec_push(pp, 1); vec_push(pp, 2);
    let et: Vec<i32> = vec_new();
    let d1: Vec<i32> = vec_new();
    let d2: Vec<i32> = vec_new();
    let d3: Vec<i32> = vec_new();
    let d4: Vec<i32> = vec_new();
