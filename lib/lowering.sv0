    if r13 != 0 { return 150 + r13; }
    let r14: i32 = test_try_variants();
    if r14 != 0 { return 160 + r14; }
    let r15: i32 = test_literals();
    if r15 != 0 { return 170 + r15; }
    let r16: i32 = test_value_to_expr();
    if r16 != 0 { return 180 + r16; }
    let r17: i32 = test_enum_alloc();
    if r17 != 0 { return 190 + r17; }
    let r18: i32 = test_ret_value_slot();
    if r18 != 0 { return 200 + r18; }
    let r19: i32 = test_use_ret_slot();
    if r19 != 0 { return 210 + r19; }
    let r20: i32 = test_lit_supported();
    if r20 != 0 { return 220 + r20; }
    let r21: i32 = test_param_name_tag();
    if r21 != 0 { return 230 + r21; }
    let r22: i32 = test_uniq_old_names();
    if r22 != 0 { return 240 + r22; }
    let r23: i32 = test_fresh_tmp_str();
    if r23 != 0 { return 250 + r23; }
    let r24: i32 = test_lower_lit_ir();
    if r24 != 0 { return 260 + r24; }
    let r25: i32 = test_fn_ret_cty();
    if r25 != 0 { return 270 + r25; }
    let r26: i32 = test_lower_alias();
    if r26 != 0 { return 280 + r26; }
    let r27: i32 = test_resolve_fn_callee();
    if r27 != 0 { return 290 + r27; }
    let r28: i32 = test_resolve_ctor_path();
    if r28 != 0 { return 300 + r28; }
    return 0;
}
