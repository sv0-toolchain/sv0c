    let item_field_counts: Vec<i32> = vec_new();
    let enum_vnames_flat: Vec<i32> = vec_new();
    let enum_max_payloads: Vec<i32> = vec_new();
    let rc: i32 = lower_block(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                               1, 1, 0, 0, ctr, out, en_n, en_to, en_tc,
                               en_tf, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, vec_new(), vec_new());
    if rc != 0 { return 1; }
    if vec_len(out) < 3 { return 2; }
    let mut out2: Vec<i32> = vec_new();
    let rc2: i32 = lower_block(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                1, 1, 0 - 1, 0, ctr, out2,
                                en_n, en_to, en_tc, en_tf, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, vec_new(), vec_new());
    if rc2 != 0 { return 3; }
    if vec_len(out2) != 2 { return 4; }
    return 0;
}

fn test_value_to_expr_fn() -> i32 {
    let v1: Value = Value::VInt(42);
    let e1: Expr = value_to_expr(v1);
    if ir_expr_tag(e1) != 0 { return 1; }
    let v2: Value = Value::VVar(7);
    let e2: Expr = value_to_expr(v2);
    if ir_expr_tag(e2) != 1 { return 2; }
    let v3: Value = Value::VUnit;
    let e3: Expr = value_to_expr(v3);
    if ir_expr_tag(e3) != 0 { return 3; }
    let v4: Value = Value::VBoolTrue;
    let e4: Expr = value_to_expr(v4);
    if ir_expr_tag(e4) != 0 { return 4; }
    return 0;
}

