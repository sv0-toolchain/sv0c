                box_new(Expr::Literal(box_new(Value::VBoolTrue))), loop_body);
            vec_push(out_instrs, box_new(wl));
        }
        return Value::VUnit;
    }
    if tag == 13 {
        return lower_tag_for(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                              idx, ctr, out_instrs, enum_names,
                              enum_tag_offsets, enum_tag_counts,
                              enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    }
    if tag == 14 {
        let loop_body: i32 = vec_get(ed1, idx);
        let true_v: Value = Value::VBoolTrue;
        let true_e: Expr = Expr::Literal(box_new(true_v));
        let mut loop_is: Vec<i32> = vec_new();
        let discard4: i32 = lower_for_effect(et, ed1, ed2, ed3, ed4, pp,
                                                   tok_tags, loop_body, ctr,
                                                   loop_is, enum_names,
                                                   enum_tag_offsets,
                                                   enum_tag_counts,
                                                   enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let ll: Instr = Instr::WhileLoop(box_new(true_e), loop_is);
        vec_push(out_instrs, box_new(ll));
        return Value::VUnit;
    }
    if tag == 15 {
        let val_idx: i32 = vec_get(ed1, idx);
        if val_idx >= 0 {
            let rv: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                                 tok_tags, val_idx, ctr,
                                                 out_instrs, enum_names,
                                                 enum_tag_offsets,
                                                 enum_tag_counts,
                                                 enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
            let ret_instr: Instr = Instr::ReturnVal(box_new(rv));
            vec_push(out_instrs, box_new(ret_instr));
            return Value::VUnit;
        }
        let ret_void: Instr = Instr::ReturnVoid;
        vec_push(out_instrs, box_new(ret_void));
        return Value::VUnit;
    }
    if tag == 16 {
        let brk: Instr = Instr::Break;
        vec_push(out_instrs, box_new(brk));
        return Value::VUnit;
    }
    if tag == 17 {
        let cnt: Instr = Instr::Continue;
        vec_push(out_instrs, box_new(cnt));
        return Value::VUnit;
    }
    if tag == 18 {
        let lhs_idx: i32 = vec_get(ed1, idx);
        let rhs_idx: i32 = vec_get(ed2, idx);
        /* SML ExprAssign: Store(x, <rhs as Ir.expr>) via lowerExprWithInstrs —
           a binop RHS is stored directly, not spilled through a temp. */
        let rhs_e: Expr = lower_expr_with_instrs(et, ed1, ed2, ed3, ed4, pp,
                                                tok_tags, rhs_idx, ctr,
                                                out_instrs, enum_names,
                                                enum_tag_offsets,
                                                enum_tag_counts,
                                                enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        let mut aout: Vec<i32> = vec_new();
        let cls: i32 = classify_assign_lhs_arena(et, ed1, ed2, pp, lhs_idx,
                                                  aout);
        if cls == 0 {
            let var_tok: i32 = vec_get(aout, 0);
            let store: Instr = Instr::Store(var_tok, box_new(rhs_e));
            vec_push(out_instrs, box_new(store));
        }
        if cls == 1 {
            let obj_tok: i32 = vec_get(aout, 0);
            let fld_tok: i32 = vec_get(aout, 1);
            let sf: Instr = Instr::StoreField(obj_tok, fld_tok, box_new(rhs_e));
            vec_push(out_instrs, box_new(sf));
        }
        return Value::VUnit;
    }
    if tag == 19 {
        let op_tag: i32 = vec_get(ed1, idx);
        let lhs_idx2: i32 = vec_get(ed2, idx);
        let rhs_idx2: i32 = vec_get(ed3, idx);
        let mut aout2: Vec<i32> = vec_new();
        let cls2: i32 = classify_assign_lhs_arena(et, ed1, ed2, pp, lhs_idx2,
                                                   aout2);
        if cls2 == 0 {
            let var_tok2: i32 = vec_get(aout2, 0);
            let cur: Value = Value::VVar(var_tok2);
            let rv2: Value = lower_expr_to_value(et, ed1, ed2, ed3, ed4, pp,
                                                  tok_tags, rhs_idx2, ctr,
                                                  out_instrs, enum_names,
                                                  enum_tag_offsets,
                                                  enum_tag_counts,
                                                  enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
            let be: Expr = Expr::Binop(op_tag, box_new(cur), box_new(rv2));
            let st2: Instr = Instr::Store(var_tok2, box_new(be));
            vec_push(out_instrs, box_new(st2));
