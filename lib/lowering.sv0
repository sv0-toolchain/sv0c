    vec_push(et, 1); vec_push(d1, 1); vec_push(d2, 1); vec_push(d3, 0); vec_push(d4, 0);
    vec_push(et, 4); vec_push(d1, 0); vec_push(d2, 1); vec_push(d3, 1); vec_push(d4, 0);
    let out: Vec<i32> = vec_new();
    all_old_names_expr(et, d1, d2, d3, d4, 2, src, st, nd, pp, out);
    if vec_len(out) != 1 { return 2; }
    if vec_get(out, 0) != 1 { return 3; }
    let et2: Vec<i32> = vec_new();
    let e1: Vec<i32> = vec_new();
    let e2: Vec<i32> = vec_new();
    let e3: Vec<i32> = vec_new();
    let e4: Vec<i32> = vec_new();
    vec_push(et2, 1); vec_push(e1, 0); vec_push(e2, 1); vec_push(e3, 0); vec_push(e4, 0);
    vec_push(et2, 1); vec_push(e1, 1); vec_push(e2, 1); vec_push(e3, 0); vec_push(e4, 0);
    vec_push(et2, 4); vec_push(e1, 0); vec_push(e2, 1); vec_push(e3, 1); vec_push(e4, 0);
    vec_push(et2, 1); vec_push(e1, 2); vec_push(e2, 1); vec_push(e3, 0); vec_push(e4, 0);
    vec_push(et2, 4); vec_push(e1, 0); vec_push(e2, 3); vec_push(e3, 1); vec_push(e4, 0);
    vec_push(et2, 3); vec_push(e1, 0); vec_push(e2, 2); vec_push(e3, 4); vec_push(e4, 0);
    let out3: Vec<i32> = vec_new();
    all_old_names_expr(et2, e1, e2, e3, e4, 5, src, st, nd, pp, out3);
    if vec_len(out3) != 2 { return 4; }
    if vec_get(out3, 0) != 1 { return 5; }
    if vec_get(out3, 1) != 2 { return 6; }
    return 0;
}

