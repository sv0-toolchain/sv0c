fn test_lower_fn_contract_glue() -> i32 {
    let et: Vec<i32> = vec_new();
    let ed1: Vec<i32> = vec_new();
    let ed2: Vec<i32> = vec_new();
    let ed3: Vec<i32> = vec_new();
    let ed4: Vec<i32> = vec_new();
    let pp: Vec<i32> = vec_new();
    let tok_tags: Vec<i32> = vec_new();
    /* body literal */
    vec_push(et, 0); vec_push(ed1, 0); vec_push(ed2, 0); vec_push(ed3, 0); vec_push(ed4, 0);
    /* requires literal */
    vec_push(et, 0); vec_push(ed1, 0); vec_push(ed2, 0); vec_push(ed3, 0); vec_push(ed4, 0);
    /* ensures path `result` to trigger ret-slot flow */
    vec_push(et, 1); vec_push(ed1, 0); vec_push(ed2, 1); vec_push(ed3, 0); vec_push(ed4, 0);
    let source: string = "result";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 6);
    vec_push(pp, 0);
    let req_roots: Vec<i32> = vec_new();
    vec_push(req_roots, 1);
    let ens_roots: Vec<i32> = vec_new();
    vec_push(ens_roots, 2);
    let out: Vec<i32> = vec_new();
    let rc: i32 = lower_fn(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                           0, 55, req_roots, ens_roots, out,
                           vec_new(), vec_new(), vec_new(), vec_new(),
                           vec_new(), vec_new(), vec_new(),
                           source, starts, ends,
                           vec_new(), vec_new(), vec_new(), vec_new(), vec_new(),
                           vec_new(), vec_new(), vec_new(), 0 - 1, vec_new(), vec_new());
    if rc != 0 { return 1; }
    if vec_len(out) < 5 { return 2; }
    let i0: Instr = box_deref(vec_get(out, 0));
    if ir_instr_tag(i0) != 1 { return 3; }
    let i1: Instr = box_deref(vec_get(out, 1));
    if ir_instr_tag(i1) != 12 { return 4; }
    let mut has_ens: bool = false;
    let mut i: i32 = 2;
    while i < vec_len(out) {
        let ii: Instr = box_deref(vec_get(out, i));
        if ir_instr_tag(ii) == 13 { has_ens = true; }
        i = i + 1;
    }
    if has_ens != true { return 5; }
    let ilast: Instr = box_deref(vec_get(out, vec_len(out) - 1));
    if ir_instr_tag(ilast) != 15 { return 6; }
    return 0;
}

