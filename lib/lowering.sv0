    if string_eq(fn_ret_cty(true, "int32_t"), "int32_t") != true { return 2; }
    if string_eq(fn_ret_cty(true, "void"), "void") != true { return 3; }
    return 0;
}

fn test_lower_alias() -> i32 {
    let a: Vec<i32> = lower_alias_new();
    lower_alias_add(a, 10, 20);
    lower_alias_add(a, 30, 40);
    if lower_alias_lookup(a, 10) != 20 { return 1; }
    if lower_alias_lookup(a, 30) != 40 { return 2; }
    if lower_alias_lookup(a, 99) != 0 - 1 { return 3; }
    return 0;
}

fn test_resolve_fn_callee() -> i32 {
    let a: Vec<i32> = lower_alias_new();
    lower_alias_add(a, 10, 20);
    if resolve_fn_callee(a, 10) != 20 { return 1; }
    if resolve_fn_callee(a, 99) != 99 { return 2; }
    return 0;
}

fn test_resolve_ctor_path() -> i32 {
    let fe: Vec<i32> = vec_new();
    let fv: Vec<i32> = vec_new();
    let te: Vec<i32> = vec_new();
    let tv: Vec<i32> = vec_new();
    vec_push(fe, 10); vec_push(fv, 20);
    vec_push(te, 30); vec_push(tv, 40);
    let idx: i32 = resolve_enum_ctor_path(fe, fv, te, tv, 10, 20);
    if idx != 0 { return 1; }
    if resolved_ctor_enum(te, idx, 10) != 30 { return 2; }
    if resolved_ctor_variant(tv, idx, 20) != 40 { return 3; }
    let miss: i32 = resolve_enum_ctor_path(fe, fv, te, tv, 99, 88);
    if miss != 0 - 1 { return 4; }
    if resolved_ctor_enum(te, miss, 99) != 99 { return 5; }
    if resolved_ctor_variant(tv, miss, 88) != 88 { return 6; }
    return 0;
}

