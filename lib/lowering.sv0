    /* ExprRange: lo..hi has no scalar IR in this seed; evaluate
       optional endpoints for side effects (SML `lowerExprToValue`
       fallback would assign from `lowerExprWithInstrs`; full range
       value / for-desugar parity deferred). */
    if tag == 21 {
        let lo_ix: i32 = vec_get(ed1, idx);
        let hi_ix: i32 = vec_get(ed2, idx);
        if lo_ix >= 0 {
            lower_for_effect(et, ed1, ed2, ed3, ed4, pp, tok_tags, lo_ix,
                             ctr, out_instrs, enum_names, enum_tag_offsets,
                             enum_tag_counts, enum_tags_flat, fn_ctx,
                             builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        }
        if hi_ix >= 0 {
            lower_for_effect(et, ed1, ed2, ed3, ed4, pp, tok_tags, hi_ix,
                             ctr, out_instrs, enum_names, enum_tag_offsets,
                             enum_tag_counts, enum_tags_flat, fn_ctx,
                             builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        }
        return Value::VUnit;
    }
    if tag == 9 {
        return lower_tag_block(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                idx, ctr, out_instrs, enum_names,
                                enum_tag_offsets, enum_tag_counts,
                                enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases, 0, 0 - 1);
    }
    if tag == 10 {
        return lower_tag_if(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                             idx, ctr, out_instrs, enum_names,
                             enum_tag_offsets, enum_tag_counts,
                             enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    }
    if tag == 11 {
        return lower_tag_match(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                idx, ctr, out_instrs, enum_names,
                                enum_tag_offsets, enum_tag_counts,
                                enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
    }
    if tag == 12 {
        let cond_idx2: i32 = vec_get(ed1, idx);
        let body_idx2: i32 = vec_get(ed2, idx);
        /* Lower the condition to its own instr list + top-level Expr so it can be
           RE-EVALUATED each iteration (SML lowering.sml ExprWhile). */
        let mut cond_is: Vec<i32> = vec_new();
        let ce2: Expr = lower_cond_expr(et, ed1, ed2, ed3, ed4, pp, tok_tags,
                                        cond_idx2, ctr, cond_is,
                                        enum_names, enum_tag_offsets, enum_tag_counts,
                                        enum_tags_flat, fn_ctx, builtin_map, lit_sf_names,
                                        source, starts, ends, item_tags, item_names,
                                        item_d2, item_d3, item_d4, item_field_counts,
                                        enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit,
                                        import_aliases);
        let mut body_is: Vec<i32> = vec_new();
        let discard3: i32 = lower_for_effect(et, ed1, ed2, ed3, ed4, pp,
                                                   tok_tags, body_idx2, ctr,
                                                   body_is, enum_names,
                                                   enum_tag_offsets,
                                                   enum_tag_counts,
                                                   enum_tags_flat, fn_ctx, builtin_map, lit_sf_names, source, starts, ends, item_tags, item_names, item_d2, item_d3, item_d4, item_field_counts, enum_vnames_flat, enum_max_payloads, item_fn_row, match_env_inherit, import_aliases);
        if vec_len(cond_is) == 0 {
            /* Simple condition (no sub-instructions): while (cond) { body } — C
               re-evaluates the condition expression each iteration. */
            let wl: Instr = Instr::WhileLoop(box_new(ce2), body_is);
            vec_push(out_instrs, box_new(wl));
        } else {
            /* Complex condition: while (1) { cond_is; ct = cond; if (!ct) break;
               body } so the condition instructions re-run every iteration. */
            let ct_w: i32 = ctr_fresh(ctr);
            let loop_body: Vec<i32> = vec_new();
            let mut ci: i32 = 0;
            while ci < vec_len(cond_is) {
                vec_push(loop_body, vec_get(cond_is, ci));
                ci = ci + 1;
            }
            let asg_w: Instr = Instr::Assign(ct_w, box_new(ce2));
            vec_push(loop_body, box_new(asg_w));
            let neg_w: Expr = Expr::Unop(1, box_new(Value::VVar(ct_w)));
            let brk_blk: Vec<i32> = vec_new();
            vec_push(brk_blk, box_new(Instr::Break));
            let empty_else: Vec<i32> = vec_new();
            /* if (!ct) { break } else {} — break when the condition is FALSE. The
               break block is the THEN arm; putting it in the else arm inverts the
               loop (breaks while the condition holds), miscompiling any while whose
               condition needs sub-instructions, e.g. `while i < len - 1`. */
            let if_w: Instr = Instr::IfElse(box_new(neg_w), brk_blk, empty_else);
            vec_push(loop_body, box_new(if_w));
            let mut bi: i32 = 0;
            while bi < vec_len(body_is) {
                vec_push(loop_body, vec_get(body_is, bi));
                bi = bi + 1;
            }
