    if param_name_tag(1) != true { return 1; }
    if param_name_tag(0) != false { return 2; }
    if param_name_tag(2) != false { return 3; }
    return 0;
}

fn test_uniq_old_names() -> i32 {
    let names: Vec<i32> = vec_new();
    vec_push(names, 10); vec_push(names, 20); vec_push(names, 10); vec_push(names, 30); vec_push(names, 20);
    let uniq: Vec<i32> = uniq_old_names(names);
    if vec_len(uniq) != 3 { return 1; }
    if vec_get(uniq, 0) != 10 { return 2; }
    if vec_get(uniq, 1) != 20 { return 3; }
    if vec_get(uniq, 2) != 30 { return 4; }
    let empty: Vec<i32> = vec_new();
    let uniq2: Vec<i32> = uniq_old_names(empty);
    if vec_len(uniq2) != 0 { return 5; }
    if old_name_seen(uniq, 10) != true { return 6; }
    if old_name_seen(uniq, 99) != false { return 7; }
    return 0;
}

fn test_fresh_tmp_str() -> i32 {
    if string_eq(fresh_tmp_str(0), "_sv0t0") != true { return 1; }
    if string_eq(fresh_tmp_str(1), "_sv0t1") != true { return 2; }
    if string_eq(fresh_tmp_str(42), "_sv0t42") != true { return 3; }
    if string_eq(fresh_tmp_str(100), "_sv0t100") != true { return 4; }
    return 0;
}

