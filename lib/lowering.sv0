    if build_struct_order(tags, nms, fcs, sff, on, oo, oc, of1) != 1 { return 4; }
    if vec_get(oc, 0) != 2 { return 5; }
    let evn: Vec<i32> = vec_new();
    vec_push(evn, 10); vec_push(evn, 20);
    let en2: Vec<i32> = vec_new();
    let eto: Vec<i32> = vec_new();
    let etc: Vec<i32> = vec_new();
    let etf: Vec<i32> = vec_new();
    let emp: Vec<i32> = vec_new();
    if build_enum_variants_data(tags, nms, fcs, vmx, evn, en2, eto, etc, etf, emp) != 1 { return 6; }
    if vec_get(emp, 0) != 1 { return 7; }
    return 0;
}

