fn test_typedef_builders() -> i32 {
    let src: string = "P x i32 y bool E";
    let st: Vec<i32> = vec_new();
    let nd: Vec<i32> = vec_new();
    vec_push(st, 0); vec_push(nd, 1);
    vec_push(st, 2); vec_push(nd, 3);
    vec_push(st, 4); vec_push(nd, 7);
    vec_push(st, 8); vec_push(nd, 9);
    vec_push(st, 10); vec_push(nd, 14);
    vec_push(st, 15); vec_push(nd, 16);
    if string_eq(handle_to_str(0, src, st, nd), "P") != true { return 1; }
    let sn: Vec<i32> = vec_new();
    let en: Vec<i32> = vec_new();
    let fv: Vec<i32> = vec_new();
    let tv: Vec<i32> = vec_new();
    vec_push(fv, 1); vec_push(fv, 3);
    vec_push(tv, 2); vec_push(tv, 4);
    let td: string = emit_struct_td(0, fv, tv, 0, 2, src, st, nd, sn, en);
    if string_eq(td, "typedef struct {\n  int x;\n  int y;\n} P;\n") != true { return 2; }
    let td2: string = emit_enum_td(5, 1, src, st, nd);
    if string_eq(td2, "typedef struct {\n  int tag;\n  int p0;\n} E;\n") != true { return 3; }
    let tags: Vec<i32> = vec_new();
    let nms: Vec<i32> = vec_new();
    let fcs: Vec<i32> = vec_new();
    let vmx: Vec<i32> = vec_new();
    vec_push(tags, 1); vec_push(nms, 0); vec_push(fcs, 2); vec_push(vmx, 0);
    vec_push(tags, 2); vec_push(nms, 5); vec_push(fcs, 2); vec_push(vmx, 1);
    let sff: Vec<i32> = vec_new();
    vec_push(sff, 1); vec_push(sff, 3);
    let on: Vec<i32> = vec_new();
    let oo: Vec<i32> = vec_new();
    let oc: Vec<i32> = vec_new();
    let of1: Vec<i32> = vec_new();
    if build_struct_order(tags, nms, fcs, sff, on, oo, oc, of1) != 1 { return 4; }
    if vec_get(oc, 0) != 2 { return 5; }
    let evn: Vec<i32> = vec_new();
    vec_push(evn, 10); vec_push(evn, 20);
    let en2: Vec<i32> = vec_new();
    let eto: Vec<i32> = vec_new();
    let etc: Vec<i32> = vec_new();
    let etf: Vec<i32> = vec_new();
    let emp: Vec<i32> = vec_new();
    if build_enum_variants_data(tags, nms, fcs, vmx, evn, en2, eto, etc, etf, emp) != 1 { return 6; }
    if vec_get(emp, 0) != 1 { return 7; }
    return 0;
}

fn main() -> i32 {
    let r1: i32 = test_fresh_tmp();
    if r1 != 0 { return r1; }
    let r2: i32 = test_split_qname();
    if r2 != 0 { return 10 + r2; }
    let r3: i32 = test_binop_to_c();
    if r3 != 0 { return 30 + r3; }
    let r4: i32 = test_unop_to_c();
    if r4 != 0 { return 50 + r4; }
    let r5: i32 = test_ty_to_c();
    if r5 != 0 { return 60 + r5; }
    let r6: i32 = test_old_slot();
    if r6 != 0 { return 80 + r6; }
    let r7: i32 = test_ret_syntax();
    if r7 != 0 { return 90 + r7; }
    let r8: i32 = test_store_value_class();
    if r8 != 0 { return 100 + r8; }
    let r9: i32 = test_assign_lhs();
    if r9 != 0 { return 110 + r9; }
    let r10: i32 = test_enum_tag();
    if r10 != 0 { return 120 + r10; }
    let r11: i32 = test_struct_fields();
    if r11 != 0 { return 130 + r11; }
    let r12: i32 = test_type_detection();
    if r12 != 0 { return 140 + r12; }
    let r13: i32 = test_variant_slots();
    if r13 != 0 { return 150 + r13; }
    let r14: i32 = test_try_variants();
    if r14 != 0 { return 160 + r14; }
    let r15: i32 = test_literals();
    if r15 != 0 { return 170 + r15; }
    let r16: i32 = test_value_to_expr();
    if r16 != 0 { return 180 + r16; }
    let r17: i32 = test_enum_alloc();
    if r17 != 0 { return 190 + r17; }
    let r18: i32 = test_ret_value_slot();
    if r18 != 0 { return 200 + r18; }
    let r19: i32 = test_use_ret_slot();
    if r19 != 0 { return 210 + r19; }
    let r20: i32 = test_lit_supported();
    if r20 != 0 { return 220 + r20; }
    let r21: i32 = test_param_name_tag();
    if r21 != 0 { return 230 + r21; }
