/* Phase 2 real pipeline module: sml/backend/vm/bytecode.sml -> sv0.
   Bytecode wire format: magic/version constants, all 50 wire opcode
   constants (matching encodeInsn/decodeInsnVec), per-opcode encoding
   sizes, opcode classification (simple/u32-arg/i32-arg/multi-arg),
   little-endian byte extraction helpers (division-based for u16/u32/
   i32 without bitwise ops), Vec-based LE encoding (encode_u16_le,
   encode_u32_le, encode_i32_le push bytes into Vec<i32>),
   file header encoding (encode_header), .sv0b file layout constants
   (6-byte header, 20-byte func entry, string pool overhead),
   encode_strings / decode_strings (SML encodeStrings/decodeStrings —
   string pool byte codec using string_char_at for ASCII byte loops),
   encode_insn_at / decode_insn_at (SML encodeInsn/decodeInsnVec —
   instruction-level byte encoding/decoding between flat insn Vec
   and byte buffer), encode_all_insns / decode_all_insns (SML
   encodeAll/decodeAll — full instruction stream encode/decode),
   encode_file / decode_file (SML encodeFile/decodeFile — complete
   .sv0b file-level serialization with header, string section,
   function table section, and code section). */

/* ── magic and version ──────────────────────────────────────── */

fn magic_byte_0() -> i32 { return 83; }
fn magic_byte_1() -> i32 { return 86; }
fn magic_byte_2() -> i32 { return 48; }
fn magic_byte_3() -> i32 { return 66; }
fn format_version() -> i32 { return 1; }

/* ── wire opcode constants (from encodeInsn) ────────────────── */

fn OP_HALT() -> i32 { return 0; }
fn OP_POP() -> i32 { return 1; }
fn OP_DUP() -> i32 { return 2; }
fn OP_PUSH_UNIT() -> i32 { return 3; }
fn OP_PUSH_I32() -> i32 { return 4; }
fn OP_PUSH_I64() -> i32 { return 5; }
fn OP_PUSH_F64() -> i32 { return 6; }
fn OP_PUSH_BOOL() -> i32 { return 7; }
fn OP_PUSH_STRING() -> i32 { return 8; }

fn OP_ADD_I32() -> i32 { return 16; }
fn OP_SUB_I32() -> i32 { return 17; }
fn OP_MUL_I32() -> i32 { return 18; }
fn OP_DIV_I32() -> i32 { return 19; }
fn OP_MOD_I32() -> i32 { return 20; }
fn OP_NEG_I32() -> i32 { return 21; }

fn OP_ADD_I64() -> i32 { return 32; }
fn OP_SUB_I64() -> i32 { return 33; }
fn OP_MUL_I64() -> i32 { return 34; }
fn OP_DIV_I64() -> i32 { return 35; }
fn OP_MOD_I64() -> i32 { return 36; }
fn OP_NEG_I64() -> i32 { return 37; }
/* SS-U14: unsigned wide div/rem (2^64-1 must not read as Int64 -1). */
fn OP_DIV_U64() -> i32 { return 38; }
fn OP_MOD_U64() -> i32 { return 39; }
/* SS-U14 residual #1: wide (64-bit) shifts. The polymorphic OP_SHL/OP_SHR
   (92/93) truncate to 32 bits on the VM; i64/u64 operands need the full
   width. SHL is bit-identical for signed/unsigned; SHR splits — I64 is
   arithmetic (sign-extending), U64 is logical. */
fn OP_SHL_I64() -> i32 { return 40; }
fn OP_SHR_I64() -> i32 { return 41; }
fn OP_SHR_U64() -> i32 { return 42; }

fn OP_ADD_F64() -> i32 { return 48; }
fn OP_SUB_F64() -> i32 { return 49; }
fn OP_MUL_F64() -> i32 { return 50; }
fn OP_DIV_F64() -> i32 { return 51; }
fn OP_NEG_F64() -> i32 { return 52; }

fn OP_EQ() -> i32 { return 64; }
fn OP_NEQ() -> i32 { return 65; }
fn OP_LT() -> i32 { return 66; }
fn OP_GT() -> i32 { return 67; }
fn OP_LTE() -> i32 { return 68; }
fn OP_GTE() -> i32 { return 69; }
/* SS-U14: unsigned ordered comparisons for u64 / usize. */
fn OP_LT_U64() -> i32 { return 70; }
fn OP_GT_U64() -> i32 { return 71; }
fn OP_LTE_U64() -> i32 { return 72; }
fn OP_GTE_U64() -> i32 { return 73; }

fn OP_AND() -> i32 { return 80; }
fn OP_OR() -> i32 { return 81; }
fn OP_NOT() -> i32 { return 82; }

fn OP_BIT_AND() -> i32 { return 88; }
fn OP_BIT_OR() -> i32 { return 89; }
fn OP_BIT_XOR() -> i32 { return 90; }
fn OP_BIT_NOT() -> i32 { return 91; }
fn OP_SHL() -> i32 { return 92; }
fn OP_SHR() -> i32 { return 93; }

fn OP_LOAD_LOCAL() -> i32 { return 96; }
fn OP_STORE_LOCAL() -> i32 { return 97; }

fn OP_JUMP() -> i32 { return 112; }
fn OP_JUMP_IF() -> i32 { return 113; }
fn OP_JUMP_IF_NOT() -> i32 { return 114; }
fn OP_CALL() -> i32 { return 115; }
fn OP_RETURN() -> i32 { return 116; }
fn OP_CALL_BUILTIN() -> i32 { return 117; }
fn OP_RETURN_SLOTS() -> i32 { return 118; }

fn OP_ALLOC_STRUCT() -> i32 { return 128; }
fn OP_GET_FIELD() -> i32 { return 129; }
fn OP_SET_FIELD() -> i32 { return 130; }
fn OP_ALLOC_ARRAY() -> i32 { return 131; }
fn OP_GET_INDEX() -> i32 { return 132; }
fn OP_SET_INDEX() -> i32 { return 133; }

fn OP_CONSTRUCT_VARIANT() -> i32 { return 144; }
fn OP_GET_TAG() -> i32 { return 145; }
fn OP_GET_VARIANT_FIELD() -> i32 { return 146; }

fn OP_CONTRACT_CHECK() -> i32 { return 160; }
fn OP_CAST() -> i32 { return 161; }

/* ── encoding size per opcode ───────────────────────────────── */

/* Returns total encoded byte count for a given opcode. */
fn insn_encoded_size(opc: i32) -> i32 {
    if opc == 0 { return 1; }
    if opc == 1 { return 1; }
    if opc == 2 { return 1; }
    if opc == 3 { return 1; }
    if opc == 4 { return 5; }
    if opc == 5 { return 9; }
    if opc == 6 { return 9; }
    if opc == 7 { return 2; }
    if opc == 8 { return 5; }
    if opc >= 16 {
        if opc <= 21 { return 1; }
    }
    if opc >= 32 {
        if opc <= 42 { return 1; }
    }
    if opc >= 48 {
        if opc <= 52 { return 1; }
    }
    if opc >= 64 {
        if opc <= 73 { return 1; }
    }
    if opc >= 80 {
        if opc <= 82 { return 1; }
    }
    if opc >= 88 {
        if opc <= 93 { return 1; }
    }
    if opc == 96 { return 5; }
    if opc == 97 { return 5; }
    if opc == 112 { return 5; }
    if opc == 113 { return 5; }
    if opc == 114 { return 5; }
    if opc == 115 { return 9; }
    if opc == 116 { return 1; }
    if opc == 117 { return 5; }
    if opc == 118 { return 2; }
    if opc == 128 { return 5; }
    if opc == 129 { return 5; }
    if opc == 130 { return 5; }
    if opc == 131 { return 5; }
    if opc == 132 { return 1; }
    if opc == 133 { return 1; }
    if opc == 144 { return 13; }
    if opc == 145 { return 1; }
    if opc == 146 { return 5; }
    if opc == 160 { return 5; }
    if opc == 161 { return 5; }
    return 0;
}

/* ── opcode classification ──────────────────────────────────── */

fn is_simple_opcode(opc: i32) -> bool {
    return insn_encoded_size(opc) == 1;
}

fn opcode_has_i32_payload(opc: i32) -> bool {
    if opc == 4 { return true; }
    if opc == 112 { return true; }
    if opc == 113 { return true; }
    if opc == 114 { return true; }
    return false;
}

fn opcode_has_u32_payload(opc: i32) -> bool {
    if opc == 8 { return true; }
    if opc == 96 { return true; }
    if opc == 97 { return true; }
    if opc == 117 { return true; }
    if opc == 128 { return true; }
    if opc == 129 { return true; }
    if opc == 130 { return true; }
    if opc == 131 { return true; }
    if opc == 146 { return true; }
    if opc == 160 { return true; }
    return false;
}

fn is_arithmetic_opcode(opc: i32) -> bool {
    if opc >= 16 {
        if opc <= 21 { return true; }
    }
    if opc >= 32 {
        if opc <= 42 { return true; }
    }
    if opc >= 48 {
        if opc <= 52 { return true; }
    }
    return false;
}

fn is_compare_opcode(opc: i32) -> bool {
    if opc >= 64 {
        if opc <= 73 { return true; }
    }
    return false;
}

fn is_logic_opcode(opc: i32) -> bool {
    if opc >= 80 {
        if opc <= 82 { return true; }
    }
    return false;
}

fn is_bitwise_opcode(opc: i32) -> bool {
    if opc >= 88 {
        if opc <= 93 { return true; }
    }
    return false;
}

fn is_control_flow_opcode(opc: i32) -> bool {
    if opc >= 112 {
        if opc <= 118 { return true; }
    }
    return false;
}

fn is_struct_opcode(opc: i32) -> bool {
    if opc >= 128 {
        if opc <= 133 { return true; }
    }
    return false;
}

fn is_variant_opcode(opc: i32) -> bool {
    if opc >= 144 {
        if opc <= 146 { return true; }
    }
    return false;
}

/* ── little-endian byte extraction (division-based) ─────────── */

/* Extract little-endian bytes from the two's-complement i32 representation via
   bitwise ops. The old division form tried to fix negatives by adding 2^32, but
   256*256*256*256 overflows i32 to 0 (a no-op) and truncating division of a
   negative yields 0 for the high bytes — so a backward loop-jump offset like -37
   encoded as `db 00 00 00` instead of `db ff ff ff`. `>>` is an arithmetic shift
   on the i32 runtime (sign-extending), and `& 255` masks one byte, so this is
   correct for negatives and byte-identical to the old form for non-negatives. */
fn le_byte0(val: i32) -> i32 {
    return val & 255;
}

fn le_byte1(val: i32) -> i32 {
    return (val >> 8) & 255;
}

fn le_byte2(val: i32) -> i32 {
    return (val >> 16) & 255;
}

fn le_byte3(val: i32) -> i32 {
    return (val >> 24) & 255;
}

fn from_le_u16(b0: i32, b1: i32) -> i32 {
    return b0 + b1 * 256;
}

fn from_le_u32(b0: i32, b1: i32, b2: i32, b3: i32) -> i32 {
    return b0 + b1 * 256 + b2 * 256 * 256 + b3 * 256 * 256 * 256;
}

/* ── Vec-based LE encoding ─────────────────────────────────── */

fn encode_u16_le(val: i32, out: Vec<i32>) -> i32 {
    vec_push(out, le_byte0(val));
    vec_push(out, le_byte1(val));
    return 2;
}

fn encode_u32_le(val: i32, out: Vec<i32>) -> i32 {
    vec_push(out, le_byte0(val));
    vec_push(out, le_byte1(val));
    vec_push(out, le_byte2(val));
    vec_push(out, le_byte3(val));
    return 4;
}

fn encode_i32_le(val: i32, out: Vec<i32>) -> i32 {
    vec_push(out, le_byte0(val));
    vec_push(out, le_byte1(val));
    vec_push(out, le_byte2(val));
    vec_push(out, le_byte3(val));
    return 4;
}

fn encode_header(version: i32, out: Vec<i32>) -> i32 {
    vec_push(out, magic_byte_0());
    vec_push(out, magic_byte_1());
    vec_push(out, magic_byte_2());
    vec_push(out, magic_byte_3());
    encode_u16_le(version, out);
    return 6;
}

fn decode_u16_at(buf: Vec<i32>, pos: i32) -> i32 {
    let b0: i32 = vec_get(buf, pos);
    let b1: i32 = vec_get(buf, pos + 1);
    return from_le_u16(b0, b1);
}

fn decode_u32_at(buf: Vec<i32>, pos: i32) -> i32 {
    let b0: i32 = vec_get(buf, pos);
    let b1: i32 = vec_get(buf, pos + 1);
    let b2: i32 = vec_get(buf, pos + 2);
    let b3: i32 = vec_get(buf, pos + 3);
    return from_le_u32(b0, b1, b2, b3);
}

fn verify_magic(buf: Vec<i32>) -> bool {
    if vec_len(buf) < 6 { return false; }
    if vec_get(buf, 0) != magic_byte_0() { return false; }
    if vec_get(buf, 1) != magic_byte_1() { return false; }
    if vec_get(buf, 2) != magic_byte_2() { return false; }
    if vec_get(buf, 3) != magic_byte_3() { return false; }
    return true;
}

/* ── .sv0b file layout constants ────────────────────────────── */

fn file_header_size() -> i32 { return 6; }
fn func_entry_size() -> i32 { return 20; }
fn string_entry_overhead() -> i32 { return 4; }

fn file_header_magic_len() -> i32 { return 4; }
fn file_header_version_len() -> i32 { return 2; }

fn string_section_size(count: i32, total_bytes: i32) -> i32 {
    return 4 + count * 4 + total_bytes;
}

fn func_table_size(count: i32) -> i32 {
    return 4 + count * 20;
}

/* ── string pool encode/decode (SML encodeStrings/decodeStrings)
   String pool wire format: u32 count, then for each string:
   u32 byte_length followed by byte_length raw bytes (ASCII).
   sv0 strings are ASCII; each char is one byte via string_char_at. */

/* Decode a pool entry's source span [s, e) to its raw bytes. A string-LITERAL
   token span still carries its surrounding double quotes and unresolved escapes
   (`"a\nb"`), but SML's VString holds the already-parsed VALUE, so the .sv0b must
   store the decoded bytes: strip the quotes and interpret escapes (mirroring the
   lexer's escape_char / scan_escape). Non-literal pool entries — function names,
   contract keys — never start with `"`, so they are copied verbatim. Returns the
   number of bytes pushed to `out` (escapes collapse, so this ≠ e - s). */
fn bc_string_escape_char(c: i32) -> i32 {
    if c == 110 { return 10; }
    if c == 116 { return 9; }
    if c == 114 { return 13; }
    if c == 92 { return 92; }
    if c == 34 { return 34; }
    if c == 39 { return 39; }
    if c == 48 { return 0; }
    return c;
}

fn bc_hex_digit_value(c: i32) -> i32 {
    if c >= 48 {
        if c <= 57 { return c - 48; }
    }
    if c >= 65 {
        if c <= 70 { return c - 55; }
    }
    if c >= 97 {
        if c <= 102 { return c - 87; }
    }
    return 0;
}

/* Decode one escape sequence: `pos` is just past the backslash, `end` bounds the
   literal body. Pushes the decoded byte to `out` and returns the position after
   the sequence (mirrors the lexer's scan_escape). Kept separate so decode_pool_
   string's loop body ends in a plain statement, not a value-position if. */
fn decode_one_escape(source: string, pos: i32, end: i32, out: Vec<i32>) -> i32 {
    if pos >= end {
        vec_push(out, 92);
        return pos;
    }
    let nc: i32 = string_char_at(source, pos);
    if nc == 120 {
        let mut d1: i32 = 48;
        let mut d2: i32 = 48;
        if pos + 1 < end { d1 = string_char_at(source, pos + 1); }
        if pos + 2 < end { d2 = string_char_at(source, pos + 2); }
        vec_push(out, bc_hex_digit_value(d1) * 16 + bc_hex_digit_value(d2));
        return pos + 3;
    }
    vec_push(out, bc_string_escape_char(nc));
    return pos + 1;
}

fn decode_pool_string(source: string, s: i32, e: i32, out: Vec<i32>) -> i32 {
    if e <= s { return 0; }
    if string_char_at(source, s) != 34 {
        let mut j: i32 = s;
        while j < e {
            vec_push(out, string_char_at(source, j));
            j = j + 1;
        }
        return e - s;
    }
    let inner_end: i32 = e - 1;
    let mut pos: i32 = s + 1;
    let mut n: i32 = 0;
    while pos < inner_end {
        let c: i32 = string_char_at(source, pos);
        if c == 92 {
            pos = decode_one_escape(source, pos + 1, inner_end, out);
        } else {
            vec_push(out, c);
            pos = pos + 1;
        }
        n = n + 1;
    }
    return n;
}

fn bc_push_ascii(s: string, out: Vec<i32>) -> i32 {
    let n: i32 = string_len(s);
    let mut i: i32 = 0;
    while i < n {
        vec_push(out, string_char_at(s, i));
        i = i + 1;
    }
    return n;
}

/* Decode a negative contract-message sentinel from vm_codegen.contract_pool_key
   ( key = -(kind*1000000 + fn_h + 1) ) into "requires failed: <fn>" /
   "ensures failed: <fn>" bytes in `sbuf`, mirroring the SML VM emitter's
   `poolAdd pool ("requires failed: " ^ fnName)`. Returns the byte length. */
fn decode_contract_key(idx: i32, source: string, starts: Vec<i32>,
                       ends: Vec<i32>, sbuf: Vec<i32>) -> i32 {
    let neg: i32 = 0 - idx - 1;
    let kind: i32 = neg / 1000000;
    let fn_h: i32 = neg - kind * 1000000;
    let mut plen: i32 = 0;
    if kind == 0 {
        plen = bc_push_ascii("requires failed: ", sbuf);
    } else {
        plen = bc_push_ascii("ensures failed: ", sbuf);
    }
    let mut nlen: i32 = 0;
    if fn_h >= 0 {
        if fn_h < vec_len(starts) {
            let fs: i32 = vec_get(starts, fn_h);
            let fe: i32 = vec_get(ends, fn_h);
            let mut k: i32 = fs;
            while k < fe {
                vec_push(sbuf, string_char_at(source, k));
                k = k + 1;
            }
            nlen = fe - fs;
        }
    }
    return plen + nlen;
}

fn encode_strings(strings: Vec<i32>, source: string, starts: Vec<i32>,
                  ends: Vec<i32>, out: Vec<i32>) -> i32 {
    let count: i32 = vec_len(strings);
    encode_u32_le(count, out);
    let mut total: i32 = 4;
    let mut i: i32 = 0;
    while i < count {
        let idx: i32 = vec_get(strings, i);
        let sbuf: Vec<i32> = vec_new();
        let mut slen: i32 = 0;
        if idx < 0 {
            slen = decode_contract_key(idx, source, starts, ends, sbuf);
        } else {
            let s: i32 = vec_get(starts, idx);
            let e: i32 = vec_get(ends, idx);
            slen = decode_pool_string(source, s, e, sbuf);
        }
        encode_u32_le(slen, out);
        total = total + 4;
        let mut j: i32 = 0;
        while j < slen {
            vec_push(out, vec_get(sbuf, j));
            j = j + 1;
        }
        total = total + slen;
        i = i + 1;
    }
    return total;
}

fn encode_string_literals(strs: Vec<i32>, out: Vec<i32>) -> i32 {
    let count: i32 = vec_len(strs);
    encode_u32_le(count, out);
    let mut total: i32 = 4;
    let mut i: i32 = 0;
    while i < count {
        let handle: i32 = vec_get(strs, i);
        encode_u32_le(handle, out);
        total = total + 4;
        i = i + 1;
    }
    return total;
}

fn decode_strings(buf: Vec<i32>, pos: i32,
                  out_starts: Vec<i32>, out_lens: Vec<i32>) -> i32 {
    let count: i32 = decode_u32_at(buf, pos);
    let mut p: i32 = pos + 4;
    let mut i: i32 = 0;
    while i < count {
        let slen: i32 = decode_u32_at(buf, p);
        p = p + 4;
        vec_push(out_starts, p);
        vec_push(out_lens, slen);
        p = p + slen;
        i = i + 1;
    }
    return p;
}

/* ── encode_insn_at (SML encodeInsn) ──────────────────────────
   Reads one instruction from flat insn Vec (instrs) starting at idx.
   Instruction layout: slot 0 = opcode, slots 1+ = payload i32 values.
   Writes encoded bytes to out Vec<i32>.
   Returns next index in instrs (idx + stride). */
fn encode_insn_at(instrs: Vec<i32>, idx: i32, out: Vec<i32>) -> i32 {
    let opc: i32 = vec_get(instrs, idx);
    vec_push(out, opc);

    if opc == 0 { return idx + 1; }
    if opc == 1 { return idx + 1; }
    if opc == 2 { return idx + 1; }
    if opc == 3 { return idx + 1; }

    if opc == 4 {
        encode_i32_le(vec_get(instrs, idx + 1), out);
        return idx + 2;
    }
    if opc == 5 {
        encode_i32_le(vec_get(instrs, idx + 1), out);
        encode_i32_le(vec_get(instrs, idx + 2), out);
        return idx + 3;
    }
    if opc == 6 {
        encode_i32_le(vec_get(instrs, idx + 1), out);
        encode_i32_le(vec_get(instrs, idx + 2), out);
        return idx + 3;
    }
    if opc == 7 {
        let bval: i32 = vec_get(instrs, idx + 1);
        if bval != 0 { vec_push(out, 1); }
        if bval == 0 { vec_push(out, 0); }
        return idx + 2;
    }
    if opc == 8 {
        encode_u32_le(vec_get(instrs, idx + 1), out);
        return idx + 2;
    }

    if opc >= 16 {
        if opc <= 21 { return idx + 1; }
    }
    if opc >= 32 {
        if opc <= 42 { return idx + 1; }
    }
    if opc >= 48 {
        if opc <= 52 { return idx + 1; }
    }
    if opc >= 64 {
        if opc <= 73 { return idx + 1; }
    }
    if opc >= 80 {
        if opc <= 82 { return idx + 1; }
    }
    if opc >= 88 {
        if opc <= 93 { return idx + 1; }
    }

    if opc == 96 {
        encode_u32_le(vec_get(instrs, idx + 1), out);
        return idx + 2;
    }
    if opc == 97 {
        encode_u32_le(vec_get(instrs, idx + 1), out);
        return idx + 2;
    }

    if opc == 112 {
        encode_i32_le(vec_get(instrs, idx + 1), out);
        return idx + 2;
    }
    if opc == 113 {
        encode_i32_le(vec_get(instrs, idx + 1), out);
        return idx + 2;
    }
    if opc == 114 {
        encode_i32_le(vec_get(instrs, idx + 1), out);
        return idx + 2;
    }
    if opc == 115 {
        encode_u32_le(vec_get(instrs, idx + 1), out);
        encode_u32_le(vec_get(instrs, idx + 2), out);
        return idx + 3;
    }
    if opc == 116 { return idx + 1; }
    if opc == 117 {
        encode_u32_le(vec_get(instrs, idx + 1), out);
        return idx + 2;
    }
    if opc == 118 {
        let cnt: i32 = vec_get(instrs, idx + 1);
        vec_push(out, cnt);
        return idx + 2;
    }

    if opc == 128 {
        encode_u32_le(vec_get(instrs, idx + 1), out);
        return idx + 2;
    }
    if opc == 129 {
        encode_u32_le(vec_get(instrs, idx + 1), out);
        return idx + 2;
    }
    if opc == 130 {
        encode_u32_le(vec_get(instrs, idx + 1), out);
        return idx + 2;
    }
    if opc == 131 {
        encode_u32_le(vec_get(instrs, idx + 1), out);
        return idx + 2;
    }
    if opc == 132 { return idx + 1; }
    if opc == 133 { return idx + 1; }

    if opc == 144 {
        encode_u32_le(vec_get(instrs, idx + 1), out);
        encode_u32_le(vec_get(instrs, idx + 2), out);
        encode_u32_le(vec_get(instrs, idx + 3), out);
        return idx + 4;
    }
    if opc == 145 { return idx + 1; }
    if opc == 146 {
        encode_u32_le(vec_get(instrs, idx + 1), out);
        return idx + 2;
    }

    if opc == 160 {
        encode_u32_le(vec_get(instrs, idx + 1), out);
        return idx + 2;
    }
    if opc == 161 {
        encode_u16_le(vec_get(instrs, idx + 1), out);
        encode_u16_le(vec_get(instrs, idx + 2), out);
        return idx + 3;
    }

    return idx + 1;
}

/* ── decode_insn_at (SML decodeInsnVec) ──────────────────────
   Reads one instruction from byte buffer (buf) starting at pos.
   Appends opcode + payload slots to out Vec<i32>.
   Returns the next byte position in buf. */
fn decode_insn_at(buf: Vec<i32>, pos: i32, out: Vec<i32>) -> i32 {
    let opc: i32 = vec_get(buf, pos);
    vec_push(out, opc);

    if opc == 0 { return pos + 1; }
    if opc == 1 { return pos + 1; }
    if opc == 2 { return pos + 1; }
    if opc == 3 { return pos + 1; }

    if opc == 4 {
        let v: i32 = decode_u32_at(buf, pos + 1);
        vec_push(out, v);
        return pos + 5;
    }
    if opc == 5 {
        let lo: i32 = decode_u32_at(buf, pos + 1);
        let hi: i32 = decode_u32_at(buf, pos + 5);
        vec_push(out, lo);
        vec_push(out, hi);
        return pos + 9;
    }
    if opc == 6 {
        let lo: i32 = decode_u32_at(buf, pos + 1);
        let hi: i32 = decode_u32_at(buf, pos + 5);
        vec_push(out, lo);
        vec_push(out, hi);
        return pos + 9;
    }
    if opc == 7 {
        let bval: i32 = vec_get(buf, pos + 1);
        vec_push(out, bval);
        return pos + 2;
    }
    if opc == 8 {
        let v: i32 = decode_u32_at(buf, pos + 1);
        vec_push(out, v);
        return pos + 5;
    }

    if opc >= 16 {
        if opc <= 21 { return pos + 1; }
    }
    if opc >= 32 {
        if opc <= 42 { return pos + 1; }
    }
    if opc >= 48 {
        if opc <= 52 { return pos + 1; }
    }
    if opc >= 64 {
        if opc <= 73 { return pos + 1; }
    }
    if opc >= 80 {
        if opc <= 82 { return pos + 1; }
    }
    if opc >= 88 {
        if opc <= 93 { return pos + 1; }
    }

    if opc == 96 {
        let v: i32 = decode_u32_at(buf, pos + 1);
        vec_push(out, v);
        return pos + 5;
    }
    if opc == 97 {
        let v: i32 = decode_u32_at(buf, pos + 1);
        vec_push(out, v);
        return pos + 5;
    }

    if opc == 112 {
        let v: i32 = decode_u32_at(buf, pos + 1);
        vec_push(out, v);
        return pos + 5;
    }
    if opc == 113 {
        let v: i32 = decode_u32_at(buf, pos + 1);
        vec_push(out, v);
        return pos + 5;
    }
    if opc == 114 {
        let v: i32 = decode_u32_at(buf, pos + 1);
        vec_push(out, v);
        return pos + 5;
    }
    if opc == 115 {
        let f: i32 = decode_u32_at(buf, pos + 1);
        let n: i32 = decode_u32_at(buf, pos + 5);
        vec_push(out, f);
        vec_push(out, n);
        return pos + 9;
    }
    if opc == 116 { return pos + 1; }
    if opc == 117 {
        let v: i32 = decode_u32_at(buf, pos + 1);
        vec_push(out, v);
        return pos + 5;
    }
    if opc == 118 {
        let cnt: i32 = vec_get(buf, pos + 1);
        vec_push(out, cnt);
        return pos + 2;
    }

    if opc == 128 {
        let v: i32 = decode_u32_at(buf, pos + 1);
        vec_push(out, v);
        return pos + 5;
    }
    if opc == 129 {
        let v: i32 = decode_u32_at(buf, pos + 1);
        vec_push(out, v);
        return pos + 5;
    }
    if opc == 130 {
        let v: i32 = decode_u32_at(buf, pos + 1);
        vec_push(out, v);
        return pos + 5;
    }
    if opc == 131 {
        let v: i32 = decode_u32_at(buf, pos + 1);
        vec_push(out, v);
        return pos + 5;
    }
    if opc == 132 { return pos + 1; }
    if opc == 133 { return pos + 1; }

    if opc == 144 {
        let t: i32 = decode_u32_at(buf, pos + 1);
        let vv: i32 = decode_u32_at(buf, pos + 5);
        let fc: i32 = decode_u32_at(buf, pos + 9);
        vec_push(out, t);
        vec_push(out, vv);
        vec_push(out, fc);
        return pos + 13;
    }
    if opc == 145 { return pos + 1; }
    if opc == 146 {
        let v: i32 = decode_u32_at(buf, pos + 1);
        vec_push(out, v);
        return pos + 5;
    }

    if opc == 160 {
        let v: i32 = decode_u32_at(buf, pos + 1);
        vec_push(out, v);
        return pos + 5;
    }
    if opc == 161 {
        let a: i32 = decode_u16_at(buf, pos + 1);
        let b: i32 = decode_u16_at(buf, pos + 3);
        vec_push(out, a);
        vec_push(out, b);
        return pos + 5;
    }

    return pos + 1;
}

/* ── encode_all_insns (SML encodeAll) ────────────────────────
   Encodes every instruction in the flat insn Vec into bytes in out.
   Returns total byte count written. */
fn encode_all_insns(instrs: Vec<i32>, out: Vec<i32>) -> i32 {
    let n: i32 = vec_len(instrs);
    let start_len: i32 = vec_len(out);
    let mut idx: i32 = 0;
    while idx < n {
        idx = encode_insn_at(instrs, idx, out);
    }
    return vec_len(out) - start_len;
}

/* ── decode_all_insns (SML decodeAll) ────────────────────────
   Decodes all instructions from byte buffer buf[0..buf_len) into
   opcode+payload slots appended to out.  Returns total slots written. */
fn decode_all_insns(buf: Vec<i32>, buf_len: i32, out: Vec<i32>) -> i32 {
    let start_len: i32 = vec_len(out);
    let mut pos: i32 = 0;
    while pos < buf_len {
        pos = decode_insn_at(buf, pos, out);
    }
    return vec_len(out) - start_len;
}

/* ── encode_file (SML encodeFile) ─────────────────────────────
   Assembles a complete .sv0b file from a pre-encoded string section
   and a function table.  str_sec/str_sec_len hold the already-encoded
   string pool bytes (produced by encode_strings or encode_string_literals).
   ft_entries is stride-4: [nameIdx, arity, localCount, code_vec_handle]
   repeated for each function.  code_vec_handle is a Vec<i32> of flat
   instruction data (opcode + payload slots).
   Layout: header(6) + str_section + func_section + code_section.
   Returns total byte count. */

fn encode_file(str_sec: Vec<i32>, str_sec_len: i32,
               ft_entries: Vec<i32>, out: Vec<i32>) -> i32 {
    encode_header(1, out);
    let func_count: i32 = vec_len(ft_entries) / 4;
    encode_u32_le(str_sec_len, out);
    let mut si: i32 = 0;
    while si < str_sec_len {
        vec_push(out, vec_get(str_sec, si));
        si = si + 1;
    }
    let code_sizes: Vec<i32> = vec_new();
    let code_bufs: Vec<i32> = vec_new();
    let mut fi: i32 = 0;
    while fi < func_count {
        let code_vec: Vec<i32> = vec_get(ft_entries, fi * 4 + 3);
        let cbuf: Vec<i32> = vec_new();
        let bcount: i32 = encode_all_insns(code_vec, cbuf);
        vec_push(code_sizes, bcount);
        vec_push(code_bufs, cbuf);
        fi = fi + 1;
    }
    let func_sec_data_len: i32 = 4 + func_count * 20;
    encode_u32_le(func_sec_data_len, out);
    encode_u32_le(func_count, out);
    let mut code_offset: i32 = 0;
    fi = 0;
    while fi < func_count {
        encode_u32_le(vec_get(ft_entries, fi * 4 + 0), out);
        encode_u32_le(vec_get(ft_entries, fi * 4 + 1), out);
        encode_u32_le(vec_get(ft_entries, fi * 4 + 2), out);
        encode_u32_le(code_offset, out);
        encode_u32_le(vec_get(code_sizes, fi), out);
        code_offset = code_offset + vec_get(code_sizes, fi);
        fi = fi + 1;
    }
    encode_u32_le(code_offset, out);
    fi = 0;
    while fi < func_count {
        let fb: Vec<i32> = vec_get(code_bufs, fi);
        let flen: i32 = vec_len(fb);
        let mut ci: i32 = 0;
        while ci < flen {
            vec_push(out, vec_get(fb, ci));
            ci = ci + 1;
        }
        fi = fi + 1;
    }
    return vec_len(out);
}

/* ── decode_file (SML decodeFile) ─────────────────────────────
   Parses a .sv0b byte buffer into string offsets/lengths and a
   function table.  out_str_starts/out_str_lens receive byte positions
   and lengths of decoded strings within buf.  out_ft receives
   stride-4 entries [nameIdx, arity, localCount, code_vec_handle]
   where code_vec_handle is a newly allocated Vec<i32> of decoded
   instruction data.  Returns 0 on success, negative on error. */

fn decode_file(buf: Vec<i32>, buf_len: i32,
               out_str_starts: Vec<i32>, out_str_lens: Vec<i32>,
               out_ft: Vec<i32>) -> i32 {
    if verify_magic(buf) == false { return 0 - 1; }
    let ver: i32 = decode_u16_at(buf, 4);
    if ver != 1 { return 0 - 2; }
    let mut pos: i32 = 6;
    let str_sec_len: i32 = decode_u32_at(buf, pos);
    pos = pos + 4;
    let str_end: i32 = pos + str_sec_len;
    decode_strings(buf, pos, out_str_starts, out_str_lens);
    pos = str_end;
    let func_sec_len: i32 = decode_u32_at(buf, pos);
    pos = pos + 4;
    let func_sec_end: i32 = pos + func_sec_len;
    let func_count: i32 = decode_u32_at(buf, pos);
    pos = pos + 4;
    let code_sec_start: i32 = func_sec_end + 4;
    let mut fi: i32 = 0;
    while fi < func_count {
        let nameIdx: i32 = decode_u32_at(buf, pos);
        pos = pos + 4;
        let arity: i32 = decode_u32_at(buf, pos);
        pos = pos + 4;
        let localCount: i32 = decode_u32_at(buf, pos);
        pos = pos + 4;
        let code_off: i32 = decode_u32_at(buf, pos);
        pos = pos + 4;
        let code_len: i32 = decode_u32_at(buf, pos);
        pos = pos + 4;
        let code_buf: Vec<i32> = vec_new();
        let mut ci: i32 = 0;
        while ci < code_len {
            vec_push(code_buf, vec_get(buf, code_sec_start + code_off + ci));
            ci = ci + 1;
        }
        let code_vec: Vec<i32> = vec_new();
        decode_all_insns(code_buf, code_len, code_vec);
        vec_push(out_ft, nameIdx);
        vec_push(out_ft, arity);
        vec_push(out_ft, localCount);
        vec_push(out_ft, code_vec);
        fi = fi + 1;
    }
    return 0;
}

/* ── tests ──────────────────────────────────────────────────── */

fn test_magic() -> i32 {
    if magic_byte_0() != 83 { return 1; }
    if magic_byte_1() != 86 { return 2; }
    if magic_byte_2() != 48 { return 3; }
    if magic_byte_3() != 66 { return 4; }
    if format_version() != 1 { return 5; }
    return 0;
}

fn test_opcodes() -> i32 {
    if OP_HALT() != 0 { return 1; }
    if OP_PUSH_I32() != 4 { return 2; }
    if OP_ADD_I32() != 16 { return 3; }
    if OP_ADD_I64() != 32 { return 4; }
    if OP_ADD_F64() != 48 { return 5; }
    if OP_EQ() != 64 { return 6; }
    if OP_AND() != 80 { return 7; }
    if OP_BIT_AND() != 88 { return 8; }
    if OP_LOAD_LOCAL() != 96 { return 9; }
    if OP_JUMP() != 112 { return 10; }
    if OP_CALL() != 115 { return 11; }
    if OP_RETURN() != 116 { return 12; }
    if OP_ALLOC_STRUCT() != 128 { return 13; }
    if OP_CONSTRUCT_VARIANT() != 144 { return 14; }
    if OP_CONTRACT_CHECK() != 160 { return 15; }
    if OP_CAST() != 161 { return 16; }
    if OP_RETURN_SLOTS() != 118 { return 17; }
    return 0;
}

fn test_insn_sizes() -> i32 {
    if insn_encoded_size(0) != 1 { return 1; }
    if insn_encoded_size(1) != 1 { return 2; }
    if insn_encoded_size(4) != 5 { return 3; }
    if insn_encoded_size(5) != 9 { return 4; }
    if insn_encoded_size(6) != 9 { return 5; }
    if insn_encoded_size(7) != 2 { return 6; }
    if insn_encoded_size(8) != 5 { return 7; }
    if insn_encoded_size(16) != 1 { return 8; }
    if insn_encoded_size(38) != 1 { return 80; }
    if insn_encoded_size(39) != 1 { return 81; }
    if insn_encoded_size(70) != 1 { return 82; }
    if insn_encoded_size(73) != 1 { return 83; }
    if insn_encoded_size(40) != 1 { return 84; }
    if insn_encoded_size(42) != 1 { return 85; }
    if insn_encoded_size(64) != 1 { return 9; }
    if insn_encoded_size(96) != 5 { return 10; }
    if insn_encoded_size(112) != 5 { return 11; }
    if insn_encoded_size(115) != 9 { return 12; }
    if insn_encoded_size(116) != 1 { return 13; }
    if insn_encoded_size(118) != 2 { return 14; }
    if insn_encoded_size(144) != 13 { return 15; }
    if insn_encoded_size(161) != 5 { return 16; }
    return 0;
}

fn test_opcode_classify() -> i32 {
    if is_simple_opcode(0) != true { return 1; }
    if is_simple_opcode(4) != false { return 2; }
    if opcode_has_i32_payload(4) != true { return 3; }
    if opcode_has_i32_payload(112) != true { return 4; }
    if opcode_has_i32_payload(8) != false { return 5; }
    if opcode_has_u32_payload(8) != true { return 6; }
    if opcode_has_u32_payload(96) != true { return 7; }
    if is_arithmetic_opcode(16) != true { return 8; }
    if is_arithmetic_opcode(52) != true { return 9; }
    if is_arithmetic_opcode(64) != false { return 10; }
    if is_arithmetic_opcode(40) != true { return 100; }
    if is_arithmetic_opcode(42) != true { return 101; }
    if is_arithmetic_opcode(43) != false { return 102; }
    if is_compare_opcode(64) != true { return 11; }
    if is_compare_opcode(69) != true { return 12; }
    if is_logic_opcode(80) != true { return 13; }
    if is_bitwise_opcode(88) != true { return 14; }
    if is_bitwise_opcode(93) != true { return 15; }
    if is_control_flow_opcode(112) != true { return 16; }
    if is_control_flow_opcode(118) != true { return 17; }
    if is_struct_opcode(128) != true { return 18; }
    if is_variant_opcode(144) != true { return 19; }
    return 0;
}

fn test_le_bytes() -> i32 {
    if le_byte0(258) != 2 { return 1; }
    if le_byte1(258) != 1 { return 2; }
    if le_byte2(258) != 0 { return 3; }
    if le_byte3(258) != 0 { return 4; }
    if le_byte0(65536) != 0 { return 5; }
    if le_byte2(65536) != 1 { return 6; }
    if from_le_u16(2, 1) != 258 { return 7; }
    if from_le_u32(1, 0, 1, 0) != 65537 { return 8; }
    if from_le_u32(0, 0, 0, 1) != 256 * 256 * 256 { return 9; }
    return 0;
}

fn test_file_layout() -> i32 {
    if file_header_size() != 6 { return 1; }
    if func_entry_size() != 20 { return 2; }
    if string_entry_overhead() != 4 { return 3; }
    if string_section_size(2, 10) != 22 { return 4; }
    if func_table_size(3) != 64 { return 5; }
    return 0;
}

fn test_encode_le() -> i32 {
    let buf: Vec<i32> = vec_new();
    encode_u16_le(258, buf);
    if vec_len(buf) != 2 { return 1; }
    if vec_get(buf, 0) != 2 { return 2; }
    if vec_get(buf, 1) != 1 { return 3; }
    let buf2: Vec<i32> = vec_new();
    encode_u32_le(65537, buf2);
    if vec_len(buf2) != 4 { return 4; }
    if vec_get(buf2, 0) != 1 { return 5; }
    if vec_get(buf2, 1) != 0 { return 6; }
    if vec_get(buf2, 2) != 1 { return 7; }
    if vec_get(buf2, 3) != 0 { return 8; }
    let buf3: Vec<i32> = vec_new();
    encode_i32_le(256, buf3);
    if vec_len(buf3) != 4 { return 9; }
    if vec_get(buf3, 0) != 0 { return 10; }
    if vec_get(buf3, 1) != 1 { return 11; }
    return 0;
}

fn test_encode_header() -> i32 {
    let buf: Vec<i32> = vec_new();
    let sz: i32 = encode_header(1, buf);
    if sz != 6 { return 1; }
    if vec_len(buf) != 6 { return 2; }
    if vec_get(buf, 0) != 83 { return 3; }
    if vec_get(buf, 1) != 86 { return 4; }
    if vec_get(buf, 2) != 48 { return 5; }
    if vec_get(buf, 3) != 66 { return 6; }
    if vec_get(buf, 4) != 1 { return 7; }
    if vec_get(buf, 5) != 0 { return 8; }
    return 0;
}

fn test_decode_at() -> i32 {
    let buf: Vec<i32> = vec_new();
    encode_u32_le(65537, buf);
    let decoded: i32 = decode_u32_at(buf, 0);
    if decoded != 65537 { return 1; }
    let buf2: Vec<i32> = vec_new();
    encode_u16_le(258, buf2);
    let d2: i32 = decode_u16_at(buf2, 0);
    if d2 != 258 { return 2; }
    return 0;
}

fn test_verify_magic() -> i32 {
    let buf: Vec<i32> = vec_new();
    encode_header(1, buf);
    if verify_magic(buf) != true { return 1; }
    let bad: Vec<i32> = vec_new();
    vec_push(bad, 0);
    vec_push(bad, 0);
    vec_push(bad, 0);
    vec_push(bad, 0);
    vec_push(bad, 0);
    vec_push(bad, 0);
    if verify_magic(bad) != false { return 2; }
    let tiny: Vec<i32> = vec_new();
    vec_push(tiny, 83);
    if verify_magic(tiny) != false { return 3; }
    return 0;
}

fn test_encode_decode_strings() -> i32 {
    let source: string = "hello world";
    let strings: Vec<i32> = vec_new();
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 5);
    vec_push(starts, 6); vec_push(ends, 11);
    vec_push(strings, 0);
    vec_push(strings, 1);
    let out: Vec<i32> = vec_new();
    let total: i32 = encode_strings(strings, source, starts, ends, out);
    if total != 4 + 4 + 5 + 4 + 5 { return 1; }
    let d_starts: Vec<i32> = vec_new();
    let d_lens: Vec<i32> = vec_new();
    let end_pos: i32 = decode_strings(out, 0, d_starts, d_lens);
    if end_pos != total { return 2; }
    if vec_len(d_starts) != 2 { return 3; }
    if vec_get(d_lens, 0) != 5 { return 4; }
    if vec_get(d_lens, 1) != 5 { return 5; }
    if vec_get(out, vec_get(d_starts, 0)) != 104 { return 6; }
    if vec_get(out, vec_get(d_starts, 1)) != 119 { return 7; }
    return 0;
}

fn test_encode_string_literals() -> i32 {
    let strs: Vec<i32> = vec_new();
    vec_push(strs, 42);
    vec_push(strs, 99);
    let out: Vec<i32> = vec_new();
    let total: i32 = encode_string_literals(strs, out);
    if total != 12 { return 1; }
    if vec_len(out) != 12 { return 2; }
    let count: i32 = decode_u32_at(out, 0);
    if count != 2 { return 3; }
    let h0: i32 = decode_u32_at(out, 4);
    if h0 != 42 { return 4; }
    let h1: i32 = decode_u32_at(out, 8);
    if h1 != 99 { return 5; }
    return 0;
}

fn test_encode_insn_simple() -> i32 {
    let instrs: Vec<i32> = vec_new();
    vec_push(instrs, 0);
    vec_push(instrs, 1);
    vec_push(instrs, 2);
    vec_push(instrs, 3);
    vec_push(instrs, 116);
    vec_push(instrs, 132);
    vec_push(instrs, 133);
    vec_push(instrs, 145);
    let out: Vec<i32> = vec_new();
    let mut idx: i32 = 0;
    idx = encode_insn_at(instrs, idx, out);
    if idx != 1 { return 1; }
    idx = encode_insn_at(instrs, idx, out);
    idx = encode_insn_at(instrs, idx, out);
    idx = encode_insn_at(instrs, idx, out);
    idx = encode_insn_at(instrs, idx, out);
    idx = encode_insn_at(instrs, idx, out);
    idx = encode_insn_at(instrs, idx, out);
    idx = encode_insn_at(instrs, idx, out);
    if idx != 8 { return 2; }
    if vec_len(out) != 8 { return 3; }
    if vec_get(out, 0) != 0 { return 4; }
    if vec_get(out, 1) != 1 { return 5; }
    if vec_get(out, 4) != 116 { return 6; }
    if vec_get(out, 7) != 145 { return 7; }
    return 0;
}

fn test_encode_insn_payload() -> i32 {
    let instrs: Vec<i32> = vec_new();
    vec_push(instrs, 4);  vec_push(instrs, 42);
    vec_push(instrs, 7);  vec_push(instrs, 1);
    vec_push(instrs, 7);  vec_push(instrs, 0);
    vec_push(instrs, 96); vec_push(instrs, 5);
    vec_push(instrs, 118); vec_push(instrs, 3);
    let out: Vec<i32> = vec_new();
    let mut idx: i32 = 0;
    idx = encode_insn_at(instrs, idx, out);
    if idx != 2 { return 1; }
    if vec_len(out) != 5 { return 2; }
    if vec_get(out, 0) != 4 { return 3; }
    if vec_get(out, 1) != 42 { return 4; }
    if vec_get(out, 2) != 0 { return 5; }
    if vec_get(out, 3) != 0 { return 6; }
    if vec_get(out, 4) != 0 { return 7; }
    idx = encode_insn_at(instrs, idx, out);
    if idx != 4 { return 8; }
    if vec_get(out, 5) != 7 { return 9; }
    if vec_get(out, 6) != 1 { return 10; }
    idx = encode_insn_at(instrs, idx, out);
    if idx != 6 { return 11; }
    if vec_get(out, 7) != 7 { return 12; }
    if vec_get(out, 8) != 0 { return 13; }
    idx = encode_insn_at(instrs, idx, out);
    if idx != 8 { return 14; }
    if vec_len(out) != 14 { return 15; }
    idx = encode_insn_at(instrs, idx, out);
    if idx != 10 { return 16; }
    if vec_get(out, 14) != 118 { return 17; }
    if vec_get(out, 15) != 3 { return 18; }
    return 0;
}

fn test_encode_insn_multi() -> i32 {
    let instrs: Vec<i32> = vec_new();
    vec_push(instrs, 115); vec_push(instrs, 2); vec_push(instrs, 3);
    vec_push(instrs, 144); vec_push(instrs, 10); vec_push(instrs, 20); vec_push(instrs, 30);
    vec_push(instrs, 161); vec_push(instrs, 1); vec_push(instrs, 2);
    let out: Vec<i32> = vec_new();
    let mut idx: i32 = 0;
    idx = encode_insn_at(instrs, idx, out);
    if idx != 3 { return 1; }
    if vec_len(out) != 9 { return 2; }
    if vec_get(out, 0) != 115 { return 3; }
    let d_func: i32 = decode_u32_at(out, 1);
    if d_func != 2 { return 4; }
    let d_arity: i32 = decode_u32_at(out, 5);
    if d_arity != 3 { return 5; }
    idx = encode_insn_at(instrs, idx, out);
    if idx != 7 { return 6; }
    if vec_len(out) != 22 { return 7; }
    if vec_get(out, 9) != 144 { return 8; }
    idx = encode_insn_at(instrs, idx, out);
    if idx != 10 { return 9; }
    if vec_len(out) != 27 { return 10; }
    if vec_get(out, 22) != 161 { return 11; }
    let d_from: i32 = decode_u16_at(out, 23);
    if d_from != 1 { return 12; }
    let d_to: i32 = decode_u16_at(out, 25);
    if d_to != 2 { return 13; }
    return 0;
}

fn test_decode_insn_simple() -> i32 {
    let buf: Vec<i32> = vec_new();
    vec_push(buf, 0);
    vec_push(buf, 1);
    vec_push(buf, 116);
    let out: Vec<i32> = vec_new();
    let mut pos: i32 = 0;
    pos = decode_insn_at(buf, pos, out);
    if pos != 1 { return 1; }
    if vec_get(out, 0) != 0 { return 2; }
    pos = decode_insn_at(buf, pos, out);
    if pos != 2 { return 3; }
    if vec_get(out, 1) != 1 { return 4; }
    pos = decode_insn_at(buf, pos, out);
    if pos != 3 { return 5; }
    if vec_get(out, 2) != 116 { return 6; }
    return 0;
}

fn test_decode_insn_payload() -> i32 {
    let buf: Vec<i32> = vec_new();
    vec_push(buf, 4);
    encode_i32_le(42, buf);
    vec_push(buf, 7); vec_push(buf, 1);
    vec_push(buf, 96);
    encode_u32_le(99, buf);
    let out: Vec<i32> = vec_new();
    let mut pos: i32 = 0;
    pos = decode_insn_at(buf, pos, out);
    if pos != 5 { return 1; }
    if vec_get(out, 0) != 4 { return 2; }
    if vec_get(out, 1) != 42 { return 3; }
    pos = decode_insn_at(buf, pos, out);
    if pos != 7 { return 4; }
    if vec_get(out, 2) != 7 { return 5; }
    if vec_get(out, 3) != 1 { return 6; }
    pos = decode_insn_at(buf, pos, out);
    if pos != 12 { return 7; }
    if vec_get(out, 4) != 96 { return 8; }
    if vec_get(out, 5) != 99 { return 9; }
    return 0;
}

fn test_encode_decode_roundtrip() -> i32 {
    let instrs: Vec<i32> = vec_new();
    vec_push(instrs, 0);
    vec_push(instrs, 4);  vec_push(instrs, 100);
    vec_push(instrs, 7);  vec_push(instrs, 1);
    vec_push(instrs, 115); vec_push(instrs, 5); vec_push(instrs, 2);
    vec_push(instrs, 116);
    vec_push(instrs, 118); vec_push(instrs, 4);
    let bytes: Vec<i32> = vec_new();
    let bcount: i32 = encode_all_insns(instrs, bytes);
    if bcount != 1 + 5 + 2 + 9 + 1 + 2 { return 1; }
    let decoded: Vec<i32> = vec_new();
    let scount: i32 = decode_all_insns(bytes, bcount, decoded);
    if vec_len(decoded) != vec_len(instrs) { return 2; }
    let mut i: i32 = 0;
    while i < vec_len(instrs) {
        if vec_get(instrs, i) != vec_get(decoded, i) { return 3 + i; }
        i = i + 1;
    }
    return 0;
}

fn test_encode_decode_all() -> i32 {
    let instrs: Vec<i32> = vec_new();
    vec_push(instrs, 3);
    vec_push(instrs, 16);
    vec_push(instrs, 64);
    vec_push(instrs, 112); vec_push(instrs, 10);
    vec_push(instrs, 144); vec_push(instrs, 1); vec_push(instrs, 2); vec_push(instrs, 3);
    vec_push(instrs, 161); vec_push(instrs, 4); vec_push(instrs, 8);
    let bytes: Vec<i32> = vec_new();
    let bcount: i32 = encode_all_insns(instrs, bytes);
    if bcount != 1 + 1 + 1 + 5 + 13 + 5 { return 1; }
    let decoded: Vec<i32> = vec_new();
    decode_all_insns(bytes, bcount, decoded);
    if vec_len(decoded) != vec_len(instrs) { return 2; }
    if vec_get(decoded, 0) != 3 { return 3; }
    if vec_get(decoded, 1) != 16 { return 4; }
    if vec_get(decoded, 2) != 64 { return 5; }
    if vec_get(decoded, 3) != 112 { return 6; }
    if vec_get(decoded, 4) != 10 { return 7; }
    if vec_get(decoded, 5) != 144 { return 8; }
    if vec_get(decoded, 6) != 1 { return 9; }
    if vec_get(decoded, 7) != 2 { return 10; }
    if vec_get(decoded, 8) != 3 { return 11; }
    if vec_get(decoded, 9) != 161 { return 12; }
    if vec_get(decoded, 10) != 4 { return 13; }
    if vec_get(decoded, 11) != 8 { return 14; }
    return 0;
}

fn test_encode_file() -> i32 {
    let source: string = "main";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 4);
    let pool: Vec<i32> = vec_new();
    vec_push(pool, 0);
    let str_buf: Vec<i32> = vec_new();
    let str_len: i32 = encode_strings(pool, source, starts, ends, str_buf);
    let code0: Vec<i32> = vec_new();
    vec_push(code0, 0);
    let ft: Vec<i32> = vec_new();
    vec_push(ft, 0); vec_push(ft, 0); vec_push(ft, 1); vec_push(ft, code0);
    let out: Vec<i32> = vec_new();
    let total: i32 = encode_file(str_buf, str_len, ft, out);
    if total <= 0 { return 1; }
    if vec_get(out, 0) != 83 { return 2; }
    if vec_get(out, 1) != 86 { return 3; }
    if vec_get(out, 2) != 48 { return 4; }
    if vec_get(out, 3) != 66 { return 5; }
    return 0;
}

fn test_decode_file_roundtrip() -> i32 {
    let source: string = "main add";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 4);
    vec_push(starts, 5); vec_push(ends, 8);
    let pool: Vec<i32> = vec_new();
    vec_push(pool, 0);
    vec_push(pool, 1);
    let str_buf: Vec<i32> = vec_new();
    let str_len: i32 = encode_strings(pool, source, starts, ends, str_buf);
    let code0: Vec<i32> = vec_new();
    vec_push(code0, 4); vec_push(code0, 42);
    vec_push(code0, 118); vec_push(code0, 1);
    let code1: Vec<i32> = vec_new();
    vec_push(code1, 0);
    let ft: Vec<i32> = vec_new();
    vec_push(ft, 0); vec_push(ft, 0); vec_push(ft, 2); vec_push(ft, code0);
    vec_push(ft, 1); vec_push(ft, 2); vec_push(ft, 0); vec_push(ft, code1);
    let out: Vec<i32> = vec_new();
    let _ef: i32 = encode_file(str_buf, str_len, ft, out);
    let buf_len: i32 = vec_len(out);
    let ds: Vec<i32> = vec_new();
    let dl: Vec<i32> = vec_new();
    let dft: Vec<i32> = vec_new();
    let rc: i32 = decode_file(out, buf_len, ds, dl, dft);
    if rc != 0 { return 1; }
    if vec_len(ds) != 2 { return 2; }
    if vec_get(dl, 0) != 4 { return 3; }
    let s0: i32 = vec_get(ds, 0);
    if vec_get(out, s0) != 109 { return 4; }
    if vec_get(out, s0 + 3) != 110 { return 5; }
    if vec_get(dl, 1) != 3 { return 6; }
    if vec_len(dft) != 8 { return 7; }
    if vec_get(dft, 0) != 0 { return 8; }
    if vec_get(dft, 1) != 0 { return 9; }
    if vec_get(dft, 2) != 2 { return 10; }
    let dc0: Vec<i32> = vec_get(dft, 3);
    if vec_len(dc0) != 4 { return 11; }
    if vec_get(dc0, 0) != 4 { return 12; }
    if vec_get(dc0, 1) != 42 { return 13; }
    if vec_get(dc0, 2) != 118 { return 14; }
    if vec_get(dc0, 3) != 1 { return 15; }
    if vec_get(dft, 4) != 1 { return 16; }
    if vec_get(dft, 5) != 2 { return 17; }
    if vec_get(dft, 6) != 0 { return 18; }
    let dc1: Vec<i32> = vec_get(dft, 7);
    if vec_len(dc1) != 1 { return 19; }
    if vec_get(dc1, 0) != 0 { return 20; }
    return 0;
}

fn test_logical_opcode_cluster() -> i32 {
    if OP_AND() != 80 { return 1; }
    if OP_OR() != 81 { return 2; }
    if OP_NOT() != 82 { return 3; }
    if OP_EQ() != 64 { return 4; }
    return 0;
}

fn main() -> i32 {
    let r1: i32 = test_magic();
    if r1 != 0 { return r1; }
