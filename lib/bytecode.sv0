    if r2b != 0 { return 15 + r2b; }
    let r3: i32 = test_insn_sizes();
    if r3 != 0 { return 30 + r3; }
    let r4: i32 = test_opcode_classify();
    if r4 != 0 { return 50 + r4; }
    let r5: i32 = test_le_bytes();
    if r5 != 0 { return 70 + r5; }
    let r6: i32 = test_file_layout();
    if r6 != 0 { return 80 + r6; }
    let r7: i32 = test_encode_le();
    if r7 != 0 { return 90 + r7; }
    let r8: i32 = test_encode_header();
    if r8 != 0 { return 110 + r8; }
    let r9: i32 = test_decode_at();
    if r9 != 0 { return 120 + r9; }
    let r10: i32 = test_verify_magic();
    if r10 != 0 { return 130 + r10; }
    let r11: i32 = test_encode_decode_strings();
    if r11 != 0 { return 140 + r11; }
    let r12: i32 = test_encode_string_literals();
    if r12 != 0 { return 150 + r12; }
    let r13: i32 = test_encode_insn_simple();
    if r13 != 0 { return 160 + r13; }
    let r14: i32 = test_encode_insn_payload();
    if r14 != 0 { return 170 + r14; }
    let r15: i32 = test_encode_insn_multi();
    if r15 != 0 { return 190 + r15; }
    let r16: i32 = test_decode_insn_simple();
    if r16 != 0 { return 204 + r16; }
    let r17: i32 = test_decode_insn_payload();
    if r17 != 0 { return 212 + r17; }
    let r18: i32 = test_encode_decode_roundtrip();
    if r18 != 0 { return 222 + r18; }
    let r19: i32 = test_encode_decode_all();
    if r19 != 0 { return 236 + r19; }
    let r20: i32 = test_encode_file();
    if r20 != 0 { return 246 + r20; }
    let r21: i32 = test_decode_file_roundtrip();
    if r21 != 0 { return 10 + r21; }
    return 0;
}
