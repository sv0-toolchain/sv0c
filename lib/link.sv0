    write_file(p2, "B");
    let mut listing: string = p1;
    listing = string_concat(listing, "\n");
    listing = string_concat(listing, p2);
    listing = string_concat(listing, "\n");
    let starts: Vec<i32> = vec_new();
    let lens: Vec<i32> = vec_new();
    let out: string = link_project_concat_sources_offsets_from_listing(listing,
        starts, lens);
    if string_eq(out, "A\nB") != true { return 1; }
    if vec_len(starts) != 2 { return 2; }
    if vec_len(lens) != 2 { return 3; }
    if vec_get(starts, 0) != 0 { return 4; }
    if vec_get(starts, 1) != 2 { return 5; }
    if vec_get(lens, 0) != 1 { return 6; }
    if vec_get(lens, 1) != 1 { return 7; }
    return 0;
}

fn test_split_module_name() -> i32 {
    let it: Vec<i32> = vec_new();
    let id1: Vec<i32> = vec_new();
    let pp: Vec<i32> = vec_new();
    vec_push(it, 6);
    vec_push(id1, 0);
    vec_push(pp, 42);
    if split_module_name(it, id1, pp, 99) != 42 { return 1; }
    if split_module_body_start(it) != 1 { return 2; }
    let it2: Vec<i32> = vec_new();
    let id1b: Vec<i32> = vec_new();
    vec_push(it2, 0);
    vec_push(id1b, 10);
    if split_module_name(it2, id1b, pp, 99) != 99 { return 3; }
    if split_module_body_start(it2) != 0 { return 4; }
    let empty: Vec<i32> = vec_new();
    if split_module_name(empty, id1, pp, 77) != 77 { return 5; }
    if split_module_body_start(empty) != 0 { return 6; }
    return 0;
}

fn main() -> i32 {
    let r1: i32 = test_is_sv0();
    if r1 != 0 { return r1; }
    let r2: i32 = test_is_hidden();
    if r2 != 0 { return 10 + r2; }
    let r2b: i32 = test_is_link_source_file();
    if r2b != 0 { return 15 + r2b; }
    let r3: i32 = test_file_stem();
    if r3 != 0 { return 20 + r3; }
    let r4: i32 = test_mangle();
    if r4 != 0 { return 30 + r4; }
    let r5: i32 = test_is_top_defining();
    if r5 != 0 { return 40 + r5; }
    let r6: i32 = test_collect_tops_count();
    if r6 != 0 { return 50 + r6; }
    let r7: i32 = test_is_link_directive();
    if r7 != 0 { return 60 + r7; }
    let r8: i32 = test_strip_directives_count();
    if r8 != 0 { return 70 + r8; }
    let r9: i32 = test_has_module_prefix();
    if r9 != 0 { return 80 + r9; }
    let r10: i32 = test_in_tops();
    if r10 != 0 { return 90 + r10; }
    let r11: i32 = test_path_seg_needs_mangle();
    if r11 != 0 { return 100 + r11; }
    let r12: i32 = test_split_module();
    if r12 != 0 { return 110 + r12; }
    let r13: i32 = test_map_ty_kind();
    if r13 != 0 { return 120 + r13; }
    let r14: i32 = test_item_rewrite();
    if r14 != 0 { return 140 + r14; }
