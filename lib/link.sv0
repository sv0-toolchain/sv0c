    if tag == 6 {
        let ob: i32 = vec_get(ed1, idx);
        return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
            pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, ob, depth + 1);
    }
    if tag == 7 {
        let ob7: i32 = vec_get(ed1, idx);
        return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
            pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, ob7, depth + 1);
    }
    if tag == 8 {
        let o8: i32 = vec_get(ed1, idx);
        let i8: i32 = vec_get(ed2, idx);
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, o8, depth + 1) == true {
            return true;
