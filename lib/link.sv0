    vec_push(pp, 2);
    vec_push(et, 1);
    vec_push(e1, 0);
    vec_push(e2, 1);
    vec_push(e3, 0);
    vec_push(e4, 0);
    vec_push(et, 1);
    vec_push(e1, 1);
    vec_push(e2, 1);
    vec_push(e3, 0);
    vec_push(e4, 0);
    vec_push(et, 10);
    vec_push(e1, 0);
    vec_push(e2, 1);
    vec_push(e3, 0 - 1);
    vec_push(e4, 0);
    let cnt: i32 = link_expr_subtree_node_count(et, e1, e2, e3, e4, 2, 0);
    if cnt != 3 { return 1; }
    let tops: Vec<i32> = vec_new();
    vec_push(tops, 2);
    let tty: Vec<i32> = vec_new();
    let td1: Vec<i32> = vec_new();
    let td2: Vec<i32> = vec_new();
    let td3: Vec<i32> = vec_new();
    if link_expr_root_needs_mangle(et, e1, e2, e3, e4, pp,
            tty, td1, td2, td3, tops, 2, 0) != true {
        return 2;
    }
    return 0;
}

