    if link_listing_nonempty("") != false { return 1; }
    if link_listing_nonempty("\n\n") != false { return 2; }
    if link_listing_nonempty("a.sv0\n") != true { return 3; }
    if LINK_ERR_NO_SV0_IN_DIR() != 321 { return 4; }
    return 0;
}

fn test_link_project_concat_sources_from_listing() -> i32 {
    let p1: string = "/tmp/sv0_link_concat_a.sv0";
    let p2: string = "/tmp/sv0_link_concat_b.sv0";
    write_file(p1, "A");
    write_file(p2, "B");
    let mut listing: string = p1;
    listing = string_concat(listing, "\n");
    listing = string_concat(listing, p2);
    listing = string_concat(listing, "\n");
    let out: string = link_project_concat_sources_from_listing(listing);
    if string_eq(out, "A\nB") != true { return 1; }
    let out2: string = link_project_concat_sources_from_listing("");
    if string_eq(out2, "") != true { return 2; }
    return 0;
}

fn test_listing_count_nonempty_paths() -> i32 {
    if listing_count_nonempty_paths("") != 0 { return 1; }
    if listing_count_nonempty_paths("\n\n") != 0 { return 2; }
    if listing_count_nonempty_paths("a.sv0") != 1 { return 3; }
    if listing_count_nonempty_paths("a.sv0\nb.sv0") != 2 { return 4; }
    if listing_count_nonempty_paths("a.sv0\n\nb.sv0") != 2 { return 5; }
    return 0;
}

