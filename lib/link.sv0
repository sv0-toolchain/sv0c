    if string_eq(s, "probe") != true { return 1; }
    /* walk_sv0 / link_project_dir are read_dir/list_sv0 aliases — do not
       read_dir(".") here: native self-host cwd can be huge and recurse
       until stack overflow (SIGSEGV on CI). */
    return 0;
}

