    let r2: string = map_path_segs_rewrite_1(tops, "mod", 99, "Bar");
    if string_eq(r2, "Bar") != true { return 2; }
    let r3: string = map_path_segs_rewrite_2(tops, "mod", 20, "Baz");
    if string_eq(r3, "mod__Baz") != true { return 3; }
    let r4: string = map_path_segs_rewrite_2(tops, "mod", 99, "Qux");
    if string_eq(r4, "Qux") != true { return 4; }
    return 0;
}

