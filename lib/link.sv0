fn test_strip_link_directives() -> i32 {
    let it: Vec<i32> = vec_new();
    vec_push(it, 0);
    vec_push(it, 5);
    vec_push(it, 1);
    vec_push(it, 6);
    vec_push(it, 2);
    let out: Vec<i32> = vec_new();
    let n: i32 = strip_link_directives(it, out);
    if n != 3 { return 1; }
    if vec_get(out, 0) != 0 { return 2; }
    if vec_get(out, 1) != 2 { return 3; }
    if vec_get(out, 2) != 4 { return 4; }
    let empty_it: Vec<i32> = vec_new();
    let empty_out: Vec<i32> = vec_new();
    if strip_link_directives(empty_it, empty_out) != 0 { return 5; }
    let all_use: Vec<i32> = vec_new();
    vec_push(all_use, 5);
    vec_push(all_use, 6);
    let au_out: Vec<i32> = vec_new();
    if strip_link_directives(all_use, au_out) != 0 { return 6; }
    return 0;
}

fn test_g2_link_host_io_aliases() -> i32 {
    let p: string = "/tmp/sv0_g2_link_parse.sv0";
    write_file(p, "probe");
    let s: string = parse_file(p);
    if string_eq(s, "probe") != true { return 1; }
    /* walk_sv0 / link_project_dir are read_dir/list_sv0 aliases — do not
       read_dir(".") here: native self-host cwd can be huge and recurse
       until stack overflow (SIGSEGV on CI). */
    return 0;
}

