fn test_link_reloc_i32_vec_inplace() -> i32 {
    let v: Vec<i32> = vec_new();
    vec_push(v, 1);
    vec_push(v, 5);
    let nr: i32 = vec_len(v);
    let mut ir: i32 = 0;
    while ir < nr {
        vec_set(v, ir, vec_get(v, ir) + 10);
        ir = ir + 1;
    }
    if vec_get(v, 0) != 11 { return 1; }
    if vec_get(v, 1) != 15 { return 2; }
    return 0;
}

