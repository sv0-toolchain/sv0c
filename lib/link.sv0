        if sb12 <= 0 { return 0 - 1; }
        let mut sum12: i32 = 1 + sc12 + sb12;
        if invf >= 0 {
            let mut lo12: i32 = invf;
            let mut ii12: i32 = 0;
            while ii12 < invc {
                let ir12: i32 = link_expr_find_root_covering_min(expr_tags, ed1,
                    ed2, ed3, ed4, lo12, idx);
                if ir12 < 0 { return 0 - 1; }
                let si12: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                    ed3, ed4, ir12, depth + 1);
                if si12 <= 0 { return 0 - 1; }
                sum12 = sum12 + si12;
                lo12 = ir12 + 1;
                ii12 = ii12 + 1;
            }
        }
        return sum12;
    }
    if tag == 13 {
        let iter13: i32 = vec_get(ed2, idx);
        let body13: i32 = vec_get(ed3, idx);
        let si13: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, iter13, depth + 1);
        if si13 <= 0 { return 0 - 1; }
        let sb13: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, body13, depth + 1);
        if sb13 <= 0 { return 0 - 1; }
        return 1 + si13 + sb13;
    }
    if tag == 14 {
        let bd: i32 = vec_get(ed1, idx);
        let sb: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, bd, depth + 1);
        if sb <= 0 { return 0 - 1; }
        return 1 + sb;
    }
    if tag == 15 {
        let vi: i32 = vec_get(ed1, idx);
        if vi < 0 { return 1; }
        let sv: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, vi, depth + 1);
        if sv <= 0 { return 0 - 1; }
        return 1 + sv;
    }
    if tag == 16 {
        let vb: i32 = vec_get(ed1, idx);
        if vb < 0 { return 1; }
        let sb: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, vb, depth + 1);
        if sb <= 0 { return 0 - 1; }
        return 1 + sb;
    }
    if tag == 17 { return 1; }
    if tag == 27 {
        let init27: i32 = vec_get(ed3, idx);
        if init27 < 0 { return 1; }
        let si27: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, init27, depth + 1);
        if si27 <= 0 { return 0 - 1; }
        return 1 + si27;
    }
    if tag == 28 {
        let se28: i32 = vec_get(ed1, idx);
        let ss28: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
