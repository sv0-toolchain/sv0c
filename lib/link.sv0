        if ss28 <= 0 { return 0 - 1; }
        return 1 + ss28;
    }
    if tag == 29 {
        let gd29: i32 = vec_get(ed3, idx);
        let bd29: i32 = vec_get(ed4, idx);
        let sb29: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, bd29, depth + 1);
        if sb29 <= 0 { return 0 - 1; }
        if gd29 < 0 { return 1 + sb29; }
        let sg29: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, gd29, depth + 1);
        if sg29 <= 0 { return 0 - 1; }
        return 1 + sb29 + sg29;
    }
    if tag == 30 { return 1; }
    if tag == 31 { return 1; }
    if tag == 32 { return 1; }
    if tag == 33 { return 1; }
    if tag == 18 {
        let al: i32 = vec_get(ed1, idx);
        let ar: i32 = vec_get(ed2, idx);
        let sl: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, al, depth + 1);
        if sl <= 0 { return 0 - 1; }
        let sr: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, ar, depth + 1);
        if sr <= 0 { return 0 - 1; }
        return 1 + sl + sr;
    }
    if tag == 19 {
        let al2: i32 = vec_get(ed2, idx);
        let ar2: i32 = vec_get(ed3, idx);
        let sl2: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                     ed4, al2, depth + 1);
        if sl2 <= 0 { return 0 - 1; }
        let sr2: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                     ed4, ar2, depth + 1);
        if sr2 <= 0 { return 0 - 1; }
        return 1 + sl2 + sr2;
    }
    if tag == 20 {
        let cs: i32 = vec_get(ed1, idx);
        let ss: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, cs, depth + 1);
        if ss <= 0 { return 0 - 1; }
        return 1 + ss;
    }
    if tag == 21 {
        let slo: i32 = vec_get(ed1, idx);
        let shi: i32 = vec_get(ed2, idx);
        let mut sum: i32 = 1;
        if slo >= 0 {
            let sl: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, slo, depth + 1);
            if sl <= 0 { return 0 - 1; }
            sum = sum + sl;
        }
        if shi >= 0 {
            let sr: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, shi, depth + 1);
            if sr <= 0 { return 0 - 1; }
            sum = sum + sr;
        }
        return sum;
    }
    if tag == 22 {
        let te: i32 = vec_get(ed1, idx);
        let st: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, te, depth + 1);
        if st <= 0 { return 0 - 1; }
        return 1 + st;
    }
    if tag == 23 {
        let ae: i32 = vec_get(ed1, idx);
        let sa: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, ae, depth + 1);
        if sa <= 0 { return 0 - 1; }
        return 1 + sa;
    }
    if tag == 24 {
        let fc: i32 = vec_get(ed3, idx);
        if fc <= 0 { return 1; }
        let mut sumf: i32 = 1;
        let mut fi: i32 = 0;
        while fi < fc {
            let fr: i32 = idx - fc + fi;
            let sf: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, fr, depth + 1);
            if sf <= 0 { return 0 - 1; }
            sumf = sumf + sf;
            fi = fi + 1;
        }
        return sumf;
    }
    if tag == 25 {
        let first: i32 = vec_get(ed1, idx);
        let cnt: i32 = vec_get(ed2, idx);
        let mut cur: i32 = first;
        let mut sumt: i32 = 1;
        let mut j: i32 = 0;
        while j < cnt {
            let se: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, cur, depth + 1);
            if se <= 0 { return 0 - 1; }
            sumt = sumt + se;
            cur = cur + se;
            j = j + 1;
        }
        return sumt;
    }
    if tag == 26 {
        let ec: i32 = vec_get(ed2, idx);
        let mut suma: i32 = 1;
        let mut k: i32 = 0;
        while k < ec {
            let er: i32 = idx - ec + k;
            let se: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, er, depth + 1);
            if se <= 0 { return 0 - 1; }
            suma = suma + se;
            k = k + 1;
        }
        return suma;
    }
    return 0 - 1;
}

fn link_expr_find_root_covering_min(expr_tags: Vec<i32>, ed1: Vec<i32>,
                                    ed2: Vec<i32>, ed3: Vec<i32>, ed4: Vec<i32>,
                                    lo: i32, hi_excl: i32) -> i32 {
    let mut r: i32 = lo;
    while r < hi_excl {
        let c: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                   ed4, r, 0);
        if c > 0 {
            let min_i: i32 = r - c + 1;
            if min_i <= lo { return r; }
        }
        r = r + 1;
    }
    return 0 - 1;
}

fn link_expr_root_needs_mangle(expr_tags: Vec<i32>, ed1: Vec<i32>,
                               ed2: Vec<i32>, ed3: Vec<i32>, ed4: Vec<i32>,
                               pp: Vec<i32>,
                               ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                               ty_d2: Vec<i32>, ty_d3: Vec<i32>,
                               tops: Vec<i32>, idx: i32, depth: i32) -> bool {
    if idx < 0 { return false; }
    if depth > 96 { return false; }
    let tag: i32 = vec_get(expr_tags, idx);
    if tag == 1 {
        return link_expr_path_needs_mangle(expr_tags, ed1, ed2, pp, tops,
                                           idx);
    }
    if tag == 2 {
        let op: i32 = vec_get(ed2, idx);
        return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
            pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, op, depth + 1);
    }
    if tag == 3 {
        let lhs: i32 = vec_get(ed2, idx);
        let rhs: i32 = vec_get(ed3, idx);
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, lhs, depth + 1) == true {
            return true;
        }
        return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
            pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, rhs, depth + 1);
    }
    if tag == 4 {
        let ce: i32 = vec_get(ed1, idx);
        let af: i32 = vec_get(ed2, idx);
        let span: i32 = vec_get(ed3, idx);
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, ce, depth + 1) == true {
            return true;
        }
        let hi: i32 = af + span;
        let mut lo: i32 = af;
        while lo < hi {
            let ar: i32 = link_expr_find_root_covering_min(expr_tags, ed1, ed2,
                ed3, ed4, lo, hi);
            if ar < 0 { return false; }
            let ac: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, ar, 0);
            if ac <= 0 { return false; }
            if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                    pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, ar, depth + 1) ==
                    true {
                return true;
            }
            lo = ar + 1;
        }
        return false;
    }
    if tag == 5 {
        let rcv: i32 = vec_get(ed1, idx);
        let afm: i32 = vec_get(ed3, idx);
        let acm: i32 = vec_get(ed4, idx);
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, rcv, depth + 1) == true {
            return true;
        }
        let hi5: i32 = afm + acm;
        let mut lo5: i32 = afm;
        while lo5 < hi5 {
            let ar5: i32 = link_expr_find_root_covering_min(expr_tags, ed1,
                ed2, ed3, ed4, lo5, hi5);
            if ar5 < 0 { return false; }
            let ac5: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, ar5, 0);
            if ac5 <= 0 { return false; }
            if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                    pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, ar5, depth + 1) ==
                    true {
                return true;
            }
            lo5 = ar5 + 1;
        }
        return false;
