fn test_link_program_item_vecs_append() -> i32 {
    let it_a: Vec<i32> = vec_new();
    let id1_a: Vec<i32> = vec_new();
    let id2_a: Vec<i32> = vec_new();
    let id3_a: Vec<i32> = vec_new();
    let id4_a: Vec<i32> = vec_new();
    let id5_a: Vec<i32> = vec_new();
    vec_push(it_a, 0);
    vec_push(id1_a, 1);
    vec_push(id2_a, 2);
    vec_push(id3_a, 3);
    vec_push(id4_a, 4);
    vec_push(id5_a, 5);
    let it_b: Vec<i32> = vec_new();
    let id1_b: Vec<i32> = vec_new();
    let id2_b: Vec<i32> = vec_new();
    let id3_b: Vec<i32> = vec_new();
    let id4_b: Vec<i32> = vec_new();
    let id5_b: Vec<i32> = vec_new();
    vec_push(it_b, 10);
    vec_push(id1_b, 11);
    vec_push(id2_b, 12);
    vec_push(id3_b, 13);
    vec_push(id4_b, 14);
    vec_push(id5_b, 15);
    let napp: i32 = vec_len(it_b);
    let mut japp: i32 = 0;
    while japp < napp {
        vec_push(it_a, vec_get(it_b, japp));
        vec_push(id1_a, vec_get(id1_b, japp));
        vec_push(id2_a, vec_get(id2_b, japp));
        vec_push(id3_a, vec_get(id3_b, japp));
        vec_push(id4_a, vec_get(id4_b, japp));
        vec_push(id5_a, vec_get(id5_b, japp));
        japp = japp + 1;
    }
    if vec_len(it_a) != 2 { return 1; }
    if vec_get(it_a, 0) != 0 { return 2; }
    if vec_get(it_a, 1) != 10 { return 3; }
    if vec_get(id4_a, 1) != 14 { return 4; }
    return 0;
}

