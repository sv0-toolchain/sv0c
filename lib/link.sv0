        return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
            pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, i8, depth + 1);
    }
    if tag == 9 {
        let sf9: i32 = vec_get(ed1, idx);
        let sc9: i32 = vec_get(ed2, idx);
        let tail9: i32 = vec_get(ed3, idx);
        let mut lo9: i32 = sf9;
        let mut si9: i32 = 0;
        while si9 < sc9 {
            let sr9: i32 = link_expr_find_root_covering_min(expr_tags, ed1, ed2,
                ed3, ed4, lo9, idx);
            if sr9 < 0 { return false; }
            if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
                    ty_tags, ty_d1, ty_d2, ty_d3, tops, sr9, depth + 1) == true {
                return true;
            }
            lo9 = sr9 + 1;
            si9 = si9 + 1;
        }
        if tail9 >= 0 {
            return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, tail9, depth + 1);
        }
        return false;
    }
    if tag == 10 {
        let c10: i32 = vec_get(ed1, idx);
        let t10: i32 = vec_get(ed2, idx);
        let e10: i32 = vec_get(ed3, idx);
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
                ty_tags, ty_d1, ty_d2, ty_d3, tops, c10, depth + 1) == true {
            return true;
        }
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
                ty_tags, ty_d1, ty_d2, ty_d3, tops, t10, depth + 1) == true {
            return true;
        }
        if e10 >= 0 {
            return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, e10, depth + 1);
        }
        return false;
    }
    if tag == 11 {
        let scr11: i32 = vec_get(ed1, idx);
        let af11: i32 = vec_get(ed2, idx);
        let ac11: i32 = vec_get(ed3, idx);
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
                ty_tags, ty_d1, ty_d2, ty_d3, tops, scr11, depth + 1) == true {
            return true;
        }
        let mut lo11: i32 = af11;
        let mut ai11: i32 = 0;
        while ai11 < ac11 {
            let ar11: i32 = link_expr_find_root_covering_min(expr_tags, ed1, ed2,
                ed3, ed4, lo11, idx);
            if ar11 < 0 { return false; }
            if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
