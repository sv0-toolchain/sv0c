/* Phase 2 real pipeline module: sml/link/link.sml -> sv0.
   Link-time utilities: file classification (isSv0, isHidden),
   name extraction (fileStem), name mangling (mangle), fn_name_for_link
   (main exemption), link_dir_from_entry (directory extraction),
   top-level name collection (collectTops — tag+name streams and
   Vec<i32> collection), link directive stripping (stripLinkDirectives),
   split-module detection, map_path_segs (SML mapPathSegs — 1/2-segment
   path mangling with rewrite).
   G2 (M3-S-019): walk_sv0 / parse_file / link_project_dir expose host
   I/O for orchestration (read_dir / read_file / listing). G6 adds
   link_listing_nonempty / link_project_guard_nonempty (E0321-style empty
   listing), link_project_concat_sources_from_listing + listing_count_nonempty_paths,
   link_project_concat_sources_from_dir; link_project_listing_from_entry /
   link_project_concat_sources_from_entry (SML linkDirectory → linkProjectDir bridges),
   link_ty_tyname_path_needs_mangle; link_ty_subtree_node_count;
   link_ty_peel_ref_mut_slice / link_ty_after_ref_slice_chain_tyname_needs_mangle
   (Ref/RefMut/Slice, TyArray, TyTuple, TyName + generic args);
   **`link_path_pool_prefix_needs_mangle`** + **`link_expr_path_needs_mangle`**
   (ExprPath); **`link_expr_subtree_node_count`** / **`link_expr_root_needs_mangle`**
   (recursive mapExpr predicate — ExprCall/MethodCall arg slicing, block/match
   root-span traversal, stmt/arm tags 27–33). **`link_pat_subtree_node_count`** /
   **`link_pat_root_needs_mangle`** — standalone **pat arena** (parser **`pat_tags`**
   rows 0–6) subtree sizing + path mangle predicate (**`mapPat`** rewrite still
   deferred).    **`link_ty_tyname_first_seg_preview`** / **`link_ty_tyname_second_seg_preview`**;
   **`link_expr_path_first_seg_preview`** / **`link_expr_path_second_seg_preview`** —
   same dry-run for **`ExprPath`** (expr tag 1; **`ed1`/`ed2`** = **`pp`** start/count).
   No arena mutation — **`doc/link-g6-blockers.md`**. **`mapItem`** rewrite remains deferred. */

/* ── file classification ────────────────────────────────────── */

fn is_sv0(name: string) -> bool {
    let len: i32 = string_len(name);
    if len < 4 { return false; }
    let suffix: string = string_substr(name, len - 4, 4);
    return string_eq(suffix, ".sv0");
}

fn is_hidden(name: string) -> bool {
    let len: i32 = string_len(name);
    if len == 0 { return false; }
    let first: i32 = string_char_at(name, 0);
    return first == 46;
}

fn is_link_source_file(name: string) -> bool {
    if is_hidden(name) { return false; }
    return is_sv0(name);
}

/* Newline-separated full paths to .sv0 files under dir (recursive),
   sorted lexicographically — see sv0doc/compiler/bootstrap-host-io.md. */
fn list_sv0(dir: string) -> string {
    return read_dir(dir);
}

fn walk_sv0(dir: string) -> string {
    return read_dir(dir);
}

fn parse_file(path: string) -> string {
    return read_file(path);
}

fn listing_find_newline(listing: string, start: i32) -> i32 {
    let len: i32 = string_len(listing);
    let mut i: i32 = start;
    while i < len {
        if string_char_at(listing, i) == 10 { return i; }
        i = i + 1;
    }
    return len;
}

fn link_project_concat_sources_from_listing(listing: string) -> string {
    let len: i32 = string_len(listing);
    let mut p: i32 = 0;
    let mut out: string = "";
    let mut first: bool = true;
    while p < len {
        let nl: i32 = listing_find_newline(listing, p);
        let lsz: i32 = nl - p;
        if lsz > 0 {
            let path: string = string_substr(listing, p, lsz);
            let src: string = parse_file(path);
            if first {
                out = src;
                first = false;
            } else {
                out = string_concat(out, "\n");
                out = string_concat(out, src);
            }
        }
        p = nl + 1;
    }
    return out;
}

/* Count non-empty lines in a read_dir / list_sv0 listing (newline-separated paths). */

fn listing_count_nonempty_paths(listing: string) -> i32 {
    let len: i32 = string_len(listing);
    let mut p: i32 = 0;
    let mut n: i32 = 0;
    while p < len {
        let nl: i32 = listing_find_newline(listing, p);
        let lsz: i32 = nl - p;
        if lsz > 0 { n = n + 1; }
        p = nl + 1;
    }
    return n;
}

/* SML linkProjectDir: listSv0(dir) then per-path parseFile — source-level bridge
   uses host read_dir ordering (see sv0doc/compiler/bootstrap-host-io.md) +
   link_project_concat_sources_from_listing. AST mapProgramUnit remains in parser. */

fn link_project_concat_sources_from_dir(dir: string) -> string {
    let listing: string = link_project_dir(dir);
    return link_project_concat_sources_from_listing(listing);
}

/* SML Link.linkDirectory(entryPath): OS.Path.dir entryPath (or ".") then
   linkProjectDir. Listing / concat bridges use the same dir extraction.
   Do not call from VM unit tests: link_project_dir invokes read_dir (host). */

fn link_project_listing_from_entry(entry_path: string) -> string {
    let dir: string = link_dir_from_entry(entry_path);
    return link_project_dir(dir);
}

fn link_project_concat_sources_from_entry(entry_path: string) -> string {
    let dir: string = link_dir_from_entry(entry_path);
    return link_project_concat_sources_from_dir(dir);
}

fn link_project_dir(dir: string) -> string {
    return list_sv0(dir);
}

/* ── G6 (M3-S-039 / M3-S-040): empty-project guard (SML linkProjectDir E0321) ─
   Full recursive mapTy/mapExpr/mapItem on parser arenas remains deferred; see
   sv0c/sml/link/link.sml and milestone ## M3 G6 slice status. */

fn LINK_ERR_NO_SV0_IN_DIR() -> i32 {
    return 321;
}

fn link_listing_nonempty(listing: string) -> bool {
    return listing_count_nonempty_paths(listing) > 0;
}

fn link_project_guard_nonempty(dir: string) -> i32 {
    let listing: string = link_project_dir(dir);
    if link_listing_nonempty(listing) != true {
        return LINK_ERR_NO_SV0_IN_DIR();
    }
    return 0;
}

/* ── name extraction ────────────────────────────────────────── */

fn find_last_slash(path: string) -> i32 {
    let len: i32 = string_len(path);
    let mut i: i32 = len - 1;
    while i >= 0 {
        let c: i32 = string_char_at(path, i);
        if c == 47 { return i; }
        if c == 92 { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

fn find_last_dot(s: string, start: i32) -> i32 {
    let len: i32 = string_len(s);
    let mut i: i32 = len - 1;
    while i >= start {
        let c: i32 = string_char_at(s, i);
        if c == 46 { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

fn file_stem(path: string) -> string {
    let len: i32 = string_len(path);
    let slash: i32 = find_last_slash(path);
    let base_start: i32 = slash + 1;
    let dot: i32 = find_last_dot(path, base_start);
    if dot <= base_start {
        return string_substr(path, base_start, len - base_start);
    }
    return string_substr(path, base_start, dot - base_start);
}

/* ── name mangling ──────────────────────────────────────────── */

fn mangle(mod_id: string, x: string) -> string {
    let a: string = string_concat(mod_id, "__");
    return string_concat(a, x);
}

fn fn_name_for_link(mod_id: string, name: string) -> string {
    if string_eq(name, "main") { return "main"; }
    return mangle(mod_id, name);
}

fn link_dir_from_entry(entry_path: string) -> string {
    let slash: i32 = find_last_slash(entry_path);
    if slash < 0 { return "."; }
    if slash == 0 { return "/"; }
    return string_substr(entry_path, 0, slash);
}

fn module_id_from_entry_path(entry_path: string) -> string {
    return file_stem(entry_path);
}

/* ── top-level name collection ──────────────────────────────── */

/* Item tags from ast.sv0: 0=ItemFn, 1=ItemStruct, 2=ItemEnum,
   3=ItemTrait, 4=ItemImpl, 5=ItemUse, 6=ItemModule, 7=ItemTypeAlias.
   collectTops collects names from ItemFn, ItemStruct, ItemEnum,
   ItemTrait, ItemTypeAlias — tags 0,1,2,3,7. */
fn is_top_defining(tag: i32) -> bool {
    if tag == 0 { return true; }
    if tag == 1 { return true; }
    if tag == 2 { return true; }
    if tag == 3 { return true; }
    if tag == 7 { return true; }
    return false;
}

fn collect_tops_count(item_tags: Vec<i32>) -> i32 {
    let len: i32 = vec_len(item_tags);
    let mut count: i32 = 0;
    let mut i: i32 = 0;
    while i < len {
        let tag: i32 = vec_get(item_tags, i);
        if is_top_defining(tag) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

/* SML collectTops: builds a list of name handles for top-defining items.
   item_tags and item_names are parallel Vecs of the same length. */
fn collect_top_names(item_tags: Vec<i32>, item_names: Vec<i32>,
                     out: Vec<i32>) -> i32 {
    let len: i32 = vec_len(item_tags);
    let mut count: i32 = 0;
    let mut i: i32 = 0;
    while i < len {
        if is_top_defining(vec_get(item_tags, i)) {
            vec_push(out, vec_get(item_names, i));
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

/* ── link directive stripping ───────────────────────────────── */

/* stripLinkDirectives removes ItemUse (5) and ItemModule (6). */
fn is_link_directive(tag: i32) -> bool {
    if tag == 5 { return true; }
    if tag == 6 { return true; }
    return false;
}

fn strip_directives_count(item_tags: Vec<i32>) -> i32 {
    let len: i32 = vec_len(item_tags);
    let mut count: i32 = 0;
    let mut i: i32 = 0;
    while i < len {
        let tag: i32 = vec_get(item_tags, i);
        if is_link_directive(tag) != true { count = count + 1; }
        i = i + 1;
    }
    return count;
}

/* ── split module ───────────────────────────────────────────── */

fn has_module_prefix(first_tag: i32) -> bool {
    return first_tag == 6;
}

fn split_module_inner_count(total_items: i32, has_wrapper: bool) -> i32 {
    if has_wrapper { return total_items - 1; }
    return total_items;
}

/* ── type rewrite classification (mapTy dispatch) ────────────── */

fn map_ty_kind(ty_tag: i32) -> i32 {
    if ty_tag == 0 { return 1; }
    if ty_tag == 1 { return 2; }
    if ty_tag == 2 { return 2; }
    if ty_tag == 3 { return 2; }
    if ty_tag == 4 { return 2; }
    if ty_tag == 5 { return 3; }
    if ty_tag == 6 { return 0; }
    if ty_tag == 7 { return 0; }
    return 0;
}

fn needs_path_rewrite(ty_tag: i32) -> bool {
    return map_ty_kind(ty_tag) == 1;
}

fn needs_recursive_rewrite(ty_tag: i32) -> bool {
    return map_ty_kind(ty_tag) == 2;
}

fn needs_list_rewrite(ty_tag: i32) -> bool {
    return map_ty_kind(ty_tag) == 3;
}

fn is_leaf_ty(ty_tag: i32) -> bool {
    return map_ty_kind(ty_tag) == 0;
}

fn rewrite_depth(ty_tag: i32, child_depth: i32) -> i32 {
    if is_leaf_ty(ty_tag) { return 0; }
    return 1 + child_depth;
}

/* ── item rewrite classification (mapItem dispatch) ──────────── */

fn item_needs_rewrite(item_kind: i32) -> bool {
    if item_kind == 0 { return true; }
    if item_kind == 3 { return true; }
    if item_kind == 4 { return true; }
    if item_kind == 5 { return true; }
    if item_kind == 6 { return true; }
    return false;
}

fn item_has_body(item_kind: i32) -> bool {
    if item_kind == 0 { return true; }
    if item_kind == 5 { return true; }
    if item_kind == 6 { return true; }
    return false;
}

fn item_has_fields(item_kind: i32) -> bool {
    if item_kind == 3 { return true; }
    if item_kind == 4 { return true; }
    return false;
}

fn map_fn_components(has_params: bool, has_body: bool, has_contracts: bool) -> i32 {
    let mut parts: i32 = 1;
    if has_params { parts = parts + 1; }
    if has_body { parts = parts + 1; }
    if has_contracts { parts = parts + 1; }
    return parts;
}

/* ── in-tops membership (Vec-based) ─────────────────────────── */

fn in_tops(tops: Vec<i32>, name: i32) -> bool {
    let len: i32 = vec_len(tops);
    let mut i: i32 = 0;
    while i < len {
        let t: i32 = vec_get(tops, i);
        if t == name { return true; }
        i = i + 1;
    }
    return false;
}

/* map_path_seg: if name handle is in tops, mangle it with mod_id
   string. Returns the original or mangled name handle. Since we
   can only return i32 and mangled names need string operations, this
   surrogate returns 1 (rewritten) or 0 (unchanged) as a flag. */
fn path_seg_needs_mangle(tops: Vec<i32>, name: i32) -> bool {
    return in_tops(tops, name);
}

/* ── map_path_segs (SML mapPathSegs) ───────────────────────── */

fn map_path_segs_needs_mangle(tops: Vec<i32>, seg_count: i32,
                              first_seg: i32) -> bool {
    if seg_count == 1 { return in_tops(tops, first_seg); }
    if seg_count == 2 { return in_tops(tops, first_seg); }
    return false;
}

fn map_path_segs_mangle_first(mod_id: string, first_seg_str: string) -> string {
    return mangle(mod_id, first_seg_str);
}

/* SML mapPathSegs composition: for a 1-segment path, if in tops
   the result is [mangle(mod_id, seg)]; for 2-segment, [mangle(mod_id, seg0), seg1].
   map_path_segs_rewrite_1 returns mangled string for a 1-seg path. */
fn map_path_segs_rewrite_1(tops: Vec<i32>, mod_id: string,
                           seg_handle: i32, seg_str: string) -> string {
    if in_tops(tops, seg_handle) {
        return mangle(mod_id, seg_str);
    }
    return seg_str;
}

/* map_path_segs_rewrite_2 returns mangled first segment for a 2-seg path.
   Second segment is unchanged; caller keeps it. */
fn map_path_segs_rewrite_2(tops: Vec<i32>, mod_id: string,
                           first_handle: i32, first_str: string) -> string {
    if in_tops(tops, first_handle) {
        return mangle(mod_id, first_str);
    }
    return first_str;
}

/* ── mapPathSegs predicate on path pool (TyName + ExprPath share encoding) ─ */

fn link_path_pool_prefix_needs_mangle(pp: Vec<i32>, tops: Vec<i32>,
                                      pool_start: i32,
                                      seg_count: i32) -> bool {
    if seg_count == 1 {
        let ft: i32 = vec_get(pp, pool_start);
        return map_path_segs_needs_mangle(tops, 1, ft);
    }
    if seg_count == 2 {
        let ft2: i32 = vec_get(pp, pool_start);
        return map_path_segs_needs_mangle(tops, 2, ft2);
    }
    return false;
}

/* ── mapTy TyName slice (M3-S-039): path rewrite predicate on ty arena ─────
   SML mapTy recurses through TyRef/TyTuple/…; generic TyName args need extra
   metadata to walk in the flat arena — track in transliteration-plan. This
   helper covers TyName path segments only (mapPathSegs composition). */

fn link_ty_tyname_path_needs_mangle(ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                                    ty_d2: Vec<i32>, pp: Vec<i32>,
                                    tops: Vec<i32>, idx: i32) -> bool {
    if idx < 0 { return false; }
    if vec_get(ty_tags, idx) != 0 { return false; }
    let ps: i32 = vec_get(ty_d1, idx);
    let sc: i32 = vec_get(ty_d2, idx);
    return link_path_pool_prefix_needs_mangle(pp, tops, ps, sc);
}

/* Lexer token slice — mirrors parser **`ps_tok_text`** for **`pos`** handle. */

fn link_tok_text(source: string, starts: Vec<i32>, ends: Vec<i32>,
                 pos: i32) -> string {
    let st: i32 = vec_get(starts, pos);
    let en: i32 = vec_get(ends, pos);
    let len: i32 = en - st;
    return string_substr(source, st, len);
}

/* Dry-run **`mapPathSegs`** on **`TyName`** first segment: returned text is what a
   mutating **`mapTy`** would spell after rewrite. Does not write arenas — full
   rewrite needs synthetic token handles; see **`doc/link-g6-blockers.md`**. */

fn link_ty_tyname_first_seg_preview(ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                                    ty_d2: Vec<i32>, pp: Vec<i32>,
                                    tops: Vec<i32>, mod_id: string,
                                    starts: Vec<i32>, ends: Vec<i32>,
                                    source: string, idx: i32) -> string {
    if idx < 0 { return ""; }
    if vec_get(ty_tags, idx) != 0 { return ""; }
    let ps: i32 = vec_get(ty_d1, idx);
    let sc: i32 = vec_get(ty_d2, idx);
    if sc == 1 {
        let h1: i32 = vec_get(pp, ps);
        let t1: string = link_tok_text(source, starts, ends, h1);
        return map_path_segs_rewrite_1(tops, mod_id, h1, t1);
    }
    if sc == 2 {
        let hf: i32 = vec_get(pp, ps);
        let tf: string = link_tok_text(source, starts, ends, hf);
        return map_path_segs_rewrite_2(tops, mod_id, hf, tf);
    }
    return "";
}

/* Second **`TyName`** path segment text when **`sc==2`** (`Foo::Bar`). SML
   **`mapPathSegs`** only rewrites the first segment; the second token is copied
   through unchanged — this helper surfaces that text for diagnostics / previews.
   Empty when **`sc!=2`**. */

fn link_ty_tyname_second_seg_preview(ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                                     ty_d2: Vec<i32>, pp: Vec<i32>,
                                     starts: Vec<i32>, ends: Vec<i32>,
                                     source: string, idx: i32) -> string {
    if idx < 0 { return ""; }
    if vec_get(ty_tags, idx) != 0 { return ""; }
    let ps: i32 = vec_get(ty_d1, idx);
    let sc: i32 = vec_get(ty_d2, idx);
    if sc != 2 { return ""; }
    let h2: i32 = vec_get(pp, ps + 1);
    return link_tok_text(source, starts, ends, h2);
}

/* ExprPath (parser expr tag 1): same pp_start / pp_count as mapExpr ExprPath. */

fn link_expr_path_needs_mangle(expr_tags: Vec<i32>, ed1: Vec<i32>,
                               ed2: Vec<i32>, pp: Vec<i32>,
                               tops: Vec<i32>, idx: i32) -> bool {
    if idx < 0 { return false; }
    if vec_get(expr_tags, idx) != 1 { return false; }
    let ps2: i32 = vec_get(ed1, idx);
    let sc2: i32 = vec_get(ed2, idx);
    return link_path_pool_prefix_needs_mangle(pp, tops, ps2, sc2);
}

/* Dry-run **`mapPathSegs`** on **`ExprPath`** first segment — logic matches
   **`link_ty_tyname_first_seg_preview`** but reads **`expr_tags`/`ed1`/`ed2`**. */

fn link_expr_path_first_seg_preview(expr_tags: Vec<i32>, ed1: Vec<i32>,
                                    ed2: Vec<i32>, pp: Vec<i32>,
                                    tops: Vec<i32>, mod_id: string,
                                    starts: Vec<i32>, ends: Vec<i32>,
                                    source: string, idx: i32) -> string {
    if idx < 0 { return ""; }
    if vec_get(expr_tags, idx) != 1 { return ""; }
    let ps: i32 = vec_get(ed1, idx);
    let sc: i32 = vec_get(ed2, idx);
    if sc == 1 {
        let h1: i32 = vec_get(pp, ps);
        let t1: string = link_tok_text(source, starts, ends, h1);
        return map_path_segs_rewrite_1(tops, mod_id, h1, t1);
    }
    if sc == 2 {
        let hf: i32 = vec_get(pp, ps);
        let tf: string = link_tok_text(source, starts, ends, hf);
        return map_path_segs_rewrite_2(tops, mod_id, hf, tf);
    }
    return "";
}

/* Second **`ExprPath`** segment text when **`sc==2`**. */

fn link_expr_path_second_seg_preview(expr_tags: Vec<i32>, ed1: Vec<i32>,
                                     ed2: Vec<i32>, pp: Vec<i32>,
                                     starts: Vec<i32>, ends: Vec<i32>,
                                     source: string, idx: i32) -> string {
    if idx < 0 { return ""; }
    if vec_get(expr_tags, idx) != 1 { return ""; }
    let ps: i32 = vec_get(ed1, idx);
    let sc: i32 = vec_get(ed2, idx);
    if sc != 2 { return ""; }
    let h2: i32 = vec_get(pp, ps + 1);
    return link_tok_text(source, starts, ends, h2);
}

/* Synthetic token append helper for mapPathSegs rewrites.
   Appends text to source, records [start,end) token spans, and returns
   the updated source buffer. */

fn link_append_synth_ident(source: string, starts: Vec<i32>, ends: Vec<i32>,
                           text: string) -> string {
    let mut out: string = source;
    let mut st: i32 = string_len(source);
    if st > 0 {
        out = string_concat(out, "\n");
        st = st + 1;
    }
    out = string_concat(out, text);
    vec_push(starts, st);
    vec_push(ends, st + string_len(text));
    return out;
}

fn link_last_tok_handle(starts: Vec<i32>) -> i32 {
    return vec_len(starts) - 1;
}

/* M3-S-039 forward step: mutate first path segment token handle for TyName
   rows (tag 0) using synthetic token append. */

fn link_ty_tyname_rewrite_first_seg_handle(ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                                           ty_d2: Vec<i32>, pp: Vec<i32>,
                                           tops: Vec<i32>, mod_id: string,
                                           starts: Vec<i32>, ends: Vec<i32>,
                                           source: string, idx: i32) -> string {
    if idx < 0 { return source; }
    if vec_get(ty_tags, idx) != 0 { return source; }
    let ps: i32 = vec_get(ty_d1, idx);
    let sc: i32 = vec_get(ty_d2, idx);
    if sc != 1 {
        if sc != 2 { return source; }
    }
    let h0: i32 = vec_get(pp, ps);
    if in_tops(tops, h0) != true { return source; }
    let t0: string = link_tok_text(source, starts, ends, h0);
    let mangled: string = mangle(mod_id, t0);
    let out: string = link_append_synth_ident(source, starts, ends, mangled);
    let nh: i32 = link_last_tok_handle(starts);
    vec_set(pp, ps, nh);
    return out;
}

/* M3-S-039 forward step: mutate first path segment token handle for ExprPath
   rows (expr tag 1) using synthetic token append. */

fn link_expr_path_rewrite_first_seg_handle(expr_tags: Vec<i32>, ed1: Vec<i32>,
                                           ed2: Vec<i32>, pp: Vec<i32>,
                                           tops: Vec<i32>, mod_id: string,
                                           starts: Vec<i32>, ends: Vec<i32>,
                                           source: string, idx: i32) -> string {
    if idx < 0 { return source; }
    if vec_get(expr_tags, idx) != 1 { return source; }
    let ps: i32 = vec_get(ed1, idx);
    let sc: i32 = vec_get(ed2, idx);
    if sc != 1 {
        if sc != 2 { return source; }
    }
    let h0: i32 = vec_get(pp, ps);
    if in_tops(tops, h0) != true { return source; }
    let t0: string = link_tok_text(source, starts, ends, h0);
    let mangled: string = mangle(mod_id, t0);
    let out: string = link_append_synth_ident(source, starts, ends, mangled);
    let nh: i32 = link_last_tok_handle(starts);
    vec_set(pp, ps, nh);
    return out;
}

fn link_ty_arena_rewrite_all_first_seg(ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                                       ty_d2: Vec<i32>, pp: Vec<i32>,
                                       tops: Vec<i32>, mod_id: string,
                                       starts: Vec<i32>, ends: Vec<i32>,
                                       source: string) -> string {
    let mut out: string = source;
    let n: i32 = vec_len(ty_tags);
    let mut i: i32 = 0;
    while i < n {
        out = link_ty_tyname_rewrite_first_seg_handle(ty_tags, ty_d1, ty_d2, pp,
            tops, mod_id, starts, ends, out, i);
        i = i + 1;
    }
    return out;
}

fn link_expr_arena_rewrite_all_first_seg(expr_tags: Vec<i32>, ed1: Vec<i32>,
                                         ed2: Vec<i32>, pp: Vec<i32>,
                                         tops: Vec<i32>, mod_id: string,
                                         starts: Vec<i32>, ends: Vec<i32>,
                                         source: string) -> string {
    let mut out: string = source;
    let n: i32 = vec_len(expr_tags);
    let mut i: i32 = 0;
    while i < n {
        out = link_expr_path_rewrite_first_seg_handle(expr_tags, ed1, ed2, pp,
            tops, mod_id, starts, ends, out, i);
        i = i + 1;
    }
    return out;
}

/* mapPat path helpers (PatStruct=4, PatEnum=5): previews + first-segment
   synthetic-token rewrite to mirror TyName/ExprPath rewrites. */

fn link_pat_path_first_seg_preview(pat_tags: Vec<i32>, pat_d1: Vec<i32>,
                                   pat_d2: Vec<i32>, pp: Vec<i32>,
                                   tops: Vec<i32>, mod_id: string,
                                   starts: Vec<i32>, ends: Vec<i32>,
                                   source: string, idx: i32) -> string {
    if idx < 0 { return ""; }
    let tag: i32 = vec_get(pat_tags, idx);
    if tag != 4 {
        if tag != 5 { return ""; }
    }
    let ps: i32 = vec_get(pat_d1, idx);
    let sc: i32 = vec_get(pat_d2, idx);
    if sc == 1 {
        let h1: i32 = vec_get(pp, ps);
        let t1: string = link_tok_text(source, starts, ends, h1);
        return map_path_segs_rewrite_1(tops, mod_id, h1, t1);
    }
    if sc == 2 {
        let hf: i32 = vec_get(pp, ps);
        let tf: string = link_tok_text(source, starts, ends, hf);
        return map_path_segs_rewrite_2(tops, mod_id, hf, tf);
    }
    return "";
}

fn link_pat_path_second_seg_preview(pat_tags: Vec<i32>, pat_d1: Vec<i32>,
                                    pat_d2: Vec<i32>, pp: Vec<i32>,
                                    starts: Vec<i32>, ends: Vec<i32>,
                                    source: string, idx: i32) -> string {
    if idx < 0 { return ""; }
    let tag: i32 = vec_get(pat_tags, idx);
    if tag != 4 {
        if tag != 5 { return ""; }
    }
    let ps: i32 = vec_get(pat_d1, idx);
    let sc: i32 = vec_get(pat_d2, idx);
    if sc != 2 { return ""; }
    let h2: i32 = vec_get(pp, ps + 1);
    return link_tok_text(source, starts, ends, h2);
}

fn link_pat_path_rewrite_first_seg_handle(pat_tags: Vec<i32>, pat_d1: Vec<i32>,
                                          pat_d2: Vec<i32>, pp: Vec<i32>,
                                          tops: Vec<i32>, mod_id: string,
                                          starts: Vec<i32>, ends: Vec<i32>,
                                          source: string, idx: i32) -> string {
    if idx < 0 { return source; }
    let tag: i32 = vec_get(pat_tags, idx);
    if tag != 4 {
        if tag != 5 { return source; }
    }
    let ps: i32 = vec_get(pat_d1, idx);
    let sc: i32 = vec_get(pat_d2, idx);
    if sc != 1 {
        if sc != 2 { return source; }
    }
    let h0: i32 = vec_get(pp, ps);
    if in_tops(tops, h0) != true { return source; }
    let t0: string = link_tok_text(source, starts, ends, h0);
    let mangled: string = mangle(mod_id, t0);
    let out: string = link_append_synth_ident(source, starts, ends, mangled);
    let nh: i32 = link_last_tok_handle(starts);
    vec_set(pp, ps, nh);
    return out;
}

fn link_pat_arena_rewrite_all_first_seg(pat_tags: Vec<i32>, pat_d1: Vec<i32>,
                                        pat_d2: Vec<i32>, pp: Vec<i32>,
                                        tops: Vec<i32>, mod_id: string,
                                        starts: Vec<i32>, ends: Vec<i32>,
                                        source: string) -> string {
    let mut out: string = source;
    let n: i32 = vec_len(pat_tags);
    let mut i: i32 = 0;
    while i < n {
        out = link_pat_path_rewrite_first_seg_handle(pat_tags, pat_d1, pat_d2,
            pp, tops, mod_id, starts, ends, out, i);
        i = i + 1;
    }
    return out;
}

/* M3-S-039: one-call mapPathSegs for path-bearing rows (TyName, ExprPath,
   PatStruct/PatEnum) — SML order is mapTy/mapExpr/mapPat; same flat-arena
   coverage as per-arena drivers. Item ident mangling (mapItem) is separate. */

fn link_apply_map_path_segs_program_source(ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                                           ty_d2: Vec<i32>, expr_tags: Vec<i32>,
                                           ed1: Vec<i32>, ed2: Vec<i32>,
                                           pat_tags: Vec<i32>, pat_d1: Vec<i32>,
                                           pat_d2: Vec<i32>, pp: Vec<i32>,
                                           tops: Vec<i32>, mod_id: string,
                                           starts: Vec<i32>, ends: Vec<i32>,
                                           source: string) -> string {
    let mut out: string = source;
    out = link_ty_arena_rewrite_all_first_seg(ty_tags, ty_d1, ty_d2, pp, tops,
        mod_id, starts, ends, out);
    out = link_expr_arena_rewrite_all_first_seg(expr_tags, ed1, ed2, pp, tops,
        mod_id, starts, ends, out);
    out = link_pat_arena_rewrite_all_first_seg(pat_tags, pat_d1, pat_d2, pp,
        tops, mod_id, starts, ends, out);
    return out;
}

/* ── mapItem defining identifiers (SML mapFn / mapStruct / mapEnum /
   mapTrait / ItemTypeAlias) ──────────────────────────────────────────
   Parser stores each top item's declared name as a lexer token index in
   item_names (parallel item_tags). Synthetic append + vec_set on that row
   mirrors other map* handle rewrites. **`fn main`** stays unmangled via
   **`fn_name_for_link`**.

   **`link_apply_map_link_pass_program_source`** runs **`mapPathSegs`** bulk
   passes first (same **`tops`** as **`collect_top_names`**), then defining
   item names. If the same source span index appeared in both a path pool row
   and **`item_names`**, both passes could append duplicate mangled lines —
   normal sources use distinct lexer indices for distinct occurrences; avoid
   overlapping synthetic tests. */

fn link_item_def_mangled_text(item_tag: i32, mod_id: string,
                              raw_name: string) -> string {
    if item_tag == 0 {
        return fn_name_for_link(mod_id, raw_name);
    }
    return mangle(mod_id, raw_name);
}

fn link_item_row_rewrite_defining_name(item_tags: Vec<i32>,
                                       item_names: Vec<i32>,
                                       mod_id: string,
                                       starts: Vec<i32>, ends: Vec<i32>,
                                       source: string, idx: i32) -> string {
    if idx < 0 { return source; }
    let tag: i32 = vec_get(item_tags, idx);
    if is_top_defining(tag) != true { return source; }
    let name_pos: i32 = vec_get(item_names, idx);
    let raw: string = link_tok_text(source, starts, ends, name_pos);
    let mangled: string = link_item_def_mangled_text(tag, mod_id, raw);
    if string_eq(mangled, raw) == true { return source; }
    let out: string = link_append_synth_ident(source, starts, ends, mangled);
    let nh: i32 = link_last_tok_handle(starts);
    vec_set(item_names, idx, nh);
    return out;
}

fn link_item_arena_rewrite_defining_names(item_tags: Vec<i32>,
                                          item_names: Vec<i32>,
                                          mod_id: string,
                                          starts: Vec<i32>, ends: Vec<i32>,
                                          source: string) -> string {
    let mut out: string = source;
    let n: i32 = vec_len(item_tags);
    let mut i: i32 = 0;
    while i < n {
        out = link_item_row_rewrite_defining_name(item_tags, item_names,
            mod_id, starts, ends, out, i);
        i = i + 1;
    }
    return out;
}

fn link_apply_map_link_pass_program_source(ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                                           ty_d2: Vec<i32>,
                                           expr_tags: Vec<i32>, ed1: Vec<i32>,
                                           ed2: Vec<i32>,
                                           pat_tags: Vec<i32>, pat_d1: Vec<i32>,
                                           pat_d2: Vec<i32>, pp: Vec<i32>,
                                           item_tags: Vec<i32>,
                                           item_names: Vec<i32>,
                                           tops: Vec<i32>, mod_id: string,
                                           starts: Vec<i32>, ends: Vec<i32>,
                                           source: string) -> string {
    let mut out: string = source;
    out = link_apply_map_path_segs_program_source(ty_tags, ty_d1, ty_d2,
        expr_tags, ed1, ed2, pat_tags, pat_d1, pat_d2, pp, tops, mod_id,
        starts, ends, out);
    out = link_item_arena_rewrite_defining_names(item_tags, item_names,
        mod_id, starts, ends, out);
    return out;
}

/* ── M3-S-040 merge primitives (per-file lex → merged token stream) ───
   **`link_project_concat_sources_*`** joins files with **`\\n`**. For token
   spans from file B (indices relative to **`source_b`** alone), relocate by
   **`string_len(source_a) + 1`** before merging parallel **`tags`/`starts`/`ends`**
   Vecs. **`parse_program`** arena relocation (expr/ty item indices) is still a
   separate orchestration step — these helpers only wire **byte-aligned** lexer
   output like SML **`parseFile` → concat** token bookkeeping. */

fn link_merge_sources_two(first: string, second: string) -> string {
    let mut out: string = first;
    out = string_concat(out, "\n");
    out = string_concat(out, second);
    return out;
}

fn link_second_file_byte_offset_after_concat(first: string) -> i32 {
    return string_len(first) + 1;
}

/* C backend: avoid chaining multiple `-> ()` calls in one block — use one loop or
   inline at call sites (see **`test_link_reloc_i32_vec_inplace`**). */
fn link_reloc_i32_vec_inplace(v: Vec<i32>, delta: i32) -> () {
    let n: i32 = vec_len(v);
    let mut i: i32 = 0;
    while i < n {
        vec_set(v, i, vec_get(v, i) + delta);
        i = i + 1;
    }
}

fn link_merge_parallel_token_streams_reloc_b(tags_a: Vec<i32>,
                                             starts_a: Vec<i32>, ends_a: Vec<i32>,
                                             tags_b: Vec<i32>,
                                             starts_b: Vec<i32>, ends_b: Vec<i32>,
                                             delta_b: i32,
                                             out_tags: Vec<i32>,
                                             out_starts: Vec<i32>,
                                             out_ends: Vec<i32>) -> i32 {
    let na: i32 = vec_len(tags_a);
    let mut ia: i32 = 0;
    while ia < na {
        vec_push(out_tags, vec_get(tags_a, ia));
        vec_push(out_starts, vec_get(starts_a, ia));
        vec_push(out_ends, vec_get(ends_a, ia));
        ia = ia + 1;
    }
    let nb: i32 = vec_len(tags_b);
    let mut j: i32 = 0;
    while j < nb {
        vec_push(out_tags, vec_get(tags_b, j));
        vec_push(out_starts, vec_get(starts_b, j) + delta_b);
        vec_push(out_ends, vec_get(ends_b, j) + delta_b);
        j = j + 1;
    }
    return vec_len(out_tags);
}

/* Append parallel **item** arena rows (`it`, **`id1`**–**`id5`**) from a second
   parsed unit onto **`_*_dst`** Vecs (same layout as **`parse_program`**).
   **`id4`** body roots / cross-arena indices are **not** relocated — caller must
   offset **`expr`/`ty`** arenas first when merging two standalone parses
   (**`M3-S-040`** full **`linkProjectDir`** parity). */

fn link_program_item_vecs_append(it_dst: Vec<i32>,
                                 id1_dst: Vec<i32>, id2_dst: Vec<i32>,
                                 id3_dst: Vec<i32>, id4_dst: Vec<i32>,
                                 id5_dst: Vec<i32>,
                                 it_src: Vec<i32>,
                                 id1_src: Vec<i32>, id2_src: Vec<i32>,
                                 id3_src: Vec<i32>, id4_src: Vec<i32>,
                                 id5_src: Vec<i32>) -> () {
    let n: i32 = vec_len(it_src);
    let mut i: i32 = 0;
    while i < n {
        vec_push(it_dst, vec_get(it_src, i));
        vec_push(id1_dst, vec_get(id1_src, i));
        vec_push(id2_dst, vec_get(id2_src, i));
        vec_push(id3_dst, vec_get(id3_src, i));
        vec_push(id4_dst, vec_get(id4_src, i));
        vec_push(id5_dst, vec_get(id5_src, i));
        i = i + 1;
    }
}

fn link_listing_path_at_index(listing: string, idx: i32) -> string {
    if idx < 0 { return ""; }
    let len: i32 = string_len(listing);
    let mut p: i32 = 0;
    let mut k: i32 = 0;
    while p < len {
        let nl: i32 = listing_find_newline(listing, p);
        let lsz: i32 = nl - p;
        if lsz > 0 {
            if k == idx { return string_substr(listing, p, lsz); }
            k = k + 1;
        }
        p = nl + 1;
    }
    return "";
}

fn link_listing_module_id_at_index(listing: string, idx: i32) -> string {
    let path: string = link_listing_path_at_index(listing, idx);
    if string_len(path) == 0 { return ""; }
    return file_stem(path);
}

fn link_project_concat_sources_offsets_from_listing(listing: string,
                                                    starts_out: Vec<i32>,
                                                    lens_out: Vec<i32>) -> string {
    let len: i32 = string_len(listing);
    let mut p: i32 = 0;
    let mut out: string = "";
    let mut first: bool = true;
    while p < len {
        let nl: i32 = listing_find_newline(listing, p);
        let lsz: i32 = nl - p;
        if lsz > 0 {
            let path: string = string_substr(listing, p, lsz);
            let src: string = parse_file(path);
            let mut start: i32 = string_len(out);
            if first {
                out = src;
                first = false;
                start = 0;
            } else {
                out = string_concat(out, "\n");
                out = string_concat(out, src);
                start = start + 1;
            }
            vec_push(starts_out, start);
            vec_push(lens_out, string_len(src));
        }
        p = nl + 1;
    }
    return out;
}

fn link_project_concat_sources_offsets_from_dir(dir: string,
                                                starts_out: Vec<i32>,
                                                lens_out: Vec<i32>) -> string {
    let listing: string = link_project_dir(dir);
    return link_project_concat_sources_offsets_from_listing(listing,
        starts_out, lens_out);
}

fn link_project_concat_sources_offsets_from_entry(entry_path: string,
                                                  starts_out: Vec<i32>,
                                                  lens_out: Vec<i32>) -> string {
    let dir: string = link_dir_from_entry(entry_path);
    return link_project_concat_sources_offsets_from_dir(dir,
        starts_out, lens_out);
}

/* Parser **pat** arena (parallel pat_tags / pat_data1–3) — see parser.sv0
   “pat arena tags”. Size + mapPat-style predicate for link-time passes that
   consume **`parse_pat`** buffers (match arms also embed patterns in the expr
   arena via ExprMatchArm / ExprPatExtra). Mirrors **`pat_leftmost_subtree_rows`**
   row counts. */

fn link_pat_subtree_node_count(pat_tags: Vec<i32>, pat_d1: Vec<i32>,
                               pat_d2: Vec<i32>, pat_d3: Vec<i32>,
                               idx: i32, depth: i32) -> i32 {
    if idx < 0 { return 0 - 1; }
    if depth > 96 { return 0 - 1; }
    let t: i32 = vec_get(pat_tags, idx);
    if t == 0 { return 1; }
    if t == 1 { return 1; }
    if t == 2 { return 1; }
    if t == 3 {
        let ef: i32 = vec_get(pat_d1, idx);
        let ec: i32 = vec_get(pat_d2, idx);
        let mut cur: i32 = ef;
        let mut tot: i32 = 0;
        let mut j: i32 = 0;
        while j < ec {
            let part: i32 = link_pat_subtree_node_count(pat_tags, pat_d1,
                pat_d2, pat_d3, cur, depth + 1);
            if part <= 0 { return 0 - 1; }
            tot = tot + part;
            cur = cur + part;
            j = j + 1;
        }
        return tot + 1;
    }
    if t == 4 {
        let fc: i32 = vec_get(pat_d3, idx);
        if fc <= 0 { return 1; }
        let first_f: i32 = idx - fc;
        let mut cur2: i32 = first_f;
        let mut tot2: i32 = 0;
        let mut j2: i32 = 0;
        while j2 < fc {
            let part2: i32 = link_pat_subtree_node_count(pat_tags, pat_d1,
                pat_d2, pat_d3, cur2, depth + 1);
            if part2 <= 0 { return 0 - 1; }
            tot2 = tot2 + part2;
            cur2 = cur2 + part2;
            j2 = j2 + 1;
        }
        return tot2 + 1;
    }
    if t == 5 {
        let ac: i32 = vec_get(pat_d3, idx);
        if ac <= 0 { return 1; }
        let first_a: i32 = idx - ac;
        let mut cur3: i32 = first_a;
        let mut tot3: i32 = 0;
        let mut j3: i32 = 0;
        while j3 < ac {
            let part3: i32 = link_pat_subtree_node_count(pat_tags, pat_d1,
                pat_d2, pat_d3, cur3, depth + 1);
            if part3 <= 0 { return 0 - 1; }
            tot3 = tot3 + part3;
            cur3 = cur3 + part3;
            j3 = j3 + 1;
        }
        return tot3 + 1;
    }
    if t == 6 {
        let fo: i32 = vec_get(pat_d1, idx);
        let span: i32 = idx - fo + 1;
        return span;
    }
    return 0 - 1;
}

fn link_pat_root_needs_mangle(pat_tags: Vec<i32>, pat_d1: Vec<i32>,
                              pat_d2: Vec<i32>, pat_d3: Vec<i32>,
                              pp: Vec<i32>, tops: Vec<i32>,
                              idx: i32, depth: i32) -> bool {
    if idx < 0 { return false; }
    if depth > 96 { return false; }
    let t: i32 = vec_get(pat_tags, idx);
    if t == 0 { return false; }
    if t == 1 { return false; }
    if t == 2 { return false; }
    if t == 3 {
        let ef: i32 = vec_get(pat_d1, idx);
        let ec: i32 = vec_get(pat_d2, idx);
        let mut cur: i32 = ef;
        let mut j: i32 = 0;
        while j < ec {
            if link_pat_root_needs_mangle(pat_tags, pat_d1, pat_d2, pat_d3,
                    pp, tops, cur, depth + 1) == true {
                return true;
            }
            let sp: i32 = link_pat_subtree_node_count(pat_tags, pat_d1, pat_d2,
                pat_d3, cur, 0);
            if sp <= 0 { return false; }
            cur = cur + sp;
            j = j + 1;
        }
        return false;
    }
    if t == 4 {
        let ps: i32 = vec_get(pat_d1, idx);
        let sc: i32 = vec_get(pat_d2, idx);
        if link_path_pool_prefix_needs_mangle(pp, tops, ps, sc) == true {
            return true;
        }
        let fc: i32 = vec_get(pat_d3, idx);
        let mut fi: i32 = 0;
        while fi < fc {
            let fr: i32 = idx - fc + fi;
            if link_pat_root_needs_mangle(pat_tags, pat_d1, pat_d2, pat_d3,
                    pp, tops, fr, depth + 1) == true {
                return true;
            }
            fi = fi + 1;
        }
        return false;
    }
    if t == 5 {
        let ps5: i32 = vec_get(pat_d1, idx);
        let sc5: i32 = vec_get(pat_d2, idx);
        if link_path_pool_prefix_needs_mangle(pp, tops, ps5, sc5) == true {
            return true;
        }
        let ac: i32 = vec_get(pat_d3, idx);
        let mut ai: i32 = 0;
        while ai < ac {
            let ar: i32 = idx - ac + ai;
            if link_pat_root_needs_mangle(pat_tags, pat_d1, pat_d2, pat_d3,
                    pp, tops, ar, depth + 1) == true {
                return true;
            }
            ai = ai + 1;
        }
        return false;
    }
    if t == 6 {
        let fo: i32 = vec_get(pat_d1, idx);
        let cnt: i32 = vec_get(pat_d2, idx);
        let mut cur: i32 = fo;
        let mut ai: i32 = 0;
        while ai < cnt {
            if link_pat_root_needs_mangle(pat_tags, pat_d1, pat_d2, pat_d3,
                    pp, tops, cur, depth + 1) == true {
                return true;
            }
            let sp: i32 = link_pat_subtree_node_count(pat_tags, pat_d1, pat_d2,
                pat_d3, cur, 0);
            if sp <= 0 { return false; }
            cur = cur + sp;
            ai = ai + 1;
        }
        return false;
    }
    return false;
}

/* Post-order expr subtree size at root idx (parser expr arena — children
   precede parents). */

fn link_expr_subtree_node_count(expr_tags: Vec<i32>, ed1: Vec<i32>,
                                ed2: Vec<i32>, ed3: Vec<i32>, ed4: Vec<i32>,
                                idx: i32, depth: i32) -> i32 {
    if idx < 0 { return 0 - 1; }
    if depth > 96 { return 0 - 1; }
    let tag: i32 = vec_get(expr_tags, idx);
    if tag == 0 { return 1; }
    if tag == 1 { return 1; }
    if tag == 2 {
        let op: i32 = vec_get(ed2, idx);
        let sc: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, op, depth + 1);
        if sc <= 0 { return 0 - 1; }
        return 1 + sc;
    }
    if tag == 3 {
        let lhs: i32 = vec_get(ed2, idx);
        let rhs: i32 = vec_get(ed3, idx);
        let sl: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, lhs, depth + 1);
        if sl <= 0 { return 0 - 1; }
        let sr: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, rhs, depth + 1);
        if sr <= 0 { return 0 - 1; }
        return 1 + sl + sr;
    }
    if tag == 4 {
        let ce: i32 = vec_get(ed1, idx);
        let span: i32 = vec_get(ed3, idx);
        let sc: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, ce, depth + 1);
        if sc <= 0 { return 0 - 1; }
        return 1 + sc + span;
    }
    if tag == 5 {
        let rcv: i32 = vec_get(ed1, idx);
        let spanm: i32 = vec_get(ed4, idx);
        let sr: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, rcv, depth + 1);
        if sr <= 0 { return 0 - 1; }
        return 1 + sr + spanm;
    }
    if tag == 6 {
        let ob: i32 = vec_get(ed1, idx);
        let sc: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, ob, depth + 1);
        if sc <= 0 { return 0 - 1; }
        return 1 + sc;
    }
    if tag == 7 {
        let ob7: i32 = vec_get(ed1, idx);
        let sc7: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                     ed4, ob7, depth + 1);
        if sc7 <= 0 { return 0 - 1; }
        return 1 + sc7;
    }
    if tag == 8 {
        let o8: i32 = vec_get(ed1, idx);
        let i8: i32 = vec_get(ed2, idx);
        let so: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, o8, depth + 1);
        if so <= 0 { return 0 - 1; }
        let si: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, i8, depth + 1);
        if si <= 0 { return 0 - 1; }
        return 1 + so + si;
    }
    if tag == 9 {
        let sf: i32 = vec_get(ed1, idx);
        let scnt: i32 = vec_get(ed2, idx);
        let tail: i32 = vec_get(ed3, idx);
        let mut sum9: i32 = 1;
        let mut lo9: i32 = sf;
        let mut si9: i32 = 0;
        while si9 < scnt {
            let sr9: i32 = link_expr_find_root_covering_min(expr_tags, ed1, ed2,
                ed3, ed4, lo9, idx);
            if sr9 < 0 { return 0 - 1; }
            let sc9: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, sr9, depth + 1);
            if sc9 <= 0 { return 0 - 1; }
            sum9 = sum9 + sc9;
            lo9 = sr9 + 1;
            si9 = si9 + 1;
        }
        if tail >= 0 {
            let st9: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, tail, depth + 1);
            if st9 <= 0 { return 0 - 1; }
            sum9 = sum9 + st9;
        }
        return sum9;
    }
    if tag == 10 {
        let cond: i32 = vec_get(ed1, idx);
        let th: i32 = vec_get(ed2, idx);
        let el: i32 = vec_get(ed3, idx);
        let sc: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, cond, depth + 1);
        if sc <= 0 { return 0 - 1; }
        let st: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, th, depth + 1);
        if st <= 0 { return 0 - 1; }
        let mut sum10: i32 = 1 + sc + st;
        if el >= 0 {
            let se: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, el, depth + 1);
            if se <= 0 { return 0 - 1; }
            sum10 = sum10 + se;
        }
        return sum10;
    }
    if tag == 11 {
        let scr: i32 = vec_get(ed1, idx);
        let af: i32 = vec_get(ed2, idx);
        let ac: i32 = vec_get(ed3, idx);
        let ss: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, scr, depth + 1);
        if ss <= 0 { return 0 - 1; }
        let mut sum11: i32 = 1 + ss;
        let mut lo11: i32 = af;
        let mut ai11: i32 = 0;
        while ai11 < ac {
            let ar11: i32 = link_expr_find_root_covering_min(expr_tags, ed1, ed2,
                ed3, ed4, lo11, idx);
            if ar11 < 0 { return 0 - 1; }
            let sa11: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, ar11, depth + 1);
            if sa11 <= 0 { return 0 - 1; }
            sum11 = sum11 + sa11;
            lo11 = ar11 + 1;
            ai11 = ai11 + 1;
        }
        return sum11;
    }
    if tag == 12 {
        let cond12: i32 = vec_get(ed1, idx);
        let body12: i32 = vec_get(ed2, idx);
        let invf: i32 = vec_get(ed3, idx);
        let invc: i32 = vec_get(ed4, idx);
        let sc12: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
