    if item_has_body(3) != false { return 6; }
    if item_has_body(6) != true { return 7; }
    if item_has_fields(3) != true { return 8; }
    if item_has_fields(4) != true { return 9; }
    if item_has_fields(0) != false { return 10; }
    if map_fn_components(true, true, true) != 4 { return 11; }
    if map_fn_components(false, true, false) != 2 { return 12; }
    if map_fn_components(false, false, false) != 1 { return 13; }
    return 0;
}

fn test_collect_top_names() -> i32 {
    let tags: Vec<i32> = vec_new();
    let names: Vec<i32> = vec_new();
    vec_push(tags, 0); vec_push(names, 100);
    vec_push(tags, 5); vec_push(names, 200);
    vec_push(tags, 1); vec_push(names, 300);
    vec_push(tags, 6); vec_push(names, 400);
    vec_push(tags, 7); vec_push(names, 500);
    let out: Vec<i32> = vec_new();
    let n: i32 = collect_top_names(tags, names, out);
    if n != 3 { return 1; }
    if vec_len(out) != 3 { return 2; }
    if vec_get(out, 0) != 100 { return 3; }
    if vec_get(out, 1) != 300 { return 4; }
    if vec_get(out, 2) != 500 { return 5; }
    return 0;
}

