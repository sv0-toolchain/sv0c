fn test_split_module_name() -> i32 {
    let it: Vec<i32> = vec_new();
    let id1: Vec<i32> = vec_new();
    let pp: Vec<i32> = vec_new();
    vec_push(it, 6);
    vec_push(id1, 0);
    vec_push(pp, 42);
    if split_module_name(it, id1, pp, 99) != 42 { return 1; }
    if split_module_body_start(it) != 1 { return 2; }
    let it2: Vec<i32> = vec_new();
    let id1b: Vec<i32> = vec_new();
    vec_push(it2, 0);
    vec_push(id1b, 10);
    if split_module_name(it2, id1b, pp, 99) != 99 { return 3; }
    if split_module_body_start(it2) != 0 { return 4; }
    let empty: Vec<i32> = vec_new();
    if split_module_name(empty, id1, pp, 77) != 77 { return 5; }
    if split_module_body_start(empty) != 0 { return 6; }
    return 0;
}

