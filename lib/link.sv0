/* Phase 2 real pipeline module: sml/link/link.sml -> sv0.
   Link-time utilities: file classification (isSv0, isHidden),
   name extraction (fileStem), name mangling (mangle), fn_name_for_link
   (main exemption), link_dir_from_entry (directory extraction),
   top-level name collection (collectTops — tag+name streams and
   Vec<i32> collection), link directive stripping (stripLinkDirectives),
   split-module detection, map_path_segs (SML mapPathSegs — 1/2-segment
   path mangling with rewrite).
   G2 (M3-S-019): walk_sv0 / parse_file / link_project_dir expose host
   I/O for orchestration (read_dir / read_file / listing). G6 adds
   link_listing_nonempty / link_project_guard_nonempty (E0321-style empty
   listing), link_project_concat_sources_from_listing + listing_count_nonempty_paths,
   link_project_concat_sources_from_dir; link_project_listing_from_entry /
   link_project_concat_sources_from_entry (SML linkDirectory → linkProjectDir bridges),
   link_ty_tyname_path_needs_mangle; link_ty_subtree_node_count;
   link_ty_peel_ref_mut_slice / link_ty_after_ref_slice_chain_tyname_needs_mangle
   (Ref/RefMut/Slice, TyArray, TyTuple, TyName + generic args);
   **`link_path_pool_prefix_needs_mangle`** + **`link_expr_path_needs_mangle`**
   (ExprPath); **`link_expr_subtree_node_count`** / **`link_expr_root_needs_mangle`**
   (recursive mapExpr predicate — ExprCall/MethodCall arg slicing, block/match
   root-span traversal, stmt/arm tags 27–33). **`mapPat`** / **`mapItem`**
   rewrite remains deferred. */

/* ── file classification ────────────────────────────────────── */

fn is_sv0(name: string) -> bool {
    let len: i32 = string_len(name);
    if len < 4 { return false; }
    let suffix: string = string_substr(name, len - 4, 4);
    return string_eq(suffix, ".sv0");
}

fn is_hidden(name: string) -> bool {
    let len: i32 = string_len(name);
    if len == 0 { return false; }
    let first: i32 = string_char_at(name, 0);
    return first == 46;
}

fn is_link_source_file(name: string) -> bool {
    if is_hidden(name) { return false; }
    return is_sv0(name);
}

/* Newline-separated full paths to .sv0 files under dir (recursive),
   sorted lexicographically — see sv0doc/compiler/bootstrap-host-io.md. */
fn list_sv0(dir: string) -> string {
    return read_dir(dir);
}

fn walk_sv0(dir: string) -> string {
    return read_dir(dir);
}

fn parse_file(path: string) -> string {
    return read_file(path);
}

fn listing_find_newline(listing: string, start: i32) -> i32 {
    let len: i32 = string_len(listing);
    let mut i: i32 = start;
    while i < len {
        if string_char_at(listing, i) == 10 { return i; }
        i = i + 1;
    }
    return len;
}

fn link_project_concat_sources_from_listing(listing: string) -> string {
    let len: i32 = string_len(listing);
    let mut p: i32 = 0;
    let mut out: string = "";
    let mut first: bool = true;
    while p < len {
        let nl: i32 = listing_find_newline(listing, p);
        let lsz: i32 = nl - p;
        if lsz > 0 {
            let path: string = string_substr(listing, p, lsz);
            let src: string = parse_file(path);
            if first {
                out = src;
                first = false;
            } else {
                out = string_concat(out, "\n");
                out = string_concat(out, src);
            }
        }
        p = nl + 1;
    }
    return out;
}

/* Count non-empty lines in a read_dir / list_sv0 listing (newline-separated paths). */

fn listing_count_nonempty_paths(listing: string) -> i32 {
    let len: i32 = string_len(listing);
    let mut p: i32 = 0;
    let mut n: i32 = 0;
    while p < len {
        let nl: i32 = listing_find_newline(listing, p);
        let lsz: i32 = nl - p;
        if lsz > 0 { n = n + 1; }
        p = nl + 1;
    }
    return n;
}

/* SML linkProjectDir: listSv0(dir) then per-path parseFile — source-level bridge
   uses host read_dir ordering (see sv0doc/compiler/bootstrap-host-io.md) +
   link_project_concat_sources_from_listing. AST mapProgramUnit remains in parser. */

fn link_project_concat_sources_from_dir(dir: string) -> string {
    let listing: string = link_project_dir(dir);
    return link_project_concat_sources_from_listing(listing);
}

/* SML Link.linkDirectory(entryPath): OS.Path.dir entryPath (or ".") then
   linkProjectDir. Listing / concat bridges use the same dir extraction.
   Do not call from VM unit tests: link_project_dir invokes read_dir (host). */

fn link_project_listing_from_entry(entry_path: string) -> string {
    let dir: string = link_dir_from_entry(entry_path);
    return link_project_dir(dir);
}

fn link_project_concat_sources_from_entry(entry_path: string) -> string {
    let dir: string = link_dir_from_entry(entry_path);
    return link_project_concat_sources_from_dir(dir);
}

fn link_project_dir(dir: string) -> string {
    return list_sv0(dir);
}

/* ── G6 (M3-S-039 / M3-S-040): empty-project guard (SML linkProjectDir E0321) ─
   Full recursive mapTy/mapExpr/mapItem on parser arenas remains deferred; see
   sv0c/sml/link/link.sml and milestone ## M3 G6 slice status. */

fn LINK_ERR_NO_SV0_IN_DIR() -> i32 {
    return 321;
}

fn link_listing_nonempty(listing: string) -> bool {
    return string_len(listing) > 0;
}

fn link_project_guard_nonempty(dir: string) -> i32 {
    let listing: string = link_project_dir(dir);
    if link_listing_nonempty(listing) != true {
        return LINK_ERR_NO_SV0_IN_DIR();
    }
    return 0;
}

/* ── name extraction ────────────────────────────────────────── */

fn find_last_slash(path: string) -> i32 {
    let len: i32 = string_len(path);
    let mut i: i32 = len - 1;
    while i >= 0 {
        let c: i32 = string_char_at(path, i);
        if c == 47 { return i; }
        if c == 92 { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

fn find_last_dot(s: string, start: i32) -> i32 {
    let len: i32 = string_len(s);
    let mut i: i32 = len - 1;
    while i >= start {
        let c: i32 = string_char_at(s, i);
        if c == 46 { return i; }
        i = i - 1;
    }
    return 0 - 1;
}

fn file_stem(path: string) -> string {
    let len: i32 = string_len(path);
    let slash: i32 = find_last_slash(path);
    let base_start: i32 = slash + 1;
    let dot: i32 = find_last_dot(path, base_start);
    if dot <= base_start {
        return string_substr(path, base_start, len - base_start);
    }
    return string_substr(path, base_start, dot - base_start);
}

/* ── name mangling ──────────────────────────────────────────── */

fn mangle(mod_id: string, x: string) -> string {
    let a: string = string_concat(mod_id, "__");
    return string_concat(a, x);
}

fn fn_name_for_link(mod_id: string, name: string) -> string {
    if string_eq(name, "main") { return "main"; }
    return mangle(mod_id, name);
}

fn link_dir_from_entry(entry_path: string) -> string {
    let slash: i32 = find_last_slash(entry_path);
    if slash < 0 { return "."; }
    if slash == 0 { return "/"; }
    return string_substr(entry_path, 0, slash);
}

fn module_id_from_entry_path(entry_path: string) -> string {
    return file_stem(entry_path);
}

/* ── top-level name collection ──────────────────────────────── */

/* Item tags from ast.sv0: 0=ItemFn, 1=ItemStruct, 2=ItemEnum,
   3=ItemTrait, 4=ItemImpl, 5=ItemUse, 6=ItemModule, 7=ItemTypeAlias.
   collectTops collects names from ItemFn, ItemStruct, ItemEnum,
   ItemTrait, ItemTypeAlias — tags 0,1,2,3,7. */
fn is_top_defining(tag: i32) -> bool {
    if tag == 0 { return true; }
    if tag == 1 { return true; }
    if tag == 2 { return true; }
    if tag == 3 { return true; }
    if tag == 7 { return true; }
    return false;
}

fn collect_tops_count(item_tags: Vec<i32>) -> i32 {
    let len: i32 = vec_len(item_tags);
    let mut count: i32 = 0;
    let mut i: i32 = 0;
    while i < len {
        let tag: i32 = vec_get(item_tags, i);
        if is_top_defining(tag) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

/* SML collectTops: builds a list of name handles for top-defining items.
   item_tags and item_names are parallel Vecs of the same length. */
fn collect_top_names(item_tags: Vec<i32>, item_names: Vec<i32>,
                     out: Vec<i32>) -> i32 {
    let len: i32 = vec_len(item_tags);
    let mut count: i32 = 0;
    let mut i: i32 = 0;
    while i < len {
        if is_top_defining(vec_get(item_tags, i)) {
            vec_push(out, vec_get(item_names, i));
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

/* ── link directive stripping ───────────────────────────────── */

/* stripLinkDirectives removes ItemUse (5) and ItemModule (6). */
fn is_link_directive(tag: i32) -> bool {
    if tag == 5 { return true; }
    if tag == 6 { return true; }
    return false;
}

fn strip_directives_count(item_tags: Vec<i32>) -> i32 {
    let len: i32 = vec_len(item_tags);
    let mut count: i32 = 0;
    let mut i: i32 = 0;
    while i < len {
        let tag: i32 = vec_get(item_tags, i);
        if is_link_directive(tag) != true { count = count + 1; }
        i = i + 1;
    }
    return count;
}

/* ── split module ───────────────────────────────────────────── */

fn has_module_prefix(first_tag: i32) -> bool {
    return first_tag == 6;
}

fn split_module_inner_count(total_items: i32, has_wrapper: bool) -> i32 {
    if has_wrapper { return total_items - 1; }
    return total_items;
}

/* ── type rewrite classification (mapTy dispatch) ────────────── */

fn map_ty_kind(ty_tag: i32) -> i32 {
    if ty_tag == 0 { return 1; }
    if ty_tag == 1 { return 2; }
    if ty_tag == 2 { return 2; }
    if ty_tag == 3 { return 2; }
    if ty_tag == 4 { return 2; }
    if ty_tag == 5 { return 3; }
    if ty_tag == 6 { return 0; }
    if ty_tag == 7 { return 0; }
    return 0;
}

fn needs_path_rewrite(ty_tag: i32) -> bool {
    return map_ty_kind(ty_tag) == 1;
}

fn needs_recursive_rewrite(ty_tag: i32) -> bool {
    return map_ty_kind(ty_tag) == 2;
}

fn needs_list_rewrite(ty_tag: i32) -> bool {
    return map_ty_kind(ty_tag) == 3;
}

fn is_leaf_ty(ty_tag: i32) -> bool {
    return map_ty_kind(ty_tag) == 0;
}

fn rewrite_depth(ty_tag: i32, child_depth: i32) -> i32 {
    if is_leaf_ty(ty_tag) { return 0; }
    return 1 + child_depth;
}

/* ── item rewrite classification (mapItem dispatch) ──────────── */

fn item_needs_rewrite(item_kind: i32) -> bool {
    if item_kind == 0 { return true; }
    if item_kind == 3 { return true; }
    if item_kind == 4 { return true; }
    if item_kind == 5 { return true; }
    if item_kind == 6 { return true; }
    return false;
}

fn item_has_body(item_kind: i32) -> bool {
    if item_kind == 0 { return true; }
    if item_kind == 5 { return true; }
    if item_kind == 6 { return true; }
    return false;
}

fn item_has_fields(item_kind: i32) -> bool {
    if item_kind == 3 { return true; }
    if item_kind == 4 { return true; }
    return false;
}

fn map_fn_components(has_params: bool, has_body: bool, has_contracts: bool) -> i32 {
    let mut parts: i32 = 1;
    if has_params { parts = parts + 1; }
    if has_body { parts = parts + 1; }
    if has_contracts { parts = parts + 1; }
    return parts;
}

/* ── in-tops membership (Vec-based) ─────────────────────────── */

fn in_tops(tops: Vec<i32>, name: i32) -> bool {
    let len: i32 = vec_len(tops);
    let mut i: i32 = 0;
    while i < len {
        let t: i32 = vec_get(tops, i);
        if t == name { return true; }
        i = i + 1;
    }
    return false;
}

/* map_path_seg: if name handle is in tops, mangle it with mod_id
   string. Returns the original or mangled name handle. Since we
   can only return i32 and mangled names need string operations, this
   surrogate returns 1 (rewritten) or 0 (unchanged) as a flag. */
fn path_seg_needs_mangle(tops: Vec<i32>, name: i32) -> bool {
    return in_tops(tops, name);
}

/* ── map_path_segs (SML mapPathSegs) ───────────────────────── */

fn map_path_segs_needs_mangle(tops: Vec<i32>, seg_count: i32,
                              first_seg: i32) -> bool {
    if seg_count == 1 { return in_tops(tops, first_seg); }
    if seg_count == 2 { return in_tops(tops, first_seg); }
    return false;
}

fn map_path_segs_mangle_first(mod_id: string, first_seg_str: string) -> string {
    return mangle(mod_id, first_seg_str);
}

/* SML mapPathSegs composition: for a 1-segment path, if in tops
   the result is [mangle(mod_id, seg)]; for 2-segment, [mangle(mod_id, seg0), seg1].
   map_path_segs_rewrite_1 returns mangled string for a 1-seg path. */
fn map_path_segs_rewrite_1(tops: Vec<i32>, mod_id: string,
                           seg_handle: i32, seg_str: string) -> string {
    if in_tops(tops, seg_handle) {
        return mangle(mod_id, seg_str);
    }
    return seg_str;
}

/* map_path_segs_rewrite_2 returns mangled first segment for a 2-seg path.
   Second segment is unchanged; caller keeps it. */
fn map_path_segs_rewrite_2(tops: Vec<i32>, mod_id: string,
                           first_handle: i32, first_str: string) -> string {
    if in_tops(tops, first_handle) {
        return mangle(mod_id, first_str);
    }
    return first_str;
}

/* ── mapPathSegs predicate on path pool (TyName + ExprPath share encoding) ─ */

fn link_path_pool_prefix_needs_mangle(pp: Vec<i32>, tops: Vec<i32>,
                                      pool_start: i32,
                                      seg_count: i32) -> bool {
    if seg_count == 1 {
        let ft: i32 = vec_get(pp, pool_start);
        return map_path_segs_needs_mangle(tops, 1, ft);
    }
    if seg_count == 2 {
        let ft2: i32 = vec_get(pp, pool_start);
        return map_path_segs_needs_mangle(tops, 2, ft2);
    }
    return false;
}

/* ── mapTy TyName slice (M3-S-039): path rewrite predicate on ty arena ─────
   SML mapTy recurses through TyRef/TyTuple/…; generic TyName args need extra
   metadata to walk in the flat arena — track in transliteration-plan. This
   helper covers TyName path segments only (mapPathSegs composition). */

fn link_ty_tyname_path_needs_mangle(ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                                    ty_d2: Vec<i32>, pp: Vec<i32>,
                                    tops: Vec<i32>, idx: i32) -> bool {
    if idx < 0 { return false; }
    if vec_get(ty_tags, idx) != 0 { return false; }
    let ps: i32 = vec_get(ty_d1, idx);
    let sc: i32 = vec_get(ty_d2, idx);
    return link_path_pool_prefix_needs_mangle(pp, tops, ps, sc);
}

/* ExprPath (parser expr tag 1): same pp_start / pp_count as mapExpr ExprPath. */

fn link_expr_path_needs_mangle(expr_tags: Vec<i32>, ed1: Vec<i32>,
                               ed2: Vec<i32>, pp: Vec<i32>,
                               tops: Vec<i32>, idx: i32) -> bool {
    if idx < 0 { return false; }
    if vec_get(expr_tags, idx) != 1 { return false; }
    let ps2: i32 = vec_get(ed1, idx);
    let sc2: i32 = vec_get(ed2, idx);
    return link_path_pool_prefix_needs_mangle(pp, tops, ps2, sc2);
}

/* Post-order expr subtree size at root idx (parser expr arena — children
   precede parents). */

fn link_expr_subtree_node_count(expr_tags: Vec<i32>, ed1: Vec<i32>,
                                ed2: Vec<i32>, ed3: Vec<i32>, ed4: Vec<i32>,
                                idx: i32, depth: i32) -> i32 {
    if idx < 0 { return 0 - 1; }
    if depth > 96 { return 0 - 1; }
    let tag: i32 = vec_get(expr_tags, idx);
    if tag == 0 { return 1; }
    if tag == 1 { return 1; }
    if tag == 2 {
        let op: i32 = vec_get(ed2, idx);
        let sc: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, op, depth + 1);
        if sc <= 0 { return 0 - 1; }
        return 1 + sc;
    }
    if tag == 3 {
        let lhs: i32 = vec_get(ed2, idx);
        let rhs: i32 = vec_get(ed3, idx);
        let sl: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, lhs, depth + 1);
        if sl <= 0 { return 0 - 1; }
        let sr: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, rhs, depth + 1);
        if sr <= 0 { return 0 - 1; }
        return 1 + sl + sr;
    }
    if tag == 4 {
        let ce: i32 = vec_get(ed1, idx);
        let span: i32 = vec_get(ed3, idx);
        let sc: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, ce, depth + 1);
        if sc <= 0 { return 0 - 1; }
        return 1 + sc + span;
    }
    if tag == 5 {
        let rcv: i32 = vec_get(ed1, idx);
        let spanm: i32 = vec_get(ed4, idx);
        let sr: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, rcv, depth + 1);
        if sr <= 0 { return 0 - 1; }
        return 1 + sr + spanm;
    }
    if tag == 6 {
        let ob: i32 = vec_get(ed1, idx);
        let sc: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, ob, depth + 1);
        if sc <= 0 { return 0 - 1; }
        return 1 + sc;
    }
    if tag == 7 {
        let ob7: i32 = vec_get(ed1, idx);
        let sc7: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                     ed4, ob7, depth + 1);
        if sc7 <= 0 { return 0 - 1; }
        return 1 + sc7;
    }
    if tag == 8 {
        let o8: i32 = vec_get(ed1, idx);
        let i8: i32 = vec_get(ed2, idx);
        let so: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, o8, depth + 1);
        if so <= 0 { return 0 - 1; }
        let si: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, i8, depth + 1);
        if si <= 0 { return 0 - 1; }
        return 1 + so + si;
    }
    if tag == 9 {
        let sf: i32 = vec_get(ed1, idx);
        let scnt: i32 = vec_get(ed2, idx);
        let tail: i32 = vec_get(ed3, idx);
        let mut sum9: i32 = 1;
        let mut lo9: i32 = sf;
        let mut si9: i32 = 0;
        while si9 < scnt {
            let sr9: i32 = link_expr_find_root_covering_min(expr_tags, ed1, ed2,
                ed3, ed4, lo9, idx);
            if sr9 < 0 { return 0 - 1; }
            let sc9: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, sr9, depth + 1);
            if sc9 <= 0 { return 0 - 1; }
            sum9 = sum9 + sc9;
            lo9 = sr9 + 1;
            si9 = si9 + 1;
        }
        if tail >= 0 {
            let st9: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, tail, depth + 1);
            if st9 <= 0 { return 0 - 1; }
            sum9 = sum9 + st9;
        }
        return sum9;
    }
    if tag == 10 {
        let cond: i32 = vec_get(ed1, idx);
        let th: i32 = vec_get(ed2, idx);
        let el: i32 = vec_get(ed3, idx);
        let sc: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, cond, depth + 1);
        if sc <= 0 { return 0 - 1; }
        let st: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, th, depth + 1);
        if st <= 0 { return 0 - 1; }
        let mut sum10: i32 = 1 + sc + st;
        if el >= 0 {
            let se: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, el, depth + 1);
            if se <= 0 { return 0 - 1; }
            sum10 = sum10 + se;
        }
        return sum10;
    }
    if tag == 11 {
        let scr: i32 = vec_get(ed1, idx);
        let af: i32 = vec_get(ed2, idx);
        let ac: i32 = vec_get(ed3, idx);
        let ss: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, scr, depth + 1);
        if ss <= 0 { return 0 - 1; }
        let mut sum11: i32 = 1 + ss;
        let mut lo11: i32 = af;
        let mut ai11: i32 = 0;
        while ai11 < ac {
            let ar11: i32 = link_expr_find_root_covering_min(expr_tags, ed1, ed2,
                ed3, ed4, lo11, idx);
            if ar11 < 0 { return 0 - 1; }
            let sa11: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, ar11, depth + 1);
            if sa11 <= 0 { return 0 - 1; }
            sum11 = sum11 + sa11;
            lo11 = ar11 + 1;
            ai11 = ai11 + 1;
        }
        return sum11;
    }
    if tag == 12 {
        let cond12: i32 = vec_get(ed1, idx);
        let body12: i32 = vec_get(ed2, idx);
        let invf: i32 = vec_get(ed3, idx);
        let invc: i32 = vec_get(ed4, idx);
        let sc12: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, cond12, depth + 1);
        if sc12 <= 0 { return 0 - 1; }
        let sb12: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, body12, depth + 1);
        if sb12 <= 0 { return 0 - 1; }
        let mut sum12: i32 = 1 + sc12 + sb12;
        if invf >= 0 {
            let mut lo12: i32 = invf;
            let mut ii12: i32 = 0;
            while ii12 < invc {
                let ir12: i32 = link_expr_find_root_covering_min(expr_tags, ed1,
                    ed2, ed3, ed4, lo12, idx);
                if ir12 < 0 { return 0 - 1; }
                let si12: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                    ed3, ed4, ir12, depth + 1);
                if si12 <= 0 { return 0 - 1; }
                sum12 = sum12 + si12;
                lo12 = ir12 + 1;
                ii12 = ii12 + 1;
            }
        }
        return sum12;
    }
    if tag == 13 {
        let iter13: i32 = vec_get(ed2, idx);
        let body13: i32 = vec_get(ed3, idx);
        let si13: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, iter13, depth + 1);
        if si13 <= 0 { return 0 - 1; }
        let sb13: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, body13, depth + 1);
        if sb13 <= 0 { return 0 - 1; }
        return 1 + si13 + sb13;
    }
    if tag == 14 {
        let bd: i32 = vec_get(ed1, idx);
        let sb: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, bd, depth + 1);
        if sb <= 0 { return 0 - 1; }
        return 1 + sb;
    }
    if tag == 15 {
        let vi: i32 = vec_get(ed1, idx);
        if vi < 0 { return 1; }
        let sv: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, vi, depth + 1);
        if sv <= 0 { return 0 - 1; }
        return 1 + sv;
    }
    if tag == 16 {
        let vb: i32 = vec_get(ed1, idx);
        if vb < 0 { return 1; }
        let sb: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, vb, depth + 1);
        if sb <= 0 { return 0 - 1; }
        return 1 + sb;
    }
    if tag == 17 { return 1; }
    if tag == 27 {
        let init27: i32 = vec_get(ed3, idx);
        if init27 < 0 { return 1; }
        let si27: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, init27, depth + 1);
        if si27 <= 0 { return 0 - 1; }
        return 1 + si27;
    }
    if tag == 28 {
        let se28: i32 = vec_get(ed1, idx);
        let ss28: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, se28, depth + 1);
        if ss28 <= 0 { return 0 - 1; }
        return 1 + ss28;
    }
    if tag == 29 {
        let gd29: i32 = vec_get(ed3, idx);
        let bd29: i32 = vec_get(ed4, idx);
        let sb29: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, bd29, depth + 1);
        if sb29 <= 0 { return 0 - 1; }
        if gd29 < 0 { return 1 + sb29; }
        let sg29: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
            ed4, gd29, depth + 1);
        if sg29 <= 0 { return 0 - 1; }
        return 1 + sb29 + sg29;
    }
    if tag == 30 { return 1; }
    if tag == 31 { return 1; }
    if tag == 32 { return 1; }
    if tag == 33 { return 1; }
    if tag == 18 {
        let al: i32 = vec_get(ed1, idx);
        let ar: i32 = vec_get(ed2, idx);
        let sl: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, al, depth + 1);
        if sl <= 0 { return 0 - 1; }
        let sr: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, ar, depth + 1);
        if sr <= 0 { return 0 - 1; }
        return 1 + sl + sr;
    }
    if tag == 19 {
        let al2: i32 = vec_get(ed2, idx);
        let ar2: i32 = vec_get(ed3, idx);
        let sl2: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                     ed4, al2, depth + 1);
        if sl2 <= 0 { return 0 - 1; }
        let sr2: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                     ed4, ar2, depth + 1);
        if sr2 <= 0 { return 0 - 1; }
        return 1 + sl2 + sr2;
    }
    if tag == 20 {
        let cs: i32 = vec_get(ed1, idx);
        let ss: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, cs, depth + 1);
        if ss <= 0 { return 0 - 1; }
        return 1 + ss;
    }
    if tag == 21 {
        let slo: i32 = vec_get(ed1, idx);
        let shi: i32 = vec_get(ed2, idx);
        let mut sum: i32 = 1;
        if slo >= 0 {
            let sl: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, slo, depth + 1);
            if sl <= 0 { return 0 - 1; }
            sum = sum + sl;
        }
        if shi >= 0 {
            let sr: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, shi, depth + 1);
            if sr <= 0 { return 0 - 1; }
            sum = sum + sr;
        }
        return sum;
    }
    if tag == 22 {
        let te: i32 = vec_get(ed1, idx);
        let st: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, te, depth + 1);
        if st <= 0 { return 0 - 1; }
        return 1 + st;
    }
    if tag == 23 {
        let ae: i32 = vec_get(ed1, idx);
        let sa: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                    ed4, ae, depth + 1);
        if sa <= 0 { return 0 - 1; }
        return 1 + sa;
    }
    if tag == 24 {
        let fc: i32 = vec_get(ed3, idx);
        if fc <= 0 { return 1; }
        let mut sumf: i32 = 1;
        let mut fi: i32 = 0;
        while fi < fc {
            let fr: i32 = idx - fc + fi;
            let sf: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, fr, depth + 1);
            if sf <= 0 { return 0 - 1; }
            sumf = sumf + sf;
            fi = fi + 1;
        }
        return sumf;
    }
    if tag == 25 {
        let first: i32 = vec_get(ed1, idx);
        let cnt: i32 = vec_get(ed2, idx);
        let mut cur: i32 = first;
        let mut sumt: i32 = 1;
        let mut j: i32 = 0;
        while j < cnt {
            let se: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, cur, depth + 1);
            if se <= 0 { return 0 - 1; }
            sumt = sumt + se;
            cur = cur + se;
            j = j + 1;
        }
        return sumt;
    }
    if tag == 26 {
        let ec: i32 = vec_get(ed2, idx);
        let mut suma: i32 = 1;
        let mut k: i32 = 0;
        while k < ec {
            let er: i32 = idx - ec + k;
            let se: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, er, depth + 1);
            if se <= 0 { return 0 - 1; }
            suma = suma + se;
            k = k + 1;
        }
        return suma;
    }
    return 0 - 1;
}

fn link_expr_find_root_covering_min(expr_tags: Vec<i32>, ed1: Vec<i32>,
                                    ed2: Vec<i32>, ed3: Vec<i32>, ed4: Vec<i32>,
                                    lo: i32, hi_excl: i32) -> i32 {
    let mut r: i32 = lo;
    while r < hi_excl {
        let c: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2, ed3,
                                                   ed4, r, 0);
        if c > 0 {
            let min_i: i32 = r - c + 1;
            if min_i <= lo { return r; }
        }
        r = r + 1;
    }
    return 0 - 1;
}

fn link_expr_root_needs_mangle(expr_tags: Vec<i32>, ed1: Vec<i32>,
                               ed2: Vec<i32>, ed3: Vec<i32>, ed4: Vec<i32>,
                               pp: Vec<i32>,
                               ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                               ty_d2: Vec<i32>, ty_d3: Vec<i32>,
                               tops: Vec<i32>, idx: i32, depth: i32) -> bool {
    if idx < 0 { return false; }
    if depth > 96 { return false; }
    let tag: i32 = vec_get(expr_tags, idx);
    if tag == 1 {
        return link_expr_path_needs_mangle(expr_tags, ed1, ed2, pp, tops,
                                           idx);
    }
    if tag == 2 {
        let op: i32 = vec_get(ed2, idx);
        return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
            pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, op, depth + 1);
    }
    if tag == 3 {
        let lhs: i32 = vec_get(ed2, idx);
        let rhs: i32 = vec_get(ed3, idx);
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, lhs, depth + 1) == true {
            return true;
        }
        return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
            pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, rhs, depth + 1);
    }
    if tag == 4 {
        let ce: i32 = vec_get(ed1, idx);
        let af: i32 = vec_get(ed2, idx);
        let span: i32 = vec_get(ed3, idx);
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, ce, depth + 1) == true {
            return true;
        }
        let hi: i32 = af + span;
        let mut lo: i32 = af;
        while lo < hi {
            let ar: i32 = link_expr_find_root_covering_min(expr_tags, ed1, ed2,
                ed3, ed4, lo, hi);
            if ar < 0 { return false; }
            let ac: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, ar, 0);
            if ac <= 0 { return false; }
            if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                    pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, ar, depth + 1) ==
                    true {
                return true;
            }
            lo = ar + 1;
        }
        return false;
    }
    if tag == 5 {
        let rcv: i32 = vec_get(ed1, idx);
        let afm: i32 = vec_get(ed3, idx);
        let acm: i32 = vec_get(ed4, idx);
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, rcv, depth + 1) == true {
            return true;
        }
        let hi5: i32 = afm + acm;
        let mut lo5: i32 = afm;
        while lo5 < hi5 {
            let ar5: i32 = link_expr_find_root_covering_min(expr_tags, ed1,
                ed2, ed3, ed4, lo5, hi5);
            if ar5 < 0 { return false; }
            let ac5: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, ar5, 0);
            if ac5 <= 0 { return false; }
            if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                    pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, ar5, depth + 1) ==
                    true {
                return true;
            }
            lo5 = ar5 + 1;
        }
        return false;
    }
    if tag == 6 {
        let ob: i32 = vec_get(ed1, idx);
        return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
            pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, ob, depth + 1);
    }
    if tag == 7 {
        let ob7: i32 = vec_get(ed1, idx);
        return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
            pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, ob7, depth + 1);
    }
    if tag == 8 {
        let o8: i32 = vec_get(ed1, idx);
        let i8: i32 = vec_get(ed2, idx);
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, o8, depth + 1) == true {
            return true;
        }
        return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
            pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, i8, depth + 1);
    }
    if tag == 9 {
        let sf9: i32 = vec_get(ed1, idx);
        let sc9: i32 = vec_get(ed2, idx);
        let tail9: i32 = vec_get(ed3, idx);
        let mut lo9: i32 = sf9;
        let mut si9: i32 = 0;
        while si9 < sc9 {
            let sr9: i32 = link_expr_find_root_covering_min(expr_tags, ed1, ed2,
                ed3, ed4, lo9, idx);
            if sr9 < 0 { return false; }
            if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
                    ty_tags, ty_d1, ty_d2, ty_d3, tops, sr9, depth + 1) == true {
                return true;
            }
            lo9 = sr9 + 1;
            si9 = si9 + 1;
        }
        if tail9 >= 0 {
            return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, tail9, depth + 1);
        }
        return false;
    }
    if tag == 10 {
        let c10: i32 = vec_get(ed1, idx);
        let t10: i32 = vec_get(ed2, idx);
        let e10: i32 = vec_get(ed3, idx);
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
                ty_tags, ty_d1, ty_d2, ty_d3, tops, c10, depth + 1) == true {
            return true;
        }
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
                ty_tags, ty_d1, ty_d2, ty_d3, tops, t10, depth + 1) == true {
            return true;
        }
        if e10 >= 0 {
            return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, e10, depth + 1);
        }
        return false;
    }
    if tag == 11 {
        let scr11: i32 = vec_get(ed1, idx);
        let af11: i32 = vec_get(ed2, idx);
        let ac11: i32 = vec_get(ed3, idx);
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
                ty_tags, ty_d1, ty_d2, ty_d3, tops, scr11, depth + 1) == true {
            return true;
        }
        let mut lo11: i32 = af11;
        let mut ai11: i32 = 0;
        while ai11 < ac11 {
            let ar11: i32 = link_expr_find_root_covering_min(expr_tags, ed1, ed2,
                ed3, ed4, lo11, idx);
            if ar11 < 0 { return false; }
            if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
                    ty_tags, ty_d1, ty_d2, ty_d3, tops, ar11, depth + 1) == true {
                return true;
            }
            lo11 = ar11 + 1;
            ai11 = ai11 + 1;
        }
        return false;
    }
    if tag == 12 {
        let c12: i32 = vec_get(ed1, idx);
        let b12: i32 = vec_get(ed2, idx);
        let invf12: i32 = vec_get(ed3, idx);
        let invc12: i32 = vec_get(ed4, idx);
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
                ty_tags, ty_d1, ty_d2, ty_d3, tops, c12, depth + 1) == true {
            return true;
        }
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
                ty_tags, ty_d1, ty_d2, ty_d3, tops, b12, depth + 1) == true {
            return true;
        }
        if invf12 >= 0 {
            let mut lo12: i32 = invf12;
            let mut ii12: i32 = 0;
            while ii12 < invc12 {
                let ir12: i32 = link_expr_find_root_covering_min(expr_tags, ed1,
                    ed2, ed3, ed4, lo12, idx);
                if ir12 < 0 { return false; }
                if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                        pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, ir12, depth + 1)
                        == true {
                    return true;
                }
                lo12 = ir12 + 1;
                ii12 = ii12 + 1;
            }
        }
        return false;
    }
    if tag == 13 {
        let it13: i32 = vec_get(ed2, idx);
        let bd13: i32 = vec_get(ed3, idx);
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
                ty_tags, ty_d1, ty_d2, ty_d3, tops, it13, depth + 1) == true {
            return true;
        }
        return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
            ty_tags, ty_d1, ty_d2, ty_d3, tops, bd13, depth + 1);
    }
    if tag == 20 {
        let cs: i32 = vec_get(ed1, idx);
        let tyi: i32 = vec_get(ed2, idx);
        if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, cs, depth + 1) == true {
            return true;
        }
        if vec_len(ty_tags) > tyi && tyi >= 0 {
            if link_ty_after_ref_slice_chain_tyname_needs_mangle(ty_tags,
                    ty_d1, ty_d2, ty_d3, pp, tops, tyi) == true {
                return true;
            }
        }
        return false;
    }
    if tag == 27 {
        let init27: i32 = vec_get(ed3, idx);
        if init27 < 0 { return false; }
        return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
            ty_tags, ty_d1, ty_d2, ty_d3, tops, init27, depth + 1);
    }
    if tag == 28 {
        let s28: i32 = vec_get(ed1, idx);
        return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
            ty_tags, ty_d1, ty_d2, ty_d3, tops, s28, depth + 1);
    }
    if tag == 29 {
        let g29: i32 = vec_get(ed3, idx);
        let b29: i32 = vec_get(ed4, idx);
        if g29 >= 0 {
            if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
                    ty_tags, ty_d1, ty_d2, ty_d3, tops, g29, depth + 1) == true {
                return true;
            }
        }
        return link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4, pp,
            ty_tags, ty_d1, ty_d2, ty_d3, tops, b29, depth + 1);
    }
    if tag == 24 {
        let fc: i32 = vec_get(ed3, idx);
        let mut fi: i32 = 0;
        while fi < fc {
            let fr: i32 = idx - fc + fi;
            if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                    pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, fr, depth + 1) ==
                    true {
                return true;
            }
            fi = fi + 1;
        }
        return false;
    }
    if tag == 25 {
        let first: i32 = vec_get(ed1, idx);
        let cnt: i32 = vec_get(ed2, idx);
        let mut cur: i32 = first;
        let mut j: i32 = 0;
        while j < cnt {
            if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                    pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, cur, depth + 1) ==
                    true {
                return true;
            }
            let sc: i32 = link_expr_subtree_node_count(expr_tags, ed1, ed2,
                ed3, ed4, cur, 0);
            if sc <= 0 { return false; }
            cur = cur + sc;
            j = j + 1;
        }
        return false;
    }
    if tag == 26 {
        let ec: i32 = vec_get(ed2, idx);
        let mut k: i32 = 0;
        while k < ec {
            let er: i32 = idx - ec + k;
            if link_expr_root_needs_mangle(expr_tags, ed1, ed2, ed3, ed4,
                    pp, ty_tags, ty_d1, ty_d2, ty_d3, tops, er, depth + 1) ==
                    true {
                return true;
            }
            k = k + 1;
        }
        return false;
    }
    return false;
}

/* Post-order node count for one type subtree (parser parse_type arena).
   Used to advance tuple element roots (forward) and generic arg roots
   (backward from TyName). Returns -1 if depth exceeded or malformed idx. */

fn link_ty_subtree_node_count(ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                              ty_d2: Vec<i32>, ty_d3: Vec<i32>,
                              idx: i32, depth: i32) -> i32 {
    if idx < 0 { return 0 - 1; }
    if depth > 64 { return 0 - 1; }
    let t: i32 = vec_get(ty_tags, idx);
    if t == 6 { return 1; }
    if t == 0 {
        let nargs: i32 = vec_get(ty_d3, idx);
        if nargs == 0 { return 1; }
        let mut pos: i32 = idx - 1;
        let mut sum: i32 = 1;
        let mut i: i32 = 0;
        while i < nargs {
            if pos < 0 { return 0 - 1; }
            let sc: i32 = link_ty_subtree_node_count(ty_tags, ty_d1, ty_d2,
                                                      ty_d3, pos, depth + 1);
            if sc <= 0 { return 0 - 1; }
            sum = sum + sc;
            pos = pos - sc;
            i = i + 1;
        }
        return sum;
    }
    if t == 1 {
        let inn: i32 = vec_get(ty_d1, idx);
        let sc: i32 = link_ty_subtree_node_count(ty_tags, ty_d1, ty_d2,
                                                  ty_d3, inn, depth + 1);
        if sc <= 0 { return 0 - 1; }
        return 1 + sc;
    }
    if t == 2 {
        let inn2: i32 = vec_get(ty_d1, idx);
        let sc2: i32 = link_ty_subtree_node_count(ty_tags, ty_d1, ty_d2,
                                                   ty_d3, inn2, depth + 1);
        if sc2 <= 0 { return 0 - 1; }
        return 1 + sc2;
    }
    if t == 3 {
        let el: i32 = vec_get(ty_d1, idx);
        let sc3: i32 = link_ty_subtree_node_count(ty_tags, ty_d1, ty_d2,
                                                   ty_d3, el, depth + 1);
        if sc3 <= 0 { return 0 - 1; }
        return 1 + sc3;
    }
    if t == 4 {
        let sl: i32 = vec_get(ty_d1, idx);
        let sc4: i32 = link_ty_subtree_node_count(ty_tags, ty_d1, ty_d2,
                                                   ty_d3, sl, depth + 1);
        if sc4 <= 0 { return 0 - 1; }
        return 1 + sc4;
    }
    if t == 5 {
        let first: i32 = vec_get(ty_d1, idx);
        let cnt: i32 = vec_get(ty_d2, idx);
        let mut cur: i32 = first;
        let mut sumt: i32 = 1;
        let mut j: i32 = 0;
        while j < cnt {
            let sce: i32 = link_ty_subtree_node_count(ty_tags, ty_d1, ty_d2,
                                                       ty_d3, cur, depth + 1);
            if sce <= 0 { return 0 - 1; }
            sumt = sumt + sce;
            cur = cur + sce;
            j = j + 1;
        }
        return sumt;
    }
    return 0 - 1;
}

/* Peel TyRef (1) / TyRefMut (2) / TySlice (4) per SML mapTy — bounded depth. */

fn link_ty_peel_ref_mut_slice(ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                              idx: i32) -> i32 {
    let mut cur: i32 = idx;
    let mut guard: i32 = 0;
    while guard < 64 {
        let tg: i32 = vec_get(ty_tags, cur);
        if tg == 1 {
            cur = vec_get(ty_d1, cur);
            guard = guard + 1;
        } else {
            if tg == 2 {
                cur = vec_get(ty_d1, cur);
                guard = guard + 1;
            } else {
                if tg == 4 {
                    cur = vec_get(ty_d1, cur);
                    guard = guard + 1;
                } else {
                    return cur;
                }
            }
        }
    }
    return cur;
}

fn link_ty_after_ref_slice_chain_tyname_needs_mangle(ty_tags: Vec<i32>,
                                                     ty_d1: Vec<i32>,
                                                     ty_d2: Vec<i32>,
                                                     ty_d3: Vec<i32>,
                                                     pp: Vec<i32>,
                                                     tops: Vec<i32>,
                                                     idx: i32) -> bool {
    let mut cur: i32 = idx;
    let mut arr_guard: i32 = 0;
    while arr_guard < 32 {
        let base: i32 = link_ty_peel_ref_mut_slice(ty_tags, ty_d1, cur);
        let bt: i32 = vec_get(ty_tags, base);
        if bt == 0 {
            if link_ty_tyname_path_needs_mangle(ty_tags, ty_d1, ty_d2, pp,
                                                 tops, base) == true {
                return true;
            }
            let nargs: i32 = vec_get(ty_d3, base);
            if nargs == 0 { return false; }
            let mut pos: i32 = base - 1;
            let mut ai: i32 = 0;
            while ai < nargs {
                if link_ty_after_ref_slice_chain_tyname_needs_mangle(ty_tags,
                    ty_d1, ty_d2, ty_d3, pp, tops, pos) == true {
                    return true;
                }
                let sc: i32 = link_ty_subtree_node_count(ty_tags, ty_d1, ty_d2,
                                                          ty_d3, pos, 0);
                if sc <= 0 { return false; }
                pos = pos - sc;
                ai = ai + 1;
            }
            return false;
        }
        if bt == 3 {
            cur = vec_get(ty_d1, base);
            arr_guard = arr_guard + 1;
        } else {
            if bt == 5 {
                let first: i32 = vec_get(ty_d1, base);
                let cnt: i32 = vec_get(ty_d2, base);
                let mut er: i32 = first;
                let mut ei: i32 = 0;
                while ei < cnt {
                    if link_ty_after_ref_slice_chain_tyname_needs_mangle(ty_tags,
                        ty_d1, ty_d2, ty_d3, pp, tops, er) == true {
                        return true;
                    }
                    let se: i32 = link_ty_subtree_node_count(ty_tags, ty_d1,
                        ty_d2, ty_d3, er, 0);
                    if se <= 0 { return false; }
                    er = er + se;
                    ei = ei + 1;
                }
                return false;
            }
            return false;
        }
    }
    return false;
}

/* ── strip_link_directives (SML stripLinkDirectives) ─────────
   Build a Vec of item indices that are NOT use/module directives.
   The caller can iterate the output to process only real items. */

fn strip_link_directives(item_tags: Vec<i32>,
                         out_indices: Vec<i32>) -> i32 {
    let len: i32 = vec_len(item_tags);
    let mut i: i32 = 0;
    while i < len {
        let tag: i32 = vec_get(item_tags, i);
        if is_link_directive(tag) != true {
            vec_push(out_indices, i);
        }
        i = i + 1;
    }
    return vec_len(out_indices);
}

/* ── split_module_name (SML splitModule) ─────────────────────
   If the first item is ItemModule (tag 6), extract the module
   name handle from the path pool and return it.  Otherwise
   return the default_name handle.  Also returns the index of
   the first non-module item (0 if no wrapper, 1 if present). */

fn split_module_name(item_tags: Vec<i32>, item_d1: Vec<i32>,
                     pp: Vec<i32>,
                     default_name: i32) -> i32 {
    if vec_len(item_tags) == 0 { return default_name; }
    let first: i32 = vec_get(item_tags, 0);
    if first == 6 {
        let pp_start: i32 = vec_get(item_d1, 0);
        return vec_get(pp, pp_start);
    }
    return default_name;
}

fn split_module_body_start(item_tags: Vec<i32>) -> i32 {
    if vec_len(item_tags) == 0 { return 0; }
    if vec_get(item_tags, 0) == 6 { return 1; }
    return 0;
}

