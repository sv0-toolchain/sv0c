    vec_push(tags, 2); vec_push(names, 30); vec_push(fcounts, 0);
    vec_push(tags, 1); vec_push(names, 40); vec_push(fcounts, 2);
    let out_n: Vec<i32> = vec_new();
    let out_fc: Vec<i32> = vec_new();
    let count: i32 = struct_layouts_build(tags, names, fcounts, out_n, out_fc);
    if count != 2 { return 1; }
    if vec_get(out_n, 0) != 20 { return 2; }
    if vec_get(out_fc, 0) != 3 { return 3; }
    if vec_get(out_n, 1) != 40 { return 4; }
    if vec_get(out_fc, 1) != 2 { return 5; }
    return 0;
}

