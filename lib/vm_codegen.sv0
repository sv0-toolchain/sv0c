fn test_emit_value() -> i32 {
    let en: Vec<i32> = vec_new();
    let eb: Vec<i32> = vec_new();
    let ew: Vec<i32> = vec_new();
    let pool: Vec<i32> = vec_new();
    let out: Vec<i32> = vec_new();
    let vi: Value = Value::VInt(42);
    let r1: i32 = emit_value(vi, en, eb, ew, pool, out);
    if r1 != 2 { return 1; }
    if vec_get(out, 0) != 4 { return 2; }
    if vec_get(out, 1) != 42 { return 3; }
    let out2: Vec<i32> = vec_new();
    let vb: Value = Value::VBool(true);
    let r2: i32 = emit_value(vb, en, eb, ew, pool, out2);
    if r2 != 2 { return 4; }
    if vec_get(out2, 0) != 7 { return 5; }
    if vec_get(out2, 1) != 1 { return 6; }
    let out3: Vec<i32> = vec_new();
    let vbf: Value = Value::VBool(false);
    let r2b: i32 = emit_value(vbf, en, eb, ew, pool, out3);
    if r2b != 2 { return 7; }
    if vec_get(out3, 1) != 0 { return 8; }
    let out4: Vec<i32> = vec_new();
    let vu: Value = Value::VUnit;
    let r3: i32 = emit_value(vu, en, eb, ew, pool, out4);
    if r3 != 1 { return 9; }
    if vec_get(out4, 0) != 3 { return 10; }
    let out5: Vec<i32> = vec_new();
    let vs: Value = Value::VString(99);
    let r4: i32 = emit_value(vs, en, eb, ew, pool, out5);
    if r4 != 2 { return 11; }
    if vec_get(out5, 0) != 8 { return 12; }
    if vec_get(out5, 1) != 0 { return 13; }
    vec_push(en, 50); vec_push(eb, 2); vec_push(ew, 1);
    let out6: Vec<i32> = vec_new();
    let vv: Value = Value::VVar(50);
    let r5: i32 = emit_value(vv, en, eb, ew, pool, out6);
    if r5 != 2 { return 14; }
    if vec_get(out6, 0) != 96 { return 15; }
    if vec_get(out6, 1) != 2 { return 16; }
    vec_push(en, 60); vec_push(eb, 5); vec_push(ew, 3);
    let out7: Vec<i32> = vec_new();
    let vv2: Value = Value::VVar(60);
    let r6: i32 = emit_value(vv2, en, eb, ew, pool, out7);
    if r6 != 6 { return 17; }
    if vec_get(out7, 0) != 96 { return 18; }
    if vec_get(out7, 1) != 5 { return 19; }
    if vec_get(out7, 2) != 96 { return 20; }
    if vec_get(out7, 3) != 6 { return 21; }
    if vec_get(out7, 4) != 96 { return 22; }
    if vec_get(out7, 5) != 7 { return 23; }
    let out8: Vec<i32> = vec_new();
    let va: Value = Value::VAddrOf(50);
    let r7: i32 = emit_value(va, en, eb, ew, pool, out8);
    if r7 != 2 { return 24; }
    if vec_get(out8, 0) != 4 { return 25; }
    if vec_get(out8, 1) != 2 { return 26; }
    return 0;
}

fn test_emit_expr() -> i32 {
    let en: Vec<i32> = vec_new();
    let eb: Vec<i32> = vec_new();
    let ew: Vec<i32> = vec_new();
    let pool: Vec<i32> = vec_new();
    let source: string = "+-!i32";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 1);
    vec_push(starts, 1); vec_push(ends, 2);
    vec_push(starts, 2); vec_push(ends, 3);
    vec_push(starts, 3); vec_push(ends, 6);
    let out1: Vec<i32> = vec_new();
    let lit: Expr = Expr::Literal(box_new(Value::VInt(7)));
    let r1: i32 = emit_expr(lit, en, eb, ew, pool, source, starts, ends, out1);
    if r1 != 2 { return 1; }
    if vec_get(out1, 0) != 4 { return 2; }
    if vec_get(out1, 1) != 7 { return 3; }
    let out2: Vec<i32> = vec_new();
    let binop: Expr = Expr::Binop(0, box_new(Value::VInt(3)), box_new(Value::VInt(4)));
    let r2: i32 = emit_expr(binop, en, eb, ew, pool, source, starts, ends, out2);
    if r2 != 5 { return 4; }
    if vec_get(out2, 0) != 4 { return 5; }
    if vec_get(out2, 1) != 3 { return 6; }
    if vec_get(out2, 2) != 4 { return 7; }
    if vec_get(out2, 3) != 4 { return 8; }
    if vec_get(out2, 4) != 16 { return 9; }
    let out3: Vec<i32> = vec_new();
    let unop_not: Expr = Expr::Unop(2, box_new(Value::VBool(true)));
    let r3: i32 = emit_expr(unop_not, en, eb, ew, pool, source, starts, ends, out3);
    if r3 != 3 { return 10; }
    if vec_get(out3, 0) != 7 { return 11; }
    if vec_get(out3, 1) != 1 { return 12; }
    if vec_get(out3, 2) != 82 { return 13; }
    let out4: Vec<i32> = vec_new();
    let unop_neg: Expr = Expr::Unop(1, box_new(Value::VInt(5)));
    let r4: i32 = emit_expr(unop_neg, en, eb, ew, pool, source, starts, ends, out4);
    if r4 != 3 { return 14; }
    if vec_get(out4, 0) != 4 { return 15; }
    if vec_get(out4, 1) != 5 { return 16; }
    if vec_get(out4, 2) != 21 { return 17; }
    vec_push(en, 70); vec_push(eb, 0); vec_push(ew, 1);
    let out5: Vec<i32> = vec_new();
    let load: Expr = Expr::Load(70);
    let r5: i32 = emit_expr(load, en, eb, ew, pool, source, starts, ends, out5);
    if r5 != 2 { return 18; }
    if vec_get(out5, 0) != 96 { return 19; }
    if vec_get(out5, 1) != 0 { return 20; }
    let out6: Vec<i32> = vec_new();
    let unop_cast: Expr = Expr::Unop(3, box_new(Value::VInt(9)));
    let r6: i32 = emit_expr(unop_cast, en, eb, ew, pool, source, starts, ends, out6);
    if r6 != 2 { return 21; }
    if vec_get(out6, 0) != 4 { return 22; }
    if vec_get(out6, 1) != 9 { return 23; }
    return 0;
}

fn test_emit_instr() -> i32 {
    let en: Vec<i32> = vec_new();
    let eb: Vec<i32> = vec_new();
    let ew: Vec<i32> = vec_new();
    let pool: Vec<i32> = vec_new();
    let source: string = "+-!";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 1);
    vec_push(starts, 1); vec_push(ends, 2);
    vec_push(starts, 2); vec_push(ends, 3);
    vec_push(en, 50); vec_push(eb, 0); vec_push(ew, 1);
    let out1: Vec<i32> = vec_new();
    let r1: i32 = emit_instr(Instr::Nop, en, eb, ew, pool, source, starts, ends, out1);
    if r1 != 0 { return 1; }
    if vec_len(out1) != 0 { return 2; }
    let out2: Vec<i32> = vec_new();
    let r2: i32 = emit_instr(Instr::DeclVar(99), en, eb, ew, pool, source, starts, ends, out2);
    if r2 != 0 { return 3; }
    if vec_len(out2) != 0 { return 4; }
    let out3: Vec<i32> = vec_new();
    let r3: i32 = emit_instr(Instr::DeclNamed(1, 2), en, eb, ew, pool, source, starts, ends, out3);
    if r3 != 0 { return 5; }
    let out4: Vec<i32> = vec_new();
    let asgn_e: Expr = Expr::Literal(box_new(Value::VInt(42)));
    let r4: i32 = emit_instr(Instr::Assign(50, box_new(asgn_e)),
                              en, eb, ew, pool, source, starts, ends, out4);
    if r4 != 4 { return 6; }
    if vec_get(out4, 0) != 4 { return 7; }
    if vec_get(out4, 1) != 42 { return 8; }
    if vec_get(out4, 2) != 97 { return 9; }
    if vec_get(out4, 3) != 0 { return 10; }
    let out5: Vec<i32> = vec_new();
    let store_e: Expr = Expr::Literal(box_new(Value::VBool(true)));
    let r5: i32 = emit_instr(Instr::Store(50, box_new(store_e)),
                              en, eb, ew, pool, source, starts, ends, out5);
    if r5 != 4 { return 11; }
    if vec_get(out5, 0) != 7 { return 12; }
    if vec_get(out5, 1) != 1 { return 13; }
    if vec_get(out5, 2) != 97 { return 14; }
    if vec_get(out5, 3) != 0 { return 15; }
    let out6: Vec<i32> = vec_new();
    let r6: i32 = emit_instr(Instr::ReturnVoid, en, eb, ew, pool, source, starts, ends, out6);
    if r6 != 2 { return 16; }
    if vec_get(out6, 0) != 118 { return 17; }
    if vec_get(out6, 1) != 0 { return 18; }
    let out7: Vec<i32> = vec_new();
    let r7: i32 = emit_instr(Instr::ReturnVal(box_new(Value::VInt(7))),
                              en, eb, ew, pool, source, starts, ends, out7);
    if r7 != 4 { return 19; }
    if vec_get(out7, 0) != 4 { return 20; }
    if vec_get(out7, 1) != 7 { return 21; }
    if vec_get(out7, 2) != 118 { return 22; }
    if vec_get(out7, 3) != 1 { return 23; }
    let out8: Vec<i32> = vec_new();
    let r8: i32 = emit_instr(Instr::ReturnVal(box_new(Value::VVar(50))),
                              en, eb, ew, pool, source, starts, ends, out8);
    if r8 != 4 { return 24; }
    if vec_get(out8, 0) != 96 { return 25; }
    if vec_get(out8, 1) != 0 { return 26; }
    if vec_get(out8, 2) != 118 { return 27; }
    if vec_get(out8, 3) != 1 { return 28; }
    vec_push(en, 60); vec_push(eb, 1); vec_push(ew, 3);
    let out9: Vec<i32> = vec_new();
    let asgn2_e: Expr = Expr::Load(60);
    let r9: i32 = emit_instr(Instr::Assign(60, box_new(asgn2_e)),
                              en, eb, ew, pool, source, starts, ends, out9);
    if r9 != 12 { return 29; }
    if vec_get(out9, 0) != 96 { return 30; }
    if vec_get(out9, 1) != 1 { return 31; }
    if vec_get(out9, 2) != 96 { return 32; }
    if vec_get(out9, 3) != 2 { return 33; }
    if vec_get(out9, 4) != 96 { return 34; }
    if vec_get(out9, 5) != 3 { return 35; }
    if vec_get(out9, 6) != 97 { return 36; }
    if vec_get(out9, 7) != 3 { return 37; }
    if vec_get(out9, 8) != 97 { return 38; }
    if vec_get(out9, 9) != 2 { return 39; }
    if vec_get(out9, 10) != 97 { return 40; }
    if vec_get(out9, 11) != 1 { return 41; }
    let out10: Vec<i32> = vec_new();
    let r10: i32 = emit_instr(Instr::ReturnVal(box_new(Value::VVar(60))),
                               en, eb, ew, pool, source, starts, ends, out10);
    if r10 != 8 { return 42; }
    if vec_get(out10, 6) != 118 { return 43; }
    if vec_get(out10, 7) != 3 { return 44; }
    return 0;
}

fn test_emit_instrs() -> i32 {
    let en: Vec<i32> = vec_new();
    let eb: Vec<i32> = vec_new();
    let ew: Vec<i32> = vec_new();
    let pool: Vec<i32> = vec_new();
    let source: string = "+";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 1);
    let empty: Vec<i32> = vec_new();
    let out1: Vec<i32> = vec_new();
    let r1: i32 = emit_instrs(empty, en, eb, ew, pool, source, starts, ends, out1);
    if r1 != 0 { return 1; }
    if vec_len(out1) != 0 { return 2; }
    let instrs: Vec<i32> = vec_new();
    vec_push(instrs, box_new(Instr::Nop));
    vec_push(instrs, box_new(Instr::ReturnVoid));
    let out2: Vec<i32> = vec_new();
    let r2: i32 = emit_instrs(instrs, en, eb, ew, pool, source, starts, ends, out2);
    if r2 != 2 { return 3; }
    if vec_len(out2) != 2 { return 4; }
    if vec_get(out2, 0) != 118 { return 5; }
    if vec_get(out2, 1) != 0 { return 6; }
    vec_push(en, 70); vec_push(eb, 0); vec_push(ew, 1);
    let instrs2: Vec<i32> = vec_new();
    let a_e: Expr = Expr::Literal(box_new(Value::VInt(99)));
    vec_push(instrs2, box_new(Instr::Assign(70, box_new(a_e))));
    vec_push(instrs2, box_new(Instr::ReturnVal(box_new(Value::VVar(70)))));
    let out3: Vec<i32> = vec_new();
    let r3: i32 = emit_instrs(instrs2, en, eb, ew, pool, source, starts, ends, out3);
    if r3 != 8 { return 7; }
    if vec_get(out3, 0) != 4 { return 8; }
    if vec_get(out3, 1) != 99 { return 9; }
    if vec_get(out3, 2) != 97 { return 10; }
    if vec_get(out3, 3) != 0 { return 11; }
    if vec_get(out3, 4) != 96 { return 12; }
    if vec_get(out3, 5) != 0 { return 13; }
    if vec_get(out3, 6) != 118 { return 14; }
    if vec_get(out3, 7) != 1 { return 15; }
    return 0;
}

fn test_vec_append() -> i32 {
    let dst: Vec<i32> = vec_new();
    vec_push(dst, 1);
    let src: Vec<i32> = vec_new();
    vec_push(src, 2); vec_push(src, 3);
    let n: i32 = vec_append(dst, src);
    if n != 2 { return 1; }
    if vec_len(dst) != 3 { return 2; }
    if vec_get(dst, 0) != 1 { return 3; }
    if vec_get(dst, 1) != 2 { return 4; }
    if vec_get(dst, 2) != 3 { return 5; }
    let e: Vec<i32> = vec_new();
    let n2: i32 = vec_append(dst, e);
    if n2 != 0 { return 6; }
    if vec_len(dst) != 3 { return 7; }
    return 0;
}

