    if vec_get(out1, 1) != 1 { return 3; }
    if vec_get(out1, 2) != 160 { return 4; }
    if vec_get(out1, 3) != 0 { return 5; }
    if pool_size(pool) != 1 { return 6; }
    let out2: Vec<i32> = vec_new();
    let ens1: Instr = Instr::Ensures(
        box_new(Expr::Literal(box_new(Value::VBoolFalse))), 42);
    let r2: i32 = emit_instr(ens1, en, eb, ew, ec, efs, eff, pool, source,
                              starts, ends, fns, out2);
    if r2 != 4 { return 7; }
