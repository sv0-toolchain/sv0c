    let out1: Vec<i32> = vec_new();
    let req1: Instr = Instr::Requires(
        box_new(Expr::Literal(box_new(Value::VBoolTrue))), 42);
    let r1: i32 = emit_instr(req1, en, eb, ew, ec, efs, eff, pool, source,
                              starts, ends, fns, out1);
    if r1 != 4 { return 1; }
