                              starts, ends, fns, out3);
    if r3 != 4 { return 13; }
    if vec_get(out3, 3) != 0 { return 14; }
    if pool_size(pool) != 2 { return 15; }
    let out4: Vec<i32> = vec_new();
    let req3: Instr = Instr::Requires(
        box_new(Expr::Literal(box_new(Value::VBoolTrue))), 99);
    let r4: i32 = emit_instr(req3, en, eb, ew, ec, efs, eff, pool, source,
                              starts, ends, fns, out4);
    if r4 != 4 { return 16; }
    if vec_get(out4, 3) != 2 { return 17; }
    if pool_size(pool) != 3 { return 18; }
    let k0: i32 = contract_pool_key(42, 0);
    let k1: i32 = contract_pool_key(42, 1);
    let k2: i32 = contract_pool_key(99, 0);
    if k0 == k1 { return 19; }
    if k0 == k2 { return 20; }
    if k0 >= 0 { return 21; }
    if k1 >= 0 { return 22; }
    return 0;
}

fn test_compute_arity() -> i32 {
    let sn: Vec<i32> = vec_new();
    let sfc: Vec<i32> = vec_new();
    let enn: Vec<i32> = vec_new();
    let enw: Vec<i32> = vec_new();
    /* --- no params → arity 0 --- */
    let pc0: Vec<i32> = vec_new();
    if compute_arity(pc0, sn, sfc, enn, enw, "", vec_new(), vec_new()) != 0 { return 1; }
    /* --- one scalar param → arity 1 --- */
    let pc1: Vec<i32> = vec_new();
    vec_push(pc1, 777);
    if compute_arity(pc1, sn, sfc, enn, enw, "", vec_new(), vec_new()) != 1 { return 2; }
    /* --- two scalar params → arity 2 --- */
    let pc2: Vec<i32> = vec_new();
    vec_push(pc2, 777);
    vec_push(pc2, 778);
    if compute_arity(pc2, sn, sfc, enn, enw, "", vec_new(), vec_new()) != 2 { return 3; }
    /* --- struct param (width 3) → arity 3 --- */
    let sn2: Vec<i32> = vec_new();
    let sfc2: Vec<i32> = vec_new();
    vec_push(sn2, 500);
    vec_push(sfc2, 3);
    let pc3: Vec<i32> = vec_new();
    vec_push(pc3, 500);
    if compute_arity(pc3, sn2, sfc2, enn, enw, "", vec_new(), vec_new()) != 3 { return 4; }
    /* --- mixed: scalar + struct(3) → arity 4 --- */
    let pc4: Vec<i32> = vec_new();
    vec_push(pc4, 777);
    vec_push(pc4, 500);
    if compute_arity(pc4, sn2, sfc2, enn, enw, "", vec_new(), vec_new()) != 4 { return 5; }
    /* --- enum param (width 2) → arity 2 --- */
    let enn2: Vec<i32> = vec_new();
    let enw2: Vec<i32> = vec_new();
    vec_push(enn2, 600);
    vec_push(enw2, 2);
    let pc5: Vec<i32> = vec_new();
    vec_push(pc5, 600);
    if compute_arity(pc5, sn, sfc, enn2, enw2, "", vec_new(), vec_new()) != 2 { return 6; }
    return 0;
}

fn test_emit_fn() -> i32 {
    let sn: Vec<i32> = vec_new();
    let sfc: Vec<i32> = vec_new();
    let enn: Vec<i32> = vec_new();
    let enw: Vec<i32> = vec_new();
    let pool: Vec<i32> = vec_new();
    let fns: Vec<i32> = vec_new();
    let source: string = "+";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 1);
    let ft: Vec<i32> = vec_new();
    /* --- fn with no params, ReturnVoid body --- */
    let pn0: Vec<i32> = vec_new();
    let pc0: Vec<i32> = vec_new();
    let ins0: Vec<i32> = vec_new();
    vec_push(ins0, box_new(Instr::ReturnVoid));
    let r0: i32 = emit_fn(42, pn0, pc0, ins0,
                            sn, sfc, enn, enw,
                            vec_new(), vec_new(),
                            pool, source, starts, ends, fns, ft);
    if r0 != 0 { return 1; }
    if vec_len(ft) != 4 { return 2; }
    let ni0: i32 = vec_get(ft, 0);
    if ni0 != 0 { return 3; }
    if vec_get(ft, 1) != 0 { return 4; }
    if vec_get(ft, 2) != 0 { return 5; }
    let code0: Vec<i32> = vec_get(ft, 3);
    if vec_len(code0) != 2 { return 6; }
    if vec_get(code0, 0) != 118 { return 7; }
    if vec_get(code0, 1) != 0 { return 8; }
    /* --- fn with one scalar param, Assign + ReturnVal --- */
    let pn1: Vec<i32> = vec_new();
    let pc1: Vec<i32> = vec_new();
    vec_push(pn1, 10);
    vec_push(pc1, 777);
    let ins1: Vec<i32> = vec_new();
    vec_push(ins1, box_new(Instr::Assign(20,
        box_new(Expr::Literal(box_new(Value::VInt(99)))))));
    vec_push(ins1, box_new(Instr::ReturnVal(
        box_new(Value::VVar(20)))));
    let r1: i32 = emit_fn(43, pn1, pc1, ins1,
                            sn, sfc, enn, enw,
                            vec_new(), vec_new(),
                            pool, source, starts, ends, fns, ft);
    if r1 != 0 { return 9; }
    if vec_len(ft) != 8 { return 10; }
    if vec_get(ft, 5) != 1 { return 11; }
    let lc1: i32 = vec_get(ft, 6);
    if lc1 != 2 { return 12; }
    let code1: Vec<i32> = vec_get(ft, 7);
    if vec_len(code1) < 2 { return 13; }
    /* --- pool correctness: two distinct labels pooled --- */
    if pool_size(pool) != 2 { return 14; }
    /* --- fn with struct param (width 3) → arity 3, lc 3 --- */
    let sn3: Vec<i32> = vec_new();
    let sfc3: Vec<i32> = vec_new();
    vec_push(sn3, 500);
    vec_push(sfc3, 3);
    let pn2: Vec<i32> = vec_new();
    let pc2: Vec<i32> = vec_new();
    vec_push(pn2, 30);
    vec_push(pc2, 500);
    let ins2: Vec<i32> = vec_new();
    vec_push(ins2, box_new(Instr::ReturnVoid));
    let pool2: Vec<i32> = vec_new();
    let ft2: Vec<i32> = vec_new();
    let r2: i32 = emit_fn(44, pn2, pc2, ins2,
                            sn3, sfc3, enn, enw,
                            vec_new(), vec_new(),
                            pool2, source, starts, ends, fns, ft2);
    if r2 != 0 { return 15; }
    if vec_get(ft2, 1) != 3 { return 16; }
    if vec_get(ft2, 2) != 3 { return 17; }
    /* --- two functions into same ft → stride-4 entries --- */
    let pn3: Vec<i32> = vec_new();
    let pc3: Vec<i32> = vec_new();
    let ins3: Vec<i32> = vec_new();
    vec_push(ins3, box_new(Instr::ReturnVoid));
    let r3: i32 = emit_fn(45, pn3, pc3, ins3,
                            sn, sfc, enn, enw,
                            vec_new(), vec_new(),
                            pool2, source, starts, ends, fns, ft2);
    if r3 != 0 { return 18; }
    if vec_len(ft2) != 8 { return 19; }
    if vec_get(ft2, 4) != vec_get(ft2, 0) + 1 { return 20; }
    return 0;
}

fn test_local_count_and_env() -> i32 {
    let sn: Vec<i32> = vec_new();
    let sfc: Vec<i32> = vec_new();
    let enn: Vec<i32> = vec_new();
    let enw: Vec<i32> = vec_new();
    /* --- no params, no instrs → 0 locals --- */
    let en0: Vec<i32> = vec_new();
    let eb0: Vec<i32> = vec_new();
    let ew0: Vec<i32> = vec_new();
    let ec0: Vec<i32> = vec_new();
    let efs0: Vec<i32> = vec_new();
    let pn0: Vec<i32> = vec_new();
    let pc0: Vec<i32> = vec_new();
    let ins0: Vec<i32> = vec_new();
    let lc0: i32 = local_count_and_env(pn0, pc0, ins0,
                                        en0, eb0, ew0, ec0, efs0,
                                        sn, sfc, enn, enw,
                                        vec_new(), vec_new(), vec_new(),
                                        "", vec_new(), vec_new());
    if lc0 != 0 { return 1; }
    if vec_len(en0) != 0 { return 2; }
    /* --- two scalar params (width 1 each) → 2 slots --- */
    let en1: Vec<i32> = vec_new();
    let eb1: Vec<i32> = vec_new();
    let ew1: Vec<i32> = vec_new();
    let ec1: Vec<i32> = vec_new();
    let efs1: Vec<i32> = vec_new();
    let pn1: Vec<i32> = vec_new();
    let pc1: Vec<i32> = vec_new();
    vec_push(pn1, 10);
    vec_push(pc1, 777);
    vec_push(pn1, 20);
    vec_push(pc1, 778);
    let ins1: Vec<i32> = vec_new();
    let lc1: i32 = local_count_and_env(pn1, pc1, ins1,
                                        en1, eb1, ew1, ec1, efs1,
                                        sn, sfc, enn, enw,
                                        vec_new(), vec_new(), vec_new(),
                                        "", vec_new(), vec_new());
    if lc1 != 2 { return 3; }
    if vec_len(en1) != 2 { return 4; }
    if vec_get(en1, 0) != 10 { return 5; }
    if vec_get(eb1, 0) != 0 { return 6; }
    if vec_get(ew1, 0) != 1 { return 7; }
    if vec_get(en1, 1) != 20 { return 8; }
    if vec_get(eb1, 1) != 1 { return 9; }
    /* --- struct param (width 3) → occupies slots 0-2 --- */
    let sn2: Vec<i32> = vec_new();
    let sfc2: Vec<i32> = vec_new();
    vec_push(sn2, 500);
    vec_push(sfc2, 3);
    let en2: Vec<i32> = vec_new();
    let eb2: Vec<i32> = vec_new();
    let ew2: Vec<i32> = vec_new();
    let ec2: Vec<i32> = vec_new();
    let efs2: Vec<i32> = vec_new();
    let pn2: Vec<i32> = vec_new();
    let pc2: Vec<i32> = vec_new();
    vec_push(pn2, 30);
    vec_push(pc2, 500);
    let ins2: Vec<i32> = vec_new();
    let lc2: i32 = local_count_and_env(pn2, pc2, ins2,
                                        en2, eb2, ew2, ec2, efs2,
                                        sn2, sfc2, enn, enw,
                                        vec_new(), vec_new(), vec_new(),
                                        "", vec_new(), vec_new());
    if lc2 != 3 { return 10; }
    if vec_get(ew2, 0) != 3 { return 11; }
    if vec_get(eb2, 0) != 0 { return 12; }
    /* --- DeclVar instruction adds slot --- */
    let en3: Vec<i32> = vec_new();
    let eb3: Vec<i32> = vec_new();
    let ew3: Vec<i32> = vec_new();
    let ec3: Vec<i32> = vec_new();
    let efs3: Vec<i32> = vec_new();
    let pn3: Vec<i32> = vec_new();
    let pc3: Vec<i32> = vec_new();
    let ins3: Vec<i32> = vec_new();
    vec_push(ins3, box_new(Instr::DeclVar(40)));
    let lc3: i32 = local_count_and_env(pn3, pc3, ins3,
                                        en3, eb3, ew3, ec3, efs3,
                                        sn, sfc, enn, enw,
                                        vec_new(), vec_new(), vec_new(),
                                        "", vec_new(), vec_new());
    if lc3 != 1 { return 13; }
    if vec_get(en3, 0) != 40 { return 14; }
    if vec_get(eb3, 0) != 0 { return 15; }
    if vec_get(ew3, 0) != 1 { return 16; }
    /* --- DeclVar does not double-add existing var --- */
    let en4: Vec<i32> = vec_new();
    let eb4: Vec<i32> = vec_new();
    let ew4: Vec<i32> = vec_new();
    let ec4: Vec<i32> = vec_new();
    let efs4: Vec<i32> = vec_new();
    let pn4: Vec<i32> = vec_new();
    let pc4: Vec<i32> = vec_new();
    let ins4: Vec<i32> = vec_new();
    vec_push(ins4, box_new(Instr::DeclVar(50)));
    vec_push(ins4, box_new(Instr::DeclVar(50)));
    let lc4: i32 = local_count_and_env(pn4, pc4, ins4,
                                        en4, eb4, ew4, ec4, efs4,
                                        sn, sfc, enn, enw,
                                        vec_new(), vec_new(), vec_new(),
                                        "", vec_new(), vec_new());
    if lc4 != 1 { return 17; }
    if vec_len(en4) != 1 { return 18; }
    /* --- Assign ensures var exists --- */
    let en5: Vec<i32> = vec_new();
    let eb5: Vec<i32> = vec_new();
    let ew5: Vec<i32> = vec_new();
    let ec5: Vec<i32> = vec_new();
    let efs5: Vec<i32> = vec_new();
    let pn5: Vec<i32> = vec_new();
    let pc5: Vec<i32> = vec_new();
    let ins5: Vec<i32> = vec_new();
    vec_push(ins5, box_new(Instr::Assign(60,
        box_new(Expr::Literal(box_new(Value::VInt(7)))))));
    let lc5: i32 = local_count_and_env(pn5, pc5, ins5,
                                        en5, eb5, ew5, ec5, efs5,
                                        sn, sfc, enn, enw,
                                        vec_new(), vec_new(), vec_new(),
                                        "", vec_new(), vec_new());
    if lc5 != 1 { return 19; }
    if vec_get(en5, 0) != 60 { return 20; }
    /* --- Call with dest allocates slot (scalar rty) --- */
    let en6: Vec<i32> = vec_new();
    let eb6: Vec<i32> = vec_new();
    let ew6: Vec<i32> = vec_new();
    let ec6: Vec<i32> = vec_new();
    let efs6: Vec<i32> = vec_new();
    let pn6: Vec<i32> = vec_new();
    let pc6: Vec<i32> = vec_new();
    let ins6: Vec<i32> = vec_new();
    let cargs: Vec<i32> = vec_new();
    vec_push(ins6, box_new(Instr::Call(70, 100, cargs, 999)));
    let lc6: i32 = local_count_and_env(pn6, pc6, ins6,
                                        en6, eb6, ew6, ec6, efs6,
                                        sn, sfc, enn, enw,
                                        vec_new(), vec_new(), vec_new(),
                                        "", vec_new(), vec_new());
    if lc6 != 1 { return 21; }
    if vec_get(en6, 0) != 70 { return 22; }
    /* --- Call with dst=0 (no dest) does not allocate --- */
    let en7: Vec<i32> = vec_new();
    let eb7: Vec<i32> = vec_new();
    let ew7: Vec<i32> = vec_new();
    let ec7: Vec<i32> = vec_new();
    let efs7: Vec<i32> = vec_new();
    let pn7: Vec<i32> = vec_new();
    let pc7: Vec<i32> = vec_new();
    let ins7: Vec<i32> = vec_new();
    let cargs2: Vec<i32> = vec_new();
    vec_push(ins7, box_new(Instr::Call(0, 100, cargs2, 999)));
    let lc7: i32 = local_count_and_env(pn7, pc7, ins7,
                                        en7, eb7, ew7, ec7, efs7,
                                        sn, sfc, enn, enw,
                                        vec_new(), vec_new(), vec_new(),
                                        "", vec_new(), vec_new());
    if lc7 != 0 { return 23; }
    if vec_len(en7) != 0 { return 24; }
    /* --- Call with struct return type (width 3) --- */
    let en8: Vec<i32> = vec_new();
    let eb8: Vec<i32> = vec_new();
    let ew8: Vec<i32> = vec_new();
    let ec8: Vec<i32> = vec_new();
    let efs8: Vec<i32> = vec_new();
    let pn8: Vec<i32> = vec_new();
    let pc8: Vec<i32> = vec_new();
    let ins8: Vec<i32> = vec_new();
    let cargs3: Vec<i32> = vec_new();
    vec_push(ins8, box_new(Instr::Call(80, 100, cargs3, 500)));
    let lc8: i32 = local_count_and_env(pn8, pc8, ins8,
                                        en8, eb8, ew8, ec8, efs8,
                                        sn2, sfc2, enn, enw,
                                        vec_new(), vec_new(), vec_new(),
                                        "", vec_new(), vec_new());
    if lc8 != 3 { return 25; }
    if vec_get(ew8, 0) != 3 { return 26; }
    /* --- IfElse scans both branches --- */
    let en9: Vec<i32> = vec_new();
    let eb9: Vec<i32> = vec_new();
    let ew9: Vec<i32> = vec_new();
    let ec9: Vec<i32> = vec_new();
    let efs9: Vec<i32> = vec_new();
    let pn9: Vec<i32> = vec_new();
    let pc9: Vec<i32> = vec_new();
    let ins9: Vec<i32> = vec_new();
    let th9: Vec<i32> = vec_new();
    let el9: Vec<i32> = vec_new();
    vec_push(th9, box_new(Instr::DeclVar(90)));
    vec_push(el9, box_new(Instr::DeclVar(91)));
    vec_push(ins9, box_new(Instr::IfElse(
        box_new(Expr::Literal(box_new(Value::VBoolTrue))),
        th9, el9)));
    let lc9: i32 = local_count_and_env(pn9, pc9, ins9,
                                        en9, eb9, ew9, ec9, efs9,
                                        sn, sfc, enn, enw,
                                        vec_new(), vec_new(), vec_new(),
                                        "", vec_new(), vec_new());
    if lc9 != 2 { return 27; }
    if vec_get(en9, 0) != 90 { return 28; }
    if vec_get(en9, 1) != 91 { return 29; }
    /* --- WhileLoop scans body --- */
    let en10: Vec<i32> = vec_new();
    let eb10: Vec<i32> = vec_new();
    let ew10: Vec<i32> = vec_new();
    let ec10: Vec<i32> = vec_new();
    let efs10: Vec<i32> = vec_new();
    let pn10: Vec<i32> = vec_new();
    let pc10: Vec<i32> = vec_new();
    let ins10: Vec<i32> = vec_new();
    let wbod: Vec<i32> = vec_new();
    vec_push(wbod, box_new(Instr::DeclVar(95)));
    vec_push(ins10, box_new(Instr::WhileLoop(
        box_new(Expr::Literal(box_new(Value::VBoolTrue))),
        wbod)));
    let lc10: i32 = local_count_and_env(pn10, pc10, ins10,
                                         en10, eb10, ew10, ec10, efs10,
                                         sn, sfc, enn, enw,
                                        vec_new(), vec_new(), vec_new(),
                                        "", vec_new(), vec_new());
    if lc10 != 1 { return 30; }
    if vec_get(en10, 0) != 95 { return 31; }
    /* --- params + locals combined --- */
    let en11: Vec<i32> = vec_new();
    let eb11: Vec<i32> = vec_new();
    let ew11: Vec<i32> = vec_new();
    let ec11: Vec<i32> = vec_new();
    let efs11: Vec<i32> = vec_new();
    let pn11: Vec<i32> = vec_new();
    let pc11: Vec<i32> = vec_new();
    vec_push(pn11, 200);
    vec_push(pc11, 777);
    let ins11: Vec<i32> = vec_new();
    vec_push(ins11, box_new(Instr::DeclVar(201)));
    vec_push(ins11, box_new(Instr::DeclVar(202)));
    let lc11: i32 = local_count_and_env(pn11, pc11, ins11,
                                         en11, eb11, ew11, ec11, efs11,
                                         sn, sfc, enn, enw,
                                        vec_new(), vec_new(), vec_new(),
                                        "", vec_new(), vec_new());
    if lc11 != 3 { return 32; }
    if vec_len(en11) != 3 { return 33; }
    if vec_get(eb11, 0) != 0 { return 34; }
    if vec_get(eb11, 1) != 1 { return 35; }
    if vec_get(eb11, 2) != 2 { return 36; }
    /* --- no-op instructions do not allocate --- */
    let en12: Vec<i32> = vec_new();
    let eb12: Vec<i32> = vec_new();
    let ew12: Vec<i32> = vec_new();
    let ec12: Vec<i32> = vec_new();
    let efs12: Vec<i32> = vec_new();
    let pn12: Vec<i32> = vec_new();
    let pc12: Vec<i32> = vec_new();
    let ins12: Vec<i32> = vec_new();
    vec_push(ins12, box_new(Instr::Nop));
    vec_push(ins12, box_new(Instr::Break));
    vec_push(ins12, box_new(Instr::Continue));
    vec_push(ins12, box_new(Instr::ReturnVoid));
    let lc12: i32 = local_count_and_env(pn12, pc12, ins12,
                                         en12, eb12, ew12, ec12, efs12,
                                         sn, sfc, enn, enw,
                                        vec_new(), vec_new(), vec_new(),
                                        "", vec_new(), vec_new());
    if lc12 != 0 { return 37; }
    if vec_len(en12) != 0 { return 38; }
    return 0;
}

fn test_is_main_label() -> i32 {
    let src: string = "main foo";
    let st: Vec<i32> = vec_new();
    let en: Vec<i32> = vec_new();
    vec_push(st, 0); vec_push(en, 4);
    vec_push(st, 5); vec_push(en, 8);
    if is_main_label(0, src, st, en) != true { return 1; }
    if is_main_label(1, src, st, en) != false { return 2; }
    return 0;
}

fn test_build_func_order() -> i32 {
    let src: string = "main foo";
    let st: Vec<i32> = vec_new();
    let en: Vec<i32> = vec_new();
    vec_push(st, 0); vec_push(en, 4);
    vec_push(st, 5); vec_push(en, 8);
    let labs: Vec<i32> = vec_new();
    vec_push(labs, 0);
    vec_push(labs, 1);
    let ord: Vec<i32> = vec_new();
    let fc: i32 = build_func_order(labs, src, st, en, ord);
    if fc != 2 { return 1; }
    if vec_get(ord, 0) != 1 { return 2; }
    if vec_get(ord, 1) != 0 { return 3; }
    return 0;
}

fn emit_program_1fn(source: string, starts: Vec<i32>,
                    ends: Vec<i32>, lab: i32,
                    pn: Vec<i32>, pc: Vec<i32>,
                    ins: Vec<i32>,
                    pool: Vec<i32>, ft: Vec<i32>) -> i32 {
    let it: Vec<i32> = vec_new();
    let in2: Vec<i32> = vec_new();
    let ifc: Vec<i32> = vec_new();
    let ivp: Vec<i32> = vec_new();
    let bl: Vec<i32> = vec_new();
    vec_push(bl, lab);
    let bpn: Vec<i32> = vec_new();
    vec_push(bpn, pn);
    let bpc: Vec<i32> = vec_new();
    vec_push(bpc, pc);
    let bi: Vec<i32> = vec_new();
    vec_push(bi, ins);
    return emit_program(it, in2, ifc, ivp, vec_new(), vec_new(), bl, bpn, bpc, bi,
                         source, starts, ends, pool, ft);
}

fn test_emit_program() -> i32 {
    let src: string = "main";
    let st: Vec<i32> = vec_new();
    let en: Vec<i32> = vec_new();
    vec_push(st, 0); vec_push(en, 4);
    let pn: Vec<i32> = vec_new();
    let pc: Vec<i32> = vec_new();
    let ins: Vec<i32> = vec_new();
    vec_push(ins, box_new(Instr::ReturnVal(
        box_new(Value::VInt(42)))));
    let pool: Vec<i32> = vec_new();
    let ft: Vec<i32> = vec_new();
    let fc: i32 = emit_program_1fn(src, st, en, 0, pn, pc, ins,
                                    pool, ft);
    if fc != 1 { return 1; }
    if vec_len(ft) != 4 { return 2; }
    if vec_get(ft, 1) != 0 { return 3; }
    return 0;
}

fn main() -> i32 {
    let r1: i32 = test_variant_slots();
    if r1 != 0 { return r1; }
    let r2: i32 = test_cty_classify();
    if r2 != 0 { return 10 + r2; }
    let r3: i32 = test_index_of_field();
    if r3 != 0 { return 20 + r3; }
    let r4: i32 = test_binop_to_insn();
