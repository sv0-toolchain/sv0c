/* Phase 2 real pipeline module: sml/backend/vm/vm_codegen.sml -> sv0.
   VM code generation utilities: variant slot counting, enum field
   names/payload indexing, struct/enum layout lookup, widthOfCty
   (Vec-based struct/enum layout width with proper name comparison),
   indexOfField, binop/unop → opcode dispatch, instruction encoding
   length (encLen/encLens), string pool management (Vec-based), loop
   sentinels, value width classification, builtin function dispatch.
   lookup_slot (SML lookupSlot — name→slot_info in Vec env),
   alloc_local (SML allocLocal — bindParam wrapper), replace_loop_exit_jump
   (SML replaceLoopExitJump — patches trailing JUMP placeholder),
   patch_continue_jumps (SML patchContinueJumpsFrom — walk flat opcode
   stream and replace continue-sentinel JUMP args with real offsets),
   enum_field_names (SML enumFieldNames — "tag","p0","p1"... Vec),
   value_width (SML valueWidth — slot-based width for VVar, else 1),
   bind_param (SML bindParam — slot_info with struct/enum fields),
   struct_layouts_build (SML structLayouts — filter ItemStruct from items),
   enum_layouts_build (SML enumLayouts — filter ItemEnum, width = 1+maxP),
   emit_value (SML emitValue — IR Value → bytecode instruction words;
   all scalar cases: VInt/VBool/VUnit/VString/VVar/VAddrOf; VMember deferred),
   emit_expr (SML emitExpr — IR Expr → bytecode instruction words;
   Literal/Load/Binop/Unop with handle-based op resolution; FieldAccess deferred),
   emit_instr (SML emitInstr — IR Instr → bytecode instruction words;
   all 16 cases: Nop/DeclVar/DeclNamed/Assign/Store/StoreField/IfElse/
   WhileLoop/BlockInstr/Break/Continue/Call/Requires/Ensures/ReturnVoid/
   ReturnVal),
   emit_instrs (SML emitBlock — iterate Box<Instr> Vec, calling emit_instr),
   vec_append (copy src Vec<i32> into dst), emit_ret_width (value width for
   RETURN_SLOTS), flat_byte_size (walk flat insn Vec and sum encoded byte
   sizes for jump offset calculation).
   index_of_field_range (field lookup within flat per-slot fields),
   contract_pool_key (negative key encoding for contract messages),
   ensure_var_int (SML ensureVarInt — add scalar slot if absent),
   scan_instr_env / scan_instrs_env (SML scanInstr — recursive env scan),
   local_count_and_env (SML localCountAndEnv — bind params + scan instrs,
   build env Vecs, return local slot count; field_starts placeholder-only
   until struct field name storage is added),
   compute_arity (sum of param widths),
   emit_fn (SML emitFn — function-level orchestration: builds env via
   local_count_and_env, emits code via emit_instrs, computes arity,
   pools label, appends stride-4 func_entry to ft_entries),
   is_main_label (SML isMain — string equality check for "main"),
   build_func_order (SML funcOrder — non-main first, main last),
   emit_program (SML VmCodegen.emit — top-level program orchestration:
   builds struct/enum layouts, reorders blocks, emits all functions via
   emit_fn; returns pool + ft_entries for caller to encode via
   bytecode.sv0's encode_strings / encode_file). */

/* ── variant slot counting ──────────────────────────────────── */

fn variant_slots_unit() -> i32 { return 0; }
fn variant_slots_tuple(field_count: i32) -> i32 { return field_count; }
fn variant_slots_struct(field_count: i32) -> i32 { return field_count; }

fn variant_slots(variant_kind: i32, field_count: i32) -> i32 {
    if variant_kind == 0 { return 0; }
    return field_count;
}

/* ── enum field names ──────────────────────────────────────────
   enumFieldNames: for an enum with width w (= 1 + maxPayload),
   the "fields" are tag, p0, p1, ..., p(w-2).
   Field count = width; index 0 is always the tag. */

fn enum_field_count_from_width(width: i32) -> i32 {
    return width;
}

fn enum_field_is_tag(idx: i32) -> bool {
    return idx == 0;
}

fn enum_payload_field_index(field_idx: i32) -> i32 {
    return field_idx - 1;
}

/* ── struct/enum layout lookup ──────────────────────────────── */

fn layout_lookup(names: Vec<i32>, widths: Vec<i32>, name: i32) -> i32 {
    let n: i32 = vec_len(names);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(names, i) == name { return vec_get(widths, i); }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── width of C type ────────────────────────────────────────── */

fn is_void_cty(cty: string) -> bool {
    return string_eq(cty, "void");
}

fn is_scalar_cty(cty: string) -> bool {
    if string_eq(cty, "bool") { return true; }
    if string_len(cty) >= 3 {
        let c0: i32 = string_char_at(cty, 0);
        let c1: i32 = string_char_at(cty, 1);
        let c2: i32 = string_char_at(cty, 2);
        if c0 == 105 {
            if c1 == 110 {
                if c2 == 116 { return true; }
            }
        }
        if c0 == 117 {
            if c1 == 105 {
                if c2 == 110 { return true; }
            }
        }
    }
    return false;
}

/* widthOfCty with Vec-based struct/enum layouts.
   structs_names: Vec of struct name handles
   structs_field_counts: Vec of field counts (parallel)
   enums_names: Vec of enum name handles
   enums_widths: Vec of enum widths (1 + maxPayload, parallel) */
/* A struct/enum type-name handle at a declaration (`let x: T`, a struct literal
   `T { … }`) differs from the token at the type's definition (`struct T { … }`),
   so match by resolved NAME (slot_name_eq: source string when both handles index
   the arena, else integer — empty source falls back to integer for the synthetic
   layout tests). Width of a struct is its field count, of an enum its slot width
   (tag + payload), of a scalar 1. */
fn width_of_cty(cty_handle: i32,
                structs_names: Vec<i32>, structs_field_counts: Vec<i32>,
                enums_names: Vec<i32>, enums_widths: Vec<i32>,
                source: string, starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    let sn: i32 = vec_len(structs_names);
    let mut si: i32 = 0;
    while si < sn {
        if slot_name_eq(vec_get(structs_names, si), cty_handle, source, starts, ends) {
            return vec_get(structs_field_counts, si);
        }
        si = si + 1;
    }
    let en: i32 = vec_len(enums_names);
    let mut ei: i32 = 0;
    while ei < en {
        if slot_name_eq(vec_get(enums_names, ei), cty_handle, source, starts, ends) {
            return vec_get(enums_widths, ei);
        }
        ei = ei + 1;
    }
    return 1;
}

/* Slot type-category for typed-opcode selection (VMF-006): resolve a cty token
   handle to its sv0 source name and map f32/f64 -> 1 (float), i64/u64 -> 2
   (wide int), everything else -> 0 (int / default). Mirrors megaTU-main.sv0's
   megatu_cty_category but keyed on the sv0 type name rather than the emitted C
   type, since the VM emitter never resolves cty handles to C strings. Guards an
   out-of-range / synthetic-test handle to 0. Read by emit_expr in VMF-006c to
   pick ADD_F64/ADD_I64 vs ADD_I32; unused until then. */
fn cty_cat_of_handle(cty_h: i32, source: string,
                     starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    if slot_handle_in_range(cty_h, starts) != true { return 0; }
    let s: string = handle_to_str(cty_h, source, starts, ends);
    if string_eq(s, "f64") { return 1; }
    if string_eq(s, "f32") { return 1; }
    if string_eq(s, "i64") { return 2; }
    if string_eq(s, "u64") { return 2; }
    return 0;
}

fn width_of_cty_scalar(cty: string) -> i32 {
    if is_void_cty(cty) { return 0; }
    return 1;
}

fn width_of_cty_simple(cty: string) -> i32 {
    if is_void_cty(cty) { return 0; }
    return 1;
}

/* ── field index lookup ─────────────────────────────────────── */

fn index_of_field(fields: Vec<i32>, field_name: i32) -> i32 {
    let n: i32 = vec_len(fields);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(fields, i) == field_name {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn index_of_field_range(fields_flat: Vec<i32>, start: i32,
                        count: i32, name: i32,
                        source: string, starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    let mut i: i32 = 0;
    while i < count {
        if slot_name_eq(vec_get(fields_flat, start + i), name, source, starts, ends) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── enum field names ───────────────────────────────────────── */

fn enum_field_count(width: i32) -> i32 {
    if width <= 1 { return 1; }
    return width;
}

/* SML enumFieldNames: builds Vec of field-name handles for an enum
   with the given width.  Index 0 is always the tag handle; indices
   1..width-1 are payload slots "p0","p1",... represented as interned
   name handles.  Caller passes the interned handles for "tag" and
   "p0".."p<max>" directly since sv0 bootstrap cannot call an intern
   function across compilation units; this version builds a Vec of
   *indices* 0..width-1 where 0 = tag position and k>0 = payload k-1.
   The real field names are resolved by the caller using its pool. */
fn enum_field_names(width: i32) -> Vec<i32> {
    let out: Vec<i32> = vec_new();
    let mut i: i32 = 0;
    while i < width {
        vec_push(out, i);
        i = i + 1;
    }
    return out;
}

/* ── binop -> opcode ────────────────────────────────────────── */

fn binop_to_insn(op: string) -> i32 {
    if string_eq(op, "+") { return 16; }
    if string_eq(op, "-") { return 17; }
    if string_eq(op, "*") { return 18; }
    if string_eq(op, "/") { return 19; }
    if string_eq(op, "%") { return 20; }
    if string_eq(op, "==") { return 64; }
    if string_eq(op, "!=") { return 65; }
    if string_eq(op, "<") { return 66; }
    if string_eq(op, ">") { return 67; }
    if string_eq(op, "<=") { return 68; }
    if string_eq(op, ">=") { return 69; }
    if string_eq(op, "&&") { return 80; }
    if string_eq(op, "||") { return 81; }
    if string_eq(op, "&") { return 88; }
    if string_eq(op, "|") { return 89; }
    if string_eq(op, "^") { return 90; }
    if string_eq(op, "<<") { return 92; }
    if string_eq(op, ">>") { return 93; }
    return 0 - 1;
}

/* ── unop -> opcode ─────────────────────────────────────────── */

fn unop_to_insn(op: string) -> i32 {
    if string_eq(op, "!") { return 82; }
    if string_eq(op, "-") { return 21; }
    return 0 - 1;
}

/* ── instruction encoding length ────────────────────────────── */

/* Inline from bytecode.sv0 since each .sv0 compiles standalone. */
fn insn_size(opc: i32) -> i32 {
    if opc == 0 { return 1; }
    if opc == 1 { return 1; }
    if opc == 2 { return 1; }
    if opc == 3 { return 1; }
    if opc == 4 { return 5; }
    if opc == 5 { return 9; }
    if opc == 6 { return 9; }
    if opc == 7 { return 2; }
    if opc == 8 { return 5; }
    if opc >= 16 {
        if opc <= 21 { return 1; }
    }
    if opc >= 32 {
        if opc <= 37 { return 1; }
    }
    if opc >= 48 {
        if opc <= 52 { return 1; }
    }
    if opc >= 64 {
        if opc <= 69 { return 1; }
    }
    if opc >= 80 {
        if opc <= 82 { return 1; }
    }
    if opc >= 88 {
        if opc <= 93 { return 1; }
    }
    if opc == 96 { return 5; }
    if opc == 97 { return 5; }
    if opc == 112 { return 5; }
    if opc == 113 { return 5; }
    if opc == 114 { return 5; }
    if opc == 115 { return 9; }
    if opc == 116 { return 1; }
    if opc == 117 { return 5; }
    if opc == 118 { return 2; }
    if opc == 128 { return 5; }
    if opc == 129 { return 5; }
    if opc == 130 { return 5; }
    if opc == 131 { return 5; }
    if opc == 132 { return 1; }
    if opc == 133 { return 1; }
    if opc == 144 { return 13; }
    if opc == 145 { return 1; }
    if opc == 146 { return 5; }
    if opc == 160 { return 5; }
    if opc == 161 { return 5; }
    return 0;
}

fn enc_len(opcode: i32) -> i32 {
    return insn_size(opcode);
}

fn enc_lens(opcodes: Vec<i32>) -> i32 {
    let n: i32 = vec_len(opcodes);
    let mut total: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        total = total + insn_size(vec_get(opcodes, i));
        i = i + 1;
    }
    return total;
}

/* ── loop sentinel constants ────────────────────────────────── */

fn loop_exit_sentinel() -> i32 { return 0 - 987654321; }
fn loop_continue_sentinel() -> i32 { return 0 - 876543210; }
fn loop_break_sentinel() -> i32 { return 0 - 765432109; }

fn is_loop_exit_sentinel(v: i32) -> bool {
    return v == 0 - 987654321;
}

fn is_loop_continue_sentinel(v: i32) -> bool {
    return v == 0 - 876543210;
}

fn is_loop_break_sentinel(v: i32) -> bool {
    return v == 0 - 765432109;
}

/* ── string pool ────────────────────────────────────────────── */

fn pool_new() -> Vec<i32> {
    return vec_new();
}

/* Resolve a pool handle to the string VALUE used for deduplication, matching SML's
   value-keyed poolAdd. A string-literal token's span carries surrounding quotes
   (`"main"`); strip them so the literal `"main"` dedups against the `main` function
   name, as it does in SML. (Escapes are collapsed at encode time; the quote-stripped
   form is a consistent dedup key for the common no-escape case.) Empty source is the
   synthetic-test signal — fall back to handle identity there. */
fn pool_resolve(h: i32, source: string, starts: Vec<i32>, ends: Vec<i32>) -> string {
    let raw: string = handle_to_str(h, source, starts, ends);
    let n: i32 = string_len(raw);
    if n >= 2 {
        if string_char_at(raw, 0) == 34 {
            return string_substr(raw, 1, n - 2);
        }
    }
    return raw;
}

/* Two pool handles denote the same string iff they resolve to the same value.
   Resolve by source only when BOTH handles index the token arena (as with
   slot_name_eq); otherwise compare integers, so the synthetic low-level unit
   tests (which key the pool on bare integers, not real tokens) keep working. */
fn pool_key_eq(a: i32, b: i32, source: string,
               starts: Vec<i32>, ends: Vec<i32>) -> bool {
    if a == b { return true; }
    if string_len(source) == 0 { return false; }
    if slot_handle_in_range(a, starts) != true { return false; }
    if slot_handle_in_range(b, starts) != true { return false; }
    return string_eq(pool_resolve(a, source, starts, ends),
                     pool_resolve(b, source, starts, ends));
}

fn pool_add(pool: Vec<i32>, s: i32,
            source: string, starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    let n: i32 = vec_len(pool);
    let mut i: i32 = 0;
    while i < n {
        if pool_key_eq(vec_get(pool, i), s, source, starts, ends) {
            return i;
        }
        i = i + 1;
    }
    vec_push(pool, s);
    return n;
}

fn pool_size(pool: Vec<i32>) -> i32 {
    return vec_len(pool);
}

fn contract_pool_key(fn_h: i32, kind: i32) -> i32 {
    return 0 - (kind * 1000000 + fn_h + 1);
}

/* ── builtin function -> CALL_BUILTIN id ────────────────────── */

fn builtin_id(name: string) -> i32 {
    if string_eq(name, "sv0_println") { return 0; }
    if string_eq(name, "sv0_no_alias") { return 1; }
    if string_eq(name, "sv0_string_len") { return 2; }
    if string_eq(name, "sv0_string_eq") { return 3; }
    if string_eq(name, "sv0_string_concat") { return 4; }
    if string_eq(name, "sv0_string_char_at") { return 5; }
    if string_eq(name, "sv0_string_substr") { return 6; }
    if string_eq(name, "sv0_vec_new") { return 7; }
    if string_eq(name, "sv0_vec_push") { return 8; }
    if string_eq(name, "sv0_vec_len") { return 9; }
    if string_eq(name, "sv0_vec_get") { return 10; }
    if string_eq(name, "sv0_vec_set") { return 11; }
    if string_eq(name, "sv0_box_alloc") { return 12; }
    if string_eq(name, "sv0_box_store") { return 13; }
    if string_eq(name, "sv0_box_load") { return 14; }
    if string_eq(name, "sv0_read_file") { return 15; }
    if string_eq(name, "sv0_write_file") { return 16; }
    if string_eq(name, "sv0_read_dir") { return 17; }
    return 0 - 1;
}

fn is_builtin(name: string) -> bool {
    return builtin_id(name) >= 0;
}

fn builtin_has_result(name: string) -> bool {
    if string_eq(name, "sv0_println") { return false; }
    if string_eq(name, "sv0_vec_push") { return false; }
    if string_eq(name, "sv0_vec_set") { return false; }
    if string_eq(name, "sv0_box_store") { return false; }
    if string_eq(name, "sv0_write_file") { return false; }
    return true;
}

fn builtin_arg_count(name: string) -> i32 {
    if string_eq(name, "sv0_println") { return 1; }
    if string_eq(name, "sv0_no_alias") { return 0; }
    if string_eq(name, "sv0_string_len") { return 1; }
    if string_eq(name, "sv0_string_eq") { return 2; }
    if string_eq(name, "sv0_string_concat") { return 2; }
    if string_eq(name, "sv0_string_char_at") { return 2; }
    if string_eq(name, "sv0_string_substr") { return 3; }
    if string_eq(name, "sv0_vec_new") { return 0; }
    if string_eq(name, "sv0_vec_push") { return 2; }
    if string_eq(name, "sv0_vec_len") { return 1; }
    if string_eq(name, "sv0_vec_get") { return 2; }
    if string_eq(name, "sv0_vec_set") { return 3; }
    if string_eq(name, "sv0_box_alloc") { return 1; }
    if string_eq(name, "sv0_box_store") { return 3; }
    if string_eq(name, "sv0_box_load") { return 2; }
    if string_eq(name, "sv0_read_file") { return 1; }
    if string_eq(name, "sv0_write_file") { return 2; }
    if string_eq(name, "sv0_read_dir") { return 1; }
    return 0;
}

/* ── value width (SML valueWidth) ──────────────────────────── */

fn value_width_scalar() -> i32 { return 1; }

fn value_is_var(value_tag: i32) -> bool {
    return value_tag == 4;
}

fn value_width(value_tag: i32, var_name: i32,
               env_names: Vec<i32>, env_bases: Vec<i32>,
               env_widths: Vec<i32>) -> i32 {
    if value_tag == 4 {
        let idx: i32 = lookup_slot(env_names, env_bases, env_widths, var_name,
                                  "", vec_new(), vec_new());
        if idx >= 0 { return slot_width(env_widths, idx); }
    }
    return 1;
}

/* ── store ordering (multi-slot) ────────────────────────────── */

fn store_slot_offset(base: i32, width: i32, k: i32) -> i32 {
    return base + width - 1 - k;
}

/* ── slot environment lookup (SML lookupSlot) ──────────────── */

/* Two variable handles denote the same slot iff they resolve to the same NAME:
   the same source variable carries different token handles at its declaration and
   each use site (lower emits VVar/Assign with the use-site token), so a raw `==`
   compare misses — the C backend likewise resolves via handle_to_str. But not every
   handle is a source token: freshTmp temps are offset past the token arena (see
   lower_temp_base) and the synthetic low-level unit tests key the env on bare
   integers. So compare by source string only when BOTH handles index the token
   arena; otherwise compare integers. Temps (out of range) thus match by their
   stable counter value, real vars (in range) by name — exactly the intended
   discrimination, with no collision since temps sit far past the token count. */
fn slot_handle_in_range(h: i32, starts: Vec<i32>) -> bool {
    if h < 0 { return false; }
    return h < vec_len(starts);
}

fn slot_name_eq(a: i32, b: i32, source: string,
                starts: Vec<i32>, ends: Vec<i32>) -> bool {
    if a == b { return true; }
    if string_len(source) == 0 { return false; }
    if slot_handle_in_range(a, starts) != true { return false; }
    if slot_handle_in_range(b, starts) != true { return false; }
    return string_eq(handle_to_str(a, source, starts, ends),
                     handle_to_str(b, source, starts, ends));
}

fn lookup_slot(env_names: Vec<i32>, env_bases: Vec<i32>,
               env_widths: Vec<i32>, name: i32,
               source: string, starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    let n: i32 = vec_len(env_names);
    let mut i: i32 = n - 1;
    while i >= 0 {
        if slot_name_eq(vec_get(env_names, i), name, source, starts, ends) {
            return i;
        }
        i = i - 1;
    }
    return 0 - 1;
}

fn slot_base(env_bases: Vec<i32>, idx: i32) -> i32 {
    return vec_get(env_bases, idx);
}

fn slot_width(env_widths: Vec<i32>, idx: i32) -> i32 {
    return vec_get(env_widths, idx);
}

/* ── alloc_local (SML allocLocal / bindParam) ──────────────── */

fn alloc_local(env_names: Vec<i32>, env_bases: Vec<i32>,
               env_widths: Vec<i32>, name: i32, width: i32, slot: i32) -> i32 {
    vec_push(env_names, name);
    vec_push(env_bases, slot);
    vec_push(env_widths, width);
    return slot + width;
}

/* ── bind_param (SML bindParam) ──────────────────────────────
   Returns the new slot after binding.  Pushes name/base/width/fields
   into the env Vecs.  `fields` is a Vec<i32> of struct field handles
   (from struct layout) or enum synthetic field indices (from
   enum_field_names).  If cty matches neither struct nor enum, fields
   is empty. */
fn bind_param(name: i32, cty_handle: i32, slot: i32,
              env_names: Vec<i32>, env_bases: Vec<i32>,
              env_widths: Vec<i32>, env_fields: Vec<i32>,
              structs_names: Vec<i32>, structs_field_counts: Vec<i32>,
              enums_names: Vec<i32>, enums_widths: Vec<i32>) -> i32 {
    let w: i32 = width_of_cty(cty_handle, structs_names,
                               structs_field_counts, enums_names,
                               enums_widths, "", vec_new(), vec_new());
    vec_push(env_names, name);
    vec_push(env_bases, slot);
    vec_push(env_widths, w);
    vec_push(env_fields, vec_len(env_fields));
    return slot + w;
}

/* ── replace_loop_exit_jump (SML replaceLoopExitJump) ──────── */

fn replace_loop_exit_jump(instrs: Vec<i32>, back_offset: i32) -> bool {
    let n: i32 = vec_len(instrs);
    if n < 2 { return false; }
    let last_op: i32 = vec_get(instrs, n - 2);
    let last_arg: i32 = vec_get(instrs, n - 1);
    if last_op != 112 { return false; }
    if last_arg != loop_exit_sentinel() { return false; }
    vec_set(instrs, n - 1, back_offset);
    return true;
}

/* ── insn_vec_stride ───────────────────────────────────────────
   Number of i32 elements one instruction occupies in a flat Vec.
   Byte size → element count: 1→1, 2→2, 5→2, 9→3, 13→4.        */
fn insn_vec_stride(opc: i32) -> i32 {
    let bs: i32 = insn_size(opc);
    if bs <= 1 { return 1; }
    let payload: i32 = bs - 1;
    let slots: i32 = (payload + 3) / 4;
    return 1 + slots;
}

/* ── patch_continue_jumps (SML patchContinueJumpsFrom) ────────
   Walk a flat instruction Vec starting at byte position from_pos.
   For each JUMP (opcode 112) whose arg is the continue sentinel,
   replace the arg with (target_abs - (current_byte_pos + byte_len)).
   Byte positions use insn_size; Vec indices use insn_vec_stride. */
fn patch_continue_jumps(instrs: Vec<i32>, from_pos: i32,
                        target_abs: i32) -> i32 {
    let n: i32 = vec_len(instrs);
    let mut i: i32 = 0;
    let mut pos: i32 = from_pos;
    let mut patched: i32 = 0;
    while i < n {
        let op: i32 = vec_get(instrs, i);
        let byte_sz: i32 = insn_size(op);
        let stride: i32 = insn_vec_stride(op);
        if op == 112 {
            if i + 1 < n {
                let arg: i32 = vec_get(instrs, i + 1);
                if is_loop_continue_sentinel(arg) {
                    vec_set(instrs, i + 1, target_abs - (pos + byte_sz));
                    patched = patched + 1;
                }
            }
        }
        i = i + stride;
        pos = pos + byte_sz;
    }
    return patched;
}

/* ── patch_break_jumps ──────────────────────────────────────────
   Same scan as patch_continue_jumps but matches break sentinel.
   Each matching JUMP arg is replaced with
   (target_abs - (current_byte_pos + byte_len)). */
fn patch_break_jumps(instrs: Vec<i32>, from_pos: i32,
                     target_abs: i32) -> i32 {
    let n: i32 = vec_len(instrs);
    let mut i: i32 = 0;
    let mut pos: i32 = from_pos;
    let mut patched: i32 = 0;
    while i < n {
        let op: i32 = vec_get(instrs, i);
        let byte_sz: i32 = insn_size(op);
        let stride: i32 = insn_vec_stride(op);
        if op == 112 {
            if i + 1 < n {
                let arg: i32 = vec_get(instrs, i + 1);
                if is_loop_break_sentinel(arg) {
                    vec_set(instrs, i + 1, target_abs - (pos + byte_sz));
                    patched = patched + 1;
                }
            }
        }
        i = i + stride;
        pos = pos + byte_sz;
    }
    return patched;
}

/* ── struct_layouts_build / enum_layouts_build ─────────────── */

fn struct_layouts_build(item_tags: Vec<i32>, item_names: Vec<i32>,
                        item_field_counts: Vec<i32>,
                        out_names: Vec<i32>,
                        out_field_counts: Vec<i32>) -> i32 {
    let n: i32 = vec_len(item_tags);
    let mut count: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        if vec_get(item_tags, i) == 1 {
            vec_push(out_names, vec_get(item_names, i));
            vec_push(out_field_counts, vec_get(item_field_counts, i));
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

/* Parallel to struct_layouts_build (same struct iteration order): flatten each
   struct's field-name tokens into out_fields_flat, recording where each struct's
   run starts in out_field_starts. `item_field_bases[i]` is the struct's base into
   `struct_field_name_toks` (the parser's sfn / struct_field_name_toks). Used to
   populate a struct local's per-slot field layout so StoreField / FieldAccess can
   resolve field name -> slot offset (SML indexOfField). */
/* When a slot holds a struct value, record its field-name layout so field access
   resolves name -> offset. Finds the struct whose name matches `cty` (by resolved
   string — decl/use tokens differ), appends its field-name tokens to `env_fields_
   flat`, and returns the start index (the value stored in env_field_starts for
   this slot). A scalar/enum/unknown cty records nothing and returns 0. */
fn record_field_layout(cty: i32,
                       structs_names: Vec<i32>, structs_field_counts: Vec<i32>,
                       struct_fields_flat: Vec<i32>, struct_field_starts: Vec<i32>,
                       source: string, starts: Vec<i32>, ends: Vec<i32>,
                       env_fields_flat: Vec<i32>) -> i32 {
    let ns: i32 = vec_len(structs_names);
    let mut k: i32 = 0;
    while k < ns {
        if slot_name_eq(vec_get(structs_names, k), cty, source, starts, ends) {
            /* struct_field_starts is built parallel to structs_names in real emit;
               a synthetic test may leave it short, so guard before indexing. */
            if k >= vec_len(struct_field_starts) { return 0; }
            let fstart: i32 = vec_len(env_fields_flat);
            let fcount: i32 = vec_get(structs_field_counts, k);
            let sbase: i32 = vec_get(struct_field_starts, k);
            let mut j: i32 = 0;
            while j < fcount {
                vec_push(env_fields_flat, vec_get(struct_fields_flat, sbase + j));
                j = j + 1;
            }
            return fstart;
        }
        k = k + 1;
    }
    return 0;
}

fn struct_fields_build(item_tags: Vec<i32>, item_field_counts: Vec<i32>,
                       item_field_bases: Vec<i32>,
                       struct_field_name_toks: Vec<i32>,
                       out_fields_flat: Vec<i32>,
                       out_field_starts: Vec<i32>) -> i32 {
    let n: i32 = vec_len(item_tags);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(item_tags, i) == 1 {
            vec_push(out_field_starts, vec_len(out_fields_flat));
            let fc: i32 = vec_get(item_field_counts, i);
            let base: i32 = vec_get(item_field_bases, i);
            let mut k: i32 = 0;
            while k < fc {
                vec_push(out_fields_flat, vec_get(struct_field_name_toks, base + k));
                k = k + 1;
            }
        }
        i = i + 1;
    }
    return vec_len(out_field_starts);
}

fn enum_layouts_build(item_tags: Vec<i32>, item_names: Vec<i32>,
                      item_variant_counts: Vec<i32>,
                      item_variant_max_payload: Vec<i32>,
                      out_names: Vec<i32>,
                      out_widths: Vec<i32>) -> i32 {
    let n: i32 = vec_len(item_tags);
    let mut count: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        if vec_get(item_tags, i) == 2 {
            vec_push(out_names, vec_get(item_names, i));
            vec_push(out_widths, 1 + vec_get(item_variant_max_payload, i));
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

/* ── IR value and expression types (local; mirrors ir.sv0) ── */

/* Converged with lowering.sv0's IR ADT (D1b): the SML reference fed ONE shared
   Ir to both backends; the sv0 per-module split let vm_codegen's Value/Expr drift
   (skewed tags + VBool(bool)/VFloat/IndexAccess that lower never produces). These
   now match lowering.sv0 exactly (same variants, same order) so the native VM
   emitter can consume lower's boxed IR directly. */
enum Value {
    VInt(i32),
    VBoolTrue,
    VBoolFalse,
    VVar(i32),
    VUnit,
    VString(i32),
    VMember(Box<Value>, i32),
    VAddrOf(i32),
    /* Appended (tags 8, 9) to stay a prefix-compatible layout match with
       lowering.sv0's enum Value, which megaTU-main.sv0's VM tail reinterprets
       these boxes as via box_deref. lowering.sv0 added VFloat/VIntWide for the C
       backend (sv0-mathlib BUGS.md #5 / #1); this copy had drifted to 8 variants.
       h is the literal's source token handle (no eager numeric parse — same
       "print the source text verbatim" strategy as the C backend). Emission is
       deferred: VMF-005 only restores the ADT match; VMF-007 wires the bytes. */
    VFloat(i32),
    VIntWide(i32),
}

enum Expr {
    Literal(Box<Value>),
    Load(i32),
    Binop(i32, Box<Value>, Box<Value>),
    Unop(i32, Box<Value>),
    FieldAccess(Box<Value>, i32),
}

/* ── AST-tag → opcode helpers ───────────────────────────────
   lower() stores the operator as an AST binop/unop TAG (the flat i32 IR can't
   inline the operator string SML's Ir.Binop carries), so the VM emit must decode
   the tag directly — same tag numbering as lowering.sv0's ast_binop_to_c /
   ast_unop_to_c, composed with binop_to_insn / unop_to_insn's opcodes. (The
   binop_handle_to_insn / unop_handle_to_insn variants below resolve an operator
   from a source token span; kept for the string path but NOT used by emit_expr,
   which consumes lower's tags.) */
fn binop_tag_to_insn(tag: i32) -> i32 {
    if tag == 0 { return 16; }
    if tag == 1 { return 17; }
    if tag == 2 { return 18; }
    if tag == 3 { return 19; }
    if tag == 4 { return 20; }
    if tag == 5 { return 64; }
    if tag == 6 { return 65; }
    if tag == 7 { return 66; }
    if tag == 8 { return 67; }
    if tag == 9 { return 68; }
    if tag == 10 { return 69; }
    if tag == 11 { return 80; }
    if tag == 12 { return 81; }
    if tag == 13 { return 88; }
    if tag == 14 { return 89; }
    if tag == 15 { return 90; }
    if tag == 16 { return 92; }
    if tag == 17 { return 93; }
    return 0 - 1;
}

fn unop_tag_to_insn(tag: i32) -> i32 {
    if tag == 0 { return 21; }
    if tag == 1 { return 82; }
    return 0 - 1;
}

/* ── handle → operator string → opcode helpers ────────────── */

fn binop_handle_to_insn(op_h: i32, source: string,
                        starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    let s: i32 = vec_get(starts, op_h);
    let e: i32 = vec_get(ends, op_h);
    let op: string = string_substr(source, s, e - s);
    return binop_to_insn(op);
}

fn unop_handle_to_insn(op_h: i32, source: string,
                       starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    let s: i32 = vec_get(starts, op_h);
    let e: i32 = vec_get(ends, op_h);
    let op: string = string_substr(source, s, e - s);
    return unop_to_insn(op);
}

/* ── handle_to_str (resolve token handle to string) ─────────── */

fn handle_to_str(h: i32, source: string,
                 starts: Vec<i32>, ends: Vec<i32>) -> string {
    let s: i32 = vec_get(starts, h);
    let e: i32 = vec_get(ends, h);
    return string_substr(source, s, e - s);
}

/* ── index_of_fn (SML indexOfFn — fn name handle → table index) */

fn index_of_fn(fn_h: i32, fn_names: Vec<i32>,
               source: string, starts: Vec<i32>,
               ends: Vec<i32>) -> i32 {
    let target: string = handle_to_str(fn_h, source, starts, ends);
    let n: i32 = vec_len(fn_names);
    let mut i: i32 = 0;
    while i < n {
        let candidate: string = handle_to_str(vec_get(fn_names, i),
                                              source, starts, ends);
        if string_eq(target, candidate) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

/* ── emit_value (SML emitValue — IR value → bytecode) ────────
   Pushes instruction words into `out`.  Returns the number of
   Vec elements pushed, or -1 on error.
   VMember deferred — requires per-slot field name data. */

/* Enum field sentinels (lowering emits these for `match` extraction and enum
   construction): the tag is field -1 -> slot 0; payload i is field -10 - i ->
   slot i + 1 (SML enumFieldNames: "tag", "p0", "p1", …). A non-negative field is a
   struct field token and is resolved by name elsewhere, not here. */
fn member_offset_from_field(width: i32, field_h: i32) -> i32 {
    if width <= 0 { return 0 - 1; }
    let mut off: i32 = field_h;
    if field_h == 0 - 1 { off = 0; }
    if field_h <= 0 - 10 { off = (0 - 10 - field_h) + 1; }
    if off < 0 { return 0 - 1; }
    if off >= width { return 0 - 1; }
    return off;
}

fn emit_member_load_from_var(x: i32, field_h: i32,
                             env_names: Vec<i32>, env_bases: Vec<i32>,
                             env_widths: Vec<i32>,
                             env_field_starts: Vec<i32>, env_fields_flat: Vec<i32>,
                             source: string, starts: Vec<i32>, ends: Vec<i32>,
                             out: Vec<i32>) -> i32 {
    let si: i32 = lookup_slot(env_names, env_bases, env_widths, x,
                              source, starts, ends);
    if si < 0 { return 0 - 1; }
    let base: i32 = slot_base(env_bases, si);
    let width: i32 = slot_width(env_widths, si);
    /* Struct field name token (>=0) -> offset by name lookup in the slot's field
       layout; enum sentinels (<0) and the synthetic tests (which leave
       env_field_starts short) fall back to member_offset_from_field. */
    let mut off: i32 = member_offset_from_field(width, field_h);
    if field_h >= 0 {
        if si < vec_len(env_field_starts) {
            let fs: i32 = vec_get(env_field_starts, si);
            off = index_of_field_range(env_fields_flat, fs, width, field_h,
                                       source, starts, ends);
        }
    }
    if off < 0 { return 0 - 1; }
    vec_push(out, 96);
    vec_push(out, base + off);
    return 2;
}

fn emit_value(v: Value,
              env_names: Vec<i32>, env_bases: Vec<i32>,
              env_widths: Vec<i32>,
              env_field_starts: Vec<i32>, env_fields_flat: Vec<i32>,
              pool: Vec<i32>,
              source: string, starts: Vec<i32>, ends: Vec<i32>,
              out: Vec<i32>) -> i32 {
    match v {
        Value::VInt(n) => {
            vec_push(out, 4);
            vec_push(out, n);
            return 2;
        },
        Value::VBoolTrue => {
            vec_push(out, 7);
            vec_push(out, 1);
            return 2;
        },
        Value::VBoolFalse => {
            vec_push(out, 7);
            vec_push(out, 0);
            return 2;
        },
        Value::VString(s) => {
            let idx: i32 = pool_add(pool, s, source, starts, ends);
            vec_push(out, 8);
            vec_push(out, idx);
            return 2;
        },
        Value::VUnit => {
            vec_push(out, 3);
            return 1;
        },
        Value::VVar(x) => {
            let si: i32 = lookup_slot(env_names, env_bases, env_widths, x,
                                      source, starts, ends);
            if si < 0 { return 0 - 1; }
            let base: i32 = slot_base(env_bases, si);
            let width: i32 = slot_width(env_widths, si);
            let mut k: i32 = 0;
            while k < width {
                vec_push(out, 96);
                vec_push(out, base + k);
                k = k + 1;
            }
            return width * 2;
        },
        Value::VMember(bv, f) => {
            let base_v: Value = box_deref(bv);
            match base_v {
                Value::VVar(x) => {
                    return emit_member_load_from_var(x, f,
                                                     env_names, env_bases,
                                                     env_widths,
                                                     env_field_starts, env_fields_flat,
                                                     source, starts, ends, out);
                },
                Value::VInt(n) => { return 0 - 1; },
                Value::VBoolTrue => { return 0 - 1; },
                Value::VBoolFalse => { return 0 - 1; },
                Value::VString(s) => { return 0 - 1; },
                Value::VUnit => { return 0 - 1; },
                Value::VMember(bv2, f2) => { return 0 - 1; },
                Value::VAddrOf(h2) => { return 0 - 1; },
                Value::VFloat(h2) => { return 0 - 1; },
                Value::VIntWide(h2) => { return 0 - 1; },
            }
            return 0 - 1;
        },
        Value::VAddrOf(x) => {
            let si: i32 = lookup_slot(env_names, env_bases, env_widths, x,
                                      source, starts, ends);
            if si < 0 { return 0 - 1; }
            let base: i32 = slot_base(env_bases, si);
            vec_push(out, 4);
            vec_push(out, base);
            return 2;
        },
        /* Deferred to VMF-007: PUSH_F64 (op 6) / PUSH_I64 (op 5) as [opc, lo, hi]
           insn words. Returning -1 here means a float/wide literal makes
           emit_program fail cleanly (compose-main exit 5), same as before this
           variant existed. */
        Value::VFloat(h) => { return 0 - 1; },
        Value::VIntWide(h) => { return 0 - 1; },
    }
    return 0 - 1;
}

/* ── emit_expr (SML emitExpr — IR expression → bytecode) ─────
   Pushes instruction words into `out`.  Returns the number of
   Vec elements pushed, or -1 on error.
   FieldAccess and IndexAccess deferred. */

fn emit_expr(e: Expr,
             env_names: Vec<i32>, env_bases: Vec<i32>,
             env_widths: Vec<i32>,
             env_cats: Vec<i32>,
             env_field_starts: Vec<i32>, env_fields_flat: Vec<i32>,
             pool: Vec<i32>,
             source: string, starts: Vec<i32>, ends: Vec<i32>,
             out: Vec<i32>) -> i32 {
    match e {
        Expr::Literal(bv) => {
            let v: Value = box_deref(bv);
            return emit_value(v, env_names, env_bases, env_widths, env_field_starts, env_fields_flat, pool, source, starts, ends, out);
        },
        Expr::Load(x) => {
            let si: i32 = lookup_slot(env_names, env_bases, env_widths, x,
                                      source, starts, ends);
            if si < 0 { return 0 - 1; }
            let base: i32 = slot_base(env_bases, si);
            let width: i32 = slot_width(env_widths, si);
            let mut k: i32 = 0;
            while k < width {
                vec_push(out, 96);
                vec_push(out, base + k);
                k = k + 1;
            }
            return width * 2;
        },
        Expr::Binop(op_h, bv1, bv2) => {
            let v1: Value = box_deref(bv1);
            let v2: Value = box_deref(bv2);
            let n1: i32 = emit_value(v1, env_names, env_bases, env_widths, env_field_starts, env_fields_flat, pool, source, starts, ends, out);
            if n1 < 0 { return 0 - 1; }
            let n2: i32 = emit_value(v2, env_names, env_bases, env_widths, env_field_starts, env_fields_flat, pool, source, starts, ends, out);
            if n2 < 0 { return 0 - 1; }
            let opc: i32 = binop_tag_to_insn(op_h);
            vec_push(out, opc);
            return n1 + n2 + 1;
        },
        Expr::Unop(op_h, bv) => {
            let v: Value = box_deref(bv);
            let n: i32 = emit_value(v, env_names, env_bases, env_widths, env_field_starts, env_fields_flat, pool, source, starts, ends, out);
            if n < 0 { return 0 - 1; }
            let opc: i32 = unop_tag_to_insn(op_h);
            if opc >= 0 {
                vec_push(out, opc);
                return n + 1;
            }
            return n;
        },
        Expr::FieldAccess(bv, f) => {
            let base_v: Value = box_deref(bv);
            match base_v {
                Value::VVar(x) => {
                    return emit_member_load_from_var(x, f,
                                                     env_names, env_bases,
                                                     env_widths,
                                                     env_field_starts, env_fields_flat,
                                                     source, starts, ends, out);
                },
                Value::VInt(n) => { return 0 - 1; },
                Value::VBoolTrue => { return 0 - 1; },
                Value::VBoolFalse => { return 0 - 1; },
                Value::VString(s) => { return 0 - 1; },
                Value::VUnit => { return 0 - 1; },
                Value::VMember(bv2, f2) => { return 0 - 1; },
                Value::VAddrOf(h2) => { return 0 - 1; },
                Value::VFloat(h2) => { return 0 - 1; },
                Value::VIntWide(h2) => { return 0 - 1; },
            }
            return 0 - 1;
        },
    }
    return 0 - 1;
}

/* ── vec_append helper ────────────────────────────────────── */

fn vec_append(dst: Vec<i32>, src: Vec<i32>) -> i32 {
    let n: i32 = vec_len(src);
    let mut i: i32 = 0;
    while i < n {
        vec_push(dst, vec_get(src, i));
        i = i + 1;
    }
    return n;
}

/* ── flat_byte_size (total encoded byte size of flat insn Vec) ─
   Walks the Vec with insn_vec_stride (not element-by-element),
   summing insn_size for each opcode.  Used by IfElse for jump
   offset calculation. */

fn flat_byte_size(instrs: Vec<i32>) -> i32 {
    let n: i32 = vec_len(instrs);
    let mut total: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        let opc: i32 = vec_get(instrs, i);
        total = total + insn_size(opc);
        i = i + insn_vec_stride(opc);
    }
    return total;
}

/* ── emit_ret_width (value width for RETURN_SLOTS) ───────── */

fn emit_ret_width(v: Value,
                  env_names: Vec<i32>, env_bases: Vec<i32>,
                  env_widths: Vec<i32>,
                  source: string, starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    match v {
        Value::VVar(x) => {
            let si: i32 = lookup_slot(env_names, env_bases, env_widths, x,
                                      source, starts, ends);
            if si >= 0 { return slot_width(env_widths, si); }
            return 1;
        },
        Value::VInt(n) => { return 1; },
        Value::VBoolTrue => { return 1; },
        Value::VBoolFalse => { return 1; },
        Value::VString(s) => { return 1; },
        Value::VUnit => { return 1; },
        Value::VMember(bv, f) => { return 1; },
        Value::VAddrOf(h) => { return 1; },
        Value::VFloat(h) => { return 1; },
        Value::VIntWide(h) => { return 1; },
    }
    return 1;
}

/* ── IR instruction type (local; mirrors ir.sv0 / codegen.sv0) */

enum Instr {
    Nop,
    DeclVar(i32),
    DeclNamed(i32, i32),
    Assign(i32, Box<Expr>),
    Store(i32, Box<Expr>),
    StoreField(i32, i32, Box<Expr>),
    IfElse(Box<Expr>, Vec<i32>, Vec<i32>),
    WhileLoop(Box<Expr>, Vec<i32>),
    BlockInstr(Vec<i32>),
    Break,
    Continue,
    Call(i32, i32, Vec<i32>, i32),
    Requires(Box<Expr>, i32),
    Ensures(Box<Expr>, i32),
    ReturnVoid,
    ReturnVal(Box<Value>),
}

/* ── emit_instr (SML emitInstr — IR instruction → bytecode) ──
   Pushes instruction words into `out`.  Returns the number of
   Vec elements pushed, or -1 on error / deferred case.
   Implemented: Nop, DeclVar, DeclNamed, Assign, Store,
   ReturnVoid, ReturnVal, IfElse, BlockInstr, Call,
   WhileLoop, Break, Continue.
   WhileLoop emits cond + JUMP_IF_NOT + body + JUMP back-edge,
   with sentinel patching for break/continue.  Break/Continue
   emit JUMP with sentinel operands, patched by WhileLoop.
   All 16 Instr cases implemented.
   StoreField uses env_field_starts/env_fields_flat for per-slot
   field-name lookup.  Requires/Ensures use contract_pool_key to
   encode contract-message pool entries (decoded at serialisation). */

/* box_new(inner) multi-slot unpack (SML lowering boxNewFromValue +
   vm_codegen sv0_box_alloc/sv0_box_store).  sv0 lowering keeps box_new as a
   single builtin Call (bid 12) so the C backend can memcpy-box it; the VM,
   however, needs the SML flat form: box_alloc(W) then one box_store per slot.
   The box_new result temp (dst_h) is the same freshTmp SML allocates for the
   box handle, so slot numbering matches SML byte-for-byte with no lowering
   change.  For a struct/enum arg (a local, so VVar) each slot k copies
   inner[k] — SML emits box_store(h, k, VMember(va, field_k)) and VMember always
   resolves to slot base(va)+k, so a direct local-load is byte-identical and
   needs no enum/struct field data here.  A non-VVar (scalar literal) arg boxes
   as width 1 with the raw value.  Opcodes: PUSH_INT 4, LOAD_LOCAL 96,
   STORE_LOCAL 97, CALL_BUILTIN 117 (box_alloc=12, box_store=13). */
fn emit_box_new(dst_h: i32, args: Vec<i32>,
                env_names: Vec<i32>, env_bases: Vec<i32>, env_widths: Vec<i32>,
                env_field_starts: Vec<i32>, env_fields_flat: Vec<i32>,
                pool: Vec<i32>,
                source: string, starts: Vec<i32>, ends: Vec<i32>,
                out: Vec<i32>) -> i32 {
    if vec_len(args) < 1 { return 0 - 1; }
    let inner_v: Value = box_deref(vec_get(args, 0));
    let dsi: i32 = lookup_slot(env_names, env_bases, env_widths, dst_h,
                               source, starts, ends);
    if dsi < 0 { return 0 - 1; }
    let base_d: i32 = slot_base(env_bases, dsi);
    let mut is_var: i32 = 0;
    let mut base_in: i32 = 0;
    let mut w: i32 = 1;
    match inner_v {
        Value::VVar(x) => {
            let si: i32 = lookup_slot(env_names, env_bases, env_widths, x,
                                      source, starts, ends);
            if si < 0 { return 0 - 1; }
            base_in = slot_base(env_bases, si);
            w = slot_width(env_widths, si);
            is_var = 1;
        },
        Value::VInt(n) => { w = 1; },
        Value::VBoolTrue => { w = 1; },
        Value::VBoolFalse => { w = 1; },
        Value::VString(s) => { w = 1; },
        Value::VUnit => { w = 1; },
        Value::VMember(bv, f) => { w = 1; },
        Value::VAddrOf(h2) => { w = 1; },
        Value::VFloat(h2) => { w = 1; },
        Value::VIntWide(h2) => { w = 1; },
    }
    /* box_alloc(W): PUSH_INT W ; CALL_BUILTIN 12 ; STORE_LOCAL base_d */
    vec_push(out, 4);   vec_push(out, w);
    vec_push(out, 117); vec_push(out, 12);
    vec_push(out, 97);  vec_push(out, base_d);
    let mut total: i32 = 6;
    if is_var == 1 {
        let mut k: i32 = 0;
        while k < w {
            vec_push(out, 96);  vec_push(out, base_d);        /* LOAD box handle */
            vec_push(out, 4);   vec_push(out, k);             /* PUSH_INT k */
            vec_push(out, 96);  vec_push(out, base_in + k);   /* LOAD inner slot k */
            vec_push(out, 117); vec_push(out, 13);            /* CALL_BUILTIN box_store */
            total = total + 8;
            k = k + 1;
        }
    } else {
        /* scalar literal: box_store(h, 0, <raw value>) */
        vec_push(out, 96); vec_push(out, base_d);
        vec_push(out, 4);  vec_push(out, 0);
        let nv: i32 = emit_value(inner_v, env_names, env_bases, env_widths,
                                 env_field_starts, env_fields_flat, pool,
                                 source, starts, ends, out);
        if nv < 0 { return 0 - 1; }
        vec_push(out, 117); vec_push(out, 13);
        total = total + 4 + nv + 2;
    }
    return total;
}

fn emit_instr(ins: Instr,
              env_names: Vec<i32>, env_bases: Vec<i32>,
              env_widths: Vec<i32>,
              env_cats: Vec<i32>,
              env_field_starts: Vec<i32>, env_fields_flat: Vec<i32>,
              pool: Vec<i32>,
              source: string, starts: Vec<i32>, ends: Vec<i32>,
              fn_names: Vec<i32>,
              out: Vec<i32>) -> i32 {
    match ins {
        Instr::Nop => { return 0; },
        Instr::DeclVar(x) => { return 0; },
        Instr::DeclNamed(cty, x) => { return 0; },
        Instr::Assign(x, be) => {
            let e: Expr = box_deref(be);
            let n: i32 = emit_expr(e, env_names, env_bases, env_widths, env_cats, env_field_starts, env_fields_flat,
                                   pool, source, starts, ends, out);
            if n < 0 { return 0 - 1; }
            let si: i32 = lookup_slot(env_names, env_bases, env_widths, x,
                                      source, starts, ends);
            if si < 0 { return 0 - 1; }
            let base: i32 = slot_base(env_bases, si);
            let width: i32 = slot_width(env_widths, si);
            let mut k: i32 = 0;
            while k < width {
                vec_push(out, 97);
                vec_push(out, base + width - 1 - k);
                k = k + 1;
            }
            return n + width * 2;
        },
        Instr::Store(x, be) => {
            let e: Expr = box_deref(be);
            let n: i32 = emit_expr(e, env_names, env_bases, env_widths, env_cats, env_field_starts, env_fields_flat,
                                   pool, source, starts, ends, out);
            if n < 0 { return 0 - 1; }
            let si: i32 = lookup_slot(env_names, env_bases, env_widths, x,
                                      source, starts, ends);
            if si < 0 { return 0 - 1; }
            let base: i32 = slot_base(env_bases, si);
            let width: i32 = slot_width(env_widths, si);
            let mut k: i32 = 0;
            while k < width {
                vec_push(out, 97);
                vec_push(out, base + width - 1 - k);
                k = k + 1;
            }
            return n + width * 2;
        },
        Instr::StoreField(bh, fh, be) => {
            let e: Expr = box_deref(be);
            let ne: i32 = emit_expr(e, env_names, env_bases, env_widths, env_cats, env_field_starts, env_fields_flat,
                                    pool, source, starts, ends, out);
            if ne < 0 { return 0 - 1; }
            let si: i32 = lookup_slot(env_names, env_bases, env_widths, bh,
                                      source, starts, ends);
            if si < 0 { return 0 - 1; }
            let b0: i32 = slot_base(env_bases, si);
            let w: i32 = slot_width(env_widths, si);
            let mut off: i32 = member_offset_from_field(w, fh);
            if fh >= 0 {
                if si < vec_len(env_field_starts) {
                    let fs: i32 = vec_get(env_field_starts, si);
                    off = index_of_field_range(env_fields_flat, fs, w, fh,
                                               source, starts, ends);
                }
            }
            if off < 0 { return 0 - 1; }
            vec_push(out, 97);
            vec_push(out, b0 + off);
            return ne + 2;
        },
        Instr::IfElse(be, th, el) => {
            let cond: Expr = box_deref(be);
            let nc: i32 = emit_expr(cond, env_names, env_bases, env_widths, env_cats, env_field_starts, env_fields_flat,
                                    pool, source, starts, ends, out);
            if nc < 0 { return 0 - 1; }
            let then_out: Vec<i32> = vec_new();
            let nt: i32 = emit_instrs(th, env_names, env_bases, env_widths,
                                      env_cats,
                                      env_field_starts, env_fields_flat,
                                      pool, source, starts, ends,
                                      fn_names, then_out);
            if nt < 0 { return 0 - 1; }
            let else_out: Vec<i32> = vec_new();
            let ne: i32 = emit_instrs(el, env_names, env_bases, env_widths,
                                      env_cats,
                                      env_field_starts, env_fields_flat,
                                      pool, source, starts, ends,
                                      fn_names, else_out);
            if ne < 0 { return 0 - 1; }
            let off_else: i32 = flat_byte_size(then_out) + insn_size(112);
            let off_end: i32 = flat_byte_size(else_out);
            vec_push(out, 114);
            vec_push(out, off_else);
            let at: i32 = vec_append(out, then_out);
            vec_push(out, 112);
            vec_push(out, off_end);
            let ae: i32 = vec_append(out, else_out);
            return nc + 2 + at + 2 + ae;
        },
        Instr::WhileLoop(be, body) => {
            let cond: Expr = box_deref(be);
            let cond_out: Vec<i32> = vec_new();
            let nc: i32 = emit_expr(cond, env_names, env_bases, env_widths, env_cats, env_field_starts, env_fields_flat,
                                    pool, source, starts, ends, cond_out);
            if nc < 0 { return 0 - 1; }
            /* Pre-pool the body in SML emitLoopSeq order (continuation-first at
               each IfElse) so string-pool indices match SML --target=vm. Cond is
               already pooled above (SML pools condC first too); body dedups. */
            prepool_loop_seq(body, 0, env_names, env_bases, env_widths,
                             env_cats,
                             env_field_starts, env_fields_flat, pool,
                             source, starts, ends, fn_names);
            let body_out: Vec<i32> = vec_new();
            let nb: i32 = emit_instrs(body, env_names, env_bases, env_widths,
                                      env_cats,
                                      env_field_starts, env_fields_flat,
                                      pool, source, starts, ends,
                                      fn_names, body_out);
            if nb < 0 { return 0 - 1; }
            vec_push(body_out, 112);
            vec_push(body_out, loop_exit_sentinel());
            let cond_bytes: i32 = flat_byte_size(cond_out);
            let jif_bytes: i32 = insn_size(114);
            let body_bytes: i32 = flat_byte_size(body_out);
            let forward: i32 = body_bytes;
            let back: i32 = 0 - (cond_bytes + jif_bytes + body_bytes);
            replace_loop_exit_jump(body_out, back);
            let loop_out: Vec<i32> = vec_new();
            vec_append(loop_out, cond_out);
            vec_push(loop_out, 114);
            vec_push(loop_out, forward);
            vec_append(loop_out, body_out);
            let total_bytes: i32 = flat_byte_size(loop_out);
            patch_continue_jumps(loop_out, 0, 0);
            patch_break_jumps(loop_out, 0, total_bytes);
            let added: i32 = vec_append(out, loop_out);
            return added;
        },
        Instr::BlockInstr(body) => {
            return emit_instrs(body, env_names, env_bases, env_widths,
                               env_cats,
                               env_field_starts, env_fields_flat,
                               pool, source, starts, ends, fn_names, out);
        },
        Instr::Break => {
            vec_push(out, 112);
            vec_push(out, loop_break_sentinel());
            return 2;
        },
        Instr::Continue => {
            vec_push(out, 112);
            vec_push(out, loop_continue_sentinel());
            return 2;
        },
        Instr::Call(dst_h, fn_h, args, rt_h) => {
            /* Negative fn_h encodes CALL_BUILTIN id N as fn_h = 0 - N
               (see lowering.sv0 lower_tag_call: fn_sentinel = 0 - bid).
               Positive fn_h is a source token index resolved via handle_to_str. */
            let mut bid: i32 = 0 - 1;
            if fn_h < 0 {
                bid = 0 - fn_h;
                /* Remap lowering builtin ids to VM CALL_BUILTIN indices. Most
                   align (string/vec 2-11, file 15-18), but println is lowering id
                   1 while its VM index is 0, and box_deref is lowering id 13 while
                   its VM op is box_load = 14. box_new (12) is intercepted below;
                   no_alias (14) is resolved in lowering and never reaches here. */
                if bid == 1 { bid = 0; }
                if bid == 13 { bid = 14; }
                if bid == 21 { bid = 14; }
            } else {
                let fn_name: string = handle_to_str(fn_h, source, starts, ends);
                bid = builtin_id(fn_name);
            }
            /* box_new (lowering builtin id 12): unpack to box_alloc + per-slot
               box_store (SML flat VM form). The generic path below would mis-emit
               it as a single CALL_BUILTIN 12 over the multi-slot arg. */
            if bid == 12 {
                return emit_box_new(dst_h, args, env_names, env_bases, env_widths,
                                    env_field_starts, env_fields_flat, pool,
                                    source, starts, ends, out);
            }
            let nargs_vec: i32 = vec_len(args);
            let mut total: i32 = 0;
            if bid >= 0 {
                let mut ai: i32 = 0;
                while ai < nargs_vec {
                    let bv: Box<Value> = vec_get(args, ai);
                    let v: Value = box_deref(bv);
                    let nv: i32 = emit_value(v, env_names, env_bases,
                                             env_widths, env_field_starts, env_fields_flat, pool, source, starts, ends, out);
                    if nv < 0 { return 0 - 1; }
                    total = total + nv;
                    ai = ai + 1;
                }
                vec_push(out, 117);
                vec_push(out, bid);
                total = total + 2;
                if dst_h != 0 {
                    let si: i32 = lookup_slot(env_names, env_bases,
                                             env_widths, dst_h,
                                             source, starts, ends);
                    if si < 0 { return 0 - 1; }
                    let base: i32 = slot_base(env_bases, si);
                    let width: i32 = slot_width(env_widths, si);
                    let mut k: i32 = 0;
                    while k < width {
                        vec_push(out, 97);
                        vec_push(out, base + width - 1 - k);
                        k = k + 1;
                    }
                    total = total + width * 2;
                }
                return total;
            }
            let mut nargs_total: i32 = 0;
            let mut ai: i32 = 0;
            while ai < nargs_vec {
                let bv: Box<Value> = vec_get(args, ai);
                let v: Value = box_deref(bv);
                let w: i32 = emit_ret_width(v, env_names, env_bases,
                                            env_widths, source, starts, ends);
                nargs_total = nargs_total + w;
                let nv: i32 = emit_value(v, env_names, env_bases,
                                         env_widths, env_field_starts, env_fields_flat, pool, source, starts, ends, out);
                if nv < 0 { return 0 - 1; }
                total = total + nv;
                ai = ai + 1;
            }
            let fix: i32 = index_of_fn(fn_h, fn_names, source,
                                       starts, ends);
            if fix < 0 { return 0 - 1; }
            vec_push(out, 115);
            vec_push(out, fix);
            vec_push(out, nargs_total);
            total = total + 3;
            if dst_h != 0 {
                let si: i32 = lookup_slot(env_names, env_bases,
                                         env_widths, dst_h,
                                         source, starts, ends);
                if si < 0 { return 0 - 1; }
                let base: i32 = slot_base(env_bases, si);
                let width: i32 = slot_width(env_widths, si);
                let mut k: i32 = 0;
                while k < width {
                    vec_push(out, 97);
                    vec_push(out, base + width - 1 - k);
                    k = k + 1;
                }
                total = total + width * 2;
            }
            return total;
        },
        Instr::Requires(be, fn_h) => {
            let e: Expr = box_deref(be);
            let ne: i32 = emit_expr(e, env_names, env_bases, env_widths, env_cats, env_field_starts, env_fields_flat,
                                    pool, source, starts, ends, out);
            if ne < 0 { return 0 - 1; }
            let key: i32 = contract_pool_key(fn_h, 0);
            let pidx: i32 = pool_add(pool, key, source, starts, ends);
            vec_push(out, 160);
            vec_push(out, pidx);
            return ne + 2;
        },
        Instr::Ensures(be, fn_h) => {
            let e: Expr = box_deref(be);
            let ne: i32 = emit_expr(e, env_names, env_bases, env_widths, env_cats, env_field_starts, env_fields_flat,
                                    pool, source, starts, ends, out);
            if ne < 0 { return 0 - 1; }
            let key: i32 = contract_pool_key(fn_h, 1);
            let pidx: i32 = pool_add(pool, key, source, starts, ends);
            vec_push(out, 160);
            vec_push(out, pidx);
            return ne + 2;
        },
        Instr::ReturnVoid => {
            vec_push(out, 118);
            vec_push(out, 0);
            return 2;
        },
        Instr::ReturnVal(bv) => {
            let v: Value = box_deref(bv);
            let w: i32 = emit_ret_width(v, env_names, env_bases, env_widths, source, starts, ends);
            let n: i32 = emit_value(v, env_names, env_bases, env_widths, env_field_starts, env_fields_flat, pool, source, starts, ends, out);
            if n < 0 { return 0 - 1; }
            vec_push(out, 118);
            vec_push(out, w);
            return n + 2;
        },
    }
    return 0 - 1;
}

/* ── emit_instrs (SML emitBlock — iterate Box<Instr> Vec) ────
   Each element of `instrs` is a Box<Instr> handle.
   Returns total Vec elements pushed to `out`. */

fn emit_instrs(instrs: Vec<i32>,
               env_names: Vec<i32>, env_bases: Vec<i32>,
               env_widths: Vec<i32>,
               env_cats: Vec<i32>,
               env_field_starts: Vec<i32>, env_fields_flat: Vec<i32>,
               pool: Vec<i32>,
               source: string, starts: Vec<i32>, ends: Vec<i32>,
               fn_names: Vec<i32>,
               out: Vec<i32>) -> i32 {
    let count: i32 = vec_len(instrs);
    let mut total: i32 = 0;
    let mut idx: i32 = 0;
    while idx < count {
        let bh: Box<Instr> = vec_get(instrs, idx);
        let ins: Instr = box_deref(bh);
        let n: i32 = emit_instr(ins, env_names, env_bases, env_widths,
                                env_cats,
                                env_field_starts, env_fields_flat,
                                pool, source, starts, ends, fn_names, out);
        if n < 0 { return 0 - 1; }
        total = total + n;
        idx = idx + 1;
    }
    return total;
}

/* ── prepool_loop_seq (matches SML emitLoopSeq/emitLoopStmt POOL ORDER) ──
   SML's emitLoopStmt (vm_codegen.sml) for an IfElse inside a loop body
   evaluates the CONTINUATION first (to size break jumps), so poolAdd runs in
   the order continuation -> else -> then -> cond — reversed from natural
   emission. Native's sentinel-based loop emitter (Instr::WhileLoop) emits in
   natural order, giving different string-pool INDICES (same bytecode). This
   pre-pass walks a WhileLoop body in SML's emitLoopSeq order, calling the real
   emit_expr/emit_instr into a THROWAWAY buffer purely for the pool_add side
   effect; the subsequent real emission dedups, so byte output is unchanged and
   only the pool order is corrected. Non-IfElse statements keep natural order. */
fn prepool_loop_seq(instrs: Vec<i32>, i0: i32,
                    env_names: Vec<i32>, env_bases: Vec<i32>,
                    env_widths: Vec<i32>,
                    env_cats: Vec<i32>,
                    env_field_starts: Vec<i32>, env_fields_flat: Vec<i32>,
                    pool: Vec<i32>,
                    source: string, starts: Vec<i32>, ends: Vec<i32>,
                    fn_names: Vec<i32>) -> i32 {
    if i0 >= vec_len(instrs) { return 0; }
    let bh: Box<Instr> = vec_get(instrs, i0);
    let ins: Instr = box_deref(bh);
    match ins {
        Instr::IfElse(be, th, el) => {
            /* emitLoopStmt IfElse: contCode = cont() FIRST, then else, then, cond */
            prepool_loop_seq(instrs, i0 + 1, env_names, env_bases, env_widths,
                             env_cats,
                             env_field_starts, env_fields_flat, pool,
                             source, starts, ends, fn_names);
            prepool_loop_seq(el, 0, env_names, env_bases, env_widths,
                             env_cats,
                             env_field_starts, env_fields_flat, pool,
                             source, starts, ends, fn_names);
            prepool_loop_seq(th, 0, env_names, env_bases, env_widths,
                             env_cats,
                             env_field_starts, env_fields_flat, pool,
                             source, starts, ends, fn_names);
            let ce_if: Expr = box_deref(be);
            let cscratch: Vec<i32> = vec_new();
            emit_expr(ce_if, env_names, env_bases, env_widths,
                      env_cats,
                      env_field_starts, env_fields_flat, pool,
                      source, starts, ends, cscratch);
            return 0;
        },
        Instr::WhileLoop(be, body) => {
            /* emitLoopStmt While: emitWhileLoop (cond then body-seq) THEN cont() */
            let ce_wh: Expr = box_deref(be);
            let cscratch: Vec<i32> = vec_new();
            emit_expr(ce_wh, env_names, env_bases, env_widths,
                      env_cats,
                      env_field_starts, env_fields_flat, pool,
                      source, starts, ends, cscratch);
            prepool_loop_seq(body, 0, env_names, env_bases, env_widths,
                             env_cats,
                             env_field_starts, env_fields_flat, pool,
                             source, starts, ends, fn_names);
            prepool_loop_seq(instrs, i0 + 1, env_names, env_bases, env_widths,
                             env_cats,
                             env_field_starts, env_fields_flat, pool,
                             source, starts, ends, fn_names);
            return 0;
        },
        Instr::BlockInstr(body) => {
            /* emitLoopStmt Block: emitLoopSeq xs cont — the block's stmts join the
               sequence, then the outer continuation. Approximate by pooling the
               block body in loop order, then the continuation. */
            prepool_loop_seq(body, 0, env_names, env_bases, env_widths,
                             env_cats,
                             env_field_starts, env_fields_flat, pool,
                             source, starts, ends, fn_names);
            prepool_loop_seq(instrs, i0 + 1, env_names, env_bases, env_widths,
                             env_cats,
                             env_field_starts, env_fields_flat, pool,
                             source, starts, ends, fn_names);
            return 0;
        },
        Instr::Continue => {
            /* emitLoopSeq Continue: terminates the sequence (rest not emitted). */
            return 0;
        },
        _ => {
            /* Any other instr (Store/Assign/StoreField/Call/Break/…): emitInstr in
               natural order (pool side effect), then the continuation. Break falls
               here — SML still pools the rest, so continue to i0+1. */
            let scratch: Vec<i32> = vec_new();
            emit_instr(ins, env_names, env_bases, env_widths,
                       env_cats,
                       env_field_starts, env_fields_flat, pool,
                       source, starts, ends, fn_names, scratch);
            prepool_loop_seq(instrs, i0 + 1, env_names, env_bases, env_widths,
                             env_cats,
                             env_field_starts, env_fields_flat, pool,
                             source, starts, ends, fn_names);
            return 0;
        },
    }
    return 0;
}

/* ── ensure_var_int (SML ensureVarInt) ─────────────────────────
   If `name` is not already in the env, add it with width = 1 and
   no fields (field_start points to current end of env_fields_flat).
   Returns (possibly updated) next_slot. */
fn ensure_var_int(name: i32,
                  env_names: Vec<i32>, env_bases: Vec<i32>,
                  env_widths: Vec<i32>, env_cats: Vec<i32>, env_field_starts: Vec<i32>,
                  next_slot: i32,
                  source: string, starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    let si: i32 = lookup_slot(env_names, env_bases, env_widths, name,
                              source, starts, ends);
    if si >= 0 { return next_slot; }
    vec_push(env_names, name);
    vec_push(env_bases, next_slot);
    vec_push(env_widths, 1);
    vec_push(env_cats, 0);
    vec_push(env_field_starts, 0);
    return next_slot + 1;
}

/* ── scan_instr_env (SML scanInstr) ──────────────────────────
   Walk one instruction for env-building (slot allocation).
   Handles DeclVar, DeclNamed, Assign, Call (with dest),
   IfElse/WhileLoop/BlockInstr (recurse), rest are no-ops.
   Returns updated next_slot. */
fn scan_instr_env(ins: Instr,
                  env_names: Vec<i32>, env_bases: Vec<i32>,
                  env_widths: Vec<i32>, env_cats: Vec<i32>, env_field_starts: Vec<i32>,
                  next_slot: i32,
                  structs_names: Vec<i32>, structs_field_counts: Vec<i32>,
                  enums_names: Vec<i32>, enums_widths: Vec<i32>,
                  structs_fields_flat: Vec<i32>, structs_field_starts: Vec<i32>,
                  env_fields_flat: Vec<i32>,
                  source: string, starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    match ins {
        Instr::DeclVar(x) => {
            return ensure_var_int(x, env_names, env_bases, env_widths,
                                 env_cats,
                                 env_field_starts, next_slot,
                                 source, starts, ends);
        },
        Instr::DeclNamed(cty, x) => {
            let w: i32 = width_of_cty(cty, structs_names,
                                       structs_field_counts,
                                       enums_names, enums_widths,
                                       source, starts, ends);
            vec_push(env_names, x);
            vec_push(env_bases, next_slot);
            vec_push(env_widths, w);
            vec_push(env_cats, cty_cat_of_handle(cty, source, starts, ends));
            vec_push(env_field_starts,
                     record_field_layout(cty, structs_names, structs_field_counts,
                                         structs_fields_flat, structs_field_starts,
                                         source, starts, ends, env_fields_flat));
            return next_slot + w;
        },
        Instr::Assign(x, be) => {
            return ensure_var_int(x, env_names, env_bases, env_widths,
                                 env_cats,
                                 env_field_starts, next_slot,
                                 source, starts, ends);
        },
        Instr::Call(dst, fn_h, args, rty) => {
            if dst == 0 { return next_slot; }
            let w0: i32 = width_of_cty(rty, structs_names,
                                        structs_field_counts,
                                        enums_names, enums_widths,
                                        source, starts, ends);
            let w: i32 = if w0 < 1 { 1 } else { w0 };
            vec_push(env_names, dst);
            vec_push(env_bases, next_slot);
            vec_push(env_widths, w);
            vec_push(env_cats, cty_cat_of_handle(rty, source, starts, ends));
            vec_push(env_field_starts,
                     record_field_layout(rty, structs_names, structs_field_counts,
                                         structs_fields_flat, structs_field_starts,
                                         source, starts, ends, env_fields_flat));
            return next_slot + w;
        },
        Instr::IfElse(be, th, el) => {
            let ns1: i32 = scan_instrs_env(th, env_names, env_bases,
                                           env_widths, env_cats, env_field_starts,
                                           next_slot,
                                           structs_names, structs_field_counts,
                                           enums_names, enums_widths,
                                           structs_fields_flat, structs_field_starts,
                                           env_fields_flat,
                                           source, starts, ends);
            return scan_instrs_env(el, env_names, env_bases,
                                  env_widths, env_cats, env_field_starts, ns1,
                                  structs_names, structs_field_counts,
                                  enums_names, enums_widths,
                                  structs_fields_flat, structs_field_starts,
                                  env_fields_flat,
                                  source, starts, ends);
        },
        Instr::WhileLoop(be, body) => {
            return scan_instrs_env(body, env_names, env_bases,
                                  env_widths, env_cats, env_field_starts,
                                  next_slot,
                                  structs_names, structs_field_counts,
                                  enums_names, enums_widths,
                                  structs_fields_flat, structs_field_starts,
                                  env_fields_flat,
                                  source, starts, ends);
        },
        Instr::BlockInstr(body) => {
            return scan_instrs_env(body, env_names, env_bases,
                                  env_widths, env_cats, env_field_starts,
                                  next_slot,
                                  structs_names, structs_field_counts,
                                  enums_names, enums_widths,
                                  structs_fields_flat, structs_field_starts,
                                  env_fields_flat,
                                  source, starts, ends);
        },
        Instr::Nop => { return next_slot; },
        Instr::Store(x, be) => { return next_slot; },
        Instr::StoreField(bh, fh, be) => { return next_slot; },
        Instr::Break => { return next_slot; },
        Instr::Continue => { return next_slot; },
        Instr::Requires(be, fn_h) => { return next_slot; },
        Instr::Ensures(be, fn_h) => { return next_slot; },
        Instr::ReturnVoid => { return next_slot; },
        Instr::ReturnVal(bv) => { return next_slot; },
    }
    return next_slot;
}

/* ── scan_instrs_env (iterate Box<Instr> Vec for env scan) ──── */
fn scan_instrs_env(instrs: Vec<i32>,
                   env_names: Vec<i32>, env_bases: Vec<i32>,
                   env_widths: Vec<i32>, env_cats: Vec<i32>, env_field_starts: Vec<i32>,
                   next_slot: i32,
                   structs_names: Vec<i32>, structs_field_counts: Vec<i32>,
                   enums_names: Vec<i32>, enums_widths: Vec<i32>,
                   structs_fields_flat: Vec<i32>, structs_field_starts: Vec<i32>,
                   env_fields_flat: Vec<i32>,
                   source: string, starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    let n: i32 = vec_len(instrs);
    let mut ns: i32 = next_slot;
    let mut i: i32 = 0;
    while i < n {
        let bh: Box<Instr> = vec_get(instrs, i);
        let ins: Instr = box_deref(bh);
        ns = scan_instr_env(ins, env_names, env_bases, env_widths,
                            env_cats,
                            env_field_starts, ns,
                            structs_names, structs_field_counts,
                            enums_names, enums_widths,
                            structs_fields_flat, structs_field_starts,
                            env_fields_flat,
                            source, starts, ends);
        i = i + 1;
    }
    return ns;
}

/* ── local_count_and_env (SML localCountAndEnv) ──────────────
   Binds block parameters, then scans all instructions to allocate
   local variable slots.  Populates env_names/env_bases/env_widths/
   env_field_starts (field_starts = 0 placeholders; real field data
   deferred to emitFn when struct field name storage is available).
   Returns the total local slot count. */
fn local_count_and_env(param_names: Vec<i32>, param_ctys: Vec<i32>,
                       instrs: Vec<i32>,
                       env_names: Vec<i32>, env_bases: Vec<i32>,
                       env_widths: Vec<i32>,
                       env_cats: Vec<i32>,
                       env_field_starts: Vec<i32>,
                       structs_names: Vec<i32>,
                       structs_field_counts: Vec<i32>,
                       enums_names: Vec<i32>,
                       enums_widths: Vec<i32>,
                       structs_fields_flat: Vec<i32>, structs_field_starts: Vec<i32>,
                       env_fields_flat: Vec<i32>,
                       source: string, starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    let np: i32 = vec_len(param_names);
    let mut ns: i32 = 0;
    let mut pi: i32 = 0;
    while pi < np {
        let pn: i32 = vec_get(param_names, pi);
        let pc: i32 = vec_get(param_ctys, pi);
        let w: i32 = width_of_cty(pc, structs_names, structs_field_counts,
                                   enums_names, enums_widths,
                                   source, starts, ends);
        vec_push(env_names, pn);
        vec_push(env_bases, ns);
        vec_push(env_widths, w);
        vec_push(env_cats, cty_cat_of_handle(pc, source, starts, ends));
        vec_push(env_field_starts,
                 record_field_layout(pc, structs_names, structs_field_counts,
                                     structs_fields_flat, structs_field_starts,
                                     source, starts, ends, env_fields_flat));
        ns = ns + w;
        pi = pi + 1;
    }
    return scan_instrs_env(instrs, env_names, env_bases, env_widths,
                           env_cats,
                           env_field_starts, ns,
                           structs_names, structs_field_counts,
                           enums_names, enums_widths,
                           structs_fields_flat, structs_field_starts,
                           env_fields_flat,
                           source, starts, ends);
}

/* ── compute_arity (SML arity calculation in emitFn) ──────────
   Sum of widthOfCty for each parameter type. */
fn compute_arity(param_ctys: Vec<i32>,
                 structs_names: Vec<i32>,
                 structs_field_counts: Vec<i32>,
                 enums_names: Vec<i32>,
                 enums_widths: Vec<i32>,
                 source: string, starts: Vec<i32>, ends: Vec<i32>) -> i32 {
    let np: i32 = vec_len(param_ctys);
    let mut total: i32 = 0;
    let mut i: i32 = 0;
    while i < np {
        total = total + width_of_cty(vec_get(param_ctys, i),
                                      structs_names, structs_field_counts,
                                      enums_names, enums_widths,
                                      source, starts, ends);
        i = i + 1;
    }
    return total;
}

/* ── emit_fn (SML emitFn) ────────────────────────────────────
   Function-level orchestration: builds env via local_count_and_env,
   emits bytecode via emit_instrs, computes arity, pools the label,
   and appends a stride-4 function entry to ft_entries:
     [+0] nameIdx  (pool index for the function name)
     [+1] arity    (sum of param widths)
     [+2] localCount
     [+3] code     (Vec<i32> handle — flat opcode/payload words)
   Returns 0 on success, -1 on emission error. */
fn emit_fn(label: i32,
           param_names: Vec<i32>, param_ctys: Vec<i32>,
           instrs: Vec<i32>,
           structs_names: Vec<i32>, structs_field_counts: Vec<i32>,
           enums_names: Vec<i32>, enums_widths: Vec<i32>,
           structs_fields_flat: Vec<i32>, structs_field_starts: Vec<i32>,
           pool: Vec<i32>,
           source: string, starts: Vec<i32>, ends: Vec<i32>,
           fn_names: Vec<i32>,
           ft_entries: Vec<i32>) -> i32 {
    let en: Vec<i32> = vec_new();
    let eb: Vec<i32> = vec_new();
    let ew: Vec<i32> = vec_new();
    let ec: Vec<i32> = vec_new();
    let efs: Vec<i32> = vec_new();
    let eff: Vec<i32> = vec_new();
    let lc: i32 = local_count_and_env(param_names, param_ctys,
                                       instrs, en, eb, ew, ec, efs,
                                       structs_names, structs_field_counts,
                                       enums_names, enums_widths,
                                       structs_fields_flat, structs_field_starts,
                                       eff,
                                       source, starts, ends);
    let code: Vec<i32> = vec_new();
    let n: i32 = emit_instrs(instrs, en, eb, ew, ec, efs, eff,
                              pool, source, starts, ends, fn_names, code);
    if n < 0 { return 0 - 1; }
    let arity: i32 = compute_arity(param_ctys, structs_names,
                                    structs_field_counts,
                                    enums_names, enums_widths,
                                    source, starts, ends);
    let name_idx: i32 = pool_add(pool, label, source, starts, ends);
    vec_push(ft_entries, name_idx);
    vec_push(ft_entries, arity);
    vec_push(ft_entries, lc);
    vec_push(ft_entries, code);
    return 0;
}

/* ── is_main_label (SML isMain) ────────────────────────────── */
fn is_main_label(label: i32, source: string,
                 starts: Vec<i32>, ends: Vec<i32>) -> bool {
    let s: string = handle_to_str(label, source, starts, ends);
    return string_eq(s, "main");
}

/* ── build_func_order (SML funcOrder) ─────────────────────────
   Populates `order` with block indices: non-main first, main last.
   Returns the count of ordered functions. */
fn build_func_order(block_labels: Vec<i32>, source: string,
                    starts: Vec<i32>, ends: Vec<i32>,
                    order: Vec<i32>) -> i32 {
    let n: i32 = vec_len(block_labels);
    let mut main_idx: i32 = 0 - 1;
    let mut i: i32 = 0;
    while i < n {
        let lab: i32 = vec_get(block_labels, i);
        if is_main_label(lab, source, starts, ends) {
            main_idx = i;
        } else {
            vec_push(order, i);
        }
        i = i + 1;
    }
    if main_idx >= 0 {
        vec_push(order, main_idx);
    }
    return vec_len(order);
}

/* ── emit_program (SML VmCodegen.emit — top-level) ────────────
   Program-level orchestration: builds struct/enum layouts from AST
   items, reorders blocks (main last), builds fn_names table, emits
   all functions via emit_fn.  Populates `out_pool` with the string
   pool token handles and `out_ft` with the stride-4 function table
   (see emit_fn).  The caller is responsible for encoding the pool
   via encode_strings and assembling the final bytecode via
   encode_file — those live in bytecode.sv0, a separate compilation
   unit the SML driver already links.
   Returns the function count on success, or -1 on error. */
fn emit_program(item_tags: Vec<i32>, item_names: Vec<i32>,
                item_field_counts: Vec<i32>,
                item_variant_max_payload: Vec<i32>,
                item_field_bases: Vec<i32>,
                struct_field_name_toks: Vec<i32>,
                block_labels: Vec<i32>,
                block_param_names: Vec<i32>,
                block_param_ctys: Vec<i32>,
                block_instrs: Vec<i32>,
                source: string, starts: Vec<i32>, ends: Vec<i32>,
                out_pool: Vec<i32>, out_ft: Vec<i32>) -> i32 {
    let sn: Vec<i32> = vec_new();
    let sfc: Vec<i32> = vec_new();
    struct_layouts_build(item_tags, item_names, item_field_counts,
                         sn, sfc);
    let sff: Vec<i32> = vec_new();
    let sfs: Vec<i32> = vec_new();
    struct_fields_build(item_tags, item_field_counts, item_field_bases,
                        struct_field_name_toks, sff, sfs);
    let enn: Vec<i32> = vec_new();
    let enw: Vec<i32> = vec_new();
    enum_layouts_build(item_tags, item_names, item_field_counts,
                       item_variant_max_payload, enn, enw);
    let func_order: Vec<i32> = vec_new();
    let fc: i32 = build_func_order(block_labels, source,
                                    starts, ends, func_order);
    let fn_names: Vec<i32> = vec_new();
    let mut fi: i32 = 0;
    while fi < fc {
        let bi: i32 = vec_get(func_order, fi);
        vec_push(fn_names, vec_get(block_labels, bi));
        fi = fi + 1;
    }
    fi = 0;
    while fi < fc {
        let bi2: i32 = vec_get(func_order, fi);
        let pn: Vec<i32> = vec_get(block_param_names, bi2);
        let pc: Vec<i32> = vec_get(block_param_ctys, bi2);
        let ins: Vec<i32> = vec_get(block_instrs, bi2);
        let lab: i32 = vec_get(block_labels, bi2);
        let r: i32 = emit_fn(lab, pn, pc, ins,
                              sn, sfc, enn, enw,
                              sff, sfs,
                              out_pool, source, starts, ends,
                              fn_names, out_ft);
        if r < 0 { return 0 - 1; }
        fi = fi + 1;
    }
    return fc;
}

/* ── tests ──────────────────────────────────────────────────── */

fn test_variant_slots() -> i32 {
    if variant_slots(0, 0) != 0 { return 1; }
    if variant_slots(1, 3) != 3 { return 2; }
    if variant_slots(2, 2) != 2 { return 3; }
    if variant_slots_unit() != 0 { return 4; }
    if variant_slots_tuple(5) != 5 { return 5; }
    return 0;
}

fn test_cty_classify() -> i32 {
    if is_void_cty("void") != true { return 1; }
    if is_void_cty("int32_t") != false { return 2; }
    if is_scalar_cty("bool") != true { return 3; }
    if is_scalar_cty("int32_t") != true { return 4; }
    if is_scalar_cty("uint8_t") != true { return 5; }
    if is_scalar_cty("MyStruct") != false { return 6; }
    if width_of_cty_scalar("void") != 0 { return 7; }
    if width_of_cty_scalar("int32_t") != 1 { return 8; }
    if width_of_cty_scalar("bool") != 1 { return 9; }
    return 0;
}

fn test_width_of_cty() -> i32 {
    let sn: Vec<i32> = vec_new();
    let sf: Vec<i32> = vec_new();
    let en: Vec<i32> = vec_new();
    let ew: Vec<i32> = vec_new();
    let ec: Vec<i32> = vec_new();
    vec_push(sn, 100); vec_push(sf, 3);
    vec_push(sn, 200); vec_push(sf, 5);
    vec_push(en, 300); vec_push(ew, 4);
    if width_of_cty(100, sn, sf, en, ew, "", vec_new(), vec_new()) != 3 { return 1; }
    if width_of_cty(200, sn, sf, en, ew, "", vec_new(), vec_new()) != 5 { return 2; }
    if width_of_cty(300, sn, sf, en, ew, "", vec_new(), vec_new()) != 4 { return 3; }
    if width_of_cty(999, sn, sf, en, ew, "", vec_new(), vec_new()) != 1 { return 4; }
    return 0;
}

fn test_enum_field_helpers() -> i32 {
    if enum_field_count_from_width(4) != 4 { return 1; }
    if enum_field_is_tag(0) != true { return 2; }
    if enum_field_is_tag(1) != false { return 3; }
    if enum_payload_field_index(1) != 0 { return 4; }
    if enum_payload_field_index(3) != 2 { return 5; }
    return 0;
}

fn test_layout_lookup() -> i32 {
    let names: Vec<i32> = vec_new();
    let widths: Vec<i32> = vec_new();
    vec_push(names, 10); vec_push(widths, 3);
    vec_push(names, 20); vec_push(widths, 7);
    if layout_lookup(names, widths, 10) != 3 { return 1; }
    if layout_lookup(names, widths, 20) != 7 { return 2; }
    if layout_lookup(names, widths, 99) != 0 - 1 { return 3; }
    return 0;
}

fn test_index_of_field() -> i32 {
    let fields: Vec<i32> = vec_new();
    vec_push(fields, 10);
    vec_push(fields, 20);
    vec_push(fields, 30);
    if index_of_field(fields, 10) != 0 { return 1; }
    if index_of_field(fields, 20) != 1 { return 2; }
    if index_of_field(fields, 30) != 2 { return 3; }
    if index_of_field(fields, 99) != 0 - 1 { return 4; }
    return 0;
}

fn test_binop_to_insn() -> i32 {
    if binop_to_insn("+") != 16 { return 1; }
    if binop_to_insn("-") != 17 { return 2; }
    if binop_to_insn("*") != 18 { return 3; }
    if binop_to_insn("==") != 64 { return 4; }
    if binop_to_insn("!=") != 65 { return 5; }
    if binop_to_insn("<") != 66 { return 6; }
    if binop_to_insn("&&") != 80 { return 7; }
    if binop_to_insn("&") != 88 { return 8; }
    if binop_to_insn("<<") != 92 { return 9; }
    if binop_to_insn(">>") != 93 { return 10; }
    if binop_to_insn("??") != 0 - 1 { return 11; }
    return 0;
}

fn test_unop_to_insn() -> i32 {
    if unop_to_insn("!") != 82 { return 1; }
    if unop_to_insn("-") != 21 { return 2; }
    if unop_to_insn("~") != 0 - 1 { return 3; }
    return 0;
}

fn test_enc_len() -> i32 {
    if enc_len(0) != 1 { return 1; }
    if enc_len(4) != 5 { return 2; }
    if enc_len(5) != 9 { return 3; }
    if enc_len(115) != 9 { return 4; }
    if enc_len(144) != 13 { return 5; }
    let opcodes: Vec<i32> = vec_new();
    vec_push(opcodes, 0);
    vec_push(opcodes, 4);
    vec_push(opcodes, 116);
    if enc_lens(opcodes) != 7 { return 6; }
    return 0;
}

fn test_sentinels() -> i32 {
    if is_loop_exit_sentinel(loop_exit_sentinel()) != true { return 1; }
    if is_loop_continue_sentinel(loop_continue_sentinel()) != true { return 2; }
    if is_loop_exit_sentinel(0) != false { return 3; }
    if is_loop_continue_sentinel(0) != false { return 4; }
    if loop_exit_sentinel() == loop_continue_sentinel() { return 5; }
    return 0;
}

fn test_pool() -> i32 {
    let pool: Vec<i32> = pool_new();
    let i0: i32 = pool_add(pool, 100, "", vec_new(), vec_new());
    if i0 != 0 { return 1; }
    let i1: i32 = pool_add(pool, 200, "", vec_new(), vec_new());
    if i1 != 1 { return 2; }
    let i0b: i32 = pool_add(pool, 100, "", vec_new(), vec_new());
    if i0b != 0 { return 3; }
    if pool_size(pool) != 2 { return 4; }
    return 0;
}

fn test_builtin_id() -> i32 {
    if builtin_id("sv0_println") != 0 { return 1; }
    if builtin_id("sv0_string_len") != 2 { return 2; }
    if builtin_id("sv0_vec_new") != 7 { return 3; }
    if builtin_id("sv0_box_load") != 14 { return 4; }
    if builtin_id("sv0_read_file") != 15 { return 5; }
    if builtin_id("sv0_write_file") != 16 { return 6; }
    if builtin_id("sv0_read_dir") != 17 { return 7; }
    if builtin_id("unknown") != 0 - 1 { return 8; }
    if is_builtin("sv0_println") != true { return 9; }
    if is_builtin("foo") != false { return 10; }
    if builtin_has_result("sv0_println") != false { return 11; }
    if builtin_has_result("sv0_string_len") != true { return 12; }
    if builtin_arg_count("sv0_println") != 1 { return 13; }
    if builtin_arg_count("sv0_string_substr") != 3 { return 14; }
    return 0;
}

fn test_store_ordering() -> i32 {
    if store_slot_offset(10, 3, 0) != 12 { return 1; }
    if store_slot_offset(10, 3, 1) != 11 { return 2; }
    if store_slot_offset(10, 3, 2) != 10 { return 3; }
    if store_slot_offset(0, 1, 0) != 0 { return 4; }
    return 0;
}

fn test_lookup_slot() -> i32 {
    let names: Vec<i32> = vec_new();
    let bases: Vec<i32> = vec_new();
    let widths: Vec<i32> = vec_new();
    vec_push(names, 10); vec_push(bases, 0); vec_push(widths, 1);
    vec_push(names, 20); vec_push(bases, 1); vec_push(widths, 3);
    if lookup_slot(names, bases, widths, 10, "", vec_new(), vec_new()) != 0 { return 1; }
    if lookup_slot(names, bases, widths, 20, "", vec_new(), vec_new()) != 1 { return 2; }
    if lookup_slot(names, bases, widths, 99, "", vec_new(), vec_new()) != 0 - 1 { return 3; }
    if slot_base(bases, 1) != 1 { return 4; }
    if slot_width(widths, 1) != 3 { return 5; }
    return 0;
}

fn test_alloc_local() -> i32 {
    let names: Vec<i32> = vec_new();
    let bases: Vec<i32> = vec_new();
    let widths: Vec<i32> = vec_new();
    let s1: i32 = alloc_local(names, bases, widths, 10, 1, 0);
    if s1 != 1 { return 1; }
    let s2: i32 = alloc_local(names, bases, widths, 20, 3, 1);
    if s2 != 4 { return 2; }
    if vec_len(names) != 2 { return 3; }
    if slot_base(bases, 0) != 0 { return 4; }
    if slot_width(widths, 1) != 3 { return 5; }
    return 0;
}

fn test_replace_loop_exit() -> i32 {
    let instrs: Vec<i32> = vec_new();
    vec_push(instrs, 112);
    vec_push(instrs, loop_exit_sentinel());
    if replace_loop_exit_jump(instrs, 42) != true { return 1; }
    if vec_get(instrs, 1) != 42 { return 2; }
    let bad: Vec<i32> = vec_new();
    vec_push(bad, 112);
    vec_push(bad, 999);
    if replace_loop_exit_jump(bad, 42) != false { return 3; }
    let empty: Vec<i32> = vec_new();
    if replace_loop_exit_jump(empty, 42) != false { return 4; }
    return 0;
}

