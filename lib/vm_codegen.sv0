fn test_emit_value() -> i32 {
    let en: Vec<i32> = vec_new();
    let eb: Vec<i32> = vec_new();
    let ew: Vec<i32> = vec_new();
    let ec: Vec<i32> = vec_new();
    let pool: Vec<i32> = vec_new();
    let out: Vec<i32> = vec_new();
    let vi: Value = Value::VInt(42);
    let r1: i32 = emit_value(vi, en, eb, ew, vec_new(), vec_new(), pool, "", vec_new(), vec_new(), out);
    if r1 != 2 { return 1; }
    if vec_get(out, 0) != 4 { return 2; }
    if vec_get(out, 1) != 42 { return 3; }
    let out2: Vec<i32> = vec_new();
    let vb: Value = Value::VBoolTrue;
    let r2: i32 = emit_value(vb, en, eb, ew, vec_new(), vec_new(), pool, "", vec_new(), vec_new(), out2);
    if r2 != 2 { return 4; }
    if vec_get(out2, 0) != 7 { return 5; }
    if vec_get(out2, 1) != 1 { return 6; }
    let out3: Vec<i32> = vec_new();
    let vbf: Value = Value::VBoolFalse;
    let r2b: i32 = emit_value(vbf, en, eb, ew, vec_new(), vec_new(), pool, "", vec_new(), vec_new(), out3);
    if r2b != 2 { return 7; }
    if vec_get(out3, 1) != 0 { return 8; }
    let out4: Vec<i32> = vec_new();
    let vu: Value = Value::VUnit;
    let r3: i32 = emit_value(vu, en, eb, ew, vec_new(), vec_new(), pool, "", vec_new(), vec_new(), out4);
    if r3 != 1 { return 9; }
    if vec_get(out4, 0) != 3 { return 10; }
    let out5: Vec<i32> = vec_new();
    let vs: Value = Value::VString(99);
    let r4: i32 = emit_value(vs, en, eb, ew, vec_new(), vec_new(), pool, "", vec_new(), vec_new(), out5);
    if r4 != 2 { return 11; }
    if vec_get(out5, 0) != 8 { return 12; }
    if vec_get(out5, 1) != 0 { return 13; }
    vec_push(en, 50); vec_push(eb, 2); vec_push(ew, 1);
    let out6: Vec<i32> = vec_new();
    let vv: Value = Value::VVar(50);
    let r5: i32 = emit_value(vv, en, eb, ew, vec_new(), vec_new(), pool, "", vec_new(), vec_new(), out6);
    if r5 != 2 { return 14; }
    if vec_get(out6, 0) != 96 { return 15; }
    if vec_get(out6, 1) != 2 { return 16; }
    vec_push(en, 60); vec_push(eb, 5); vec_push(ew, 3);
    let out7: Vec<i32> = vec_new();
    let vv2: Value = Value::VVar(60);
    let r6: i32 = emit_value(vv2, en, eb, ew, vec_new(), vec_new(), pool, "", vec_new(), vec_new(), out7);
    if r6 != 6 { return 17; }
    if vec_get(out7, 0) != 96 { return 18; }
    if vec_get(out7, 1) != 5 { return 19; }
    if vec_get(out7, 2) != 96 { return 20; }
    if vec_get(out7, 3) != 6 { return 21; }
    if vec_get(out7, 4) != 96 { return 22; }
    if vec_get(out7, 5) != 7 { return 23; }
    let out8: Vec<i32> = vec_new();
    let va: Value = Value::VAddrOf(50);
    let r7: i32 = emit_value(va, en, eb, ew, vec_new(), vec_new(), pool, "", vec_new(), vec_new(), out8);
    if r7 != 2 { return 24; }
    if vec_get(out8, 0) != 4 { return 25; }
    if vec_get(out8, 1) != 2 { return 26; }
    let out9: Vec<i32> = vec_new();
    let vm0: Value = Value::VMember(box_new(Value::VVar(60)), 0);
    let r8: i32 = emit_value(vm0, en, eb, ew, vec_new(), vec_new(), pool, "", vec_new(), vec_new(), out9);
    if r8 != 2 { return 27; }
    if vec_get(out9, 0) != 96 { return 28; }
    if vec_get(out9, 1) != 5 { return 29; }
    let out10: Vec<i32> = vec_new();
    let vm_tag: Value = Value::VMember(box_new(Value::VVar(60)), 0 - 1);
    let r9: i32 = emit_value(vm_tag, en, eb, ew, vec_new(), vec_new(), pool, "", vec_new(), vec_new(), out10);
    if r9 != 2 { return 30; }
    if vec_get(out10, 0) != 96 { return 31; }
    if vec_get(out10, 1) != 5 { return 32; }
    let out11: Vec<i32> = vec_new();
    let vm_oob: Value = Value::VMember(box_new(Value::VVar(60)), 3);
    let r10: i32 = emit_value(vm_oob, en, eb, ew, vec_new(), vec_new(), pool, "", vec_new(), vec_new(), out11);
    if r10 != 0 - 1 { return 33; }
    return 0;
}

fn test_emit_expr() -> i32 {
    let en: Vec<i32> = vec_new();
    let eb: Vec<i32> = vec_new();
    let ew: Vec<i32> = vec_new();
    let ec: Vec<i32> = vec_new();
    let pool: Vec<i32> = vec_new();
    let source: string = "+-!i32";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 1);
    vec_push(starts, 1); vec_push(ends, 2);
    vec_push(starts, 2); vec_push(ends, 3);
    vec_push(starts, 3); vec_push(ends, 6);
    let out1: Vec<i32> = vec_new();
    let lit: Expr = Expr::Literal(box_new(Value::VInt(7)));
    let r1: i32 = emit_expr(lit, en, eb, ew, ec, vec_new(), vec_new(), pool, source, starts, ends, out1);
    if r1 != 2 { return 1; }
    if vec_get(out1, 0) != 4 { return 2; }
    if vec_get(out1, 1) != 7 { return 3; }
    let out2: Vec<i32> = vec_new();
    let binop: Expr = Expr::Binop(0, box_new(Value::VInt(3)), box_new(Value::VInt(4)));
    let r2: i32 = emit_expr(binop, en, eb, ew, ec, vec_new(), vec_new(), pool, source, starts, ends, out2);
    if r2 != 5 { return 4; }
    if vec_get(out2, 0) != 4 { return 5; }
    if vec_get(out2, 1) != 3 { return 6; }
    if vec_get(out2, 2) != 4 { return 7; }
    if vec_get(out2, 3) != 4 { return 8; }
    if vec_get(out2, 4) != 16 { return 9; }
    let out3: Vec<i32> = vec_new();
    let unop_not: Expr = Expr::Unop(1, box_new(Value::VBoolTrue));
    let r3: i32 = emit_expr(unop_not, en, eb, ew, ec, vec_new(), vec_new(), pool, source, starts, ends, out3);
    if r3 != 3 { return 10; }
    if vec_get(out3, 0) != 7 { return 11; }
    if vec_get(out3, 1) != 1 { return 12; }
    if vec_get(out3, 2) != 82 { return 13; }
    let out4: Vec<i32> = vec_new();
    let unop_neg: Expr = Expr::Unop(0, box_new(Value::VInt(5)));
    let r4: i32 = emit_expr(unop_neg, en, eb, ew, ec, vec_new(), vec_new(), pool, source, starts, ends, out4);
    if r4 != 3 { return 14; }
    if vec_get(out4, 0) != 4 { return 15; }
    if vec_get(out4, 1) != 5 { return 16; }
    if vec_get(out4, 2) != 21 { return 17; }
    vec_push(en, 70); vec_push(eb, 0); vec_push(ew, 1);
    let out5: Vec<i32> = vec_new();
    let load: Expr = Expr::Load(70);
    let r5: i32 = emit_expr(load, en, eb, ew, ec, vec_new(), vec_new(), pool, source, starts, ends, out5);
    if r5 != 2 { return 18; }
    if vec_get(out5, 0) != 96 { return 19; }
    if vec_get(out5, 1) != 0 { return 20; }
    let out6: Vec<i32> = vec_new();
    let unop_cast: Expr = Expr::Unop(99, box_new(Value::VInt(9)));
    let r6: i32 = emit_expr(unop_cast, en, eb, ew, ec, vec_new(), vec_new(), pool, source, starts, ends, out6);
    if r6 != 2 { return 21; }
    if vec_get(out6, 0) != 4 { return 22; }
    if vec_get(out6, 1) != 9 { return 23; }
    vec_push(en, 80); vec_push(eb, 4); vec_push(ew, 3);
    let out7: Vec<i32> = vec_new();
    let f0: Expr = Expr::FieldAccess(box_new(Value::VVar(80)), 0);
    let r7: i32 = emit_expr(f0, en, eb, ew, ec, vec_new(), vec_new(), pool, source, starts, ends, out7);
    if r7 != 2 { return 24; }
    if vec_get(out7, 0) != 96 { return 25; }
    if vec_get(out7, 1) != 4 { return 26; }
    let out8: Vec<i32> = vec_new();
    let ftag: Expr = Expr::FieldAccess(box_new(Value::VVar(80)), 0 - 1);
    let r8: i32 = emit_expr(ftag, en, eb, ew, ec, vec_new(), vec_new(), pool, source, starts, ends, out8);
    if r8 != 2 { return 27; }
    if vec_get(out8, 0) != 96 { return 28; }
    if vec_get(out8, 1) != 4 { return 29; }
    let out9: Vec<i32> = vec_new();
    let foob: Expr = Expr::FieldAccess(box_new(Value::VVar(80)), 3);
    let r9: i32 = emit_expr(foob, en, eb, ew, ec, vec_new(), vec_new(), pool, source, starts, ends, out9);
    if r9 != 0 - 1 { return 30; }
    return 0;
}

