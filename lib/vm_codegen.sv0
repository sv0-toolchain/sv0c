fn test_patch_continue_jumps() -> i32 {
    let instrs: Vec<i32> = vec_new();
    vec_push(instrs, 112);
    vec_push(instrs, loop_continue_sentinel());
    let n: i32 = patch_continue_jumps(instrs, 0, 100);
    if n != 1 { return 1; }
    if vec_get(instrs, 1) != 95 { return 2; }
    let i2: Vec<i32> = vec_new();
    vec_push(i2, 0);
    vec_push(i2, 112);
    vec_push(i2, loop_continue_sentinel());
    let n2: i32 = patch_continue_jumps(i2, 10, 50);
    if n2 != 1 { return 3; }
    if vec_get(i2, 2) != 34 { return 4; }
    let i3: Vec<i32> = vec_new();
    vec_push(i3, 112);
    vec_push(i3, 42);
    let n3: i32 = patch_continue_jumps(i3, 0, 100);
    if n3 != 0 { return 5; }
    if vec_get(i3, 1) != 42 { return 6; }
    let empty: Vec<i32> = vec_new();
    let n4: i32 = patch_continue_jumps(empty, 0, 100);
    if n4 != 0 { return 7; }
    return 0;
}

