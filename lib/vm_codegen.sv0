fn test_emit_instrs() -> i32 {
    let en: Vec<i32> = vec_new();
    let eb: Vec<i32> = vec_new();
    let ew: Vec<i32> = vec_new();
    let ec: Vec<i32> = vec_new();
    let efs: Vec<i32> = vec_new();
    let eff: Vec<i32> = vec_new();
    let pool: Vec<i32> = vec_new();
    let fns: Vec<i32> = vec_new();
    let source: string = "+";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 1);
    let empty: Vec<i32> = vec_new();
    let out1: Vec<i32> = vec_new();
    let r1: i32 = emit_instrs(empty, en, eb, ew, ec, efs, eff, pool, source, starts, ends, fns, out1);
    if r1 != 0 { return 1; }
    if vec_len(out1) != 0 { return 2; }
    let instrs: Vec<i32> = vec_new();
    vec_push(instrs, box_new(Instr::Nop));
    vec_push(instrs, box_new(Instr::ReturnVoid));
    let out2: Vec<i32> = vec_new();
    let r2: i32 = emit_instrs(instrs, en, eb, ew, ec, efs, eff, pool, source, starts, ends, fns, out2);
    if r2 != 2 { return 3; }
    if vec_len(out2) != 2 { return 4; }
    if vec_get(out2, 0) != 118 { return 5; }
    if vec_get(out2, 1) != 0 { return 6; }
    vec_push(en, 70); vec_push(eb, 0); vec_push(ew, 1);
    vec_push(efs, 0);
    let instrs2: Vec<i32> = vec_new();
    let a_e: Expr = Expr::Literal(box_new(Value::VInt(99)));
    vec_push(instrs2, box_new(Instr::Assign(70, box_new(a_e))));
    vec_push(instrs2, box_new(Instr::ReturnVal(box_new(Value::VVar(70)))));
    let out3: Vec<i32> = vec_new();
    let r3: i32 = emit_instrs(instrs2, en, eb, ew, ec, efs, eff, pool, source, starts, ends, fns, out3);
