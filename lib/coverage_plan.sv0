/* Coverage planner (sv0cov CV-107; SPEC 13.1, 13.2; planning conventions in
 * sv0cov docs/planning-conventions.md).
 *
 * Runs once per build after resolve/check and before lowering, over the parse
 * arenas, so the generated-C and VM backends share one plan (COV-MAP-001).
 * This slice plans sources, function entities, and their `function_entry`
 * points; regions (CV-108) and branch outcomes (CV-109) extend the same side
 * tables.
 *
 * Side tables are keyed by AST item handle and hold spans as byte offsets
 * into the compiled source (the concat of the build's files; see
 * lib/coverage_source.sv0):
 *   sources:  src_unit[k] = listing unit of source index k (sorted by logical
 *             path, bytewise)
 *   entities: ent_item, ent_source, ent_start, ent_end (end exclusive),
 *             ent_owner (the entity whose function owns it; a function owns
 *             itself); cov_plan_functions returns the qualified names, one
 *             per line
 *   points:   pt_kind (1 = function_entry), pt_entity, pt_start, pt_end
 *
 * A function entity is a `fn` item with a body (parser item tag 0, body root
 * id4 >= 0): free functions, methods of `impl` blocks, and trait methods with
 * a default body. `#[extern_c]` declarations and bodyless trait methods are
 * not entities. The span runs from the `fn` keyword through the body's
 * closing `}`. The qualified name is the function name, prefixed by the
 * `impl` self type or trait name for a method, and by the file's
 * `module a::b;` path when it has one (`a::b::Type::name`). sv0 has no nested
 * functions yet, so every function's owner is itself.
 *
 * Depends on lib/coverage_source.sv0. Names are prefixed cov_plan_ because
 * compiler modules share one translation unit.
 */

fn cov_plan_tag(tags: Vec<i32>, i: i32) -> i32 {
    if i < 0 { return 0 - 1; }
    if i >= vec_len(tags) { return 0 - 1; }
    return vec_get(tags, i);
}

fn cov_plan_tok_text(source: string, starts: Vec<i32>, ends: Vec<i32>, t: i32) -> string {
    let s: i32 = vec_get(starts, t);
    return string_substr(source, s, vec_get(ends, t) - s);
}

/* Index of the body's closing `}` for the fn whose name token is `name_tok`:
 * the first `{` outside parentheses and brackets opens the body (contract
 * clauses are parenthesized), then braces are matched. -1 when the signature
 * ends in `;` first or the tokens run out. */
fn cov_plan_body_end(tags: Vec<i32>, name_tok: i32) -> i32 {
    let n: i32 = vec_len(tags);
    let mut i: i32 = name_tok + 1;
    let mut depth: i32 = 0;
    let mut open: i32 = 0 - 1;
    while open < 0 {
        if i >= n { return 0 - 1; }
        let t: i32 = vec_get(tags, i);
        if t == 6 { depth = depth + 1; }
        if t == 10 { depth = depth + 1; }
        if t == 7 { depth = depth - 1; }
        if t == 11 { depth = depth - 1; }
        if depth == 0 {
            if t == 13 { return 0 - 1; }
            if t == 8 { open = i; }
        }
        i = i + 1;
    }
    let mut braces: i32 = 1;
    while braces > 0 {
        if i >= n { return 0 - 1; }
        let t2: i32 = vec_get(tags, i);
        if t2 == 8 { braces = braces + 1; }
        if t2 == 9 { braces = braces - 1; }
        if braces == 0 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

/* Self-type name token of the `impl` block whose first method's `fn` keyword
 * is at `fn_tok`: the type after `for` in `impl Trait for Type`, else the
 * first type token after `impl` and its optional `<...>` parameters. */
fn cov_plan_impl_type_tok(tags: Vec<i32>, fn_tok: i32) -> i32 {
    let mut k: i32 = fn_tok - 1;
    while k >= 0 {
        if vec_get(tags, k) == 69 {
            let mut j: i32 = k + 1;
            if cov_plan_tag(tags, j) == 38 {
                let mut angle: i32 = 0;
                let mut scanning: bool = true;
                while scanning {
                    let t: i32 = cov_plan_tag(tags, j);
                    if t < 0 { return 0 - 1; }
                    if t == 38 { angle = angle + 1; }
                    if t == 39 { angle = angle - 1; }
                    j = j + 1;
                    if angle == 0 { scanning = false; }
                }
            }
            let mut ty: i32 = j;
            let mut q: i32 = j;
            while q < fn_tok {
                let tq: i32 = vec_get(tags, q);
                if tq == 8 { return ty; }
                if tq == 66 { ty = q + 1; }
                q = q + 1;
            }
            return ty;
        }
        k = k - 1;
    }
    return 0 - 1;
}

/* Bytewise `a < b`. */
fn cov_plan_str_lt(a: string, b: string) -> bool {
    let na: i32 = string_len(a);
    let nb: i32 = string_len(b);
    let mut i: i32 = 0;
    while i < na {
        if i >= nb { return false; }
        let ca: i32 = string_char_at(a, i);
        let cb: i32 = string_char_at(b, i);
        if ca != cb { return ca < cb; }
        i = i + 1;
    }
    return na < nb;
}

/* Line `idx` (0-based) of newline-separated `text`. */
fn cov_plan_line_at(text: string, idx: i32) -> string {
    return cov_src_field(text, idx, 0);
}

/* Fill src_unit with listing units sorted by logical path (the table's
 * first field). Returns the unit count. */
fn cov_plan_sources(table: string, src_unit: Vec<i32>) -> i32 {
    let n: i32 = cov_src_count(table);
    let mut u: i32 = 0;
    while u < n {
        vec_push(src_unit, u);
        let mut k: i32 = vec_len(src_unit) - 1;
        let mut moving: bool = true;
        while moving {
            if k == 0 {
                moving = false;
            } else {
                let prev: i32 = vec_get(src_unit, k - 1);
                if cov_plan_str_lt(cov_src_path_at(table, u), cov_src_path_at(table, prev)) {
                    vec_set(src_unit, k, prev);
                    vec_set(src_unit, k - 1, u);
                    k = k - 1;
                } else {
                    moving = false;
                }
            }
        }
        u = u + 1;
    }
    return n;
}

/* Qualified-name prefix text for `module a::b;` whose path segment tokens
 * are pp[base .. base + segs): "a::b::". */
fn cov_plan_module_prefix(source: string, starts: Vec<i32>, ends: Vec<i32>, pp: Vec<i32>,
                          base: i32, segs: i32) -> string {
    let mut path: string = "";
    let mut s: i32 = 0;
    while s < segs {
        path = string_concat(string_concat(path, cov_plan_tok_text(source, starts, ends, vec_get(pp, base + s))), "::");
        s = s + 1;
    }
    return path;
}

/* Plan function entities and function_entry points. `cstarts`/`clens` are
 * the per-unit concat offsets from cov_src_table_build; `src_unit` comes from
 * cov_plan_sources. Qualified names are appended to the returned text, one
 * per line, in entity order. Returns "\n<error>" (a qualified name never
 * starts with LF) when a function's span cannot be recovered. */
fn cov_plan_functions(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>, source: string,
                      it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>, id4: Vec<i32>, pp: Vec<i32>,
                      cstarts: Vec<i32>, clens: Vec<i32>, src_unit: Vec<i32>,
                      ent_item: Vec<i32>, ent_source: Vec<i32>, ent_start: Vec<i32>,
                      ent_end: Vec<i32>, ent_owner: Vec<i32>,
                      pt_kind: Vec<i32>, pt_entity: Vec<i32>, pt_start: Vec<i32>,
                      pt_end: Vec<i32>) -> string {
    let nsrc: i32 = vec_len(src_unit);
    let n_items: i32 = vec_len(it);

    /* Per item: the container name token of a method (the impl self type or
     * the trait name), from the impl (tag 4) / trait (tag 3) item that
     * follows its methods; -1 for a free function. */
    let container: Vec<i32> = vec_new();
    let mut i: i32 = 0;
    while i < n_items {
        vec_push(container, 0 - 1);
        i = i + 1;
    }
    i = 0;
    while i < n_items {
        let tag: i32 = vec_get(it, i);
        let is_container: bool = if tag == 3 { true } else { tag == 4 };
        if is_container {
            let count: i32 = vec_get(id2, i);
            if count > 0 {
                let first: i32 = i - count;
                let ctok: i32 = if tag == 3 { vec_get(id1, i) } else {
                    cov_plan_impl_type_tok(tags, vec_get(id1, first) - 1)
                };
                let mut m: i32 = first;
                while m < i {
                    vec_set(container, m, ctok);
                    m = m + 1;
                }
            }
        }
        i = i + 1;
    }

    /* Per unit: its `module` declaration item, or -1. */
    let unit_module: Vec<i32> = vec_new();
    let nunits: i32 = vec_len(cstarts);
    let mut u: i32 = 0;
    while u < nunits {
        vec_push(unit_module, 0 - 1);
        u = u + 1;
    }
    /* Per item: span and unit of a function entity, else -1. */
    let item_start: Vec<i32> = vec_new();
    let item_end: Vec<i32> = vec_new();
    let item_unit: Vec<i32> = vec_new();
    i = 0;
    while i < n_items {
        let tag2: i32 = vec_get(it, i);
        vec_push(item_start, 0 - 1);
        vec_push(item_end, 0 - 1);
        vec_push(item_unit, 0 - 1);
        if tag2 == 6 {
            let mu: i32 = cov_src_unit_at(cstarts, clens, vec_get(starts, vec_get(pp, vec_get(id1, i))));
            if mu >= 0 { vec_set(unit_module, mu, i); }
        }
        let has_body: bool = if tag2 == 0 { vec_get(id4, i) >= 0 } else { false };
        if has_body {
            let name_tok: i32 = vec_get(id1, i);
            let close: i32 = cov_plan_body_end(tags, name_tok);
            if cov_plan_tag(tags, name_tok - 1) != 65 { return "\nfunction-span"; }
            if close < 0 { return "\nfunction-span"; }
            let st: i32 = vec_get(starts, name_tok - 1);
            let unit: i32 = cov_src_unit_at(cstarts, clens, st);
            if unit < 0 { return "\nfunction-span"; }
            vec_set(item_start, i, st);
            vec_set(item_end, i, vec_get(ends, close));
            vec_set(item_unit, i, unit);
        }
        i = i + 1;
    }

    let mut qnames: string = "";
    let mut k: i32 = 0;
    while k < nsrc {
        let unit2: i32 = vec_get(src_unit, k);
        let mod_item: i32 = vec_get(unit_module, unit2);
        let mut module_prefix: string = "";
        if mod_item >= 0 {
            module_prefix = cov_plan_module_prefix(source, starts, ends, pp, vec_get(id1, mod_item), vec_get(id2, mod_item));
        }
        let mut j: i32 = 0;
        while j < n_items {
            if vec_get(item_unit, j) == unit2 {
                let e: i32 = vec_len(ent_item);
                vec_push(ent_item, j);
                vec_push(ent_source, k);
                vec_push(ent_start, vec_get(item_start, j));
                vec_push(ent_end, vec_get(item_end, j));
                vec_push(ent_owner, e);
                vec_push(pt_kind, 1);
                vec_push(pt_entity, e);
                vec_push(pt_start, vec_get(item_start, j));
                vec_push(pt_end, vec_get(item_end, j));
                let ctok: i32 = vec_get(container, j);
                let mut q: string = module_prefix;
                if ctok >= 0 {
                    q = string_concat(string_concat(q, cov_plan_tok_text(source, starts, ends, ctok)), "::");
                }
                q = string_concat(q, cov_plan_tok_text(source, starts, ends, vec_get(id1, j)));
                if e == 0 { qnames = q; } else { qnames = string_concat(string_concat(qnames, "\n"), q); }
            }
            j = j + 1;
        }
        k = k + 1;
    }
    return qnames;
}

/* "<start_byte>\t<end_byte>\t<start_line>\t<start_col>\t<end_line>\t<end_col>"
 * for concat span [s, e) inside unit `unit`, in file-relative coordinates. */
fn cov_plan_span_text(source: string, cstarts: Vec<i32>, clens: Vec<i32>, unit: i32,
                      s: i32, e: i32) -> string {
    let base: i32 = vec_get(cstarts, unit);
    let text: string = string_substr(source, base, vec_get(clens, unit));
    let fs: i32 = s - base;
    let fe: i32 = e - base;
    let mut out: string = string_concat(cov_src_itoa(fs), "\t");
    out = string_concat(string_concat(out, cov_src_itoa(fe)), "\t");
    out = string_concat(string_concat(out, cov_src_itoa(cov_src_line(text, fs))), "\t");
    out = string_concat(string_concat(out, cov_src_itoa(cov_src_column(text, fs))), "\t");
    out = string_concat(string_concat(out, cov_src_itoa(cov_src_line(text, fe))), "\t");
    return string_concat(out, cov_src_itoa(cov_src_column(text, fe)));
}

/* Text form of the plan, one tab-separated record per line (the
 * `plan-dump` test hook):
 *   source  <index> <logical path> <sha256>
 *   entity  <index> function <qualified name> <source> <span> <owner>
 *   point   <index> function_entry <entity> entry <source> <span>
 * where <span> is cov_plan_span_text's six fields. */
fn cov_plan_dump(source: string, table: string, cstarts: Vec<i32>, clens: Vec<i32>,
                 src_unit: Vec<i32>, ent_source: Vec<i32>, ent_start: Vec<i32>,
                 ent_end: Vec<i32>, ent_owner: Vec<i32>, qnames: string,
                 pt_kind: Vec<i32>, pt_entity: Vec<i32>, pt_start: Vec<i32>,
                 pt_end: Vec<i32>) -> string {
    let mut out: string = "";
    let nsrc: i32 = vec_len(src_unit);
    let mut k: i32 = 0;
    while k < nsrc {
        let unit: i32 = vec_get(src_unit, k);
        out = string_concat(out, string_concat(string_concat("source\t", cov_src_itoa(k)), "\t"));
        out = string_concat(out, string_concat(string_concat(cov_src_path_at(table, unit), "\t"),
                                               string_concat(cov_src_digest_at(table, unit), "\n")));
        k = k + 1;
    }
    let ne: i32 = vec_len(ent_source);
    let mut e: i32 = 0;
    while e < ne {
        let sk: i32 = vec_get(ent_source, e);
        let unit2: i32 = vec_get(src_unit, sk);
        out = string_concat(out, string_concat(string_concat("entity\t", cov_src_itoa(e)), "\tfunction\t"));
        out = string_concat(out, string_concat(cov_plan_line_at(qnames, e), "\t"));
        out = string_concat(out, string_concat(cov_src_itoa(sk), "\t"));
        out = string_concat(out, cov_plan_span_text(source, cstarts, clens, unit2,
                                                    vec_get(ent_start, e), vec_get(ent_end, e)));
        out = string_concat(out, string_concat(string_concat("\t", cov_src_itoa(vec_get(ent_owner, e))), "\n"));
        e = e + 1;
    }
    let np: i32 = vec_len(pt_kind);
    let mut p: i32 = 0;
    while p < np {
        let pe: i32 = vec_get(pt_entity, p);
        let sk2: i32 = vec_get(ent_source, pe);
        out = string_concat(out, string_concat(string_concat("point\t", cov_src_itoa(p)), "\tfunction_entry\t"));
        out = string_concat(out, string_concat(cov_src_itoa(pe), "\tentry\t"));
        out = string_concat(out, string_concat(cov_src_itoa(sk2), "\t"));
        out = string_concat(out, cov_plan_span_text(source, cstarts, clens, vec_get(src_unit, sk2),
                                                    vec_get(pt_start, p), vec_get(pt_end, p)));
        out = string_concat(out, "\n");
        p = p + 1;
    }
    return out;
}
