/* Coverage planner (sv0cov CV-107; SPEC 13.1, 13.2; planning conventions in
 * sv0cov docs/planning-conventions.md).
 *
 * Runs once per build after resolve/check and before lowering, over the parse
 * arenas, so the generated-C and VM backends share one plan (COV-MAP-001).
 * This slice plans sources, function entities, and their `function_entry`
 * points; regions (CV-108) and branch outcomes (CV-109) extend the same side
 * tables.
 *
 * Side tables are keyed by AST item handle and hold spans as byte offsets
 * into the compiled source (the concat of the build's files; see
 * lib/coverage_source.sv0):
 *   sources:  src_unit[k] = listing unit of source index k (sorted by logical
 *             path, bytewise)
 *   entities: ent_item, ent_source, ent_start, ent_end (end exclusive),
 *             ent_owner (the entity whose function owns it; a function owns
 *             itself); cov_plan_functions returns the qualified names, one
 *             per line
 *   points:   pt_kind (1 = function_entry), pt_entity, pt_start, pt_end
 *
 * A function entity is a `fn` item with a body (parser item tag 0, body root
 * id4 >= 0): free functions, methods of `impl` blocks, and trait methods with
 * a default body. `#[extern_c]` declarations and bodyless trait methods are
 * not entities. The span runs from the `fn` keyword through the body's
 * closing `}`. The qualified name is the function name, prefixed by the
 * `impl` self type or trait name for a method, and by the file's
 * `module a::b;` path when it has one (`a::b::Type::name`). sv0 has no nested
 * functions yet, so every function's owner is itself.
 *
 * Depends on lib/coverage_source.sv0. Names are prefixed cov_plan_ because
 * compiler modules share one translation unit.
 */

fn cov_plan_tag(tags: Vec<i32>, i: i32) -> i32 {
    if i < 0 { return 0 - 1; }
    if i >= vec_len(tags) { return 0 - 1; }
    return vec_get(tags, i);
}

fn cov_plan_tok_text(source: string, starts: Vec<i32>, ends: Vec<i32>, t: i32) -> string {
    let s: i32 = vec_get(starts, t);
    return string_substr(source, s, vec_get(ends, t) - s);
}

/* Index of the body's closing `}` for the fn whose name token is `name_tok`:
 * the first `{` outside parentheses and brackets opens the body (contract
 * clauses are parenthesized), then braces are matched. -1 when the signature
 * ends in `;` first or the tokens run out. */
fn cov_plan_body_end(tags: Vec<i32>, name_tok: i32) -> i32 {
    let n: i32 = vec_len(tags);
    let mut i: i32 = name_tok + 1;
    let mut depth: i32 = 0;
    let mut open: i32 = 0 - 1;
    while open < 0 {
        if i >= n { return 0 - 1; }
        let t: i32 = vec_get(tags, i);
        if t == 6 { depth = depth + 1; }
        if t == 10 { depth = depth + 1; }
        if t == 7 { depth = depth - 1; }
        if t == 11 { depth = depth - 1; }
        if depth == 0 {
            if t == 13 { return 0 - 1; }
            if t == 8 { open = i; }
        }
        i = i + 1;
    }
    let mut braces: i32 = 1;
    while braces > 0 {
        if i >= n { return 0 - 1; }
        let t2: i32 = vec_get(tags, i);
        if t2 == 8 { braces = braces + 1; }
        if t2 == 9 { braces = braces - 1; }
        if braces == 0 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

/* Self-type name token of the `impl` block whose first method's `fn` keyword
 * is at `fn_tok`: the type after `for` in `impl Trait for Type`, else the
 * first type token after `impl` and its optional `<...>` parameters. */
fn cov_plan_impl_type_tok(tags: Vec<i32>, fn_tok: i32) -> i32 {
    let mut k: i32 = fn_tok - 1;
    while k >= 0 {
        if vec_get(tags, k) == 69 {
            let mut j: i32 = k + 1;
            if cov_plan_tag(tags, j) == 38 {
                let mut angle: i32 = 0;
                let mut scanning: bool = true;
                while scanning {
                    let t: i32 = cov_plan_tag(tags, j);
                    if t < 0 { return 0 - 1; }
                    if t == 38 { angle = angle + 1; }
                    if t == 39 { angle = angle - 1; }
                    j = j + 1;
                    if angle == 0 { scanning = false; }
                }
            }
            let mut ty: i32 = j;
            let mut q: i32 = j;
            while q < fn_tok {
                let tq: i32 = vec_get(tags, q);
                if tq == 8 { return ty; }
                if tq == 66 { ty = q + 1; }
                q = q + 1;
            }
            return ty;
        }
        k = k - 1;
    }
    return 0 - 1;
}

/* Bytewise `a < b`. */
fn cov_plan_str_lt(a: string, b: string) -> bool {
    let na: i32 = string_len(a);
    let nb: i32 = string_len(b);
    let mut i: i32 = 0;
    while i < na {
        if i >= nb { return false; }
        let ca: i32 = string_char_at(a, i);
        let cb: i32 = string_char_at(b, i);
        if ca != cb { return ca < cb; }
        i = i + 1;
    }
    return na < nb;
}

/* Line `idx` (0-based) of newline-separated `text`. */
fn cov_plan_line_at(text: string, idx: i32) -> string {
    return cov_src_field(text, idx, 0);
}

/* Fill src_unit with listing units sorted by logical path (the table's
 * first field). Returns the unit count. */
fn cov_plan_sources(table: string, src_unit: Vec<i32>) -> i32 {
    let n: i32 = cov_src_count(table);
    let mut u: i32 = 0;
    while u < n {
        vec_push(src_unit, u);
        let mut k: i32 = vec_len(src_unit) - 1;
        let mut moving: bool = true;
        while moving {
            if k == 0 {
                moving = false;
            } else {
                let prev: i32 = vec_get(src_unit, k - 1);
                if cov_plan_str_lt(cov_src_path_at(table, u), cov_src_path_at(table, prev)) {
                    vec_set(src_unit, k, prev);
                    vec_set(src_unit, k - 1, u);
                    k = k - 1;
                } else {
                    moving = false;
                }
            }
        }
        u = u + 1;
    }
    return n;
}

/* Qualified-name prefix text for `module a::b;` whose path segment tokens
 * are pp[base .. base + segs): "a::b::". */
fn cov_plan_module_prefix(source: string, starts: Vec<i32>, ends: Vec<i32>, pp: Vec<i32>,
                          base: i32, segs: i32) -> string {
    let mut path: string = "";
    let mut s: i32 = 0;
    while s < segs {
        path = string_concat(string_concat(path, cov_plan_tok_text(source, starts, ends, vec_get(pp, base + s))), "::");
        s = s + 1;
    }
    return path;
}

/* Plan function entities and function_entry points. `cstarts`/`clens` are
 * the per-unit concat offsets from cov_src_table_build; `src_unit` comes from
 * cov_plan_sources. Qualified names are appended to the returned text, one
 * per line, in entity order. Returns "\n<error>" (a qualified name never
 * starts with LF) when a function's span cannot be recovered. */
fn cov_plan_functions(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>, source: string,
                      it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>, id4: Vec<i32>, pp: Vec<i32>,
                      cstarts: Vec<i32>, clens: Vec<i32>, src_unit: Vec<i32>,
                      ent_item: Vec<i32>, ent_source: Vec<i32>, ent_start: Vec<i32>,
                      ent_end: Vec<i32>, ent_owner: Vec<i32>,
                      pt_kind: Vec<i32>, pt_entity: Vec<i32>, pt_start: Vec<i32>,
                      pt_end: Vec<i32>) -> string {
    let nsrc: i32 = vec_len(src_unit);
    let n_items: i32 = vec_len(it);

    /* Per item: the container name token of a method (the impl self type or
     * the trait name), from the impl (tag 4) / trait (tag 3) item that
     * follows its methods; -1 for a free function. */
    let container: Vec<i32> = vec_new();
    let mut i: i32 = 0;
    while i < n_items {
        vec_push(container, 0 - 1);
        i = i + 1;
    }
    i = 0;
    while i < n_items {
        let tag: i32 = vec_get(it, i);
        let is_container: bool = if tag == 3 { true } else { tag == 4 };
        if is_container {
            let count: i32 = vec_get(id2, i);
            if count > 0 {
                let first: i32 = i - count;
                let ctok: i32 = if tag == 3 { vec_get(id1, i) } else {
                    cov_plan_impl_type_tok(tags, vec_get(id1, first) - 1)
                };
                let mut m: i32 = first;
                while m < i {
                    vec_set(container, m, ctok);
                    m = m + 1;
                }
            }
        }
        i = i + 1;
    }

    /* Per unit: its `module` declaration item, or -1. */
    let unit_module: Vec<i32> = vec_new();
    let nunits: i32 = vec_len(cstarts);
    let mut u: i32 = 0;
    while u < nunits {
        vec_push(unit_module, 0 - 1);
        u = u + 1;
    }
    /* Per item: span and unit of a function entity, else -1. */
    let item_start: Vec<i32> = vec_new();
    let item_end: Vec<i32> = vec_new();
    let item_unit: Vec<i32> = vec_new();
    i = 0;
    while i < n_items {
        let tag2: i32 = vec_get(it, i);
        vec_push(item_start, 0 - 1);
        vec_push(item_end, 0 - 1);
        vec_push(item_unit, 0 - 1);
        if tag2 == 6 {
            let mu: i32 = cov_src_unit_at(cstarts, clens, vec_get(starts, vec_get(pp, vec_get(id1, i))));
            if mu >= 0 { vec_set(unit_module, mu, i); }
        }
        let has_body: bool = if tag2 == 0 { vec_get(id4, i) >= 0 } else { false };
        if has_body {
            let name_tok: i32 = vec_get(id1, i);
            let close: i32 = cov_plan_body_end(tags, name_tok);
            if cov_plan_tag(tags, name_tok - 1) != 65 { return "\nfunction-span"; }
            if close < 0 { return "\nfunction-span"; }
            let st: i32 = vec_get(starts, name_tok - 1);
            let unit: i32 = cov_src_unit_at(cstarts, clens, st);
            if unit < 0 { return "\nfunction-span"; }
            vec_set(item_start, i, st);
            vec_set(item_end, i, vec_get(ends, close));
            vec_set(item_unit, i, unit);
        }
        i = i + 1;
    }

    let mut qnames: string = "";
    let mut k: i32 = 0;
    while k < nsrc {
        let unit2: i32 = vec_get(src_unit, k);
        let mod_item: i32 = vec_get(unit_module, unit2);
        let mut module_prefix: string = "";
        if mod_item >= 0 {
            module_prefix = cov_plan_module_prefix(source, starts, ends, pp, vec_get(id1, mod_item), vec_get(id2, mod_item));
        }
        let mut j: i32 = 0;
        while j < n_items {
            if vec_get(item_unit, j) == unit2 {
                let e: i32 = vec_len(ent_item);
                vec_push(ent_item, j);
                vec_push(ent_source, k);
                vec_push(ent_start, vec_get(item_start, j));
                vec_push(ent_end, vec_get(item_end, j));
                vec_push(ent_owner, e);
                vec_push(pt_kind, 1);
                vec_push(pt_entity, e);
                vec_push(pt_start, vec_get(item_start, j));
                vec_push(pt_end, vec_get(item_end, j));
                let ctok: i32 = vec_get(container, j);
                let mut q: string = module_prefix;
                if ctok >= 0 {
                    q = string_concat(string_concat(q, cov_plan_tok_text(source, starts, ends, ctok)), "::");
                }
                q = string_concat(q, cov_plan_tok_text(source, starts, ends, vec_get(id1, j)));
                if e == 0 { qnames = q; } else { qnames = string_concat(string_concat(qnames, "\n"), q); }
            }
            j = j + 1;
        }
        k = k + 1;
    }
    return qnames;
}

/* "<start_byte>\t<end_byte>\t<start_line>\t<start_col>\t<end_line>\t<end_col>"
 * for concat span [s, e) inside unit `unit`, in file-relative coordinates. */
fn cov_plan_span_text(source: string, cstarts: Vec<i32>, clens: Vec<i32>, unit: i32,
                      s: i32, e: i32) -> string {
    let base: i32 = vec_get(cstarts, unit);
    let text: string = string_substr(source, base, vec_get(clens, unit));
    let fs: i32 = s - base;
    let fe: i32 = e - base;
    let mut out: string = string_concat(cov_src_itoa(fs), "\t");
    out = string_concat(string_concat(out, cov_src_itoa(fe)), "\t");
    out = string_concat(string_concat(out, cov_src_itoa(cov_src_line(text, fs))), "\t");
    out = string_concat(string_concat(out, cov_src_itoa(cov_src_column(text, fs))), "\t");
    out = string_concat(string_concat(out, cov_src_itoa(cov_src_line(text, fe))), "\t");
    return string_concat(out, cov_src_itoa(cov_src_column(text, fe)));
}

/* Text form of the plan, one tab-separated record per line (the
 * `plan-dump` test hook):
 *   source  <index> <logical path> <sha256>
 *   entity  <index> function <qualified name> <source> <span> <owner>
 *   point   <index> function_entry <entity> entry <source> <span>
 * where <span> is cov_plan_span_text's six fields. */
fn cov_plan_dump(source: string, table: string, cstarts: Vec<i32>, clens: Vec<i32>,
                 src_unit: Vec<i32>, ent_source: Vec<i32>, ent_start: Vec<i32>,
                 ent_end: Vec<i32>, ent_owner: Vec<i32>, qnames: string,
                 pt_kind: Vec<i32>, pt_entity: Vec<i32>, pt_start: Vec<i32>,
                 pt_end: Vec<i32>) -> string {
    let mut out: string = "";
    let nsrc: i32 = vec_len(src_unit);
    let mut k: i32 = 0;
    while k < nsrc {
        let unit: i32 = vec_get(src_unit, k);
        out = string_concat(out, string_concat(string_concat("source\t", cov_src_itoa(k)), "\t"));
        out = string_concat(out, string_concat(string_concat(cov_src_path_at(table, unit), "\t"),
                                               string_concat(cov_src_digest_at(table, unit), "\n")));
        k = k + 1;
    }
    let ne: i32 = vec_len(ent_source);
    let mut e: i32 = 0;
    while e < ne {
        let sk: i32 = vec_get(ent_source, e);
        let unit2: i32 = vec_get(src_unit, sk);
        out = string_concat(out, string_concat(string_concat("entity\t", cov_src_itoa(e)), "\tfunction\t"));
        out = string_concat(out, string_concat(cov_plan_line_at(qnames, e), "\t"));
        out = string_concat(out, string_concat(cov_src_itoa(sk), "\t"));
        out = string_concat(out, cov_plan_span_text(source, cstarts, clens, unit2,
                                                    vec_get(ent_start, e), vec_get(ent_end, e)));
        out = string_concat(out, string_concat(string_concat("\t", cov_src_itoa(vec_get(ent_owner, e))), "\n"));
        e = e + 1;
    }
    let np: i32 = vec_len(pt_kind);
    let mut p: i32 = 0;
    while p < np {
        let pe: i32 = vec_get(pt_entity, p);
        let sk2: i32 = vec_get(ent_source, pe);
        out = string_concat(out, string_concat(string_concat("point\t", cov_src_itoa(p)), "\tfunction_entry\t"));
        out = string_concat(out, string_concat(cov_src_itoa(pe), "\tentry\t"));
        out = string_concat(out, string_concat(cov_src_itoa(sk2), "\t"));
        out = string_concat(out, cov_plan_span_text(source, cstarts, clens, vec_get(src_unit, sk2),
                                                    vec_get(pt_start, p), vec_get(pt_end, p)));
        out = string_concat(out, "\n");
        p = p + 1;
    }
    return out;
}

/* ── Regions and branches (CV-108) ─────────────────────────────────────────
 *
 * Regions and branch constructs come from a structural walk over each
 * function body's tokens (sv0's statement grammar is small and the parser
 * records no statement spans); the walk's statement count is checked against
 * the AST body block, and anything it does not recognize fails closed.
 *
 * Side tables (flat, stride shown):
 *   rg  (5): kind, entity, first token, last token, counter expression
 *   br  (5): kind (1 if, 2 loop, 3 match, 4 conditional_expression: an
 *            `if` nested in an expression), entity, first token, last
 *            token, outcome count
 *   cef (2): first term, term count  -- counter expressions over
 *   cet (2): coefficient, point ref     entry and outcome points
 * A point ref >= 0 is the function_entry of that entity; a ref < 0 is branch
 * b's outcome k, encoded -(b * 1024 + k) - 1. Expression handle -1 is zero.
 *
 * Counters follow docs/planning-conventions.md: a region's counter is its
 * position (the function entry, or the enclosing branch outcome); a loop
 * condition counts body + exit; after a statement the position drops by the
 * paths inside it that always leave: `return` leaves the function, `break`
 * and `continue` leave the loop body (a loop absorbs them). The walk returns
 * both amounts through `ret`: [returns, jumps, next token, statement count].
 */

fn cov_rg_kind_name(k: i32) -> string {
    if k == 1 { return "assignment"; }
    if k == 2 { return "branch_body"; }
    if k == 3 { return "break"; }
    if k == 5 { return "continue"; }
    if k == 6 { return "expression"; }
    if k == 7 { return "expression_statement"; }
    if k == 8 { return "initializer"; }
    if k == 9 { return "loop_body"; }
    if k == 10 { return "match_arm"; }
    if k == 11 { return "mutation"; }
    if k == 12 { return "return"; }
    return "call";
}

fn cov_br_kind_name(k: i32) -> string {
    if k == 1 { return "if"; }
    if k == 2 { return "loop"; }
    if k == 4 { return "conditional_expression"; }
    return "match";
}

/* Outcome k's name: true/false, body/exit, or arm:k (SPEC 16.3.6). */
fn cov_outcome_name(kind: i32, k: i32) -> string {
    if kind == 2 {
        if k == 0 { return "body"; }
        return "exit";
    }
    if kind == 3 { return string_concat("arm:", cov_src_itoa(k)); }
    if k == 0 { return "true"; }
    return "false";
}

fn cov_outcome_ref(b: i32, k: i32) -> i32 {
    return 0 - (b * 1024 + k) - 1;
}

fn cov_ce_ref(cef: Vec<i32>, cet: Vec<i32>, r: i32) -> i32 {
    let h: i32 = vec_len(cef) / 2;
    vec_push(cef, vec_len(cet) / 2);
    vec_push(cef, 1);
    vec_push(cet, 1);
    vec_push(cet, r);
    return h;
}

/* sa * a + sb * b (either may be -1, the zero expression). */
fn cov_ce_lin(cef: Vec<i32>, cet: Vec<i32>, a: i32, sa: i32, b: i32, sb: i32) -> i32 {
    if a < 0 {
        if b < 0 { return 0 - 1; }
    }
    let h: i32 = vec_len(cef) / 2;
    let first: i32 = vec_len(cet) / 2;
    let mut n: i32 = 0;
    if a >= 0 {
        let af: i32 = vec_get(cef, a * 2);
        let al: i32 = vec_get(cef, a * 2 + 1);
        let mut i: i32 = 0;
        while i < al {
            vec_push(cet, vec_get(cet, (af + i) * 2) * sa);
            vec_push(cet, vec_get(cet, (af + i) * 2 + 1));
            i = i + 1;
        }
        n = n + al;
    }
    if b >= 0 {
        let bf: i32 = vec_get(cef, b * 2);
        let bl: i32 = vec_get(cef, b * 2 + 1);
        let mut j: i32 = 0;
        while j < bl {
            vec_push(cet, vec_get(cet, (bf + j) * 2) * sb);
            vec_push(cet, vec_get(cet, (bf + j) * 2 + 1));
            j = j + 1;
        }
        n = n + bl;
    }
    vec_push(cef, first);
    vec_push(cef, n);
    return h;
}

/* Index of the bracket closing the `(`, `[` or `{` at `open`, or -1. */
fn cov_tok_close(tags: Vec<i32>, open: i32) -> i32 {
    let n: i32 = vec_len(tags);
    let mut depth: i32 = 0;
    let mut i: i32 = open;
    while i < n {
        let t: i32 = vec_get(tags, i);
        let opens: bool = if t == 6 { true } else { if t == 8 { true } else { t == 10 } };
        let closes: bool = if t == 7 { true } else { if t == 9 { true } else { t == 11 } };
        if opens { depth = depth + 1; }
        if closes {
            depth = depth - 1;
            if depth == 0 { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

/* First token in [t, limit) with tag `want` outside any brackets, or -1. */
fn cov_tok_find0(tags: Vec<i32>, t: i32, limit: i32, want: i32) -> i32 {
    let mut depth: i32 = 0;
    let mut i: i32 = t;
    while i < limit {
        let g: i32 = vec_get(tags, i);
        if depth == 0 {
            if g == want { return i; }
        }
        let opens: bool = if g == 6 { true } else { if g == 8 { true } else { g == 10 } };
        let closes: bool = if g == 7 { true } else { if g == 9 { true } else { g == 11 } };
        if opens { depth = depth + 1; }
        if closes { depth = depth - 1; }
        i = i + 1;
    }
    return 0 - 1;
}

/* First `{` in [t, limit) outside parentheses and brackets (a body's
   opening brace), or -1. */
fn cov_tok_body_open(tags: Vec<i32>, t: i32, limit: i32) -> i32 {
    let mut depth: i32 = 0;
    let mut i: i32 = t;
    while i < limit {
        let g: i32 = vec_get(tags, i);
        if depth == 0 {
            if g == 8 { return i; }
        }
        if g == 6 { depth = depth + 1; }
        if g == 10 { depth = depth + 1; }
        if g == 7 { depth = depth - 1; }
        if g == 11 { depth = depth - 1; }
        i = i + 1;
    }
    return 0 - 1;
}

fn cov_rg_push(rg: Vec<i32>, kind: i32, e: i32, first: i32, last: i32, ce: i32) -> i32 {
    vec_push(rg, kind);
    vec_push(rg, e);
    vec_push(rg, first);
    vec_push(rg, last);
    vec_push(rg, ce);
    return 0;
}

fn cov_is_construct(t: i32) -> bool {
    if t == 68 { return true; }
    if t == 96 { return true; }
    if t == 74 { return true; }
    if t == 66 { return true; }
    return t == 72;
}

/* Walk the constructs inside expression tokens [t0, t1] at position p.
   ret = [returns, jumps]. */
fn cov_walk_expr(tags: Vec<i32>, cef: Vec<i32>, cet: Vec<i32>, rg: Vec<i32>, br: Vec<i32>,
                 e: i32, t0: i32, t1: i32, p: i32, ret: Vec<i32>) -> i32 {
    let mut r: i32 = 0 - 1;
    let mut j: i32 = 0 - 1;
    let mut t: i32 = t0;
    while t <= t1 {
        let g: i32 = vec_get(tags, t);
        if cov_is_construct(g) {
            if cov_walk_construct(tags, cef, cet, rg, br, e, t, p, true, ret) < 0 { return 0 - 1; }
            r = cov_ce_lin(cef, cet, r, 1, vec_get(ret, 0), 1);
            j = cov_ce_lin(cef, cet, j, 1, vec_get(ret, 1), 1);
            t = vec_get(ret, 2) + 1;
        } else {
            let mut block: bool = false;
            if g == 8 {
                /* A `{` after a name opens a struct literal; any other is a
                   block expression, planned like any block at position p. */
                let prev: i32 = if t > 0 { vec_get(tags, t - 1) } else { 0 };
                if prev != 5 { block = true; }
            }
            if block {
                if cov_walk_block(tags, cef, cet, rg, br, e, t, p, ret) < 0 { return 0 - 1; }
                r = cov_ce_lin(cef, cet, r, 1, vec_get(ret, 0), 1);
                j = cov_ce_lin(cef, cet, j, 1, vec_get(ret, 1), 1);
                t = vec_get(ret, 2) + 1;
            } else {
                t = t + 1;
            }
        }
    }
    vec_set(ret, 0, r);
    vec_set(ret, 1, j);
    return 0;
}

/* Walk the block whose `{` is at `open`, at position p.
   ret = [returns, jumps, closing token, statement count]. */
fn cov_walk_block(tags: Vec<i32>, cef: Vec<i32>, cet: Vec<i32>, rg: Vec<i32>, br: Vec<i32>,
                  e: i32, open: i32, p: i32, ret: Vec<i32>) -> i32 {
    let close: i32 = cov_tok_close(tags, open);
    if close < 0 { return 0 - 1; }
    let mut r: i32 = 0 - 1;
    let mut j: i32 = 0 - 1;
    let mut cur: i32 = p;
    let mut count: i32 = 0;
    let mut t: i32 = open + 1;
    while t < close {
        if cov_walk_stmt(tags, cef, cet, rg, br, e, t, close, cur, ret) < 0 { return 0 - 1; }
        let sr: i32 = vec_get(ret, 0);
        let sj: i32 = vec_get(ret, 1);
        r = cov_ce_lin(cef, cet, r, 1, sr, 1);
        j = cov_ce_lin(cef, cet, j, 1, sj, 1);
        cur = cov_ce_lin(cef, cet, cur, 1, cov_ce_lin(cef, cet, sr, 1, sj, 1), 0 - 1);
        t = vec_get(ret, 2);
        count = count + 1;
    }
    vec_set(ret, 0, r);
    vec_set(ret, 1, j);
    vec_set(ret, 2, close);
    vec_set(ret, 3, count);
    return 0;
}

/* Walk the statement starting at token t inside a block closing at `close`.
   ret = [returns, jumps, next token]. */
fn cov_walk_stmt(tags: Vec<i32>, cef: Vec<i32>, cet: Vec<i32>, rg: Vec<i32>, br: Vec<i32>,
                 e: i32, t: i32, close: i32, p: i32, ret: Vec<i32>) -> i32 {
    let g: i32 = vec_get(tags, t);
    if cov_is_construct(g) {
        if cov_walk_construct(tags, cef, cet, rg, br, e, t, p, false, ret) < 0 { return 0 - 1; }
        let mut next: i32 = vec_get(ret, 2) + 1;
        if next < close {
            if vec_get(tags, next) == 13 { next = next + 1; }
        }
        vec_set(ret, 2, next);
        return 0;
    }
    if g == 8 {
        if cov_walk_block(tags, cef, cet, rg, br, e, t, p, ret) < 0 { return 0 - 1; }
        let mut next2: i32 = vec_get(ret, 2) + 1;
        if next2 < close {
            if vec_get(tags, next2) == 13 { next2 = next2 + 1; }
        }
        vec_set(ret, 2, next2);
        return 0;
    }
    let semi: i32 = cov_tok_find0(tags, t, close, 13);
    if semi < 0 {
        /* The block's tail expression. */
        cov_rg_push(rg, 6, e, t, close - 1, p);
        if cov_walk_expr(tags, cef, cet, rg, br, e, t, close - 1, p, ret) < 0 { return 0 - 1; }
        vec_set(ret, 2, close);
        return 0;
    }
    let mut kind: i32 = 7;
    let mut inner: i32 = t;
    if g == 71 { kind = 8; inner = t + 1; }
    if g == 85 { kind = 12; inner = t + 1; }
    if g == 57 { kind = 3; inner = t + 1; }
    if g == 59 { kind = 5; inner = t + 1; }
    if kind == 7 {
        if cov_tok_find0(tags, t, semi, 35) >= 0 { kind = 1; }
        let mut q: i32 = 44;
        while q <= 51 {
            if cov_tok_find0(tags, t, semi, q) >= 0 { kind = 11; }
            q = q + 1;
        }
    }
    cov_rg_push(rg, kind, e, t, semi, p);
    if inner <= semi - 1 {
        if cov_walk_expr(tags, cef, cet, rg, br, e, inner, semi - 1, p, ret) < 0 { return 0 - 1; }
    } else {
        vec_set(ret, 0, 0 - 1);
        vec_set(ret, 1, 0 - 1);
    }
    /* return always leaves the function; break/continue leave the loop. */
    if kind == 12 { vec_set(ret, 0, p); vec_set(ret, 1, 0 - 1); }
    if kind == 3 { vec_set(ret, 0, 0 - 1); vec_set(ret, 1, p); }
    if kind == 5 { vec_set(ret, 0, 0 - 1); vec_set(ret, 1, p); }
    vec_set(ret, 2, semi + 1);
    return 0;
}

fn cov_br_push(br: Vec<i32>, kind: i32, e: i32, first: i32) -> i32 {
    let b: i32 = vec_len(br) / 5;
    vec_push(br, kind);
    vec_push(br, e);
    vec_push(br, first);
    vec_push(br, 0 - 1);
    vec_push(br, 0);
    return b;
}

/* Walk the if/while/for/loop/match construct whose keyword is at t, at
   position p. ret = [returns, jumps, last token]. */
fn cov_walk_construct(tags: Vec<i32>, cef: Vec<i32>, cet: Vec<i32>, rg: Vec<i32>, br: Vec<i32>,
                      e: i32, t: i32, p: i32, in_expr: bool, ret: Vec<i32>) -> i32 {
    let n: i32 = vec_len(tags);
    let g: i32 = vec_get(tags, t);
    if g == 68 {
        let b: i32 = cov_br_push(br, if in_expr { 4 } else { 1 }, e, t);
        vec_set(br, b * 5 + 4, 2);
        let open: i32 = cov_tok_body_open(tags, t + 1, n);
        if open <= t + 1 { return 0 - 1; }
        cov_rg_push(rg, 6, e, t + 1, open - 1, p);
        if cov_walk_expr(tags, cef, cet, rg, br, e, t + 1, open - 1, p, ret) < 0 { return 0 - 1; }
        let mut r: i32 = vec_get(ret, 0);
        let mut j: i32 = vec_get(ret, 1);
        let tpos: i32 = cov_ce_ref(cef, cet, cov_outcome_ref(b, 0));
        let body_close: i32 = cov_tok_close(tags, open);
        if body_close < 0 { return 0 - 1; }
        cov_rg_push(rg, 2, e, open, body_close, tpos);
        if cov_walk_block(tags, cef, cet, rg, br, e, open, tpos, ret) < 0 { return 0 - 1; }
        r = cov_ce_lin(cef, cet, r, 1, vec_get(ret, 0), 1);
        j = cov_ce_lin(cef, cet, j, 1, vec_get(ret, 1), 1);
        let mut last: i32 = body_close;
        if body_close + 2 < n {
            if vec_get(tags, body_close + 1) == 60 {
                let fpos: i32 = cov_ce_ref(cef, cet, cov_outcome_ref(b, 1));
                let et: i32 = body_close + 2;
                if vec_get(tags, et) == 68 {
                    if cov_walk_construct(tags, cef, cet, rg, br, e, et, fpos, in_expr, ret) < 0 { return 0 - 1; }
                    last = vec_get(ret, 2);
                } else {
                    if vec_get(tags, et) != 8 { return 0 - 1; }
                    let else_close: i32 = cov_tok_close(tags, et);
                    if else_close < 0 { return 0 - 1; }
                    cov_rg_push(rg, 2, e, et, else_close, fpos);
                    if cov_walk_block(tags, cef, cet, rg, br, e, et, fpos, ret) < 0 { return 0 - 1; }
                    last = else_close;
                }
                r = cov_ce_lin(cef, cet, r, 1, vec_get(ret, 0), 1);
                j = cov_ce_lin(cef, cet, j, 1, vec_get(ret, 1), 1);
            }
        }
        vec_set(br, b * 5 + 3, last);
        vec_set(ret, 0, r);
        vec_set(ret, 1, j);
        vec_set(ret, 2, last);
        return 0;
    }
    let is_loop: bool = if g == 96 { true } else { if g == 66 { true } else { g == 72 } };
    if is_loop {
        let b2: i32 = cov_br_push(br, 2, e, t);
        vec_set(br, b2 * 5 + 4, 2);
        let open2: i32 = cov_tok_body_open(tags, t + 1, n);
        if open2 < 0 { return 0 - 1; }
        let mut r2: i32 = 0 - 1;
        if g == 96 {
            /* while <cond> [loop_invariant(...)]* { ... }: the condition
               counts every evaluation, body + exit. */
            let mut cond_end: i32 = open2 - 1;
            let inv: i32 = cov_tok_find0(tags, t + 1, open2, 73);
            if inv >= 0 { cond_end = inv - 1; }
            if cond_end < t + 1 { return 0 - 1; }
            let both: i32 = cov_ce_lin(cef, cet, cov_ce_ref(cef, cet, cov_outcome_ref(b2, 0)), 1,
                                       cov_ce_ref(cef, cet, cov_outcome_ref(b2, 1)), 1);
            cov_rg_push(rg, 6, e, t + 1, cond_end, both);
            if cov_walk_expr(tags, cef, cet, rg, br, e, t + 1, cond_end, both, ret) < 0 { return 0 - 1; }
            r2 = vec_get(ret, 0);
        }
        if g == 66 {
            /* for <pattern> in <iterable> { ... }: the iterable is evaluated
               once per loop entry. */
            let in_tok: i32 = cov_tok_find0(tags, t + 1, open2, 70);
            if in_tok < 0 { return 0 - 1; }
            if in_tok + 1 > open2 - 1 { return 0 - 1; }
            cov_rg_push(rg, 6, e, in_tok + 1, open2 - 1, p);
            if cov_walk_expr(tags, cef, cet, rg, br, e, in_tok + 1, open2 - 1, p, ret) < 0 { return 0 - 1; }
            r2 = vec_get(ret, 0);
        }
        if g == 72 {
            if open2 != t + 1 { return 0 - 1; }
        }
        let bpos: i32 = cov_ce_ref(cef, cet, cov_outcome_ref(b2, 0));
        let close2: i32 = cov_tok_close(tags, open2);
        if close2 < 0 { return 0 - 1; }
        cov_rg_push(rg, 9, e, open2, close2, bpos);
        if cov_walk_block(tags, cef, cet, rg, br, e, open2, bpos, ret) < 0 { return 0 - 1; }
        r2 = cov_ce_lin(cef, cet, r2, 1, vec_get(ret, 0), 1);
        vec_set(br, b2 * 5 + 3, close2);
        vec_set(ret, 0, r2);
        vec_set(ret, 1, 0 - 1);
        vec_set(ret, 2, close2);
        return 0;
    }
    if g == 74 {
        let b3: i32 = cov_br_push(br, 3, e, t);
        let open3: i32 = cov_tok_body_open(tags, t + 1, n);
        if open3 <= t + 1 { return 0 - 1; }
        if cov_walk_expr(tags, cef, cet, rg, br, e, t + 1, open3 - 1, p, ret) < 0 { return 0 - 1; }
        let mut r3: i32 = vec_get(ret, 0);
        let mut j3: i32 = vec_get(ret, 1);
        let close3: i32 = cov_tok_close(tags, open3);
        if close3 < 0 { return 0 - 1; }
        let mut k: i32 = 0;
        let mut a: i32 = open3 + 1;
        while a < close3 {
            if k >= 1024 { return 0 - 1; }
            let arrow: i32 = cov_tok_find0(tags, a, close3, 20);
            if arrow < 0 { return 0 - 1; }
            let apos: i32 = cov_ce_ref(cef, cet, cov_outcome_ref(b3, k));
            let rs: i32 = arrow + 1;
            if rs >= close3 { return 0 - 1; }
            let mut next: i32 = close3;
            if vec_get(tags, rs) == 8 {
                let rclose: i32 = cov_tok_close(tags, rs);
                if rclose < 0 { return 0 - 1; }
                cov_rg_push(rg, 10, e, rs, rclose, apos);
                if cov_walk_block(tags, cef, cet, rg, br, e, rs, apos, ret) < 0 { return 0 - 1; }
                next = rclose + 1;
            } else {
                let comma: i32 = cov_tok_find0(tags, rs, close3, 12);
                let re: i32 = if comma >= 0 { comma } else { close3 };
                cov_rg_push(rg, 10, e, rs, re - 1, apos);
                if cov_walk_expr(tags, cef, cet, rg, br, e, rs, re - 1, apos, ret) < 0 { return 0 - 1; }
                let rt: i32 = vec_get(tags, rs);
                if rt == 85 { vec_set(ret, 0, apos); }
                if rt == 57 { vec_set(ret, 1, apos); }
                if rt == 59 { vec_set(ret, 1, apos); }
                next = re;
            }
            r3 = cov_ce_lin(cef, cet, r3, 1, vec_get(ret, 0), 1);
            j3 = cov_ce_lin(cef, cet, j3, 1, vec_get(ret, 1), 1);
            if next < close3 {
                if vec_get(tags, next) == 12 { next = next + 1; }
            }
            a = next;
            k = k + 1;
        }
        if k == 0 { return 0 - 1; }
        vec_set(br, b3 * 5 + 3, close3);
        vec_set(br, b3 * 5 + 4, k);
        vec_set(ret, 0, r3);
        vec_set(ret, 1, j3);
        vec_set(ret, 2, close3);
        return 0;
    }
    return 0 - 1;
}

/* Plan regions and branches for every function entity. `body_stmts[e]` is
   the AST body block's statement count (tail included) for the cross-check.
   Returns the failing entity index, or -1 when every function planned. */
fn cov_plan_regions(tags: Vec<i32>, ent_item: Vec<i32>, id1: Vec<i32>, body_stmts: Vec<i32>,
                    cef: Vec<i32>, cet: Vec<i32>, rg: Vec<i32>, br: Vec<i32>) -> i32 {
    let ret: Vec<i32> = vec_new();
    vec_push(ret, 0);
    vec_push(ret, 0);
    vec_push(ret, 0);
    vec_push(ret, 0);
    let ne: i32 = vec_len(ent_item);
    let mut e: i32 = 0;
    while e < ne {
        let name_tok: i32 = vec_get(id1, vec_get(ent_item, e));
        let open: i32 = cov_tok_body_open(tags, name_tok + 1, vec_len(tags));
        if open < 0 { return e; }
        let entry: i32 = cov_ce_ref(cef, cet, e);
        if cov_walk_block(tags, cef, cet, rg, br, e, open, entry, ret) < 0 { return e; }
        if vec_get(ret, 3) != vec_get(body_stmts, e) { return e; }
        e = e + 1;
    }
    return 0 - 1;
}

/* Comma-separated lines (1-based) on which file bytes [fs, fe) of `text`
   hold a non-whitespace byte. */
fn cov_plan_line_numbers(text: string, fs: i32, fe: i32) -> string {
    let mut line: i32 = cov_src_line(text, fs);
    let mut last: i32 = 0;
    let mut out: string = "";
    let mut i: i32 = fs;
    while i < fe {
        let c: i32 = string_char_at(text, i);
        if c == 10 {
            line = line + 1;
        } else {
            let ws: bool = if c == 32 { true } else { if c == 9 { true } else { c == 13 } };
            if ws != true {
                if line != last {
                    if last == 0 { out = cov_src_itoa(line); } else { out = string_concat(string_concat(out, ","), cov_src_itoa(line)); }
                    last = line;
                }
            }
        }
        i = i + 1;
    }
    return out;
}

/* Normalized terms of expression h: equal refs merged, zeros dropped,
   sorted by ref; "+1*entry:<e>" / "-1*branch:<b>:<k>", comma-separated. */
fn cov_plan_terms(cef: Vec<i32>, cet: Vec<i32>, h: i32) -> string {
    if h < 0 { return ""; }
    let first: i32 = vec_get(cef, h * 2);
    let n: i32 = vec_get(cef, h * 2 + 1);
    let refs: Vec<i32> = vec_new();
    let coefs: Vec<i32> = vec_new();
    let mut i: i32 = 0;
    while i < n {
        let c: i32 = vec_get(cet, (first + i) * 2);
        let r: i32 = vec_get(cet, (first + i) * 2 + 1);
        let mut k: i32 = 0;
        let mut found: bool = false;
        while k < vec_len(refs) {
            if vec_get(refs, k) == r {
                vec_set(coefs, k, vec_get(coefs, k) + c);
                found = true;
            }
            k = k + 1;
        }
        if found != true {
            /* insert keeping refs ascending */
            vec_push(refs, r);
            vec_push(coefs, c);
            let mut m: i32 = vec_len(refs) - 1;
            let mut moving: bool = true;
            while moving {
                if m == 0 {
                    moving = false;
                } else {
                    if vec_get(refs, m - 1) > r {
                        vec_set(refs, m, vec_get(refs, m - 1));
                        vec_set(coefs, m, vec_get(coefs, m - 1));
                        vec_set(refs, m - 1, r);
                        vec_set(coefs, m - 1, c);
                        m = m - 1;
                    } else {
                        moving = false;
                    }
                }
            }
        }
        i = i + 1;
    }
    let mut out: string = "";
    let mut j: i32 = 0;
    while j < vec_len(refs) {
        let cj: i32 = vec_get(coefs, j);
        if cj != 0 {
            let rj: i32 = vec_get(refs, j);
            let mut term: string = "";
            if cj > 0 { term = string_concat("+", cov_src_itoa(cj)); } else { term = cov_src_itoa(cj); }
            term = string_concat(term, "*");
            if rj >= 0 {
                term = string_concat(string_concat(term, "entry:"), cov_src_itoa(rj));
            } else {
                let enc: i32 = 0 - rj - 1;
                term = string_concat(string_concat(term, "branch:"), cov_src_itoa(enc / 1024));
                term = string_concat(string_concat(term, ":"), cov_src_itoa(enc % 1024));
            }
            if string_len(out) == 0 { out = term; } else { out = string_concat(string_concat(out, ","), term); }
        }
        j = j + 1;
    }
    return out;
}

/* region/branch dump lines (the plan-dump test hook):
 *   branch  <index> <kind> <entity> <source> <span> <outcome count>
 *           <outcome names, comma-separated>
 *   point   <index> branch_outcome <entity> <branch kind> <source> <span>
 *           <ordinal>
 *   region  <index> <kind> <entity> <source> <span> <line_contributing 0|1>
 *           <line numbers> <counter terms>
 * Regions are ordered by source, span start, span end, then kind name. */
fn cov_plan_region_dump(source: string, starts: Vec<i32>, ends: Vec<i32>,
                        cstarts: Vec<i32>, clens: Vec<i32>, src_unit: Vec<i32>,
                        ent_source: Vec<i32>, rg: Vec<i32>, br: Vec<i32>,
                        cef: Vec<i32>, cet: Vec<i32>, first_point: i32) -> string {
    let mut out: string = "";
    let nb: i32 = vec_len(br) / 5;
    let mut b: i32 = 0;
    while b < nb {
        let be: i32 = vec_get(br, b * 5 + 1);
        let sk: i32 = vec_get(ent_source, be);
        let unit: i32 = vec_get(src_unit, sk);
        out = string_concat(out, string_concat(string_concat("branch\t", cov_src_itoa(b)), "\t"));
        out = string_concat(out, string_concat(cov_br_kind_name(vec_get(br, b * 5)), "\t"));
        out = string_concat(out, string_concat(string_concat(cov_src_itoa(be), "\t"), string_concat(cov_src_itoa(sk), "\t")));
        out = string_concat(out, cov_plan_span_text(source, cstarts, clens, unit,
            vec_get(starts, vec_get(br, b * 5 + 2)), vec_get(ends, vec_get(br, b * 5 + 3))));
        let nout: i32 = vec_get(br, b * 5 + 4);
        out = string_concat(out, string_concat("\t", cov_src_itoa(nout)));
        let mut names: string = "";
        let mut k: i32 = 0;
        while k < nout {
            if k > 0 { names = string_concat(names, ","); }
            names = string_concat(names, cov_outcome_name(vec_get(br, b * 5), k));
            k = k + 1;
        }
        out = string_concat(out, string_concat(string_concat("\t", names), "\n"));
        b = b + 1;
    }
    /* branch_outcome points (CV-109): one per outcome, discriminator = the
       branch kind, span = the branch span; listed after the entry points. */
    let mut pidx: i32 = first_point;
    let mut ob: i32 = 0;
    while ob < nb {
        let obe: i32 = vec_get(br, ob * 5 + 1);
        let osk: i32 = vec_get(ent_source, obe);
        let ospan: string = cov_plan_span_text(source, cstarts, clens, vec_get(src_unit, osk),
            vec_get(starts, vec_get(br, ob * 5 + 2)), vec_get(ends, vec_get(br, ob * 5 + 3)));
        let mut ok: i32 = 0;
        while ok < vec_get(br, ob * 5 + 4) {
            out = string_concat(out, string_concat(string_concat("point\t", cov_src_itoa(pidx)), "\tbranch_outcome\t"));
            out = string_concat(out, string_concat(cov_src_itoa(obe), "\t"));
            out = string_concat(out, string_concat(cov_br_kind_name(vec_get(br, ob * 5)), "\t"));
            out = string_concat(out, string_concat(string_concat(cov_src_itoa(osk), "\t"), ospan));
            out = string_concat(out, string_concat(string_concat("\t", cov_src_itoa(ok)), "\n"));
            pidx = pidx + 1;
            ok = ok + 1;
        }
        ob = ob + 1;
    }
    let nr: i32 = vec_len(rg) / 5;
    let order: Vec<i32> = vec_new();
    let mut i: i32 = 0;
    while i < nr {
        vec_push(order, i);
        let mut m: i32 = vec_len(order) - 1;
        let mut moving: bool = true;
        while moving {
            if m == 0 {
                moving = false;
            } else {
                let a: i32 = vec_get(order, m - 1);
                let sa: i32 = vec_get(ent_source, vec_get(rg, a * 5 + 1));
                let si: i32 = vec_get(ent_source, vec_get(rg, i * 5 + 1));
                let fa: i32 = vec_get(rg, a * 5 + 2);
                let fi: i32 = vec_get(rg, i * 5 + 2);
                let la: i32 = vec_get(rg, a * 5 + 3);
                let li: i32 = vec_get(rg, i * 5 + 3);
                let mut after: bool = false;
                if si < sa { after = true; }
                if si == sa {
                    if fi < fa { after = true; }
                    if fi == fa {
                        if li < la { after = true; }
                        if li == la {
                            if cov_plan_str_lt(cov_rg_kind_name(vec_get(rg, i * 5)), cov_rg_kind_name(vec_get(rg, a * 5))) { after = true; }
                        }
                    }
                }
                if after {
                    vec_set(order, m, a);
                    vec_set(order, m - 1, i);
                    m = m - 1;
                } else {
                    moving = false;
                }
            }
        }
        i = i + 1;
    }
    let mut x: i32 = 0;
    while x < nr {
        let r: i32 = vec_get(order, x);
        let kind: i32 = vec_get(rg, r * 5);
        let re: i32 = vec_get(rg, r * 5 + 1);
        let sk2: i32 = vec_get(ent_source, re);
        let unit2: i32 = vec_get(src_unit, sk2);
        let s: i32 = vec_get(starts, vec_get(rg, r * 5 + 2));
        let en: i32 = vec_get(ends, vec_get(rg, r * 5 + 3));
        let base: i32 = vec_get(cstarts, unit2);
        let text: string = string_substr(source, base, vec_get(clens, unit2));
        let lc: bool = if kind == 2 { false } else { kind != 9 };
        out = string_concat(out, string_concat(string_concat("region\t", cov_src_itoa(x)), "\t"));
        out = string_concat(out, string_concat(cov_rg_kind_name(kind), "\t"));
        out = string_concat(out, string_concat(string_concat(cov_src_itoa(re), "\t"), string_concat(cov_src_itoa(sk2), "\t")));
        out = string_concat(out, cov_plan_span_text(source, cstarts, clens, unit2, s, en));
        if lc { out = string_concat(out, "\t1\t"); } else { out = string_concat(out, "\t0\t"); }
        out = string_concat(out, string_concat(cov_plan_line_numbers(text, s - base, en - base), "\t"));
        out = string_concat(out, string_concat(cov_plan_terms(cef, cet, vec_get(rg, r * 5 + 4)), "\n"));
        x = x + 1;
    }
    return out;
}

/* ── Hit placement table (CV-112) ──────────────────────────────────────────
 *
 * Lowering places hits by AST node (lowering.sv0 lower_cov_*); the planner
 * works on tokens. A construct node is tied to its planned branch through
 * the leftmost source token of its condition (if/while), scrutinee (match),
 * iterable (for), or body (loop): that token lies in the anchor ranges of
 * the constructs enclosing it, and the innermost such branch with the same
 * keyword (if/match/while/for/loop) is the node's own. A node that maps to nothing gets no
 * hit, which the placement check reports as a missing counter (COV1020).
 */

/* Leftmost source token of the expression subtree at `idx` (the parser's
   expression arena, children before parents), or -1 when it has none. */
fn cov_leftmost_tok(et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>, ed3: Vec<i32>, ed4: Vec<i32>,
                    pp: Vec<i32>, idx: i32) -> i32 {
    let mut i: i32 = idx;
    let mut steps: i32 = 0;
    while i >= 0 {
        if i >= vec_len(et) { return 0 - 1; }
        steps = steps + 1;
        if steps > 100000 { return 0 - 1; }
        let t: i32 = vec_get(et, i);
        if t == 0 { return vec_get(ed2, i); }
        if t == 1 { return vec_get(pp, vec_get(ed1, i)); }
        if t == 24 { return vec_get(pp, vec_get(ed1, i)); }
        if t == 27 { return vec_get(ed1, i); }
        let mut next: i32 = 0 - 1;
        if t == 2 { next = vec_get(ed2, i); }
        if t == 3 { next = vec_get(ed2, i); }
        if t == 19 { next = vec_get(ed2, i); }
        if t == 13 { next = vec_get(ed2, i); }
        if t == 9 {
            if vec_get(ed2, i) > 0 {
                let sc: i32 = vec_get(ed4, i);
                if sc > 0 { next = vec_get(pp, sc - 1); } else { next = vec_get(ed1, i); }
            } else {
                next = vec_get(ed3, i);
            }
        }
        let first_d1: bool = if t == 4 { true } else { if t == 5 { true } else { if t == 6 { true } else {
            if t == 7 { true } else { if t == 8 { true } else { if t == 10 { true } else { if t == 11 { true } else {
            if t == 12 { true } else { if t == 14 { true } else { if t == 15 { true } else { if t == 16 { true } else {
            if t == 18 { true } else { if t == 20 { true } else { if t == 21 { true } else { if t == 22 { true } else {
            if t == 23 { true } else { if t == 25 { true } else { if t == 26 { true } else { t == 28 } } } } } } } } } } } } } } } } } };
        if first_d1 { next = vec_get(ed1, i); }
        if t == 21 {
            if next < 0 { next = vec_get(ed2, i); }
        }
        i = next;
    }
    return 0 - 1;
}

/* The node table lowering reads (lower_cov_counter): one entry per
   expression-arena node, the counter of a function body's entry point at
   its body block node, of outcome 0 at an if/while/for/loop/match node,
   else -1. `counters` is cov_map_counters' numbering. */
fn cov_hit_table(tags: Vec<i32>, et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>, ed3: Vec<i32>, ed4: Vec<i32>,
                 pp: Vec<i32>, id4: Vec<i32>, ent_item: Vec<i32>, br: Vec<i32>, counters: Vec<i32>) -> Vec<i32> {
    let n: i32 = vec_len(et);
    let ntok: i32 = vec_len(tags);
    let tab: Vec<i32> = vec_new();
    let mut i: i32 = 0;
    while i < n {
        vec_push(tab, 0 - 1);
        i = i + 1;
    }
    let ne: i32 = vec_len(ent_item);
    let mut e: i32 = 0;
    while e < ne {
        let root: i32 = vec_get(id4, vec_get(ent_item, e));
        if root >= 0 {
            if root < n { vec_set(tab, root, vec_get(counters, e)); }
        }
        e = e + 1;
    }
    /* Each branch's anchor range and first counter. */
    let nb: i32 = vec_len(br) / 5;
    let alo: Vec<i32> = vec_new();
    let ahi: Vec<i32> = vec_new();
    let bctr: Vec<i32> = vec_new();
    let mut b: i32 = 0;
    let mut obase: i32 = 0;
    while b < nb {
        let first: i32 = vec_get(br, b * 5 + 2);
        let open: i32 = cov_tok_body_open(tags, first + 1, ntok);
        if vec_get(tags, first) == 72 {
            vec_push(alo, open + 1);
            vec_push(ahi, vec_get(br, b * 5 + 3) - 1);
        } else {
            vec_push(alo, first + 1);
            vec_push(ahi, open - 1);
        }
        vec_push(bctr, vec_get(counters, ne + obase));
        obase = obase + vec_get(br, b * 5 + 4);
        b = b + 1;
    }
    i = 0;
    while i < n {
        let t: i32 = vec_get(et, i);
        let mut anchor_child: i32 = 0 - 1;
        let mut want: i32 = 0;
        /* want = the construct's keyword token tag */
        if t == 10 { anchor_child = vec_get(ed1, i); want = 68; }
        if t == 11 { anchor_child = vec_get(ed1, i); want = 74; }
        if t == 12 { anchor_child = vec_get(ed1, i); want = 96; }
        if t == 13 { anchor_child = vec_get(ed2, i); want = 66; }
        if t == 14 { anchor_child = vec_get(ed1, i); want = 72; }
        if want > 0 {
            let leaf: i32 = cov_leftmost_tok(et, ed1, ed2, ed3, ed4, pp, anchor_child);
            if leaf >= 0 {
                let mut best: i32 = 0 - 1;
                let mut bb: i32 = 0;
                while bb < nb {
                    if vec_get(tags, vec_get(br, bb * 5 + 2)) == want {
                        if leaf >= vec_get(alo, bb) {
                            if leaf <= vec_get(ahi, bb) {
                                if best < 0 { best = bb; } else {
                                    if vec_get(br, bb * 5 + 2) > vec_get(br, best * 5 + 2) { best = bb; }
                                }
                            }
                        }
                    }
                    bb = bb + 1;
                }
                if best >= 0 { vec_set(tab, i, vec_get(bctr, best)); }
            }
        }
        i = i + 1;
    }
    return tab;
}
