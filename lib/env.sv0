/* Phase 2 real pipeline module: sml/name_resolution/env.sml -> sv0.
   Covers: isPreludeType (string-based, all 22 names), Vec-based
   scope frame management (enter/exit/bind/lookup), module-level
   value registration and dup detection, module-level type registration,
   typeIsRegistered. Remaining: fnArity, tyAlias, registerValueAlias,
   registerTypeAlias, lookupType, resolveCanonicalTy. */

/* ── prelude types ───────────────────────────────────────────── */

fn is_prelude_type(name: string) -> bool {
    if string_eq(name, "i8") { return true; }
    if string_eq(name, "i16") { return true; }
    if string_eq(name, "i32") { return true; }
    if string_eq(name, "i64") { return true; }
    if string_eq(name, "i128") { return true; }
    if string_eq(name, "u8") { return true; }
    if string_eq(name, "u16") { return true; }
    if string_eq(name, "u32") { return true; }
    if string_eq(name, "u64") { return true; }
    if string_eq(name, "u128") { return true; }
    if string_eq(name, "isize") { return true; }
    if string_eq(name, "usize") { return true; }
    if string_eq(name, "f32") { return true; }
    if string_eq(name, "f64") { return true; }
    if string_eq(name, "bool") { return true; }
    if string_eq(name, "char") { return true; }
    if string_eq(name, "str") { return true; }
    if string_eq(name, "string") { return true; }
    if string_eq(name, "String") { return true; }
    if string_eq(name, "unit") { return true; }
    if string_eq(name, "Vec") { return true; }
    if string_eq(name, "Box") { return true; }
    return false;
}

/* ── Vec-of-string helpers (name handles stored as i32) ──── */

fn vec_contains(v: Vec<i32>, name: i32) -> bool {
    let len: i32 = vec_len(v);
    let mut i: i32 = 0;
    while i < len {
        let n: i32 = vec_get(v, i);
        if n == name { return true; }
        i = i + 1;
    }
    return false;
}

/* ── Env representation ─────────────────────────────────────
   Env is a 3-handle tuple: (mod_vals, mod_tys, frames).
   mod_vals: Vec<i32> of interned name handles.
   mod_tys:  Vec<i32> of interned name handles.
   frames:   Vec<i32> where each element is a Vec<i32> handle
             (the inner frame's locals as name handles).
   We pass env fields individually because sv0 cannot box structs.
   ───────────────────────────────────────────────────────────── */

fn env_new_mod_vals() -> Vec<i32> {
    return vec_new();
}

fn env_new_mod_tys() -> Vec<i32> {
    return vec_new();
}

fn env_new_frames() -> Vec<i32> {
    return vec_new();
}

/* ── dup checks ─────────────────────────────────────────────── */

fn dup_mod_val(name: i32, mod_vals: Vec<i32>) -> bool {
    return vec_contains(mod_vals, name);
}

fn dup_mod_ty(name: i32, mod_tys: Vec<i32>) -> bool {
    return vec_contains(mod_tys, name);
}

/* ── register operations ────────────────────────────────────── */

fn register_module_value(mod_vals: Vec<i32>, name: i32) -> i32 {
    vec_push(mod_vals, name);
    return 0;
}

fn register_module_type(mod_tys: Vec<i32>, name: i32) -> i32 {
    vec_push(mod_tys, name);
    return 0;
}

/* type_is_registered checks if a name handle is a known type:
   either a prelude type (by string name) or in the mod_tys vec
   (by handle). Caller must supply the string form for prelude
   check and the handle for mod_tys membership. */
fn type_is_registered_by_handle(name_h: i32, mod_tys: Vec<i32>) -> bool {
    return vec_contains(mod_tys, name_h);
}

/* ── scope operations ───────────────────────────────────────── */

fn enter_scope(frames: Vec<i32>) -> i32 {
    let new_frame: Vec<i32> = vec_new();
    vec_push(frames, new_frame);
    return 0;
}

fn exit_scope(frames: Vec<i32>) -> i32 {
    let len: i32 = vec_len(frames);
    if len == 0 { return 0; }
    vec_set(frames, len - 1, 0);
    return 0;
}

fn bind_local(frames: Vec<i32>, name: i32) -> i32 {
    let len: i32 = vec_len(frames);
    if len == 0 {
        let new_frame: Vec<i32> = vec_new();
        vec_push(new_frame, name);
        vec_push(frames, new_frame);
        return 0;
    }
    let top: Vec<i32> = vec_get(frames, len - 1);
    vec_push(top, name);
    return 0;
}

fn in_frame_vec(name: i32, frame: Vec<i32>) -> bool {
    return vec_contains(frame, name);
}

fn lookup_in_frames(frames: Vec<i32>, name: i32) -> bool {
    let len: i32 = vec_len(frames);
    let mut i: i32 = len - 1;
    while i >= 0 {
        let frame: Vec<i32> = vec_get(frames, i);
        if in_frame_vec(name, frame) { return true; }
        i = i - 1;
    }
    return false;
}

fn lookup_value(mod_vals: Vec<i32>, frames: Vec<i32>, name: i32) -> bool {
    if lookup_in_frames(frames, name) { return true; }
    return vec_contains(mod_vals, name);
}

/* ── tests ──────────────────────────────────────────────────── */

fn test_prelude_types() -> i32 {
    if is_prelude_type("i32") != true { return 1; }
    if is_prelude_type("bool") != true { return 2; }
    if is_prelude_type("Vec") != true { return 3; }
    if is_prelude_type("Box") != true { return 4; }
    if is_prelude_type("String") != true { return 5; }
    if is_prelude_type("FooBar") != false { return 6; }
    if is_prelude_type("") != false { return 7; }
    return 0;
}

fn test_vec_contains() -> i32 {
    let v: Vec<i32> = vec_new();
    if vec_contains(v, 42) != false { return 1; }
    vec_push(v, 10);
    vec_push(v, 20);
    vec_push(v, 30);
    if vec_contains(v, 20) != true { return 2; }
    if vec_contains(v, 99) != false { return 3; }
    return 0;
}

fn test_dup_mod_val() -> i32 {
    let mv: Vec<i32> = vec_new();
    vec_push(mv, 100);
    vec_push(mv, 200);
    if dup_mod_val(100, mv) != true { return 1; }
    if dup_mod_val(300, mv) != false { return 2; }
    return 0;
}

fn test_register_module_value() -> i32 {
    let mv: Vec<i32> = vec_new();
    register_module_value(mv, 42);
    if vec_len(mv) != 1 { return 1; }
    if vec_contains(mv, 42) != true { return 2; }
    register_module_value(mv, 43);
    if vec_len(mv) != 2 { return 3; }
    return 0;
}

fn test_scope_enter_exit() -> i32 {
    let frames: Vec<i32> = vec_new();
    enter_scope(frames);
    if vec_len(frames) != 1 { return 1; }
    enter_scope(frames);
    if vec_len(frames) != 2 { return 2; }
    exit_scope(frames);
    return 0;
}

fn test_bind_and_lookup() -> i32 {
    let mv: Vec<i32> = vec_new();
    let frames: Vec<i32> = vec_new();
    register_module_value(mv, 100);
    if lookup_value(mv, frames, 100) != true { return 1; }
    if lookup_value(mv, frames, 200) != false { return 2; }
    enter_scope(frames);
    bind_local(frames, 200);
    if lookup_value(mv, frames, 200) != true { return 3; }
    enter_scope(frames);
    bind_local(frames, 300);
    if lookup_value(mv, frames, 300) != true { return 4; }
    if lookup_value(mv, frames, 200) != true { return 5; }
    if lookup_value(mv, frames, 999) != false { return 6; }
    return 0;
}

fn main() -> i32 {
    let r1: i32 = test_prelude_types();
    if r1 != 0 { return r1; }
    let r2: i32 = test_vec_contains();
    if r2 != 0 { return 10 + r2; }
    let r3: i32 = test_dup_mod_val();
    if r3 != 0 { return 20 + r3; }
    let r4: i32 = test_register_module_value();
    if r4 != 0 { return 30 + r4; }
    let r5: i32 = test_scope_enter_exit();
    if r5 != 0 { return 40 + r5; }
    let r6: i32 = test_bind_and_lookup();
    if r6 != 0 { return 50 + r6; }
    return 0;
}
