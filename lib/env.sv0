/* Phase 2 real pipeline module: sml/name_resolution/env.sml -> sv0.
   Full env coverage: isPreludeType, Vec-based scope management
   (enter/exit/bind/lookup), module-level value + type registration
   with dup detection, fnArity (interleaved name/arity pairs),
   tyAlias (interleaved from/to handle pairs), registerValueAlias,
   registerTypeAlias, lookupType with alias chain resolution. */

/* ── prelude types ───────────────────────────────────────────── */

fn is_prelude_type(name: string) -> bool {
    if string_eq(name, "i8") { return true; }
    if string_eq(name, "i16") { return true; }
    if string_eq(name, "i32") { return true; }
    if string_eq(name, "i64") { return true; }
    if string_eq(name, "i128") { return true; }
    if string_eq(name, "u8") { return true; }
    if string_eq(name, "u16") { return true; }
    if string_eq(name, "u32") { return true; }
    if string_eq(name, "u64") { return true; }
    if string_eq(name, "u128") { return true; }
    if string_eq(name, "isize") { return true; }
    if string_eq(name, "usize") { return true; }
    if string_eq(name, "f32") { return true; }
    if string_eq(name, "f64") { return true; }
    if string_eq(name, "bool") { return true; }
    if string_eq(name, "char") { return true; }
    if string_eq(name, "str") { return true; }
    if string_eq(name, "string") { return true; }
    if string_eq(name, "String") { return true; }
    if string_eq(name, "unit") { return true; }
    if string_eq(name, "Vec") { return true; }
    if string_eq(name, "Box") { return true; }
    return false;
}

/* ── Vec-of-string helpers (name handles stored as i32) ──── */

fn vec_contains(v: Vec<i32>, name: i32) -> bool {
    let len: i32 = vec_len(v);
    let mut i: i32 = 0;
    while i < len {
        let n: i32 = vec_get(v, i);
        if n == name { return true; }
        i = i + 1;
    }
    return false;
}

/* ── Env representation ─────────────────────────────────────
   Env is a 3-handle tuple: (mod_vals, mod_tys, frames).
   mod_vals: Vec<i32> of interned name handles.
   mod_tys:  Vec<i32> of interned name handles.
   frames:   Vec<i32> where each element is a Vec<i32> handle
             (the inner frame's locals as name handles).
   We pass env fields individually because sv0 cannot box structs.
   ───────────────────────────────────────────────────────────── */

fn env_new_mod_vals() -> Vec<i32> {
    return vec_new();
}

fn env_new_mod_tys() -> Vec<i32> {
    return vec_new();
}

fn env_new_frames() -> Vec<i32> {
    return vec_new();
}

/* ── dup checks ─────────────────────────────────────────────── */

fn dup_mod_val(name: i32, mod_vals: Vec<i32>) -> bool {
    return vec_contains(mod_vals, name);
}

fn dup_mod_ty(name: i32, mod_tys: Vec<i32>) -> bool {
    return vec_contains(mod_tys, name);
}

/* ── register operations ────────────────────────────────────── */

fn register_module_value(mod_vals: Vec<i32>, name: i32) -> i32 {
    vec_push(mod_vals, name);
    return 0;
}

fn register_module_type(mod_tys: Vec<i32>, name: i32) -> i32 {
    vec_push(mod_tys, name);
    return 0;
}

fn type_is_registered_by_handle(name_h: i32, mod_tys: Vec<i32>) -> bool {
    return vec_contains(mod_tys, name_h);
}

fn type_is_registered(name: string, mod_tys: Vec<i32>, name_h: i32) -> bool {
    if is_prelude_type(name) { return true; }
    return vec_contains(mod_tys, name_h);
}

/* ── fn arity table (interleaved: [name, arity, name, arity, …]) ── */

fn env_new_fn_arities() -> Vec<i32> {
    return vec_new();
}

fn dup_fn_arity(fn_arities: Vec<i32>, name: i32) -> bool {
    let len: i32 = vec_len(fn_arities);
    let mut i: i32 = 0;
    while i < len {
        if vec_get(fn_arities, i) == name { return true; }
        i = i + 2;
    }
    return false;
}

fn register_fn_arity(fn_arities: Vec<i32>, name: i32, arity: i32) -> i32 {
    vec_push(fn_arities, name);
    vec_push(fn_arities, arity);
    return 0;
}

fn lookup_fn_arity(fn_arities: Vec<i32>, name: i32) -> i32 {
    let len: i32 = vec_len(fn_arities);
    let mut i: i32 = 0;
    while i < len {
        if vec_get(fn_arities, i) == name {
            return vec_get(fn_arities, i + 1);
        }
        i = i + 2;
    }
    return -1;
}

/* ── type alias table (interleaved: [from, to, from, to, …]) ──── */

fn env_new_ty_aliases() -> Vec<i32> {
    return vec_new();
}

fn has_ty_alias_name(ty_aliases: Vec<i32>, from: i32) -> bool {
    let len: i32 = vec_len(ty_aliases);
    let mut i: i32 = 0;
    while i < len {
        if vec_get(ty_aliases, i) == from { return true; }
        i = i + 2;
    }
    return false;
}

fn find_ty_alias_target(ty_aliases: Vec<i32>, from: i32) -> i32 {
    let len: i32 = vec_len(ty_aliases);
    let mut i: i32 = 0;
    while i < len {
        if vec_get(ty_aliases, i) == from {
            return vec_get(ty_aliases, i + 1);
        }
        i = i + 2;
    }
    return -1;
}

fn resolve_canonical_ty(ty_aliases: Vec<i32>, name: i32) -> i32 {
    let target: i32 = find_ty_alias_target(ty_aliases, name);
    if target == -1 { return name; }
    if target == name { return name; }
    return resolve_canonical_ty(ty_aliases, target);
}

fn register_type_alias(ty_aliases: Vec<i32>, from: i32, to: i32) -> i32 {
    vec_push(ty_aliases, from);
    vec_push(ty_aliases, to);
    return 0;
}

/* ── value alias (registers mod_val + propagates fn arity) ──────
   SML registerValueAlias: looks up target's arity, registers local
   name as a module value with that arity. Returns 0 on success,
   -1 if target arity not found. */
fn register_value_alias(
    mod_vals: Vec<i32>, fn_arities: Vec<i32>,
    local_name: i32, target_name: i32
) -> i32 {
    let ar: i32 = lookup_fn_arity(fn_arities, target_name);
    if ar == -1 { return -1; }
    register_module_value(mod_vals, local_name);
    register_fn_arity(fn_arities, local_name, ar);
    return 0;
}

/* ── lookupType (single-segment, handle-based) ──────────────────
   SML lookupType takes a string list path. sv0 version takes:
   - name_h:     interned handle for the type name
   - name_str:   the string form for prelude checking
   - allow_self: whether "Self" is valid (caller passes 1 for yes)
   - self_h:     the interned handle for "Self"
   Returns true if the type is known. */
fn lookup_type(
    mod_tys: Vec<i32>, ty_aliases: Vec<i32>,
    name_h: i32, name_str: string,
    allow_self: i32, self_h: i32
) -> bool {
    if name_h == self_h { return allow_self == 1; }
    let canon: i32 = resolve_canonical_ty(ty_aliases, name_h);
    if canon != name_h {
        return vec_contains(mod_tys, canon);
    }
    if is_prelude_type(name_str) { return true; }
    return vec_contains(mod_tys, name_h);
}

/* ── scope operations ───────────────────────────────────────── */

fn enter_scope(frames: Vec<i32>) -> i32 {
    let new_frame: Vec<i32> = vec_new();
    vec_push(frames, new_frame);
    return 0;
}

fn exit_scope(frames: Vec<i32>) -> i32 {
    let len: i32 = vec_len(frames);
    if len == 0 { return 0; }
    vec_set(frames, len - 1, 0);
    return 0;
}

fn bind_local(frames: Vec<i32>, name: i32) -> i32 {
    let len: i32 = vec_len(frames);
    if len == 0 {
        let new_frame: Vec<i32> = vec_new();
        vec_push(new_frame, name);
        vec_push(frames, new_frame);
        return 0;
    }
    let top: Vec<i32> = vec_get(frames, len - 1);
    vec_push(top, name);
    return 0;
}

fn in_frame_vec(name: i32, frame: Vec<i32>) -> bool {
    return vec_contains(frame, name);
}

fn lookup_in_frames(frames: Vec<i32>, name: i32) -> bool {
    let len: i32 = vec_len(frames);
    let mut i: i32 = len - 1;
    while i >= 0 {
        let frame: Vec<i32> = vec_get(frames, i);
        if in_frame_vec(name, frame) { return true; }
        i = i - 1;
    }
    return false;
}

fn lookup_value(mod_vals: Vec<i32>, frames: Vec<i32>, name: i32) -> bool {
    if lookup_in_frames(frames, name) { return true; }
    return vec_contains(mod_vals, name);
}

/* ── tests ──────────────────────────────────────────────────── */

fn test_prelude_types() -> i32 {
    if is_prelude_type("i32") != true { return 1; }
    if is_prelude_type("bool") != true { return 2; }
    if is_prelude_type("Vec") != true { return 3; }
    if is_prelude_type("Box") != true { return 4; }
    if is_prelude_type("String") != true { return 5; }
    if is_prelude_type("FooBar") != false { return 6; }
    if is_prelude_type("") != false { return 7; }
    return 0;
}

fn test_vec_contains() -> i32 {
    let v: Vec<i32> = vec_new();
    if vec_contains(v, 42) != false { return 1; }
    vec_push(v, 10);
    vec_push(v, 20);
    vec_push(v, 30);
    if vec_contains(v, 20) != true { return 2; }
    if vec_contains(v, 99) != false { return 3; }
    return 0;
}

fn test_dup_mod_val() -> i32 {
    let mv: Vec<i32> = vec_new();
    vec_push(mv, 100);
    vec_push(mv, 200);
    if dup_mod_val(100, mv) != true { return 1; }
    if dup_mod_val(300, mv) != false { return 2; }
    return 0;
}

fn test_register_module_value() -> i32 {
    let mv: Vec<i32> = vec_new();
    register_module_value(mv, 42);
    if vec_len(mv) != 1 { return 1; }
    if vec_contains(mv, 42) != true { return 2; }
    register_module_value(mv, 43);
    if vec_len(mv) != 2 { return 3; }
    return 0;
}

fn test_scope_enter_exit() -> i32 {
    let frames: Vec<i32> = vec_new();
    enter_scope(frames);
    if vec_len(frames) != 1 { return 1; }
    enter_scope(frames);
    if vec_len(frames) != 2 { return 2; }
    exit_scope(frames);
    return 0;
}

fn test_bind_and_lookup() -> i32 {
    let mv: Vec<i32> = vec_new();
    let frames: Vec<i32> = vec_new();
    register_module_value(mv, 100);
    if lookup_value(mv, frames, 100) != true { return 1; }
    if lookup_value(mv, frames, 200) != false { return 2; }
    enter_scope(frames);
    bind_local(frames, 200);
    if lookup_value(mv, frames, 200) != true { return 3; }
    enter_scope(frames);
    bind_local(frames, 300);
    if lookup_value(mv, frames, 300) != true { return 4; }
    if lookup_value(mv, frames, 200) != true { return 5; }
    if lookup_value(mv, frames, 999) != false { return 6; }
    return 0;
}

fn test_fn_arity() -> i32 {
    let fa: Vec<i32> = env_new_fn_arities();
    if lookup_fn_arity(fa, 10) != -1 { return 1; }
    register_fn_arity(fa, 10, 2);
    register_fn_arity(fa, 20, 3);
    if lookup_fn_arity(fa, 10) != 2 { return 2; }
    if lookup_fn_arity(fa, 20) != 3 { return 3; }
    if lookup_fn_arity(fa, 99) != -1 { return 4; }
    if dup_fn_arity(fa, 10) != true { return 5; }
    if dup_fn_arity(fa, 99) != false { return 6; }
    return 0;
}

fn test_ty_alias() -> i32 {
    let ta: Vec<i32> = env_new_ty_aliases();
    if has_ty_alias_name(ta, 100) != false { return 1; }
    register_type_alias(ta, 100, 200);
    if has_ty_alias_name(ta, 100) != true { return 2; }
    if find_ty_alias_target(ta, 100) != 200 { return 3; }
    if find_ty_alias_target(ta, 999) != -1 { return 4; }
    if resolve_canonical_ty(ta, 100) != 200 { return 5; }
    if resolve_canonical_ty(ta, 999) != 999 { return 6; }
    register_type_alias(ta, 200, 300);
    if resolve_canonical_ty(ta, 100) != 300 { return 7; }
    return 0;
}

fn test_value_alias() -> i32 {
    let mv: Vec<i32> = env_new_mod_vals();
    let fa: Vec<i32> = env_new_fn_arities();
    register_fn_arity(fa, 50, 4);
    let rc: i32 = register_value_alias(mv, fa, 60, 50);
    if rc != 0 { return 1; }
    if vec_contains(mv, 60) != true { return 2; }
    if lookup_fn_arity(fa, 60) != 4 { return 3; }
    let bad: i32 = register_value_alias(mv, fa, 70, 999);
    if bad != -1 { return 4; }
    return 0;
}

fn test_lookup_type() -> i32 {
    let mt: Vec<i32> = env_new_mod_tys();
    let ta: Vec<i32> = env_new_ty_aliases();
    if lookup_type(mt, ta, 1, "i32", 0, 0) != true { return 1; }
    if lookup_type(mt, ta, 2, "Foo", 0, 0) != false { return 2; }
    register_module_type(mt, 3);
    if lookup_type(mt, ta, 3, "MyStruct", 0, 0) != true { return 3; }
    let self_h: i32 = 77;
    if lookup_type(mt, ta, self_h, "Self", 1, self_h) != true { return 4; }
    if lookup_type(mt, ta, self_h, "Self", 0, self_h) != false { return 5; }
    register_type_alias(ta, 500, 3);
    if lookup_type(mt, ta, 500, "Alias", 0, 0) != true { return 6; }
    return 0;
}

fn test_type_is_registered() -> i32 {
    let mt: Vec<i32> = env_new_mod_tys();
    if type_is_registered("i32", mt, 1) != true { return 1; }
    if type_is_registered("bool", mt, 2) != true { return 2; }
    if type_is_registered("Foo", mt, 3) != false { return 3; }
    register_module_type(mt, 3);
    if type_is_registered("Foo", mt, 3) != true { return 4; }
    if type_is_registered("Bar", mt, 99) != false { return 5; }
    return 0;
}

fn test_type_is_registered_by_handle_only() -> i32 {
    let mt: Vec<i32> = env_new_mod_tys();
    if type_is_registered_by_handle(7, mt) != false { return 1; }
    register_module_type(mt, 7);
    if type_is_registered_by_handle(7, mt) != true { return 2; }
    if type_is_registered_by_handle(8, mt) != false { return 3; }
    return 0;
}

fn main() -> i32 {
    let r1: i32 = test_prelude_types();
    if r1 != 0 { return r1; }
    let r2: i32 = test_vec_contains();
    if r2 != 0 { return 10 + r2; }
    let r3: i32 = test_dup_mod_val();
    if r3 != 0 { return 20 + r3; }
    let r4: i32 = test_register_module_value();
    if r4 != 0 { return 30 + r4; }
    let r5: i32 = test_scope_enter_exit();
    if r5 != 0 { return 40 + r5; }
    let r6: i32 = test_bind_and_lookup();
    if r6 != 0 { return 50 + r6; }
    let r7: i32 = test_fn_arity();
    if r7 != 0 { return 60 + r7; }
    let r8: i32 = test_ty_alias();
    if r8 != 0 { return 70 + r8; }
    let r9: i32 = test_value_alias();
    if r9 != 0 { return 80 + r9; }
    let r10: i32 = test_lookup_type();
    if r10 != 0 { return 90 + r10; }
    let r11: i32 = test_type_is_registered();
    if r11 != 0 { return 100 + r11; }
    let r12: i32 = test_type_is_registered_by_handle_only();
    if r12 != 0 { return 110 + r12; }
    return 0;
}
