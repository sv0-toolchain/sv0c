/* Compose main for the native mega-TU — native-compose option (A), step A2.

   NOT a standalone bootstrap unit: it references cross-module entry points
   (`tokenize`, `parse_program`, …) that exist only in the assembled
   `build/megaTU.sv0`. The assembler (scripts/assemble-sv0-megaTU.py) appends this
   file verbatim after the (main-stripped, auto-namespaced) pipeline modules, so
   these bare names resolve to the first-definer real entry points. Do not add it
   to bootstrap-sources.list / self-host-sv0-loop.list.

   A2 status: smoke stage — drives the REAL lexer + parser (composed in the TU) on
   a fixed program and asserts one item parses. Later A2 increments thread
   resolve → check → lower → emit_program over the shared arenas. */

/* ── diagnostics (BH-8 Slice 0) ──────────────────────────────
   The checker populates a flat `diag_sink` of (code, span_tok) pairs (span_tok
   = -1 when unknown). Map each code to its `Exxxx` string + a short message,
   resolve the token to a 1-based (line, col), and format via diagnostic.sv0's
   SML-parity formatters into one stderr write. */

fn megatu_diag_code_str(code: i32) -> string {
    if code == 400 { return "E0400"; }
    if code == 300 { return "E0300"; }
    if code == 301 { return "E0301"; }
    if code == 306 { return "E0306"; }
    if code == 307 { return "E0307"; }
    if code == 309 { return "E0309"; }
    if code == 409 { return "E0409"; }
    if code == 429 { return "E0429"; }
    if code == 446 { return "E0446"; }
    return "E0000";
}

fn megatu_diag_code_msg(code: i32) -> string {
    if code == 400 { return "type mismatch"; }
    if code == 300 { return "unbound name"; }
    if code == 301 { return "unknown type"; }
    if code == 306 { return "unsupported pattern"; }
    if code == 307 { return "wrong number of arguments"; }
    if code == 309 { return "invalid use clause"; }
    if code == 409 { return "contract requires an explicit return type"; }
    if code == 429 { return "no such field"; }
    if code == 446 { return "multi-element tuples are not supported in this slice"; }
    return "error";
}

fn megatu_line_of_pos(source: string, pos: i32) -> i32 {
    if pos < 0 { return 1; }
    let n: i32 = string_len(source);
    let mut line: i32 = 1;
    let mut i: i32 = 0;
    while i < pos {
        if i >= n { return line; }
        if string_char_at(source, i) == 10 { line = line + 1; }
        i = i + 1;
    }
    return line;
}

fn megatu_col_of_pos(source: string, pos: i32) -> i32 {
    if pos < 0 { return 1; }
    let n: i32 = string_len(source);
    let mut col: i32 = 1;
    let mut i: i32 = 0;
    while i < pos {
        if i >= n { return col; }
        if string_char_at(source, i) == 10 { col = 1; } else { col = col + 1; }
        i = i + 1;
    }
    return col;
}

fn megatu_emit_diagnostics(diag_sink: Vec<i32>, source: string,
                           starts: Vec<i32>) -> i32 {
    let n: i32 = vec_len(diag_sink);
    let mut out: string = "";
    let mut i: i32 = 0;
    while i + 1 < n {
        let code: i32 = vec_get(diag_sink, i);
        let tok: i32 = vec_get(diag_sink, i + 1);
        let mut line: i32 = 1;
        let mut col: i32 = 1;
        if tok >= 0 {
            if tok < vec_len(starts) {
                let pos: i32 = vec_get(starts, tok);
                line = megatu_line_of_pos(source, pos);
                col = megatu_col_of_pos(source, pos);
            }
        }
        let header: string = format_header_with_code(0,
            megatu_diag_code_msg(code), megatu_diag_code_str(code));
        out = string_concat(out, header);
        out = string_concat(out, "\n");
        out = string_concat(out, format_location("", line, col));
        out = string_concat(out, "\n");
        let snip: string = format_snippet(source, line, col, 1);
        if string_len(snip) > 0 {
            out = string_concat(out, snip);
            out = string_concat(out, "\n");
        }
        i = i + 2;
    }
    if string_len(out) > 0 { write_file("/dev/stderr", out); }
    return 0;
}

/* M4-S-024: parse whitespace/newline-separated non-negative integers (the proven
   ensures source lines the shell driver writes to the proof-results file). */
fn megatu_parse_ints(s: string) -> Vec<i32> {
    let out: Vec<i32> = vec_new();
    let n: i32 = string_len(s);
    let mut i: i32 = 0;
    let mut cur: i32 = 0;
    let mut have: bool = false;
    while i < n {
        let c: i32 = string_char_at(s, i);
        if c >= 48 {
            if c <= 57 {
                cur = cur * 10 + (c - 48);
                have = true;
            } else {
                if have { vec_push(out, cur); cur = 0; have = false; }
            }
        } else {
            if have { vec_push(out, cur); cur = 0; have = false; }
        }
        i = i + 1;
    }
    if have { vec_push(out, cur); }
    return out;
}

/* Index of char code `ch` in `s` at or after `from`, or -1. */
fn megatu_index_of(s: string, ch: i32, from: i32) -> i32 {
    let n: i32 = string_len(s);
    let mut i: i32 = from;
    while i < n {
        if string_char_at(s, i) == ch { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn main() -> i32 {
    /* M4-S-023/024: the next three lines (smoke source + contract-mode defaults)
       are replaced atomically by the native build's CLI patch
       (build-sv0-megatu-native.sh) to derive them from a `--verified <proof> <src>`
       control file; the committed defaults are runtime mode over the smoke source. */
    let source: string = "enum Opt { None, Some(i32) } fn main() -> i32 { let o: Opt = Opt::Some(5); return match o { Opt::None => 0, Opt::Some(x) => x }; }";
    let _contract_mode: i32 = 0;
    let proven_lines: Vec<i32> = vec_new();

    /* Phase 1: tokenize (real lexer.sv0) */
    let tags: Vec<i32> = vec_new();
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    let tc: i32 = tokenize(source, tags, starts, ends);
    if vec_len(tags) == 0 { return 1; }

    /* Phase 2: parse_program (real parser.sv0) — full arena set */
    let it: Vec<i32> = vec_new();
    let id1: Vec<i32> = vec_new();
    let id2: Vec<i32> = vec_new();
    let id3: Vec<i32> = vec_new();
    let id4: Vec<i32> = vec_new();
    let id5: Vec<i32> = vec_new();
    let pp: Vec<i32> = vec_new();
    let evn: Vec<i32> = vec_new();
    let sfn: Vec<i32> = vec_new();
    let fpn: Vec<i32> = vec_new();
    let fpt: Vec<i32> = vec_new();
    let frt: Vec<i32> = vec_new();
    let fcb: Vec<i32> = vec_new();
    let fcr: Vec<i32> = vec_new();
    let evpt: Vec<i32> = vec_new();
    let evpb: Vec<i32> = vec_new();
    let evpc: Vec<i32> = vec_new();
    let evpm: Vec<i32> = vec_new();
    let ptt: Vec<i32> = vec_new();
    let ptd1: Vec<i32> = vec_new();
    let ptd2: Vec<i32> = vec_new();
    let ptd3: Vec<i32> = vec_new();
    let sft: Vec<i32> = vec_new();
    let bet: Vec<i32> = vec_new();
    let bed1: Vec<i32> = vec_new();
    let bed2: Vec<i32> = vec_new();
    let bed3: Vec<i32> = vec_new();
    let bed4: Vec<i32> = vec_new();
    let bsf: Vec<i32> = vec_new();

    let pr: i32 = parse_program(tags, starts, ends, source, 0,
        it, id1, id2, id3, id4, id5, pp,
        evn, sfn, fpn, fpt, frt, fcb, fcr, evpt, evpb, evpc, evpm,
        ptt, ptd1, ptd2, ptd3, sft,
        bet, bed1, bed2, bed3, bed4, bsf);

    /* At least one top-level item must have parsed (multi-fn programs are now
       supported — the mega-TU threads all items through lower + emit). */
    if vec_len(it) < 1 { return 2; }

    /* Phase 3: resolve (real resolver.sv0). mv/mt/fa are the module value/type/
       arity env the resolver populates; pp is threaded through. 0 = ok. */
    let mv: Vec<i32> = vec_new();
    let mt: Vec<i32> = vec_new();
    let fa: Vec<i32> = vec_new();
    let rr: i32 = resolve_program(bet, bed1, bed2, bed3, bed4,
        it, id1, id2, id3, id4, id5,
        fpn, fpt, frt, fcb, fcr, evpt, evpb, evpc,
        ptt, ptd1, ptd2, ptd3, sft,
        source, starts, ends, mv, mt, fa, pp);
    if rr != 0 {
        /* resolve_program returns the specific error CODE (300 unbound / 301
           unknown type / 306 unsupported pat / 307 arity / 309 use clause) with
           the offending source token packed in (diag_pack) where available.
           Unpack both for a real (line, col); a bare code decodes with tok -1
           (default span). Surfaces E0300/E0301/E0307 (previously a silent
           exit 3). */
        let rdiag: Vec<i32> = vec_new();
        vec_push(rdiag, diag_code_of(rr));
        vec_push(rdiag, diag_tok_of(rr));
        megatu_emit_diagnostics(rdiag, source, starts);
        return 3;
    }

    /* Phase 4: type check (real checker.sv0). tp = type params (none). 0 = ok.
       (Reconciled: a tailless block whose last stmt is `return` now types as
       TY_VAR and unifies with the declared return type — see checker.sv0.) */
    let tp: Vec<i32> = vec_new();
    let diag_sink: Vec<i32> = vec_new();
    let cr: i32 = check_program(tags, source, starts, ends, pp,
        it, id1, id2, id3, id4, id5,
        fpn, fpt, frt, ptt, ptd1, ptd2, ptd3,
        bet, bed1, bed2, bed3, bed4, tp, 0, diag_sink);
    if cr != 0 {
        megatu_emit_diagnostics(diag_sink, source, starts);
        return 4;
    }

    /* Phase 5: lower (real lowering.sv0) — parse arenas -> IR out_blocks; returns
       the typedefs string. item_field_counts (ifc) is the struct field count /
       enum variant count for struct (tag 1) / enum (tag 2) items (both carry it in
       id2), else 0. item_vmax (ivm) is the enum max-payload width (0 here; enum
       payloads are future work). */
    let ifc: Vec<i32> = vec_new();
    let ivm: Vec<i32> = vec_new();
    let mut ii: i32 = 0;
    while ii < vec_len(it) {
        let itag: i32 = vec_get(it, ii);
        if itag == 1 {
            vec_push(ifc, vec_get(id2, ii));
        } else {
            if itag == 2 {
                vec_push(ifc, vec_get(id2, ii));
            } else {
                vec_push(ifc, 0);
            }
        }
        /* item_vmax = number of payload int slots (p0..) the enum typedef needs.
           evpc is the enum's TOTAL payload count (0 for non-enums); it is an upper
           bound on the max-per-variant width the SML compiler uses, so it
           over-allocates slots but is behaviorally correct (exact max would need
           per-variant counts the parser does not retain — future work for P4). */
        vec_push(ivm, vec_get(evpm, ii));
        ii = ii + 1;
    }
    /* Struct field name tokens come straight from the parser (sfn). Field types:
       emit_struct_td wants type-name TOKENS (it handle_to_str's them), but the
       parser stores type-arena ROOTS in sft, so convert each root to its type-name
       token (megatu_type_root_name_tok). */
    let sf_names: Vec<i32> = sfn;
    let sf_types: Vec<i32> = vec_new();
    let mut fti: i32 = 0;
    while fti < vec_len(sft) {
        vec_push(sf_types, megatu_type_root_name_tok(vec_get(sft, fti),
                                                     ptt, ptd1, ptd2, pp));
        fti = fti + 1;
    }
    let ob: Vec<i32> = vec_new();
    let osn: Vec<i32> = vec_new();
    let oso: Vec<i32> = vec_new();
    let osc: Vec<i32> = vec_new();
    let osf: Vec<i32> = vec_new();
    let oen: Vec<i32> = vec_new();
    let oeto: Vec<i32> = vec_new();
    let oetc: Vec<i32> = vec_new();
    let oetf: Vec<i32> = vec_new();
    let oem: Vec<i32> = vec_new();
    let out_blocks: Vec<i32> = vec_new();
    let imp: Vec<i32> = vec_new();
    let td: string = lower(it, id1, id2, id3, id4, ifc, ivm,
        sfn, evn, sf_names, sf_types,
        source, starts, ends,
        ob, osn, oso, osc, osf,
        oen, oeto, oetc, oetf, oem,
        bet, bed1, bed2, bed3, bed4, bsf,
        pp, tags, out_blocks, imp, fcr, fcb, frt, ptt, ptd1,
        _contract_mode, proven_lines);

    /* Phase 6: emit C. codegen's emit_program AND its body emit (emit_instrs)
       use hardcoded test stubs — name_of (token-index -> fabricated names,
       `label_h == 11` for main) and op_of (ad-hoc 1-8 operator table). Bridge the
       whole emit here: megatu_emit_program resolves fn names via lowering's
       handle_to_str + detects main by name, and megatu_emit_instrs (below)
       resolves body var/temp names and AST binop/unop operators against the real
       source. This is the native-compose (A) de-stub, done in the compose main so
       codegen.sv0 stays standalone-compilable. */
    /* BH-12: assign shadow indices to local-var name tokens (0 = no shadow) so
       the emit renders re-bound names as `x_N` instead of redeclaring `x`. */
    let sidx: Vec<i32> = assign_shadow_indices(it, id3, id4, id5, fpn,
                                               bet, bed1, bed2, bed3, bed4, pp,
                                               source, starts, ends);
    let c: string = megatu_emit_program(td, out_blocks, source, starts, ends,
                                        it, id1, id2, id3, id5, fpn,
                                        fpt, frt, ptt, ptd1, ptd2, pp, sidx);
    if string_len(c) == 0 { return 5; }

    /* MILESTONE: all six real phases (tokenize -> parse -> resolve -> check ->
       lower -> emit_program) compose and RUN in the native mega-TU with a fully
       de-stubbed emit including user struct types. This smoke program
       (`struct P { x: i32 }` + `fn getx(p: P) -> i32 { p.x }`) emits a
       `typedef struct { int x; } P;`, a `static int getx(P p) { return p.x; }`,
       and runs to exit 42. Native-vs-SML behavioral parity holds across the
       first-order surface: literals/operators (`1+2*3` -> 7), `let` locals
       (`let x=5; return x` -> 5), multi-fn calls with params (`add(2,5)` -> 7),
       non-i32 types (`fn wide(a: u8, b: i64) -> i64` -> int64_t/uint8_t, exit 9;
       `-> bool` -> int; void), and structs as param/return types with field
       access (`p.x`) and pass-through (`return p`). Fixes that got here:
       return-stmt lowering, box/vec convention, source-aware fn + body names,
       integer-literal values, the body operator/name de-stub (lower_temp_base),
       the block statement-order sidecar (block_stmt_index), the checker body path
       pool (real pp), the calls/params de-stub, real C types for params + returns
       (megatu_cty_of_root, including user struct/enum names via megatu_is_user_type
       by text), struct typedefs with fields (ifc + sf_names/sf_types threaded from
       the parser), bare-`return;` lowering (ReturnVoid), and struct literal
       construction — this smoke's `let q: P = P { x: 7 }; return getx(q)` lowers to
       `P q; P _sv0t0; _sv0t0.x = 7; q = _sv0t0;` + a call and runs to exit 7.
       Construction needed (1) the parser to thread the struct field-name pool
       through parse_expr (parse_expr_sf) so ExprStruct field names reach body_sf,
       and (2) lower to declare a struct-literal-initialised `let` with the struct
       type (DeclNamed) not int, and nullary enum variants — this smoke's
       `enum Color { Red, Green, Blue }` + `let c: Color = Color::Green; c.tag`
       emits `typedef struct { int tag; } Color;`, and matches on it: this smoke's
       `match c { Color::Red => 10, Color::Green => 20, Color::Blue => 30 }` lowers
       to an `if ((c.tag == 0)) ... else if ((c.tag == 1)) { 20 } ...` chain and
       returns 20 (Green). Enums needed the resolver to accept `Enum::Variant` value
       paths (coarse), a text-based variant-tag lookup (enum_tag_lookup_str; the
       tables hold definition tokens, ctors/patterns carry use tokens), the
       tag/payload field-name resolver in emit (megatu_field_name: -1 -> "tag",
       -10-i -> "p<i>"), enum-ctor `let`-type inference, the match arm-order sidecar
       (arm nodes are non-contiguous, like block statements — reuse block_stmt_index
       via ExprMatch d4), match patterns parsed into the SHARED pp (so PatEnum path
       tokens survive for lower), and the match comparison ops remapped from the old
       codegen op_of encoding (4 = "==") to the AST encoding the emitter uses
       (5 = Eq, 6 = Neq). Payload variants also work: this smoke's
       `enum Opt { None, Some(i32) }` + `let o = Opt::Some(5); match o { Opt::None
       => 0, Opt::Some(x) => x }` emits `typedef struct { int tag; int p0; } Opt;`,
       lowers the ctor to `_sv0t0.tag = 1; _sv0t0.p0 = 5;`, and the match arm to
       `int x = o.p0; ... = x;`, returning 5. Payloads needed item_vmax = the enum's
       payload-slot count (from evpc, an upper bound on the per-variant max), the
       `let`-type for a payload ctor (an ExprCall with a 2-seg callee -> the enum
       type), and payload PatBind registration in the resolver and checker (walk the
       ExprPatEnumMeta -> ExprPatFieldEmbed rows; the ctor payload store and match
       payload bind already existed in lower). NEXT: exact per-variant item_vmax (for
       P4 byte-exactness); calls to non-int fns (Call rt_h is 0 = int); `let` types
       for non-struct/enum inits (still int); then the self-host-sv0-loop corpus for
       native-vs-SML parity; then A3 (--target=vm) and P4. */
    return 0;
}

/* Find the item index of the ItemFn whose name token is label_h (blocks carry the
   fn name token as their label). Lets the emit recover per-fn param data that
   lower() does not thread into out_blocks. */
fn megatu_find_item_by_label(it: Vec<i32>, id1: Vec<i32>, label_h: i32) -> i32 {
    let n: i32 = vec_len(it);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(it, i) == 0 {
            if vec_get(id1, i) == label_h {
                return i;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

/* Type-name token of a type-arena root: for TyName (tag 0) the last path segment
   token; -1 otherwise. Used to build the sf_types token array emit_struct_td wants. */
fn megatu_type_root_name_tok(root: i32, ptt: Vec<i32>, ptd1: Vec<i32>,
                             ptd2: Vec<i32>, pp: Vec<i32>) -> i32 {
    if root < 0 {
        return 0 - 1;
    }
    if vec_get(ptt, root) == 0 {
        let segc: i32 = vec_get(ptd2, root);
        if segc <= 0 {
            return 0 - 1;
        }
        return vec_get(pp, vec_get(ptd1, root) + segc - 1);
    }
    return 0 - 1;
}

/* True if `nm` names a top-level struct (tag 1) or enum (tag 2) item, by text.
   Matches on the source text (not token index) — a type reference and the struct/
   enum definition are different tokens with the same spelling. */
fn megatu_is_user_type(nm: string, it: Vec<i32>, id1: Vec<i32>,
                       source: string, starts: Vec<i32>, ends: Vec<i32>) -> bool {
    let n: i32 = vec_len(it);
    let mut i: i32 = 0;
    while i < n {
        let tg: i32 = vec_get(it, i);
        if tg == 1 {
            if string_eq(handle_to_str(vec_get(id1, i), source, starts, ends), nm) {
                return true;
            }
        }
        if tg == 2 {
            if string_eq(handle_to_str(vec_get(id1, i), source, starts, ends), nm) {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

/* Resolve a type-arena root (parser pty_tt/ptd1/ptd2 arena) to its C type string.
   TyName (tag 0): ptd1 = path start in pp, ptd2 = segment count; the last segment
   is the type name, mapped via lowering's ast_ty_to_c_string (i32->int, bool->int,
   i8->int8_t, u8->uint8_t, i64->int64_t, string->const char*, unit->void, ...). A
   name that is not a primitive but matches a top-level struct/enum resolves to that
   typedef name (the emitted C typedef). root < 0 means no type (unit) -> "void".
   TyRef and other constructors fall back to "int". */
fn megatu_cty_of_root(root: i32, ptt: Vec<i32>, ptd1: Vec<i32>, ptd2: Vec<i32>,
                      pp: Vec<i32>, source: string, starts: Vec<i32>,
                      ends: Vec<i32>, it: Vec<i32>, id1: Vec<i32>) -> string {
    if root < 0 {
        return "void";
    }
    /* TyUnit (ty_tag 6, `-> ()`): an explicit unit return type is void. Without
       this it falls through to "int", so a `fn f(..) -> ()` with bare `return;`
       emits as `int f(..)` -> -Wreturn-mismatch (e.g. driver.sv0 drv_resolve_expr). */
    if vec_get(ptt, root) == 6 {
        return "void";
    }
    if vec_get(ptt, root) == 0 {
        let ppstart: i32 = vec_get(ptd1, root);
        let segc: i32 = vec_get(ptd2, root);
        if segc <= 0 {
            return "int";
        }
        let name_tok: i32 = vec_get(pp, ppstart + segc - 1);
        let nm: string = handle_to_str(name_tok, source, starts, ends);
        let prim: string = ast_ty_to_c_string(nm);
        if !string_eq(prim, "int") {
            return prim;
        }
        if megatu_is_user_type(nm, it, id1, source, starts, ends) {
            return nm;
        }
        return "int";
    }
    return "int";
}

/* Build the C parameter list for fn item `item_i`. Param name tokens live in fpn
   (fn_param_name_toks) at base id5[item_i]; the parallel type roots live in fpt
   (fn_param_ty_root), resolved via megatu_cty_of_root. param_count in id3[item_i].
   lower() currently pushes empty params into out_blocks, so the emit reconstructs
   them here from the parse arenas — the params de-stub, matching the fn-name and
   body de-stubs. */
fn megatu_param_list(item_i: i32, it: Vec<i32>, id1: Vec<i32>, id3: Vec<i32>,
                     id5: Vec<i32>, fpn: Vec<i32>,
                     fpt: Vec<i32>, ptt: Vec<i32>, ptd1: Vec<i32>, ptd2: Vec<i32>,
                     pp: Vec<i32>, source: string, starts: Vec<i32>,
                     ends: Vec<i32>) -> string {
    if item_i < 0 { return "void"; }
    let pc: i32 = vec_get(id3, item_i);
    if pc == 0 { return "void"; }
    let base: i32 = vec_get(id5, item_i);
    let mut out: string = "";
    let mut k: i32 = 0;
    while k < pc {
        if k > 0 {
            out = string_concat(out, ", ");
        }
        let nt: i32 = vec_get(fpn, base + k);
        let nm: string = handle_to_str(nt, source, starts, ends);
        let cty: string = megatu_cty_of_root(vec_get(fpt, base + k),
                                             ptt, ptd1, ptd2, pp,
                                             source, starts, ends, it, id1);
        out = string_concat(out, string_concat(string_concat(cty, " "), nm));
        k = k + 1;
    }
    return out;
}

/* Source-aware C emit (native-compose A de-stub). Same shape as codegen.sv0's
   emit_program, but resolves each block's fn name via lowering's handle_to_str
   (real source names) instead of the stub name_of, detects main by name, builds
   the parameter list from the parse arenas (megatu_param_list), and emits the body
   via the source-aware megatu_emit_instrs. Lives in the compose main so it can see
   BOTH modules; codegen.sv0 stays a standalone unit. */
fn megatu_emit_program(typedefs: string, blocks: Vec<i32>,
                       source: string, starts: Vec<i32>, ends: Vec<i32>,
                       it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
                       id3: Vec<i32>, id5: Vec<i32>, fpn: Vec<i32>,
                       fpt: Vec<i32>, frt: Vec<i32>,
                       ptt: Vec<i32>, ptd1: Vec<i32>, ptd2: Vec<i32>,
                       pp: Vec<i32>, sidx: Vec<i32>) -> string {
    let num_blocks: i32 = vec_len(blocks) / 4;
    if num_blocks == 0 {
        return "#include \"sv0_runtime.h\"\nint main(void) { return 0; }\n";
    }
    let prelude: string = "#include \"sv0_runtime.h\"\n\n";
    let mut td_part: string = "";
    if string_eq(typedefs, "") != true {
        td_part = string_concat(typedefs, "\n");
    }
    let mut fwd_decls: string = "";
    let mut statics: string = "";
    let mut main_part: string = "";
    let mut idx: i32 = 0;
    while idx < num_blocks {
        let label_h: i32 = vec_get(blocks, idx * 4);
        let ret_h: i32 = vec_get(blocks, idx * 4 + 1);
        /* lower stores params/instrs as box_new(vec); box_deref to recover them.
           The params box is empty (lower does not fill it yet); the real param
           list is rebuilt below from the parse arenas via megatu_param_list. */
        let instrs: Vec<i32> = box_deref(vec_get(blocks, idx * 4 + 3));
        let fn_name: string = handle_to_str(label_h, source, starts, ends);
        let item_i: i32 = megatu_find_item_by_label(it, id1, label_h);
        /* Return type from the item, not the hardcoded ret_h (lower always emits 9
           = int). has_ret is the low bit of id2 (id2 = has_ret + contract*2); a
           fn with no `-> T` returns void, else resolve frt (fn_ret_ty_root). */
        let mut ret_name: string = name_of(ret_h);
        if item_i >= 0 {
            let idv: i32 = vec_get(id2, item_i);
            let has_ret: i32 = idv - (idv / 2) * 2;
            if has_ret == 0 {
                ret_name = "void";
            } else {
                ret_name = megatu_cty_of_root(vec_get(frt, item_i),
                                             ptt, ptd1, ptd2, pp,
                                             source, starts, ends, it, id1);
            }
        }
        let pstr: string = megatu_param_list(item_i, it, id1, id3, id5, fpn,
                                             fpt, ptt, ptd1, ptd2, pp,
                                             source, starts, ends);
        let sig: string = string_concat(fn_name,
            string_concat("(", string_concat(pstr, ")")));
        /* Body via the source-aware emitter (not codegen's emit_instrs, whose
           name_of/op_of are test stubs): resolves var/temp names and operators
           against the real source. This is the body-level de-stub. */
        let body: string = megatu_emit_instrs(instrs, "  ", ret_name,
                                              source, starts, ends, sidx);
        if string_eq(fn_name, "main") {
            let proto: string = string_concat(ret_name, string_concat(" ", sig));
            main_part = emit_block_defn(proto, body);
        } else {
            let proto: string = string_concat("static ",
                string_concat(ret_name, string_concat(" ", sig)));
            fwd_decls = string_concat(fwd_decls, string_concat(proto, ";\n"));
            statics = string_concat(statics, emit_block_defn(proto, body));
        }
        idx = idx + 1;
    }
    if string_eq(main_part, "") {
        main_part = "int main(void) { return 0; }\n";
    }
    let mut out: string = string_concat(prelude, td_part);
    out = string_concat(out, fwd_decls);
    out = string_concat(out, "\n");
    out = string_concat(out, statics);
    return string_concat(out, main_part);
}

/* ── Body-level de-stub (native-compose A) ──────────────────────────────────
   codegen.sv0's emit_instrs resolves body names via name_of (a hardcoded test
   stub: 1->x, 12->foo, …) and operators via op_of (an ad-hoc 1-8 table). The
   real pipeline carries source-token handles for names and AST binop/unop tags
   for operators, so codegen's stubs emit `?`. These megatu_* mirrors reproduce
   codegen's emit tree exactly but resolve:
     - variable/temp names  via megatu_val_name (temps >= lower_temp_base ->
       "_sv0t<n>", tuple fields 500..599 -> "f<n>", else handle_to_str),
     - type names           via megatu_ty_name (name_of for int/void, else source),
     - operators            via the real AST binop/unop -> C tables.
   The SML reference (ir.sml) carries these as strings pre-resolved at lowering
   time; the flat i32 IR defers resolution to emit, which is what happens here.
   Lives in the compose main so codegen.sv0 stays a standalone-compilable unit. */

/* ── shadowing pre-pass (BH-12) ───────────────────────────────
   sv0 permits `let` shadowing (`let x = 10; let x = x + 32`), but a flat C
   function scope cannot redeclare `x`. This pass assigns each local-variable name
   TOKEN a shadow index N: the first binding of a name in a function is 0 (emitted
   as `x`), each subsequent binding (sequential or in a nested block) gets a fresh
   N (emitted as `x_N`); a reference resolves to the index of its currently-live
   binding. Non-shadowing code keeps index 0 everywhere, so its emit is byte
   identical — the whole thing lives in the compose main (not a golden module) and
   only kicks in when a name is actually re-bound. env_len is a logical stack
   length (no vec_pop): a block records the length on entry and restores it on
   exit; cnt_* is a persistent per-name counter for fresh-index allocation. */

fn sh_name_eq(source: string, starts: Vec<i32>, ends: Vec<i32>, a: i32, b: i32) -> bool {
    if a < 0 { return false; }
    if b < 0 { return false; }
    let as2: i32 = vec_get(starts, a);
    let ae: i32 = vec_get(ends, a);
    let bs: i32 = vec_get(starts, b);
    let be: i32 = vec_get(ends, b);
    return string_eq(string_substr(source, as2, ae - as2),
                     string_substr(source, bs, be - bs));
}

/* A new binding's shadow index = how many bindings of the same name are CURRENTLY
   LIVE (in scope). 0 when none (the common case) -> bare name; 1 when it shadows
   one live binding -> `_1`; etc. Scope-depth based, NOT a persistent counter, so
   two *disjoint* (sibling-scope) bindings of a name both get 0 and are never
   spuriously renamed — only a genuine live shadow (sequential same-block or a
   nested inner block) is. */
fn sh_live_count(env_tok: Vec<i32>, env_len: Vec<i32>,
                 source: string, starts: Vec<i32>, ends: Vec<i32>, name_tok: i32) -> i32 {
    let len: i32 = vec_get(env_len, 0);
    let mut c: i32 = 0;
    let mut j: i32 = 0;
    while j < len {
        if sh_name_eq(source, starts, ends, vec_get(env_tok, j), name_tok) {
            c = c + 1;
        }
        j = j + 1;
    }
    return c;
}

fn sh_lookup_idx(env_tok: Vec<i32>, env_idx: Vec<i32>, env_len: Vec<i32>,
                 source: string, starts: Vec<i32>, ends: Vec<i32>, name_tok: i32) -> i32 {
    let mut j: i32 = vec_get(env_len, 0) - 1;
    while j >= 0 {
        if sh_name_eq(source, starts, ends, vec_get(env_tok, j), name_tok) {
            return vec_get(env_idx, j);
        }
        j = j - 1;
    }
    return 0;
}

fn sh_env_push(env_tok: Vec<i32>, env_idx: Vec<i32>, env_len: Vec<i32>,
               tok: i32, idx: i32) -> i32 {
    let len: i32 = vec_get(env_len, 0);
    if len < vec_len(env_tok) {
        vec_set(env_tok, len, tok);
        vec_set(env_idx, len, idx);
    } else {
        vec_push(env_tok, tok);
        vec_push(env_idx, idx);
    }
    vec_set(env_len, 0, len + 1);
    return 0;
}

fn sh_set_sidx(sidx: Vec<i32>, tok: i32, idx: i32) -> i32 {
    if tok >= 0 {
        if tok < vec_len(sidx) {
            vec_set(sidx, tok, idx);
        }
    }
    return 0;
}

fn sh_walk(idx: i32, bet: Vec<i32>, bed1: Vec<i32>, bed2: Vec<i32>,
           bed3: Vec<i32>, bed4: Vec<i32>, bpp: Vec<i32>,
           source: string, starts: Vec<i32>, ends: Vec<i32>,
           sidx: Vec<i32>, env_tok: Vec<i32>, env_idx: Vec<i32>, env_len: Vec<i32>,
           cnt_tok: Vec<i32>, cnt_val: Vec<i32>) -> i32 {
    if idx < 0 { return 0; }
    if idx >= vec_len(bet) { return 0; }
    let tag: i32 = vec_get(bet, idx);
    if tag == 9 {
        let mark: i32 = vec_get(env_len, 0);
        let sfirst: i32 = vec_get(bed1, idx);
        let scount: i32 = vec_get(bed2, idx);
        let tail: i32 = vec_get(bed3, idx);
        let sidecar: i32 = vec_get(bed4, idx);
        let mut si: i32 = 0;
        while si < scount {
            let st: i32 = block_stmt_index(bpp, sfirst, sidecar, si);
            let _r: i32 = sh_walk(st, bet, bed1, bed2, bed3, bed4, bpp,
                                  source, starts, ends, sidx, env_tok, env_idx,
                                  env_len, cnt_tok, cnt_val);
            si = si + 1;
        }
        if tail >= 0 {
            let _t: i32 = sh_walk(tail, bet, bed1, bed2, bed3, bed4, bpp,
                                  source, starts, ends, sidx, env_tok, env_idx,
                                  env_len, cnt_tok, cnt_val);
        }
        vec_set(env_len, 0, mark);
        return 0;
    }
    if tag == 27 {
        let init: i32 = vec_get(bed3, idx);
        if init >= 0 {
            let _i: i32 = sh_walk(init, bet, bed1, bed2, bed3, bed4, bpp,
                                  source, starts, ends, sidx, env_tok, env_idx,
                                  env_len, cnt_tok, cnt_val);
        }
        let name_tok: i32 = vec_get(bed1, idx);
        let nidx: i32 = sh_live_count(env_tok, env_len, source, starts, ends, name_tok);
        let _s: i32 = sh_set_sidx(sidx, name_tok, nidx);
        let _p: i32 = sh_env_push(env_tok, env_idx, env_len, name_tok, nidx);
        return 0;
    }
    if tag == 28 {
        return sh_walk(vec_get(bed1, idx), bet, bed1, bed2, bed3, bed4, bpp,
                       source, starts, ends, sidx, env_tok, env_idx, env_len,
                       cnt_tok, cnt_val);
    }
    if tag == 1 {
        if vec_get(bed2, idx) == 1 {
            let pps: i32 = vec_get(bed1, idx);
            if pps >= 0 {
                if pps < vec_len(bpp) {
                    let rtok: i32 = vec_get(bpp, pps);
                    let ridx: i32 = sh_lookup_idx(env_tok, env_idx, env_len,
                                                  source, starts, ends, rtok);
                    let _s: i32 = sh_set_sidx(sidx, rtok, ridx);
                }
            }
        }
        return 0;
    }
    if tag == 2 {
        return sh_walk(vec_get(bed2, idx), bet, bed1, bed2, bed3, bed4, bpp,
                       source, starts, ends, sidx, env_tok, env_idx, env_len,
                       cnt_tok, cnt_val);
    }
    if tag == 3 {
        let _l: i32 = sh_walk(vec_get(bed2, idx), bet, bed1, bed2, bed3, bed4, bpp,
                              source, starts, ends, sidx, env_tok, env_idx, env_len,
                              cnt_tok, cnt_val);
        return sh_walk(vec_get(bed3, idx), bet, bed1, bed2, bed3, bed4, bpp,
                       source, starts, ends, sidx, env_tok, env_idx, env_len,
                       cnt_tok, cnt_val);
    }
    if tag == 15 {
        return sh_walk(vec_get(bed1, idx), bet, bed1, bed2, bed3, bed4, bpp,
                       source, starts, ends, sidx, env_tok, env_idx, env_len,
                       cnt_tok, cnt_val);
    }
    if tag == 18 {
        let _l: i32 = sh_walk(vec_get(bed1, idx), bet, bed1, bed2, bed3, bed4, bpp,
                              source, starts, ends, sidx, env_tok, env_idx, env_len,
                              cnt_tok, cnt_val);
        return sh_walk(vec_get(bed2, idx), bet, bed1, bed2, bed3, bed4, bpp,
                       source, starts, ends, sidx, env_tok, env_idx, env_len,
                       cnt_tok, cnt_val);
    }
    if tag == 10 {
        let _c: i32 = sh_walk(vec_get(bed1, idx), bet, bed1, bed2, bed3, bed4, bpp,
                              source, starts, ends, sidx, env_tok, env_idx, env_len,
                              cnt_tok, cnt_val);
        let _th: i32 = sh_walk(vec_get(bed2, idx), bet, bed1, bed2, bed3, bed4, bpp,
                               source, starts, ends, sidx, env_tok, env_idx, env_len,
                               cnt_tok, cnt_val);
        return sh_walk(vec_get(bed3, idx), bet, bed1, bed2, bed3, bed4, bpp,
                       source, starts, ends, sidx, env_tok, env_idx, env_len,
                       cnt_tok, cnt_val);
    }
    if tag == 4 {
        let _ce: i32 = sh_walk(vec_get(bed1, idx), bet, bed1, bed2, bed3, bed4, bpp,
                               source, starts, ends, sidx, env_tok, env_idx, env_len,
                               cnt_tok, cnt_val);
        let af: i32 = vec_get(bed2, idx);
        let ac: i32 = vec_get(bed3, idx);
        let asc: i32 = vec_get(bed4, idx);
        let mut ai: i32 = 0;
        while ai < ac {
            let ax: i32 = block_stmt_index(bpp, af, asc, ai);
            let _a: i32 = sh_walk(ax, bet, bed1, bed2, bed3, bed4, bpp,
                                  source, starts, ends, sidx, env_tok, env_idx,
                                  env_len, cnt_tok, cnt_val);
            ai = ai + 1;
        }
        return 0;
    }
    return 0;
}

fn assign_shadow_indices(it: Vec<i32>, id3: Vec<i32>, id4: Vec<i32>, id5: Vec<i32>,
                         fpn: Vec<i32>, bet: Vec<i32>, bed1: Vec<i32>, bed2: Vec<i32>,
                         bed3: Vec<i32>, bed4: Vec<i32>, bpp: Vec<i32>,
                         source: string, starts: Vec<i32>, ends: Vec<i32>) -> Vec<i32> {
    let sidx: Vec<i32> = vec_new();
    let ntok: i32 = vec_len(starts);
    let mut z: i32 = 0;
    while z < ntok { vec_push(sidx, 0); z = z + 1; }
    let ni: i32 = vec_len(it);
    let mut i: i32 = 0;
    while i < ni {
        if vec_get(it, i) == 0 {
            let body_root: i32 = vec_get(id4, i);
            let param_count: i32 = vec_get(id3, i);
            let pbase: i32 = vec_get(id5, i);
            let env_tok: Vec<i32> = vec_new();
            let env_idx: Vec<i32> = vec_new();
            let env_len: Vec<i32> = vec_new();
            vec_push(env_len, 0);
            let cnt_tok: Vec<i32> = vec_new();
            let cnt_val: Vec<i32> = vec_new();
            let mut pj: i32 = 0;
            while pj < param_count {
                let ptok: i32 = vec_get(fpn, pbase + pj);
                let pidx: i32 = sh_live_count(env_tok, env_len, source, starts, ends, ptok);
                let _pp: i32 = sh_env_push(env_tok, env_idx, env_len, ptok, pidx);
                pj = pj + 1;
            }
            if body_root >= 0 {
                let _w: i32 = sh_walk(body_root, bet, bed1, bed2, bed3, bed4, bpp,
                                      source, starts, ends, sidx, env_tok, env_idx,
                                      env_len, cnt_tok, cnt_val);
            }
        }
        i = i + 1;
    }
    return sidx;
}

fn megatu_val_name(h: i32, source: string, starts: Vec<i32>, ends: Vec<i32>,
                   sidx: Vec<i32>) -> string {
    if h >= lower_temp_base() {
        return string_concat("_sv0t", int_to_string(h - lower_temp_base()));
    }
    /* NB: no 500..599 -> f<n> branch here. That range is the tuple-field synthetic
       handle space and belongs only to megatu_field_name (VMember/StoreField field
       positions). A *value* handle is a temp (>= lower_temp_base) or a real source
       token — and in a large module real token indices reach 500+, so treating
       them as tuple fields renders e.g. a call to token 524 as `f24`. */
    let base: string = handle_to_str(h, source, starts, ends);
    /* BH-12: a shadowed local's token carries a nonzero shadow index -> `<name>_N`;
       index 0 (the common case: no shadowing, plus fn/field/param names) is the
       bare source name, so non-shadowing emit is unchanged. */
    if h >= 0 {
        if h < vec_len(sidx) {
            let sN: i32 = vec_get(sidx, h);
            if sN > 0 {
                return string_concat(string_concat(base, "_"), int_to_string(sN));
            }
        }
    }
    return base;
}

/* Resolve a struct/enum field handle to its C field name. Enum layout (see
   emit_enum_td / the enum-ctor lowering): the tag field is the sentinel -1 ->
   "tag", and payload i is the sentinel -10 - i -> "p<i>". Tuple projection fields
   use 500..599 -> "f<n>". Everything else is a struct field name token. */
fn megatu_field_name(fh: i32, source: string, starts: Vec<i32>,
                     ends: Vec<i32>) -> string {
    if fh == 0 - 1 {
        return "tag";
    }
    if fh <= 0 - 10 {
        return string_concat("p", int_to_string(0 - 10 - fh));
    }
    if fh >= 500 {
        if fh < 600 {
            return string_concat("f", int_to_string(fh - 500));
        }
    }
    return handle_to_str(fh, source, starts, ends);
}

/* Builtin id (lowering build_builtin_map: println=1 … read_dir=17) -> runtime C
   function name. Builtin calls lower to Call(dst, 0 - id, args, rt), so the emit
   maps the negated sentinel back here. Value-returning string builtins
   (string_concat/substr) still get an `int` dest today — non-int call returns are
   a separate gap — so string_api is not yet fully supported. */
fn megatu_builtin_name(bid: i32) -> string {
    if bid == 1 { return "sv0_println"; }
    if bid == 2 { return "sv0_string_len"; }
    if bid == 3 { return "sv0_string_eq"; }
    if bid == 4 { return "sv0_string_concat"; }
    if bid == 5 { return "sv0_string_char_at"; }
    if bid == 6 { return "sv0_string_substr"; }
    if bid == 7 { return "sv0_vec_new"; }
    if bid == 8 { return "sv0_vec_push"; }
    if bid == 9 { return "sv0_vec_len"; }
    if bid == 10 { return "sv0_vec_get"; }
    if bid == 11 { return "sv0_vec_set"; }
    /* box_new/box_deref: every composed value is a single-word int handle
       (structs/enums are handles, not flat multi-word values), so the golden's
       multi-word .tag/.p0 box expansion collapses to boxing one word. Map to
       the runtime's generic single-value macros; box_deref needs a `, int`
       type argument, appended at the Call emit site. */
    if bid == 12 { return "sv0__box_new_raw"; }
    if bid == 13 { return "sv0__box_deref_raw"; }
    if bid == 14 { return "sv0_no_alias"; }
    if bid == 15 { return "sv0_read_file"; }
    if bid == 16 { return "sv0_write_file"; }
    if bid == 17 { return "sv0_read_dir"; }
    if bid == 18 { return "sv0_write_bytes"; }
    return "sv0_unknown_builtin";
}

/* C return type of a builtin call's result (dst) by builtin id. String-returning
   builtins (string_concat=4, string_substr=6, read_file=15, read_dir=17) yield
   const char*; everything else that returns a value (string_len, string_eq,
   char_at, vec_*, box_*) is int. Used to type the call-result temp. */
fn megatu_builtin_ret_cty(bid: i32) -> string {
    if bid == 4 { return "const char*"; }
    if bid == 6 { return "const char*"; }
    if bid == 15 { return "const char*"; }
    if bid == 17 { return "const char*"; }
    return "int";
}

fn megatu_ty_name(h: i32, source: string, starts: Vec<i32>, ends: Vec<i32>) -> string {
    /* String-primitive sentinel from lowering (lower_string_cty): a string-typed
       `let` gets this as its DeclNamed ctype. Must be handled before handle_to_str,
       which would read a negative token index out of bounds. */
    if h == lower_string_cty() {
        return "const char*";
    }
    /* A type ctype `h` (DeclNamed type, Call rt, box_deref elem type) is a REAL
       source token — resolve it directly by its source text. Do NOT consult
       `name_of` (a codegen *value-name* test stub that maps handles 1..15 and
       500..599 to fabricated identifiers): a genuine type token landing in those
       ranges — e.g. an enum return type at token index 15 — would be corrupted to
       the stub's name ("i" for 15), emitting `i x;` instead of `EnumName x;`.
       Lowering only ever passes a real token here (or the string sentinel above),
       never an int(9)/void(10) sentinel (rt==0 → "int" is handled by the caller),
       so handle_to_str is always correct. */
    return handle_to_str(h, source, starts, ends);
}

/* AST binop tag (ast.sml: Add=0 … Shr=17) -> C operator (astBinopToC). */
fn megatu_binop_c(t: i32) -> string {
    if t == 0 { return "+"; }
    if t == 1 { return "-"; }
    if t == 2 { return "*"; }
    if t == 3 { return "/"; }
    if t == 4 { return "%"; }
    if t == 5 { return "=="; }
    if t == 6 { return "!="; }
    if t == 7 { return "<"; }
    if t == 8 { return ">"; }
    if t == 9 { return "<="; }
    if t == 10 { return ">="; }
    if t == 11 { return "&&"; }
    if t == 12 { return "||"; }
    if t == 13 { return "&"; }
    if t == 14 { return "|"; }
    if t == 15 { return "^"; }
    if t == 16 { return "<<"; }
    if t == 17 { return ">>"; }
    return "?";
}

/* AST unop tag (ast.sml: Neg=0, Not=1, BitNot=2, Deref=3, Borrow=4, BorrowMut=5)
   -> C operator (unopToC). 99 is the synthetic cast tag lowering emits for
   ExprCast; for the i32-only surface it is an identity, so emit no operator. */
fn megatu_unop_c(t: i32) -> string {
    if t == 0 { return "-"; }
    if t == 1 { return "!"; }
    if t == 2 { return "~"; }
    if t == 3 { return "*"; }
    if t == 4 { return "&"; }
    if t == 5 { return "&"; }
    if t == 99 { return ""; }
    return "?";
}

fn megatu_emit_value(v: codegen_Value, source: string, starts: Vec<i32>, ends: Vec<i32>, sidx: Vec<i32>) -> string {
    match v {
        codegen_Value::VInt(i) => { return int_to_string(i); },
        codegen_Value::VBoolTrue => { return "1"; },
        codegen_Value::VBoolFalse => { return "0"; },
        codegen_Value::VVar(h) => { return megatu_val_name(h, source, starts, ends, sidx); },
        codegen_Value::VUnit => { return "0"; },
        codegen_Value::VString(h) => {
            /* A string literal's handle is a source token whose text still includes
               the surrounding double quotes (e.g. `"golden"` or `"a\nb"`). Strip the
               quotes and emit the inner body VERBATIM: sv0 string-escape syntax
               (\n \t \\ \" …) already matches C, so the source body is a valid C
               string body. Do NOT re-escape it — c_escape_string would double the
               backslash of `\n`, turning the newline into a literal backslash-n
               (broke lexer's skip_line_comment). name_of's stub returned bare names,
               so codegen never hit this. */
            let raw: string = megatu_val_name(h, source, starts, ends, sidx);
            let mut inner: string = raw;
            let rlen: i32 = string_len(raw);
            if rlen >= 2 {
                inner = string_substr(raw, 1, rlen - 2);
            }
            let a: string = string_concat("\"", inner);
            return string_concat(a, "\"");
        },
        codegen_Value::VMember(bv, fh) => {
            let inner: codegen_Value = box_deref(bv);
            let field: string = megatu_field_name(fh, source, starts, ends);
            let tag: i32 = codegen_value_tag(inner);
            if tag == 3 {
                let prefix: string = megatu_emit_value(inner, source, starts, ends, sidx);
                return string_concat(string_concat(prefix, "."), field);
            }
            let prefix: string = string_concat("(", megatu_emit_value(inner, source, starts, ends, sidx));
            return string_concat(string_concat(prefix, ")."), field);
        },
        codegen_Value::VAddrOf(h) => {
            return string_concat(string_concat("(&", megatu_val_name(h, source, starts, ends, sidx)), ")");
        },
    }
    return "";
}

fn megatu_emit_expr(e: codegen_Expr, source: string, starts: Vec<i32>, ends: Vec<i32>, sidx: Vec<i32>) -> string {
    match e {
        codegen_Expr::Literal(bv) => {
            let v: codegen_Value = box_deref(bv);
            return megatu_emit_value(v, source, starts, ends, sidx);
        },
        codegen_Expr::Load(h) => {
            return megatu_val_name(h, source, starts, ends, sidx);
        },
        codegen_Expr::Binop(op_h, bv1, bv2) => {
            let v1: codegen_Value = box_deref(bv1);
            let v2: codegen_Value = box_deref(bv2);
            let s1: string = megatu_emit_value(v1, source, starts, ends, sidx);
            let s2: string = megatu_emit_value(v2, source, starts, ends, sidx);
            let op: string = megatu_binop_c(op_h);
            let a: string = string_concat("(", s1);
            let b: string = string_concat(a, " ");
            let c: string = string_concat(b, op);
            let d: string = string_concat(c, " ");
            let f: string = string_concat(d, s2);
            return string_concat(f, ")");
        },
        codegen_Expr::Unop(op_h, bv) => {
            let v: codegen_Value = box_deref(bv);
            let op: string = megatu_unop_c(op_h);
            let inner: string = megatu_emit_value(v, source, starts, ends, sidx);
            let a: string = string_concat("(", op);
            return string_concat(a, string_concat(inner, ")"));
        },
        codegen_Expr::FieldAccess(bv, fh) => {
            let v: codegen_Value = box_deref(bv);
            let a: string = string_concat("(", megatu_emit_value(v, source, starts, ends, sidx));
            return string_concat(string_concat(a, ")."), megatu_field_name(fh, source, starts, ends));
        },
    }
    return "";
}

fn megatu_emit_call_args(args: Vec<i32>, source: string, starts: Vec<i32>, ends: Vec<i32>, sidx: Vec<i32>) -> string {
    let count: i32 = vec_len(args);
    if count == 0 { return ""; }
    let mut out: string = "";
    let mut idx: i32 = 0;
    while idx < count {
        if idx > 0 {
            out = string_concat(out, ", ");
        }
        let bv: Box<codegen_Value> = vec_get(args, idx);
        let v: codegen_Value = box_deref(bv);
        out = string_concat(out, megatu_emit_value(v, source, starts, ends, sidx));
        idx = idx + 1;
    }
    return out;
}

fn megatu_emit_instr(indent: string, ret_ty: string, ins: codegen_Instr,
                     source: string, starts: Vec<i32>, ends: Vec<i32>,
                     sidx: Vec<i32>) -> string {
    match ins {
        codegen_Instr::Nop => { return ""; },
        codegen_Instr::DeclVar(h) => {
            let a: string = string_concat(indent, "int ");
            let b: string = string_concat(a, megatu_val_name(h, source, starts, ends, sidx));
            return string_concat(b, ";\n");
        },
        codegen_Instr::DeclNamed(ct, h) => {
            let a: string = string_concat(indent, megatu_ty_name(ct, source, starts, ends));
            let b: string = string_concat(a, " ");
            let c: string = string_concat(b, megatu_val_name(h, source, starts, ends, sidx));
            return string_concat(c, ";\n");
        },
        codegen_Instr::Assign(h, be) => {
            let e: codegen_Expr = box_deref(be);
            let a: string = string_concat(indent, "int ");
            let b: string = string_concat(a, megatu_val_name(h, source, starts, ends, sidx));
            let c: string = string_concat(b, " = ");
            let d: string = string_concat(c, megatu_emit_expr(e, source, starts, ends, sidx));
            return string_concat(d, ";\n");
        },
        codegen_Instr::Store(h, be) => {
            let e: codegen_Expr = box_deref(be);
            let a: string = string_concat(indent, megatu_val_name(h, source, starts, ends, sidx));
            let b: string = string_concat(a, " = ");
            let c: string = string_concat(b, megatu_emit_expr(e, source, starts, ends, sidx));
            return string_concat(c, ";\n");
        },
        codegen_Instr::StoreField(bh, fh, be) => {
            let e: codegen_Expr = box_deref(be);
            let a: string = string_concat(indent, megatu_val_name(bh, source, starts, ends, sidx));
            let b: string = string_concat(a, ".");
            let c: string = string_concat(b, megatu_field_name(fh, source, starts, ends));
            let d: string = string_concat(c, " = ");
            let f: string = string_concat(d, megatu_emit_expr(e, source, starts, ends, sidx));
            return string_concat(f, ";\n");
        },
        codegen_Instr::IfElse(be, th, el) => {
            let e: codegen_Expr = box_deref(be);
            let deeper: string = string_concat(indent, "  ");
            let a: string = string_concat(indent, "if (");
            let b: string = string_concat(a, megatu_emit_expr(e, source, starts, ends, sidx));
            let c: string = string_concat(b, ") {\n");
            let d: string = string_concat(c, megatu_emit_instrs(th, deeper, ret_ty, source, starts, ends, sidx));
            let f: string = string_concat(d, indent);
            let g: string = string_concat(f, "} else {\n");
            let h: string = string_concat(g, megatu_emit_instrs(el, deeper, ret_ty, source, starts, ends, sidx));
            let j: string = string_concat(h, indent);
            return string_concat(j, "}\n");
        },
        codegen_Instr::WhileLoop(be, body) => {
            let e: codegen_Expr = box_deref(be);
            let deeper: string = string_concat(indent, "  ");
            let a: string = string_concat(indent, "while (");
            let b: string = string_concat(a, megatu_emit_expr(e, source, starts, ends, sidx));
            let c: string = string_concat(b, ") {\n");
            let d: string = string_concat(c, megatu_emit_instrs(body, deeper, ret_ty, source, starts, ends, sidx));
            let f: string = string_concat(d, indent);
            return string_concat(f, "}\n");
        },
        codegen_Instr::BlockInstr(body) => {
            let deeper: string = string_concat(indent, "  ");
            let a: string = string_concat(indent, "{\n");
            let b: string = string_concat(a, megatu_emit_instrs(body, deeper, ret_ty, source, starts, ends, sidx));
            let c: string = string_concat(b, indent);
            return string_concat(c, "}\n");
        },
        codegen_Instr::Break => {
            return string_concat(indent, "break;\n");
        },
        codegen_Instr::Continue => {
            return string_concat(indent, "continue;\n");
        },
        codegen_Instr::Call(dst_h, fn_h, args, rt_h) => {
            let mut arg_str: string = megatu_emit_call_args(args, source, starts, ends, sidx);
            /* box_deref lowers to a Call to builtin 13; sv0__box_deref_raw(h, T)
               takes the target C type as a second argument. Default `int` (values
               are int handles), but a typed box_deref (rt_h set — a `let x: T =
               box_deref(..)` on a user struct/enum) reconstructs the element type T
               so the whole struct is recovered, not just its first word. */
            if fn_h < 0 {
                if (0 - fn_h) == 13 {
                    if rt_h != 0 {
                        arg_str = string_concat(arg_str, ", ");
                        arg_str = string_concat(arg_str,
                            megatu_ty_name(rt_h, source, starts, ends));
                    } else {
                        arg_str = string_concat(arg_str, ", int");
                    }
                }
            }
            /* A builtin call is lowered as Call with a NEGATIVE fn handle: the
               sentinel is `0 - builtin_id` (lowering build_builtin_map). Map it to
               the runtime C name `sv0_<builtin>`; a source fn resolves normally. */
            let mut fn_name: string = megatu_builtin_name(0 - fn_h);
            if fn_h >= 0 {
                fn_name = megatu_val_name(fn_h, source, starts, ends, sidx);
            }
            if dst_h == 0 {
                let a: string = string_concat(indent, fn_name);
                let b: string = string_concat(a, "(");
                let c: string = string_concat(b, arg_str);
                return string_concat(c, ");\n");
            }
            /* lower emits Instr::Call with rt_h == 0 as the default-int-return
               placeholder (the i32 surface); resolve that to "int" rather than
               token 0's text (which would be the `fn` keyword). A builtin call
               (negative fn_h) uses the builtin's real return C type so a
               string-returning builtin's result temp is typed const char*. */
            let mut ret_name: string = "int";
            if fn_h < 0 {
                ret_name = megatu_builtin_ret_cty(0 - fn_h);
                /* Typed box_deref: the result temp carries the element type T. */
                if (0 - fn_h) == 13 {
                    if rt_h != 0 {
                        ret_name = megatu_ty_name(rt_h, source, starts, ends);
                    }
                }
            } else {
                if rt_h != 0 {
                    ret_name = megatu_ty_name(rt_h, source, starts, ends);
                }
            }
            let a: string = string_concat(indent, ret_name);
            let b: string = string_concat(a, " ");
            let c: string = string_concat(b, megatu_val_name(dst_h, source, starts, ends, sidx));
            let d: string = string_concat(c, " = ");
            let e: string = string_concat(d, fn_name);
            let f: string = string_concat(e, "(");
            let g: string = string_concat(f, arg_str);
            return string_concat(g, ");\n");
        },
        codegen_Instr::Requires(be, fh) => {
            let e: codegen_Expr = box_deref(be);
            let a: string = string_concat(indent, "sv0_requires(");
            let b: string = string_concat(a, megatu_emit_expr(e, source, starts, ends, sidx));
            let c: string = string_concat(b, ", \"");
            let d: string = string_concat(c, megatu_val_name(fh, source, starts, ends, sidx));
            return string_concat(d, "\");\n");
        },
        codegen_Instr::Ensures(be, fh) => {
            let e: codegen_Expr = box_deref(be);
            let a: string = string_concat(indent, "sv0_ensures(");
            let b: string = string_concat(a, megatu_emit_expr(e, source, starts, ends, sidx));
            let c: string = string_concat(b, ", \"");
            let d: string = string_concat(c, megatu_val_name(fh, source, starts, ends, sidx));
            return string_concat(d, "\");\n");
        },
        codegen_Instr::ReturnVoid => {
            return string_concat(indent, "return;\n");
        },
        codegen_Instr::ReturnVal(bv) => {
            if string_eq(ret_ty, "void") {
                return string_concat(indent, "return;\n");
            }
            let v: codegen_Value = box_deref(bv);
            let a: string = string_concat(indent, "return ");
            let b: string = string_concat(a, megatu_emit_value(v, source, starts, ends, sidx));
            return string_concat(b, ";\n");
        },
    }
    return "";
}

fn megatu_emit_instrs(instrs: Vec<i32>, indent: string, ret_ty: string,
                      source: string, starts: Vec<i32>, ends: Vec<i32>,
                      sidx: Vec<i32>) -> string {
    let count: i32 = vec_len(instrs);
    if count == 0 { return ""; }
    let mut out: string = "";
    let mut idx: i32 = 0;
    while idx < count {
        let bh: Box<codegen_Instr> = vec_get(instrs, idx);
        let ins: codegen_Instr = box_deref(bh);
        out = string_concat(out, megatu_emit_instr(indent, ret_ty, ins, source, starts, ends, sidx));
        idx = idx + 1;
    }
    return out;
}
