                             et, ed1v, ed2v, ed3v, ed4v, pp, 1);
    if p != 12 { return 1; }
    let n: i32 = vec_len(et);
    let mut found33: i32 = 0;
    let mut found30enum: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        if vec_get(et, i) == 33 { found33 = 1; }
        if vec_get(et, i) == 30 {
            if vec_get(ed4v, i) == 5 {
                if vec_get(ed3v, i) == 1 { found30enum = 1; }
            }
        }
        i = i + 1;
    }
    if found33 != 1 { return 2; }
    if found30enum != 1 { return 3; }
    return 0;
}

