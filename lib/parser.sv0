fn parse_bit_or_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                     source: string, pos: i32,
                     et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                     ed3: Vec<i32>, ed4: Vec<i32>,
