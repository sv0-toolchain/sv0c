fn test_ps_nav() -> i32 {
    let tags: Vec<i32> = vec_new();
    vec_push(tags, 5);
    vec_push(tags, 22);
    vec_push(tags, 5);
    vec_push(tags, 97);
    if ps_peek(tags, 0) != 5 { return 1; }
    if ps_peek(tags, 1) != 22 { return 2; }
    if ps_peek(tags, 3) != 97 { return 3; }
    if ps_peek(tags, 10) != 97 { return 4; }
    if ps_at_end(tags, 3) != true { return 5; }
    if ps_at_end(tags, 0) != false { return 6; }
    if ps_advance(0) != 1 { return 7; }
    if ps_expect(tags, 0, 5) != 1 { return 8; }
    if ps_expect(tags, 0, 22) != 0 - 1 { return 9; }
    if ps_match(tags, 0, 5) != 1 { return 10; }
    if ps_match(tags, 0, 22) != 0 { return 11; }
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0);
    vec_push(starts, 3);
    vec_push(ends, 3);
    vec_push(ends, 4);
    if ps_start(starts, 0) != 0 { return 12; }
    if ps_end(ends, 0) != 3 { return 13; }
    let src: string = "foo+bar";
    let txt: string = ps_tok_text(src, starts, ends, 0);
    if string_len(txt) != 3 { return 14; }
    return 0;
}

