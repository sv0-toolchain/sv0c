/* ── token stream navigation ───────────────────────────────────
   Works on the parallel Vec<i32> triplet (tags, starts, ends)
   produced by lexer tokenize. pos is the current index.
   Convention: functions return the new pos; error → return -1. */

fn ps_peek(tags: Vec<i32>, pos: i32) -> i32 {
    if pos >= vec_len(tags) { return 97; }
    return vec_get(tags, pos);
}

fn ps_at_end(tags: Vec<i32>, pos: i32) -> bool {
    return ps_peek(tags, pos) == 97;
}

fn ps_start(starts: Vec<i32>, pos: i32) -> i32 {
    return vec_get(starts, pos);
}

fn ps_end(ends: Vec<i32>, pos: i32) -> i32 {
    return vec_get(ends, pos);
}

fn ps_advance(pos: i32) -> i32 {
    return pos + 1;
}

fn ps_expect(tags: Vec<i32>, pos: i32, expected: i32) -> i32 {
    if ps_peek(tags, pos) != expected { return 0 - 1; }
    return pos + 1;
}

fn ps_match(tags: Vec<i32>, pos: i32, expected: i32) -> i32 {
    if ps_peek(tags, pos) == expected { return pos + 1; }
    return pos;
}

fn ps_tok_text(source: string, starts: Vec<i32>, ends: Vec<i32>, pos: i32) -> string {
    let s: i32 = vec_get(starts, pos);
    let e: i32 = vec_get(ends, pos);
    return string_substr(source, s, e - s);
}

/* ── parsePath ─────────────────────────────────────────────────
   Parses a path like `foo`, `Foo::Bar`, `Foo::Bar::Baz`.
   Stores token indices of path segments in path_out.
   Returns new pos, or -1 on error. */

fn parse_path(tags: Vec<i32>, pos: i32, path_out: Vec<i32>) -> i32 {
    let tag: i32 = ps_peek(tags, pos);
    if tag != 5 { return 0 - 1; }
    vec_push(path_out, pos);
    let mut p: i32 = pos + 1;
    let mut done: bool = false;
    while done != true {
        if ps_peek(tags, p) == 15 {
            let next: i32 = ps_peek(tags, p + 1);
            if next == 5 {
                vec_push(path_out, p + 1);
                p = p + 2;
            } else { done = true; }
        } else { done = true; }
    }
    return p;
}

/* ── parseGenericParams ────────────────────────────────────────
   Parses `<T, U, V>` where each param is an IDENT, optionally
   followed by `: Bound` (skipped until `,` or `>`).
   Stores token indices of param names in names_out.
   Returns new pos after `>`, or same pos if no `<`. */

fn parse_generic_params(tags: Vec<i32>, pos: i32,
                        names_out: Vec<i32>) -> i32 {
    if ps_peek(tags, pos) != 38 { return pos; }
    let mut p: i32 = pos + 1;
    let mut done: bool = false;
    while done != true {
        let t: i32 = ps_peek(tags, p);
        if t == 39 {
            p = p + 1;
            done = true;
        } else {
            if t == 97 {
                done = true;
            } else {
                if t == 5 {
                    vec_push(names_out, p);
                    p = p + 1;
                    let after: i32 = ps_peek(tags, p);
                    if after == 14 {
                        p = p + 1;
                        let mut skipping: bool = true;
                        while skipping {
                            let st: i32 = ps_peek(tags, p);
                            if st == 12 { skipping = false; }
                            else {
                                if st == 39 { skipping = false; }
                                else {
                                    if st == 97 { skipping = false; }
                                    else { p = p + 1; }
                                }
                            }
                        }
                    }
                    if ps_peek(tags, p) == 12 { p = p + 1; }
                } else { p = p + 1; }
            }
        }
    }
    return p;
}

/* ── skip helpers on token stream ──────────────────────────────
   These operate on (tags, pos) and return new pos. */

fn ps_skip_optional_pub(tags: Vec<i32>, pos: i32) -> i32 {
    if ps_peek(tags, pos) != 82 { return pos; }
    if ps_peek(tags, pos + 1) == 6 {
        if ps_peek(tags, pos + 2) == 81 {
            if ps_peek(tags, pos + 3) == 7 {
                return pos + 4;
            }
        }
    }
    return pos + 1;
}

fn ps_skip_optional_unsafe(tags: Vec<i32>, pos: i32) -> i32 {
    if ps_peek(tags, pos) == 93 { return pos + 1; }
    return pos;
}

fn ps_skip_generic_params(tags: Vec<i32>, pos: i32) -> i32 {
    if ps_peek(tags, pos) != 38 { return pos; }
    let mut p: i32 = pos + 1;
    let mut depth: i32 = 1;
    while depth > 0 {
        let t: i32 = ps_peek(tags, p);
        if t == 97 { return p; }
        if t == 38 { depth = depth + 1; }
        if t == 39 { depth = depth - 1; }
        p = p + 1;
    }
    return p;
}

fn ps_skip_where_clause(tags: Vec<i32>, pos: i32) -> i32 {
    if ps_peek(tags, pos) != 95 { return pos; }
    let mut p: i32 = pos + 1;
    let mut done: bool = false;
    while done != true {
        let t: i32 = ps_peek(tags, p);
        if t == 97 { return p; }
        if t == 8 { return p; }
        if t == 65 { return p; }
        if t == 13 { return p + 1; }
        p = p + 1;
    }
    return p;
}

fn ps_skip_attributes(tags: Vec<i32>, pos: i32) -> i32 {
    let mut p: i32 = pos;
    let mut scanning: bool = true;
    while scanning {
        if ps_peek(tags, p) == 21 {
            if ps_peek(tags, p + 1) == 10 {
                p = p + 2;
                let mut depth: i32 = 1;
                while depth > 0 {
                    let t: i32 = ps_peek(tags, p);
                    if t == 97 { return p; }
                    if t == 10 { depth = depth + 1; }
                    if t == 11 { depth = depth - 1; }
                    p = p + 1;
                }
            } else { scanning = false; }
        } else { scanning = false; }
    }
    return p;
}

/* ── parse_use_item (SML parseUseItem) ─────────────────────────
   Parses: USE path SEMICOLON
   Stores path segment indices in path_out.
   Returns new pos after SEMICOLON, or -1 on error.
   Assumes current token is USE (tag 94). */
fn parse_use_item(tags: Vec<i32>, pos: i32,
                  path_out: Vec<i32>) -> i32 {
    if ps_peek(tags, pos) != 94 { return 0 - 1; }
    let p1: i32 = pos + 1;
    let p2: i32 = parse_path(tags, p1, path_out);
    if p2 < 0 { return 0 - 1; }
    let p3: i32 = ps_expect(tags, p2, 13);
    return p3;
}

/* ── parse_module_decl (SML parseModuleDecl) ──────────────────
   Parses: MODULE path SEMICOLON
   Stores path segment indices in path_out.
   Returns new pos after SEMICOLON, or -1 on error.
   Returns same pos if current token is not MODULE (tag 83). */
fn parse_module_decl(tags: Vec<i32>, pos: i32,
                     path_out: Vec<i32>) -> i32 {
    if ps_peek(tags, pos) != 75 { return pos; }
    let p1: i32 = pos + 1;
    let p2: i32 = parse_path(tags, p1, path_out);
    if p2 < 0 { return 0 - 1; }
    let p3: i32 = ps_expect(tags, p2, 13);
    return p3;
}

/* ── AST binop tags (matching ast.sv0) ──────────────────────── */

fn AST_ADD() -> i32 { return 0; }
fn AST_SUB() -> i32 { return 1; }
fn AST_MUL() -> i32 { return 2; }
fn AST_DIV() -> i32 { return 3; }
fn AST_REM() -> i32 { return 4; }
fn AST_EQ() -> i32 { return 5; }
fn AST_NEQ() -> i32 { return 6; }
fn AST_LT() -> i32 { return 7; }
fn AST_GT() -> i32 { return 8; }
fn AST_LEQ() -> i32 { return 9; }
fn AST_GEQ() -> i32 { return 10; }
fn AST_AND() -> i32 { return 11; }
fn AST_OR() -> i32 { return 12; }
fn AST_BITAND() -> i32 { return 13; }
fn AST_BITOR() -> i32 { return 14; }
fn AST_BITXOR() -> i32 { return 15; }
fn AST_SHL() -> i32 { return 16; }
fn AST_SHR() -> i32 { return 17; }

/* ── token → binop mapping ──────────────────────────────────── */

fn binop_of(tok_tag: i32) -> i32 {
    if tok_tag == 22 { return 0; }
    if tok_tag == 23 { return 1; }
    if tok_tag == 24 { return 2; }
    if tok_tag == 25 { return 3; }
    if tok_tag == 26 { return 4; }
    if tok_tag == 27 { return 13; }
    if tok_tag == 29 { return 14; }
    if tok_tag == 31 { return 15; }
    if tok_tag == 42 { return 16; }
    if tok_tag == 43 { return 17; }
    if tok_tag == 28 { return 11; }
    if tok_tag == 30 { return 12; }
    if tok_tag == 36 { return 5; }
    if tok_tag == 37 { return 6; }
    if tok_tag == 38 { return 7; }
    if tok_tag == 39 { return 8; }
    if tok_tag == 40 { return 9; }
    if tok_tag == 41 { return 10; }
    return 0 - 1;
}

fn has_binop(tok_tag: i32) -> bool {
    return binop_of(tok_tag) >= 0;
}

/* ── token → assign binop mapping ───────────────────────────── */

fn assign_binop(tok_tag: i32) -> i32 {
    if tok_tag == 44 { return 0; }
    if tok_tag == 45 { return 1; }
    if tok_tag == 46 { return 2; }
    if tok_tag == 47 { return 3; }
    if tok_tag == 48 { return 4; }
    if tok_tag == 49 { return 13; }
    if tok_tag == 50 { return 14; }
    if tok_tag == 51 { return 15; }
    if tok_tag == 52 { return 16; }
    if tok_tag == 53 { return 17; }
    return 0 - 1;
}

fn has_assign_binop(tok_tag: i32) -> bool {
    return assign_binop(tok_tag) >= 0;
}

fn is_compound_assign(tok_tag: i32) -> bool {
    if tok_tag >= 44 {
        if tok_tag <= 53 { return true; }
    }
    return false;
}

/* SML isAssignTok: token is = (EQ) or any compound assignment op */
fn is_assign_tok(tok_tag: i32) -> bool {
    if tok_tag == 35 { return true; }
    return has_assign_binop(tok_tag);
}

/* SML pathOfTy: TyName (tag 0 in ast.sv0) has an extractable path.
   Returns true if the type tag is TyName. */
fn path_of_ty_valid(ty_tag: i32) -> bool {
    return ty_tag == 0;
}

/* ── literal classification from token ──────────────────────── */

fn LIT_TAG_INT() -> i32 { return 0; }
fn LIT_TAG_FLOAT() -> i32 { return 1; }
fn LIT_TAG_STRING() -> i32 { return 3; }
fn LIT_TAG_CHAR() -> i32 { return 4; }
fn LIT_TAG_BOOL() -> i32 { return 5; }
fn LIT_TAG_NONE() -> i32 { return 0 - 1; }

fn lit_from_tok(tok_tag: i32) -> i32 {
    if tok_tag == 0 { return 0; }
    if tok_tag == 1 { return 1; }
    if tok_tag == 2 { return 3; }
    if tok_tag == 3 { return 4; }
    if tok_tag == 91 { return 5; }
    if tok_tag == 64 { return 5; }
    return 0 - 1;
}

fn is_literal_tok(tok_tag: i32) -> bool {
    return lit_from_tok(tok_tag) >= 0;
}

/* ── expr span extraction ───────────────────────────────────── */

fn expr_has_span(expr_tag: i32) -> bool {
    if expr_tag >= 0 {
        if expr_tag <= 27 { return true; }
    }
    return false;
}

/* ── skip helpers ───────────────────────────────────────────── */

fn is_pub_token(tok_tag: i32) -> bool {
    return tok_tag == 82;
}

fn is_unsafe_token(tok_tag: i32) -> bool {
    return tok_tag == 93;
}

fn is_where_token(tok_tag: i32) -> bool {
    return tok_tag == 95;
}

fn is_hash_token(tok_tag: i32) -> bool {
    return tok_tag == 21;
}

fn is_lt_token(tok_tag: i32) -> bool {
    return tok_tag == 38;
}

fn is_gt_token(tok_tag: i32) -> bool {
    return tok_tag == 39;
}

/* skipGenericParams: track angle-bracket depth */
fn generic_params_update_depth(tok_tag: i32, depth: i32) -> i32 {
    if tok_tag == 38 { return depth + 1; }
    if tok_tag == 39 { return depth - 1; }
    return depth;
}

fn generic_params_done(depth: i32) -> bool {
    return depth <= 0;
}

/* skipWhereClause stop tokens */
fn where_clause_stop(tok_tag: i32) -> bool {
    if tok_tag == 8 { return true; }
    if tok_tag == 65 { return true; }
    if tok_tag == 13 { return true; }
    if tok_tag == 97 { return true; }
    return false;
}

/* skipAttributes: track bracket depth */
fn attr_bracket_update(tok_tag: i32, depth: i32) -> i32 {
    if tok_tag == 10 { return depth + 1; }
    if tok_tag == 11 { return depth - 1; }
    return depth;
}

/* ── pathOfTy ───────────────────────────────────────────────── */

fn ty_is_name(ty_tag: i32) -> bool {
    return ty_tag == 0;
}

/* ── span merge (min start, max end) ────────────────────────── */

fn span_min(a: i32, b: i32) -> i32 {
    if a <= b { return a; }
    return b;
}

fn span_max(a: i32, b: i32) -> i32 {
    if a >= b { return a; }
    return b;
}

fn span_merge_start(s1: i32, s2: i32) -> i32 {
    return span_min(s1, s2);
}

fn span_merge_end(e1: i32, e2: i32) -> i32 {
    return span_max(e1, e2);
}

/* ── precedence helpers ─────────────────────────────────────── */

fn is_cmp_token(tok_tag: i32) -> bool {
    if tok_tag == 36 { return true; }
    if tok_tag == 37 { return true; }
    if tok_tag == 38 { return true; }
    if tok_tag == 39 { return true; }
    if tok_tag == 40 { return true; }
    if tok_tag == 41 { return true; }
    return false;
}

fn is_additive_token(tok_tag: i32) -> bool {
    if tok_tag == 22 { return true; }
    if tok_tag == 23 { return true; }
    return false;
}

fn is_multiplicative_token(tok_tag: i32) -> bool {
    if tok_tag == 24 { return true; }
    if tok_tag == 25 { return true; }
    if tok_tag == 26 { return true; }
    return false;
}

fn is_shift_token(tok_tag: i32) -> bool {
    if tok_tag == 42 { return true; }
    if tok_tag == 43 { return true; }
    return false;
}

fn is_unary_prefix(tok_tag: i32) -> bool {
    if tok_tag == 23 { return true; }
    if tok_tag == 33 { return true; }
    if tok_tag == 27 { return true; }
    if tok_tag == 24 { return true; }
    return false;
}

/* ── Pratt precedence (binop tag → level) ──────────────────── */

fn prec_of_binop(binop_tag: i32) -> i32 {
    if binop_tag == 12 { return 1; }
    if binop_tag == 11 { return 2; }
    if binop_tag == 5 { return 3; }
    if binop_tag == 6 { return 3; }
    if binop_tag == 7 { return 3; }
    if binop_tag == 8 { return 3; }
    if binop_tag == 9 { return 3; }
    if binop_tag == 10 { return 3; }
    if binop_tag == 14 { return 4; }
    if binop_tag == 15 { return 5; }
    if binop_tag == 13 { return 6; }
    if binop_tag == 16 { return 7; }
    if binop_tag == 17 { return 7; }
    if binop_tag == 0 { return 8; }
    if binop_tag == 1 { return 8; }
    if binop_tag == 2 { return 9; }
    if binop_tag == 3 { return 9; }
    if binop_tag == 4 { return 9; }
    return 0;
}

fn is_right_assoc(binop_tag: i32) -> bool {
    return false;
}

fn next_prec(current: i32, right_assoc: bool) -> i32 {
    if right_assoc { return current; }
    return current + 1;
}

fn binop_is_comparison(binop_tag: i32) -> bool {
    return prec_of_binop(binop_tag) == 3;
}

fn binop_is_arithmetic(binop_tag: i32) -> bool {
    let p: i32 = prec_of_binop(binop_tag);
    if p == 8 { return true; }
    if p == 9 { return true; }
    return false;
}

fn binop_is_logical(binop_tag: i32) -> bool {
    let p: i32 = prec_of_binop(binop_tag);
    if p == 1 { return true; }
    if p == 2 { return true; }
    return false;
}

/* ── is_builtin_type_name (SML inline check in parseType) ──── */

fn is_builtin_type_name(source: string, starts: Vec<i32>,
                        ends: Vec<i32>, pos: i32) -> bool {
    let txt: string = ps_tok_text(source, starts, ends, pos);
    if string_eq(txt, "i8") { return true; }
    if string_eq(txt, "i16") { return true; }
    if string_eq(txt, "i32") { return true; }
    if string_eq(txt, "i64") { return true; }
    if string_eq(txt, "i128") { return true; }
    if string_eq(txt, "u8") { return true; }
    if string_eq(txt, "u16") { return true; }
    if string_eq(txt, "u32") { return true; }
    if string_eq(txt, "u64") { return true; }
    if string_eq(txt, "u128") { return true; }
    if string_eq(txt, "usize") { return true; }
    if string_eq(txt, "isize") { return true; }
    if string_eq(txt, "f32") { return true; }
    if string_eq(txt, "f64") { return true; }
    if string_eq(txt, "bool") { return true; }
    if string_eq(txt, "char") { return true; }
    if string_eq(txt, "byte") { return true; }
    if string_eq(txt, "string") { return true; }
    return false;
}

/* ── parse_type (SML parseType, lines 128-225) ─────────────────
   Recursive-descent type parser. Builds type nodes in a flat arena
   (parallel Vec<i32>s). Children are appended before parents.

   Arena encoding per node:
     tag 0 (TyName)   : data1=path_pool_start, data2=seg_count, data3=type_arg_count
     tag 1 (TyRef)    : data1=inner_ty_arena_idx
     tag 2 (TyRefMut) : data1=inner_ty_arena_idx
     tag 3 (TyArray)  : data1=elem_ty_arena_idx, data2=len_tok_pos
     tag 4 (TySlice)  : data1=elem_ty_arena_idx
     tag 5 (TyTuple)  : data1=first_elem_ty_arena_idx, data2=elem_count
     tag 6 (TyUnit)   : (no payload)

   Returns new pos, or -1 on error.
   The last-appended entry in ty_tags is the parsed type node. */

fn parse_type(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
              source: string, pos: i32,
              ty_tags: Vec<i32>, ty_data1: Vec<i32>,
              ty_data2: Vec<i32>, ty_data3: Vec<i32>,
              path_pool: Vec<i32>) -> i32 {
    let t: i32 = ps_peek(tags, pos);
    if t == 6 {
        let p1: i32 = pos + 1;
        if ps_peek(tags, p1) == 7 {
            vec_push(ty_tags, 6);
            vec_push(ty_data1, 0);
            vec_push(ty_data2, 0);
            vec_push(ty_data3, 0);
            return p1 + 1;
        }
        let p2: i32 = parse_type(tags, starts, ends, source, p1,
                                  ty_tags, ty_data1, ty_data2, ty_data3,
                                  path_pool);
        if p2 < 0 { return 0 - 1; }
        let first_idx: i32 = vec_len(ty_tags) - 1;
        let mut p: i32 = p2;
        let mut count: i32 = 1;
        let mut saw_comma: bool = false;
        let mut done: bool = false;
        while done != true {
            let tc: i32 = ps_peek(tags, p);
            if tc == 12 {
                saw_comma = true;
                p = p + 1;
                if ps_peek(tags, p) == 7 {
                    vec_push(ty_tags, 5);
                    vec_push(ty_data1, first_idx);
                    vec_push(ty_data2, count);
                    vec_push(ty_data3, 0);
                    return p + 1;
                }
                let pn: i32 = parse_type(tags, starts, ends, source, p,
                                          ty_tags, ty_data1, ty_data2,
                                          ty_data3, path_pool);
                if pn < 0 { return 0 - 1; }
                count = count + 1;
                p = pn;
            } else {
                if tc == 7 {
                    if saw_comma {
                        vec_push(ty_tags, 5);
                        vec_push(ty_data1, first_idx);
                        vec_push(ty_data2, count);
                        vec_push(ty_data3, 0);
                    }
                    return p + 1;
                }
                return 0 - 1;
            }
        }
        return 0 - 1;
    }
    if t == 27 {
        let p1: i32 = pos + 1;
        if ps_peek(tags, p1) == 77 {
            let p2: i32 = parse_type(tags, starts, ends, source, p1 + 1,
                                      ty_tags, ty_data1, ty_data2,
                                      ty_data3, path_pool);
            if p2 < 0 { return 0 - 1; }
            let inner: i32 = vec_len(ty_tags) - 1;
            vec_push(ty_tags, 2);
            vec_push(ty_data1, inner);
            vec_push(ty_data2, 0);
            vec_push(ty_data3, 0);
            return p2;
        }
        let p2: i32 = parse_type(tags, starts, ends, source, p1,
                                  ty_tags, ty_data1, ty_data2,
                                  ty_data3, path_pool);
        if p2 < 0 { return 0 - 1; }
        let inner: i32 = vec_len(ty_tags) - 1;
        vec_push(ty_tags, 1);
        vec_push(ty_data1, inner);
        vec_push(ty_data2, 0);
        vec_push(ty_data3, 0);
        return p2;
    }
    if t == 10 {
        let p1: i32 = pos + 1;
        let p2: i32 = parse_type(tags, starts, ends, source, p1,
                                  ty_tags, ty_data1, ty_data2,
                                  ty_data3, path_pool);
        if p2 < 0 { return 0 - 1; }
        let elem: i32 = vec_len(ty_tags) - 1;
        if ps_peek(tags, p2) == 13 {
            let p3: i32 = p2 + 1;
            if ps_peek(tags, p3) != 0 { return 0 - 1; }
            let len_pos: i32 = p3;
            let p4: i32 = p3 + 1;
            if ps_peek(tags, p4) != 11 { return 0 - 1; }
            vec_push(ty_tags, 3);
            vec_push(ty_data1, elem);
            vec_push(ty_data2, len_pos);
            vec_push(ty_data3, 0);
            return p4 + 1;
        }
        if ps_peek(tags, p2) == 11 {
            vec_push(ty_tags, 4);
            vec_push(ty_data1, elem);
            vec_push(ty_data2, 0);
            vec_push(ty_data3, 0);
            return p2 + 1;
        }
        return 0 - 1;
    }
    if t == 87 {
        let p1: i32 = pos + 1;
        if ps_peek(tags, p1) == 15 {
            if ps_peek(tags, p1 + 1) == 5 {
                let path_start: i32 = vec_len(path_pool);
                vec_push(path_pool, pos);
                vec_push(path_pool, p1 + 1);
                let mut p2: i32 = p1 + 2;
                if ps_peek(tags, p2) == 38 {
                    p2 = ps_skip_generic_params(tags, p2);
                }
                vec_push(ty_tags, 0);
                vec_push(ty_data1, path_start);
                vec_push(ty_data2, 2);
                vec_push(ty_data3, 0);
                return p2;
            }
        }
        let path_start: i32 = vec_len(path_pool);
        vec_push(path_pool, pos);
        vec_push(ty_tags, 0);
        vec_push(ty_data1, path_start);
        vec_push(ty_data2, 1);
        vec_push(ty_data3, 0);
        return p1;
    }
    if t == 5 {
        if is_builtin_type_name(source, starts, ends, pos) {
            let path_start: i32 = vec_len(path_pool);
            vec_push(path_pool, pos);
            vec_push(ty_tags, 0);
            vec_push(ty_data1, path_start);
            vec_push(ty_data2, 1);
            vec_push(ty_data3, 0);
            return pos + 1;
        }
        let path_start: i32 = vec_len(path_pool);
        let p1: i32 = parse_path(tags, pos, path_pool);
        if p1 < 0 { return 0 - 1; }
        let seg_count: i32 = vec_len(path_pool) - path_start;
        if ps_peek(tags, p1) == 38 {
            let mut p: i32 = p1 + 1;
            let mut arg_count: i32 = 0;
            if ps_peek(tags, p) == 39 {
                vec_push(ty_tags, 0);
                vec_push(ty_data1, path_start);
                vec_push(ty_data2, seg_count);
                vec_push(ty_data3, 0);
                return p + 1;
            }
            let mut done: bool = false;
            while done != true {
                if ps_peek(tags, p) == 39 {
                    done = true;
                } else {
                    let p2: i32 = parse_type(tags, starts, ends, source, p,
                                              ty_tags, ty_data1, ty_data2,
                                              ty_data3, path_pool);
                    if p2 < 0 { return 0 - 1; }
                    arg_count = arg_count + 1;
                    if ps_peek(tags, p2) == 12 {
                        p = p2 + 1;
                    } else {
                        if ps_peek(tags, p2) == 39 {
                            p = p2;
                        } else {
                            return 0 - 1;
                        }
                    }
                }
            }
            vec_push(ty_tags, 0);
            vec_push(ty_data1, path_start);
            vec_push(ty_data2, seg_count);
            vec_push(ty_data3, arg_count);
            return p + 1;
        }
        vec_push(ty_tags, 0);
        vec_push(ty_data1, path_start);
        vec_push(ty_data2, seg_count);
        vec_push(ty_data3, 0);
        return p1;
    }
    return 0 - 1;
}

/* ── pat arena tags ────────────────────────────────────────────
   0=PatWild  1=PatBind  2=PatLit  3=PatTuple
   4=PatStruct  5=PatEnum  6=PatOr

   Arena encoding (parallel Vec<i32>s, children before parents):
     0 PatWild   : (no payload)
     1 PatBind   : data1=name_tok_pos, data2=is_mut,
                   data3=struct field name tok when PatStruct row uses
                   `field: pat` (0 = shorthand: field name is data1)
     2 PatLit    : data1=lit_tag, data2=tok_pos, data3=is_neg
     3 PatTuple  : data1=first_elem_idx, data2=elem_count
     4 PatStruct : data1=pp_start, data2=pp_count, data3=field_count
     5 PatEnum   : data1=pp_start, data2=pp_count, data3=arg_count
     6 PatOr     : data1=first_alt_idx, data2=alt_count */

/* ── path_pattern_from (SML pathPatternFrom, lines 247-294) ───
   Called after a path is parsed. Dispatches on next token:
   { → struct pattern, ( → enum with args, else → bare enum. */

fn path_pattern_from(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                     source: string, pos: i32,
                     pat_tags: Vec<i32>, pat_data1: Vec<i32>,
                     pat_data2: Vec<i32>, pat_data3: Vec<i32>,
                     path_pool: Vec<i32>,
                     pp_start: i32, pp_count: i32) -> i32 {
    let t: i32 = ps_peek(tags, pos);
    if t == 8 {
        let mut p: i32 = pos + 1;
        let mut field_count: i32 = 0;
        let mut done: bool = false;
        while done != true {
            let ft: i32 = ps_peek(tags, p);
            if ft == 9 {
                vec_push(pat_tags, 4);
                vec_push(pat_data1, pp_start);
                vec_push(pat_data2, pp_count);
                vec_push(pat_data3, field_count);
                return p + 1;
            }
            if ft == 17 {
                if ps_peek(tags, p + 1) == 9 {
                    vec_push(pat_tags, 4);
                    vec_push(pat_data1, pp_start);
                    vec_push(pat_data2, pp_count);
                    vec_push(pat_data3, field_count);
                    return p + 2;
                }
            }
            if ft != 5 { return 0 - 1; }
            let fname_pos: i32 = p;
            p = p + 1;
            if ps_peek(tags, p) == 14 {
                p = p + 1;
                let pv: i32 = parse_pat(tags, starts, ends, source, p,
                                         pat_tags, pat_data1, pat_data2,
                                         pat_data3, path_pool);
                if pv < 0 { return 0 - 1; }
                let last_pat: i32 = vec_len(pat_tags) - 1;
                vec_set(pat_data3, last_pat, fname_pos);
                p = pv;
            } else {
                vec_push(pat_tags, 1);
                vec_push(pat_data1, fname_pos);
                vec_push(pat_data2, 0);
                vec_push(pat_data3, 0);
            }
            field_count = field_count + 1;
            if ps_peek(tags, p) == 12 {
                p = p + 1;
            }
        }
        return 0 - 1;
    }
    if t == 6 {
        let mut p: i32 = pos + 1;
        if ps_peek(tags, p) == 7 {
            vec_push(pat_tags, 5);
            vec_push(pat_data1, pp_start);
            vec_push(pat_data2, pp_count);
            vec_push(pat_data3, 0);
            return p + 1;
        }
        let mut arg_count: i32 = 0;
        let mut done: bool = false;
        while done != true {
            let pa: i32 = parse_pat(tags, starts, ends, source, p,
                                     pat_tags, pat_data1, pat_data2,
                                     pat_data3, path_pool);
            if pa < 0 { return 0 - 1; }
            arg_count = arg_count + 1;
            p = pa;
            if ps_peek(tags, p) == 12 {
                p = p + 1;
            } else {
                if ps_peek(tags, p) == 7 {
                    done = true;
                } else { return 0 - 1; }
            }
        }
        vec_push(pat_tags, 5);
        vec_push(pat_data1, pp_start);
        vec_push(pat_data2, pp_count);
        vec_push(pat_data3, arg_count);
        return p + 1;
    }
    vec_push(pat_tags, 5);
    vec_push(pat_data1, pp_start);
    vec_push(pat_data2, pp_count);
    vec_push(pat_data3, 0);
    return pos;
}

/* ── parse_pat_atom (SML parsePatAtom, lines 296-355) ─────────
   Dispatches on token: _ → PatWild, mut IDENT → PatBind,
   IDENT :: → path+pathPatternFrom, IDENT → PatBind,
   - literal → PatLit(neg), literal → PatLit,
   () → PatTuple(0), (pat) → unwrap, (pat,...) → PatTuple. */

fn parse_pat_atom(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                  source: string, pos: i32,
                  pat_tags: Vec<i32>, pat_data1: Vec<i32>,
                  pat_data2: Vec<i32>, pat_data3: Vec<i32>,
                  path_pool: Vec<i32>) -> i32 {
    let t: i32 = ps_peek(tags, pos);
    if t == 77 {
        if ps_peek(tags, pos + 1) == 5 {
            vec_push(pat_tags, 1);
            vec_push(pat_data1, pos + 1);
            vec_push(pat_data2, 1);
            vec_push(pat_data3, 0);
            return pos + 2;
        }
        return 0 - 1;
    }
    if t == 5 {
        let txt: string = ps_tok_text(source, starts, ends, pos);
        if string_eq(txt, "_") {
            vec_push(pat_tags, 0);
            vec_push(pat_data1, 0);
            vec_push(pat_data2, 0);
            vec_push(pat_data3, 0);
            return pos + 1;
        }
        if ps_peek(tags, pos + 1) == 15 {
            let pp_start: i32 = vec_len(path_pool);
            let p1: i32 = parse_path(tags, pos, path_pool);
            if p1 < 0 { return 0 - 1; }
            let pp_count: i32 = vec_len(path_pool) - pp_start;
            return path_pattern_from(tags, starts, ends, source, p1,
                                      pat_tags, pat_data1, pat_data2,
                                      pat_data3, path_pool,
                                      pp_start, pp_count);
        }
        vec_push(pat_tags, 1);
        vec_push(pat_data1, pos);
        vec_push(pat_data2, 0);
        vec_push(pat_data3, 0);
        return pos + 1;
    }
    if t == 23 {
        let nt: i32 = ps_peek(tags, pos + 1);
        if nt == 0 {
            vec_push(pat_tags, 2);
            vec_push(pat_data1, 0);
            vec_push(pat_data2, pos + 1);
            vec_push(pat_data3, 1);
            return pos + 2;
        }
        if nt == 1 {
            vec_push(pat_tags, 2);
            vec_push(pat_data1, 1);
            vec_push(pat_data2, pos + 1);
            vec_push(pat_data3, 1);
            return pos + 2;
        }
        return 0 - 1;
    }
    let lt: i32 = lit_from_tok(t);
    if lt >= 0 {
        vec_push(pat_tags, 2);
        vec_push(pat_data1, lt);
        vec_push(pat_data2, pos);
        vec_push(pat_data3, 0);
        return pos + 1;
    }
    if t == 6 {
        let p1: i32 = pos + 1;
        if ps_peek(tags, p1) == 7 {
            vec_push(pat_tags, 3);
            vec_push(pat_data1, 0);
            vec_push(pat_data2, 0);
            vec_push(pat_data3, 0);
            return p1 + 1;
        }
        let first_idx: i32 = vec_len(pat_tags);
        let p2: i32 = parse_pat(tags, starts, ends, source, p1,
                                  pat_tags, pat_data1, pat_data2,
                                  pat_data3, path_pool);
        if p2 < 0 { return 0 - 1; }
        if ps_peek(tags, p2) == 7 {
            return p2 + 1;
        }
        if ps_peek(tags, p2) == 12 {
            let mut p: i32 = p2 + 1;
            let mut count: i32 = 1;
            let mut done: bool = false;
            while done != true {
                if ps_peek(tags, p) == 7 {
                    vec_push(pat_tags, 3);
                    vec_push(pat_data1, first_idx);
                    vec_push(pat_data2, count);
                    vec_push(pat_data3, 0);
                    return p + 1;
                }
                let pn: i32 = parse_pat(tags, starts, ends, source, p,
                                          pat_tags, pat_data1, pat_data2,
                                          pat_data3, path_pool);
                if pn < 0 { return 0 - 1; }
                count = count + 1;
                p = pn;
                if ps_peek(tags, p) == 12 {
                    p = p + 1;
                } else {
                    if ps_peek(tags, p) != 7 { return 0 - 1; }
                }
            }
        }
        return 0 - 1;
    }
    return 0 - 1;
}

/* ── parse_pat (SML parsePat, lines 228-244) ──────────────────
   Entry point: parse_pat_atom then accumulate | alternatives. */

fn parse_pat(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
             source: string, pos: i32,
             pat_tags: Vec<i32>, pat_data1: Vec<i32>,
             pat_data2: Vec<i32>, pat_data3: Vec<i32>,
             path_pool: Vec<i32>) -> i32 {
    let first_idx: i32 = vec_len(pat_tags);
    let p1: i32 = parse_pat_atom(tags, starts, ends, source, pos,
                                  pat_tags, pat_data1, pat_data2,
                                  pat_data3, path_pool);
    if p1 < 0 { return 0 - 1; }
    if ps_peek(tags, p1) != 29 {
        return p1;
    }
    let mut p: i32 = p1;
    let mut count: i32 = 1;
    let mut or_done: bool = false;
    while or_done != true {
        if ps_peek(tags, p) != 29 {
            or_done = true;
        } else {
            p = p + 1;
            let pa: i32 = parse_pat_atom(tags, starts, ends, source, p,
                                          pat_tags, pat_data1, pat_data2,
                                          pat_data3, path_pool);
            if pa < 0 { return 0 - 1; }
            count = count + 1;
            p = pa;
        }
    }
    vec_push(pat_tags, 6);
    vec_push(pat_data1, first_idx);
    vec_push(pat_data2, count);
    vec_push(pat_data3, 0);
    return p;
}

/* ── expr arena tags ──────────────────────────────────────────
   0=ExprLit     1=ExprPath    2=ExprUnop     3=ExprBinop
   4=ExprCall    5=ExprMethodCall  6=ExprField  7=ExprTupleField
   8=ExprIndex   9=ExprBlock   10=ExprIf      11=ExprMatch
   12=ExprWhile  13=ExprFor    14=ExprLoop    15=ExprReturn
   16=ExprBreak  17=ExprContinue  18=ExprAssign 19=ExprAssignOp
   20=ExprCast   21=ExprRange  22=ExprTry     23=ExprAssert
   24=ExprStruct 25=ExprTuple  26=ExprArray

   Arena encoding (parallel Vec<i32>s, children before parents):
     0 ExprLit      : d1=lit_tag, d2=tok_pos
     1 ExprPath     : d1=pp_start, d2=pp_count
     2 ExprUnop     : d1=unop_tag, d2=operand_idx
     3 ExprBinop    : d1=binop_tag, d2=lhs_idx, d3=rhs_idx
     4 ExprCall     : d1=callee_idx, d2=args_first_idx, d3=args_count
     5 ExprMethodCall: d1=obj_idx, d2=method_tok, d3=args_first, d4=args_count
     6 ExprField    : d1=obj_idx, d2=field_tok
     7 ExprTupleField: d1=obj_idx, d2=field_num
     8 ExprIndex    : d1=obj_idx, d2=index_idx
     9 ExprBlock    : d1=stmts_first, d2=stmts_count, d3=tail_idx(-1=none)
    10 ExprIf       : d1=cond_idx, d2=then_idx, d3=else_idx(-1=none)
    11 ExprMatch    : d1=scrut_idx, d2=arms_first, d3=arms_count
    12 ExprWhile    : d1=cond_idx, d2=body_idx, d3=inv_first, d4=inv_count
    13 ExprFor      : d1=pat_idx, d2=iter_idx, d3=body_idx
    14 ExprLoop     : d1=body_idx
    15 ExprReturn   : d1=value_idx(-1=none)
    16 ExprBreak    : d1=value_idx(-1=none)
    17 ExprContinue : (no payload)
    18 ExprAssign   : d1=lhs_idx, d2=rhs_idx
    19 ExprAssignOp : d1=binop_tag, d2=lhs_idx, d3=rhs_idx
    20 ExprCast     : d1=expr_idx, d2=type_arena_idx
    21 ExprRange    : d1=lo_idx(-1=none), d2=hi_idx(-1=none)
    22 ExprTry      : d1=expr_idx
    23 ExprAssert   : d1=expr_idx
    24 ExprStruct   : d1=pp_start, d2=pp_count, d3=field_count,
                     d4=sf_names_start (index into parse_fn_body `body_sf`
                     field-name token positions; lowering reads
                     `lit_sf_names[sf_names_start + i]` for each field)
    25 ExprTuple    : d1=first_elem_idx, d2=elem_count
    26 ExprArray    : d1=first_elem_idx, d2=elem_count

   Stmt-like nodes (also in the expr arena, referenced by ExprBlock):
    27 LetStmt      : d1=name_tok_pos, d2=annotation type-head token (-1=none), d3=init_idx(-1=none), d4=is_mut(0/1)
    28 SemiStmt     : d1=expr_idx

   Match arm nodes (also in expr arena, referenced by ExprMatch):
    29 ExprMatchArm : d1=pat_tag, d2=pat_d1 or pat_extra_idx, d3=guard_idx(-1=none), d4=body_idx
    30 ExprPatExtra : pattern payload for match arms (PatLit/PatStruct/PatEnum);
                     d1,d2,d3 = parse_pat **root** row data (root = last pat row;
                     children precede parent in pat arena); d4 = pat_tag (2/4/5)
    31 ExprPatFieldEmbed : one struct-field sub-pattern row copied from the pat
                     arena (PatBind/PatLit/…); d1–d3 = pat data1–3, d4 = pat tag.
                     For PatEnum tuple arms, d2 = payload slot index (0..n-1).
    32 ExprPatStructMeta : precedes ExprPatExtra for PatStruct(4) arms only;
                     d1=field_count, d2=first ExprPatFieldEmbed index (-1 if none),
                     d3–d4 reserved
    33 ExprPatEnumMeta : precedes ExprPatExtra for PatEnum(5) arms with `(` … `)`
                     tuple args only; d1=arg_count, d2=first ExprPatFieldEmbed index,
                     d3–d4 reserved */

/* Parses a comma-separated argument list, pushing each argument's ROOT node index
   (its last-pushed node) to `arg_roots` in order. The number of args is
   vec_len(arg_roots); the roots are non-contiguous (a nested call arg spans many
   nodes), so callers store them via a pp sidecar (block_stmt_sidecar_push) exactly
   like block statements — counting `vec_len(et)` deltas over-counts multi-node
   args (e.g. `f(g(h(0)))` would look like 5 args). */
fn parse_arg_list(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                  source: string, pos: i32,
                  et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                  ed3: Vec<i32>, ed4: Vec<i32>,
                  pp: Vec<i32>, sf_names: Vec<i32>, arg_roots: Vec<i32>) -> i32 {
    if ps_peek(tags, pos) == 7 { return pos; }
    let p1: i32 = parse_expr_sf(tags, starts, ends, source, pos,
                                 et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
    if p1 < 0 { return 0 - 1; }
    vec_push(arg_roots, vec_len(et) - 1);
    let mut p: i32 = p1;
    let mut done: bool = false;
    while done != true {
        let t: i32 = ps_peek(tags, p);
        if t == 12 {
            let nt: i32 = ps_peek(tags, p + 1);
            if nt == 7 {
                done = true;
            } else {
                p = p + 1;
                let pa: i32 = parse_expr_sf(tags, starts, ends, source, p,
                                             et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
                if pa < 0 { return 0 - 1; }
                vec_push(arg_roots, vec_len(et) - 1);
                p = pa;
            }
        } else {
            done = true;
        }
    }
    return p;
}

fn parse_struct_fields(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                       source: string, pos: i32,
                       et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                       ed3: Vec<i32>, ed4: Vec<i32>,
                       pp: Vec<i32>, sf_names: Vec<i32>) -> i32 {
    if ps_peek(tags, pos) == 9 { return pos + 1; }
    let mut p: i32 = pos;
    let mut done: bool = false;
    while done != true {
        let t: i32 = ps_peek(tags, p);
        if t == 9 {
            done = true;
            p = p + 1;
        } else {
            if t == 17 {
                let nt: i32 = ps_peek(tags, p + 1);
                if nt == 5 {
                    let n2: i32 = ps_peek(tags, p + 2);
                    if n2 == 14 {
                        vec_push(sf_names, p + 1);
                        let pv: i32 = parse_expr_sf(tags, starts, ends, source, p + 3,
                                                  et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
                        if pv < 0 { return 0 - 1; }
                        vec_push(sf_names, vec_len(et) - 1);
                        p = pv;
                    } else {
                        return 0 - 1;
                    }
                } else {
                    return 0 - 1;
                }
            } else {
                if t == 5 {
                    let nt: i32 = ps_peek(tags, p + 1);
                    if nt == 14 {
                        vec_push(sf_names, p);
                        let pv: i32 = parse_expr_sf(tags, starts, ends, source, p + 2,
                                                  et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
                        if pv < 0 { return 0 - 1; }
                        vec_push(sf_names, vec_len(et) - 1);
                        p = pv;
                    } else {
                        vec_push(sf_names, p);
                        let pps: i32 = vec_len(pp);
                        vec_push(pp, p);
                        vec_push(et, 1);
                        vec_push(ed1, pps);
                        vec_push(ed2, 1);
                        vec_push(ed3, 0);
                        vec_push(ed4, 0);
                        vec_push(sf_names, vec_len(et) - 1);
                        p = p + 1;
                    }
                } else {
                    return 0 - 1;
                }
            }
            let ct: i32 = ps_peek(tags, p);
            if ct == 12 {
                p = p + 1;
            } else {
                if ct != 9 { return 0 - 1; }
            }
        }
    }
    return p;
}

fn parse_primary_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                      source: string, pos: i32,
                      et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                      ed3: Vec<i32>, ed4: Vec<i32>,
                      pp: Vec<i32>, sf_names: Vec<i32>,
                      allow_struct: i32) -> i32 {
    let t: i32 = ps_peek(tags, pos);
    let lt: i32 = lit_from_tok(t);
    if lt != 0 - 1 {
        vec_push(et, 0);
        vec_push(ed1, lt);
        vec_push(ed2, pos);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        return pos + 1;
    }
    /* `result` (TK_RESULT=84) in an `ensures` clause: the return value. SML parses
       it as ExprPath(["result"]) (parser.sml); mirror that as a 1-seg path so the
       contract expression parses. */
    if t == 84 {
        let ppr: i32 = vec_len(pp);
        vec_push(pp, pos);
        vec_push(et, 1);
        vec_push(ed1, ppr);
        vec_push(ed2, 1);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        return pos + 1;
    }
    if t == 5 {
        let pps: i32 = vec_len(pp);
        let p1: i32 = parse_path(tags, pos, pp);
        if p1 < 0 { return 0 - 1; }
        let ppc: i32 = vec_len(pp) - pps;
        if allow_struct == 1 {
            if ps_peek(tags, p1) == 8 {
                let fc_before: i32 = vec_len(sf_names);
                let first_val: i32 = vec_len(et);
                let pf: i32 = parse_struct_fields(tags, starts, ends, source,
                                                   p1 + 1, et, ed1, ed2, ed3,
                                                   ed4, pp, sf_names);
                if pf < 0 { return 0 - 1; }
                /* sf_names is stride-2 per field: [name_tok, value_root]. The
                   value root lets lowering read each field's value expression
                   directly (they are non-contiguous in the arena when values are
                   field accesses / calls), instead of guessing contiguity. */
                let fc: i32 = (vec_len(sf_names) - fc_before) / 2;
                vec_push(et, 24);
                vec_push(ed1, pps);
                vec_push(ed2, ppc);
                vec_push(ed3, fc);
                vec_push(ed4, fc_before);
                return pf;
            }
        }
        vec_push(et, 1);
        vec_push(ed1, pps);
        vec_push(ed2, ppc);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        return p1;
    }
    if t == 6 {
        let nt: i32 = ps_peek(tags, pos + 1);
        if nt == 7 {
            vec_push(et, 0);
            vec_push(ed1, 5);
            vec_push(ed2, pos);
            vec_push(ed3, 0);
            vec_push(ed4, 0);
            return pos + 2;
        }
        let p1: i32 = parse_expr_sf(tags, starts, ends, source, pos + 1,
                                  et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
        if p1 < 0 { return 0 - 1; }
        if ps_peek(tags, p1) == 7 {
            return p1 + 1;
        }
        if ps_peek(tags, p1) == 12 {
            let first_idx: i32 = vec_len(et) - 1;
            let mut count: i32 = 1;
            let mut p: i32 = p1 + 1;
            let mut td: bool = false;
            while td != true {
                if ps_peek(tags, p) == 7 {
                    vec_push(et, 25);
                    vec_push(ed1, first_idx);
                    vec_push(ed2, count);
                    vec_push(ed3, 0);
                    vec_push(ed4, 0);
                    return p + 1;
                }
                let pa: i32 = parse_expr_sf(tags, starts, ends, source, p,
                                          et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
                if pa < 0 { return 0 - 1; }
                count = count + 1;
                p = pa;
                if ps_peek(tags, p) == 12 {
                    p = p + 1;
                } else {
                    if ps_peek(tags, p) == 7 {
                        vec_push(et, 25);
                        vec_push(ed1, first_idx);
                        vec_push(ed2, count);
                        vec_push(ed3, 0);
                        vec_push(ed4, 0);
                        return p + 1;
                    }
                    return 0 - 1;
                }
            }
        }
        return 0 - 1;
    }
    if t == 10 {
        if ps_peek(tags, pos + 1) == 11 {
            vec_push(et, 26);
            vec_push(ed1, 0);
            vec_push(ed2, 0);
            vec_push(ed3, 0);
            vec_push(ed4, 0);
            return pos + 2;
        }
        let first_idx: i32 = vec_len(et);
        let p1: i32 = parse_expr_sf(tags, starts, ends, source, pos + 1,
                                  et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
        if p1 < 0 { return 0 - 1; }
        if ps_peek(tags, p1) == 13 {
            let p2: i32 = parse_expr_sf(tags, starts, ends, source, p1 + 1,
                                      et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
            if p2 < 0 { return 0 - 1; }
            if ps_peek(tags, p2) != 11 { return 0 - 1; }
            vec_push(et, 26);
            vec_push(ed1, first_idx);
            vec_push(ed2, 2);
            vec_push(ed3, 0);
            vec_push(ed4, 0);
            return p2 + 1;
        }
        if ps_peek(tags, p1) == 11 {
            vec_push(et, 26);
            vec_push(ed1, first_idx);
            vec_push(ed2, 1);
            vec_push(ed3, 0);
            vec_push(ed4, 0);
            return p1 + 1;
        }
        if ps_peek(tags, p1) == 12 {
            let mut count: i32 = 1;
            let mut p: i32 = p1 + 1;
            let mut ad: bool = false;
            while ad != true {
                if ps_peek(tags, p) == 11 {
                    vec_push(et, 26);
                    vec_push(ed1, first_idx);
                    vec_push(ed2, count);
                    vec_push(ed3, 0);
                    vec_push(ed4, 0);
                    return p + 1;
                }
                let pa: i32 = parse_expr_sf(tags, starts, ends, source, p,
                                          et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
                if pa < 0 { return 0 - 1; }
                count = count + 1;
                p = pa;
                if ps_peek(tags, p) == 12 {
                    p = p + 1;
                } else {
                    if ps_peek(tags, p) == 11 {
                        vec_push(et, 26);
                        vec_push(ed1, first_idx);
                        vec_push(ed2, count);
                        vec_push(ed3, 0);
                        vec_push(ed4, 0);
                        return p + 1;
                    }
                    return 0 - 1;
                }
            }
        }
        return 0 - 1;
    }
    if t == 8 {
        return parse_block(tags, starts, ends, source, pos,
                           et, ed1, ed2, ed3, ed4, pp, sf_names);
    }
    if t == 68 {
        return parse_if_expr(tags, starts, ends, source, pos + 1,
                             et, ed1, ed2, ed3, ed4, pp, sf_names);
    }
    if t == 96 {
        return parse_while_expr(tags, starts, ends, source, pos + 1,
                                et, ed1, ed2, ed3, ed4, pp, sf_names);
    }
    if t == 66 {
        return parse_for_expr(tags, starts, ends, source, pos + 1,
                              et, ed1, ed2, ed3, ed4, pp, sf_names);
    }
    if t == 72 {
        return parse_loop_expr(tags, starts, ends, source, pos + 1,
                               et, ed1, ed2, ed3, ed4, pp, sf_names);
    }
    if t == 85 {
        return parse_return_expr(tags, starts, ends, source, pos + 1,
                                 et, ed1, ed2, ed3, ed4, pp, sf_names);
    }
    if t == 93 {
        return parse_block(tags, starts, ends, source, pos + 1,
                           et, ed1, ed2, ed3, ed4, pp, sf_names);
    }
    if t == 55 {
        let pa: i32 = parse_expr_sf(tags, starts, ends, source, pos + 1,
                                  et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
        if pa < 0 { return 0 - 1; }
        let ei: i32 = vec_len(et) - 1;
        vec_push(et, 23);
        vec_push(ed1, ei);
        vec_push(ed2, 0);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        return pa;
    }
    if t == 74 {
        return parse_match_expr(tags, starts, ends, source, pos + 1,
                                et, ed1, ed2, ed3, ed4, pp, sf_names);
    }
    if t == 67 {
        return parse_quant(tags, starts, ends, source, pos, 1,
                           et, ed1, ed2, ed3, ed4, pp);
    }
    if t == 63 {
        return parse_quant(tags, starts, ends, source, pos, 0,
                           et, ed1, ed2, ed3, ed4, pp);
    }
    if t == 80 {
        if ps_peek(tags, pos + 1) != 6 { return 0 - 1; }
        let first_idx: i32 = vec_len(et);
        let pe: i32 = parse_expr_sf(tags, starts, ends, source, pos + 2,
                                  et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
        if pe < 0 { return 0 - 1; }
        if ps_peek(tags, pe) != 7 { return 0 - 1; }
        let pps: i32 = vec_len(pp);
        vec_push(pp, pos);
        vec_push(et, 1);
        vec_push(ed1, pps);
        vec_push(ed2, 1);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        let callee_idx: i32 = vec_len(et) - 1;
        vec_push(et, 4);
        vec_push(ed1, callee_idx);
        vec_push(ed2, first_idx);
        vec_push(ed3, 1);
        vec_push(ed4, 0);
        return pe + 1;
    }
    if t == 79 {
        if ps_peek(tags, pos + 1) != 6 { return 0 - 1; }
        let first_idx: i32 = vec_len(et);
        let pa: i32 = parse_expr_sf(tags, starts, ends, source, pos + 2,
                                  et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
        if pa < 0 { return 0 - 1; }
        if ps_peek(tags, pa) != 12 { return 0 - 1; }
        let pb: i32 = parse_expr_sf(tags, starts, ends, source, pa + 1,
                                  et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
        if pb < 0 { return 0 - 1; }
        if ps_peek(tags, pb) != 7 { return 0 - 1; }
        let pps: i32 = vec_len(pp);
        vec_push(pp, pos);
        vec_push(et, 1);
        vec_push(ed1, pps);
        vec_push(ed2, 1);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        let callee_idx: i32 = vec_len(et) - 1;
        vec_push(et, 4);
        vec_push(ed1, callee_idx);
        vec_push(ed2, first_idx);
        vec_push(ed3, 2);
        vec_push(ed4, 0);
        return pb + 1;
    }
    return 0 - 1;
}

fn parse_postfix_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                      source: string, pos: i32,
                      et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                      ed3: Vec<i32>, ed4: Vec<i32>,
                      pp: Vec<i32>, sf_names: Vec<i32>,
                      allow_struct: i32) -> i32 {
    let p1: i32 = parse_primary_expr(tags, starts, ends, source, pos,
                                      et, ed1, ed2, ed3, ed4, pp, sf_names,
                                      allow_struct);
    if p1 < 0 { return 0 - 1; }
    let mut cur: i32 = vec_len(et) - 1;
    let mut p: i32 = p1;
    let mut done: bool = false;
    while done != true {
        let t: i32 = ps_peek(tags, p);
        if t == 6 {
            let args_before: i32 = vec_len(et);
            let arg_roots: Vec<i32> = vec_new();
            let pa: i32 = parse_arg_list(tags, starts, ends, source, p + 1,
                                          et, ed1, ed2, ed3, ed4, pp, sf_names,
                                          arg_roots);
            if pa < 0 { return 0 - 1; }
            /* d3 = real argument count; d4 = pp sidecar of arg-root indices (args
               are non-contiguous). Consumers read arg k via block_stmt_index. */
            let argc: i32 = vec_len(arg_roots);
            if ps_peek(tags, pa) != 7 { return 0 - 1; }
            vec_push(et, 4);
            vec_push(ed1, cur);
            vec_push(ed2, args_before);
            vec_push(ed3, argc);
            vec_push(ed4, block_stmt_sidecar_push(pp, arg_roots));
            cur = vec_len(et) - 1;
            p = pa + 1;
        } else {
            if t == 16 {
                let nt: i32 = ps_peek(tags, p + 1);
                if nt == 5 {
                    let n2: i32 = ps_peek(tags, p + 2);
                    if n2 == 6 {
                        let method_tok: i32 = p + 1;
                        let args_before: i32 = vec_len(et);
                        let arg_roots_m: Vec<i32> = vec_new();
                        let pa: i32 = parse_arg_list(tags, starts, ends, source,
                                                      p + 3, et, ed1, ed2, ed3,
                                                      ed4, pp, sf_names, arg_roots_m);
                        if pa < 0 { return 0 - 1; }
                        /* Method calls (tag 5) have no free field for an arg
                           sidecar; store the real arg count (flat method args are
                           contiguous — nested method args are not yet supported). */
                        let argc: i32 = vec_len(arg_roots_m);
                        if ps_peek(tags, pa) != 7 { return 0 - 1; }
                        vec_push(et, 5);
                        vec_push(ed1, cur);
                        vec_push(ed2, method_tok);
                        vec_push(ed3, args_before);
                        vec_push(ed4, argc);
                        cur = vec_len(et) - 1;
                        p = pa + 1;
                    } else {
                        vec_push(et, 6);
                        vec_push(ed1, cur);
                        vec_push(ed2, p + 1);
                        vec_push(ed3, 0);
                        vec_push(ed4, 0);
                        cur = vec_len(et) - 1;
                        p = p + 2;
                    }
                } else {
                    if nt == 0 {
                        vec_push(et, 7);
                        vec_push(ed1, cur);
                        vec_push(ed2, p + 1);
                        vec_push(ed3, 0);
                        vec_push(ed4, 0);
                        cur = vec_len(et) - 1;
                        p = p + 2;
                    } else {
                        done = true;
                    }
                }
            } else {
                if t == 10 {
                    let ix_p: i32 = parse_expr_sf(tags, starts, ends, source,
                                                p + 1, et, ed1, ed2, ed3,
                                                ed4, pp, sf_names, 1);
                    if ix_p < 0 { return 0 - 1; }
                    let ix_idx: i32 = vec_len(et) - 1;
                    if ps_peek(tags, ix_p) != 11 { return 0 - 1; }
                    vec_push(et, 8);
                    vec_push(ed1, cur);
                    vec_push(ed2, ix_idx);
                    vec_push(ed3, 0);
                    vec_push(ed4, 0);
                    cur = vec_len(et) - 1;
                    p = ix_p + 1;
                } else {
                    done = true;
                }
            }
        }
    }
    return p;
}

fn parse_unary_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                    source: string, pos: i32,
                    et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                    ed3: Vec<i32>, ed4: Vec<i32>,
                    pp: Vec<i32>, sf_names: Vec<i32>,
                    allow_struct: i32) -> i32 {
    let t: i32 = ps_peek(tags, pos);
    if t == 23 {
        let p1: i32 = parse_unary_expr(tags, starts, ends, source, pos + 1,
                                        et, ed1, ed2, ed3, ed4, pp, sf_names,
                                        allow_struct);
        if p1 < 0 { return 0 - 1; }
        let oi: i32 = vec_len(et) - 1;
        vec_push(et, 2);
        vec_push(ed1, 0);
        vec_push(ed2, oi);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        return p1;
    }
    if t == 33 {
        let p1: i32 = parse_unary_expr(tags, starts, ends, source, pos + 1,
                                        et, ed1, ed2, ed3, ed4, pp, sf_names,
                                        allow_struct);
        if p1 < 0 { return 0 - 1; }
        let oi: i32 = vec_len(et) - 1;
        vec_push(et, 2);
        vec_push(ed1, 1);
        vec_push(ed2, oi);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        return p1;
    }
    if t == 24 {
        let p1: i32 = parse_unary_expr(tags, starts, ends, source, pos + 1,
                                        et, ed1, ed2, ed3, ed4, pp, sf_names,
                                        allow_struct);
        if p1 < 0 { return 0 - 1; }
        let oi: i32 = vec_len(et) - 1;
        vec_push(et, 2);
        vec_push(ed1, 3);
        vec_push(ed2, oi);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        return p1;
    }
    if t == 27 {
        if ps_peek(tags, pos + 1) == 77 {
            let p1: i32 = parse_unary_expr(tags, starts, ends, source, pos + 2,
                                            et, ed1, ed2, ed3, ed4, pp, sf_names,
                                            allow_struct);
            if p1 < 0 { return 0 - 1; }
            let oi: i32 = vec_len(et) - 1;
            vec_push(et, 2);
            vec_push(ed1, 5);
            vec_push(ed2, oi);
            vec_push(ed3, 0);
            vec_push(ed4, 0);
            return p1;
        }
        let p1: i32 = parse_unary_expr(tags, starts, ends, source, pos + 1,
                                        et, ed1, ed2, ed3, ed4, pp, sf_names,
                                        allow_struct);
        if p1 < 0 { return 0 - 1; }
        let oi: i32 = vec_len(et) - 1;
        vec_push(et, 2);
        vec_push(ed1, 4);
        vec_push(ed2, oi);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        return p1;
    }
    return parse_postfix_expr(tags, starts, ends, source, pos,
                               et, ed1, ed2, ed3, ed4, pp, sf_names,
                               allow_struct);
}

fn parse_cast_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                   source: string, pos: i32,
                   et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                   ed3: Vec<i32>, ed4: Vec<i32>,
                   pp: Vec<i32>, sf_names: Vec<i32>,
                   ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                   ty_d2: Vec<i32>, ty_d3: Vec<i32>,
                   allow_struct: i32) -> i32 {
    let p1: i32 = parse_unary_expr(tags, starts, ends, source, pos,
                                    et, ed1, ed2, ed3, ed4, pp, sf_names,
                                    allow_struct);
    if p1 < 0 { return 0 - 1; }
    let mut cur: i32 = vec_len(et) - 1;
    let mut p: i32 = p1;
    let mut done: bool = false;
    while done != true {
        if ps_peek(tags, p) == 54 {
            let ty_idx: i32 = vec_len(ty_tags);
            let pt: i32 = parse_type(tags, starts, ends, source, p + 1,
                                      ty_tags, ty_d1, ty_d2, ty_d3, pp);
            if pt < 0 { return 0 - 1; }
            vec_push(et, 20);
            vec_push(ed1, cur);
            vec_push(ed2, ty_idx);
            vec_push(ed3, 0);
            vec_push(ed4, 0);
            cur = vec_len(et) - 1;
            p = pt;
        } else {
            done = true;
        }
    }
    return p;
}

fn parse_mul_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                  source: string, pos: i32,
                  et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                  ed3: Vec<i32>, ed4: Vec<i32>,
                  pp: Vec<i32>, sf_names: Vec<i32>,
                  ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                  ty_d2: Vec<i32>, ty_d3: Vec<i32>,
                  allow_struct: i32) -> i32 {
    let p1: i32 = parse_cast_expr(tags, starts, ends, source, pos,
                                   et, ed1, ed2, ed3, ed4, pp, sf_names,
                                   ty_tags, ty_d1, ty_d2, ty_d3, allow_struct);
    if p1 < 0 { return 0 - 1; }
    let mut left: i32 = vec_len(et) - 1;
    let mut p: i32 = p1;
    let mut done: bool = false;
    while done != true {
        let t: i32 = ps_peek(tags, p);
        if is_multiplicative_token(t) != true {
            done = true;
        } else {
            let bop: i32 = binop_of(t);
            let pa: i32 = parse_cast_expr(tags, starts, ends, source, p + 1,
                                           et, ed1, ed2, ed3, ed4, pp, sf_names,
                                           ty_tags, ty_d1, ty_d2, ty_d3,
                                           allow_struct);
            if pa < 0 { return 0 - 1; }
            let ri: i32 = vec_len(et) - 1;
            vec_push(et, 3);
            vec_push(ed1, bop);
            vec_push(ed2, left);
            vec_push(ed3, ri);
            vec_push(ed4, 0);
            left = vec_len(et) - 1;
            p = pa;
        }
    }
    return p;
}

fn parse_add_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
