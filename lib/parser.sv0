/* Phase 2 real pipeline module: sml/parser/parser.sml -> sv0.
   Token stream navigation (peek/advance/expect/match on parallel Vecs
   from lexer tokenize), parsePath, skipOptionalPub/skipOptionalUnsafe/
   skipGenericParams/skipWhereClause/skipAttributes on token stream,
   token→binop/assign-binop/literal mapping, Pratt precedence, span
   merge. Full recursive-descent parser (parseExpr/parseType/parsePat/
   parseItem) deferred — needs mutual recursion over AST construction. */

/* ── token tag constants (from token.sv0) ───────────────────── */

fn TK_INT_LIT() -> i32 { return 0; }
fn TK_FLOAT_LIT() -> i32 { return 1; }
fn TK_STRING_LIT() -> i32 { return 2; }
fn TK_CHAR_LIT() -> i32 { return 3; }
fn TK_BOOL_LIT() -> i32 { return 4; }
fn TK_IDENT() -> i32 { return 5; }
fn TK_LPAREN() -> i32 { return 6; }
fn TK_RPAREN() -> i32 { return 7; }
fn TK_LBRACE() -> i32 { return 8; }
fn TK_RBRACE() -> i32 { return 9; }
fn TK_LBRACKET() -> i32 { return 10; }
fn TK_RBRACKET() -> i32 { return 11; }
fn TK_COMMA() -> i32 { return 12; }
fn TK_SEMICOLON() -> i32 { return 13; }
fn TK_COLON() -> i32 { return 14; }
fn TK_COLONCOLON() -> i32 { return 15; }
fn TK_DOT() -> i32 { return 16; }
fn TK_DOTDOT() -> i32 { return 17; }
fn TK_ARROW() -> i32 { return 19; }
fn TK_FATARROW() -> i32 { return 20; }
fn TK_HASH() -> i32 { return 21; }
fn TK_PLUS() -> i32 { return 22; }
fn TK_MINUS() -> i32 { return 23; }
fn TK_STAR() -> i32 { return 24; }
fn TK_SLASH() -> i32 { return 25; }
fn TK_PERCENT() -> i32 { return 26; }
fn TK_AMP() -> i32 { return 27; }
fn TK_AMPAMP() -> i32 { return 28; }
fn TK_PIPE() -> i32 { return 29; }
fn TK_PIPEPIPE() -> i32 { return 30; }
fn TK_CARET() -> i32 { return 31; }
fn TK_BANG() -> i32 { return 33; }
fn TK_EQ() -> i32 { return 35; }
fn TK_EQEQ() -> i32 { return 36; }
fn TK_BANGEQ() -> i32 { return 37; }
fn TK_LT() -> i32 { return 38; }
fn TK_GT() -> i32 { return 39; }
fn TK_LTEQ() -> i32 { return 40; }
fn TK_GTEQ() -> i32 { return 41; }
fn TK_LTLT() -> i32 { return 42; }
fn TK_GTGT() -> i32 { return 43; }
fn TK_PLUSEQ() -> i32 { return 44; }
fn TK_MINUSEQ() -> i32 { return 45; }
fn TK_STAREQ() -> i32 { return 46; }
fn TK_SLASHEQ() -> i32 { return 47; }
fn TK_PERCENTEQ() -> i32 { return 48; }
fn TK_AMPEQ() -> i32 { return 49; }
fn TK_PIPEEQ() -> i32 { return 50; }
fn TK_CARETEQ() -> i32 { return 51; }
fn TK_LTLTEQ() -> i32 { return 52; }
fn TK_GTGTEQ() -> i32 { return 53; }
fn TK_PUB() -> i32 { return 82; }
fn TK_PROJECT() -> i32 { return 81; }
fn TK_UNSAFE() -> i32 { return 93; }
fn TK_FN() -> i32 { return 65; }
fn TK_WHERE() -> i32 { return 95; }
fn TK_TRUE() -> i32 { return 91; }
fn TK_FALSE() -> i32 { return 64; }
fn TK_EOF() -> i32 { return 97; }
fn TK_SELF_TYPE() -> i32 { return 87; }
fn TK_MUT() -> i32 { return 77; }
fn TK_LET() -> i32 { return 71; }
fn TK_IF() -> i32 { return 68; }
fn TK_ELSE() -> i32 { return 60; }
fn TK_MATCH() -> i32 { return 74; }
fn TK_RETURN() -> i32 { return 85; }
fn TK_WHILE() -> i32 { return 96; }
fn TK_LOOP() -> i32 { return 72; }
fn TK_FOR() -> i32 { return 66; }
fn TK_BREAK() -> i32 { return 57; }
fn TK_CONTINUE() -> i32 { return 59; }
fn TK_STRUCT() -> i32 { return 89; }
fn TK_ENUM() -> i32 { return 62; }
fn TK_IMPL() -> i32 { return 69; }
fn TK_TRAIT() -> i32 { return 90; }
fn TK_TYPE() -> i32 { return 92; }
fn TK_USE() -> i32 { return 94; }
fn TK_AS() -> i32 { return 54; }
fn TK_IN() -> i32 { return 70; }

/* ── token stream navigation ───────────────────────────────────
   Works on the parallel Vec<i32> triplet (tags, starts, ends)
   produced by lexer tokenize. pos is the current index.
   Convention: functions return the new pos; error → return -1. */

fn ps_peek(tags: Vec<i32>, pos: i32) -> i32 {
    if pos >= vec_len(tags) { return 97; }
    return vec_get(tags, pos);
}

fn ps_at_end(tags: Vec<i32>, pos: i32) -> bool {
    return ps_peek(tags, pos) == 97;
}

fn ps_start(starts: Vec<i32>, pos: i32) -> i32 {
    return vec_get(starts, pos);
}

fn ps_end(ends: Vec<i32>, pos: i32) -> i32 {
    return vec_get(ends, pos);
}

fn ps_advance(pos: i32) -> i32 {
    return pos + 1;
}

fn ps_expect(tags: Vec<i32>, pos: i32, expected: i32) -> i32 {
    if ps_peek(tags, pos) != expected { return 0 - 1; }
    return pos + 1;
}

fn ps_match(tags: Vec<i32>, pos: i32, expected: i32) -> i32 {
    if ps_peek(tags, pos) == expected { return pos + 1; }
    return pos;
}

fn ps_tok_text(source: string, starts: Vec<i32>, ends: Vec<i32>, pos: i32) -> string {
    let s: i32 = vec_get(starts, pos);
    let e: i32 = vec_get(ends, pos);
    return string_substr(source, s, e - s);
}

/* ── parsePath ─────────────────────────────────────────────────
   Parses a path like `foo`, `Foo::Bar`, `Foo::Bar::Baz`.
   Stores token indices of path segments in path_out.
   Returns new pos, or -1 on error. */

fn parse_path(tags: Vec<i32>, pos: i32, path_out: Vec<i32>) -> i32 {
    let tag: i32 = ps_peek(tags, pos);
    if tag != 5 { return 0 - 1; }
    vec_push(path_out, pos);
    let mut p: i32 = pos + 1;
    let mut done: bool = false;
    while done != true {
        if ps_peek(tags, p) == 15 {
            let next: i32 = ps_peek(tags, p + 1);
            if next == 5 {
                vec_push(path_out, p + 1);
                p = p + 2;
            } else { done = true; }
        } else { done = true; }
    }
    return p;
}

/* ── skip helpers on token stream ──────────────────────────────
   These operate on (tags, pos) and return new pos. */

fn ps_skip_optional_pub(tags: Vec<i32>, pos: i32) -> i32 {
    if ps_peek(tags, pos) != 82 { return pos; }
    if ps_peek(tags, pos + 1) == 6 {
        if ps_peek(tags, pos + 2) == 81 {
            if ps_peek(tags, pos + 3) == 7 {
                return pos + 4;
            }
        }
    }
    return pos + 1;
}

fn ps_skip_optional_unsafe(tags: Vec<i32>, pos: i32) -> i32 {
    if ps_peek(tags, pos) == 93 { return pos + 1; }
    return pos;
}

fn ps_skip_generic_params(tags: Vec<i32>, pos: i32) -> i32 {
    if ps_peek(tags, pos) != 38 { return pos; }
    let mut p: i32 = pos + 1;
    let mut depth: i32 = 1;
    while depth > 0 {
        let t: i32 = ps_peek(tags, p);
        if t == 97 { return p; }
        if t == 38 { depth = depth + 1; }
        if t == 39 { depth = depth - 1; }
        p = p + 1;
    }
    return p;
}

fn ps_skip_where_clause(tags: Vec<i32>, pos: i32) -> i32 {
    if ps_peek(tags, pos) != 95 { return pos; }
    let mut p: i32 = pos + 1;
    let mut done: bool = false;
    while done != true {
        let t: i32 = ps_peek(tags, p);
        if t == 97 { return p; }
        if t == 8 { return p; }
        if t == 65 { return p; }
        if t == 13 { return p + 1; }
        p = p + 1;
    }
    return p;
}

fn ps_skip_attributes(tags: Vec<i32>, pos: i32) -> i32 {
    let mut p: i32 = pos;
    let mut scanning: bool = true;
    while scanning {
        if ps_peek(tags, p) == 21 {
            if ps_peek(tags, p + 1) == 10 {
                p = p + 2;
                let mut depth: i32 = 1;
                while depth > 0 {
                    let t: i32 = ps_peek(tags, p);
                    if t == 97 { return p; }
                    if t == 10 { depth = depth + 1; }
                    if t == 11 { depth = depth - 1; }
                    p = p + 1;
                }
            } else { scanning = false; }
        } else { scanning = false; }
    }
    return p;
}

/* ── AST binop tags (matching ast.sv0) ──────────────────────── */

fn AST_ADD() -> i32 { return 0; }
fn AST_SUB() -> i32 { return 1; }
fn AST_MUL() -> i32 { return 2; }
fn AST_DIV() -> i32 { return 3; }
fn AST_REM() -> i32 { return 4; }
fn AST_EQ() -> i32 { return 5; }
fn AST_NEQ() -> i32 { return 6; }
fn AST_LT() -> i32 { return 7; }
fn AST_GT() -> i32 { return 8; }
fn AST_LEQ() -> i32 { return 9; }
fn AST_GEQ() -> i32 { return 10; }
fn AST_AND() -> i32 { return 11; }
fn AST_OR() -> i32 { return 12; }
fn AST_BITAND() -> i32 { return 13; }
fn AST_BITOR() -> i32 { return 14; }
fn AST_BITXOR() -> i32 { return 15; }
fn AST_SHL() -> i32 { return 16; }
fn AST_SHR() -> i32 { return 17; }

/* ── token → binop mapping ──────────────────────────────────── */

fn binop_of(tok_tag: i32) -> i32 {
    if tok_tag == 22 { return 0; }
    if tok_tag == 23 { return 1; }
    if tok_tag == 24 { return 2; }
    if tok_tag == 25 { return 3; }
    if tok_tag == 26 { return 4; }
    if tok_tag == 27 { return 13; }
    if tok_tag == 29 { return 14; }
    if tok_tag == 31 { return 15; }
    if tok_tag == 42 { return 16; }
    if tok_tag == 43 { return 17; }
    if tok_tag == 28 { return 11; }
    if tok_tag == 30 { return 12; }
    if tok_tag == 36 { return 5; }
    if tok_tag == 37 { return 6; }
    if tok_tag == 38 { return 7; }
    if tok_tag == 39 { return 8; }
    if tok_tag == 40 { return 9; }
    if tok_tag == 41 { return 10; }
    return 0 - 1;
}

fn has_binop(tok_tag: i32) -> bool {
    return binop_of(tok_tag) >= 0;
}

/* ── token → assign binop mapping ───────────────────────────── */

fn assign_binop(tok_tag: i32) -> i32 {
    if tok_tag == 44 { return 0; }
    if tok_tag == 45 { return 1; }
    if tok_tag == 46 { return 2; }
    if tok_tag == 47 { return 3; }
    if tok_tag == 48 { return 4; }
    if tok_tag == 49 { return 13; }
    if tok_tag == 50 { return 14; }
    if tok_tag == 51 { return 15; }
    if tok_tag == 52 { return 16; }
    if tok_tag == 53 { return 17; }
    return 0 - 1;
}

fn has_assign_binop(tok_tag: i32) -> bool {
    return assign_binop(tok_tag) >= 0;
}

fn is_compound_assign(tok_tag: i32) -> bool {
    if tok_tag >= 44 {
        if tok_tag <= 53 { return true; }
    }
    return false;
}

/* ── literal classification from token ──────────────────────── */

fn LIT_TAG_INT() -> i32 { return 0; }
fn LIT_TAG_FLOAT() -> i32 { return 1; }
fn LIT_TAG_STRING() -> i32 { return 3; }
fn LIT_TAG_CHAR() -> i32 { return 4; }
fn LIT_TAG_BOOL() -> i32 { return 5; }
fn LIT_TAG_NONE() -> i32 { return 0 - 1; }

fn lit_from_tok(tok_tag: i32) -> i32 {
    if tok_tag == 0 { return 0; }
    if tok_tag == 1 { return 1; }
    if tok_tag == 2 { return 3; }
    if tok_tag == 3 { return 4; }
    if tok_tag == 91 { return 5; }
    if tok_tag == 64 { return 5; }
    return 0 - 1;
}

fn is_literal_tok(tok_tag: i32) -> bool {
    return lit_from_tok(tok_tag) >= 0;
}

/* ── expr span extraction ───────────────────────────────────── */

fn expr_has_span(expr_tag: i32) -> bool {
    if expr_tag >= 0 {
        if expr_tag <= 27 { return true; }
    }
    return false;
}

/* ── skip helpers ───────────────────────────────────────────── */

fn is_pub_token(tok_tag: i32) -> bool {
    return tok_tag == 82;
}

fn is_unsafe_token(tok_tag: i32) -> bool {
    return tok_tag == 93;
}

fn is_where_token(tok_tag: i32) -> bool {
    return tok_tag == 95;
}

fn is_hash_token(tok_tag: i32) -> bool {
    return tok_tag == 21;
}

fn is_lt_token(tok_tag: i32) -> bool {
    return tok_tag == 38;
}

fn is_gt_token(tok_tag: i32) -> bool {
    return tok_tag == 39;
}

/* skipGenericParams: track angle-bracket depth */
fn generic_params_update_depth(tok_tag: i32, depth: i32) -> i32 {
    if tok_tag == 38 { return depth + 1; }
    if tok_tag == 39 { return depth - 1; }
    return depth;
}

fn generic_params_done(depth: i32) -> bool {
    return depth <= 0;
}

/* skipWhereClause stop tokens */
fn where_clause_stop(tok_tag: i32) -> bool {
    if tok_tag == 8 { return true; }
    if tok_tag == 65 { return true; }
    if tok_tag == 13 { return true; }
    if tok_tag == 97 { return true; }
    return false;
}

/* skipAttributes: track bracket depth */
fn attr_bracket_update(tok_tag: i32, depth: i32) -> i32 {
    if tok_tag == 10 { return depth + 1; }
    if tok_tag == 11 { return depth - 1; }
    return depth;
}

/* ── pathOfTy ───────────────────────────────────────────────── */

fn ty_is_name(ty_tag: i32) -> bool {
    return ty_tag == 0;
}

/* ── span merge (min start, max end) ────────────────────────── */

fn span_min(a: i32, b: i32) -> i32 {
    if a <= b { return a; }
    return b;
}

fn span_max(a: i32, b: i32) -> i32 {
    if a >= b { return a; }
    return b;
}

fn span_merge_start(s1: i32, s2: i32) -> i32 {
    return span_min(s1, s2);
}

fn span_merge_end(e1: i32, e2: i32) -> i32 {
    return span_max(e1, e2);
}

/* ── precedence helpers ─────────────────────────────────────── */

fn is_cmp_token(tok_tag: i32) -> bool {
    if tok_tag == 36 { return true; }
    if tok_tag == 37 { return true; }
    if tok_tag == 38 { return true; }
    if tok_tag == 39 { return true; }
    if tok_tag == 40 { return true; }
    if tok_tag == 41 { return true; }
    return false;
}

fn is_additive_token(tok_tag: i32) -> bool {
    if tok_tag == 22 { return true; }
    if tok_tag == 23 { return true; }
    return false;
}

fn is_multiplicative_token(tok_tag: i32) -> bool {
    if tok_tag == 24 { return true; }
    if tok_tag == 25 { return true; }
    if tok_tag == 26 { return true; }
    return false;
}

fn is_shift_token(tok_tag: i32) -> bool {
    if tok_tag == 42 { return true; }
    if tok_tag == 43 { return true; }
    return false;
}

fn is_unary_prefix(tok_tag: i32) -> bool {
    if tok_tag == 23 { return true; }
    if tok_tag == 33 { return true; }
    if tok_tag == 27 { return true; }
    if tok_tag == 24 { return true; }
    return false;
}

/* ── Pratt precedence (binop tag → level) ──────────────────── */

fn prec_of_binop(binop_tag: i32) -> i32 {
    if binop_tag == 12 { return 1; }
    if binop_tag == 11 { return 2; }
    if binop_tag == 5 { return 3; }
    if binop_tag == 6 { return 3; }
    if binop_tag == 7 { return 3; }
    if binop_tag == 8 { return 3; }
    if binop_tag == 9 { return 3; }
    if binop_tag == 10 { return 3; }
    if binop_tag == 14 { return 4; }
    if binop_tag == 15 { return 5; }
    if binop_tag == 13 { return 6; }
    if binop_tag == 16 { return 7; }
    if binop_tag == 17 { return 7; }
    if binop_tag == 0 { return 8; }
    if binop_tag == 1 { return 8; }
    if binop_tag == 2 { return 9; }
    if binop_tag == 3 { return 9; }
    if binop_tag == 4 { return 9; }
    return 0;
}

fn is_right_assoc(binop_tag: i32) -> bool {
    return false;
}

fn next_prec(current: i32, right_assoc: bool) -> i32 {
    if right_assoc { return current; }
    return current + 1;
}

fn binop_is_comparison(binop_tag: i32) -> bool {
    return prec_of_binop(binop_tag) == 3;
}

fn binop_is_arithmetic(binop_tag: i32) -> bool {
    let p: i32 = prec_of_binop(binop_tag);
    if p == 8 { return true; }
    if p == 9 { return true; }
    return false;
}

fn binop_is_logical(binop_tag: i32) -> bool {
    let p: i32 = prec_of_binop(binop_tag);
    if p == 1 { return true; }
    if p == 2 { return true; }
    return false;
}

/* ── tests ──────────────────────────────────────────────────── */

fn test_binop_of() -> i32 {
    if binop_of(22) != 0 { return 1; }
    if binop_of(23) != 1 { return 2; }
    if binop_of(24) != 2 { return 3; }
    if binop_of(25) != 3 { return 4; }
    if binop_of(26) != 4 { return 5; }
    if binop_of(27) != 13 { return 6; }
    if binop_of(29) != 14 { return 7; }
    if binop_of(31) != 15 { return 8; }
    if binop_of(42) != 16 { return 9; }
    if binop_of(43) != 17 { return 10; }
    if binop_of(28) != 11 { return 11; }
    if binop_of(30) != 12 { return 12; }
    if binop_of(36) != 5 { return 13; }
    if binop_of(37) != 6 { return 14; }
    if binop_of(38) != 7 { return 15; }
    if binop_of(39) != 8 { return 16; }
    if binop_of(40) != 9 { return 17; }
    if binop_of(41) != 10 { return 18; }
    if binop_of(0) != 0 - 1 { return 19; }
    if has_binop(22) != true { return 20; }
    if has_binop(0) != false { return 21; }
    return 0;
}

fn test_assign_binop() -> i32 {
    if assign_binop(44) != 0 { return 1; }
    if assign_binop(45) != 1 { return 2; }
    if assign_binop(46) != 2 { return 3; }
    if assign_binop(47) != 3 { return 4; }
    if assign_binop(48) != 4 { return 5; }
    if assign_binop(49) != 13 { return 6; }
    if assign_binop(50) != 14 { return 7; }
    if assign_binop(51) != 15 { return 8; }
    if assign_binop(52) != 16 { return 9; }
    if assign_binop(53) != 17 { return 10; }
    if assign_binop(0) != 0 - 1 { return 11; }
    if has_assign_binop(44) != true { return 12; }
    if has_assign_binop(0) != false { return 13; }
    if is_compound_assign(44) != true { return 14; }
    if is_compound_assign(53) != true { return 15; }
    if is_compound_assign(22) != false { return 16; }
    return 0;
}

fn test_lit_from_tok() -> i32 {
    if lit_from_tok(0) != 0 { return 1; }
    if lit_from_tok(1) != 1 { return 2; }
    if lit_from_tok(2) != 3 { return 3; }
    if lit_from_tok(3) != 4 { return 4; }
    if lit_from_tok(91) != 5 { return 5; }
    if lit_from_tok(64) != 5 { return 6; }
    if lit_from_tok(5) != 0 - 1 { return 7; }
    if is_literal_tok(0) != true { return 8; }
    if is_literal_tok(5) != false { return 9; }
    return 0;
}

fn test_expr_span() -> i32 {
    if expr_has_span(0) != true { return 1; }
    if expr_has_span(27) != true { return 2; }
    if expr_has_span(28) != false { return 3; }
    if expr_has_span(0 - 1) != false { return 4; }
    return 0;
}

fn test_skip_helpers() -> i32 {
    if is_pub_token(82) != true { return 1; }
    if is_pub_token(0) != false { return 2; }
    if is_unsafe_token(93) != true { return 3; }
    if is_where_token(95) != true { return 4; }
    if is_hash_token(21) != true { return 5; }
    if is_lt_token(38) != true { return 6; }
    if is_gt_token(39) != true { return 7; }
    if generic_params_update_depth(38, 1) != 2 { return 8; }
    if generic_params_update_depth(39, 2) != 1 { return 9; }
    if generic_params_update_depth(0, 1) != 1 { return 10; }
    if generic_params_done(0) != true { return 11; }
    if generic_params_done(1) != false { return 12; }
    if where_clause_stop(8) != true { return 13; }
    if where_clause_stop(65) != true { return 14; }
    if where_clause_stop(13) != true { return 15; }
    if where_clause_stop(97) != true { return 16; }
    if where_clause_stop(0) != false { return 17; }
    return 0;
}

fn test_span_merge() -> i32 {
    if span_min(3, 5) != 3 { return 1; }
    if span_min(5, 3) != 3 { return 2; }
    if span_max(3, 5) != 5 { return 3; }
    if span_max(5, 3) != 5 { return 4; }
    if span_merge_start(10, 5) != 5 { return 5; }
    if span_merge_end(10, 20) != 20 { return 6; }
    return 0;
}

fn test_precedence() -> i32 {
    if is_cmp_token(36) != true { return 1; }
    if is_cmp_token(41) != true { return 2; }
    if is_cmp_token(22) != false { return 3; }
    if is_additive_token(22) != true { return 4; }
    if is_additive_token(23) != true { return 5; }
    if is_additive_token(24) != false { return 6; }
    if is_multiplicative_token(24) != true { return 7; }
    if is_multiplicative_token(25) != true { return 8; }
    if is_multiplicative_token(26) != true { return 9; }
    if is_multiplicative_token(22) != false { return 10; }
    if is_shift_token(42) != true { return 11; }
    if is_shift_token(43) != true { return 12; }
    if is_shift_token(22) != false { return 13; }
    if is_unary_prefix(23) != true { return 14; }
    if is_unary_prefix(33) != true { return 15; }
    if is_unary_prefix(27) != true { return 16; }
    if is_unary_prefix(0) != false { return 17; }
    return 0;
}

fn test_ty_name() -> i32 {
    if ty_is_name(0) != true { return 1; }
    if ty_is_name(1) != false { return 2; }
    return 0;
}

fn test_pratt_prec() -> i32 {
    if prec_of_binop(12) != 1 { return 1; }
    if prec_of_binop(11) != 2 { return 2; }
    if prec_of_binop(5) != 3 { return 3; }
    if prec_of_binop(10) != 3 { return 4; }
    if prec_of_binop(0) != 8 { return 5; }
    if prec_of_binop(2) != 9 { return 6; }
    if prec_of_binop(16) != 7 { return 7; }
    if is_right_assoc(0) != false { return 8; }
    if next_prec(3, false) != 4 { return 9; }
    if next_prec(3, true) != 3 { return 10; }
    if binop_is_comparison(5) != true { return 11; }
    if binop_is_comparison(0) != false { return 12; }
    if binop_is_arithmetic(0) != true { return 13; }
    if binop_is_arithmetic(2) != true { return 14; }
    if binop_is_arithmetic(5) != false { return 15; }
    if binop_is_logical(11) != true { return 16; }
    if binop_is_logical(12) != true { return 17; }
    if binop_is_logical(0) != false { return 18; }
    return 0;
}

fn test_attr_bracket() -> i32 {
    if attr_bracket_update(10, 0) != 1 { return 1; }
    if attr_bracket_update(11, 2) != 1 { return 2; }
    if attr_bracket_update(5, 1) != 1 { return 3; }
    return 0;
}

fn test_ps_nav() -> i32 {
    let tags: Vec<i32> = vec_new();
    vec_push(tags, 5);
    vec_push(tags, 22);
    vec_push(tags, 5);
    vec_push(tags, 97);
    if ps_peek(tags, 0) != 5 { return 1; }
    if ps_peek(tags, 1) != 22 { return 2; }
    if ps_peek(tags, 3) != 97 { return 3; }
    if ps_peek(tags, 10) != 97 { return 4; }
    if ps_at_end(tags, 3) != true { return 5; }
    if ps_at_end(tags, 0) != false { return 6; }
    if ps_advance(0) != 1 { return 7; }
    if ps_expect(tags, 0, 5) != 1 { return 8; }
    if ps_expect(tags, 0, 22) != 0 - 1 { return 9; }
    if ps_match(tags, 0, 5) != 1 { return 10; }
    if ps_match(tags, 0, 22) != 0 { return 11; }
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0);
    vec_push(starts, 3);
    vec_push(ends, 3);
    vec_push(ends, 4);
    if ps_start(starts, 0) != 0 { return 12; }
    if ps_end(ends, 0) != 3 { return 13; }
    let src: string = "foo+bar";
    let txt: string = ps_tok_text(src, starts, ends, 0);
    if string_len(txt) != 3 { return 14; }
    return 0;
}

fn test_parse_path() -> i32 {
    let tags: Vec<i32> = vec_new();
    vec_push(tags, 5);
    vec_push(tags, 15);
    vec_push(tags, 5);
    vec_push(tags, 15);
    vec_push(tags, 5);
    vec_push(tags, 22);
    vec_push(tags, 97);
    let path: Vec<i32> = vec_new();
    let end_pos: i32 = parse_path(tags, 0, path);
    if vec_len(path) != 3 { return 1; }
    if vec_get(path, 0) != 0 { return 2; }
    if vec_get(path, 1) != 2 { return 3; }
    if vec_get(path, 2) != 4 { return 4; }
    if end_pos != 5 { return 5; }
    let path2: Vec<i32> = vec_new();
    let end2: i32 = parse_path(tags, 0, path2);
    if vec_len(path2) != 3 { return 6; }
    let single: Vec<i32> = vec_new();
    let tags2: Vec<i32> = vec_new();
    vec_push(tags2, 5);
    vec_push(tags2, 22);
    vec_push(tags2, 97);
    let end3: i32 = parse_path(tags2, 0, single);
    if vec_len(single) != 1 { return 7; }
    if end3 != 1 { return 8; }
    let empty: Vec<i32> = vec_new();
    let fail: i32 = parse_path(tags2, 1, empty);
    if fail != 0 - 1 { return 9; }
    return 0;
}

fn test_ps_skip() -> i32 {
    let tags: Vec<i32> = vec_new();
    vec_push(tags, 82);
    vec_push(tags, 65);
    vec_push(tags, 97);
    if ps_skip_optional_pub(tags, 0) != 1 { return 1; }
    if ps_skip_optional_pub(tags, 1) != 1 { return 2; }
    let tags2: Vec<i32> = vec_new();
    vec_push(tags2, 82);
    vec_push(tags2, 6);
    vec_push(tags2, 81);
    vec_push(tags2, 7);
    vec_push(tags2, 65);
    vec_push(tags2, 97);
    if ps_skip_optional_pub(tags2, 0) != 4 { return 3; }
    let tags3: Vec<i32> = vec_new();
    vec_push(tags3, 93);
    vec_push(tags3, 65);
    vec_push(tags3, 97);
    if ps_skip_optional_unsafe(tags3, 0) != 1 { return 4; }
    if ps_skip_optional_unsafe(tags3, 1) != 1 { return 5; }
    let tags4: Vec<i32> = vec_new();
    vec_push(tags4, 38);
    vec_push(tags4, 5);
    vec_push(tags4, 12);
    vec_push(tags4, 5);
    vec_push(tags4, 39);
    vec_push(tags4, 8);
    vec_push(tags4, 97);
    if ps_skip_generic_params(tags4, 0) != 5 { return 6; }
    if ps_skip_generic_params(tags4, 5) != 5 { return 7; }
    let tags5: Vec<i32> = vec_new();
    vec_push(tags5, 95);
    vec_push(tags5, 5);
    vec_push(tags5, 14);
    vec_push(tags5, 5);
    vec_push(tags5, 8);
    vec_push(tags5, 97);
    if ps_skip_where_clause(tags5, 0) != 4 { return 8; }
    if ps_skip_where_clause(tags5, 4) != 4 { return 9; }
    let tags6: Vec<i32> = vec_new();
    vec_push(tags6, 21);
    vec_push(tags6, 10);
    vec_push(tags6, 5);
    vec_push(tags6, 11);
    vec_push(tags6, 65);
    vec_push(tags6, 97);
    if ps_skip_attributes(tags6, 0) != 4 { return 10; }
    if ps_skip_attributes(tags6, 4) != 4 { return 11; }
    return 0;
}

fn main() -> i32 {
    let r1: i32 = test_binop_of();
    if r1 != 0 { return r1; }
    let r2: i32 = test_assign_binop();
    if r2 != 0 { return 30 + r2; }
    let r3: i32 = test_lit_from_tok();
    if r3 != 0 { return 50 + r3; }
    let r4: i32 = test_expr_span();
    if r4 != 0 { return 60 + r4; }
    let r5: i32 = test_skip_helpers();
    if r5 != 0 { return 70 + r5; }
    let r6: i32 = test_span_merge();
    if r6 != 0 { return 90 + r6; }
    let r7: i32 = test_precedence();
    if r7 != 0 { return 100 + r7; }
    let r8: i32 = test_ty_name();
    if r8 != 0 { return 120 + r8; }
    let r9: i32 = test_attr_bracket();
    if r9 != 0 { return 130 + r9; }
    let r10: i32 = test_pratt_prec();
    if r10 != 0 { return 140 + r10; }
    let r11: i32 = test_ps_nav();
    if r11 != 0 { return 160 + r11; }
    let r12: i32 = test_parse_path();
    if r12 != 0 { return 180 + r12; }
    let r13: i32 = test_ps_skip();
    if r13 != 0 { return 200 + r13; }
    return 0;
}
