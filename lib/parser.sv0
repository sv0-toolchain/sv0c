fn test_parse_block_let() -> i32 {
    let tags: Vec<i32> = vec_new();
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(tags, 8); vec_push(starts, 0); vec_push(ends, 1);
    vec_push(tags, 71); vec_push(starts, 1); vec_push(ends, 4);
    vec_push(tags, 5); vec_push(starts, 5); vec_push(ends, 6);
    vec_push(tags, 14); vec_push(starts, 6); vec_push(ends, 7);
    vec_push(tags, 5); vec_push(starts, 8); vec_push(ends, 11);
    vec_push(tags, 35); vec_push(starts, 12); vec_push(ends, 13);
    vec_push(tags, 0); vec_push(starts, 14); vec_push(ends, 15);
    vec_push(tags, 13); vec_push(starts, 15); vec_push(ends, 16);
    vec_push(tags, 5); vec_push(starts, 17); vec_push(ends, 18);
    vec_push(tags, 9); vec_push(starts, 18); vec_push(ends, 19);
    vec_push(tags, 97); vec_push(starts, 19); vec_push(ends, 19);
    let et: Vec<i32> = vec_new();
    let ed1v: Vec<i32> = vec_new();
    let ed2v: Vec<i32> = vec_new();
    let ed3v: Vec<i32> = vec_new();
    let ed4v: Vec<i32> = vec_new();
    let pp: Vec<i32> = vec_new();
    let p: i32 = parse_expr(tags, starts, ends, "{ let x: i32 = 1; x }", 0,
                             et, ed1v, ed2v, ed3v, ed4v, pp, 1);
    if p != 10 { return 1; }
    if vec_get(et, 0) != 0 { return 2; }
    if vec_get(et, 1) != 27 { return 3; }
    if vec_get(ed1v, 1) != 2 { return 4; }
    /* LetStmt d2 now holds the annotation type-head token (was a bare 0 flag): for
       `let x: i32`, the `:` is token 3, so the type head `i32` is token 4. */
    if vec_get(ed2v, 1) != 4 { return 5; }
    if vec_get(ed3v, 1) != 0 { return 6; }
    if vec_get(ed4v, 1) != 0 { return 7; }
    if vec_get(et, 2) != 1 { return 8; }
    if vec_get(et, 3) != 9 { return 9; }
    if vec_get(ed2v, 3) != 1 { return 10; }
    if vec_get(ed3v, 3) != 2 { return 11; }
    return 0;
}

