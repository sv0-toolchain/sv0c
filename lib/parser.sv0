        let t: i32 = ps_peek(tags, p);
        if t != 29 {
            done = true;
        } else {
            let bop: i32 = binop_of(t);
            let pa: i32 = parse_bit_xor_expr(tags, starts, ends, source, p + 1,
                                              et, ed1, ed2, ed3, ed4, pp, sf_names,
                                              ty_tags, ty_d1, ty_d2, ty_d3,
                                              allow_struct);
