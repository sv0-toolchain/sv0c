fn test_pratt_prec() -> i32 {
    if prec_of_binop(12) != 1 { return 1; }
    if prec_of_binop(11) != 2 { return 2; }
    if prec_of_binop(5) != 3 { return 3; }
    if prec_of_binop(10) != 3 { return 4; }
    if prec_of_binop(0) != 8 { return 5; }
    if prec_of_binop(2) != 9 { return 6; }
    if prec_of_binop(16) != 7 { return 7; }
    if is_right_assoc(0) != false { return 8; }
    if next_prec(3, false) != 4 { return 9; }
    if next_prec(3, true) != 3 { return 10; }
    if binop_is_comparison(5) != true { return 11; }
    if binop_is_comparison(0) != false { return 12; }
    if binop_is_arithmetic(0) != true { return 13; }
    if binop_is_arithmetic(2) != true { return 14; }
    if binop_is_arithmetic(5) != false { return 15; }
    if binop_is_logical(11) != true { return 16; }
    if binop_is_logical(12) != true { return 17; }
    if binop_is_logical(0) != false { return 18; }
    return 0;
}

fn test_attr_bracket() -> i32 {
    if attr_bracket_update(10, 0) != 1 { return 1; }
    if attr_bracket_update(11, 2) != 1 { return 2; }
    if attr_bracket_update(5, 1) != 1 { return 3; }
    return 0;
}

