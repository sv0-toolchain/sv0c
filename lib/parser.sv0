/* Phase 2 real pipeline module: sml/parser/parser.sml -> sv0.
   Token stream navigation (peek/advance/expect/match on parallel Vecs
   from lexer tokenize), parsePath, parseGenericParams (extracts type
   param names from <T, U: Bound>), skipOptionalPub/skipOptionalUnsafe/
   skipGenericParams/skipWhereClause/skipAttributes on token stream,
   token→binop/assign-binop/literal mapping, Pratt precedence, span
   merge, parse_use_item (SML parseUseItem — USE path SEMICOLON),
   parse_module_decl (SML parseModuleDecl — MODULE path SEMICOLON),
   is_assign_tok (SML isAssignTok — EQ or compound assign),
   path_of_ty_valid (SML pathOfTy — TyName has path),
   is_builtin_type_name (SML inline check in parseType — 18 primitives),
   parse_type (SML parseType — recursive-descent type parser with
   arena output; handles TyUnit/TyName/TyRef/TyRefMut/TyArray/TySlice/
   TyTuple and generic type arguments),
   path_pattern_from (SML pathPatternFrom — struct/enum pattern after
   path), parse_pat_atom (SML parsePatAtom — wildcard/bind/lit/tuple/
   enum dispatch), parse_pat (SML parsePat — entry point with | for
   PatOr),
   parse_expr (SML parseExpr — full expression parser with precedence
   chain: parse_primary_expr/postfix/unary/cast/mul/add/shift/bit_and/
   bit_xor/bit_or/cmp/and/or/range, struct literal fields, arg list,
   array body, tuples),
   parse_block (SML parseBlock — { stmt* [tail_expr] }),
   try_stmt/parse_let_stmt/try_assign_stmt (block statement dispatch),
   parse_if_expr/parse_while_expr/parse_for_expr/parse_loop_expr/
   parse_return_expr (control-flow expressions),
   expr_ends_with_braced_block (braced block heuristic).
   parse_match_expr (SML parseMatchExpr — match scrutinee { arms }),
   parse_quant (SML parseQuant — forall/exists as ExprCall),
   old/no_alias dispatch (ExprCall encoding),
   loop_invariant parsing in parse_while_expr,
   parse_param/parse_param_list (SML parseParam/parseParamList),
   parse_contract/parse_contracts (SML parseContract/parseContracts),
   parse_fn_body (SML parseFnBody — ItemFn),
   parse_struct_item/parse_enum_item/parse_type_alias_item/
   parse_trait_item/parse_impl_item (SML item parsers),
   parse_item (SML parseItem — top-level dispatcher),
   parse_program (SML val parse — item list until EOF).
   Parser expression/statement/item coverage: complete. */

