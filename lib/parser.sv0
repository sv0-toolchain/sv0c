    if end_pos != 3 { return 1; }
    if vec_len(path) != 1 { return 2; }
    if vec_get(path, 0) != 1 { return 3; }
    let path2: Vec<i32> = vec_new();
    let same: i32 = parse_module_decl(tags, 3, path2);
    if same != 3 { return 4; }
    if vec_len(path2) != 0 { return 5; }
    let tags2: Vec<i32> = vec_new();
    vec_push(tags2, 5);
    vec_push(tags2, 97);
    let path3: Vec<i32> = vec_new();
    let noop: i32 = parse_module_decl(tags2, 0, path3);
    if noop != 0 { return 6; }
    return 0;
}

