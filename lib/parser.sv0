    vec_push(tags, 5); vec_push(starts, 0); vec_push(ends, 3);
    vec_push(tags, 15); vec_push(starts, 3); vec_push(ends, 5);
    vec_push(tags, 5); vec_push(starts, 5); vec_push(ends, 8);
    vec_push(tags, 97); vec_push(starts, 8); vec_push(ends, 8);
    let pt: Vec<i32> = vec_new();
    let pd1: Vec<i32> = vec_new();
    let pd2: Vec<i32> = vec_new();
    let pd3: Vec<i32> = vec_new();
    let pp: Vec<i32> = vec_new();
    let p: i32 = parse_pat(tags, starts, ends, src, 0,
                             pt, pd1, pd2, pd3, pp);
    if p != 3 { return 1; }
    if vec_len(pt) != 1 { return 2; }
    if vec_get(pt, 0) != 5 { return 3; }
    if vec_get(pd3, 0) != 0 { return 4; }
    if vec_len(pp) != 2 { return 5; }
    return 0;
}

fn test_ps_nav() -> i32 {
    let tags: Vec<i32> = vec_new();
    vec_push(tags, 5);
    vec_push(tags, 22);
    vec_push(tags, 5);
    vec_push(tags, 97);
    if ps_peek(tags, 0) != 5 { return 1; }
    if ps_peek(tags, 1) != 22 { return 2; }
    if ps_peek(tags, 3) != 97 { return 3; }
    if ps_peek(tags, 10) != 97 { return 4; }
    if ps_at_end(tags, 3) != true { return 5; }
    if ps_at_end(tags, 0) != false { return 6; }
    if ps_advance(0) != 1 { return 7; }
    if ps_expect(tags, 0, 5) != 1 { return 8; }
    if ps_expect(tags, 0, 22) != 0 - 1 { return 9; }
    if ps_match(tags, 0, 5) != 1 { return 10; }
    if ps_match(tags, 0, 22) != 0 { return 11; }
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0);
    vec_push(starts, 3);
    vec_push(ends, 3);
    vec_push(ends, 4);
    if ps_start(starts, 0) != 0 { return 12; }
    if ps_end(ends, 0) != 3 { return 13; }
    let src: string = "foo+bar";
    let txt: string = ps_tok_text(src, starts, ends, 0);
    if string_len(txt) != 3 { return 14; }
    return 0;
}

fn test_parse_path() -> i32 {
    let tags: Vec<i32> = vec_new();
    vec_push(tags, 5);
    vec_push(tags, 15);
    vec_push(tags, 5);
    vec_push(tags, 15);
    vec_push(tags, 5);
    vec_push(tags, 22);
    vec_push(tags, 97);
    let path: Vec<i32> = vec_new();
    let end_pos: i32 = parse_path(tags, 0, path);
    if vec_len(path) != 3 { return 1; }
    if vec_get(path, 0) != 0 { return 2; }
    if vec_get(path, 1) != 2 { return 3; }
    if vec_get(path, 2) != 4 { return 4; }
    if end_pos != 5 { return 5; }
    let path2: Vec<i32> = vec_new();
    let end2: i32 = parse_path(tags, 0, path2);
    if vec_len(path2) != 3 { return 6; }
    let single: Vec<i32> = vec_new();
    let tags2: Vec<i32> = vec_new();
    vec_push(tags2, 5);
    vec_push(tags2, 22);
    vec_push(tags2, 97);
    let end3: i32 = parse_path(tags2, 0, single);
    if vec_len(single) != 1 { return 7; }
    if end3 != 1 { return 8; }
    let empty: Vec<i32> = vec_new();
    let fail: i32 = parse_path(tags2, 1, empty);
    if fail != 0 - 1 { return 9; }
    return 0;
}

fn test_ps_skip() -> i32 {
    let tags: Vec<i32> = vec_new();
    vec_push(tags, 82);
    vec_push(tags, 65);
    vec_push(tags, 97);
    if ps_skip_optional_pub(tags, 0) != 1 { return 1; }
    if ps_skip_optional_pub(tags, 1) != 1 { return 2; }
    let tags2: Vec<i32> = vec_new();
    vec_push(tags2, 82);
    vec_push(tags2, 6);
    vec_push(tags2, 81);
    vec_push(tags2, 7);
    vec_push(tags2, 65);
    vec_push(tags2, 97);
    if ps_skip_optional_pub(tags2, 0) != 4 { return 3; }
    let tags3: Vec<i32> = vec_new();
    vec_push(tags3, 93);
    vec_push(tags3, 65);
    vec_push(tags3, 97);
    if ps_skip_optional_unsafe(tags3, 0) != 1 { return 4; }
    if ps_skip_optional_unsafe(tags3, 1) != 1 { return 5; }
    let tags4: Vec<i32> = vec_new();
    vec_push(tags4, 38);
    vec_push(tags4, 5);
    vec_push(tags4, 12);
    vec_push(tags4, 5);
    vec_push(tags4, 39);
    vec_push(tags4, 8);
    vec_push(tags4, 97);
    if ps_skip_generic_params(tags4, 0) != 5 { return 6; }
    if ps_skip_generic_params(tags4, 5) != 5 { return 7; }
    let tags5: Vec<i32> = vec_new();
    vec_push(tags5, 95);
    vec_push(tags5, 5);
    vec_push(tags5, 14);
    vec_push(tags5, 5);
    vec_push(tags5, 8);
    vec_push(tags5, 97);
    if ps_skip_where_clause(tags5, 0) != 4 { return 8; }
    if ps_skip_where_clause(tags5, 4) != 4 { return 9; }
    let tags6: Vec<i32> = vec_new();
    vec_push(tags6, 21);
    vec_push(tags6, 10);
    vec_push(tags6, 5);
    vec_push(tags6, 11);
    vec_push(tags6, 65);
    vec_push(tags6, 97);
    if ps_skip_attributes(tags6, 0) != 4 { return 10; }
    if ps_skip_attributes(tags6, 4) != 4 { return 11; }
    return 0;
}

fn test_parse_generic_params() -> i32 {
    let tags: Vec<i32> = vec_new();
    vec_push(tags, 38);
    vec_push(tags, 5);
    vec_push(tags, 12);
    vec_push(tags, 5);
    vec_push(tags, 12);
    vec_push(tags, 5);
    vec_push(tags, 39);
    vec_push(tags, 8);
    vec_push(tags, 97);
    let names: Vec<i32> = vec_new();
    let end_pos: i32 = parse_generic_params(tags, 0, names);
    if vec_len(names) != 3 { return 1; }
    if vec_get(names, 0) != 1 { return 2; }
    if vec_get(names, 1) != 3 { return 3; }
    if vec_get(names, 2) != 5 { return 4; }
    if end_pos != 7 { return 5; }
    let names2: Vec<i32> = vec_new();
    let no_gen: i32 = parse_generic_params(tags, 7, names2);
    if vec_len(names2) != 0 { return 6; }
    if no_gen != 7 { return 7; }
    let tags2: Vec<i32> = vec_new();
    vec_push(tags2, 38);
    vec_push(tags2, 5);
    vec_push(tags2, 14);
    vec_push(tags2, 5);
    vec_push(tags2, 39);
    vec_push(tags2, 97);
    let bounded: Vec<i32> = vec_new();
    let end2: i32 = parse_generic_params(tags2, 0, bounded);
    if vec_len(bounded) != 1 { return 8; }
    if vec_get(bounded, 0) != 1 { return 9; }
    if end2 != 5 { return 10; }
    return 0;
}

fn test_parse_use_item() -> i32 {
    let tags: Vec<i32> = vec_new();
    vec_push(tags, 94);
    vec_push(tags, 5);
    vec_push(tags, 15);
    vec_push(tags, 5);
    vec_push(tags, 13);
    vec_push(tags, 97);
    let path: Vec<i32> = vec_new();
