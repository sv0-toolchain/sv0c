fn main() -> i32 {
    let r0: i32 = test_item_fn_id2_pack_roundtrip();
    if r0 != 0 { return 2000 + r0; }
    let r1: i32 = test_binop_of();
    if r1 != 0 { return r1; }
    let r2: i32 = test_assign_binop();
    if r2 != 0 { return 30 + r2; }
