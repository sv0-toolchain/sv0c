    if end_pos != 5 { return 1; }
    if vec_len(path) != 2 { return 2; }
    if vec_get(path, 0) != 1 { return 3; }
    if vec_get(path, 1) != 3 { return 4; }
    let path2: Vec<i32> = vec_new();
    let fail: i32 = parse_use_item(tags, 1, path2);
    if fail != 0 - 1 { return 5; }
    let tags2: Vec<i32> = vec_new();
    vec_push(tags2, 94);
    vec_push(tags2, 5);
    vec_push(tags2, 97);
    let path3: Vec<i32> = vec_new();
    let fail2: i32 = parse_use_item(tags2, 0, path3);
    if fail2 != 0 - 1 { return 6; }
    return 0;
}

