fn parse_cmp_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                  source: string, pos: i32,
                  et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                  ed3: Vec<i32>, ed4: Vec<i32>,
                  pp: Vec<i32>, sf_names: Vec<i32>,
                  ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                  ty_d2: Vec<i32>, ty_d3: Vec<i32>,
                  allow_struct: i32) -> i32 {
    let p1: i32 = parse_bit_or_expr(tags, starts, ends, source, pos,
                                     et, ed1, ed2, ed3, ed4, pp, sf_names,
                                     ty_tags, ty_d1, ty_d2, ty_d3, allow_struct);
    if p1 < 0 { return 0 - 1; }
    let t: i32 = ps_peek(tags, p1);
    if is_cmp_token(t) == true {
        let bop: i32 = binop_of(t);
        let left: i32 = vec_len(et) - 1;
        let pa: i32 = parse_bit_or_expr(tags, starts, ends, source, p1 + 1,
                                         et, ed1, ed2, ed3, ed4, pp, sf_names,
                                         ty_tags, ty_d1, ty_d2, ty_d3,
                                         allow_struct);
        if pa < 0 { return 0 - 1; }
        let ri: i32 = vec_len(et) - 1;
        vec_push(et, 3);
        vec_push(ed1, bop);
        vec_push(ed2, left);
        vec_push(ed3, ri);
        vec_push(ed4, 0);
        return pa;
    }
    return p1;
}

fn parse_and_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                  source: string, pos: i32,
                  et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                  ed3: Vec<i32>, ed4: Vec<i32>,
                  pp: Vec<i32>, sf_names: Vec<i32>,
                  ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                  ty_d2: Vec<i32>, ty_d3: Vec<i32>,
                  allow_struct: i32) -> i32 {
    let p1: i32 = parse_cmp_expr(tags, starts, ends, source, pos,
                                  et, ed1, ed2, ed3, ed4, pp, sf_names,
                                  ty_tags, ty_d1, ty_d2, ty_d3, allow_struct);
    if p1 < 0 { return 0 - 1; }
    let mut left: i32 = vec_len(et) - 1;
    let mut p: i32 = p1;
    let mut done: bool = false;
    while done != true {
        let t: i32 = ps_peek(tags, p);
        if t != 28 {
            done = true;
        } else {
            let pa: i32 = parse_cmp_expr(tags, starts, ends, source, p + 1,
                                          et, ed1, ed2, ed3, ed4, pp, sf_names,
                                          ty_tags, ty_d1, ty_d2, ty_d3,
                                          allow_struct);
            if pa < 0 { return 0 - 1; }
            let ri: i32 = vec_len(et) - 1;
            vec_push(et, 3);
            /* AST_AND = 11 (ast.sv0). This dedicated `&&` parser previously pushed
               10 (AST_GEQ), so lower/emit saw `&&` as `>=`. */
            vec_push(ed1, 11);
            vec_push(ed2, left);
            vec_push(ed3, ri);
            vec_push(ed4, 0);
            left = vec_len(et) - 1;
            p = pa;
        }
    }
    return p;
}

fn parse_or_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                 source: string, pos: i32,
                 et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                 ed3: Vec<i32>, ed4: Vec<i32>,
                 pp: Vec<i32>, sf_names: Vec<i32>,
                 ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                 ty_d2: Vec<i32>, ty_d3: Vec<i32>,
                 allow_struct: i32) -> i32 {
    let p1: i32 = parse_and_expr(tags, starts, ends, source, pos,
                                  et, ed1, ed2, ed3, ed4, pp, sf_names,
                                  ty_tags, ty_d1, ty_d2, ty_d3, allow_struct);
    if p1 < 0 { return 0 - 1; }
    let mut left: i32 = vec_len(et) - 1;
    let mut p: i32 = p1;
    let mut done: bool = false;
    while done != true {
        let t: i32 = ps_peek(tags, p);
        if t != 30 {
            done = true;
        } else {
            let pa: i32 = parse_and_expr(tags, starts, ends, source, p + 1,
                                          et, ed1, ed2, ed3, ed4, pp, sf_names,
                                          ty_tags, ty_d1, ty_d2, ty_d3,
                                          allow_struct);
            if pa < 0 { return 0 - 1; }
            let ri: i32 = vec_len(et) - 1;
            vec_push(et, 3);
            /* AST_OR = 12 (ast.sv0). This dedicated `||` parser previously pushed
               11 (AST_AND), so lower/emit saw `||` as `&&`. */
            vec_push(ed1, 12);
            vec_push(ed2, left);
            vec_push(ed3, ri);
            vec_push(ed4, 0);
            left = vec_len(et) - 1;
            p = pa;
        }
    }
    return p;
}

fn parse_range_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                    source: string, pos: i32,
                    et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                    ed3: Vec<i32>, ed4: Vec<i32>,
                    pp: Vec<i32>, sf_names: Vec<i32>,
                    ty_tags: Vec<i32>, ty_d1: Vec<i32>,
                    ty_d2: Vec<i32>, ty_d3: Vec<i32>,
                    allow_struct: i32) -> i32 {
    let p1: i32 = parse_or_expr(tags, starts, ends, source, pos,
                                 et, ed1, ed2, ed3, ed4, pp, sf_names,
                                 ty_tags, ty_d1, ty_d2, ty_d3, allow_struct);
    if p1 < 0 { return 0 - 1; }
    let t: i32 = ps_peek(tags, p1);
    if t == 17 {
        let left_idx: i32 = vec_len(et) - 1;
        let pa: i32 = parse_or_expr(tags, starts, ends, source, p1 + 1,
                                     et, ed1, ed2, ed3, ed4, pp, sf_names,
                                     ty_tags, ty_d1, ty_d2, ty_d3, allow_struct);
        if pa < 0 { return 0 - 1; }
        let ri: i32 = vec_len(et) - 1;
        vec_push(et, 21);
        vec_push(ed1, left_idx);
        vec_push(ed2, ri);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        return pa;
    }
    return p1;
}

/* parse_expr with an explicit struct-literal field-name pool. Body expressions
   must thread the function's body_sf so ExprStruct field names land in the pool
   lowering reads (lit_sf_names); a local pool would be discarded and lower would
   read it out of bounds. The plain parse_expr keeps its old signature (used by
   conditions and unit tests, where struct literals are absent) and delegates here
   with a throwaway pool. */
fn parse_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
              source: string, pos: i32,
              et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
              ed3: Vec<i32>, ed4: Vec<i32>,
              pp: Vec<i32>, allow_struct: i32) -> i32 {
    let sf: Vec<i32> = vec_new();
    return parse_expr_sf(tags, starts, ends, source, pos,
                         et, ed1, ed2, ed3, ed4, pp, sf, allow_struct);
}

fn parse_expr_sf(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                 source: string, pos: i32,
                 et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                 ed3: Vec<i32>, ed4: Vec<i32>,
                 pp: Vec<i32>, sf_names: Vec<i32>, allow_struct: i32) -> i32 {
    let tt: Vec<i32> = vec_new();
    let td1: Vec<i32> = vec_new();
    let td2: Vec<i32> = vec_new();
    let td3: Vec<i32> = vec_new();
    return parse_range_expr(tags, starts, ends, source, pos,
                             et, ed1, ed2, ed3, ed4, pp, sf_names,
                             tt, td1, td2, td3, allow_struct);
}

/* ── control-flow expressions + block / stmt machinery ───────
   SML: parseIfExpr, parseMatchExpr, parseWhileExpr, parseForExpr,
        parseLoopExpr, parseReturnExpr, parseBlock, tryStmt,
        parseLetStmt, tryAssignStmt, exprEndsWithBracedBlock.
   Stmts are encoded in the expr arena as LetStmt(27) / SemiStmt(28).
   Control-flow functions create local type/sf arenas when they need
   to call parse_range_expr (conditions) or parse_type (let stmts). */

fn expr_ends_with_braced_block(et: Vec<i32>, idx: i32) -> i32 {
    let tag: i32 = vec_get(et, idx);
    if tag == 9 { return 1; }
    if tag == 10 { return 1; }
    if tag == 11 { return 1; }
    if tag == 12 { return 1; }
    if tag == 13 { return 1; }
    if tag == 14 { return 1; }
    return 0;
}

fn parse_return_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                     source: string, pos: i32,
                     et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                     ed3: Vec<i32>, ed4: Vec<i32>,
                     pp: Vec<i32>, sf_names: Vec<i32>) -> i32 {
    let t: i32 = ps_peek(tags, pos);
    if t == 13 {
        vec_push(et, 15);
        vec_push(ed1, 0 - 1);
        vec_push(ed2, 0);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        return pos;
    }
    if t == 9 {
        vec_push(et, 15);
        vec_push(ed1, 0 - 1);
        vec_push(ed2, 0);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        return pos;
    }
    let tt: Vec<i32> = vec_new();
    let td1: Vec<i32> = vec_new();
    let td2: Vec<i32> = vec_new();
    let td3: Vec<i32> = vec_new();
    /* Thread the real struct-literal field-name pool (sf_names), not a throwaway:
       a `return P { ... }` records field-name offsets that lowering reads back, so
       a discarded pool leaves them dangling -> vec OOB in the struct-lit lowering. */
    let p1: i32 = parse_range_expr(tags, starts, ends, source, pos,
                                    et, ed1, ed2, ed3, ed4, pp, sf_names,
                                    tt, td1, td2, td3, 1);
    if p1 < 0 { return 0 - 1; }
    let vi: i32 = vec_len(et) - 1;
    vec_push(et, 15);
    vec_push(ed1, vi);
    vec_push(ed2, 0);
    vec_push(ed3, 0);
    vec_push(ed4, 0);
    return p1;
}

fn parse_let_stmt(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                  source: string, pos: i32,
                  et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                  ed3: Vec<i32>, ed4: Vec<i32>,
                  pp: Vec<i32>, sf_names: Vec<i32>) -> i32 {
    let mut is_mut: i32 = 0;
    let mut p: i32 = pos;
    if ps_peek(tags, p) == 77 {
        is_mut = 1;
        p = p + 1;
    }
    let pt: Vec<i32> = vec_new();
    let pd1v: Vec<i32> = vec_new();
    let pd2v: Vec<i32> = vec_new();
    let pd3v: Vec<i32> = vec_new();
    let p2: i32 = parse_pat(tags, starts, ends, source, p,
                             pt, pd1v, pd2v, pd3v, pp);
    if p2 < 0 { return 0 - 1; }
    let name_tok: i32 = vec_get(pd1v, 0);
    let mut type_flag: i32 = 0 - 1;
    let mut p3: i32 = p2;
    if ps_peek(tags, p3) == 14 {
        let tytt: Vec<i32> = vec_new();
        let tyd1: Vec<i32> = vec_new();
        let tyd2: Vec<i32> = vec_new();
        let tyd3: Vec<i32> = vec_new();
        let pt2: i32 = parse_type(tags, starts, ends, source, p3 + 1,
                                   tytt, tyd1, tyd2, tyd3, pp);
        if pt2 < 0 { return 0 - 1; }
        /* Retain the annotation's type-head token (the token right after `:`) in
           LetStmt d2 (was a bare 0/-1 present flag, unread by consumers) so the
           lowering can recover the declared type — e.g. `let x: Value = box_deref(..)`
           needs the element type Value to type the deref. -1 still means no annotation. */
        type_flag = p3 + 1;
        p3 = pt2;
    }
    let mut init_idx: i32 = 0 - 1;
    let mut p4: i32 = p3;
    if ps_peek(tags, p4) == 35 {
        let pi: i32 = parse_expr_sf(tags, starts, ends, source, p4 + 1,
                                  et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
        if pi < 0 { return 0 - 1; }
        init_idx = vec_len(et) - 1;
        p4 = pi;
    }
    if ps_peek(tags, p4) != 13 { return 0 - 1; }
    vec_push(et, 27);
    vec_push(ed1, name_tok);
    vec_push(ed2, type_flag);
    vec_push(ed3, init_idx);
    vec_push(ed4, is_mut);
    return p4 + 1;
}

fn parse_assign_target_op_pos(tags: Vec<i32>, pos: i32, out: Vec<i32>) -> i32 {
    if ps_peek(tags, pos) != 5 { return 0 - 2; }
    let mut field_tok: i32 = 0 - 1;
    let mut op_pos: i32 = pos + 1;
    if ps_peek(tags, pos + 1) == 15 {
        if ps_peek(tags, pos + 2) != 5 { return 0 - 2; }
        field_tok = pos + 2;
        op_pos = pos + 3;
    }
    vec_push(out, field_tok);
    vec_push(out, op_pos);
    return op_pos;
}

fn try_assign_stmt(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                   source: string, pos: i32,
                   et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                   ed3: Vec<i32>, ed4: Vec<i32>,
                   pp: Vec<i32>, sf_names: Vec<i32>) -> i32 {
    let tmp: Vec<i32> = vec_new();
    let op_pos: i32 = parse_assign_target_op_pos(tags, pos, tmp);
    if op_pos < 0 { return op_pos; }
    let lhs_field_tok: i32 = vec_get(tmp, 0);
    let rhs_pos: i32 = op_pos + 1;
    let nt: i32 = ps_peek(tags, op_pos);
    if nt == 35 {
        let pps: i32 = vec_len(pp);
        vec_push(pp, pos);
        vec_push(et, 1);
        vec_push(ed1, pps);
        vec_push(ed2, 1);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        let mut lhs_idx: i32 = vec_len(et) - 1;
        if lhs_field_tok >= 0 {
            vec_push(et, 6);
            vec_push(ed1, lhs_idx);
            vec_push(ed2, lhs_field_tok);
            vec_push(ed3, 0);
            vec_push(ed4, 0);
            lhs_idx = vec_len(et) - 1;
        }
        let pe: i32 = parse_expr_sf(tags, starts, ends, source, rhs_pos,
                                  et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
        if pe < 0 { return 0 - 1; }
        let rhs_idx: i32 = vec_len(et) - 1;
        if ps_peek(tags, pe) != 13 { return 0 - 1; }
        vec_push(et, 18);
        vec_push(ed1, lhs_idx);
        vec_push(ed2, rhs_idx);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        let ai: i32 = vec_len(et) - 1;
        vec_push(et, 28);
        vec_push(ed1, ai);
        vec_push(ed2, 0);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        return pe + 1;
    }
    if has_assign_binop(nt) == true {
        let bop: i32 = assign_binop(nt);
        let pps: i32 = vec_len(pp);
        vec_push(pp, pos);
        vec_push(et, 1);
        vec_push(ed1, pps);
        vec_push(ed2, 1);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        let mut lhs_idx: i32 = vec_len(et) - 1;
        if lhs_field_tok >= 0 {
            vec_push(et, 6);
            vec_push(ed1, lhs_idx);
            vec_push(ed2, lhs_field_tok);
            vec_push(ed3, 0);
            vec_push(ed4, 0);
            lhs_idx = vec_len(et) - 1;
        }
        let pe: i32 = parse_expr_sf(tags, starts, ends, source, rhs_pos,
                                  et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
        if pe < 0 { return 0 - 1; }
        let rhs_idx: i32 = vec_len(et) - 1;
        if ps_peek(tags, pe) != 13 { return 0 - 1; }
        vec_push(et, 19);
        vec_push(ed1, bop);
        vec_push(ed2, lhs_idx);
        vec_push(ed3, rhs_idx);
        vec_push(ed4, 0);
        let ai: i32 = vec_len(et) - 1;
        vec_push(et, 28);
        vec_push(ed1, ai);
        vec_push(ed2, 0);
        vec_push(ed3, 0);
        vec_push(ed4, 0);
        return pe + 1;
    }
    return 0 - 2;
}

fn try_stmt(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
            source: string, pos: i32,
            et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
            ed3: Vec<i32>, ed4: Vec<i32>,
            pp: Vec<i32>, sf_names: Vec<i32>) -> i32 {
    let t: i32 = ps_peek(tags, pos);
    if t == 71 {
        return parse_let_stmt(tags, starts, ends, source, pos + 1,
                              et, ed1, ed2, ed3, ed4, pp, sf_names);
    }
    if t == 57 {
        if ps_peek(tags, pos + 1) == 13 {
            vec_push(et, 16);
            vec_push(ed1, 0 - 1);
            vec_push(ed2, 0);
            vec_push(ed3, 0);
            vec_push(ed4, 0);
            let bi: i32 = vec_len(et) - 1;
            vec_push(et, 28);
            vec_push(ed1, bi);
            vec_push(ed2, 0);
            vec_push(ed3, 0);
            vec_push(ed4, 0);
            return pos + 2;
        }
        let pe: i32 = parse_expr_sf(tags, starts, ends, source, pos + 1,
                                  et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
        if pe >= 0 {
            if ps_peek(tags, pe) == 13 {
                let vi: i32 = vec_len(et) - 1;
                vec_push(et, 16);
                vec_push(ed1, vi);
                vec_push(ed2, 0);
                vec_push(ed3, 0);
                vec_push(ed4, 0);
                let bi: i32 = vec_len(et) - 1;
                vec_push(et, 28);
                vec_push(ed1, bi);
                vec_push(ed2, 0);
                vec_push(ed3, 0);
                vec_push(ed4, 0);
                return pe + 1;
            }
        }
        return 0 - 2;
    }
    if t == 59 {
        if ps_peek(tags, pos + 1) == 13 {
            vec_push(et, 17);
            vec_push(ed1, 0);
            vec_push(ed2, 0);
            vec_push(ed3, 0);
            vec_push(ed4, 0);
            let ci: i32 = vec_len(et) - 1;
            vec_push(et, 28);
            vec_push(ed1, ci);
            vec_push(ed2, 0);
            vec_push(ed3, 0);
            vec_push(ed4, 0);
            return pos + 2;
        }
        return 0 - 2;
    }
    if t == 55 {
        let pe: i32 = parse_expr_sf(tags, starts, ends, source, pos + 1,
                                  et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
        if pe >= 0 {
            if ps_peek(tags, pe) == 13 {
                let ei: i32 = vec_len(et) - 1;
                vec_push(et, 23);
                vec_push(ed1, ei);
                vec_push(ed2, 0);
                vec_push(ed3, 0);
                vec_push(ed4, 0);
                let ai: i32 = vec_len(et) - 1;
                vec_push(et, 28);
                vec_push(ed1, ai);
                vec_push(ed2, 0);
                vec_push(ed3, 0);
                vec_push(ed4, 0);
                return pe + 1;
            }
        }
        return 0 - 2;
    }
    return try_assign_stmt(tags, starts, ends, source, pos,
                            et, ed1, ed2, ed3, ed4, pp, sf_names);
}

/* Block statement-order sidecar. Statement nodes are pushed to the expr arena
   interleaved with their sub-expressions (each stmt's sub-exprs come first, then
   the stmt node), so statements are NOT at contiguous indices — `stmts_first + si`
   only finds statement 0. To recover the ordered list, parse_block collects each
   statement node's index and stores that list in the shared pp pool (pp is only
   ever read by stored offset, never iterated wholesale). The ExprBlock node's
   otherwise-unused d4 holds `offset + 1` (0 = no sidecar → consumers fall back to
   the legacy stmts_first + si, which is correct for hand-built single-stmt test
   arenas). Consumers resolve statement si via block_stmt_index below. */
fn block_stmt_sidecar_push(pp: Vec<i32>, stmt_ids: Vec<i32>) -> i32 {
    let off: i32 = vec_len(pp);
    let mut k: i32 = 0;
    while k < vec_len(stmt_ids) {
        vec_push(pp, vec_get(stmt_ids, k));
        k = k + 1;
    }
    return off + 1;
}

fn parse_block(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
               source: string, pos: i32,
               et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
               ed3: Vec<i32>, ed4: Vec<i32>,
               pp: Vec<i32>, sf_names: Vec<i32>) -> i32 {
    if ps_peek(tags, pos) != 8 { return 0 - 1; }
    let mut stmts_first: i32 = 0 - 1;
    let mut stmt_count: i32 = 0;
    let stmt_ids: Vec<i32> = vec_new();
    let mut p: i32 = pos + 1;
    let mut blk_done: bool = false;
    while blk_done != true {
        if ps_peek(tags, p) == 9 {
            let mut sf2: i32 = stmts_first;
            if sf2 < 0 { sf2 = vec_len(et); }
            vec_push(et, 9);
            vec_push(ed1, sf2);
            vec_push(ed2, stmt_count);
            vec_push(ed3, 0 - 1);
            vec_push(ed4, block_stmt_sidecar_push(pp, stmt_ids));
            return p + 1;
        }
        let s: i32 = try_stmt(tags, starts, ends, source, p,
                               et, ed1, ed2, ed3, ed4, pp, sf_names);
        if s >= 0 {
            if stmts_first < 0 {
                stmts_first = vec_len(et) - 1;
            }
            vec_push(stmt_ids, vec_len(et) - 1);
            stmt_count = stmt_count + 1;
            p = s;
        } else {
            let pe: i32 = parse_expr_sf(tags, starts, ends, source, p,
                                      et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
            if pe < 0 { return 0 - 1; }
            if ps_peek(tags, pe) == 9 {
                let tail_idx: i32 = vec_len(et) - 1;
                let mut sf2: i32 = stmts_first;
                if sf2 < 0 { sf2 = tail_idx; }
                vec_push(et, 9);
                vec_push(ed1, sf2);
                vec_push(ed2, stmt_count);
                vec_push(ed3, tail_idx);
                vec_push(ed4, block_stmt_sidecar_push(pp, stmt_ids));
                return pe + 1;
            }
            if ps_peek(tags, pe) == 13 {
                let ei: i32 = vec_len(et) - 1;
                vec_push(et, 28);
                vec_push(ed1, ei);
                vec_push(ed2, 0);
                vec_push(ed3, 0);
                vec_push(ed4, 0);
                if stmts_first < 0 {
                    stmts_first = vec_len(et) - 1;
                }
                vec_push(stmt_ids, vec_len(et) - 1);
                stmt_count = stmt_count + 1;
                p = pe + 1;
            } else {
                if expr_ends_with_braced_block(et, vec_len(et) - 1) == 1 {
                    let ei: i32 = vec_len(et) - 1;
                    vec_push(et, 28);
                    vec_push(ed1, ei);
                    vec_push(ed2, 0);
                    vec_push(ed3, 0);
                    vec_push(ed4, 0);
                    if stmts_first < 0 {
                        stmts_first = vec_len(et) - 1;
                    }
                    vec_push(stmt_ids, vec_len(et) - 1);
                    stmt_count = stmt_count + 1;
                    p = pe;
                } else {
                    return 0 - 1;
                }
            }
        }
    }
    return 0 - 1;
}

fn parse_if_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                 source: string, pos: i32,
                 et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                 ed3: Vec<i32>, ed4: Vec<i32>,
                 pp: Vec<i32>, sf_names: Vec<i32>) -> i32 {
    let sf: Vec<i32> = vec_new();
    let tt: Vec<i32> = vec_new();
    let td1: Vec<i32> = vec_new();
    let td2: Vec<i32> = vec_new();
    let td3: Vec<i32> = vec_new();
    let p1: i32 = parse_range_expr(tags, starts, ends, source, pos,
                                    et, ed1, ed2, ed3, ed4, pp, sf,
                                    tt, td1, td2, td3, 0);
    if p1 < 0 { return 0 - 1; }
    let cond_idx: i32 = vec_len(et) - 1;
    let p2: i32 = parse_block(tags, starts, ends, source, p1,
                               et, ed1, ed2, ed3, ed4, pp, sf_names);
    if p2 < 0 { return 0 - 1; }
    let then_idx: i32 = vec_len(et) - 1;
    if ps_peek(tags, p2) == 60 {
        if ps_peek(tags, p2 + 1) == 68 {
            let p3: i32 = parse_if_expr(tags, starts, ends, source, p2 + 2,
                                         et, ed1, ed2, ed3, ed4, pp, sf_names);
            if p3 < 0 { return 0 - 1; }
            let else_idx: i32 = vec_len(et) - 1;
            vec_push(et, 10);
            vec_push(ed1, cond_idx);
            vec_push(ed2, then_idx);
            vec_push(ed3, else_idx);
            vec_push(ed4, 0);
            return p3;
        }
        let p3: i32 = parse_block(tags, starts, ends, source, p2 + 1,
                                   et, ed1, ed2, ed3, ed4, pp, sf_names);
        if p3 < 0 { return 0 - 1; }
        let else_idx: i32 = vec_len(et) - 1;
        vec_push(et, 10);
        vec_push(ed1, cond_idx);
        vec_push(ed2, then_idx);
        vec_push(ed3, else_idx);
        vec_push(ed4, 0);
        return p3;
    }
    vec_push(et, 10);
    vec_push(ed1, cond_idx);
    vec_push(ed2, then_idx);
    vec_push(ed3, 0 - 1);
    vec_push(ed4, 0);
    return p2;
}

fn parse_while_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                    source: string, pos: i32,
                    et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                    ed3: Vec<i32>, ed4: Vec<i32>,
                    pp: Vec<i32>, sf_names: Vec<i32>) -> i32 {
    let sf: Vec<i32> = vec_new();
    let tt: Vec<i32> = vec_new();
    let td1: Vec<i32> = vec_new();
    let td2: Vec<i32> = vec_new();
    let td3: Vec<i32> = vec_new();
    let p1: i32 = parse_range_expr(tags, starts, ends, source, pos,
                                    et, ed1, ed2, ed3, ed4, pp, sf,
                                    tt, td1, td2, td3, 0);
    if p1 < 0 { return 0 - 1; }
    let cond_idx: i32 = vec_len(et) - 1;
    let inv_mark: i32 = vec_len(et);
    let mut inv_count: i32 = 0;
    let mut pi: i32 = p1;
    let mut inv_done: bool = false;
    while inv_done != true {
        if ps_peek(tags, pi) != 73 {
            inv_done = true;
        } else {
            if ps_peek(tags, pi + 1) != 6 { return 0 - 1; }
            let pe: i32 = parse_expr_sf(tags, starts, ends, source, pi + 2,
                                      et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
            if pe < 0 { return 0 - 1; }
            if ps_peek(tags, pe) != 7 { return 0 - 1; }
            inv_count = inv_count + 1;
            pi = pe + 1;
        }
    }
    let p2: i32 = parse_block(tags, starts, ends, source, pi,
                               et, ed1, ed2, ed3, ed4, pp, sf_names);
    if p2 < 0 { return 0 - 1; }
    let body_idx: i32 = vec_len(et) - 1;
    let mut inv_first: i32 = 0 - 1;
    if inv_count > 0 { inv_first = inv_mark; }
    vec_push(et, 12);
    vec_push(ed1, cond_idx);
    vec_push(ed2, body_idx);
    vec_push(ed3, inv_first);
    vec_push(ed4, inv_count);
    return p2;
}

fn parse_for_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                  source: string, pos: i32,
                  et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                  ed3: Vec<i32>, ed4: Vec<i32>,
                  pp: Vec<i32>, sf_names: Vec<i32>) -> i32 {
    let pt: Vec<i32> = vec_new();
    let pd1v: Vec<i32> = vec_new();
    let pd2v: Vec<i32> = vec_new();
    let pd3v: Vec<i32> = vec_new();
    let p1: i32 = parse_pat(tags, starts, ends, source, pos,
                             pt, pd1v, pd2v, pd3v, pp);
    if p1 < 0 { return 0 - 1; }
    let pat_tok: i32 = vec_get(pd1v, 0);
    if ps_peek(tags, p1) != 70 { return 0 - 1; }
    let sf: Vec<i32> = vec_new();
    let tt: Vec<i32> = vec_new();
    let td1: Vec<i32> = vec_new();
    let td2: Vec<i32> = vec_new();
    let td3: Vec<i32> = vec_new();
    let p2: i32 = parse_range_expr(tags, starts, ends, source, p1 + 1,
                                    et, ed1, ed2, ed3, ed4, pp, sf,
                                    tt, td1, td2, td3, 0);
    if p2 < 0 { return 0 - 1; }
    let iter_idx: i32 = vec_len(et) - 1;
    let p3: i32 = parse_block(tags, starts, ends, source, p2,
                               et, ed1, ed2, ed3, ed4, pp, sf_names);
    if p3 < 0 { return 0 - 1; }
    let body_idx: i32 = vec_len(et) - 1;
    vec_push(et, 13);
    vec_push(ed1, pat_tok);
    vec_push(ed2, iter_idx);
    vec_push(ed3, body_idx);
    vec_push(ed4, 0);
    return p3;
}

fn parse_loop_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                   source: string, pos: i32,
                   et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                   ed3: Vec<i32>, ed4: Vec<i32>,
                   pp: Vec<i32>, sf_names: Vec<i32>) -> i32 {
    let pb: i32 = parse_block(tags, starts, ends, source, pos,
                               et, ed1, ed2, ed3, ed4, pp, sf_names);
    if pb < 0 { return 0 - 1; }
    let body_idx: i32 = vec_len(et) - 1;
    vec_push(et, 14);
    vec_push(ed1, body_idx);
    vec_push(ed2, 0);
    vec_push(ed3, 0);
    vec_push(ed4, 0);
    return pb;
}

/* ── pat_leftmost_subtree_rows ────────────────────────────────
   Row count of one `parse_pat_atom` / `parse_pat` subtree in the
   flat pat arena (children-before-parent). `s` is the leftmost row
   index of that subtree. Used to split PatOr alternatives into
   separate match arms in `parse_match_expr`. */

fn pat_leftmost_subtree_rows(pat_tags: Vec<i32>, pat_d1: Vec<i32>,
                             pat_d2: Vec<i32>, pat_d3: Vec<i32>,
                             s: i32) -> i32 {
    let t: i32 = vec_get(pat_tags, s);
    if t == 0 {
        return 1;
    }
    if t == 1 {
        return 1;
    }
    if t == 2 {
        return 1;
    }
    if t == 3 {
        let ef: i32 = vec_get(pat_d1, s);
        let ec: i32 = vec_get(pat_d2, s);
        let mut cur: i32 = ef;
        let mut tot: i32 = 0;
        let mut j: i32 = 0;
        while j < ec {
            let part: i32 = pat_leftmost_subtree_rows(pat_tags, pat_d1,
                pat_d2, pat_d3, cur);
            tot = tot + part;
            cur = cur + part;
            j = j + 1;
        }
        let one: i32 = 1;
        return tot + one;
    }
    if t == 4 {
        let fc: i32 = vec_get(pat_d3, s);
        let first_f: i32 = s - fc;
        let mut cur2: i32 = first_f;
        let mut tot2: i32 = 0;
        let mut j2: i32 = 0;
        while j2 < fc {
            let part2: i32 = pat_leftmost_subtree_rows(pat_tags, pat_d1,
                pat_d2, pat_d3, cur2);
            tot2 = tot2 + part2;
            cur2 = cur2 + part2;
            j2 = j2 + 1;
        }
        let one2: i32 = 1;
        return tot2 + one2;
    }
    if t == 5 {
        let ac: i32 = vec_get(pat_d3, s);
        let first_a: i32 = s - ac;
        let mut cur3: i32 = first_a;
        let mut tot3: i32 = 0;
        let mut j3: i32 = 0;
        while j3 < ac {
            let part3: i32 = pat_leftmost_subtree_rows(pat_tags, pat_d1,
                pat_d2, pat_d3, cur3);
            tot3 = tot3 + part3;
            cur3 = cur3 + part3;
            j3 = j3 + 1;
        }
        let one3: i32 = 1;
        return tot3 + one3;
    }
    if t == 6 {
        let fo: i32 = vec_get(pat_d1, s);
        let span: i32 = s - fo + 1;
        return span;
    }
    return 1;
}

/* ── match expressions + contract quantifiers ─────────────────
   SML: parseMatchExpr, parseMatchArms, parseQuant.
   Match arms encoded as ExprMatchArm(29) in the expr arena.
   PatOr(6) expands to one arm per alternative (same guard/body).
   Quantifiers (forall/exists) and old/no_alias encoded as ExprCall. */

fn parse_match_expr(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                    source: string, pos: i32,
                    et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                    ed3: Vec<i32>, ed4: Vec<i32>,
                    pp: Vec<i32>, sf_names: Vec<i32>) -> i32 {
    let sf: Vec<i32> = vec_new();
    let tt: Vec<i32> = vec_new();
    let td1: Vec<i32> = vec_new();
    let td2: Vec<i32> = vec_new();
    let td3: Vec<i32> = vec_new();
    let p1: i32 = parse_range_expr(tags, starts, ends, source, pos,
                                    et, ed1, ed2, ed3, ed4, pp, sf,
                                    tt, td1, td2, td3, 0);
    if p1 < 0 { return 0 - 1; }
    let scrut_idx: i32 = vec_len(et) - 1;
    if ps_peek(tags, p1) != 8 { return 0 - 1; }
    let mut arms_first: i32 = 0 - 1;
    let mut arm_count: i32 = 0;
    /* Match arm nodes (tag 29) are interleaved with their pattern-payload and body
       sub-expressions, so they are NOT at contiguous indices — record each arm
       node index in order and stash the list in pp (offset+1 in ExprMatch d4), the
       same statement-order sidecar blocks use. Consumers read it via
       block_stmt_index. */
    let arm_ids: Vec<i32> = vec_new();
    let mut p: i32 = p1 + 1;
    let mut arms_done: bool = false;
    while arms_done != true {
        if ps_peek(tags, p) == 9 {
            arms_done = true;
        } else {
            let pt: Vec<i32> = vec_new();
            let pd1v: Vec<i32> = vec_new();
            let pd2v: Vec<i32> = vec_new();
            let pd3v: Vec<i32> = vec_new();
            /* Parse the pattern path into the SHARED pp: PatEnum/PatStruct record a
               pp offset (pd1v[pr]) that the ExprPatExtra copies into et, and lower
               reads the enum/struct/variant name tokens back from pp. A local pool
               would be discarded, leaving those offsets dangling into pp. */
            let pa: i32 = parse_pat(tags, starts, ends, source, p,
                                     pt, pd1v, pd2v, pd3v, pp);
            if pa < 0 { return 0 - 1; }
            let pr: i32 = vec_len(pt) - 1;
            if pr < 0 { return 0 - 1; }
            let pat_tag: i32 = vec_get(pt, pr);
            let pat_d1: i32 = vec_get(pd1v, pr);
            let mut guard_idx: i32 = 0 - 1;
            let mut p2: i32 = pa;
            if ps_peek(tags, p2) == 68 {
                let pg: i32 = parse_expr_sf(tags, starts, ends, source, p2 + 1,
                                          et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
                if pg < 0 { return 0 - 1; }
                guard_idx = vec_len(et) - 1;
                p2 = pg;
            }
            if ps_peek(tags, p2) != 20 { return 0 - 1; }
            let p3: i32 = p2 + 1;
            let mut body_pos: i32 = 0;
            if ps_peek(tags, p3) == 8 {
                body_pos = parse_block(tags, starts, ends, source, p3,
                                        et, ed1, ed2, ed3, ed4, pp, sf_names);
            } else {
                body_pos = parse_expr_sf(tags, starts, ends, source, p3,
                                       et, ed1, ed2, ed3, ed4, pp, sf_names, 1);
            }
            if body_pos < 0 { return 0 - 1; }
            let body_idx: i32 = vec_len(et) - 1;
            let alt_roots: Vec<i32> = vec_new();
            if pat_tag == 6 {
                let pof: i32 = vec_get(pd1v, pr);
                let poc: i32 = vec_get(pd2v, pr);
                let mut crs: i32 = pof;
                let mut aix: i32 = 0;
                while aix < poc {
                    let spro: i32 = pat_leftmost_subtree_rows(pt, pd1v, pd2v,
                        pd3v, crs);
                    let aroot: i32 = crs + spro - 1;
                    vec_push(alt_roots, aroot);
                    crs = crs + spro;
                    aix = aix + 1;
                }
            } else {
                vec_push(alt_roots, pr);
            }
            let naltarms: i32 = vec_len(alt_roots);
            let mut am: i32 = 0;
            while am < naltarms {
                let pr_u: i32 = vec_get(alt_roots, am);
                let pat_tag_u: i32 = vec_get(pt, pr_u);
                let pat_d1_u: i32 = vec_get(pd1v, pr_u);
                let mut arm_ed2: i32 = pat_d1_u;
                if pat_tag_u == 2 || pat_tag_u == 4 || pat_tag_u == 5 {
                    if pat_tag_u == 4 {
                        let fc_u: i32 = vec_get(pd3v, pr_u);
                        let first_embed: i32 = vec_len(et);
                        let mut fj: i32 = 0;
                        while fj < fc_u {
                            let row: i32 = pr_u - fc_u + fj;
                            vec_push(et, 31);
                            vec_push(ed1, vec_get(pd1v, row));
                            vec_push(ed2, vec_get(pd2v, row));
                            vec_push(ed3, vec_get(pd3v, row));
                            vec_push(ed4, vec_get(pt, row));
                            fj = fj + 1;
                        }
                        vec_push(et, 32);
                        vec_push(ed1, fc_u);
                        if fc_u > 0 {
                            vec_push(ed2, first_embed);
                        } else {
                            vec_push(ed2, 0 - 1);
                        }
                        vec_push(ed3, 0);
                        vec_push(ed4, 0);
                    }
                    if pat_tag_u == 5 {
                        let ac_u: i32 = vec_get(pd3v, pr_u);
                        if ac_u > 0 {
                            let first_emb_e: i32 = vec_len(et);
                            let mut aj: i32 = 0;
                            while aj < ac_u {
                                let row_e: i32 = pr_u - ac_u + aj;
                                vec_push(et, 31);
                                vec_push(ed1, vec_get(pd1v, row_e));
                                vec_push(ed2, aj);
                                vec_push(ed3, vec_get(pd3v, row_e));
                                vec_push(ed4, vec_get(pt, row_e));
                                aj = aj + 1;
                            }
                            vec_push(et, 33);
                            vec_push(ed1, ac_u);
                            vec_push(ed2, first_emb_e);
                            vec_push(ed3, 0);
                            vec_push(ed4, 0);
                        }
                    }
                    vec_push(et, 30);
                    vec_push(ed1, vec_get(pd1v, pr_u));
                    vec_push(ed2, vec_get(pd2v, pr_u));
                    vec_push(ed3, vec_get(pd3v, pr_u));
                    vec_push(ed4, pat_tag_u);
                    arm_ed2 = vec_len(et) - 1;
                }
                vec_push(et, 29);
                vec_push(ed1, pat_tag_u);
                vec_push(ed2, arm_ed2);
                vec_push(ed3, guard_idx);
                vec_push(ed4, body_idx);
                if arms_first < 0 { arms_first = vec_len(et) - 1; }
                vec_push(arm_ids, vec_len(et) - 1);
                arm_count = arm_count + 1;
                am = am + 1;
            }
            if ps_peek(tags, body_pos) == 12 {
                p = body_pos + 1;
            } else {
                p = body_pos;
            }
        }
    }
    vec_push(et, 11);
    vec_push(ed1, scrut_idx);
    vec_push(ed2, arms_first);
    vec_push(ed3, arm_count);
    vec_push(ed4, block_stmt_sidecar_push(pp, arm_ids));
    return p + 1;
}

fn parse_quant(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
               source: string, pos: i32, is_forall: i32,
               et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
               ed3: Vec<i32>, ed4: Vec<i32>,
               pp: Vec<i32>) -> i32 {
    if ps_peek(tags, pos + 1) != 6 { return 0 - 1; }
    if ps_peek(tags, pos + 2) != 5 { return 0 - 1; }
    let id_pos: i32 = pos + 2;
    if ps_peek(tags, pos + 3) != 70 { return 0 - 1; }
    let first_idx: i32 = vec_len(et);
    let pps_id: i32 = vec_len(pp);
    vec_push(pp, id_pos);
    vec_push(et, 1);
    vec_push(ed1, pps_id);
    vec_push(ed2, 1);
    vec_push(ed3, 0);
    vec_push(ed4, 0);
    let pd: i32 = parse_expr(tags, starts, ends, source, pos + 4,
                              et, ed1, ed2, ed3, ed4, pp, 1);
    if pd < 0 { return 0 - 1; }
    if ps_peek(tags, pd) != 12 { return 0 - 1; }
    let pb: i32 = parse_expr(tags, starts, ends, source, pd + 1,
                              et, ed1, ed2, ed3, ed4, pp, 1);
    if pb < 0 { return 0 - 1; }
    if ps_peek(tags, pb) != 7 { return 0 - 1; }
    let pps_q: i32 = vec_len(pp);
    vec_push(pp, pos);
    vec_push(et, 1);
    vec_push(ed1, pps_q);
    vec_push(ed2, 1);
    vec_push(ed3, 0);
    vec_push(ed4, 0);
    let callee_idx: i32 = vec_len(et) - 1;
    vec_push(et, 4);
    vec_push(ed1, callee_idx);
    vec_push(ed2, first_idx);
    vec_push(ed3, 3);
    vec_push(ed4, 0);
    return pb + 1;
}

/* ── item-level parsing (SML parseFnBody…parseItem…val parse) ─
   Item arena (parallel Vec<i32>s: it, id1, id2, id3, id4):
     0 ItemFn         : d1=name_tok_pos,
                       d2=packed — has_ret (d2%2) + contract_count*2 (d2/2),
                       d3=param_count, d4=body_root (expr arena index in shared body_et),
                       d5=fn_param_name_toks_base (offset; wildcard `_` stores -1)
     1 ItemStruct     : d1=name_tok_pos, d2=field_count,
                       d3=struct_field_name_toks_base (offset into struct_field_name_toks),
                       d4=field_count (sanity mirror of d2; slice is [d3..d3+d4))
     2 ItemEnum       : d1=name_tok_pos, d2=variant_count,
                       d3=enum_variant_name_toks_base (offset into enum_variant_name_toks),
                       d4=variant_count (mirror of d2; slice is [d3..d3+d4))
     3 ItemTrait      : d1=name_tok_pos, d2=method_count, d3=0, d4=-1 sentinel
     4 ItemImpl       : d1=has_trait(0/1), d2=items_count, d3=0, d4=-1 sentinel
     5 ItemUse        : d1=pp_start, d2=pp_count
     6 ItemModule     : d1=pp_start, d2=pp_count
     7 ItemTypeAlias  : d1=name_tok_pos
   d5 for non-ItemFn items is **-1** (unused).
   Sidecar Vecs (program-local, parallel to parse): enum_variant_name_toks holds each
   variant’s IDENT token index; struct_field_name_toks holds each field’s IDENT token index;
   fn_param_name_toks holds each parameter’s IDENT token index (or **-1** for `_`).
   Children-before-parents: trait/impl push method ItemFn entries
   before the parent ItemTrait/ItemImpl entry. */

fn parse_param(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
               source: string, pos: i32, pp: Vec<i32>,
               fn_param_name_toks: Vec<i32>,
               pty_tt: Vec<i32>, pty_td1: Vec<i32>,
               pty_td2: Vec<i32>, pty_td3: Vec<i32>,
               fn_param_ty_root: Vec<i32>) -> i32 {
    let mut p: i32 = pos;
    if ps_peek(tags, p) == 77 { p = p + 1; }
    let t: i32 = ps_peek(tags, p);
    if t == 5 {
        vec_push(fn_param_name_toks, p);
    } else {
        if t != 86 { return 0 - 1; }
        vec_push(fn_param_name_toks, 0 - 1);
    }
    p = p + 1;
    if ps_peek(tags, p) != 14 { return 0 - 1; }
    let pt: i32 = parse_type(tags, starts, ends, source, p + 1,
                              pty_tt, pty_td1, pty_td2, pty_td3, pp);
    if pt < 0 { return 0 - 1; }
    vec_push(fn_param_ty_root, vec_len(pty_tt) - 1);
    return pt;
}

fn parse_param_list(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                    source: string, pos: i32, pp: Vec<i32>,
                    count_out: Vec<i32>,
                    fn_param_name_toks: Vec<i32>,
                    pty_tt: Vec<i32>, pty_td1: Vec<i32>,
                    pty_td2: Vec<i32>, pty_td3: Vec<i32>,
                    fn_param_ty_root: Vec<i32>) -> i32 {
    if ps_peek(tags, pos) == 7 { vec_push(count_out, 0); return pos; }
    let p1: i32 = parse_param(tags, starts, ends, source, pos, pp,
                               fn_param_name_toks,
                               pty_tt, pty_td1, pty_td2, pty_td3,
                               fn_param_ty_root);
    if p1 < 0 { return 0 - 1; }
    let mut count: i32 = 1;
    let mut p: i32 = p1;
    let mut done: bool = false;
    while done != true {
        if ps_peek(tags, p) == 12 {
            if ps_peek(tags, p + 1) == 7 {
                p = p + 1;
                done = true;
            } else {
                let pn: i32 = parse_param(tags, starts, ends, source, p + 1,
                                           pp, fn_param_name_toks,
                                           pty_tt, pty_td1, pty_td2, pty_td3,
                                           fn_param_ty_root);
                if pn < 0 { return 0 - 1; }
                count = count + 1;
                p = pn;
            }
        } else {
            done = true;
        }
    }
    vec_push(count_out, count);
    return p;
}

fn parse_contract(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                  source: string, pos: i32, pp: Vec<i32>,
                  et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                  ed3: Vec<i32>, ed4: Vec<i32>,
                  contract_root: Vec<i32>) -> i32 {
    let t: i32 = ps_peek(tags, pos);
    if t != 83 {
        if t != 61 {
            if t != 73 { return 0 - 2; }
        }
    }
    if ps_peek(tags, pos + 1) != 6 { return 0 - 1; }
    let pe: i32 = parse_expr(tags, starts, ends, source, pos + 2,
                              et, ed1, ed2, ed3, ed4, pp, 1);
    if pe < 0 { return 0 - 1; }
    if ps_peek(tags, pe) != 7 { return 0 - 1; }
    vec_push(contract_root, vec_len(et) - 1);
    return pe + 1;
}

fn parse_contracts(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                   source: string, pos: i32, pp: Vec<i32>,
                   et: Vec<i32>, ed1: Vec<i32>, ed2: Vec<i32>,
                   ed3: Vec<i32>, ed4: Vec<i32>,
                   contract_root: Vec<i32>,
                   count_out: Vec<i32>) -> i32 {
    let mut p: i32 = pos;
    let mut count: i32 = 0;
    let mut done: bool = false;
    while done != true {
        let pc: i32 = parse_contract(tags, starts, ends, source, p, pp,
                                     et, ed1, ed2, ed3, ed4, contract_root);
        if pc == 0 - 2 { done = true; }
        else {
            if pc < 0 { return 0 - 1; }
            count = count + 1;
            p = pc;
        }
    }
    vec_push(count_out, count);
    return p;
}

fn parse_fn_body(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                 source: string, pos: i32,
                 it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
                 id3: Vec<i32>, id4: Vec<i32>, id5: Vec<i32>,
                 pp: Vec<i32>,
                 fn_param_name_toks: Vec<i32>,
                 fn_param_ty_root: Vec<i32>,
                 fn_ret_ty_root_by_item: Vec<i32>,
                 fn_contract_base_by_item: Vec<i32>,
                 fn_contract_root: Vec<i32>,
                 enum_variant_payload_base_by_item: Vec<i32>,
                 enum_variant_payload_count_by_item: Vec<i32>,
                 pty_tt: Vec<i32>, pty_td1: Vec<i32>,
                 pty_td2: Vec<i32>, pty_td3: Vec<i32>,
                 body_et: Vec<i32>, body_ed1: Vec<i32>,
                 body_ed2: Vec<i32>, body_ed3: Vec<i32>,
                 body_ed4: Vec<i32>, body_sf: Vec<i32>) -> i32 {
    let p0: i32 = ps_skip_optional_unsafe(tags, pos);
    if ps_peek(tags, p0) != 65 { return 0 - 1; }
    if ps_peek(tags, p0 + 1) != 5 { return 0 - 1; }
    let name_pos: i32 = p0 + 1;
    let gp: Vec<i32> = vec_new();
    let p1: i32 = parse_generic_params(tags, p0 + 2, gp);
    if ps_peek(tags, p1) != 6 { return 0 - 1; }
    let pbase: i32 = vec_len(fn_param_name_toks);
    let pc: Vec<i32> = vec_new();
    let p2: i32 = parse_param_list(tags, starts, ends, source, p1 + 1, pp, pc,
                                    fn_param_name_toks,
                                    pty_tt, pty_td1, pty_td2, pty_td3,
                                    fn_param_ty_root);
    if p2 < 0 { return 0 - 1; }
    if ps_peek(tags, p2) != 7 { return 0 - 1; }
    let param_count: i32 = vec_get(pc, 0);
    let mut has_ret: i32 = 0;
    let mut ret_ty_root: i32 = 0 - 1;
    let mut p3: i32 = p2 + 1;
    if ps_peek(tags, p3) == 19 {
        let pt: i32 = parse_type(tags, starts, ends, source, p3 + 1,
                                  pty_tt, pty_td1, pty_td2, pty_td3, pp);
        if pt < 0 { return 0 - 1; }
        has_ret = 1;
        ret_ty_root = vec_len(pty_tt) - 1;
        p3 = pt;
    }
    let p4: i32 = ps_skip_where_clause(tags, p3);
    let contract_base: i32 = vec_len(fn_contract_root);
    let cc: Vec<i32> = vec_new();
    let p5: i32 = parse_contracts(tags, starts, ends, source, p4, pp,
                                  body_et, body_ed1, body_ed2,
                                  body_ed3, body_ed4,
                                  fn_contract_root, cc);
    if p5 < 0 { return 0 - 1; }
    let contract_count: i32 = vec_get(cc, 0);
    let p6: i32 = parse_block(tags, starts, ends, source, p5,
                               body_et, body_ed1, body_ed2, body_ed3,
                               body_ed4, pp, body_sf);
    if p6 < 0 { return 0 - 1; }
    let body_root: i32 = vec_len(body_et) - 1;
    vec_push(it, 0);
    vec_push(id1, name_pos);
    vec_push(id2, has_ret + contract_count * 2);
    vec_push(id3, param_count);
    vec_push(id4, body_root);
    vec_push(id5, pbase);
    vec_push(fn_ret_ty_root_by_item, ret_ty_root);
    vec_push(fn_contract_base_by_item, contract_base);
    vec_push(enum_variant_payload_base_by_item, 0 - 1);
    vec_push(enum_variant_payload_count_by_item, 0);
    return p6;
}

fn parse_struct_item(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                     source: string, pos: i32,
                     it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
                     id3: Vec<i32>, id4: Vec<i32>, id5: Vec<i32>,
                     pp: Vec<i32>,
                     struct_field_name_toks: Vec<i32>,
                     fn_ret_ty_root_by_item: Vec<i32>,
                     fn_contract_base_by_item: Vec<i32>,
                     enum_variant_payload_base_by_item: Vec<i32>,
                     enum_variant_payload_count_by_item: Vec<i32>,
                     pty_tt: Vec<i32>, pty_td1: Vec<i32>, pty_td2: Vec<i32>,
                     pty_td3: Vec<i32>, struct_field_ty_root: Vec<i32>) -> i32 {
    if ps_peek(tags, pos) != 89 { return 0 - 1; }
    if ps_peek(tags, pos + 1) != 5 { return 0 - 1; }
    let name_pos: i32 = pos + 1;
    let gp: Vec<i32> = vec_new();
    let p1: i32 = parse_generic_params(tags, pos + 2, gp);
    if ps_peek(tags, p1) != 8 { return 0 - 1; }
    let mut p: i32 = p1 + 1;
    let mut field_count: i32 = 0;
    let sf_base: i32 = vec_len(struct_field_name_toks);
    let mut done: bool = false;
    while done != true {
        if ps_peek(tags, p) == 9 {
            done = true;
        } else {
            let fp: i32 = ps_skip_optional_pub(tags, p);
            if ps_peek(tags, fp) != 5 { return 0 - 1; }
            vec_push(struct_field_name_toks, fp);
            if ps_peek(tags, fp + 1) != 14 { return 0 - 1; }
            let pt: i32 = parse_type(tags, starts, ends, source, fp + 2,
                                      pty_tt, pty_td1, pty_td2, pty_td3, pp);
            if pt < 0 { return 0 - 1; }
            vec_push(struct_field_ty_root, vec_len(pty_tt) - 1);
            field_count = field_count + 1;
            if ps_peek(tags, pt) == 12 {
                p = pt + 1;
            } else {
                if ps_peek(tags, pt) == 9 { p = pt; }
                else { return 0 - 1; }
            }
        }
    }
    vec_push(it, 1);
    vec_push(id1, name_pos);
    vec_push(id2, field_count);
    vec_push(id3, sf_base);
    vec_push(id4, field_count);
    vec_push(id5, 0 - 1);
    vec_push(fn_ret_ty_root_by_item, 0 - 1);
    vec_push(fn_contract_base_by_item, 0 - 1);
    vec_push(enum_variant_payload_base_by_item, 0 - 1);
    vec_push(enum_variant_payload_count_by_item, 0);
    return p + 1;
}

fn parse_enum_item(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                   source: string, pos: i32,
                   it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
                   id3: Vec<i32>, id4: Vec<i32>, id5: Vec<i32>,
                   pp: Vec<i32>,
                   enum_variant_name_toks: Vec<i32>,
                   fn_ret_ty_root_by_item: Vec<i32>,
                   fn_contract_base_by_item: Vec<i32>,
                   enum_variant_payload_ty_root: Vec<i32>,
                   enum_variant_payload_base_by_item: Vec<i32>,
                   enum_variant_payload_count_by_item: Vec<i32>,
                   pty_tt: Vec<i32>, pty_td1: Vec<i32>, pty_td2: Vec<i32>,
                   pty_td3: Vec<i32>) -> i32 {
    if ps_peek(tags, pos) != 62 { return 0 - 1; }
    if ps_peek(tags, pos + 1) != 5 { return 0 - 1; }
    let name_pos: i32 = pos + 1;
    let gp: Vec<i32> = vec_new();
    let p1: i32 = parse_generic_params(tags, pos + 2, gp);
    if ps_peek(tags, p1) != 8 { return 0 - 1; }
    let mut p: i32 = p1 + 1;
    let mut variant_count: i32 = 0;
    let ev_base: i32 = vec_len(enum_variant_name_toks);
    let payload_base: i32 = vec_len(enum_variant_payload_ty_root);
    let mut payload_count: i32 = 0;
    let mut done: bool = false;
    while done != true {
        if ps_peek(tags, p) == 9 {
            done = true;
        } else {
            if ps_peek(tags, p) != 5 { return 0 - 1; }
            vec_push(enum_variant_name_toks, p);
            let vp: i32 = p + 1;
            if ps_peek(tags, vp) == 6 {
                let mut tp: i32 = vp + 1;
                if ps_peek(tags, tp) == 7 {
                    tp = tp + 1;
                } else {
                    let mut td: bool = false;
                    while td != true {
                        let pt: i32 = parse_type(tags, starts, ends, source, tp,
                                                  pty_tt, pty_td1, pty_td2, pty_td3, pp);
                        if pt < 0 { return 0 - 1; }
                        vec_push(enum_variant_payload_ty_root, vec_len(pty_tt) - 1);
                        payload_count = payload_count + 1;
                        if ps_peek(tags, pt) == 12 { tp = pt + 1; }
                        else {
                            if ps_peek(tags, pt) == 7 { tp = pt + 1; td = true; }
                            else { return 0 - 1; }
                        }
                    }
                }
                variant_count = variant_count + 1;
                if ps_peek(tags, tp) == 12 { p = tp + 1; }
                else {
                    if ps_peek(tags, tp) == 9 { p = tp; }
                    else { return 0 - 1; }
                }
            } else {
                if ps_peek(tags, vp) == 8 {
                    let mut sp: i32 = vp + 1;
                    let mut sd: bool = false;
                    while sd != true {
                        if ps_peek(tags, sp) == 9 { sp = sp + 1; sd = true; }
                        else {
                            if ps_peek(tags, sp) != 5 { return 0 - 1; }
                            if ps_peek(tags, sp + 1) != 14 { return 0 - 1; }
                            let pt: i32 = parse_type(tags, starts, ends, source, sp + 2,
                                                      pty_tt, pty_td1, pty_td2, pty_td3, pp);
                            if pt < 0 { return 0 - 1; }
                            vec_push(enum_variant_payload_ty_root, vec_len(pty_tt) - 1);
                            payload_count = payload_count + 1;
                            if ps_peek(tags, pt) == 12 { sp = pt + 1; }
                            else {
                                if ps_peek(tags, pt) == 9 { sp = pt; }
                                else { return 0 - 1; }
                            }
                        }
                    }
                    variant_count = variant_count + 1;
                    if ps_peek(tags, sp) == 12 { p = sp + 1; }
                    else {
                        if ps_peek(tags, sp) == 9 { p = sp; }
                        else { return 0 - 1; }
                    }
                } else {
                    variant_count = variant_count + 1;
                    if ps_peek(tags, vp) == 12 { p = vp + 1; }
                    else {
                        if ps_peek(tags, vp) == 9 { p = vp; }
                        else { return 0 - 1; }
                    }
                }
            }
        }
    }
    vec_push(it, 2);
    vec_push(id1, name_pos);
    vec_push(id2, variant_count);
    vec_push(id3, ev_base);
    vec_push(id4, variant_count);
    vec_push(id5, 0 - 1);
    vec_push(fn_ret_ty_root_by_item, 0 - 1);
    vec_push(fn_contract_base_by_item, 0 - 1);
    vec_push(enum_variant_payload_base_by_item, payload_base);
    vec_push(enum_variant_payload_count_by_item, payload_count);
    return p + 1;
}

fn parse_type_alias_item(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                         source: string, pos: i32,
                         it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
                         id3: Vec<i32>, id4: Vec<i32>, id5: Vec<i32>,
                         pp: Vec<i32>,
                         fn_ret_ty_root_by_item: Vec<i32>,
                         fn_contract_base_by_item: Vec<i32>,
                         enum_variant_payload_base_by_item: Vec<i32>,
                         enum_variant_payload_count_by_item: Vec<i32>,
                         pty_tt: Vec<i32>, pty_td1: Vec<i32>, pty_td2: Vec<i32>,
                         pty_td3: Vec<i32>) -> i32 {
    if ps_peek(tags, pos) != 92 { return 0 - 1; }
    if ps_peek(tags, pos + 1) != 5 { return 0 - 1; }
    let name_pos: i32 = pos + 1;
    let p1: i32 = ps_skip_generic_params(tags, pos + 2);
    if ps_peek(tags, p1) != 35 { return 0 - 1; }
    let pt: i32 = parse_type(tags, starts, ends, source, p1 + 1,
                              pty_tt, pty_td1, pty_td2, pty_td3, pp);
    if pt < 0 { return 0 - 1; }
    if ps_peek(tags, pt) != 13 { return 0 - 1; }
    let alias_ty_root: i32 = vec_len(pty_tt) - 1;
    vec_push(it, 7);
    vec_push(id1, name_pos);
    vec_push(id2, alias_ty_root);
    vec_push(id3, 0);
    vec_push(id4, 0);
    vec_push(id5, 0 - 1);
    vec_push(fn_ret_ty_root_by_item, 0 - 1);
    vec_push(fn_contract_base_by_item, 0 - 1);
    vec_push(enum_variant_payload_base_by_item, 0 - 1);
    vec_push(enum_variant_payload_count_by_item, 0);
    return pt + 1;
}

fn parse_trait_item(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                    source: string, pos: i32,
                    it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
                    id3: Vec<i32>, id4: Vec<i32>, id5: Vec<i32>,
                    pp: Vec<i32>,
                    fn_param_name_toks: Vec<i32>,
                    fn_param_ty_root: Vec<i32>,
                    fn_ret_ty_root_by_item: Vec<i32>,
                    fn_contract_base_by_item: Vec<i32>,
                    fn_contract_root: Vec<i32>,
                    enum_variant_payload_base_by_item: Vec<i32>,
                    enum_variant_payload_count_by_item: Vec<i32>,
                    pty_tt: Vec<i32>, pty_td1: Vec<i32>,
                    pty_td2: Vec<i32>, pty_td3: Vec<i32>,
                    body_et: Vec<i32>, body_ed1: Vec<i32>,
                    body_ed2: Vec<i32>, body_ed3: Vec<i32>,
                    body_ed4: Vec<i32>, body_sf: Vec<i32>) -> i32 {
    if ps_peek(tags, pos) != 90 { return 0 - 1; }
    if ps_peek(tags, pos + 1) != 5 { return 0 - 1; }
    let name_pos: i32 = pos + 1;
    let p1: i32 = ps_skip_generic_params(tags, pos + 2);
    if ps_peek(tags, p1) != 8 { return 0 - 1; }
    let mut p: i32 = p1 + 1;
    let mut method_count: i32 = 0;
    let mut done: bool = false;
    while done != true {
        if ps_peek(tags, p) == 9 { done = true; }
        else {
            let pm: i32 = parse_fn_body(tags, starts, ends, source, p,
                                         it, id1, id2, id3, id4, id5, pp,
                                         fn_param_name_toks,
                                         fn_param_ty_root,
                                         fn_ret_ty_root_by_item,
                                         fn_contract_base_by_item,
                                         fn_contract_root,
                                         enum_variant_payload_base_by_item,
                                         enum_variant_payload_count_by_item,
                                         pty_tt, pty_td1, pty_td2, pty_td3,
                                         body_et, body_ed1, body_ed2,
                                         body_ed3, body_ed4, body_sf);
            if pm < 0 { return 0 - 1; }
            method_count = method_count + 1;
            p = pm;
        }
    }
    vec_push(it, 3);
    vec_push(id1, name_pos);
    vec_push(id2, method_count);
    vec_push(id3, 0);
    vec_push(id4, 0 - 1);
    vec_push(id5, 0 - 1);
    vec_push(fn_ret_ty_root_by_item, 0 - 1);
    vec_push(fn_contract_base_by_item, 0 - 1);
    vec_push(enum_variant_payload_base_by_item, 0 - 1);
    vec_push(enum_variant_payload_count_by_item, 0);
    return p + 1;
}

fn parse_impl_item(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                   source: string, pos: i32,
                   it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
                   id3: Vec<i32>, id4: Vec<i32>, id5: Vec<i32>,
                   pp: Vec<i32>,
                   fn_param_name_toks: Vec<i32>,
                   fn_param_ty_root: Vec<i32>,
                   fn_ret_ty_root_by_item: Vec<i32>,
                   fn_contract_base_by_item: Vec<i32>,
                   fn_contract_root: Vec<i32>,
                   enum_variant_payload_base_by_item: Vec<i32>,
                   enum_variant_payload_count_by_item: Vec<i32>,
                   pty_tt: Vec<i32>, pty_td1: Vec<i32>,
                   pty_td2: Vec<i32>, pty_td3: Vec<i32>,
                   body_et: Vec<i32>, body_ed1: Vec<i32>,
                   body_ed2: Vec<i32>, body_ed3: Vec<i32>,
                   body_ed4: Vec<i32>, body_sf: Vec<i32>) -> i32 {
    if ps_peek(tags, pos) != 69 { return 0 - 1; }
    let p0: i32 = ps_skip_generic_params(tags, pos + 1);
    let tt: Vec<i32> = vec_new();
    let td1v: Vec<i32> = vec_new();
    let td2v: Vec<i32> = vec_new();
    let td3v: Vec<i32> = vec_new();
    let p1: i32 = parse_type(tags, starts, ends, source, p0,
                              tt, td1v, td2v, td3v, pp);
    if p1 < 0 { return 0 - 1; }
    let mut has_trait: i32 = 0;
    let mut p2: i32 = p1;
    if ps_peek(tags, p1) == 66 {
        has_trait = 1;
        let tt2: Vec<i32> = vec_new();
        let td1b: Vec<i32> = vec_new();
        let td2b: Vec<i32> = vec_new();
        let td3b: Vec<i32> = vec_new();
        let p3: i32 = parse_type(tags, starts, ends, source, p1 + 1,
                                  tt2, td1b, td2b, td3b, pp);
        if p3 < 0 { return 0 - 1; }
        p2 = p3;
    }
    let p4: i32 = ps_skip_where_clause(tags, p2);
    if ps_peek(tags, p4) != 8 { return 0 - 1; }
    let mut p: i32 = p4 + 1;
    let mut items_count: i32 = 0;
    let mut done: bool = false;
    while done != true {
        if ps_peek(tags, p) == 9 { done = true; }
        else {
            let pm: i32 = parse_fn_body(tags, starts, ends, source, p,
                                         it, id1, id2, id3, id4, id5, pp,
                                         fn_param_name_toks,
                                         fn_param_ty_root,
                                         fn_ret_ty_root_by_item,
                                         fn_contract_base_by_item,
                                         fn_contract_root,
                                         enum_variant_payload_base_by_item,
                                         enum_variant_payload_count_by_item,
                                         pty_tt, pty_td1, pty_td2, pty_td3,
                                         body_et, body_ed1, body_ed2,
                                         body_ed3, body_ed4, body_sf);
            if pm < 0 { return 0 - 1; }
            items_count = items_count + 1;
            p = pm;
        }
    }
    vec_push(it, 4);
    vec_push(id1, has_trait);
    vec_push(id2, items_count);
    vec_push(id3, 0);
    vec_push(id4, 0 - 1);
    vec_push(id5, 0 - 1);
    vec_push(fn_ret_ty_root_by_item, 0 - 1);
    vec_push(fn_contract_base_by_item, 0 - 1);
    vec_push(enum_variant_payload_base_by_item, 0 - 1);
    vec_push(enum_variant_payload_count_by_item, 0);
    return p + 1;
}

fn parse_item(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
              source: string, pos: i32,
              it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
              id3: Vec<i32>, id4: Vec<i32>, id5: Vec<i32>,
              pp: Vec<i32>,
              enum_variant_name_toks: Vec<i32>,
              struct_field_name_toks: Vec<i32>,
              fn_param_name_toks: Vec<i32>,
              fn_param_ty_root: Vec<i32>,
              fn_ret_ty_root_by_item: Vec<i32>,
              fn_contract_base_by_item: Vec<i32>,
              fn_contract_root: Vec<i32>,
              enum_variant_payload_ty_root: Vec<i32>,
              enum_variant_payload_base_by_item: Vec<i32>,
              enum_variant_payload_count_by_item: Vec<i32>,
              pty_tt: Vec<i32>, pty_td1: Vec<i32>, pty_td2: Vec<i32>,
              pty_td3: Vec<i32>, struct_field_ty_root: Vec<i32>,
              body_et: Vec<i32>, body_ed1: Vec<i32>,
              body_ed2: Vec<i32>, body_ed3: Vec<i32>,
              body_ed4: Vec<i32>, body_sf: Vec<i32>) -> i32 {
    let p0: i32 = ps_skip_optional_pub(tags, ps_skip_attributes(tags, pos));
    let t: i32 = ps_peek(tags, p0);
    if t == 75 {
        let pps: i32 = vec_len(pp);
        let pm: i32 = parse_module_decl(tags, p0, pp);
        if pm == p0 { return 0 - 1; }
        let ppc: i32 = vec_len(pp) - pps;
        vec_push(it, 6);
        vec_push(id1, pps);
        vec_push(id2, ppc);
        vec_push(id3, 0);
        vec_push(id4, 0 - 1);
        vec_push(id5, 0 - 1);
        vec_push(fn_ret_ty_root_by_item, 0 - 1);
        vec_push(fn_contract_base_by_item, 0 - 1);
        vec_push(enum_variant_payload_base_by_item, 0 - 1);
        vec_push(enum_variant_payload_count_by_item, 0);
        return pm;
    }
    if t == 94 {
        let pps: i32 = vec_len(pp);
        let pu: i32 = parse_use_item(tags, p0, pp);
        if pu < 0 { return 0 - 1; }
        let ppc: i32 = vec_len(pp) - pps;
        vec_push(it, 5);
        vec_push(id1, pps);
        vec_push(id2, ppc);
        vec_push(id3, 0);
        vec_push(id4, 0 - 1);
        vec_push(id5, 0 - 1);
        vec_push(fn_ret_ty_root_by_item, 0 - 1);
        vec_push(fn_contract_base_by_item, 0 - 1);
        vec_push(enum_variant_payload_base_by_item, 0 - 1);
        vec_push(enum_variant_payload_count_by_item, 0);
        return pu;
    }
    if t == 65 {
        return parse_fn_body(tags, starts, ends, source, p0,
                             it, id1, id2, id3, id4, id5, pp,
                             fn_param_name_toks,
                             fn_param_ty_root,
                             fn_ret_ty_root_by_item,
                             fn_contract_base_by_item,
                             fn_contract_root,
                             enum_variant_payload_base_by_item,
                             enum_variant_payload_count_by_item,
                             pty_tt, pty_td1, pty_td2, pty_td3,
                             body_et, body_ed1, body_ed2,
                             body_ed3, body_ed4, body_sf);
    }
    if t == 93 {
        return parse_fn_body(tags, starts, ends, source, p0,
                             it, id1, id2, id3, id4, id5, pp,
                             fn_param_name_toks,
                             fn_param_ty_root,
                             fn_ret_ty_root_by_item,
                             fn_contract_base_by_item,
                             fn_contract_root,
                             enum_variant_payload_base_by_item,
                             enum_variant_payload_count_by_item,
                             pty_tt, pty_td1, pty_td2, pty_td3,
                             body_et, body_ed1, body_ed2,
                             body_ed3, body_ed4, body_sf);
    }
    if t == 89 {
        return parse_struct_item(tags, starts, ends, source, p0,
                                 it, id1, id2, id3, id4, id5, pp,
                                 struct_field_name_toks,
                                 fn_ret_ty_root_by_item,
                                 fn_contract_base_by_item,
                                 enum_variant_payload_base_by_item,
                                 enum_variant_payload_count_by_item,
                                 pty_tt, pty_td1, pty_td2, pty_td3,
                                 struct_field_ty_root);
    }
    if t == 62 {
        return parse_enum_item(tags, starts, ends, source, p0,
                               it, id1, id2, id3, id4, id5, pp,
                               enum_variant_name_toks,
                               fn_ret_ty_root_by_item,
                               fn_contract_base_by_item,
                               enum_variant_payload_ty_root,
                               enum_variant_payload_base_by_item,
                               enum_variant_payload_count_by_item,
                               pty_tt, pty_td1, pty_td2, pty_td3);
    }
    if t == 90 {
        return parse_trait_item(tags, starts, ends, source, p0,
                                it, id1, id2, id3, id4, id5, pp,
                                fn_param_name_toks,
                                fn_param_ty_root,
                                fn_ret_ty_root_by_item,
                                fn_contract_base_by_item,
                                fn_contract_root,
                                enum_variant_payload_base_by_item,
                                enum_variant_payload_count_by_item,
                                pty_tt, pty_td1, pty_td2, pty_td3,
                                body_et, body_ed1, body_ed2,
                                body_ed3, body_ed4, body_sf);
    }
    if t == 69 {
        return parse_impl_item(tags, starts, ends, source, p0,
                               it, id1, id2, id3, id4, id5, pp,
                               fn_param_name_toks,
                               fn_param_ty_root,
                               fn_ret_ty_root_by_item,
                               fn_contract_base_by_item,
                               fn_contract_root,
                               enum_variant_payload_base_by_item,
                               enum_variant_payload_count_by_item,
                               pty_tt, pty_td1, pty_td2, pty_td3,
                               body_et, body_ed1, body_ed2,
                               body_ed3, body_ed4, body_sf);
    }
    if t == 92 {
        return parse_type_alias_item(tags, starts, ends, source, p0,
                                     it, id1, id2, id3, id4, id5, pp,
                                     fn_ret_ty_root_by_item,
                                     fn_contract_base_by_item,
                                     enum_variant_payload_base_by_item,
                                     enum_variant_payload_count_by_item,
                                     pty_tt, pty_td1, pty_td2, pty_td3);
    }
    return 0 - 1;
}

fn parse_program(tags: Vec<i32>, starts: Vec<i32>, ends: Vec<i32>,
                 source: string, pos: i32,
                 it: Vec<i32>, id1: Vec<i32>, id2: Vec<i32>,
                 id3: Vec<i32>, id4: Vec<i32>, id5: Vec<i32>,
                 pp: Vec<i32>,
                 enum_variant_name_toks: Vec<i32>,
                 struct_field_name_toks: Vec<i32>,
                 fn_param_name_toks: Vec<i32>,
                 fn_param_ty_root: Vec<i32>,
                 fn_ret_ty_root_by_item: Vec<i32>,
                 fn_contract_base_by_item: Vec<i32>,
                 fn_contract_root: Vec<i32>,
                 enum_variant_payload_ty_root: Vec<i32>,
                 enum_variant_payload_base_by_item: Vec<i32>,
                 enum_variant_payload_count_by_item: Vec<i32>,
                 pty_tt: Vec<i32>, pty_td1: Vec<i32>, pty_td2: Vec<i32>,
                 pty_td3: Vec<i32>, struct_field_ty_root: Vec<i32>,
                 body_et: Vec<i32>, body_ed1: Vec<i32>,
                 body_ed2: Vec<i32>, body_ed3: Vec<i32>,
                 body_ed4: Vec<i32>, body_sf: Vec<i32>) -> i32 {
    let mut p: i32 = pos;
    let mut done: bool = false;
    while done != true {
        let p0: i32 = ps_skip_attributes(tags, p);
        if ps_peek(tags, p0) == 97 { done = true; }
        else {
            let pi: i32 = parse_item(tags, starts, ends, source, p0,
                                      it, id1, id2, id3, id4, id5, pp,
                                      enum_variant_name_toks,
                                      struct_field_name_toks,
                                      fn_param_name_toks,
                                      fn_param_ty_root,
                                      fn_ret_ty_root_by_item,
                                      fn_contract_base_by_item,
                                      fn_contract_root,
                                      enum_variant_payload_ty_root,
                                      enum_variant_payload_base_by_item,
                                      enum_variant_payload_count_by_item,
                                      pty_tt, pty_td1, pty_td2, pty_td3,
                                      struct_field_ty_root,
                                      body_et, body_ed1, body_ed2,
                                      body_ed3, body_ed4, body_sf);
            if pi < 0 { return 0 - 1; }
            p = pi;
        }
    }
    return p;
}

/* ── ItemFn id2 packing (M3 G3 — resolver/checker helpers) ────
   parse_fn_body stores id2 = has_ret + 2*contract_count (each ≥ 0). */

fn item_fn_has_ret_packed(item_id2: i32) -> i32 {
    let m: i32 = item_id2 % 2;
    return m;
}

fn item_fn_contract_count_packed(item_id2: i32) -> i32 {
    return item_id2 / 2;
}

/* ── tests ──────────────────────────────────────────────────── */

fn test_item_fn_id2_pack_roundtrip() -> i32 {
    let x: i32 = item_fn_has_ret_packed(7);
    if x != 1 { return 1; }
    let c: i32 = item_fn_contract_count_packed(7);
    if c != 3 { return 2; }
    let x2: i32 = item_fn_has_ret_packed(6);
    if x2 != 0 { return 3; }
    let c2: i32 = item_fn_contract_count_packed(6);
    if c2 != 3 { return 4; }
    return 0;
}

fn test_binop_of() -> i32 {
    if binop_of(22) != 0 { return 1; }
    if binop_of(23) != 1 { return 2; }
    if binop_of(24) != 2 { return 3; }
    if binop_of(25) != 3 { return 4; }
    if binop_of(26) != 4 { return 5; }
    if binop_of(27) != 13 { return 6; }
    if binop_of(29) != 14 { return 7; }
    if binop_of(31) != 15 { return 8; }
    if binop_of(42) != 16 { return 9; }
    if binop_of(43) != 17 { return 10; }
    if binop_of(28) != 11 { return 11; }
    if binop_of(30) != 12 { return 12; }
    if binop_of(36) != 5 { return 13; }
    if binop_of(37) != 6 { return 14; }
    if binop_of(38) != 7 { return 15; }
    if binop_of(39) != 8 { return 16; }
    if binop_of(40) != 9 { return 17; }
    if binop_of(41) != 10 { return 18; }
    if binop_of(0) != 0 - 1 { return 19; }
    if has_binop(22) != true { return 20; }
    if has_binop(0) != false { return 21; }
    return 0;
}

fn test_assign_binop() -> i32 {
    if assign_binop(44) != 0 { return 1; }
    if assign_binop(45) != 1 { return 2; }
    if assign_binop(46) != 2 { return 3; }
    if assign_binop(47) != 3 { return 4; }
    if assign_binop(48) != 4 { return 5; }
    if assign_binop(49) != 13 { return 6; }
    if assign_binop(50) != 14 { return 7; }
    if assign_binop(51) != 15 { return 8; }
    if assign_binop(52) != 16 { return 9; }
    if assign_binop(53) != 17 { return 10; }
    if assign_binop(0) != 0 - 1 { return 11; }
    if has_assign_binop(44) != true { return 12; }
    if has_assign_binop(0) != false { return 13; }
    if is_compound_assign(44) != true { return 14; }
    if is_compound_assign(53) != true { return 15; }
    if is_compound_assign(22) != false { return 16; }
    return 0;
}

fn test_is_assign_tok() -> i32 {
    if is_assign_tok(35) != true { return 1; }
    if is_assign_tok(44) != true { return 2; }
    if is_assign_tok(53) != true { return 3; }
    if is_assign_tok(22) != false { return 4; }
    if is_assign_tok(0) != false { return 5; }
    if is_assign_tok(97) != false { return 6; }
    return 0;
}

fn test_path_of_ty() -> i32 {
    if path_of_ty_valid(0) != true { return 1; }
    if path_of_ty_valid(1) != false { return 2; }
    if path_of_ty_valid(5) != false { return 3; }
    return 0;
}

fn test_lit_from_tok() -> i32 {
    if lit_from_tok(0) != 0 { return 1; }
    if lit_from_tok(1) != 1 { return 2; }
    if lit_from_tok(2) != 3 { return 3; }
    if lit_from_tok(3) != 4 { return 4; }
    if lit_from_tok(91) != 5 { return 5; }
    if lit_from_tok(64) != 5 { return 6; }
    if lit_from_tok(5) != 0 - 1 { return 7; }
    if is_literal_tok(0) != true { return 8; }
    if is_literal_tok(5) != false { return 9; }
    return 0;
}

fn test_expr_span() -> i32 {
    if expr_has_span(0) != true { return 1; }
    if expr_has_span(27) != true { return 2; }
    if expr_has_span(28) != false { return 3; }
    if expr_has_span(0 - 1) != false { return 4; }
    return 0;
}

fn test_skip_helpers() -> i32 {
    if is_pub_token(82) != true { return 1; }
    if is_pub_token(0) != false { return 2; }
    if is_unsafe_token(93) != true { return 3; }
    if is_where_token(95) != true { return 4; }
    if is_hash_token(21) != true { return 5; }
    if is_lt_token(38) != true { return 6; }
    if is_gt_token(39) != true { return 7; }
    if generic_params_update_depth(38, 1) != 2 { return 8; }
    if generic_params_update_depth(39, 2) != 1 { return 9; }
    if generic_params_update_depth(0, 1) != 1 { return 10; }
    if generic_params_done(0) != true { return 11; }
    if generic_params_done(1) != false { return 12; }
    if where_clause_stop(8) != true { return 13; }
    if where_clause_stop(65) != true { return 14; }
    if where_clause_stop(13) != true { return 15; }
    if where_clause_stop(97) != true { return 16; }
    if where_clause_stop(0) != false { return 17; }
    return 0;
}

fn test_span_merge() -> i32 {
    if span_min(3, 5) != 3 { return 1; }
    if span_min(5, 3) != 3 { return 2; }
    if span_max(3, 5) != 5 { return 3; }
    if span_max(5, 3) != 5 { return 4; }
    if span_merge_start(10, 5) != 5 { return 5; }
    if span_merge_end(10, 20) != 20 { return 6; }
    return 0;
}

fn test_precedence() -> i32 {
    if is_cmp_token(36) != true { return 1; }
    if is_cmp_token(41) != true { return 2; }
    if is_cmp_token(22) != false { return 3; }
    if is_additive_token(22) != true { return 4; }
    if is_additive_token(23) != true { return 5; }
    if is_additive_token(24) != false { return 6; }
    if is_multiplicative_token(24) != true { return 7; }
    if is_multiplicative_token(25) != true { return 8; }
    if is_multiplicative_token(26) != true { return 9; }
    if is_multiplicative_token(22) != false { return 10; }
    if is_shift_token(42) != true { return 11; }
    if is_shift_token(43) != true { return 12; }
    if is_shift_token(22) != false { return 13; }
    if is_unary_prefix(23) != true { return 14; }
    if is_unary_prefix(33) != true { return 15; }
    if is_unary_prefix(27) != true { return 16; }
    if is_unary_prefix(0) != false { return 17; }
    return 0;
}

fn test_ty_name() -> i32 {
    if ty_is_name(0) != true { return 1; }
    if ty_is_name(1) != false { return 2; }
    return 0;
}

fn test_pratt_prec() -> i32 {
    if prec_of_binop(12) != 1 { return 1; }
    if prec_of_binop(11) != 2 { return 2; }
    if prec_of_binop(5) != 3 { return 3; }
    if prec_of_binop(10) != 3 { return 4; }
    if prec_of_binop(0) != 8 { return 5; }
    if prec_of_binop(2) != 9 { return 6; }
    if prec_of_binop(16) != 7 { return 7; }
    if is_right_assoc(0) != false { return 8; }
    if next_prec(3, false) != 4 { return 9; }
    if next_prec(3, true) != 3 { return 10; }
    if binop_is_comparison(5) != true { return 11; }
    if binop_is_comparison(0) != false { return 12; }
    if binop_is_arithmetic(0) != true { return 13; }
    if binop_is_arithmetic(2) != true { return 14; }
    if binop_is_arithmetic(5) != false { return 15; }
    if binop_is_logical(11) != true { return 16; }
    if binop_is_logical(12) != true { return 17; }
    if binop_is_logical(0) != false { return 18; }
    return 0;
}

fn test_attr_bracket() -> i32 {
    if attr_bracket_update(10, 0) != 1 { return 1; }
    if attr_bracket_update(11, 2) != 1 { return 2; }
    if attr_bracket_update(5, 1) != 1 { return 3; }
    return 0;
}

fn test_is_builtin_type_name() -> i32 {
    let src: string = "i32 bool Foo string u8";
    let starts: Vec<i32> = vec_new();
    let ends: Vec<i32> = vec_new();
    vec_push(starts, 0); vec_push(ends, 3);
    vec_push(starts, 4); vec_push(ends, 8);
    vec_push(starts, 9); vec_push(ends, 12);
    vec_push(starts, 13); vec_push(ends, 19);
    vec_push(starts, 20); vec_push(ends, 22);
    if is_builtin_type_name(src, starts, ends, 0) != true { return 1; }
    if is_builtin_type_name(src, starts, ends, 1) != true { return 2; }
    if is_builtin_type_name(src, starts, ends, 2) != false { return 3; }
    if is_builtin_type_name(src, starts, ends, 3) != true { return 4; }
    if is_builtin_type_name(src, starts, ends, 4) != true { return 5; }
    return 0;
}

