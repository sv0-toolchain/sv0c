/* Phase 2 real pipeline module: sml/lexer/lexer.sml -> sv0.
   Lexer utilities: character classification, string-based keyword
   lookup (43 keywords → canonical token tags from lexer/token.sv0),
   escape-sequence handling, lexer state management (peek/advance
   on real strings), whitespace + nested block-comment skipping,
   identifier and digit scan helpers, operator-character → tag map.
   Full tokenize (building Token list) deferred — needs Token enum
   construction and Vec-of-located-token assembly. */

/* ── character classification ───────────────────────────────── */

fn is_ident_start(c: i32) -> bool {
    if c >= 65 {
        if c <= 90 { return true; }
    }
    if c >= 97 {
        if c <= 122 { return true; }
    }
    if c == 95 { return true; }
    return false;
}

fn is_ident_cont(c: i32) -> bool {
    if is_ident_start(c) { return true; }
    if c >= 48 {
        if c <= 57 { return true; }
    }
    return false;
}

fn is_digit(c: i32) -> bool {
    if c >= 48 {
        if c <= 57 { return true; }
    }
    return false;
}

fn is_hex_digit(c: i32) -> bool {
    if is_digit(c) { return true; }
    if c >= 65 {
        if c <= 70 { return true; }
    }
    if c >= 97 {
        if c <= 102 { return true; }
    }
    return false;
}

fn is_bin_digit(c: i32) -> bool {
    if c == 48 { return true; }
    if c == 49 { return true; }
    return false;
}

fn is_oct_digit(c: i32) -> bool {
    if c >= 48 {
        if c <= 55 { return true; }
    }
    return false;
}

fn is_whitespace(c: i32) -> bool {
    if c == 32 { return true; }
    if c == 9 { return true; }
    if c == 10 { return true; }
    if c == 13 { return true; }
    return false;
}

/* ── keyword lookup (string-based, canonical token tags) ──── */

/* Token tags from lexer/token.sv0: IDENT=5, keywords 54..96. */
fn lookup_keyword(s: string) -> i32 {
    let len: i32 = string_len(s);
    if len < 2 { return 5; }
    if len > 14 { return 5; }
    let c0: i32 = string_char_at(s, 0);
    if c0 == 97 {
        if string_eq(s, "as") { return 54; }
        if string_eq(s, "assert") { return 55; }
        return 5;
    }
    if c0 == 98 {
        if string_eq(s, "borrows") { return 56; }
        if string_eq(s, "break") { return 57; }
        return 5;
    }
    if c0 == 99 {
        if string_eq(s, "const") { return 58; }
        if string_eq(s, "continue") { return 59; }
        return 5;
    }
    if c0 == 101 {
        if string_eq(s, "else") { return 60; }
        if string_eq(s, "ensures") { return 61; }
        if string_eq(s, "enum") { return 62; }
        if string_eq(s, "exists") { return 63; }
        return 5;
    }
    if c0 == 102 {
        if string_eq(s, "false") { return 64; }
        if string_eq(s, "fn") { return 65; }
        if string_eq(s, "for") { return 66; }
        if string_eq(s, "forall") { return 67; }
        return 5;
    }
    if c0 == 105 {
        if string_eq(s, "if") { return 68; }
        if string_eq(s, "impl") { return 69; }
        if string_eq(s, "in") { return 70; }
        return 5;
    }
    if c0 == 108 {
        if string_eq(s, "let") { return 71; }
        if string_eq(s, "loop") { return 72; }
        if string_eq(s, "loop_invariant") { return 73; }
        return 5;
    }
    if c0 == 109 {
        if string_eq(s, "match") { return 74; }
        if string_eq(s, "module") { return 75; }
        if string_eq(s, "move") { return 76; }
        if string_eq(s, "mut") { return 77; }
        return 5;
    }
    if c0 == 110 {
        if string_eq(s, "newtype") { return 78; }
        if string_eq(s, "no_alias") { return 79; }
        return 5;
    }
    if c0 == 111 {
        if string_eq(s, "old") { return 80; }
        return 5;
    }
    if c0 == 112 {
        if string_eq(s, "project") { return 81; }
        if string_eq(s, "pub") { return 82; }
        return 5;
    }
    if c0 == 114 {
        if string_eq(s, "requires") { return 83; }
        if string_eq(s, "result") { return 84; }
        if string_eq(s, "return") { return 85; }
        return 5;
    }
    if c0 == 115 {
        if string_eq(s, "self") { return 86; }
        if string_eq(s, "static") { return 88; }
        if string_eq(s, "struct") { return 89; }
        return 5;
    }
    if c0 == 83 {
        if string_eq(s, "Self") { return 87; }
        return 5;
    }
    if c0 == 116 {
        if string_eq(s, "trait") { return 90; }
        if string_eq(s, "true") { return 91; }
        if string_eq(s, "type") { return 92; }
        return 5;
    }
    if c0 == 117 {
        if string_eq(s, "unsafe") { return 93; }
        if string_eq(s, "use") { return 94; }
        return 5;
    }
    if c0 == 119 {
        if string_eq(s, "where") { return 95; }
        if string_eq(s, "while") { return 96; }
        return 5;
    }
    return 5;
}

/* ── escape handling ────────────────────────────────────────── */

fn escape_char(c: i32) -> i32 {
    if c == 110 { return 10; }
    if c == 116 { return 9; }
    if c == 114 { return 13; }
    if c == 92 { return 92; }
    if c == 34 { return 34; }
    if c == 39 { return 39; }
    if c == 48 { return 0; }
    return c;
}

fn hex_digit_value(c: i32) -> i32 {
    if c >= 48 {
        if c <= 57 { return c - 48; }
    }
    if c >= 65 {
        if c <= 70 { return c - 55; }
    }
    if c >= 97 {
        if c <= 102 { return c - 87; }
    }
    return 0;
}

fn hex_escape_value(d1: i32, d2: i32) -> i32 {
    return hex_digit_value(d1) * 16 + hex_digit_value(d2);
}

/* ── lexer state (real string operations) ───────────────────── */

fn lex_at_end(source: string, pos: i32) -> bool {
    return pos >= string_len(source);
}

fn lex_peek(source: string, pos: i32) -> i32 {
    if pos >= string_len(source) { return 0 - 1; }
    return string_char_at(source, pos);
}

fn lex_peek_at(source: string, pos: i32, offset: i32) -> i32 {
    let i: i32 = pos + offset;
    if i < 0 { return 0 - 1; }
    if i >= string_len(source) { return 0 - 1; }
    return string_char_at(source, i);
}

fn advance_line(line: i32, c: i32) -> i32 {
    if c == 10 { return line + 1; }
    return line;
}

fn advance_col(col: i32, c: i32) -> i32 {
    if c == 10 { return 1; }
    return col + 1;
}

/* ── whitespace and comment skipping ────────────────────────── */

fn skip_ws(source: string, pos: i32) -> i32 {
    let len: i32 = string_len(source);
    let mut p: i32 = pos;
    while p < len {
        let c: i32 = string_char_at(source, p);
        if is_whitespace(c) != true { return p; }
        p = p + 1;
    }
    return p;
}

fn skip_line_comment(source: string, pos: i32) -> i32 {
    let len: i32 = string_len(source);
    let mut p: i32 = pos;
    while p < len {
        let c: i32 = string_char_at(source, p);
        if c == 10 { return p; }
        p = p + 1;
    }
    return p;
}

fn skip_block_comment(source: string, pos: i32, depth: i32) -> i32 {
    let len: i32 = string_len(source);
    let mut p: i32 = pos;
    let mut d: i32 = depth;
    while d > 0 {
        if p >= len { return p; }
        let c: i32 = string_char_at(source, p);
        let nx: i32 = lex_peek_at(source, p, 1);
        if c == 47 {
            if nx == 42 { d = d + 1; p = p + 2; }
            else { p = p + 1; }
        } else {
            if c == 42 {
                if nx == 47 { d = d - 1; p = p + 2; }
                else { p = p + 1; }
            } else {
                p = p + 1;
            }
        }
    }
    return p;
}

fn skip_all(source: string, pos: i32) -> i32 {
    let len: i32 = string_len(source);
    let mut p: i32 = skip_ws(source, pos);
    let mut done: bool = false;
    while done != true {
        if p >= len { return p; }
        let c: i32 = string_char_at(source, p);
        if c == 47 {
            let nx: i32 = lex_peek_at(source, p, 1);
            if nx == 47 {
                p = skip_line_comment(source, p + 2);
                p = skip_ws(source, p);
            } else {
                if nx == 42 {
                    p = skip_block_comment(source, p + 2, 1);
                    p = skip_ws(source, p);
                } else {
                    done = true;
                }
            }
        } else {
            done = true;
        }
    }
    return p;
}

/* ── identifier scanning ────────────────────────────────────── */

fn scan_ident_end(source: string, pos: i32) -> i32 {
    let len: i32 = string_len(source);
    let mut p: i32 = pos;
    while p < len {
        let c: i32 = string_char_at(source, p);
        if is_ident_cont(c) != true { return p; }
        p = p + 1;
    }
    return p;
}

/* ── digit scanning ─────────────────────────────────────────── */

fn scan_dec_digits_end(source: string, pos: i32) -> i32 {
    let len: i32 = string_len(source);
    let mut p: i32 = pos;
    while p < len {
        let c: i32 = string_char_at(source, p);
        if is_digit(c) != true {
            if c != 95 { return p; }
        }
        p = p + 1;
    }
    return p;
}

fn scan_hex_digits_end(source: string, pos: i32) -> i32 {
    let len: i32 = string_len(source);
    let mut p: i32 = pos;
    while p < len {
        let c: i32 = string_char_at(source, p);
        if is_hex_digit(c) != true {
            if c != 95 { return p; }
        }
        p = p + 1;
    }
    return p;
}

fn scan_bin_digits_end(source: string, pos: i32) -> i32 {
    let len: i32 = string_len(source);
    let mut p: i32 = pos;
    while p < len {
        let c: i32 = string_char_at(source, p);
        if is_bin_digit(c) != true {
            if c != 95 { return p; }
        }
        p = p + 1;
    }
    return p;
}

fn scan_oct_digits_end(source: string, pos: i32) -> i32 {
    let len: i32 = string_len(source);
    let mut p: i32 = pos;
    while p < len {
        let c: i32 = string_char_at(source, p);
        if is_oct_digit(c) != true {
            if c != 95 { return p; }
        }
        p = p + 1;
    }
    return p;
}

/* ── operator character → token tag ─────────────────────────── */

/* Single-char operator/delimiter → tag. Returns 0 for unknown. */
fn op_single_tag(c: i32) -> i32 {
    if c == 40 { return 6; }
    if c == 41 { return 7; }
    if c == 123 { return 8; }
    if c == 125 { return 9; }
    if c == 91 { return 10; }
    if c == 93 { return 11; }
    if c == 44 { return 12; }
    if c == 59 { return 13; }
    if c == 35 { return 21; }
    if c == 126 { return 32; }
    if c == 63 { return 34; }
    return 0;
}

/* Two-char operator pair → tag. Returns 0 for unrecognized. */
fn op_double_tag(c1: i32, c2: i32) -> i32 {
    if c1 == 58 {
        if c2 == 58 { return 15; }
        return 0;
    }
    if c1 == 46 {
        if c2 == 46 { return 17; }
        return 0;
    }
    if c1 == 43 {
        if c2 == 61 { return 44; }
        return 0;
    }
    if c1 == 45 {
        if c2 == 62 { return 19; }
        if c2 == 61 { return 45; }
        return 0;
    }
    if c1 == 42 {
        if c2 == 61 { return 46; }
        return 0;
    }
    if c1 == 47 {
        if c2 == 61 { return 47; }
        return 0;
    }
    if c1 == 37 {
        if c2 == 61 { return 48; }
        return 0;
    }
    if c1 == 61 {
        if c2 == 61 { return 36; }
        if c2 == 62 { return 20; }
        return 0;
    }
    if c1 == 33 {
        if c2 == 61 { return 37; }
        return 0;
    }
    if c1 == 60 {
        if c2 == 61 { return 40; }
        if c2 == 60 { return 42; }
        return 0;
    }
    if c1 == 62 {
        if c2 == 61 { return 41; }
        if c2 == 62 { return 43; }
        return 0;
    }
    if c1 == 38 {
        if c2 == 38 { return 28; }
        if c2 == 61 { return 49; }
        return 0;
    }
    if c1 == 124 {
        if c2 == 124 { return 30; }
        if c2 == 61 { return 50; }
        return 0;
    }
    if c1 == 94 {
        if c2 == 61 { return 51; }
        return 0;
    }
    return 0;
}

/* Fallback single-char tags for chars that also start 2-char ops. */
fn op_fallback_tag(c: i32) -> i32 {
    if c == 58 { return 14; }
    if c == 46 { return 16; }
    if c == 43 { return 22; }
    if c == 45 { return 23; }
    if c == 42 { return 24; }
    if c == 47 { return 25; }
    if c == 37 { return 26; }
    if c == 38 { return 27; }
    if c == 124 { return 29; }
    if c == 94 { return 31; }
    if c == 33 { return 33; }
    if c == 61 { return 35; }
    if c == 60 { return 38; }
    if c == 62 { return 39; }
    return 0;
}

/* ── tests ──────────────────────────────────────────────────── */

fn test_char_class() -> i32 {
    if is_ident_start(65) != true { return 1; }
    if is_ident_start(95) != true { return 2; }
    if is_ident_start(48) != false { return 3; }
    if is_ident_cont(48) != true { return 4; }
    if is_ident_cont(32) != false { return 5; }
    if is_digit(48) != true { return 6; }
    if is_digit(57) != true { return 7; }
    if is_digit(65) != false { return 8; }
    if is_hex_digit(65) != true { return 9; }
    if is_hex_digit(103) != false { return 10; }
    if is_bin_digit(48) != true { return 11; }
    if is_bin_digit(50) != false { return 12; }
    if is_oct_digit(55) != true { return 13; }
    if is_oct_digit(56) != false { return 14; }
    if is_whitespace(32) != true { return 15; }
    if is_whitespace(65) != false { return 16; }
    return 0;
}

fn test_keyword_lookup() -> i32 {
    if lookup_keyword("fn") != 65 { return 1; }
    if lookup_keyword("let") != 71 { return 2; }
    if lookup_keyword("if") != 68 { return 3; }
    if lookup_keyword("while") != 96 { return 4; }
    if lookup_keyword("struct") != 89 { return 5; }
    if lookup_keyword("enum") != 62 { return 6; }
    if lookup_keyword("return") != 85 { return 7; }
    if lookup_keyword("Self") != 87 { return 8; }
    if lookup_keyword("self") != 86 { return 9; }
    if lookup_keyword("loop_invariant") != 73 { return 10; }
    if lookup_keyword("foo") != 5 { return 11; }
    if lookup_keyword("x") != 5 { return 12; }
    if lookup_keyword("letter") != 5 { return 13; }
    if lookup_keyword("true") != 91 { return 14; }
    if lookup_keyword("false") != 64 { return 15; }
    return 0;
}

fn test_escape() -> i32 {
    if escape_char(110) != 10 { return 1; }
    if escape_char(116) != 9 { return 2; }
    if escape_char(114) != 13 { return 3; }
    if escape_char(92) != 92 { return 4; }
    if escape_char(34) != 34 { return 5; }
    if escape_char(48) != 0 { return 6; }
    if hex_digit_value(48) != 0 { return 7; }
    if hex_digit_value(57) != 9 { return 8; }
    if hex_digit_value(65) != 10 { return 9; }
    if hex_escape_value(52, 49) != 65 { return 10; }
    return 0;
}

fn test_state() -> i32 {
    let src: string = "hello";
    if lex_at_end(src, 0) != false { return 1; }
    if lex_at_end(src, 5) != true { return 2; }
    if lex_peek(src, 0) != 104 { return 3; }
    if lex_peek(src, 4) != 111 { return 4; }
    if lex_peek(src, 5) != 0 - 1 { return 5; }
    if lex_peek_at(src, 0, 1) != 101 { return 6; }
    if lex_peek_at(src, 4, 1) != 0 - 1 { return 7; }
    if advance_line(1, 65) != 1 { return 8; }
    if advance_line(1, 10) != 2 { return 9; }
    if advance_col(5, 65) != 6 { return 10; }
    if advance_col(5, 10) != 1 { return 11; }
    return 0;
}

fn test_skip_ws() -> i32 {
    let s1: string = "  hello";
    if skip_ws(s1, 0) != 2 { return 1; }
    let s2: string = "abc";
    if skip_ws(s2, 0) != 0 { return 2; }
    let s3: string = "   ";
    if skip_ws(s3, 0) != 3 { return 3; }
    return 0;
}

fn test_skip_line_comment() -> i32 {
    let src: string = "comment here\nnext";
    let end: i32 = skip_line_comment(src, 0);
    if end != 12 { return 1; }
    return 0;
}

fn test_skip_block_comment() -> i32 {
    let src: string = "inner */ rest";
    let end: i32 = skip_block_comment(src, 0, 1);
    if end != 8 { return 1; }
    return 0;
}

fn test_skip_all() -> i32 {
    let s1: string = "  fn";
    if skip_all(s1, 0) != 2 { return 1; }
    let s2: string = "// comment\nfn";
    if skip_all(s2, 0) != 11 { return 2; }
    let s3: string = "/* block */ fn";
    if skip_all(s3, 0) != 12 { return 3; }
    return 0;
}

fn test_scan_ident() -> i32 {
    let s1: string = "hello world";
    if scan_ident_end(s1, 0) != 5 { return 1; }
    let s2: string = "x123+y";
    if scan_ident_end(s2, 0) != 4 { return 2; }
    let s3: string = "_foo bar";
    if scan_ident_end(s3, 0) != 4 { return 3; }
    return 0;
}

fn test_scan_digits() -> i32 {
    let s1: string = "12345abc";
    if scan_dec_digits_end(s1, 0) != 5 { return 1; }
    let s2: string = "ff00gg";
    if scan_hex_digits_end(s2, 0) != 4 { return 2; }
    let s3: string = "0110x";
    if scan_bin_digits_end(s3, 0) != 4 { return 3; }
    let s4: string = "3778";
    if scan_oct_digits_end(s4, 0) != 3 { return 4; }
    let s5: string = "1_000_000x";
    if scan_dec_digits_end(s5, 0) != 9 { return 5; }
    return 0;
}

fn test_op_tags() -> i32 {
    if op_single_tag(40) != 6 { return 1; }
    if op_single_tag(41) != 7 { return 2; }
    if op_single_tag(44) != 12 { return 3; }
    if op_single_tag(65) != 0 { return 4; }
    if op_double_tag(61, 61) != 36 { return 5; }
    if op_double_tag(45, 62) != 19 { return 6; }
    if op_double_tag(60, 60) != 42 { return 7; }
    if op_double_tag(65, 66) != 0 { return 8; }
    if op_fallback_tag(43) != 22 { return 9; }
    if op_fallback_tag(61) != 35 { return 10; }
    if op_fallback_tag(65) != 0 { return 11; }
    return 0;
}

fn main() -> i32 {
    let r1: i32 = test_char_class();
    if r1 != 0 { return r1; }
    let r2: i32 = test_keyword_lookup();
    if r2 != 0 { return 100 + r2; }
    let r3: i32 = test_escape();
    if r3 != 0 { return 120 + r3; }
    let r4: i32 = test_state();
    if r4 != 0 { return 130 + r4; }
    let r5: i32 = test_skip_ws();
    if r5 != 0 { return 140 + r5; }
    let r6: i32 = test_skip_line_comment();
    if r6 != 0 { return 150 + r6; }
    let r7: i32 = test_skip_block_comment();
    if r7 != 0 { return 160 + r7; }
    let r8: i32 = test_skip_all();
    if r8 != 0 { return 170 + r8; }
    let r9: i32 = test_scan_ident();
    if r9 != 0 { return 180 + r9; }
    let r10: i32 = test_scan_digits();
    if r10 != 0 { return 190 + r10; }
    let r11: i32 = test_op_tags();
    if r11 != 0 { return 200 + r11; }
    return 0;
}
