/* Phase 2 real pipeline module: sml/error/diagnostic.sml -> sv0.
   Covers: severity datatype, constructors, severityToString, hasErrors,
   errorCount, ordering, string formatting helpers (spaces, carets,
   padLeft, getLine), Vec-based diagnostic list (parallel Vecs for sev/
   line/col/message), sort-by-span (insertion sort on line+col),
   format_header, format_snippet, format_diagnostic (combines header +
   location + snippet into a single formatted string, matching SML's
   `format source d`), int_to_str for line/col rendering,
   format_header_with_code (SML `codeStr` bracket — "[E0001]"),
   format_related (SML `relatedStr` — "= note: ... at file:l:c"),
   format_help (SML `helpStr` — "= help: ..."),
   format_gutter (SML `gutter`/`blank` — numbered + blank gutter lines),
   format_snippet_numbered (SML full numbered snippet with gutter).
   Remaining: full report/reportAll (I/O output). */

enum Severity { Error, Warning, Note }

fn severity_tag(s: Severity) -> i32 {
    match s {
        Severity::Error => { return 0; },
        Severity::Warning => { return 1; },
        Severity::Note => { return 2; },
    }
}

fn make_error(code: i32, message: i32, span_line: i32) -> Severity {
    return Severity::Error;
}

fn make_warning(code: i32, message: i32, span_line: i32) -> Severity {
    return Severity::Warning;
}

fn make_note(message: i32, span_line: i32) -> Severity {
    return Severity::Note;
}

fn is_error(s: Severity) -> bool {
    match s {
        Severity::Error => { return true; },
        _ => { return false; },
    }
}

fn has_errors(count: i32) -> bool {
    return count > 0;
}

fn error_count(e0: i32, e1: i32, e2: i32, e3: i32) -> i32 {
    let mut count: i32 = 0;
    if e0 == 0 { count = count + 1; }
    if e1 == 0 { count = count + 1; }
    if e2 == 0 { count = count + 1; }
    if e3 == 0 { count = count + 1; }
    return count;
}

fn severity_to_string(s: Severity) -> string {
    let tag: i32 = severity_tag(s);
    if tag == 0 { return "error"; }
    if tag == 1 { return "warning"; }
    return "note";
}

fn spaces(n: i32) -> string {
    if n <= 0 { return ""; }
    let mut out: string = "";
    let mut i: i32 = 0;
    while i < n {
        out = string_concat(out, " ");
        i = i + 1;
    }
    return out;
}

fn carets(n: i32) -> string {
    let mut effective: i32 = n;
    if effective < 1 { effective = 1; }
    let mut out: string = "";
    let mut i: i32 = 0;
    while i < effective {
        out = string_concat(out, "^");
        i = i + 1;
    }
    return out;
}

fn pad_left(s: string, width: i32) -> string {
    let slen: i32 = string_len(s);
    let pad: i32 = width - slen;
    if pad <= 0 { return s; }
    let prefix: string = spaces(pad);
    return string_concat(prefix, s);
}

fn get_line(source: string, line_no: i32) -> string {
    if line_no < 1 { return ""; }
    let slen: i32 = string_len(source);
    let mut i: i32 = 0;
    let mut start: i32 = 0;
    let mut cur_line: i32 = 1;
    while i <= slen {
        let at_end: bool = i == slen;
        let mut is_nl: bool = false;
        if at_end != true {
            let c: i32 = string_char_at(source, i);
            if c == 10 { is_nl = true; }
        }
        if at_end == true {
            if cur_line == line_no {
                return string_substr(source, start, i - start);
            }
            return "";
        }
        if is_nl == true {
            if cur_line == line_no {
                return string_substr(source, start, i - start);
            }
            cur_line = cur_line + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn severity_ord(a: Severity, b: Severity) -> i32 {
    let ta: i32 = severity_tag(a);
    let tb: i32 = severity_tag(b);
    if ta < tb { return 0; }
    if ta == tb { return 1; }
    return 2;
}

/* ── Vec-based diagnostic list ──────────────────────────────────
   Parallel Vecs: sevs (i32 severity tag), lines (i32 line),
   cols (i32 col), msgs (i32 interned message handle).
   All have the same length; index i is diagnostic i. */

fn diag_list_len(sevs: Vec<i32>) -> i32 {
    return vec_len(sevs);
}

fn diag_list_push(sevs: Vec<i32>, lines: Vec<i32>, cols: Vec<i32>,
                  msgs: Vec<i32>, sev: i32, line: i32, col: i32,
                  msg: i32) -> i32 {
    vec_push(sevs, sev);
    vec_push(lines, line);
    vec_push(cols, col);
    vec_push(msgs, msg);
    return vec_len(sevs);
}

fn diag_list_has_errors(sevs: Vec<i32>) -> bool {
    let n: i32 = vec_len(sevs);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(sevs, i) == 0 { return true; }
        i = i + 1;
    }
    return false;
}

fn diag_list_error_count(sevs: Vec<i32>) -> i32 {
    let n: i32 = vec_len(sevs);
    let mut count: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        if vec_get(sevs, i) == 0 { count = count + 1; }
        i = i + 1;
    }
    return count;
}

/* ── sort-by-span (insertion sort on line then col) ──────────── */

fn diag_span_less(lines: Vec<i32>, cols: Vec<i32>, a: i32, b: i32) -> bool {
    let la: i32 = vec_get(lines, a);
    let lb: i32 = vec_get(lines, b);
    if la < lb { return true; }
    if la > lb { return false; }
    return vec_get(cols, a) < vec_get(cols, b);
}

fn diag_sort_by_span(sevs: Vec<i32>, lines: Vec<i32>, cols: Vec<i32>,
                     msgs: Vec<i32>, order: Vec<i32>) -> i32 {
    let n: i32 = vec_len(sevs);
    let mut i: i32 = 0;
    while i < n {
        vec_push(order, i);
        i = i + 1;
    }
    let mut i2: i32 = 1;
    while i2 < n {
        let key: i32 = vec_get(order, i2);
        let mut j: i32 = i2 - 1;
        let mut shifting: bool = true;
        while shifting {
            if j < 0 { shifting = false; }
            else {
                let cur: i32 = vec_get(order, j);
                if diag_span_less(lines, cols, key, cur) {
                    vec_set(order, j + 1, cur);
                    j = j - 1;
                } else { shifting = false; }
            }
        }
        vec_set(order, j + 1, key);
        i2 = i2 + 1;
    }
    return n;
}

/* ── format helpers ────────────────────────────────────────────
   format_header: "error: message" or "warning: message"
   format_snippet: source line with underline carets */

fn format_header(sev_tag: i32, message: string) -> string {
    let mut out: string = "";
    if sev_tag == 0 { out = "error"; }
    if sev_tag == 1 { out = "warning"; }
    if sev_tag == 2 { out = "note"; }
    out = string_concat(out, ": ");
    out = string_concat(out, message);
    return out;
}

fn format_snippet(source: string, line_no: i32, col: i32, span_len: i32) -> string {
    let line_text: string = get_line(source, line_no);
    if string_len(line_text) == 0 { return ""; }
    let mut effective_span: i32 = span_len;
    if effective_span < 1 { effective_span = 1; }
    let mut out: string = "  | ";
    out = string_concat(out, line_text);
    out = string_concat(out, "\n");
    out = string_concat(out, "  | ");
    let col_offset: i32 = col - 1;
    if col_offset > 0 {
        out = string_concat(out, spaces(col_offset));
    }
    out = string_concat(out, carets(effective_span));
    return out;
}

fn digit_char(d: i32) -> string {
    if d == 0 { return "0"; }
    if d == 1 { return "1"; }
    if d == 2 { return "2"; }
    if d == 3 { return "3"; }
    if d == 4 { return "4"; }
    if d == 5 { return "5"; }
    if d == 6 { return "6"; }
    if d == 7 { return "7"; }
    if d == 8 { return "8"; }
    return "9";
}

fn diag_int_to_str(n: i32) -> string {
    if n < 0 {
        let pos: i32 = 0 - n;
        return string_concat("-", diag_int_to_str(pos));
    }
    if n < 10 { return digit_char(n); }
    let rest: i32 = n / 10;
    let last: i32 = n - rest * 10;
    return string_concat(diag_int_to_str(rest), digit_char(last));
}

fn format_location(file: string, line: i32, col: i32) -> string {
    let mut out: string = "  --> ";
    if string_len(file) > 0 {
        out = string_concat(out, file);
        out = string_concat(out, ":");
    }
    out = string_concat(out, diag_int_to_str(line));
    out = string_concat(out, ":");
    out = string_concat(out, diag_int_to_str(col));
    return out;
}

fn format_diagnostic(sev_tag: i32, message: string, file: string,
                     source: string, line: i32, col: i32,
                     span_len: i32) -> string {
    let header: string = format_header(sev_tag, message);
    let loc: string = format_location(file, line, col);
    let mut out: string = string_concat(header, "\n");
    out = string_concat(out, loc);
    out = string_concat(out, "\n");
    let snippet: string = format_snippet(source, line, col, span_len);
    if string_len(snippet) > 0 {
        out = string_concat(out, snippet);
        out = string_concat(out, "\n");
    }
    return out;
}

/* SML format: codeStr = if code = "" then "" else "[" ^ code ^ "]" */
fn format_header_with_code(sev_tag: i32, message: string, code: string) -> string {
    let mut out: string = "";
    if sev_tag == 0 { out = "error"; }
    if sev_tag == 1 { out = "warning"; }
    if sev_tag == 2 { out = "note"; }
    if string_len(code) > 0 {
        out = string_concat(out, "[");
        out = string_concat(out, code);
        out = string_concat(out, "]");
    }
    out = string_concat(out, ": ");
    out = string_concat(out, message);
    return out;
}

/* SML format: gutter = spaces gutterWidth ^ " | " */
fn format_gutter(gutter_width: i32) -> string {
    let pad: string = spaces(gutter_width);
    return string_concat(pad, " | ");
}

/* SML format: numbered = padLeft(lineStr, gutterWidth) ^ " | " ^ srcLine */
fn format_snippet_numbered(source: string, line_no: i32,
                           col: i32, span_len: i32) -> string {
    let line_text: string = get_line(source, line_no);
    if string_len(line_text) == 0 { return ""; }
    let mut effective_span: i32 = span_len;
    if effective_span < 1 { effective_span = 1; }
    let line_str: string = diag_int_to_str(line_no);
    let ls_len: i32 = string_len(line_str);
    let mut gw: i32 = ls_len;
    if gw < 2 { gw = 2; }
    let gutter: string = format_gutter(gw);
    let blank: string = string_concat(gutter, "\n");
    let numbered: string = string_concat(
        string_concat(pad_left(line_str, gw), " | "),
        string_concat(line_text, "\n"));
    let col_offset: i32 = col - 1;
    let mut underline: string = gutter;
    if col_offset > 0 {
        underline = string_concat(underline, spaces(col_offset));
    }
    underline = string_concat(underline, carets(effective_span));
    underline = string_concat(underline, "\n");
    return string_concat(blank, string_concat(numbered, underline));
}

/* SML format: relatedStr — each (msg, file, line, col) →
   gutter ^ "= note: " ^ msg ^ " at " ^ file ^ ":" ^ line ^ ":" ^ col */
fn format_related(gutter_width: i32, msg: string, file: string,
                  line: i32, col: i32) -> string {
    let gutter: string = format_gutter(gutter_width);
    let mut out: string = gutter;
    out = string_concat(out, "= note: ");
    out = string_concat(out, msg);
    out = string_concat(out, " at ");
    out = string_concat(out, file);
    out = string_concat(out, ":");
    out = string_concat(out, diag_int_to_str(line));
    out = string_concat(out, ":");
    out = string_concat(out, diag_int_to_str(col));
    out = string_concat(out, "\n");
    return out;
}

/* SML format: helpStr — each h → gutter ^ "= help: " ^ h */
fn format_help(gutter_width: i32, help_text: string) -> string {
    let gutter: string = format_gutter(gutter_width);
    let mut out: string = gutter;
    out = string_concat(out, "= help: ");
    out = string_concat(out, help_text);
    out = string_concat(out, "\n");
    return out;
}

/* ── format_diagnostic_full (SML format with code bracket) ────── */
/* Combines header_with_code + location + snippet_numbered into
   a single string matching SML's `format source d`. */

fn format_diagnostic_full(sev_tag: i32, message: string, code: string,
                          file: string, source: string,
                          line: i32, col: i32,
                          span_len: i32) -> string {
    let header: string = format_header_with_code(sev_tag, message, code);
    let loc: string = format_location(file, line, col);
    let mut out: string = string_concat(header, "\n");
    out = string_concat(out, loc);
    out = string_concat(out, "\n");
    let snippet: string = format_snippet_numbered(source, line, col, span_len);
    if string_len(snippet) > 0 {
        out = string_concat(out, snippet);
    }
    out = string_concat(out, "\n");
    return out;
}

fn test_severity_tags() -> i32 {
    if severity_tag(Severity::Error) != 0 { return 1; }
    if severity_tag(Severity::Warning) != 1 { return 2; }
    if severity_tag(Severity::Note) != 2 { return 3; }
    return 0;
}

fn test_constructors() -> i32 {
    let e: Severity = make_error(400, 1, 10);
    if is_error(e) != true { return 1; }
    let w: Severity = make_warning(401, 2, 20);
    if is_error(w) != false { return 2; }
    let n: Severity = make_note(3, 30);
    if is_error(n) != false { return 3; }
    return 0;
}

fn test_has_errors() -> i32 {
    if has_errors(0) != false { return 1; }
    if has_errors(1) != true { return 2; }
    if has_errors(5) != true { return 3; }
    return 0;
}

fn test_error_count() -> i32 {
    if error_count(0, 0, 0, 0) != 4 { return 1; }
    if error_count(0, 1, 0, 1) != 2 { return 2; }
    if error_count(1, 1, 1, 1) != 0 { return 3; }
    if error_count(0, 1, 1, 1) != 1 { return 4; }
    return 0;
}

fn test_severity_ord() -> i32 {
    if severity_ord(Severity::Error, Severity::Warning) != 0 { return 1; }
    if severity_ord(Severity::Error, Severity::Error) != 1 { return 2; }
    if severity_ord(Severity::Warning, Severity::Error) != 2 { return 3; }
    if severity_ord(Severity::Note, Severity::Error) != 2 { return 4; }
    if severity_ord(Severity::Error, Severity::Note) != 0 { return 5; }
    return 0;
}

fn test_severity_to_string() -> i32 {
    if string_eq(severity_to_string(Severity::Error), "error") != true { return 1; }
    if string_eq(severity_to_string(Severity::Warning), "warning") != true { return 2; }
    if string_eq(severity_to_string(Severity::Note), "note") != true { return 3; }
    return 0;
}

fn test_spaces() -> i32 {
    if string_eq(spaces(0), "") != true { return 1; }
    if string_len(spaces(3)) != 3 { return 2; }
    if string_eq(spaces(1), " ") != true { return 3; }
    return 0;
}

fn test_carets() -> i32 {
    if string_eq(carets(3), "^^^") != true { return 1; }
    if string_eq(carets(1), "^") != true { return 2; }
    if string_eq(carets(0), "^") != true { return 3; }
    return 0;
}

fn test_pad_left() -> i32 {
    let r1: string = pad_left("42", 5);
    if string_len(r1) != 5 { return 1; }
    if string_eq(pad_left("hello", 3), "hello") != true { return 2; }
    if string_eq(pad_left("x", 1), "x") != true { return 3; }
    return 0;
}

fn test_get_line() -> i32 {
    let src: string = "alpha\nbeta\ngamma";
    if string_eq(get_line(src, 1), "alpha") != true { return 1; }
    if string_eq(get_line(src, 2), "beta") != true { return 2; }
    if string_eq(get_line(src, 3), "gamma") != true { return 3; }
    if string_eq(get_line(src, 4), "") != true { return 4; }
    if string_eq(get_line(src, 0), "") != true { return 5; }
    if string_eq(get_line("single", 1), "single") != true { return 6; }
    return 0;
}

fn test_diag_list() -> i32 {
    let sevs: Vec<i32> = vec_new();
    let lines: Vec<i32> = vec_new();
    let cols: Vec<i32> = vec_new();
    let msgs: Vec<i32> = vec_new();
    if diag_list_has_errors(sevs) != false { return 1; }
    if diag_list_error_count(sevs) != 0 { return 2; }
    diag_list_push(sevs, lines, cols, msgs, 1, 5, 3, 100);
    if diag_list_has_errors(sevs) != false { return 3; }
    diag_list_push(sevs, lines, cols, msgs, 0, 2, 10, 200);
    if diag_list_has_errors(sevs) != true { return 4; }
    if diag_list_error_count(sevs) != 1 { return 5; }
    diag_list_push(sevs, lines, cols, msgs, 0, 8, 1, 300);
    if diag_list_error_count(sevs) != 2 { return 6; }
    if diag_list_len(sevs) != 3 { return 7; }
    return 0;
}

fn test_diag_sort() -> i32 {
    let sevs: Vec<i32> = vec_new();
    let lines: Vec<i32> = vec_new();
    let cols: Vec<i32> = vec_new();
    let msgs: Vec<i32> = vec_new();
    diag_list_push(sevs, lines, cols, msgs, 0, 10, 5, 1);
    diag_list_push(sevs, lines, cols, msgs, 1, 2, 3, 2);
    diag_list_push(sevs, lines, cols, msgs, 0, 2, 1, 3);
    diag_list_push(sevs, lines, cols, msgs, 0, 10, 2, 4);
    let order: Vec<i32> = vec_new();
    diag_sort_by_span(sevs, lines, cols, msgs, order);
    if vec_get(order, 0) != 2 { return 1; }
    if vec_get(order, 1) != 1 { return 2; }
    if vec_get(order, 2) != 3 { return 3; }
    if vec_get(order, 3) != 0 { return 4; }
    return 0;
}

fn test_format_header() -> i32 {
    let h1: string = format_header(0, "undeclared variable");
    if string_eq(h1, "error: undeclared variable") != true { return 1; }
    let h2: string = format_header(1, "unused import");
    if string_eq(h2, "warning: unused import") != true { return 2; }
    let h3: string = format_header(2, "defined here");
    if string_eq(h3, "note: defined here") != true { return 3; }
    return 0;
}

fn test_format_snippet() -> i32 {
    let src: string = "let x = 42;\nlet y = x + 1;";
    let snip: string = format_snippet(src, 1, 5, 1);
    if string_len(snip) == 0 { return 1; }
    let empty: string = format_snippet(src, 99, 1, 1);
    if string_len(empty) != 0 { return 2; }
    return 0;
}

fn test_diag_int_to_str() -> i32 {
    if string_eq(diag_int_to_str(0), "0") != true { return 1; }
    if string_eq(diag_int_to_str(42), "42") != true { return 2; }
    if string_eq(diag_int_to_str(100), "100") != true { return 3; }
    if string_eq(diag_int_to_str(7), "7") != true { return 4; }
    return 0;
}

fn test_format_location() -> i32 {
    let loc1: string = format_location("test.sv0", 5, 3);
    if string_eq(loc1, "  --> test.sv0:5:3") != true { return 1; }
    let loc2: string = format_location("", 10, 1);
    if string_eq(loc2, "  --> 10:1") != true { return 2; }
    return 0;
}

fn test_format_diagnostic() -> i32 {
    let src: string = "let x = 42;";
    let fd: string = format_diagnostic(0, "undeclared variable", "test.sv0",
                                       src, 1, 5, 1);
    if string_len(fd) == 0 { return 1; }
    let fd_empty: string = format_diagnostic(1, "unused", "f.sv0", "", 99, 1, 1);
    if string_len(fd_empty) == 0 { return 2; }
    return 0;
}

fn test_format_header_with_code() -> i32 {
    let h1: string = format_header_with_code(0, "bad type", "E0001");
    if string_eq(h1, "error[E0001]: bad type") != true { return 1; }
    let h2: string = format_header_with_code(1, "unused", "");
    if string_eq(h2, "warning: unused") != true { return 2; }
    let h3: string = format_header_with_code(2, "see here", "N42");
    if string_eq(h3, "note[N42]: see here") != true { return 3; }
    return 0;
}

fn test_format_gutter() -> i32 {
    let g2: string = format_gutter(2);
    if string_eq(g2, "   | ") != true { return 1; }
    let g4: string = format_gutter(4);
    if string_eq(g4, "     | ") != true { return 2; }
    return 0;
}

fn test_format_related() -> i32 {
    let rel: string = format_related(2, "defined here", "foo.sv0", 5, 3);
    let expected: string = "   | = note: defined here at foo.sv0:5:3\n";
    if string_eq(rel, expected) != true { return 1; }
    return 0;
}

fn test_format_help() -> i32 {
    let hlp: string = format_help(2, "try adding mut");
    let expected: string = "   | = help: try adding mut\n";
    if string_eq(hlp, expected) != true { return 1; }
    return 0;
}

fn test_format_diagnostic_full() -> i32 {
    let src: string = "let x = 42;";
    let fd: string = format_diagnostic_full(0, "undeclared variable", "E0401",
                                            "test.sv0", src, 1, 5, 1);
    if string_len(fd) == 0 { return 1; }
    let fd2: string = format_diagnostic_full(1, "unused", "", "f.sv0", "", 99, 1, 1);
    if string_len(fd2) == 0 { return 2; }
    let fd3: string = format_diagnostic_full(0, "bad type", "E0400",
                                             "m.sv0", "fn main() {", 1, 4, 4);
    if string_len(fd3) == 0 { return 3; }
    return 0;
}

fn main() -> i32 {
    let r1: i32 = test_severity_tags();
    if r1 != 0 { return r1; }
    let r2: i32 = test_constructors();
    if r2 != 0 { return 10 + r2; }
    let r3: i32 = test_has_errors();
    if r3 != 0 { return 20 + r3; }
    let r4: i32 = test_error_count();
    if r4 != 0 { return 30 + r4; }
    let r5: i32 = test_severity_ord();
    if r5 != 0 { return 40 + r5; }
    let r6: i32 = test_severity_to_string();
    if r6 != 0 { return 50 + r6; }
    let r7: i32 = test_spaces();
    if r7 != 0 { return 60 + r7; }
    let r8: i32 = test_carets();
    if r8 != 0 { return 70 + r8; }
