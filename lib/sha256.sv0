}

fn sha256_ch(e: i32, f: i32, g: i32) -> i32 {
  return (e & f) ^ ((e ^ 65535) & g);
}

fn sha256_maj(a: i32, b: i32, c: i32) -> i32 {
  return (a & b) ^ (a & c) ^ (b & c);
}

/* Byte i of the padded message: data, 0x80, zeros, then the 64-bit big-endian bit length. */
fn sha256_byte(s: str, n: i32, total: i32, i: i32) -> i32 {
  if i < n {
    return string_char_at(s, i);
  };
  if i == n {
    return 128;
  };
  let k = total - 1 - i;
  if k >= 8 {
    return 0;
  };
  if k == 0 {
    return (n % 32) * 8;
  };
  if k >= 5 {
    return 0;
  };
  return (n / sha256_pow2(8 * k - 3)) % 256;
}

fn sha256_word_hi(s: str, n: i32, total: i32, i: i32) -> i32 {
  return sha256_byte(s, n, total, i) * 256 + sha256_byte(s, n, total, i + 1);
}

fn sha256_word_lo(s: str, n: i32, total: i32, i: i32) -> i32 {
  return sha256_byte(s, n, total, i + 2) * 256 + sha256_byte(s, n, total, i + 3);
}

fn sha256_hex4(x: i32) -> str {
  let digits = "0123456789abcdef";
  let mut out = "";
  let mut shift = 4096;
  while shift > 0 {
    out = string_concat(out, string_substr(digits, (x / shift) % 16, 1));
    shift = shift / 16;
  };
  return out;
}

