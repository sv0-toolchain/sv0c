/* Byte i of the padded message: data, 0x80, zeros, then the 64-bit big-endian bit length. */
fn sha256_vbyte(s: Vec<i32>, n: i32, total: i32, i: i32, so: i32, sl: i32) -> i32 {
  if i < n {
    if i < so {
      return vec_get(s, i);
    };
    return vec_get(s, i + sl);
  };
  if i == n {
    return 128;
  };
  let k = total - 1 - i;
  if k >= 8 {
    return 0;
  };
  if k == 0 {
    return (n % 32) * 8;
  };
  if k >= 5 {
    return 0;
  };
  return (n / sha256_pow2(8 * k - 3)) % 256;
}

fn sha256_vword_hi(s: Vec<i32>, n: i32, total: i32, i: i32, so: i32, sl: i32) -> i32 {
  return sha256_vbyte(s, n, total, i, so, sl) * 256 + sha256_vbyte(s, n, total, i + 1, so, sl);
}

fn sha256_vword_lo(s: Vec<i32>, n: i32, total: i32, i: i32, so: i32, sl: i32) -> i32 {
  return sha256_vbyte(s, n, total, i + 2, so, sl) * 256 + sha256_vbyte(s, n, total, i + 3, so, sl);
}

fn sha256_hex_bytes(s: Vec<i32>) -> str {
  return sha256_hex_bytes_skip(s, 0, 0);
}

