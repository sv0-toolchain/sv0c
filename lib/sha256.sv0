    bh = (t1h + t2h + alsum / 65536) % 65536;
    bl = alsum % 65536;
    /* round 55 */
    nlsum = sha256_small1_lo(w5h, w5l) + w0l + sha256_small0_lo(w8h, w8l) + w7l;
    w7h = (sha256_small1_hi(w5h, w5l) + w0h + sha256_small0_hi(w8h, w8l) + w7h + nlsum / 65536) % 65536;
    w7l = nlsum % 65536;
    t1lsum = al + sha256_big1_lo(fh, fl) + sha256_ch(fl, gl, hl) + 28659 + w7l;
    t1h = (ah + sha256_big1_hi(fh, fl) + sha256_ch(fh, gh, hh) + 26670 + w7h + t1lsum / 65536) % 65536;
    t1l = t1lsum % 65536;
    t2lsum = sha256_big0_lo(bh, bl) + sha256_maj(bl, cl, dl);
    t2h = (sha256_big0_hi(bh, bl) + sha256_maj(bh, ch, dh) + t2lsum / 65536) % 65536;
    t2l = t2lsum % 65536;
    elsum = el + t1l;
    eh = (eh + t1h + elsum / 65536) % 65536;
    el = elsum % 65536;
    alsum = t1l + t2l;
    ah = (t1h + t2h + alsum / 65536) % 65536;
    al = alsum % 65536;
    /* round 56 */
    nlsum = sha256_small1_lo(w6h, w6l) + w1l + sha256_small0_lo(w9h, w9l) + w8l;
    w8h = (sha256_small1_hi(w6h, w6l) + w1h + sha256_small0_hi(w9h, w9l) + w8h + nlsum / 65536) % 65536;
    w8l = nlsum % 65536;
    t1lsum = hl + sha256_big1_lo(eh, el) + sha256_ch(el, fl, gl) + 33518 + w8l;
    t1h = (hh + sha256_big1_hi(eh, el) + sha256_ch(eh, fh, gh) + 29839 + w8h + t1lsum / 65536) % 65536;
    t1l = t1lsum % 65536;
    t2lsum = sha256_big0_lo(ah, al) + sha256_maj(al, bl, cl);
    t2h = (sha256_big0_hi(ah, al) + sha256_maj(ah, bh, ch) + t2lsum / 65536) % 65536;
    t2l = t2lsum % 65536;
    elsum = dl + t1l;
    dh = (dh + t1h + elsum / 65536) % 65536;
    dl = elsum % 65536;
    alsum = t1l + t2l;
    hh = (t1h + t2h + alsum / 65536) % 65536;
    hl = alsum % 65536;
    /* round 57 */
    nlsum = sha256_small1_lo(w7h, w7l) + w2l + sha256_small0_lo(w10h, w10l) + w9l;
    w9h = (sha256_small1_hi(w7h, w7l) + w2h + sha256_small0_hi(w10h, w10l) + w9h + nlsum / 65536) % 65536;
    w9l = nlsum % 65536;
    t1lsum = gl + sha256_big1_lo(dh, dl) + sha256_ch(dl, el, fl) + 25455 + w9l;
    t1h = (gh + sha256_big1_hi(dh, dl) + sha256_ch(dh, eh, fh) + 30885 + w9h + t1lsum / 65536) % 65536;
    t1l = t1lsum % 65536;
    t2lsum = sha256_big0_lo(hh, hl) + sha256_maj(hl, al, bl);
    t2h = (sha256_big0_hi(hh, hl) + sha256_maj(hh, ah, bh) + t2lsum / 65536) % 65536;
    t2l = t2lsum % 65536;
    elsum = cl + t1l;
    ch = (ch + t1h + elsum / 65536) % 65536;
    cl = elsum % 65536;
    alsum = t1l + t2l;
    gh = (t1h + t2h + alsum / 65536) % 65536;
    gl = alsum % 65536;
    /* round 58 */
    nlsum = sha256_small1_lo(w8h, w8l) + w3l + sha256_small0_lo(w11h, w11l) + w10l;
    w10h = (sha256_small1_hi(w8h, w8l) + w3h + sha256_small0_hi(w11h, w11l) + w10h + nlsum / 65536) % 65536;
    w10l = nlsum % 65536;
    t1lsum = fl + sha256_big1_lo(ch, cl) + sha256_ch(cl, dl, el) + 30740 + w10l;
    t1h = (fh + sha256_big1_hi(ch, cl) + sha256_ch(ch, dh, eh) + 33992 + w10h + t1lsum / 65536) % 65536;
    t1l = t1lsum % 65536;
    t2lsum = sha256_big0_lo(gh, gl) + sha256_maj(gl, hl, al);
    t2h = (sha256_big0_hi(gh, gl) + sha256_maj(gh, hh, ah) + t2lsum / 65536) % 65536;
    t2l = t2lsum % 65536;
    elsum = bl + t1l;
    bh = (bh + t1h + elsum / 65536) % 65536;
    bl = elsum % 65536;
    alsum = t1l + t2l;
    fh = (t1h + t2h + alsum / 65536) % 65536;
    fl = alsum % 65536;
    /* round 59 */
    nlsum = sha256_small1_lo(w9h, w9l) + w4l + sha256_small0_lo(w12h, w12l) + w11l;
    w11h = (sha256_small1_hi(w9h, w9l) + w4h + sha256_small0_hi(w12h, w12l) + w11h + nlsum / 65536) % 65536;
    w11l = nlsum % 65536;
    t1lsum = el + sha256_big1_lo(bh, bl) + sha256_ch(bl, cl, dl) + 520 + w11l;
    t1h = (eh + sha256_big1_hi(bh, bl) + sha256_ch(bh, ch, dh) + 36039 + w11h + t1lsum / 65536) % 65536;
    t1l = t1lsum % 65536;
    t2lsum = sha256_big0_lo(fh, fl) + sha256_maj(fl, gl, hl);
    t2h = (sha256_big0_hi(fh, fl) + sha256_maj(fh, gh, hh) + t2lsum / 65536) % 65536;
    t2l = t2lsum % 65536;
    elsum = al + t1l;
    ah = (ah + t1h + elsum / 65536) % 65536;
    al = elsum % 65536;
    alsum = t1l + t2l;
    eh = (t1h + t2h + alsum / 65536) % 65536;
    el = alsum % 65536;
    /* round 60 */
    nlsum = sha256_small1_lo(w10h, w10l) + w5l + sha256_small0_lo(w13h, w13l) + w12l;
    w12h = (sha256_small1_hi(w10h, w10l) + w5h + sha256_small0_hi(w13h, w13l) + w12h + nlsum / 65536) % 65536;
    w12l = nlsum % 65536;
    t1lsum = dl + sha256_big1_lo(ah, al) + sha256_ch(al, bl, cl) + 65530 + w12l;
    t1h = (dh + sha256_big1_hi(ah, al) + sha256_ch(ah, bh, ch) + 37054 + w12h + t1lsum / 65536) % 65536;
    t1l = t1lsum % 65536;
    t2lsum = sha256_big0_lo(eh, el) + sha256_maj(el, fl, gl);
    t2h = (sha256_big0_hi(eh, el) + sha256_maj(eh, fh, gh) + t2lsum / 65536) % 65536;
    t2l = t2lsum % 65536;
    elsum = hl + t1l;
    hh = (hh + t1h + elsum / 65536) % 65536;
    hl = elsum % 65536;
    alsum = t1l + t2l;
    dh = (t1h + t2h + alsum / 65536) % 65536;
    dl = alsum % 65536;
    /* round 61 */
    nlsum = sha256_small1_lo(w11h, w11l) + w6l + sha256_small0_lo(w14h, w14l) + w13l;
    w13h = (sha256_small1_hi(w11h, w11l) + w6h + sha256_small0_hi(w14h, w14l) + w13h + nlsum / 65536) % 65536;
    w13l = nlsum % 65536;
    t1lsum = cl + sha256_big1_lo(hh, hl) + sha256_ch(hl, al, bl) + 27883 + w13l;
    t1h = (ch + sha256_big1_hi(hh, hl) + sha256_ch(hh, ah, bh) + 42064 + w13h + t1lsum / 65536) % 65536;
    t1l = t1lsum % 65536;
    t2lsum = sha256_big0_lo(dh, dl) + sha256_maj(dl, el, fl);
    t2h = (sha256_big0_hi(dh, dl) + sha256_maj(dh, eh, fh) + t2lsum / 65536) % 65536;
    t2l = t2lsum % 65536;
    elsum = gl + t1l;
    gh = (gh + t1h + elsum / 65536) % 65536;
    gl = elsum % 65536;
    alsum = t1l + t2l;
    ch = (t1h + t2h + alsum / 65536) % 65536;
    cl = alsum % 65536;
    /* round 62 */
    nlsum = sha256_small1_lo(w12h, w12l) + w7l + sha256_small0_lo(w15h, w15l) + w14l;
    w14h = (sha256_small1_hi(w12h, w12l) + w7h + sha256_small0_hi(w15h, w15l) + w14h + nlsum / 65536) % 65536;
    w14l = nlsum % 65536;
    t1lsum = bl + sha256_big1_lo(gh, gl) + sha256_ch(gl, hl, al) + 41975 + w14l;
    t1h = (bh + sha256_big1_hi(gh, gl) + sha256_ch(gh, hh, ah) + 48889 + w14h + t1lsum / 65536) % 65536;
    t1l = t1lsum % 65536;
    t2lsum = sha256_big0_lo(ch, cl) + sha256_maj(cl, dl, el);
    t2h = (sha256_big0_hi(ch, cl) + sha256_maj(ch, dh, eh) + t2lsum / 65536) % 65536;
    t2l = t2lsum % 65536;
    elsum = fl + t1l;
    fh = (fh + t1h + elsum / 65536) % 65536;
    fl = elsum % 65536;
    alsum = t1l + t2l;
    bh = (t1h + t2h + alsum / 65536) % 65536;
    bl = alsum % 65536;
    /* round 63 */
    nlsum = sha256_small1_lo(w13h, w13l) + w8l + sha256_small0_lo(w0h, w0l) + w15l;
    w15h = (sha256_small1_hi(w13h, w13l) + w8h + sha256_small0_hi(w0h, w0l) + w15h + nlsum / 65536) % 65536;
    w15l = nlsum % 65536;
    t1lsum = al + sha256_big1_lo(fh, fl) + sha256_ch(fl, gl, hl) + 30962 + w15l;
    t1h = (ah + sha256_big1_hi(fh, fl) + sha256_ch(fh, gh, hh) + 50801 + w15h + t1lsum / 65536) % 65536;
    t1l = t1lsum % 65536;
    t2lsum = sha256_big0_lo(bh, bl) + sha256_maj(bl, cl, dl);
    t2h = (sha256_big0_hi(bh, bl) + sha256_maj(bh, ch, dh) + t2lsum / 65536) % 65536;
    t2l = t2lsum % 65536;
    elsum = el + t1l;
    eh = (eh + t1h + elsum / 65536) % 65536;
    el = elsum % 65536;
    alsum = t1l + t2l;
    ah = (t1h + t2h + alsum / 65536) % 65536;
    al = alsum % 65536;
    let s0 = h0l + al;
    h0l = s0 % 65536;
    h0h = (h0h + ah + s0 / 65536) % 65536;
    let s1 = h1l + bl;
    h1l = s1 % 65536;
    h1h = (h1h + bh + s1 / 65536) % 65536;
    let s2 = h2l + cl;
    h2l = s2 % 65536;
    h2h = (h2h + ch + s2 / 65536) % 65536;
    let s3 = h3l + dl;
    h3l = s3 % 65536;
    h3h = (h3h + dh + s3 / 65536) % 65536;
    let s4 = h4l + el;
    h4l = s4 % 65536;
    h4h = (h4h + eh + s4 / 65536) % 65536;
    let s5 = h5l + fl;
    h5l = s5 % 65536;
    h5h = (h5h + fh + s5 / 65536) % 65536;
    let s6 = h6l + gl;
    h6l = s6 % 65536;
    h6h = (h6h + gh + s6 / 65536) % 65536;
    let s7 = h7l + hl;
    h7l = s7 % 65536;
    h7h = (h7h + hh + s7 / 65536) % 65536;
    off = off + 64;
  };
  let mut out = "";
  out = string_concat(out, sha256_hex4(h0h));
  out = string_concat(out, sha256_hex4(h0l));
  out = string_concat(out, sha256_hex4(h1h));
  out = string_concat(out, sha256_hex4(h1l));
  out = string_concat(out, sha256_hex4(h2h));
  out = string_concat(out, sha256_hex4(h2l));
  out = string_concat(out, sha256_hex4(h3h));
  out = string_concat(out, sha256_hex4(h3l));
  out = string_concat(out, sha256_hex4(h4h));
  out = string_concat(out, sha256_hex4(h4l));
  out = string_concat(out, sha256_hex4(h5h));
  out = string_concat(out, sha256_hex4(h5l));
  out = string_concat(out, sha256_hex4(h6h));
  out = string_concat(out, sha256_hex4(h6l));
  out = string_concat(out, sha256_hex4(h7h));
  out = string_concat(out, sha256_hex4(h7l));
  return out;
}
/* Byte i of the padded message: data, 0x80, zeros, then the 64-bit big-endian bit length. */
fn sha256_vbyte(s: Vec<i32>, n: i32, total: i32, i: i32) -> i32 {
  if i < n {
    return vec_get(s, i);
  };
  if i == n {
    return 128;
  };
  let k = total - 1 - i;
  if k >= 8 {
    return 0;
  };
  if k == 0 {
    return (n % 32) * 8;
  };
  if k >= 5 {
    return 0;
  };
  return (n / sha256_pow2(8 * k - 3)) % 256;
}

fn sha256_vword_hi(s: Vec<i32>, n: i32, total: i32, i: i32) -> i32 {
  return sha256_vbyte(s, n, total, i) * 256 + sha256_vbyte(s, n, total, i + 1);
}

fn sha256_vword_lo(s: Vec<i32>, n: i32, total: i32, i: i32) -> i32 {
  return sha256_vbyte(s, n, total, i + 2) * 256 + sha256_vbyte(s, n, total, i + 3);
}

fn sha256_hex_bytes(s: Vec<i32>) -> str {
  let n = vec_len(s);
  let total = ((n + 8) / 64 + 1) * 64;
  let mut h0h = 27145;
  let mut h0l = 58983;
  let mut h1h = 47975;
  let mut h1l = 44677;
  let mut h2h = 15470;
  let mut h2l = 62322;
  let mut h3h = 42319;
  let mut h3l = 62778;
  let mut h4h = 20750;
  let mut h4l = 21119;
  let mut h5h = 39685;
  let mut h5l = 26764;
  let mut h6h = 8067;
  let mut h6l = 55723;
  let mut h7h = 23520;
  let mut h7l = 52505;
  let mut off = 0;
  while off < total {
    let mut w0h = sha256_vword_hi(s, n, total, off + 0);
    let mut w0l = sha256_vword_lo(s, n, total, off + 0);
    let mut w1h = sha256_vword_hi(s, n, total, off + 4);
    let mut w1l = sha256_vword_lo(s, n, total, off + 4);
    let mut w2h = sha256_vword_hi(s, n, total, off + 8);
    let mut w2l = sha256_vword_lo(s, n, total, off + 8);
    let mut w3h = sha256_vword_hi(s, n, total, off + 12);
    let mut w3l = sha256_vword_lo(s, n, total, off + 12);
    let mut w4h = sha256_vword_hi(s, n, total, off + 16);
    let mut w4l = sha256_vword_lo(s, n, total, off + 16);
    let mut w5h = sha256_vword_hi(s, n, total, off + 20);
    let mut w5l = sha256_vword_lo(s, n, total, off + 20);
    let mut w6h = sha256_vword_hi(s, n, total, off + 24);
    let mut w6l = sha256_vword_lo(s, n, total, off + 24);
    let mut w7h = sha256_vword_hi(s, n, total, off + 28);
    let mut w7l = sha256_vword_lo(s, n, total, off + 28);
    let mut w8h = sha256_vword_hi(s, n, total, off + 32);
    let mut w8l = sha256_vword_lo(s, n, total, off + 32);
    let mut w9h = sha256_vword_hi(s, n, total, off + 36);
    let mut w9l = sha256_vword_lo(s, n, total, off + 36);
    let mut w10h = sha256_vword_hi(s, n, total, off + 40);
    let mut w10l = sha256_vword_lo(s, n, total, off + 40);
    let mut w11h = sha256_vword_hi(s, n, total, off + 44);
    let mut w11l = sha256_vword_lo(s, n, total, off + 44);
    let mut w12h = sha256_vword_hi(s, n, total, off + 48);
    let mut w12l = sha256_vword_lo(s, n, total, off + 48);
    let mut w13h = sha256_vword_hi(s, n, total, off + 52);
    let mut w13l = sha256_vword_lo(s, n, total, off + 52);
    let mut w14h = sha256_vword_hi(s, n, total, off + 56);
    let mut w14l = sha256_vword_lo(s, n, total, off + 56);
    let mut w15h = sha256_vword_hi(s, n, total, off + 60);
    let mut w15l = sha256_vword_lo(s, n, total, off + 60);
    let mut ah = h0h;
    let mut al = h0l;
    let mut bh = h1h;
    let mut bl = h1l;
    let mut ch = h2h;
    let mut cl = h2l;
    let mut dh = h3h;
    let mut dl = h3l;
    let mut eh = h4h;
    let mut el = h4l;
    let mut fh = h5h;
    let mut fl = h5l;
    let mut gh = h6h;
    let mut gl = h6l;
    let mut hh = h7h;
    let mut hl = h7l;
    let mut t1lsum = 0;
    let mut t1l = 0;
    let mut t1h = 0;
    let mut t2lsum = 0;
    let mut t2l = 0;
    let mut t2h = 0;
    let mut elsum = 0;
    let mut alsum = 0;
    let mut nlsum = 0;
    /* round 0 */
    t1lsum = hl + sha256_big1_lo(eh, el) + sha256_ch(el, fl, gl) + 12184 + w0l;
    t1h = (hh + sha256_big1_hi(eh, el) + sha256_ch(eh, fh, gh) + 17034 + w0h + t1lsum / 65536) % 65536;
    t1l = t1lsum % 65536;
    t2lsum = sha256_big0_lo(ah, al) + sha256_maj(al, bl, cl);
    t2h = (sha256_big0_hi(ah, al) + sha256_maj(ah, bh, ch) + t2lsum / 65536) % 65536;
    t2l = t2lsum % 65536;
    elsum = dl + t1l;
    dh = (dh + t1h + elsum / 65536) % 65536;
    dl = elsum % 65536;
    alsum = t1l + t2l;
    hh = (t1h + t2h + alsum / 65536) % 65536;
    hl = alsum % 65536;
    /* round 1 */
    t1lsum = gl + sha256_big1_lo(dh, dl) + sha256_ch(dl, el, fl) + 17553 + w1l;
    t1h = (gh + sha256_big1_hi(dh, dl) + sha256_ch(dh, eh, fh) + 28983 + w1h + t1lsum / 65536) % 65536;
    t1l = t1lsum % 65536;
    t2lsum = sha256_big0_lo(hh, hl) + sha256_maj(hl, al, bl);
    t2h = (sha256_big0_hi(hh, hl) + sha256_maj(hh, ah, bh) + t2lsum / 65536) % 65536;
    t2l = t2lsum % 65536;
    elsum = cl + t1l;
    ch = (ch + t1h + elsum / 65536) % 65536;
    cl = elsum % 65536;
    alsum = t1l + t2l;
    gh = (t1h + t2h + alsum / 65536) % 65536;
    gl = alsum % 65536;
    /* round 2 */
    t1lsum = fl + sha256_big1_lo(ch, cl) + sha256_ch(cl, dl, el) + 64463 + w2l;
    t1h = (fh + sha256_big1_hi(ch, cl) + sha256_ch(ch, dh, eh) + 46528 + w2h + t1lsum / 65536) % 65536;
    t1l = t1lsum % 65536;
    t2lsum = sha256_big0_lo(gh, gl) + sha256_maj(gl, hl, al);
    t2h = (sha256_big0_hi(gh, gl) + sha256_maj(gh, hh, ah) + t2lsum / 65536) % 65536;
    t2l = t2lsum % 65536;
    elsum = bl + t1l;
    bh = (bh + t1h + elsum / 65536) % 65536;
    bl = elsum % 65536;
    alsum = t1l + t2l;
    fh = (t1h + t2h + alsum / 65536) % 65536;
    fl = alsum % 65536;
    /* round 3 */
    t1lsum = el + sha256_big1_lo(bh, bl) + sha256_ch(bl, cl, dl) + 56229 + w3l;
    t1h = (eh + sha256_big1_hi(bh, bl) + sha256_ch(bh, ch, dh) + 59829 + w3h + t1lsum / 65536) % 65536;
    t1l = t1lsum % 65536;
    t2lsum = sha256_big0_lo(fh, fl) + sha256_maj(fl, gl, hl);
    t2h = (sha256_big0_hi(fh, fl) + sha256_maj(fh, gh, hh) + t2lsum / 65536) % 65536;
    t2l = t2lsum % 65536;
    elsum = al + t1l;
    ah = (ah + t1h + elsum / 65536) % 65536;
    al = elsum % 65536;
    alsum = t1l + t2l;
    eh = (t1h + t2h + alsum / 65536) % 65536;
    el = alsum % 65536;
    /* round 4 */
    t1lsum = dl + sha256_big1_lo(ah, al) + sha256_ch(al, bl, cl) + 49755 + w4l;
    t1h = (dh + sha256_big1_hi(ah, al) + sha256_ch(ah, bh, ch) + 14678 + w4h + t1lsum / 65536) % 65536;
    t1l = t1lsum % 65536;
    t2lsum = sha256_big0_lo(eh, el) + sha256_maj(el, fl, gl);
    t2h = (sha256_big0_hi(eh, el) + sha256_maj(eh, fh, gh) + t2lsum / 65536) % 65536;
    t2l = t2lsum % 65536;
    elsum = hl + t1l;
    hh = (hh + t1h + elsum / 65536) % 65536;
    hl = elsum % 65536;
    alsum = t1l + t2l;
    dh = (t1h + t2h + alsum / 65536) % 65536;
    dl = alsum % 65536;
    /* round 5 */
    t1lsum = cl + sha256_big1_lo(hh, hl) + sha256_ch(hl, al, bl) + 4593 + w5l;
    t1h = (ch + sha256_big1_hi(hh, hl) + sha256_ch(hh, ah, bh) + 23025 + w5h + t1lsum / 65536) % 65536;
