fn sha256_pow2(n: i32) -> i32 {
  let mut p = 1;
  let mut i = 0;
  while i < n {
    p = p * 2;
    i = i + 1;
  };
  return p;
}

/* (x >> n) combined with the low n bits of y moved to the top: 0 < n < 16, x and y in 0..65535. */
fn sha256_mix(x: i32, y: i32, n: i32) -> i32 {
  let m = sha256_pow2(n);
  return x / m + (y % m) * sha256_pow2(16 - n);
}

fn sha256_rotr_hi(h: i32, l: i32, n: i32) -> i32 {
  if n >= 16 {
    return sha256_rotr_hi(l, h, n - 16);
  };
  if n == 0 {
    return h;
  };
  return sha256_mix(h, l, n);
}

fn sha256_rotr_lo(h: i32, l: i32, n: i32) -> i32 {
  if n >= 16 {
    return sha256_rotr_lo(l, h, n - 16);
  };
  if n == 0 {
    return l;
  };
  return sha256_mix(l, h, n);
}

fn sha256_shr_hi(h: i32, l: i32, n: i32) -> i32 {
  return h / sha256_pow2(n);
}

fn sha256_shr_lo(h: i32, l: i32, n: i32) -> i32 {
  return sha256_mix(l, h, n);
}

fn sha256_big0_hi(h: i32, l: i32) -> i32 {
  return sha256_rotr_hi(h, l, 2) ^ sha256_rotr_hi(h, l, 13) ^ sha256_rotr_hi(h, l, 22);
}

fn sha256_big0_lo(h: i32, l: i32) -> i32 {
  return sha256_rotr_lo(h, l, 2) ^ sha256_rotr_lo(h, l, 13) ^ sha256_rotr_lo(h, l, 22);
}

fn sha256_big1_hi(h: i32, l: i32) -> i32 {
  return sha256_rotr_hi(h, l, 6) ^ sha256_rotr_hi(h, l, 11) ^ sha256_rotr_hi(h, l, 25);
}

fn sha256_big1_lo(h: i32, l: i32) -> i32 {
  return sha256_rotr_lo(h, l, 6) ^ sha256_rotr_lo(h, l, 11) ^ sha256_rotr_lo(h, l, 25);
}

fn sha256_small0_hi(h: i32, l: i32) -> i32 {
  return sha256_rotr_hi(h, l, 7) ^ sha256_rotr_hi(h, l, 18) ^ sha256_shr_hi(h, l, 3);
}

fn sha256_small0_lo(h: i32, l: i32) -> i32 {
  return sha256_rotr_lo(h, l, 7) ^ sha256_rotr_lo(h, l, 18) ^ sha256_shr_lo(h, l, 3);
}

fn sha256_small1_hi(h: i32, l: i32) -> i32 {
  return sha256_rotr_hi(h, l, 17) ^ sha256_rotr_hi(h, l, 19) ^ sha256_shr_hi(h, l, 10);
}

fn sha256_small1_lo(h: i32, l: i32) -> i32 {
  return sha256_rotr_lo(h, l, 17) ^ sha256_rotr_lo(h, l, 19) ^ sha256_shr_lo(h, l, 10);
}

fn sha256_ch(e: i32, f: i32, g: i32) -> i32 {
  return (e & f) ^ ((e ^ 65535) & g);
}

fn sha256_maj(a: i32, b: i32, c: i32) -> i32 {
  return (a & b) ^ (a & c) ^ (b & c);
}

/* Byte i of the padded message: data, 0x80, zeros, then the 64-bit big-endian bit length. */
fn sha256_byte(s: str, n: i32, total: i32, i: i32) -> i32 {
  if i < n {
    return string_char_at(s, i);
  };
  if i == n {
    return 128;
  };
  let k = total - 1 - i;
  if k >= 8 {
    return 0;
  };
  if k == 0 {
    return (n % 32) * 8;
  };
  if k >= 5 {
    return 0;
  };
  return (n / sha256_pow2(8 * k - 3)) % 256;
}

fn sha256_word_hi(s: str, n: i32, total: i32, i: i32) -> i32 {
  return sha256_byte(s, n, total, i) * 256 + sha256_byte(s, n, total, i + 1);
}

fn sha256_word_lo(s: str, n: i32, total: i32, i: i32) -> i32 {
  return sha256_byte(s, n, total, i + 2) * 256 + sha256_byte(s, n, total, i + 3);
}

fn sha256_hex4(x: i32) -> str {
  let digits = "0123456789abcdef";
  let mut out = "";
  let mut shift = 4096;
  while shift > 0 {
    out = string_concat(out, string_substr(digits, (x / shift) % 16, 1));
    shift = shift / 16;
  };
  return out;
}

fn sha256_hex(s: str) -> str {
  let n = string_len(s);
  let total = ((n + 8) / 64 + 1) * 64;
  let mut h0h = 27145;
  let mut h0l = 58983;
  let mut h1h = 47975;
  let mut h1l = 44677;
  let mut h2h = 15470;
  let mut h2l = 62322;
  let mut h3h = 42319;
  let mut h3l = 62778;
  let mut h4h = 20750;
  let mut h4l = 21119;
  let mut h5h = 39685;
  let mut h5l = 26764;
  let mut h6h = 8067;
  let mut h6l = 55723;
  let mut h7h = 23520;
  let mut h7l = 52505;
  let mut off = 0;
  while off < total {
    let mut w0h = sha256_word_hi(s, n, total, off + 0);
    let mut w0l = sha256_word_lo(s, n, total, off + 0);
    let mut w1h = sha256_word_hi(s, n, total, off + 4);
    let mut w1l = sha256_word_lo(s, n, total, off + 4);
    let mut w2h = sha256_word_hi(s, n, total, off + 8);
    let mut w2l = sha256_word_lo(s, n, total, off + 8);
    let mut w3h = sha256_word_hi(s, n, total, off + 12);
    let mut w3l = sha256_word_lo(s, n, total, off + 12);
    let mut w4h = sha256_word_hi(s, n, total, off + 16);
    let mut w4l = sha256_word_lo(s, n, total, off + 16);
    let mut w5h = sha256_word_hi(s, n, total, off + 20);
    let mut w5l = sha256_word_lo(s, n, total, off + 20);
    let mut w6h = sha256_word_hi(s, n, total, off + 24);
    let mut w6l = sha256_word_lo(s, n, total, off + 24);
    let mut w7h = sha256_word_hi(s, n, total, off + 28);
    let mut w7l = sha256_word_lo(s, n, total, off + 28);
    let mut w8h = sha256_word_hi(s, n, total, off + 32);
    let mut w8l = sha256_word_lo(s, n, total, off + 32);
    let mut w9h = sha256_word_hi(s, n, total, off + 36);
    let mut w9l = sha256_word_lo(s, n, total, off + 36);
    let mut w10h = sha256_word_hi(s, n, total, off + 40);
    let mut w10l = sha256_word_lo(s, n, total, off + 40);
    let mut w11h = sha256_word_hi(s, n, total, off + 44);
    let mut w11l = sha256_word_lo(s, n, total, off + 44);
    let mut w12h = sha256_word_hi(s, n, total, off + 48);
    let mut w12l = sha256_word_lo(s, n, total, off + 48);
    let mut w13h = sha256_word_hi(s, n, total, off + 52);
    let mut w13l = sha256_word_lo(s, n, total, off + 52);
    let mut w14h = sha256_word_hi(s, n, total, off + 56);
    let mut w14l = sha256_word_lo(s, n, total, off + 56);
    let mut w15h = sha256_word_hi(s, n, total, off + 60);
    let mut w15l = sha256_word_lo(s, n, total, off + 60);
    let mut ah = h0h;
    let mut al = h0l;
    let mut bh = h1h;
    let mut bl = h1l;
    let mut ch = h2h;
    let mut cl = h2l;
    let mut dh = h3h;
    let mut dl = h3l;
    let mut eh = h4h;
    let mut el = h4l;
    let mut fh = h5h;
    let mut fl = h5l;
    let mut gh = h6h;
    let mut gl = h6l;
    let mut hh = h7h;
    let mut hl = h7l;
    let mut t = 0;
    while t < 64 {
      let t1lsum = hl + sha256_big1_lo(eh, el) + sha256_ch(el, fl, gl) + sha256_k_lo(t) + w0l;
      let t1l = t1lsum % 65536;
      let t1h = (hh + sha256_big1_hi(eh, el) + sha256_ch(eh, fh, gh) + sha256_k_hi(t) + w0h + t1lsum / 65536) % 65536;
      let t2lsum = sha256_big0_lo(ah, al) + sha256_maj(al, bl, cl);
      let t2l = t2lsum % 65536;
      let t2h = (sha256_big0_hi(ah, al) + sha256_maj(ah, bh, ch) + t2lsum / 65536) % 65536;
      hh = gh;
      hl = gl;
      gh = fh;
      gl = fl;
      fh = eh;
      fl = el;
      let elsum = dl + t1l;
      el = elsum % 65536;
      eh = (dh + t1h + elsum / 65536) % 65536;
      dh = ch;
      dl = cl;
      ch = bh;
      cl = bl;
      bh = ah;
      bl = al;
      let alsum = t1l + t2l;
      al = alsum % 65536;
      ah = (t1h + t2h + alsum / 65536) % 65536;
      let nlsum = sha256_small1_lo(w14h, w14l) + w9l + sha256_small0_lo(w1h, w1l) + w0l;
      let nl = nlsum % 65536;
      let nh = (sha256_small1_hi(w14h, w14l) + w9h + sha256_small0_hi(w1h, w1l) + w0h + nlsum / 65536) % 65536;
      w0h = w1h;
      w0l = w1l;
      w1h = w2h;
      w1l = w2l;
      w2h = w3h;
      w2l = w3l;
      w3h = w4h;
      w3l = w4l;
      w4h = w5h;
      w4l = w5l;
      w5h = w6h;
      w5l = w6l;
      w6h = w7h;
      w6l = w7l;
      w7h = w8h;
      w7l = w8l;
      w8h = w9h;
      w8l = w9l;
      w9h = w10h;
      w9l = w10l;
      w10h = w11h;
      w10l = w11l;
      w11h = w12h;
      w11l = w12l;
      w12h = w13h;
      w12l = w13l;
      w13h = w14h;
      w13l = w14l;
      w14h = w15h;
      w14l = w15l;
      w15h = nh;
      w15l = nl;
      t = t + 1;
    };
    let s0 = h0l + al;
    h0l = s0 % 65536;
    h0h = (h0h + ah + s0 / 65536) % 65536;
    let s1 = h1l + bl;
    h1l = s1 % 65536;
    h1h = (h1h + bh + s1 / 65536) % 65536;
    let s2 = h2l + cl;
    h2l = s2 % 65536;
    h2h = (h2h + ch + s2 / 65536) % 65536;
    let s3 = h3l + dl;
    h3l = s3 % 65536;
    h3h = (h3h + dh + s3 / 65536) % 65536;
    let s4 = h4l + el;
    h4l = s4 % 65536;
    h4h = (h4h + eh + s4 / 65536) % 65536;
    let s5 = h5l + fl;
    h5l = s5 % 65536;
    h5h = (h5h + fh + s5 / 65536) % 65536;
    let s6 = h6l + gl;
    h6l = s6 % 65536;
    h6h = (h6h + gh + s6 / 65536) % 65536;
    let s7 = h7l + hl;
    h7l = s7 % 65536;
    h7h = (h7h + hh + s7 / 65536) % 65536;
    off = off + 64;
  };
  let mut out = "";
  out = string_concat(out, sha256_hex4(h0h));
  out = string_concat(out, sha256_hex4(h0l));
  out = string_concat(out, sha256_hex4(h1h));
  out = string_concat(out, sha256_hex4(h1l));
  out = string_concat(out, sha256_hex4(h2h));
  out = string_concat(out, sha256_hex4(h2l));
  out = string_concat(out, sha256_hex4(h3h));
  out = string_concat(out, sha256_hex4(h3l));
  out = string_concat(out, sha256_hex4(h4h));
  out = string_concat(out, sha256_hex4(h4l));
  out = string_concat(out, sha256_hex4(h5h));
  out = string_concat(out, sha256_hex4(h5l));
  out = string_concat(out, sha256_hex4(h6h));
  out = string_concat(out, sha256_hex4(h6l));
  out = string_concat(out, sha256_hex4(h7h));
  out = string_concat(out, sha256_hex4(h7l));
  return out;
}
