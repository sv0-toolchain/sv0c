/* Phase 2 real pipeline module: sml/include_expand.sml -> sv0.
   Textual include expansion: character classification, whitespace
   trimming, path validation, include-line parsing, line splitting/
   joining, cycle detection (Vec-based visited list).
   `expand_text_table2` mirrors SML `expand` line-wise using a 2-slot
   in-memory path→body table (tests; no OS). `expand`/`expandFile`
   remain deferred (host file I/O). */

fn is_space(c: i32) -> bool {
    if c == 32 { return true; }
    if c == 9 { return true; }
    if c == 10 { return true; }
    if c == 11 { return true; }
    if c == 12 { return true; }
    return false;
}

fn trim_left(s: string, i: i32, len: i32) -> i32 {
    if i >= len { return i; }
    let c: i32 = string_char_at(s, i);
    if is_space(c) { return trim_left(s, i + 1, len); }
    return i;
}

fn trim_right(s: string, j: i32) -> i32 {
    if j <= 0 { return j; }
    let c: i32 = string_char_at(s, j - 1);
    if is_space(c) { return trim_right(s, j - 1); }
    return j;
}

fn trim(s: string) -> string {
    let len: i32 = string_len(s);
    let lo: i32 = trim_left(s, 0, len);
    let hi: i32 = trim_right(s, len);
    if lo >= hi { return ""; }
    return string_substr(s, lo, hi - lo);
}

fn path_ok(rel: string) -> bool {
    let len: i32 = string_len(rel);
    if len == 0 { return false; }
    let first: i32 = string_char_at(rel, 0);
    if first == 47 { return false; }
    let mut i: i32 = 0;
    while i < len - 1 {
        let c0: i32 = string_char_at(rel, i);
        let c1: i32 = string_char_at(rel, i + 1);
        if c0 == 46 {
            if c1 == 46 { return false; }
        }
        i = i + 1;
    }
    return true;
}

fn has_include_prefix(line: string) -> bool {
    let len: i32 = string_len(line);
    if len < 10 { return false; }
    let prefix: string = string_substr(line, 0, 9);
    return string_eq(prefix, "include \"");
}

fn find_closing_quote(s: string, start: i32) -> i32 {
    let len: i32 = string_len(s);
    let mut i: i32 = start;
    while i < len {
        let c: i32 = string_char_at(s, i);
        if c == 34 { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn chomp_cr(line: string) -> string {
    let len: i32 = string_len(line);
    if len == 0 { return line; }
    let last: i32 = string_char_at(line, len - 1);
    if last == 13 { return string_substr(line, 0, len - 1); }
    return line;
}

/* parse_include_line: returns the relative path if the line matches
   `include "relpath";`, or empty string if no include. Trims, chomps
   CR, checks prefix, closing quote, trailing semicolon, pathOk. */
fn parse_include_line(line: string) -> string {
    let s: string = trim(chomp_cr(line));
    if has_include_prefix(s) != true { return ""; }
    let after: string = string_substr(s, 9, string_len(s) - 9);
    let q: i32 = find_closing_quote(after, 0);
    if q < 0 { return ""; }
    let p: string = string_substr(after, 0, q);
    let rest: string = trim(string_substr(after, q + 1, string_len(after) - q - 1));
    if string_eq(rest, ";") != true { return ""; }
    if path_ok(p) != true { return ""; }
    return p;
}

/* ── line splitting/joining ─────────────────────────────────────
   split_lines: stores (start, len) pairs in out Vec, returns count.
   join_lines: reconstructs string from substrings with newlines. */

fn split_lines(source: string, starts: Vec<i32>, lens: Vec<i32>) -> i32 {
    let slen: i32 = string_len(source);
    let mut line_start: i32 = 0;
    let mut i: i32 = 0;
    let mut count: i32 = 0;
    while i < slen {
        let c: i32 = string_char_at(source, i);
        if c == 10 {
            vec_push(starts, line_start);
            vec_push(lens, i - line_start);
            count = count + 1;
            line_start = i + 1;
        }
        i = i + 1;
    }
    vec_push(starts, line_start);
    vec_push(lens, slen - line_start);
    count = count + 1;
    return count;
}

fn get_split_line(source: string, starts: Vec<i32>, lens: Vec<i32>, idx: i32) -> string {
    let s: i32 = vec_get(starts, idx);
    let l: i32 = vec_get(lens, idx);
    if l == 0 { return ""; }
    return string_substr(source, s, l);
}

/* ── cycle detection ───────────────────────────────────────────
   visited is a Vec<i32> of interned path handles.
   Returns true if handle is already in the list. */

fn include_cycle_check(visited: Vec<i32>, path_handle: i32) -> bool {
    let n: i32 = vec_len(visited);
    let mut i: i32 = 0;
    while i < n {
        if vec_get(visited, i) == path_handle { return true; }
        i = i + 1;
    }
    return false;
}

/* ── path directory extraction ─────────────────────────────────
   Returns prefix up to last '/' (exclusive), or "" if no slash. */

fn path_dir(path: string) -> string {
    let len: i32 = string_len(path);
    let mut last_slash: i32 = 0 - 1;
    let mut i: i32 = 0;
    while i < len {
        let c: i32 = string_char_at(path, i);
        if c == 47 { last_slash = i; }
        i = i + 1;
    }
    if last_slash < 0 { return ""; }
    return string_substr(path, 0, last_slash);
}

fn path_join(dir: string, rel: string) -> string {
    let dlen: i32 = string_len(dir);
    if dlen == 0 { return rel; }
    let mut out: string = dir;
    out = string_concat(out, "/");
    out = string_concat(out, rel);
    return out;
}

/* In-memory expand (SML `IncludeExpand.expand` without OS.FileSys):
   split source into lines; each `include "rel";` is resolved as
   path_join(path_dir(host_abs), rel), body loaded from a fixed 2-slot
   path→text table (empty slot keys are ignored). Recursive expansion
   uses the merged absolute path as the nested host. Depth > 24 →
   literal `E0323` (cycle / runaway guard). Missing table entry → `E0322`. */

fn table_lookup_body(p0: string, b0: string, p1: string, b1: string, merged: string) -> string {
    if string_len(p0) > 0 {
        if string_eq(p0, merged) {
            return b0;
        }
    }
    if string_len(p1) > 0 {
        if string_eq(p1, merged) {
            return b1;
        }
    }
    return "";
}

fn expand_text_table2(host_abs: string, source: string, p0: string, b0: string, p1: string,
                      b1: string, depth: i32) -> string {
    if depth > 24 {
        return "E0323";
    }
    let dd: i32 = depth + 1;
    let starts: Vec<i32> = vec_new();
    let lens: Vec<i32> = vec_new();
    let count: i32 = split_lines(source, starts, lens);
    let mut bo: string = "";
    let mut li: i32 = 0;
    while li < count {
        if li > 0 {
            bo = string_concat(bo, "\n");
        }
        let line: string = get_split_line(source, starts, lens, li);
        let rel: string = parse_include_line(line);
        if string_len(rel) == 0 {
            bo = string_concat(bo, line);
        } else {
            let dir: string = path_dir(host_abs);
            let merged: string = path_join(dir, rel);
            let body: string = table_lookup_body(p0, b0, p1, b1, merged);
            if string_len(body) == 0 {
                bo = string_concat(bo, "E0322");
            } else {
                let inner: string = expand_text_table2(merged, body, p0, b0, p1, b1, dd);
                bo = string_concat(bo, inner);
            }
        }
        li = li + 1;
    }
    return bo;
}

fn test_expand_text_table2_simple() -> i32 {
    let host: string = "/tmp/pkg/main.sv0";
    let src: string = "include \"inc.sv0\";\nfn x() -> i32 { 1 }";
    let p0: string = "/tmp/pkg/inc.sv0";
    let b0: string = "fn inc() -> i32 { 2 }";
    let p1: string = "";
    let b1: string = "";
    let got: string = expand_text_table2(host, src, p0, b0, p1, b1, 0);
    let exp: string = "fn inc() -> i32 { 2 }\nfn x() -> i32 { 1 }";
    if string_eq(got, exp) != true { return 1; }
    return 0;
}

fn test_expand_text_table2_nested() -> i32 {
    let host: string = "/tmp/pkg/a.sv0";
    let src: string = "include \"b.sv0\";\nAA";
    let p0: string = "/tmp/pkg/a.sv0";
    let b0: string = "";
    let p1: string = "/tmp/pkg/b.sv0";
    let b1: string = "BB";
    let got: string = expand_text_table2(host, src, p0, b0, p1, b1, 0);
    let exp: string = "BB\nAA";
    if string_eq(got, exp) != true { return 2; }
    return 0;
}

fn test_expand_text_table2_miss() -> i32 {
    let host: string = "/tmp/pkg/main.sv0";
    let src: string = "include \"missing.sv0\";\ntail";
    let p0: string = "/tmp/pkg/other.sv0";
    let b0: string = "x";
    let p1: string = "";
    let b1: string = "";
    let got: string = expand_text_table2(host, src, p0, b0, p1, b1, 0);
    let exp: string = "E0322\ntail";
    if string_eq(got, exp) != true { return 3; }
    return 0;
}

fn test_is_space() -> i32 {
    if is_space(32) != true { return 1; }
    if is_space(9) != true { return 2; }
    if is_space(10) != true { return 3; }
    if is_space(11) != true { return 4; }
    if is_space(12) != true { return 5; }
    if is_space(65) != false { return 6; }
    if is_space(0) != false { return 7; }
    if is_space(48) != false { return 8; }
    return 0;
}

fn test_path_ok() -> i32 {
    if path_ok("foo.sv0") != true { return 1; }
    if path_ok("src/foo.sv0") != true { return 2; }
    if path_ok("") != false { return 3; }
    if path_ok("/abs/path") != false { return 4; }
    if path_ok("../escape") != false { return 5; }
    if path_ok("foo/../bar") != false { return 6; }
    if path_ok("a.b") != true { return 7; }
    return 0;
}

fn test_has_include_prefix() -> i32 {
    if has_include_prefix("include \"foo.sv0\";") != true { return 1; }
    if has_include_prefix("let x = 1;") != false { return 2; }
    if has_include_prefix("include") != false { return 3; }
    if has_include_prefix("") != false { return 4; }
    return 0;
}

fn test_find_closing_quote() -> i32 {
    if find_closing_quote("hello\"world", 0) != 5 { return 1; }
    if find_closing_quote("noquote", 0) != 0 - 1 { return 2; }
    if find_closing_quote("a\"b\"c", 2) != 3 { return 3; }
    return 0;
}

fn test_trim() -> i32 {
    if string_eq(trim("hello"), "hello") != true { return 1; }
    if string_eq(trim("  hello  "), "hello") != true { return 2; }
    if string_eq(trim(""), "") != true { return 3; }
    if string_eq(trim("   "), "") != true { return 4; }
    if string_eq(trim("  a b  "), "a b") != true { return 5; }
    return 0;
}

fn test_chomp_cr() -> i32 {
    if string_eq(chomp_cr("hello"), "hello") != true { return 1; }
    if string_eq(chomp_cr(""), "") != true { return 2; }
    return 0;
}

fn test_parse_include_line() -> i32 {
    let r1: string = parse_include_line("include \"foo.sv0\";");
    if string_eq(r1, "foo.sv0") != true { return 1; }
    let r2: string = parse_include_line("  include \"bar.sv0\" ;  ");
    if string_eq(r2, "bar.sv0") != true { return 2; }
    let r3: string = parse_include_line("let x = 1;");
    if string_eq(r3, "") != true { return 3; }
    let r4: string = parse_include_line("include \"../escape\";");
    if string_eq(r4, "") != true { return 4; }
    let r5: string = parse_include_line("include \"/abs/path\";");
    if string_eq(r5, "") != true { return 5; }
    let r6: string = parse_include_line("include \"foo.sv0\"");
    if string_eq(r6, "") != true { return 6; }
    let r7: string = parse_include_line("include \"sub/mod.sv0\";");
    if string_eq(r7, "sub/mod.sv0") != true { return 7; }
    return 0;
}

fn test_split_lines() -> i32 {
    let src: string = "alpha\nbeta\ngamma";
    let starts: Vec<i32> = vec_new();
    let lens: Vec<i32> = vec_new();
    let count: i32 = split_lines(src, starts, lens);
    if count != 3 { return 1; }
    let l1: string = get_split_line(src, starts, lens, 0);
    if string_eq(l1, "alpha") != true { return 2; }
    let l2: string = get_split_line(src, starts, lens, 1);
    if string_eq(l2, "beta") != true { return 3; }
    let l3: string = get_split_line(src, starts, lens, 2);
    if string_eq(l3, "gamma") != true { return 4; }
    let s2: Vec<i32> = vec_new();
    let l2v: Vec<i32> = vec_new();
    let c2: i32 = split_lines("single", s2, l2v);
    if c2 != 1 { return 5; }
    if string_eq(get_split_line("single", s2, l2v, 0), "single") != true { return 6; }
    return 0;
}

fn test_cycle_check() -> i32 {
    let visited: Vec<i32> = vec_new();
    if include_cycle_check(visited, 42) != false { return 1; }
    vec_push(visited, 10);
    vec_push(visited, 20);
    vec_push(visited, 30);
    if include_cycle_check(visited, 20) != true { return 2; }
    if include_cycle_check(visited, 42) != false { return 3; }
    if include_cycle_check(visited, 10) != true { return 4; }
    return 0;
}

fn test_path_dir() -> i32 {
    if string_eq(path_dir("src/foo.sv0"), "src") != true { return 1; }
    if string_eq(path_dir("a/b/c.sv0"), "a/b") != true { return 2; }
    if string_eq(path_dir("foo.sv0"), "") != true { return 3; }
    if string_eq(path_dir(""), "") != true { return 4; }
    return 0;
}

fn test_path_join() -> i32 {
    if string_eq(path_join("src", "foo.sv0"), "src/foo.sv0") != true { return 1; }
    if string_eq(path_join("", "foo.sv0"), "foo.sv0") != true { return 2; }
    if string_eq(path_join("a/b", "c.sv0"), "a/b/c.sv0") != true { return 3; }
    return 0;
}

fn main() -> i32 {
    let r1: i32 = test_is_space();
    if r1 != 0 { return r1; }
    let r2: i32 = test_trim();
    if r2 != 0 { return 10 + r2; }
    let r3: i32 = test_path_ok();
    if r3 != 0 { return 20 + r3; }
    let r4: i32 = test_has_include_prefix();
    if r4 != 0 { return 30 + r4; }
    let r5: i32 = test_find_closing_quote();
    if r5 != 0 { return 40 + r5; }
    let r6: i32 = test_chomp_cr();
    if r6 != 0 { return 50 + r6; }
    let r7: i32 = test_parse_include_line();
    if r7 != 0 { return 60 + r7; }
    let r8: i32 = test_split_lines();
    if r8 != 0 { return 70 + r8; }
    let r9: i32 = test_cycle_check();
    if r9 != 0 { return 80 + r9; }
    let r10: i32 = test_path_dir();
    if r10 != 0 { return 90 + r10; }
    let r11: i32 = test_path_join();
    if r11 != 0 { return 100 + r11; }
    let r12: i32 = test_expand_text_table2_simple();
    if r12 != 0 { return 110 + r12; }
    let r13: i32 = test_expand_text_table2_nested();
    if r13 != 0 { return 120 + r13; }
    let r14: i32 = test_expand_text_table2_miss();
    if r14 != 0 { return 130 + r14; }
    return 0;
}
