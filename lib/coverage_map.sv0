/* Canonical coverage map writer (sv0cov CV-110; SPEC 10.3, 16.2, 16.3).
 *
 * Turns the planner's side tables (lib/coverage_plan.sv0) into the canonical
 * `.sv0covmap.json` bytes: sources, function entities, function_entry and
 * branch_outcome points with their point IDs, one fragment per source,
 * branches, regions with normalized counter expressions, and the map ID.
 *
 *   point ID     SHA-256 of the SPEC 10.3 binary preimage (sha256_hex_bytes)
 *   counters     numbered by source, span start, entry before outcome, then
 *                outcome ordinal; each source is one fragment (a contiguous
 *                counter slice), identified by the SHA-256 of its canonical
 *                fragment-identity projection
 *   map ID       SHA-256 of the canonical map without `map_id`
 *
 * Canonical JSON (SPEC 16.2): object keys in bytewise order, no whitespace,
 * `"` `\` and the controls \b \t \n \f \r escaped short, other controls as
 * \u00xx, every other byte (UTF-8 included) copied, one final LF. The
 * writer emits keys in their sorted order directly.
 *
 * Arrays are sorted with a stable merge sort over byte-comparable keys
 * (fixed-width decimal fields and names). Positions come from a per-build
 * line-start table, so a large program costs O(n log n), not O(n * size).
 * Names are prefixed cov_map_ because compiler modules share one
 * translation unit.
 */

/* ── canonical JSON pieces ─────────────────────────────────────────────── */

fn cov_map_hex2(b: i32) -> string {
    let digits: string = "0123456789abcdef";
    return string_concat(string_substr(digits, b / 16, 1), string_substr(digits, b % 16, 1));
}

/* A canonical JSON string literal for the UTF-8 bytes of s. */
fn cov_map_str(s: string) -> string {
    let n: i32 = string_len(s);
    let mut out: string = "\"";
    let mut start: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        let c: i32 = string_char_at(s, i);
        let mut esc: string = "";
        if c == 34 { esc = "\\\""; }
        if c == 92 { esc = "\\\\"; }
        if c < 32 {
            esc = string_concat("\\u00", cov_map_hex2(c));
            if c == 8 { esc = "\\b"; }
            if c == 9 { esc = "\\t"; }
            if c == 10 { esc = "\\n"; }
            if c == 12 { esc = "\\f"; }
            if c == 13 { esc = "\\r"; }
        }
        if string_len(esc) > 0 {
            out = string_concat(string_concat(out, string_substr(s, start, i - start)), esc);
            start = i + 1;
        }
        i = i + 1;
    }
    return string_concat(string_concat(out, string_substr(s, start, n - start)), "\"");
}

fn cov_map_int(n: i32) -> string {
    return cov_src_itoa(n);
}

/* Zero-padded 10-digit decimal (a byte-comparable key field, n >= 0). */
fn cov_map_pad(n: i32) -> string {
    let s: string = cov_src_itoa(n);
    let mut out: string = "";
    let mut k: i32 = string_len(s);
    while k < 10 {
        out = string_concat(out, "0");
        k = k + 1;
    }
    return string_concat(out, s);
}

/* ── byte buffers ──────────────────────────────────────────────────────────
   The map is built in Vec<i32> byte buffers, never by growing a string:
   sv0 strings are immutable and every string_concat copies both operands
   into a fresh allocation that is never freed, so accumulating an N-byte
   map in a string costs O(N^2) time and memory (a 7k-line source produced
   a map large enough to be killed). Buffers append in amortized O(1);
   only small per-item strings (a number, a span, an escaped name) are
   built as strings and copied in. */

fn cov_vb(v: Vec<i32>, s: string) -> i32 {
    let n: i32 = string_len(s);
    let mut i: i32 = 0;
    while i < n {
        vec_push(v, string_char_at(s, i));
        i = i + 1;
    }
    return 0;
}

fn cov_vb_from(v: Vec<i32>, src: Vec<i32>, off: i32, len: i32) -> i32 {
    let mut i: i32 = 0;
    while i < len {
        vec_push(v, vec_get(src, off + i));
        i = i + 1;
    }
    return 0;
}

fn cov_vb_all(v: Vec<i32>, src: Vec<i32>) -> i32 {
    return cov_vb_from(v, src, 0, vec_len(src));
}

/* ── stable merge sort of item indices by byte keys ────────────────────── */

/* Key i is keys[koff[i] .. koff[i] + klen[i]). */
fn cov_map_key_lt(keys: Vec<i32>, koff: Vec<i32>, klen: Vec<i32>, a: i32, b: i32) -> bool {
    let ao: i32 = vec_get(koff, a);
    let bo: i32 = vec_get(koff, b);
    let al: i32 = vec_get(klen, a);
    let bl: i32 = vec_get(klen, b);
    let mut i: i32 = 0;
    while i < al {
        if i >= bl { return false; }
        let ca: i32 = vec_get(keys, ao + i);
        let cb: i32 = vec_get(keys, bo + i);
        if ca != cb { return ca < cb; }
        i = i + 1;
    }
    return al < bl;
}

/* Item indices 0..n-1 ordered by key (ties keep index order). */
fn cov_map_sort(keys: Vec<i32>, koff: Vec<i32>, klen: Vec<i32>) -> Vec<i32> {
    let n: i32 = vec_len(koff);
    let mut src: Vec<i32> = vec_new();
    let mut dst: Vec<i32> = vec_new();
    let mut i: i32 = 0;
    while i < n {
        vec_push(src, i);
        vec_push(dst, i);
        i = i + 1;
    }
    let mut width: i32 = 1;
    while width < n {
        let mut lo: i32 = 0;
        while lo < n {
            let mid: i32 = if lo + width < n { lo + width } else { n };
            let hi: i32 = if lo + 2 * width < n { lo + 2 * width } else { n };
            let mut x: i32 = lo;
            let mut y: i32 = mid;
            let mut k: i32 = lo;
            while k < hi {
                let mut take_y: bool = false;
                if x >= mid {
                    take_y = true;
                } else {
                    if y < hi {
                        if cov_map_key_lt(keys, koff, klen, vec_get(src, y), vec_get(src, x)) { take_y = true; }
                    }
                }
                if take_y {
                    vec_set(dst, k, vec_get(src, y));
                    y = y + 1;
                } else {
                    vec_set(dst, k, vec_get(src, x));
                    x = x + 1;
                }
                k = k + 1;
            }
            lo = lo + 2 * width;
        }
        let tmp: Vec<i32> = src;
        src = dst;
        dst = tmp;
        width = width * 2;
    }
    return src;
}

/* Start a key at the end of `keys`; finish it with cov_map_key_end. */
fn cov_map_key_begin(keys: Vec<i32>, koff: Vec<i32>) -> i32 {
    vec_push(koff, vec_len(keys));
    return 0;
}

fn cov_map_key_end(keys: Vec<i32>, koff: Vec<i32>, klen: Vec<i32>) -> i32 {
    vec_push(klen, vec_len(keys) - vec_get(koff, vec_len(koff) - 1));
    return 0;
}

fn cov_map_key_push(keys: Vec<i32>, koff: Vec<i32>, klen: Vec<i32>, key: string) -> i32 {
    cov_map_key_begin(keys, koff);
    cov_vb(keys, key);
    return cov_map_key_end(keys, koff, klen);
}

/* ── positions ─────────────────────────────────────────────────────────── */

/* Concat offsets of every line start (offset 0, and each byte after LF). */
fn cov_map_line_starts(source: string) -> Vec<i32> {
    let ls: Vec<i32> = vec_new();
    vec_push(ls, 0);
    let n: i32 = string_len(source);
    let mut i: i32 = 0;
    while i < n {
        if string_char_at(source, i) == 10 { vec_push(ls, i + 1); }
        i = i + 1;
    }
    return ls;
}

/* Index of the last line start <= off. */
fn cov_map_line_index(ls: Vec<i32>, off: i32) -> i32 {
    let mut lo: i32 = 0;
    let mut hi: i32 = vec_len(ls) - 1;
    while lo < hi {
        let mid: i32 = (lo + hi + 1) / 2;
        if vec_get(ls, mid) <= off { lo = mid; } else { hi = mid - 1; }
    }
    return lo;
}

/* {"end_byte":..,"end_column":..,"end_line":..,"start_byte":..,
   "start_column":..,"start_line":..} for concat span [s, e) of the unit
   starting at concat offset base. */
fn cov_map_span(source: string, ls: Vec<i32>, base: i32, s: i32, e: i32) -> string {
    let first: i32 = cov_map_line_index(ls, base);
    let sl: i32 = cov_map_line_index(ls, s);
    let el: i32 = cov_map_line_index(ls, e);
    let sc: i32 = cov_map_column(source, vec_get(ls, sl), s);
    let ec: i32 = cov_map_column(source, vec_get(ls, el), e);
    let mut out: string = string_concat("{\"end_byte\":", cov_map_int(e - base));
    out = string_concat(string_concat(out, ",\"end_column\":"), cov_map_int(ec));
    out = string_concat(string_concat(out, ",\"end_line\":"), cov_map_int(el - first + 1));
    out = string_concat(string_concat(out, ",\"start_byte\":"), cov_map_int(s - base));
    out = string_concat(string_concat(out, ",\"start_column\":"), cov_map_int(sc));
    out = string_concat(string_concat(out, ",\"start_line\":"), cov_map_int(sl - first + 1));
    return string_concat(out, "}");
}

/* 1-based Unicode-scalar column of concat offset off on the line starting at ls0. */
fn cov_map_column(source: string, ls0: i32, off: i32) -> i32 {
    let mut col: i32 = 1;
    let mut i: i32 = ls0;
    while i < off {
        let b: i32 = string_char_at(source, i);
        if b < 128 { col = col + 1; } else { if b >= 192 { col = col + 1; } }
        i = i + 1;
    }
    return col;
}

/* Strictly increasing lines (unit-relative) on which concat bytes [s, e)
   hold a non-whitespace byte, as a JSON array. */
fn cov_map_line_numbers(source: string, ls: Vec<i32>, base: i32, s: i32, e: i32) -> string {
    let first: i32 = cov_map_line_index(ls, base);
    let mut line: i32 = cov_map_line_index(ls, s) - first + 1;
    let mut last: i32 = 0;
    let mut out: string = "[";
    let mut i: i32 = s;
    while i < e {
        let c: i32 = string_char_at(source, i);
        if c == 10 {
            line = line + 1;
        } else {
            let ws: bool = if c == 32 { true } else { if c == 9 { true } else { c == 13 } };
            if ws != true {
                if line != last {
                    if last != 0 { out = string_concat(out, ","); }
                    out = string_concat(out, cov_map_int(line));
                    last = line;
                }
            }
        }
        i = i + 1;
    }
    return string_concat(out, "]");
}

/* ── point identity (SPEC 10.3) ────────────────────────────────────────── */

fn cov_map_push_u32(v: Vec<i32>, n: i32) -> i32 {
    vec_push(v, n % 256);
    vec_push(v, (n / 256) % 256);
    vec_push(v, (n / 65536) % 256);
    vec_push(v, n / 16777216);
    return 0;
}

fn cov_map_push_text(v: Vec<i32>, s: string) -> i32 {
    let n: i32 = string_len(s);
    cov_map_push_u32(v, n);
    let mut i: i32 = 0;
    while i < n {
        vec_push(v, string_char_at(s, i));
        i = i + 1;
    }
    return 0;
}

fn cov_map_hexval(c: i32) -> i32 {
    if c >= 97 { return c - 87; }
    return c - 48;
}

/* Lowercase hex point ID. kind: 1 function_entry, 3 branch_outcome;
   ordinal < 0 means "no ordinal" (0xffffffff). The entity is the function. */
fn cov_map_point_id(path: string, digest: string, qname: string, kind: i32,
                    s: i32, e: i32, ordinal: i32, disc: string) -> string {
    let v: Vec<i32> = vec_new();
    let domain: string = "sv0cov.point.v1";
    let mut i: i32 = 0;
    while i < string_len(domain) {
        vec_push(v, string_char_at(domain, i));
        i = i + 1;
    }
    vec_push(v, 0);
    vec_push(v, 1);
    vec_push(v, 0);
    vec_push(v, 0);
    vec_push(v, 0);
    cov_map_push_text(v, path);
    let mut d: i32 = 0;
    while d < 32 {
        vec_push(v, cov_map_hexval(string_char_at(digest, 2 * d)) * 16 + cov_map_hexval(string_char_at(digest, 2 * d + 1)));
        d = d + 1;
    }
    vec_push(v, 1);
    cov_map_push_text(v, qname);
    vec_push(v, kind);
    cov_map_push_u32(v, s);
    cov_map_push_u32(v, 0);
    cov_map_push_u32(v, e);
    cov_map_push_u32(v, 0);
    if ordinal < 0 {
        vec_push(v, 255);
        vec_push(v, 255);
        vec_push(v, 255);
        vec_push(v, 255);
    } else {
        cov_map_push_u32(v, ordinal);
    }
    cov_map_push_text(v, disc);
    return sha256_hex_bytes(v);
}

/* ── the map ───────────────────────────────────────────────────────────── */

/* Point index of a counter-expression ref (see lib/coverage_plan.sv0):
   ref >= 0 is entity ref's entry (point ref); else outcome k of branch b. */
fn cov_map_ref_point(r: i32, n_entries: i32, obase: Vec<i32>) -> i32 {
    if r >= 0 { return r; }
    let enc: i32 = 0 - r - 1;
    return n_entries + vec_get(obase, enc / 1024) + enc % 1024;
}

/* Counter index of every planned point: entries first (point e is entity
   e's function_entry), then branch b's outcomes (point ne + obase + k, obase
   = the outcomes of earlier branches). Counters follow source, span start,
   entry before outcome, then ordinal; the map writer and hit placement
   (CV-112) both use this numbering. */
fn cov_map_counters(starts: Vec<i32>, ent_source: Vec<i32>, ent_start: Vec<i32>,
                    br: Vec<i32>) -> Vec<i32> {
    let ne: i32 = vec_len(ent_source);
    let nb: i32 = vec_len(br) / 5;
    let keys: Vec<i32> = vec_new();
    let koff: Vec<i32> = vec_new();
    let klen: Vec<i32> = vec_new();
    let mut e: i32 = 0;
    while e < ne {
        let k0: string = string_concat(string_concat(cov_map_pad(vec_get(ent_source, e)), cov_map_pad(vec_get(ent_start, e))), "0");
        cov_map_key_push(keys, koff, klen, string_concat(k0, cov_map_pad(0)));
        e = e + 1;
    }
    let uncounted: Vec<i32> = vec_new();
    e = 0;
    while e < ne {
        vec_push(uncounted, 0);
        e = e + 1;
    }
    let mut b: i32 = 0;
    while b < nb {
        let bsrc: i32 = vec_get(ent_source, vec_get(br, b * 5 + 1));
        let bstart: i32 = vec_get(starts, vec_get(br, b * 5 + 2));
        let mut k: i32 = 0;
        while k < vec_get(br, b * 5 + 4) {
            let k1: string = string_concat(string_concat(cov_map_pad(bsrc), cov_map_pad(bstart)), "1");
            cov_map_key_push(keys, koff, klen, string_concat(k1, cov_map_pad(k + 1)));
            if cov_outcome_unreachable(vec_get(br, b * 5), k) { vec_push(uncounted, 1); } else { vec_push(uncounted, 0); }
            k = k + 1;
        }
        b = b + 1;
    }
    let order: Vec<i32> = cov_map_sort(keys, koff, klen);
    let counter: Vec<i32> = vec_new();
    let mut i: i32 = 0;
    while i < vec_len(order) {
        vec_push(counter, 0 - 1);
        i = i + 1;
    }
    /* A statically unreachable outcome is uncounted (counter -1). */
    let mut next: i32 = 0;
    i = 0;
    while i < vec_len(order) {
        let q: i32 = vec_get(order, i);
        if vec_get(uncounted, q) == 0 {
            vec_set(counter, q, next);
            next = next + 1;
        }
        i = i + 1;
    }
    return counter;
}

/* Number of counted points in a cov_map_counters numbering. */
fn cov_map_counted(counter: Vec<i32>) -> i32 {
    let mut n: i32 = 0;
    let mut i: i32 = 0;
    while i < vec_len(counter) {
        if vec_get(counter, i) >= 0 { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/* Build the canonical map (bytes including the final LF) as a byte buffer. */
fn cov_map_build(source: string, starts: Vec<i32>, ends: Vec<i32>, table: string,
                 cstarts: Vec<i32>, src_unit: Vec<i32>,
                 ent_source: Vec<i32>, ent_start: Vec<i32>, ent_end: Vec<i32>, qnames: string,
                 br: Vec<i32>, rg: Vec<i32>, cef: Vec<i32>, cet: Vec<i32>,
                 target: string, identity: string) -> Vec<i32> {
    let ls: Vec<i32> = cov_map_line_starts(source);
    let nsrc: i32 = vec_len(src_unit);
    let ne: i32 = vec_len(ent_source);
    let nb: i32 = vec_len(br) / 5;

    /* Points: entries first (point e = entity e's entry), then every branch
       outcome (point ne + obase[b] + k). */
    let p_src: Vec<i32> = vec_new();
    let p_ent: Vec<i32> = vec_new();
    let p_kind: Vec<i32> = vec_new();
    let p_s: Vec<i32> = vec_new();
    let p_e: Vec<i32> = vec_new();
    let p_ord: Vec<i32> = vec_new();
    let p_br: Vec<i32> = vec_new();
    let obase: Vec<i32> = vec_new();
    let mut e: i32 = 0;
    while e < ne {
        vec_push(p_src, vec_get(ent_source, e));
        vec_push(p_ent, e);
        vec_push(p_kind, 1);
        vec_push(p_s, vec_get(ent_start, e));
        vec_push(p_e, vec_get(ent_end, e));
        vec_push(p_ord, 0 - 1);
        vec_push(p_br, 0 - 1);
        e = e + 1;
    }
    let mut b: i32 = 0;
    let mut nout: i32 = 0;
    while b < nb {
        vec_push(obase, nout);
        let be: i32 = vec_get(br, b * 5 + 1);
        let mut k: i32 = 0;
        while k < vec_get(br, b * 5 + 4) {
            vec_push(p_src, vec_get(ent_source, be));
            vec_push(p_ent, be);
            vec_push(p_kind, 3);
            vec_push(p_s, vec_get(starts, vec_get(br, b * 5 + 2)));
            vec_push(p_e, vec_get(ends, vec_get(br, b * 5 + 3)));
            vec_push(p_ord, k);
            vec_push(p_br, b);
            k = k + 1;
        }
        nout = nout + k;
        b = b + 1;
    }
    let np: i32 = vec_len(p_kind);

    /* Point IDs: 64 hex bytes per point. */
    let ids: Vec<i32> = vec_new();
    let mut p: i32 = 0;
    while p < np {
        let sk: i32 = vec_get(p_src, p);
        let unit: i32 = vec_get(src_unit, sk);
        let base: i32 = vec_get(cstarts, unit);
        let pb: i32 = vec_get(p_br, p);
        let mut disc: string = "entry";
        if pb >= 0 { disc = cov_br_kind_name(vec_get(br, pb * 5)); }
        cov_vb(ids, cov_map_point_id(cov_src_path_at(table, unit), cov_src_digest_at(table, unit),
            cov_plan_line_at(qnames, vec_get(p_ent, p)), vec_get(p_kind, p),
            vec_get(p_s, p) - base, vec_get(p_e, p) - base, vec_get(p_ord, p), disc));
        p = p + 1;
    }

    /* Counter order: source, span start, entry before outcome, ordinal. */
    let counter: Vec<i32> = cov_map_counters(starts, ent_source, ent_start, br);
    let nc: i32 = cov_map_counted(counter);
    let corder: Vec<i32> = vec_new();
    p = 0;
    while p < nc {
        vec_push(corder, 0);
        p = p + 1;
    }
    p = 0;
    while p < np {
        if vec_get(counter, p) >= 0 { vec_set(corder, vec_get(counter, p), p); }
        p = p + 1;
    }

    /* Sources and one fragment per source (counters are grouped by source). */
    let srcs: Vec<i32> = vec_new();
    let frags: Vec<i32> = vec_new();
    cov_vb(srcs, "[");
    cov_vb(frags, "[");
    let mut c: i32 = 0;
    let mut sk2: i32 = 0;
    while sk2 < nsrc {
        let unit2: i32 = vec_get(src_unit, sk2);
        let path_j: string = cov_map_str(cov_src_path_at(table, unit2));
        let digest_j: string = cov_map_str(cov_src_digest_at(table, unit2));
        if sk2 > 0 { cov_vb(srcs, ","); }
        cov_vb(srcs, string_concat(string_concat("{\"digest\":", digest_j),
            string_concat(string_concat(",\"ownership\":\"user\",\"package\":null,\"path\":", path_j),
            string_concat(string_concat(",\"source_index\":", cov_map_int(sk2)), "}"))));
        let slice_base: i32 = c;
        let proj: Vec<i32> = vec_new();
        cov_vb(proj, "{\"point_ids\":[");
        let mut in_source: bool = true;
        while in_source {
            if c >= nc {
                in_source = false;
            } else {
                let q: i32 = vec_get(corder, c);
                if vec_get(p_src, q) != sk2 {
                    in_source = false;
                } else {
                    if c > slice_base { cov_vb(proj, ","); }
                    cov_vb(proj, "\"");
                    cov_vb_from(proj, ids, q * 64, 64);
                    cov_vb(proj, "\"");
                    c = c + 1;
                }
            }
        }
        cov_vb(proj, string_concat(string_concat("],\"schema\":\"sv0cov.fragment-identity\",\"sources\":[{\"digest\":", digest_j),
            string_concat(string_concat(",\"path\":", path_j), "}],\"version\":\"1.0\"}\n")));
        if sk2 > 0 { cov_vb(frags, ","); }
        cov_vb(frags, string_concat(string_concat("{\"fragment_id\":\"", sha256_hex_bytes(proj)),
            string_concat(string_concat("\",\"fragment_index\":", cov_map_int(sk2)),
            string_concat(string_concat(string_concat(",\"slice_base\":", cov_map_int(slice_base)),
                string_concat(",\"slice_length\":", cov_map_int(c - slice_base))),
                string_concat(string_concat(",\"source_indices\":[", cov_map_int(sk2)), "]}")))));
        sk2 = sk2 + 1;
    }
    cov_vb(srcs, "]");
    cov_vb(frags, "]");

    /* Entities, in plan order (source, then position). */
    let ents: Vec<i32> = vec_new();
    cov_vb(ents, "[");
    e = 0;
    while e < ne {
        let esk: i32 = vec_get(ent_source, e);
        let ebase: i32 = vec_get(cstarts, vec_get(src_unit, esk));
        if e > 0 { cov_vb(ents, ","); }
        cov_vb(ents, string_concat(string_concat("{\"entity_index\":", cov_map_int(e)),
            string_concat(string_concat(",\"kind\":\"function\",\"qualified_name\":", cov_map_str(cov_plan_line_at(qnames, e))),
            string_concat(string_concat(",\"source_index\":", cov_map_int(esk)),
            string_concat(string_concat(",\"span\":", cov_map_span(source, ls, ebase, vec_get(ent_start, e), vec_get(ent_end, e))), "}")))));
        e = e + 1;
    }
    cov_vb(ents, "]");

    /* Points, ordered by point ID. */
    let ikoff: Vec<i32> = vec_new();
    let iklen: Vec<i32> = vec_new();
    p = 0;
    while p < np {
        vec_push(ikoff, p * 64);
        vec_push(iklen, 64);
        p = p + 1;
    }
    let iorder: Vec<i32> = cov_map_sort(ids, ikoff, iklen);
    let pts: Vec<i32> = vec_new();
    cov_vb(pts, "[");
    p = 0;
    while p < np {
        let q2: i32 = vec_get(iorder, p);
        let psk: i32 = vec_get(p_src, q2);
        let pbase: i32 = vec_get(cstarts, vec_get(src_unit, psk));
        let pbr: i32 = vec_get(p_br, q2);
        if p > 0 { cov_vb(pts, ","); }
        if vec_get(counter, q2) < 0 {
            /* Uncounted: counter and fragment indexes are both null (16.3.4). */
            cov_vb(pts, "{\"classification\":\"statically_unreachable\",\"counter_index\":null");
            cov_vb(pts, string_concat(",\"entity_index\":", cov_map_int(vec_get(p_ent, q2))));
            cov_vb(pts, ",\"fragment_index\":null");
        } else {
            cov_vb(pts, string_concat("{\"classification\":\"user\",\"counter_index\":", cov_map_int(vec_get(counter, q2))));
            cov_vb(pts, string_concat(",\"entity_index\":", cov_map_int(vec_get(p_ent, q2))));
            cov_vb(pts, string_concat(",\"fragment_index\":", cov_map_int(psk)));
        }
        if pbr < 0 {
            cov_vb(pts, ",\"kind\":\"function_entry\",\"outcome_ordinal\":null");
        } else {
            cov_vb(pts, string_concat(",\"kind\":\"branch_outcome\",\"outcome_ordinal\":", cov_map_int(vec_get(p_ord, q2))));
        }
        cov_vb(pts, ",\"point_id\":\"");
        cov_vb_from(pts, ids, q2 * 64, 64);
        cov_vb(pts, "\"");
        let mut pdisc: string = "entry";
        if pbr >= 0 { pdisc = cov_br_kind_name(vec_get(br, pbr * 5)); }
        cov_vb(pts, string_concat(",\"semantic_discriminator\":", cov_map_str(pdisc)));
        cov_vb(pts, string_concat(",\"source_index\":", cov_map_int(psk)));
        cov_vb(pts, string_concat(string_concat(",\"span\":", cov_map_span(source, ls, pbase, vec_get(p_s, q2), vec_get(p_e, q2))), "}"));
        p = p + 1;
    }
    cov_vb(pts, "]");

    /* Branches: source, span, kind, first outcome point ID. */
    let bkeys: Vec<i32> = vec_new();
    let bkoff: Vec<i32> = vec_new();
    let bklen: Vec<i32> = vec_new();
    b = 0;
    while b < nb {
        let bp0: i32 = ne + vec_get(obase, b);
        cov_map_key_begin(bkeys, bkoff);
        cov_vb(bkeys, string_concat(cov_map_pad(vec_get(p_src, bp0)), cov_map_pad(vec_get(p_s, bp0))));
        cov_vb(bkeys, string_concat(string_concat(cov_map_pad(vec_get(p_e, bp0)), cov_br_kind_name(vec_get(br, b * 5))), "\t"));
        cov_vb_from(bkeys, ids, bp0 * 64, 64);
        cov_map_key_end(bkeys, bkoff, bklen);
        b = b + 1;
    }
    let border: Vec<i32> = cov_map_sort(bkeys, bkoff, bklen);
    let brs: Vec<i32> = vec_new();
    cov_vb(brs, "[");
    let mut bi: i32 = 0;
    while bi < nb {
        let bb: i32 = vec_get(border, bi);
        let bp: i32 = ne + vec_get(obase, bb);
        let bsk: i32 = vec_get(p_src, bp);
        let bbase: i32 = vec_get(cstarts, vec_get(src_unit, bsk));
        let bkind: i32 = vec_get(br, bb * 5);
        if bi > 0 { cov_vb(brs, ","); }
        cov_vb(brs, string_concat("{\"branch_index\":", cov_map_int(bi)));
        cov_vb(brs, string_concat(",\"entity_index\":", cov_map_int(vec_get(p_ent, bp))));
        cov_vb(brs, string_concat(string_concat(",\"kind\":", cov_map_str(cov_br_kind_name(bkind))), ",\"outcomes\":["));
        let mut k2: i32 = 0;
        while k2 < vec_get(br, bb * 5 + 4) {
            if k2 > 0 { cov_vb(brs, ","); }
            if cov_outcome_unreachable(bkind, k2) {
                cov_vb(brs, string_concat(string_concat("{\"classification\":\"statically_unreachable\",\"evidence_identity\":",
                    cov_map_str(cov_outcome_evidence(bkind))), ",\"name\":"));
            } else {
                cov_vb(brs, "{\"classification\":\"eligible\",\"evidence_identity\":null,\"name\":");
            }
            cov_vb(brs, string_concat(string_concat(cov_map_str(cov_outcome_name(bkind, k2)), ",\"ordinal\":"), cov_map_int(k2)));
            cov_vb(brs, ",\"point_id\":\"");
            cov_vb_from(brs, ids, (bp + k2) * 64, 64);
            cov_vb(brs, "\"}");
            k2 = k2 + 1;
        }
        cov_vb(brs, string_concat("],\"source_index\":", cov_map_int(bsk)));
        cov_vb(brs, string_concat(string_concat(",\"span\":", cov_map_span(source, ls, bbase, vec_get(p_s, bp), vec_get(p_e, bp))), "}"));
        bi = bi + 1;
    }
    cov_vb(brs, "]");

    /* Regions: each counter expression normalized (equal points merged,
       zero terms dropped, terms ordered by point ID); regions ordered by
       source, span, kind, then the expression's canonical bytes. */
    let nr: i32 = vec_len(rg) / 5;
    let exprs: Vec<i32> = vec_new();
    let xoff: Vec<i32> = vec_new();
    let xlen: Vec<i32> = vec_new();
    let xempty: Vec<i32> = vec_new();
    let rkeys: Vec<i32> = vec_new();
    let rkoff: Vec<i32> = vec_new();
    let rklen: Vec<i32> = vec_new();
    let mut r: i32 = 0;
    while r < nr {
        let h: i32 = vec_get(rg, r * 5 + 4);
        let tp: Vec<i32> = vec_new();
        let tc: Vec<i32> = vec_new();
        if h >= 0 {
            let first: i32 = vec_get(cef, h * 2);
            let n: i32 = vec_get(cef, h * 2 + 1);
            let mut i: i32 = 0;
            while i < n {
                let pt: i32 = cov_map_ref_point(vec_get(cet, (first + i) * 2 + 1), ne, obase);
                let coef: i32 = vec_get(cet, (first + i) * 2);
                let mut found: bool = false;
                let mut j: i32 = 0;
                while j < vec_len(tp) {
                    if vec_get(tp, j) == pt {
                        vec_set(tc, j, vec_get(tc, j) + coef);
                        found = true;
                    }
                    j = j + 1;
                }
                if found != true {
                    vec_push(tp, pt);
                    vec_push(tc, coef);
                }
                i = i + 1;
            }
        }
        /* Terms in point-ID order (a handful per expression). */
        let tkoff: Vec<i32> = vec_new();
        let tklen: Vec<i32> = vec_new();
        let mut t: i32 = 0;
        while t < vec_len(tp) {
            vec_push(tkoff, vec_get(tp, t) * 64);
            vec_push(tklen, 64);
            t = t + 1;
        }
        let torder: Vec<i32> = cov_map_sort(ids, tkoff, tklen);
        cov_map_key_begin(exprs, xoff);
        cov_vb(exprs, "{\"terms\":[");
        let mut written: i32 = 0;
        t = 0;
        while t < vec_len(tp) {
            let ti: i32 = vec_get(torder, t);
            if vec_get(tc, ti) != 0 {
                if written > 0 { cov_vb(exprs, ","); }
                cov_vb(exprs, string_concat(string_concat("{\"coefficient\":", cov_map_int(vec_get(tc, ti))), ",\"point_id\":\""));
                cov_vb_from(exprs, ids, vec_get(tp, ti) * 64, 64);
                cov_vb(exprs, "\"}");
                written = written + 1;
            }
            t = t + 1;
        }
        cov_vb(exprs, "]}");
        cov_map_key_end(exprs, xoff, xlen);
        let mut empty: i32 = 0;
        if written == 0 { empty = 1; }
        vec_push(xempty, empty);
        let re: i32 = vec_get(rg, r * 5 + 1);
        cov_map_key_begin(rkeys, rkoff);
        cov_vb(rkeys, string_concat(cov_map_pad(vec_get(ent_source, re)), cov_map_pad(vec_get(starts, vec_get(rg, r * 5 + 2)))));
        cov_vb(rkeys, string_concat(string_concat(cov_map_pad(vec_get(ends, vec_get(rg, r * 5 + 3))), cov_rg_kind_name(vec_get(rg, r * 5))), "\t"));
        cov_vb_from(rkeys, exprs, vec_get(xoff, r), vec_get(xlen, r));
        cov_map_key_end(rkeys, rkoff, rklen);
        r = r + 1;
    }
    let rorder: Vec<i32> = cov_map_sort(rkeys, rkoff, rklen);
    let rgs: Vec<i32> = vec_new();
    cov_vb(rgs, "[");
    let mut ri: i32 = 0;
    while ri < nr {
        let rr: i32 = vec_get(rorder, ri);
        let kind: i32 = vec_get(rg, rr * 5);
        let rent: i32 = vec_get(rg, rr * 5 + 1);
        let rsk: i32 = vec_get(ent_source, rent);
        let rbase: i32 = vec_get(cstarts, vec_get(src_unit, rsk));
        let rs: i32 = vec_get(starts, vec_get(rg, rr * 5 + 2));
        let rend: i32 = vec_get(ends, vec_get(rg, rr * 5 + 3));
        if ri > 0 { cov_vb(rgs, ","); }
        /* A region whose counter expression is identically zero can never run
           (it follows an unconditional return, break or continue): it is
           statically_unreachable, outside every ordinary denominator, with
           the canonical empty expression (SPEC 11.7, 16.3.6; CV-201). */
        if vec_get(xempty, rr) == 1 {
            cov_vb(rgs, "{\"classification\":\"statically_unreachable\",\"counter_expression\":");
        } else {
            cov_vb(rgs, "{\"classification\":\"user\",\"counter_expression\":");
        }
        cov_vb_from(rgs, exprs, vec_get(xoff, rr), vec_get(xlen, rr));
        cov_vb(rgs, string_concat(",\"entity_index\":", cov_map_int(rent)));
        cov_vb(rgs, string_concat(",\"kind\":", cov_map_str(cov_rg_kind_name(kind))));
        if cov_rg_line_contributing(kind, string_char_at(source, rs), vec_get(xempty, rr) == 1) {
            cov_vb(rgs, ",\"line_contributing\":true");
        } else {
            cov_vb(rgs, ",\"line_contributing\":false");
        }
        cov_vb(rgs, string_concat(",\"line_numbers\":", cov_map_line_numbers(source, ls, rbase, rs, rend)));
        cov_vb(rgs, string_concat(",\"region_index\":", cov_map_int(ri)));
        cov_vb(rgs, string_concat(",\"source_index\":", cov_map_int(rsk)));
        cov_vb(rgs, string_concat(string_concat(",\"span\":", cov_map_span(source, ls, rbase, rs, rend)), "}"));
        ri = ri + 1;
    }
    cov_vb(rgs, "]");

    /* Assemble in key order; map_id hashes the map without itself. The
       map_id key sorts between "fragments" and "point_identity_version". */
    let before: Vec<i32> = vec_new();
    cov_vb(before, "{\"branches\":");
    cov_vb_all(before, brs);
    cov_vb(before, ",\"capabilities\":[\"branch-outcomes\",\"contract-coverage\",\"exclusion-audit\",\"module-fragments\",\"normalized-linear-expressions\",\"nullable-counter-bindings\",\"semantic-function-ownership\",\"source-digests\"]");
    cov_vb(before, string_concat(string_concat(",\"compiler\":{\"identity\":", cov_map_str(identity)),
        ",\"name\":\"sv0c\"},\"contracts\":[],\"entities\":"));
    cov_vb_all(before, ents);
    cov_vb(before, ",\"exclusions\":[],\"fragments\":");
    cov_vb_all(before, frags);
    let after: Vec<i32> = vec_new();
    cov_vb(after, ",\"point_identity_version\":\"1.0\",\"points\":");
    cov_vb_all(after, pts);
    cov_vb(after, string_concat(",\"program_counter_count\":", cov_map_int(nc)));
    cov_vb(after, ",\"regions\":");
    cov_vb_all(after, rgs);
    cov_vb(after, ",\"schema\":\"sv0cov.map\",\"sources\":");
    cov_vb_all(after, srcs);
    cov_vb(after, string_concat(string_concat(",\"target\":{\"kind\":\"executable\",\"name\":", cov_map_str(target)),
        "},\"version\":\"1.0\"}\n"));
    let without: Vec<i32> = vec_new();
    cov_vb_all(without, before);
    cov_vb_all(without, after);
    let map: Vec<i32> = vec_new();
    cov_vb_all(map, before);
    cov_vb(map, string_concat(string_concat(",\"map_id\":\"", sha256_hex_bytes(without)), "\""));
    cov_vb_all(map, after);
    return map;
}

/* ── generated-C registration (CV-113; SPEC 14.1) ──────────────────────── */

/* Index of needle in hay at or after from, or -1. */
fn cov_map_find(hay: string, needle: string, from: i32) -> i32 {
    let n: i32 = string_len(hay);
    let m: i32 = string_len(needle);
    let c0: i32 = string_char_at(needle, 0);
    let mut i: i32 = from;
    while i + m <= n {
        if string_char_at(hay, i) == c0 {
            if string_eq(string_substr(hay, i, m), needle) { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

/* The decimal digits starting at s[at] (0 when there are none). */
fn cov_map_read_int(s: string, at: i32) -> i32 {
    let n: i32 = string_len(s);
    let mut v: i32 = 0;
    let mut i: i32 = at;
    let mut going: bool = true;
    while going {
        going = false;
        if i < n {
            let c: i32 = string_char_at(s, i);
            if c >= 48 {
                if c <= 57 {
                    v = v * 10 + c - 48;
                    i = i + 1;
                    going = true;
                }
            }
        }
    }
    return v;
}

/* The byte-buffer forms of the above, for reading a built map. */
fn cov_map_findv(hay: Vec<i32>, needle: string, from: i32) -> i32 {
    let n: i32 = vec_len(hay);
    let m: i32 = string_len(needle);
    let mut i: i32 = from;
    while i + m <= n {
        let mut j: i32 = 0;
        let mut same: bool = true;
        while same {
            if j >= m {
                return i;
            }
            if vec_get(hay, i + j) != string_char_at(needle, j) {
                same = false;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn cov_map_read_intv(v: Vec<i32>, at: i32) -> i32 {
    let n: i32 = vec_len(v);
    let mut x: i32 = 0;
    let mut i: i32 = at;
    let mut going: bool = true;
    while going {
        going = false;
        if i < n {
            let c: i32 = vec_get(v, i);
            if c >= 48 {
                if c <= 57 {
                    x = x * 10 + c - 48;
                    i = i + 1;
                    going = true;
                }
            }
        }
    }
    return x;
}

/* v[off .. off+len) as a string; printable ASCII only (hex IDs). */
fn cov_map_strv(v: Vec<i32>, off: i32, len: i32) -> string {
    let printable: string = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
    let mut out: string = "";
    let mut i: i32 = 0;
    while i < len {
        let c: i32 = vec_get(v, off + i);
        if c >= 32 {
            if c <= 126 { out = string_concat(out, string_substr(printable, c - 32, 1)); }
        }
        i = i + 1;
    }
    return out;
}

/* A C string literal for the bytes of s: printable ASCII copied, `"` `\`
   and `?` (trigraphs) escaped, every other byte as a three-digit octal
   escape, so a following digit is never absorbed. */
fn cov_map_c_str(s: string) -> string {
    let digits: string = "01234567";
    let n: i32 = string_len(s);
    let mut out: string = "\"";
    let mut start: i32 = 0;
    let mut i: i32 = 0;
    while i < n {
        let c: i32 = string_char_at(s, i);
        let mut esc: string = "";
        if c == 34 { esc = "\\\""; }
        if c == 92 { esc = "\\\\"; }
        if c == 63 { esc = "\\?"; }
        let plain: bool = if c < 32 { false } else { c < 127 };
        if plain != true {
            esc = string_concat(string_concat("\\", string_substr(digits, c / 64, 1)),
                string_concat(string_substr(digits, (c / 8) % 8, 1), string_substr(digits, c % 8, 1)));
        }
        if string_len(esc) > 0 {
            out = string_concat(string_concat(out, string_substr(s, start, i - start)), esc);
            start = i + 1;
        }
        i = i + 1;
    }
    return string_concat(string_concat(out, string_substr(s, start, n - start)), "\"");
}

/* The C declarations an instrumented translation unit carries (generated-C
   coverage protocol 1): the runtime interface, one descriptor per map
   fragment, and this module's registration record (map ID, program counter
   count, target, compiler identity, and the module's counter slice). The
   generated main passes __sv0cov_modules to __sv0cov_start right after
   sv0_runtime_init, before user code; every hit is
   __sv0cov_hit(&__sv0cov_module, local) with local counted from the
   module's slice base. The mega-TU is one module holding every fragment,
   so its slice is the whole program and local equals the program counter.
   Reads the canonical map `map` built by cov_map_build; "" if it lacks the
   expected fields. */
/* The map's fragment table as [slice_base, slice_length] pairs in fragment
   order, or an empty Vec when the map has none or its slices are not
   contiguous from 0 to program_counter_count (CV-206). */
fn cov_map_fragment_table(map: Vec<i32>) -> Vec<i32> {
    let out: Vec<i32> = vec_new();
    let fr: i32 = cov_map_findv(map, "\"fragments\":[", 0);
    let mid: i32 = cov_map_findv(map, "\"map_id\":\"", 0);
    let pc: i32 = cov_map_findv(map, "\"program_counter_count\":", 0);
    if fr < 0 { return out; }
    if mid < 0 { return out; }
    if pc < 0 { return out; }
    let total: i32 = cov_map_read_intv(map, pc + 24);
    let mut covered: i32 = 0;
    let mut at: i32 = cov_map_findv(map, "{\"fragment_id\":\"", fr);
    while at >= 0 {
        if at > mid {
            at = 0 - 1;
        } else {
            let sb: i32 = cov_map_findv(map, "\"slice_base\":", at);
            let sl: i32 = cov_map_findv(map, "\"slice_length\":", at);
            if sb < 0 { return vec_new(); }
            if sl < 0 { return vec_new(); }
            let base: i32 = cov_map_read_intv(map, sb + 13);
            let len: i32 = cov_map_read_intv(map, sl + 15);
            if base != covered { return vec_new(); }
            covered = covered + len;
            vec_push(out, base);
            vec_push(out, len);
            at = cov_map_findv(map, "{\"fragment_id\":\"", at + 16);
        }
    }
    if covered != total { return vec_new(); }
    return out;
}

/* The fragment that owns program counter k in a cov_map_fragment_table, or
   -1. Zero-length fragments own nothing. */
fn cov_map_fragment_of(table: Vec<i32>, k: i32) -> i32 {
    let mut j: i32 = 0;
    while j * 2 < vec_len(table) {
        let base: i32 = vec_get(table, j * 2);
        if k >= base {
            if k < base + vec_get(table, j * 2 + 1) { return j; }
        }
        j = j + 1;
    }
    return 0 - 1;
}

/* Generated-C protocol 1 prelude (CV-113, CV-206): one module descriptor per
   map fragment, each holding that fragment, and the aggregator
   __sv0cov_modules[] the hosted main registers before user code. A hit
   names its fragment's module and a module-local index. Empty when the map
   has no usable fragment table. */
fn cov_map_c_prelude(map: Vec<i32>, target: string, identity: string) -> string {
    let table: Vec<i32> = cov_map_fragment_table(map);
    let nfrag: i32 = vec_len(table) / 2;
    if nfrag == 0 { return ""; }
    let mid: i32 = cov_map_findv(map, "\"map_id\":\"", 0);
    let pc: i32 = cov_map_findv(map, "\"program_counter_count\":", 0);
    let map_id: string = cov_map_strv(map, mid + 10, 64);
    let total: string = cov_map_int(cov_map_read_intv(map, pc + 24));
    let head: string = string_concat(string_concat(string_concat(string_concat("  1u, \"", map_id), "\", "),
        string_concat(total, "u, ")), string_concat(string_concat(cov_map_c_str(target), ", "),
        string_concat(cov_map_c_str(identity), ", ")));
    let mut out: string = "/* sv0cov coverage instrumentation, generated-C protocol 1 (sv0cov CV-113, CV-206).\n   One module descriptor per map fragment; hits count module-local counters.\n   The coverage runtime validates the whole set before user entry. */\n";
    out = string_concat(out, "struct __sv0cov_fragment {\n  const char *fragment_id;\n  uint32_t slice_base;\n  uint32_t slice_length;\n};\n");
    out = string_concat(out, "struct __sv0cov_module {\n  uint32_t protocol_major;\n  const char *map_id;\n  uint32_t program_counter_count;\n  const char *target;\n  const char *compiler_identity;\n  uint32_t slice_base;\n  uint32_t slice_length;\n  uint32_t fragment_count;\n  const struct __sv0cov_fragment *fragments;\n};\n");
    out = string_concat(out, "void __sv0cov_start(const struct __sv0cov_module *const *modules, uint32_t module_count);\n");
    out = string_concat(out, "void __sv0cov_hit(const struct __sv0cov_module *module, uint32_t local_index);\n");
    let mut agg: string = "";
    let fr: i32 = cov_map_findv(map, "\"fragments\":[", 0);
    let mut at: i32 = cov_map_findv(map, "{\"fragment_id\":\"", fr);
    let mut j: i32 = 0;
    while j < nfrag {
        let fid: string = cov_map_strv(map, at + 16, 64);
        let jn: string = cov_map_int(j);
        let base: string = cov_map_int(vec_get(table, j * 2));
        let len: string = cov_map_int(vec_get(table, j * 2 + 1));
        let slice: string = string_concat(string_concat(base, "u, "), string_concat(len, "u"));
        out = string_concat(out, string_concat(string_concat("static const struct __sv0cov_fragment __sv0cov_fragment_", jn),
            string_concat(string_concat("[1] = {{\"", fid), string_concat(string_concat("\", ", slice), "}};\n"))));
        out = string_concat(out, string_concat(string_concat("static const struct __sv0cov_module __sv0cov_module_", jn),
            string_concat(string_concat(" = {\n", head), string_concat(slice, string_concat(", 1u, __sv0cov_fragment_",
            string_concat(jn, "\n};\n"))))));
        if j > 0 { agg = string_concat(agg, ", "); }
        agg = string_concat(agg, string_concat("&__sv0cov_module_", jn));
        at = cov_map_findv(map, "{\"fragment_id\":\"", at + 16);
        j = j + 1;
    }
    out = string_concat(out, string_concat(string_concat("static const struct __sv0cov_module *const __sv0cov_modules[", cov_map_int(nfrag)), "] = {"));
    return string_concat(out, string_concat(agg, "};\n\n"));
}

/* ── VM v1 companion binding (CV-118; sv0doc bytecode/coverage.md 4) ───── */

/* The canonical `sv0cov.vm-binding` 1.0 companion for bytecode of
   bytecode_len bytes with SHA-256 bytecode_sha (64 hex), bound to the
   canonical map `map`: the eleven properties in key order, no whitespace,
   one final LF (sv0cov.formats.vmbinding.encode_v1). "" if the map lacks
   its ID or counter count. */
fn cov_map_vm_binding(map: Vec<i32>, identity: string, bytecode_len: i32, bytecode_sha: string) -> string {
    let mid: i32 = cov_map_findv(map, "\"map_id\":\"", 0);
    let pc: i32 = cov_map_findv(map, "\"program_counter_count\":", 0);
    if mid < 0 { return ""; }
    if pc < 0 { return ""; }
    let map_id: string = cov_map_strv(map, mid + 10, 64);
    let total: i32 = cov_map_read_intv(map, pc + 24);
    let mut out: string = string_concat("{\"bytecode_length\":", cov_map_int(bytecode_len));
    out = string_concat(out, string_concat(string_concat(",\"bytecode_sha256\":\"", bytecode_sha), "\""));
    out = string_concat(out, ",\"capabilities\":[\"sv0cov.coverage.v1\"]");
    out = string_concat(out, string_concat(",\"compiler_identity\":", cov_map_str(identity)));
    out = string_concat(out, string_concat(string_concat(",\"map_id\":\"", map_id), "\""));
    out = string_concat(out, ",\"plan_capability\":\"sv0cov.plan.v1\",\"profile\":\"sv0vm-v1-coverage\"");
    out = string_concat(out, string_concat(",\"program_counter_count\":", cov_map_int(total)));
    return string_concat(out, ",\"raw_profile_version\":\"1.0\",\"schema\":\"sv0cov.vm-binding\",\"version\":\"1.0\"}\n");
}
