/* NEX-048b sanitizer stress fixture: push 200 elements (forces several
   sv0_vec_push realloc-doubling cycles from the initial cap of 8),
   stressing the Vec<T> handle table's growth path under ASan without
   triggering any UB -- fully-defined behavior, sum 0..199 % 256 = 188. */
fn main() -> i32 {
    let v: Vec<i32> = vec_new();
    let mut i: i32 = 0;
    while i < 200 {
        vec_push(v, i);
        i = i + 1;
    }
    let mut sum: i32 = 0;
    let mut j: i32 = 0;
    while j < vec_len(v) {
        sum = sum + vec_get(v, j);
        j = j + 1;
    }
    return sum % 256;
}
