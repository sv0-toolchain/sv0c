// f64 arrays and slices: `[f64; N]` locals, float array literals, `a[i]` reads
// and `a[i] = x` stores, `&a[lo..hi]` slices, `&[f64]` / `&mut [f64]`
// parameters, and reading an element of a Vec<f64> struct field. The element type comes
// from the declaration (annotation, float literal, or parameter type); i32
// arrays are untouched. These used to be refused (E0447) or, for element
// access, read the double's raw storage. Expected exit: 42.

struct Series {
    v: Vec<f64>,
}

fn total(s: &[f64]) -> f64 {
    let mut t: f64 = 0.0;
    let mut i: i32 = 0;
    while i < slice_len(s) {
        t = t + s[i];
        i = i + 1;
    }
    return t;
}

fn bump(s: &mut [f64]) -> i32 {
    s[0] = s[0] + 1.0;
    return 0;
}

fn writes() -> i32 {
    let z: [f64; 2] = [1.5, 9.0];
    let m: &mut [f64] = &mut z[0..2];
    let r: i32 = bump(m);
    if r != 0 { return 3; }
    if z[0] != 2.5 { return 1; }
    if z[1] != 9.0 { return 2; }
    return 0;
}

fn main() -> i32 {
    let a: [f64; 3] = [1.5, 2.5, 4.0];
    if a[0] != 1.5 { return 1; }
    a[1] = 3.5;
    if a[1] != 3.5 { return 2; }

    // unannotated literal with a float first element
    let b = [0.25, 0.75];
    let bsum: f64 = b[0] + b[1];
    if bsum != 1.0 { return 3; }

    // loop indexing
    let mut sum: f64 = 0.0;
    let mut i: i32 = 0;
    while i < 3 {
        sum = sum + a[i];
        i = i + 1;
    }
    if sum != 9.0 { return 4; }

    // slices over an f64 array
    let mid: &[f64] = &a[1..3];
    if mid[0] != 3.5 { return 5; }
    if total(mid) != 7.5 { return 6; }
    let all: &[f64] = &a[..];
    if total(all) != 9.0 { return 7; }

    // store through a slice reaches the array
    if writes() != 0 { return 8; }

    // Vec<f64> field indexed directly
    let sr: Series = Series { v: vec_new() };
    vec_push(sr.v, 6.5);
    vec_push(sr.v, 0.5);
    if sr.v[1] != 0.5 { return 9; }
    let f0: f64 = sr.v[0] + 1.0;
    if f0 != 7.5 { return 10; }

    // i32 arrays are untouched
    let n: [i32; 3] = [10, 20, 12];
    n[2] = n[2] + 0;
    return n[0] + n[1] + n[2] - 0;
}
