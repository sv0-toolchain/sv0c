// A trait with a bodyless method declaration and an impl that provides it.
// The declaration used to be body-checked (failing with no diagnostic,
// exit 4) and lowered as an empty function that collided with the impl's
// definition. Both backends. Expected exit: 42.

struct Pt { x: i32 }

trait Area {
    fn area(self: Pt) -> i32;
    fn scaled(self: Pt) -> i32 { return self.x - 4; }
}

impl Area for Pt {
    fn area(self: Pt) -> i32 { return self.x * self.x; }
}

fn main() -> i32 {
    let p: Pt = Pt { x: 6 };
    return p.area() + p.scaled() + 4;
}
