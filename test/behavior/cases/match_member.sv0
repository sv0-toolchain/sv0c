// `match` on a struct member: the scrutinee's type comes from the arm patterns
// (`Enum::Variant`, `Enum::V { .. }`, `Struct { .. }`), so `match h.shape { .. }`,
// a nested `match o.h.second { .. }` and a struct pattern on a member all work
// with enum-typed fields of several widths (payloads, a struct-variant enum), on
// both backends. The VM sizes an enum field at the enum's width. Expected exit: 42.

enum Shape {
    Circle(i32),
    Rect { w: i32, h: i32 },
    Dot,
}

struct Pair {
    a: i32,
    b: i32,
}

struct Holder {
    first: Shape,
    n: i32,
    second: Shape,
    pair: Pair,
}

struct Outer {
    h: Holder,
    k: i32,
}

fn area(s: Shape) -> i32 {
    match s {
        Shape::Circle(r) => { return r * 3; },
        Shape::Rect { w, h } => { return w * h; },
        Shape::Dot => { return 0; },
    }
    return 0 - 1;
}

fn main() -> i32 {
    let p: Pair = Pair { a: 4, b: 5 };
    let hd: Holder = Holder { first: Shape::Circle(2), n: 7, second: Shape::Rect { w: 3, h: 4 }, pair: p };
    let o: Outer = Outer { h: hd, k: 1 };
    let mut acc: i32 = 0;
    match hd.first {
        Shape::Circle(r) => { acc = acc + r; },
        Shape::Rect { w, h } => { acc = acc + 100; },
        Shape::Dot => { acc = acc + 100; },
    }
    if acc != 2 { return 1; }
    match hd.second {
        Shape::Circle(r) => { return 2; },
        Shape::Rect { w, h } => { acc = acc + w * h; },
        Shape::Dot => { return 3; },
    }
    if acc != 14 { return 4; }
    match o.h.second {
        Shape::Rect { w, h } => { acc = acc + w; },
        Shape::Circle(r) => { return 5; },
        Shape::Dot => { return 6; },
    }
    if acc != 17 { return 7; }
    match hd.pair {
        Pair { a, b } => { acc = acc + a + b; },
    }
    if acc != 26 { return 8; }
    if area(hd.first) != 6 { return 9; }
    if o.h.n != 7 { return 10; }
    if o.k != 1 { return 11; }
    return acc + 16;
}
