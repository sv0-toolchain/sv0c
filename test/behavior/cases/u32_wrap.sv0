// BUGS.md #22 (sv0-mathlib): a u32 above i32::MAX must behave as unsigned on
// the native VM. It was kept as a plain i32, so `0 - 1` read as -1, a compare
// against 4294967295 failed, and `4294967295 / a` divided by a wrapped value.
// The C backend (uint32_t) was always right. Expected exit: 42 (native only --
// the SML reference rejects literals above i32).

fn sub_wrapping(a: u32, b: u32) -> u32 { return a - b; }
fn add_wrapping(a: u32, b: u32) -> u32 { return a + b; }
fn mul_wrapping(a: u32, b: u32) -> u32 { return a * b; }
fn max_u32() -> u32 { return 4294967295; }

fn main() -> i32 {
    // wrap-around: 0 - 1 == u32::MAX, both through a call and inline
    if sub_wrapping(0, 1) != max_u32() { return 10; }
    let z: u32 = 0;
    let one: u32 = 1;
    let w: u32 = z - one;
    if w != 4294967295 { return 11; }

    // overflow on add and mul wraps modulo 2^32
    if add_wrapping(max_u32(), 1) != 0 { return 12; }
    if add_wrapping(max_u32(), 2) != 1 { return 13; }
    if mul_wrapping(65536, 65536) != 0 { return 14; }
    if mul_wrapping(65537, 65537) != 131073 { return 15; }

    // ordered compares see the unsigned value
    let big: u32 = 3000000000;
    let small: u32 = 5;
    if big < small { return 16; }
    if !(big > small) { return 17; }
    if max_u32() <= big { return 18; }
    if !(max_u32() >= big) { return 19; }

    // div / rem with the high bit set
    if max_u32() / 2 != 2147483647 { return 20; }
    if max_u32() % 10 != 5 { return 21; }
    if big / 1000 != 3000000 { return 22; }

    // shifts: shl wraps, shr is logical
    let top: u32 = 2147483648;
    if (top << 1) != 0 { return 23; }
    if (top >> 31) != 1 { return 24; }
    let hi_bits: u32 = 4026531840;
    if (hi_bits >> 28) != 15 { return 25; }

    // bitwise with the high bit set stays unsigned (the C backend typed these
    // temps `int`, so the result went negative); a literal above 2^31 - 1 is
    // a wide constant, and the value is the same as the 32-bit operation
    if (big & 4294967295) != big { return 26; }
    if (top | 1) != 2147483649 { return 27; }
    if (max_u32() ^ big) != 1294967295 { return 28; }
    let mask: u32 = 65535;
    if (big & mask) != 24064 { return 30; }

    // ordinary small values are unaffected
    let a: u32 = 40;
    let b: u32 = 2;
    if a + b != 42 { return 29; }
    return 42;
}
