// Element assignment through any place: `s.v[i] = x`, compound `a[i] op= x`
// (all operators, ints and f64), and a vec taken straight from a call
// (`vec_get(mk(), i)`), whose element type is the callee's declared return
// type. These used to be parser errors (E0100) or silent no-ops. Expected
// exit: 42.

struct S {
    v: Vec<i32>,
    f: Vec<f64>,
}

fn mk() -> Vec<f64> {
    let v: Vec<f64> = vec_new();
    vec_push(v, 1.5);
    vec_push(v, 2.5);
    return v;
}

fn main() -> i32 {
    let sr: S = S { v: vec_new(), f: vec_new() };
    vec_push(sr.v, 40);
    vec_push(sr.f, 0.5);
    sr.v[0] = sr.v[0] + 1;
    sr.v[0] += 1;
    if sr.v[0] != 42 { return 1; }
    sr.f[0] *= 4.0;
    if sr.f[0] != 2.0 { return 2; }

    // every compound operator on an int array
    let a: [i32; 2] = [1, 2];
    a[1] += 5;
    a[1] -= 1;
    a[1] <<= 1;
    a[1] *= 2;
    a[1] /= 6;
    a[1] %= 3;
    if a[1] != 1 { return 3; }
    a[0] |= 6;
    a[0] &= 7;
    a[0] ^= 2;
    if a[0] != 5 { return 4; }

    // f64 array: an int operand is widened, a float one is exact
    let g: [f64; 2] = [1.5, 2.5];
    g[0] += 1;
    g[1] /= 2.0;
    if g[0] != 2.5 { return 5; }
    if g[1] != 1.25 { return 6; }

    // the index is evaluated once
    let i: i32 = 0;
    let k: [i32; 2] = [10, 20];
    k[i] += 5;
    if k[0] != 15 { return 7; }

    // a vec straight from a call
    if vec_get(mk(), 1) != 2.5 { return 8; }
    return sr.v[0];
}
