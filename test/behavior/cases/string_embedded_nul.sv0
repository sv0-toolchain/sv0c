// SS-U02b (sv0-strings Track U): owned `string` is length-bearing, so an
// embedded U+0000 is content -- len/eq/concat/substr/char_at never stop at it.
// The strlen/strcmp-based `sv0_string_*` this replaces failed every check here.
// Expected exit: 42.

fn main() -> i32 {
    // len counts past the NUL
    if string_len("a\0b") != 3 { return 1; }

    // equality is a full byte compare, not strcmp
    if string_eq("a\0b", "a\0c") { return 2; }   // differ at byte 2
    if string_eq("a\0X", "a") { return 3; }       // length 3 vs 1
    if string_eq("a\0b", "a\0b") != true { return 4; }

    // concat sizes by length; the NUL survives
    let r: string = string_concat("a\0b", "cd");  // a 00 b c d
    if string_len(r) != 5 { return 5; }
    if string_char_at(r, 1) != 0 { return 6; }
    if string_char_at(r, 2) != 98 { return 7; }   // 'b' after the NUL
    if string_char_at(r, 4) != 100 { return 8; }  // 'd'

    // substr is length-based on both ends
    let s: string = string_substr("Xa\0bY", 1, 3); // a 00 b
    if string_len(s) != 3 { return 9; }
    if string_char_at(s, 1) != 0 { return 10; }
    if string_char_at(s, 2) != 98 { return 11; }

    // empty string is well-formed
    if string_len("") != 0 { return 12; }
    if string_eq("", string_concat("", "")) != true { return 13; }

    return 42;
}
