enum Opt { Some(i32), None }

fn pick(n: i32) -> Opt {
    if n > 0 {
        return Opt::Some(n);
    }
    return Opt::None;
}

fn walk(n: i32) -> Opt {
    let mut i: i32 = 0;
    while i < n loop_invariant(pick(i + 1)? > 0) {
        i = i + 1;
    }
    return Opt::Some(i);
}

fn main() -> i32 {
    let r: Opt = walk(3);
    return match r {
        Opt::Some(x) => x - 3,
        Opt::None => 9,
    };
}
