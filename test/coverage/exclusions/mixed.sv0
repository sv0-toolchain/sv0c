/* sv0cov CV-305: every exclusion form the plan resolves, with the code
   around each one kept ordinary. run_exclusions.py compares its counts with
   the same program whose exclusions are blanked out. The program exits 0. */

#[coverage(off, reason = "a whole function")]
fn unused_path(n: i32) -> i32 {
    if n > 3 {
        return 1;
    };
    return 0;
}

struct Pair { a: i32, b: i32 }

#[coverage(off, reason = "every method of an impl")]
impl Pair {
    fn sum(self: Pair) -> i32 { return self.a + self.b; }
    fn diff(self: Pair) -> i32 {
        if self.a > self.b { return self.a - self.b; };
        return self.b - self.a;
    }
}

fn classify(n: i32) -> i32 {
    #[coverage(branch_off, reason = "only the if's own outcomes; the nested match stays")]
    if n >= 0 {
        match n {
            0 => { return 10; },
            1 => { return 11; },
            _ => {},
        };
    };
    return 12;
}

fn walk(limit: i32) -> i32 {
    let mut i: i32 = 0;
    let mut total: i32 = 0;
    #[coverage(branch_off, reason = "the loop's body and exit")]
    while i < limit {
        total = total + i;
        i = i + 1;
    };
    #[coverage(off, reason = "an early return, and the code after it stays counted")]
    if total > 100 {
        return 0;
    };
    // sv0cov: ignore-next reason="one statement"
    total = total + 1;
    let v: i32 =
        // sv0cov: ignore-next reason="an if expression"
        if total > 5 { 2 } else { 3 };
    // sv0cov: ignore-start reason="a region of statements"
    let mut j: i32 = 0;
    loop {
        j = j + 1;
        if j > 2 { break; };
    };
    // sv0cov: ignore-end
    #[coverage(off, reason = "a block")]
    {
        total = total + j;
    };
    return total + v;
}

fn pick(n: i32) -> i32 {
    #[coverage(branch_off, reason = "the arms of a match")]
    match n {
        0 => { return 1; },
        _ => {},
    };
    return 2;
}

fn main() -> i32 {
    let p: Pair = Pair { a: 1, b: 2 };
    let c: i32 = classify(1) + classify(5) + classify(0 - 1);
    let w: i32 = walk(4);
    return unused_path(0) + p.sum() - 3 + c - 33 + w - 14 + pick(3) + pick(0) - 3;
}
