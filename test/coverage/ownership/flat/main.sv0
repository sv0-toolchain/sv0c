use t_unit::check;
use ex_demo::demo;
use v_acme::acme;
use tp_misc::misc;
use gen_tab::table;
use b_out::built;
use nm_left::left;
use bench_hot::hot;
use fx_data::data;
use core_main::core;

fn main() -> i32 {
    let mut t: i32 = 0;
    t = t + check(3);
    t = t + demo(2);
    t = t + acme(5);
    t = t + misc(1);
    t = t + table(4);
    t = t + built(6);
    t = t + left(7);
    t = t + hot(2);
    t = t + data(9);
    t = t + core(1);
    return t - 78;
}
