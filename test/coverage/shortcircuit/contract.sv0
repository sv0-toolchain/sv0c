/* sv0cov CV-307: `&&` / `||` in contract clauses (requires, ensures,
   assert, loop_invariant) are no short_circuit branches; the one in the
   body is. Exits 0. */

fn pick(b: bool) -> bool {
    return b;
}

fn both(a: bool, b: bool) -> bool
    requires(a || b)
    ensures(result == (a && b))
{
    assert a || b;
    let r: bool = a && pick(b);
    return r;
}

fn count(n: i32) -> i32 {
    let mut i: i32 = 0;
    while i < n
        loop_invariant(i >= 0 && i <= n)
    {
        i = i + 1;
    }
    return i;
}

fn main() -> i32 {
    both(true, true);
    both(true, false);
    count(3);
    return 0;
}
