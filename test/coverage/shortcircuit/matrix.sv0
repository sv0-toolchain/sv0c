/* sv0cov CV-307: `&&` and `||` as short_circuit branches in every context.
   run_shortcircuit.py compares the outcomes of every short_circuit branch
   with matrix.expected (hand-derived) on both backends. The program exits 0. */

fn rt() -> bool {
    return true;
}

fn rf() -> bool {
    return false;
}

fn pick(b: bool) -> bool {
    return b;
}

fn pos(n: i32) -> bool {
    return n > 0;
}

fn m1() -> i32 {
    return 0;
}

fn m2() -> i32 {
    return 0;
}

fn m3() -> i32 {
    return 0;
}

fn m4() -> i32 {
    return 0;
}

fn m5() -> i32 {
    return 0;
}

fn m6() -> i32 {
    return 0;
}

fn m7() -> i32 {
    return 0;
}

fn m8() -> i32 {
    return 0;
}

fn take(x: bool) -> i32 {
    if x {
        return 1;
    }
    return 0;
}

struct Flags {
    lo: bool,
    hi: bool,
}

// The four (a, b) combinations of each operator, `return` context.
fn and_op(a: bool, b: bool) -> bool {
    return a && pick(b);
}

fn or_op(a: bool, b: bool) -> bool {
    return a || pick(b);
}

fn truth() -> i32 {
    and_op(true, true);
    and_op(true, false);
    and_op(true, false);
    and_op(false, true);
    and_op(false, true);
    and_op(false, true);
    and_op(false, false);
    and_op(false, false);
    and_op(false, false);
    and_op(false, false);
    or_op(true, true);
    or_op(true, false);
    or_op(true, false);
    or_op(false, true);
    or_op(false, true);
    or_op(false, true);
    or_op(false, false);
    or_op(false, false);
    or_op(false, false);
    or_op(false, false);
    return 0;
}

// Mixed precedence, parentheses and chains, `let` initializers.
fn prec(a: bool, b: bool, c: bool) -> i32 {
    let p1: bool = a || b && pick(c);
    let p2: bool = a && b || pick(c);
    let p3: bool = (a || b) && pick(c);
    let p4: bool = a && (b || pick(c));
    let p5: bool = a && b && pick(c);
    let p6: bool = a || b || pick(c);
    return 0;
}

fn all_prec() -> i32 {
    prec(true, true, true);
    prec(true, true, false);
    prec(true, false, true);
    prec(true, false, false);
    prec(false, true, true);
    prec(false, true, false);
    prec(false, false, true);
    prec(false, false, false);
    return 0;
}

fn in_if(a: bool, b: bool) -> i32 {
    if a && pick(b) {
        m1();
        return 1;
    }
    m2();
    return 0;
}

fn in_while(n: i32) -> i32 {
    let mut i: i32 = 0;
    while i < n && pos(10 - i) {
        i = i + 1;
        m3();
    }
    return i;
}

fn as_arg(a: bool, b: bool) -> i32 {
    return take(a && pick(b));
}

fn assign(a: bool, b: bool) -> i32 {
    let mut x: bool = false;
    x = a || pick(b);
    return take(x);
}

fn in_struct(a: bool, b: bool) -> i32 {
    let f: Flags = Flags { lo: a && pick(b), hi: a || pick(b) };
    return take(f.lo) + take(f.hi);
}

fn arm_expr(k: i32, a: bool, b: bool) -> bool {
    return match k {
        0 => a && pick(b),
        1 => a || pick(b),
        _ => false,
    };
}

fn guard(n: i32) -> i32 {
    let mut r: i32 = 0;
    match n {
        x if x > 0 && pos(x - 3) => {
            m4();
            r = 1;
        },
        _ => {
            m5();
        },
    };
    return r;
}

fn cond_expr(a: bool, b: bool) -> i32 {
    let v: i32 = if a && pick(b) { 1 } else { 2 };
    return v;
}

fn rhs_if(a: bool, b: bool) -> bool {
    let w: bool = a && if pick(b) { rt() } else { rf() };
    return w;
}

fn rhs_match(a: bool, k: i32) -> bool {
    let w: bool = a || match k {
        0 => rt(),
        _ => rf(),
    };
    return w;
}

fn main() -> i32 {
    truth();
    all_prec();
    in_if(true, true);
    in_if(true, false);
    in_if(false, true);
    in_while(5);
    in_while(0);
    in_while(12);
    as_arg(true, false);
    as_arg(false, false);
    assign(true, true);
    assign(false, true);
    assign(false, false);
    in_struct(true, false);
    in_struct(true, true);
    in_struct(false, true);
    arm_expr(0, true, true);
    arm_expr(0, false, true);
    arm_expr(1, true, false);
    arm_expr(1, false, false);
    arm_expr(1, false, true);
    arm_expr(2, true, true);
    guard(0 - 1);
    guard(0);
    guard(2);
    guard(5);
    cond_expr(true, true);
    cond_expr(true, false);
    cond_expr(false, true);
    rhs_if(true, true);
    rhs_if(true, false);
    rhs_if(false, true);
    rhs_if(false, false);
    rhs_match(true, 0);
    rhs_match(false, 0);
    rhs_match(false, 1);
    rhs_match(false, 2);
    m6();
    m7();
    m8();
    return 0;
}
