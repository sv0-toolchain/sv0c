enum Op { Add(i32), Stop(), Skip() }

fn grade(n: i32) -> i32 {
  if n > 90 {
    return 1;
  } else if n > 50 {
    return 2;
  } else {
    let x = 3;
    return x;
  }
}

fn tally(ops: Vec<i32>) -> i32 {
  let mut total = 0;
  for i in 0..3 {
    total += i;
  }
  let mut k = 0;
  loop {
    k = k + 1;
    if k > 2 {
      break;
    };
  };
  let pick = if total > 1 { 10 } else { 20 };
  vec_push(ops, pick);
  return total + k + pick;
}

fn run(op: Op) -> i32 {
  let mut acc = 0;
  while acc < 5 loop_invariant(acc >= 0) {
    acc = acc + 1;
    match op {
      Op::Add(v) => { acc = acc + v; },
      Op::Stop() => { break; },
      Op::Skip() => { continue; },
    };
    acc = acc + 1;
  };
  acc
}

fn main() -> i32 {
  let v: Vec<i32> = vec_new();
  return grade(95) + tally(v) + run(Op::Stop()) + scoped(1) - 28;
}

fn scoped(n: i32) -> i32 {
  let y = {
    let t = n * 2;
    t + 1
  };
  return y;
}
