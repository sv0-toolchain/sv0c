enum Op { Add, Stop, Skip }

fn op_at(i: i32) -> Op {
    if i == 3 { return Op::Stop; }
    if i == 1 { return Op::Skip; }
    return Op::Add;
}

// while: zero / one / many; code after the loop.
fn w(n: i32) -> i32 {
    let mut i: i32 = 0;
    m1();
    while i < n {
        m2();
        i = i + 1;
    }
    m3();
    return i;
}

// for with break and continue in nested ifs.
fn f(n: i32) -> i32 {
    let mut s: i32 = 0;
    for k in 0..n {
        m4();
        if k > 1 {
            if k == 4 { break; }
            m5();
        } else {
            if k == 0 { continue; }
            m6();
        }
        m7();
        s = s + 1;
    }
    m8();
    return s;
}

// loop left by break; loop left only by return (the code after it never runs).
fn lp(n: i32) -> i32 {
    let mut i: i32 = 0;
    loop {
        m9();
        i = i + 1;
        if i >= n { break; }
        m10();
    }
    m11();
    return i;
}

fn lp_ret(n: i32) -> i32 {
    let mut i: i32 = 0;
    loop {
        m12();
        if i == n { return i; }
        i = i + 1;
    }
    m28();
    return 0 - 1;
}

// while true left by break; return from a nested loop.
fn wt(n: i32) -> i32 {
    let mut i: i32 = 0;
    while true {
        m13();
        i = i + 1;
        if i > n { break; }
        m14();
    }
    m15();
    return i;
}

fn nested_ret(n: i32) -> i32 {
    let mut i: i32 = 0;
    while i < 4 {
        m16();
        let mut j: i32 = 0;
        while j < 4 {
            m17();
            if i * 4 + j == n { return 1; }
            j = j + 1;
        }
        m18();
        i = i + 1;
    }
    m19();
    return 0;
}

// inner break leaves only the inner loop; outer continue skips the rest.
fn nested_break(n: i32) -> i32 {
    let mut t: i32 = 0;
    for i in 0..n {
        m20();
        if i == 1 { continue; }
        for j in 0..10 {
            m21();
            if j >= i { break; }
            t = t + 1;
        }
        m22();
    }
    m23();
    return t;
}

// break and continue from match arms inside a loop; a loop invariant.
fn arms(n: i32) -> i32 {
    let mut acc: i32 = 0;
    let mut i: i32 = 0;
    while i < n loop_invariant(acc >= 0) {
        m24();
        let o: Op = op_at(i);
        i = i + 1;
        match o {
            Op::Add => { acc = acc + 1; },
            Op::Stop => { break; },
            Op::Skip => { continue; },
        };
        m25();
    }
    m26();
    return acc;
}

fn main() -> i32 {
    let a: i32 = w(0) + w(1) + w(3);
    let b: i32 = f(0) + f(1) + f(6);
    let c: i32 = lp(1) + lp(3);
    let d: i32 = lp_ret(0) + lp_ret(2);
    let e: i32 = wt(0) + wt(2);
    let g: i32 = nested_ret(0) + nested_ret(6) + nested_ret(99);
    let h: i32 = nested_break(0) + nested_break(4);
    let k: i32 = arms(0) + arms(2) + arms(6);
    m27();
    return a + b + c + d + e + g + h + k - 27;
}
