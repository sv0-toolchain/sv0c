/* sv0cov CV-308: a program whose paths and loop counts depend on the length
   of the environment variable SEL, so every coverage context of
   run_contexts.py counts differently. It exits 0 on every input. */

fn only_empty() -> i32 {
    return 1;
}

fn only_short() -> i32 {
    return 2;
}

fn only_long() -> i32 {
    return 3;
}

fn spin(n: i32) -> i32 {
    let mut i: i32 = 0;
    let mut s: i32 = 0;
    while i < n {
        s = s + i;
        i = i + 1;
    }
    return s;
}

fn main() -> i32 {
    let n: i32 = string_len(getenv("SEL"));
    let mut t: i32 = 0;
    if n == 0 {
        t = only_empty();
    } else {
        if n < 10 {
            t = only_short();
        } else {
            t = only_long();
        }
    }
    let k: i32 = spin(n);
    if n > 3 && k >= 0 {
        t = t + 1;
    }
    return 0;
}
