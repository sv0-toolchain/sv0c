/* FFI-008: `#[extern_c] fn ...;` must be header-only -- a `{ ... }` body
   is a parse error (an external function's real implementation lives
   elsewhere, by definition). Expects E0100 (native only, `#[extern_c]`
   doesn't exist in the sml-legacy parser). */
#[extern_c]
fn c_abs(x: i32) -> i32 {
    return x;
}
fn main() -> i32 {
    return 0;
}
