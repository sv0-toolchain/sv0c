use lib::forty_two;
use lib::neg_one;
use lib::zero;
use lib::one;
use lib::two;
use lib::three;
use lib::four;

fn main() -> i32 {
  if forty_two() != 42 {
    return 10;
  }
  if zero() != 0 {
    return 11;
  }
  if one() != 1 {
    return 12;
  }
  if two() != 2 {
    return 13;
  }
  if three() != 3 {
    return 14;
  }
  if four() != 4 {
    return 15;
  }
  return match neg_one() {
    -1 => 0,
    _ => 1,
  };
}
