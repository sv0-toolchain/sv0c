/* BH #11a: the `?` operator. `g()?` unwraps an enum-returning call, propagating
   the failure variant early; a bare `o?` propagates the enclosing fn's enum.
   g() = Some(41); f() does `g()? + 1` -> Some(42); main matches -> 42. */
enum Opt { Some(i32), None }
fn g() -> Opt { return Opt::Some(41); }
fn f() -> Opt {
    let v: i32 = g()?;
    return Opt::Some(v + 1);
}
fn main() -> i32 {
    let r: Opt = f();
    return match r {
        Opt::Some(x) => x,
        Opt::None => 0,
    };
}
