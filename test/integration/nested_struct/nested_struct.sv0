/* BH #11: a nested struct literal (a struct-typed field value) crashed the native
   compiler (vec OOB in the struct-literal field pool). Now it compiles and runs.
   o.inner.v + o.k = 40 + 2 = 42. */
struct Inner { v: i32 }
struct Outer { inner: Inner, k: i32 }
fn main() -> i32 {
    let o: Outer = Outer { inner: Inner { v: 40 }, k: 2 };
    return o.inner.v + o.k;
}
