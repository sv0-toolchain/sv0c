// match guards + top-level bind patterns (BH-13)
fn classify(n: i32) -> i32 {
  return match n {
    x if x > 100 => 0,
    x if x > 10 => x + 2,   // guard path: 40 → 42
    y => y,                 // catch-all bind path: 8 → 8
  };
}
fn main() -> i32 {
  // classify(40) = 42 (guard); classify(8) = 8 (catch-all bind); 42 + 8 - 8 = 42
  return classify(40) + classify(8) - 8;
}
