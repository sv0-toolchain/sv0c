/* SS-U04 / sv0-strings SPEC UP-006, SEC-004 — range non-overlap must be
   checkable by FULL INTERVALS (endpoint arithmetic), not pointer inequality.
   `//@ <status>` is the expected `sv0 verify` result (verified | runtime).
   Ranges are [start, start + len). Kept to the plain i32 / `ensures(result
   <op> N)` corpus style so every obligation is a single linear query. */

/* The last index a range [a, a+alen) touches is strictly below b when the
   range ends at or before b — the solver gets this from `a + alen <= b`. */
fn last_index_below(a: i32, alen: i32, b: i32) -> i32
    requires(alen >= 1)              //@ runtime
    requires(a + alen <= b)          //@ runtime
    ensures(result < b)              //@ verified
{
    return a + alen - 1;
}

/* The gap between a's end and b's start is non-negative given the same
   full-interval precondition — i.e. the ranges are provably disjoint. */
fn gap_nonneg(a: i32, alen: i32, b: i32) -> i32
    requires(alen >= 0)             //@ runtime
    requires(a + alen <= b)         //@ runtime
    ensures(result >= 0)            //@ verified
{
    return b - (a + alen);
}

/* Pointer inequality is NOT enough: `a != b` does not bound the gap, so the
   ranges may still partially overlap (a=0, b=1, alen>=2). The solver finds
   that counterexample and the postcondition stays a sound runtime residual —
   which is exactly what UP-006 is about. */
fn gap_from_ptr_ineq(a: i32, alen: i32, b: i32) -> i32
    requires(alen >= 2)            //@ runtime
    requires(a != b)               //@ runtime
    ensures(result >= 0)           //@ runtime
{
    return b - (a + alen);
}

fn main() -> i32 { return 0; }
