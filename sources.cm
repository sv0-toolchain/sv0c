Group is
  $/basis.cm
  $/smlnj-lib.cm

  (* error reporting *)
  sml-legacy/error/span.sig
  sml-legacy/error/span.sml
  sml-legacy/error/diagnostic.sig
  sml-legacy/error/diagnostic.sml

  (* lexer *)
  sml-legacy/lexer/token.sml
  sml-legacy/lexer/lexer.sig
  sml-legacy/lexer/lexer.sml

  (* AST *)
  sml-legacy/ast/ast.sml

  (* parser *)
  sml-legacy/parser/parser.sig
  sml-legacy/parser/parser.sml

  (* name resolution *)
  sml-legacy/name_resolution/env.sig
  sml-legacy/name_resolution/env.sml
  sml-legacy/name_resolution/resolver.sig
  sml-legacy/name_resolution/resolver.sml

  (* type checker *)
  sml-legacy/type_checker/types.sml
  sml-legacy/type_checker/unify.sig
  sml-legacy/type_checker/unify.sml
  sml-legacy/type_checker/checker.sig
  sml-legacy/type_checker/checker.sml

  (* contract analyzer *)
  sml-legacy/contract_analyzer/analyzer.sig
  sml-legacy/contract_analyzer/analyzer.sml

  (* IR *)
  sml-legacy/ir/ir.sml
  sml-legacy/ir/lowering.sig
  sml-legacy/ir/lowering.sml

  (* C backend *)
  sml-legacy/backend/c/codegen.sig
  sml-legacy/backend/c/codegen.sml

  (* VM backend *)
  sml-legacy/backend/vm/bytecode.sml
  sml-legacy/backend/vm/vm_codegen.sig
  sml-legacy/backend/vm/vm_codegen.sml

  (* multi-file link / name mangling *)
  sml-legacy/link/link.sig
  sml-legacy/link/link.sml

  (* transliteration: textual include before lex *)
  sml-legacy/include_expand.sml

  (* entry point *)
  sml-legacy/main.sml
